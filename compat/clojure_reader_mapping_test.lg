(ns compat.clojure-reader-mapping-test
  (:require [clojure.test :refer [deftest is]]
            [attractor.composition :as composition]))

;; Deferred contract, deliberately outside default test discovery. This suite
;; must stay runnable and red until #801 and whole-input reader integration land.
(deftest clojure-reader-mapping-acceptance
  (doseq [s ["#_ :ignored {\"a\" \"b\"}"
             "{#_ [:ignored] \"a\" #_ :ignored \"b\" #_ {:discard \"value\"}}"
             "{\"a\" \"b\"} #_ [:discarded]"
             "^{:purpose :mapping} {\"a\" \"b\"}"
             "^:mapping {\"\\u0061\" \"\\u0062\"}"]]
    (is (= {"a" "b"}
           (get-in (composition/node-config
                     {:id "child" :attrs {:subpipeline.dotfile "child.dot" :input_map s}} {})
                   [:config :input-map])))))
