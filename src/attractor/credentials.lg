(ns attractor.credentials
  "Local credential profiles and memory-only token lifecycle."
  (:refer-clojure :exclude [close!])
  (:require [clojure.string :as str]
            [clojure.core :as core]
            [hash :as hash]
            [attractor.auth :as auth]
            [attractor.context-discovery :as capacity]
            [attractor.credentials.google :as google]
            [attractor.credentials.anthropic :as anthropic]
            [os :as os]))

(defn- fail! [category profile reason]
  (throw (ex-info "Credentials operation failed"
                  {:category category :profile profile :reason reason})))

(defn- safe-string? [s]
  (and (string? s) (not (str/blank? s))
       (not (re-find #"[\x00-\x1f\x7f]" s))))

(defn- id? [s] (and (safe-string? s) (some? (re-matches #"[A-Za-z0-9][A-Za-z0-9._:-]*" s))))
(defn- absolute? [s] (and (safe-string? s) (str/starts-with? s "/")))
(defn- unknown? [p fields] (some #(not (contains? fields %)) (keys p)))

(defn validate-profiles
  "Validate merged EDN profile definitions without I/O. source labels diagnostics;
   profiles maps string IDs to :google-browser, :google-oauth or
   :anthropic-google-oidc maps. Returns normalized map with sorted unique scopes.
   Failures expose only category, profile and reason."
  [source profiles]
  (when-not (map? profiles) (fail! :credentials-config nil :profiles-not-map))
  (let [normalized
        (into {}
          (map (fn [[id p]]
                 (when-not (and (id? id) (map? p))
                   (fail! :credentials-config nil :profile-shape))
                 (case (:type p)
                   :google-browser
                   (do (when (or (unknown? p #{:type :client_file :scopes})
                                 (not (absolute? (:client_file p)))
                                 (not (sequential? (:scopes p)))
                                 (empty? (:scopes p))
                                 (not (every? #(and (safe-string? %)
                                                    (not (re-find #"\s" %)))
                                              (:scopes p))))
                         (fail! :credentials-config id :google-profile-invalid))
                       [id (assoc p :scopes (vec (sort (set (:scopes p)))))] )
                   :google-oauth
                   (do (when (or (unknown? p #{:type :source :quota_project})
                                 (not (id? (:source p)))
                                 (not (id? (:quota_project p))))
                         (fail! :credentials-config id :gemini-profile-invalid))
                       [id p])
                   :anthropic-google-oidc
                   (do (when (or (unknown? p #{:type :source :google_service_account
                                               :organization_id :federation_rule_id
                                               :service_account_id :workspace_id})
                                 (not (id? (:source p)))
                                 (not (and (safe-string? (:google_service_account p))
                                           (some? (re-matches #"[A-Za-z0-9._-]+@[A-Za-z0-9.-]+\.iam\.gserviceaccount\.com"
                                                              (:google_service_account p)))))
                                 (not (id? (:organization_id p)))
                                 (not (id? (:federation_rule_id p)))
                                 (not (id? (:service_account_id p)))
                                 (not (id? (:workspace_id p))))
                         (fail! :credentials-config id :anthropic-profile-invalid))
                       [id p])
                   (fail! :credentials-config id :unsupported-profile-type))) profiles))]
    (doseq [[id p] normalized :when (not= :google-browser (:type p))]
      (when-not (= :google-browser (:type (get normalized (:source p))))
        (fail! :credentials-config id :invalid-source)))
    normalized))

(defn- source-id [resolver id]
  (let [p (get (:profiles resolver) id)]
    (when-not p (fail! :credentials-config id :unknown-profile))
    (if (= :google-browser (:type p)) id (:source p))))

(defn- safe-call [profile category reason f]
  (try (f)
       (catch Object error
         (if (and (map? (ex-data error))
                  (keyword? (:category (ex-data error)))
                  (str/starts-with? (name (:category (ex-data error))) "credentials-"))
           (fail! (:category (ex-data error)) profile (:reason (ex-data error)))
           (fail! category profile reason)))))

(defn- bounded [resolver profile request]
  (let [timeout (:http-timeout-ms resolver)
        result (safe-call profile :credentials-transport :transport-failed
                 #(capacity/call! (fn [] ((:transport resolver) request))
                                  {:timeout_ms timeout}))]
    (when (and (map? result) (= :unavailable (:status result)))
      (fail! :credentials-transport profile :transport-unavailable))
    result))

(defn- lock! [resolver id]
  (let [lock (get (:locks resolver) id)
        deadline (+ (System/currentTimeMillis) (:lock-timeout-ms resolver))]
    (loop []
      (if (compare-and-set! lock false true)
        nil
        (if (>= (System/currentTimeMillis) deadline)
          (fail! :credentials-busy id :lock-timeout)
          (do (core/sleep 5) (recur)))))))

(defn- with-lock [resolver id f]
  (lock! resolver id)
  (try (f) (finally (reset! (get (:locks resolver) id) false))))

(defn- assert-open! [resolver id]
  (when @(:closed resolver) (fail! :credentials-closed id :resolver-closed)))

(defn- generation [resolver id]
  [(get @(:generations resolver) id 0) @(:closed resolver)])

(defn- same-generation! [resolver id before]
  (when (or (contains? @(:invalidating resolver) id)
            (not= before (generation resolver id)))
    (fail! :credentials-invalidated id :operation-invalidated)))

(defn- expiry [resolver seconds]
  (+ ((:clock resolver)) (* 1000 seconds)))

(defn- valid-cache? [resolver item]
  (and item
       (< ((:clock resolver))
          (- (:expires-at-ms item)
             (min 30000 (max 1 (quot (- (:expires-at-ms item) (:issued-at-ms item)) 4)))))))

(defn- visible [item headers]
  {:token (:token item) :expires-at-ms (:expires-at-ms item)
   :headers (merge {"authorization" (str "Bearer " (:token item))} headers)})

(defn- remember! [resolver & values]
  (doseq [v values :when (google/safe-token? v)] (swap! (:seen resolver) conj v)))

(defn secrets
  "Return the set of secret strings already seen by this resolver, with no I/O.
   Intended for ordinary provider trace/error redaction."
  [resolver]
  @(:seen resolver))

(defn- client! [resolver id]
  (let [p (get (:profiles resolver) id)
        c (safe-call id :credentials-client :client-invalid
            #(google/client! (:client-reader resolver) (:client_file p)))]
    (remember! resolver (:client-secret c))
    c))

(defn grant-entry
  "Return the current keychain identity map for a Google browser profile.
   Reads only the configured client metadata; the entry contains no secrets."
  [resolver profile-id]
  (let [p (get (:profiles resolver) profile-id)]
    (when-not (= :google-browser (:type p))
      (fail! :credentials-config profile-id :not-google-source))
    (let [c (client! resolver profile-id)]
      {:host (auth/token-host google/token-endpoint)
       :username (str "google:" profile-id ":"
                      (hash/sha256 (pr-str [profile-id (:client-id c) (:scopes p)])))})))

(defn- fetch-grant [resolver id entry]
  (let [grant (safe-call id :credentials-store :fetch-failed
                 #((:fetch (:store resolver)) entry))]
    (when (some? grant)
      (when-not (google/safe-token? grant) (fail! :credentials-store id :invalid-grant))
      (remember! resolver grant))
    grant))

(defn- put-grant! [resolver id entry secret]
  (safe-call id :credentials-store :store-failed
    #((:store (:store resolver)) (assoc entry :secret secret)))
  (remember! resolver secret))

(defn- google-token! [resolver id]
  (let [cached (get @(:cache resolver) id)]
    (if (valid-cache? resolver cached) cached
      (with-lock resolver id
        (fn []
          (assert-open! resolver id)
          (let [cached (get @(:cache resolver) id)]
            (if (valid-cache? resolver cached) cached
              (let [before (generation resolver id)
                    profile (get (:profiles resolver) id)
                    client (client! resolver id)
                    entry (grant-entry resolver id)
                    grant (fetch-grant resolver id entry)]
                (when-not grant (fail! :credentials-login-required id :no-grant))
                (let [body (safe-call id :credentials-google :refresh-failed
                             #(google/refresh! (fn [request] (bounded resolver id request))
                                               client grant (:scopes profile)))
                      rotated (get body "refresh_token")]
                  (same-generation! resolver id before)
                  (when (and rotated (not= rotated grant))
                    (put-grant! resolver id entry rotated))
                  (same-generation! resolver id before)
                  (let [now ((:clock resolver))
                        item {:token (get body "access_token") :issued-at-ms now
                              :expires-at-ms (expiry resolver (get body "expires_in"))}]
                    (remember! resolver (:token item))
                    (swap! (:cache resolver) assoc id item)
                    item))))))))))

(defn- anthropic-token! [resolver id]
  (let [cached (get @(:cache resolver) id)]
    (if (valid-cache? resolver cached) cached
      (with-lock resolver id
        (fn []
          (assert-open! resolver id)
          (let [cached (get @(:cache resolver) id)]
            (if (valid-cache? resolver cached) cached
              (let [source (source-id resolver id)
                    before (generation resolver source)
                    profile (get (:profiles resolver) id)
                    google-access (:token (google-token! resolver source))
                    identity (safe-call id :credentials-google :id-token-failed
                               #(google/id-token! (fn [req] (bounded resolver id req))
                                                  google-access (:google_service_account profile)))
                    _ (remember! resolver identity)
                    body (safe-call id :credentials-anthropic :exchange-failed
                           #(anthropic/exchange! (fn [req] (bounded resolver id req)) identity profile))]
                (same-generation! resolver source before)
                (let [now ((:clock resolver))
                      item {:token (get body "access_token") :issued-at-ms now
                            :expires-at-ms (expiry resolver (get body "expires_in"))}]
                  (remember! resolver (:token item))
                  (swap! (:cache resolver) assoc id item)
                  item)))))))))

(defn- default-browser [url]
  (let [result (os/sh "open" url)]
    (when-not (= 0 (:exit result)) (fail! :credentials-browser nil :open-failed))))

(defn- open-browser! [resolver profile-id url]
  (let [result (safe-call profile-id :credentials-browser :open-failed
                 #(capacity/call! (fn [] ((:open-browser resolver) url))
                                  {:timeout_ms (:http-timeout-ms resolver)}))]
    (when (and (map? result) (= :unavailable (:status result)))
      (fail! :credentials-browser profile-id :open-timeout))))

(defn make-resolver
  "Create isolated in-memory credentials state. profiles is validated EDN map.
   options injects :transport (fn [request] -> {:status :body}), :clock
   (fn [] -> epoch milliseconds), :store {:fetch :store :erase} using
   {:host :username :secret?}, :client-reader (fn [absolute-path] -> parsed
   installed-client JSON), and :open-browser (fn [authorization-url]).
   Defaults use OS keychain, private-file reader, system clock and argv-based
   `open`. :http-timeout-ms and :lock-timeout-ms are bounded milliseconds."
  [profiles options]
  (let [p (validate-profiles :resolver profiles)
        opts (or options {})]
    {:profiles p :transport (:transport opts)
     :clock (or (:clock opts) #(System/currentTimeMillis))
     :store (or (:store opts) (auth/osxkeychain-store))
     :client-reader (or (:client-reader opts) google/default-client-reader)
     :open-browser (or (:open-browser opts) default-browser)
     :http-timeout-ms (min 60000 (max 1 (or (:http-timeout-ms opts) 15000)))
     :lock-timeout-ms (min 60000 (max 1 (or (:lock-timeout-ms opts) 30000)))
     :cache (atom {}) :seen (atom #{}) :closed (atom false)
     :invalidating (atom #{})
     :generations (atom {}) :locks (into {} (map (fn [id] [id (atom false)]) (keys p)))}))

(defn resolve!
  "Resolve one profile just before an HTTP attempt. Returns {:token
   :expires-at-ms :headers}; throws value-free category/profile/reason errors."
  [resolver profile-id]
  (assert-open! resolver profile-id)
  (let [p (get (:profiles resolver) profile-id)
        source (source-id resolver profile-id)
        before (generation resolver source)
        _ (when (contains? @(:invalidating resolver) source)
            (fail! :credentials-invalidated profile-id :operation-invalidated))
        item (case (:type p)
               :google-browser (google-token! resolver profile-id)
               :google-oauth (google-token! resolver source)
               :anthropic-google-oidc (anthropic-token! resolver profile-id))]
    (same-generation! resolver source before)
    (visible item (if (= :google-oauth (:type p))
                    {"x-goog-user-project" (:quota_project p)} {}))))

(defn status
  "Inspect configured profile, client metadata and keychain only. Does no HTTP
   or browser work. Returns safe {:profile :type :source? :state :expires-at-ms?}."
  [resolver profile-id]
  (let [p (get (:profiles resolver) profile-id)
        source (source-id resolver profile-id)
        base {:profile profile-id :type (:type p) :source source}]
    (if @(:closed resolver)
      (assoc base :state :closed)
      (try
        (let [entry (grant-entry resolver source)
              grant (fetch-grant resolver source entry)
              item (get @(:cache resolver) profile-id)]
          (cond-> (assoc base :state (if grant :ready :login-required))
            (valid-cache? resolver item) (assoc :expires-at-ms (:expires-at-ms item))))
        (catch Object _ (assoc base :state :error))))))

(defn login!
  "Run native Google browser login for a :google-browser profile. Returns safe
   status only; token values never appear in the result."
  [resolver profile-id]
  (assert-open! resolver profile-id)
  (let [p (get (:profiles resolver) profile-id)]
    (when-not (= :google-browser (:type p))
      (fail! :credentials-config profile-id :login-requires-google-source))
    (with-lock resolver profile-id
      (fn []
        (let [before (generation resolver profile-id)
              _ (when (contains? @(:invalidating resolver) profile-id)
                  (fail! :credentials-invalidated profile-id :operation-invalidated))
              client (client! resolver profile-id)
              entry (grant-entry resolver profile-id)
              result (safe-call profile-id :credentials-login :login-failed
                #(google/login! (fn [req] (bounded resolver profile-id req))
                                (:store resolver)
                                (fn [url] (open-browser! resolver profile-id url))
                                p client (:username entry) 300000))]
          (same-generation! resolver profile-id before)
          (when-not (:refresh-stored result)
            (fail! :credentials-login profile-id :grant-not-stored))
          (remember! resolver (:access-token result))
          (let [now ((:clock resolver))
                item {:token (:access-token result) :issued-at-ms now
                      :expires-at-ms (expiry resolver (:expires-in result))}]
            (swap! (:cache resolver) assoc profile-id item))
          {:profile profile-id :type :google-browser :state :ready})))))

(defn logout!
  "Erase the current local Google refresh grant and invalidate dependent caches.
   Does not claim server-side revocation. In-flight work is generation fenced."
  [resolver profile-id]
  (let [source (source-id resolver profile-id)]
    (swap! (:invalidating resolver) conj source)
    (swap! (:generations resolver) update source (fnil inc 0))
    (swap! (:cache resolver)
      (fn [cache]
        (into {} (remove (fn [[id _]] (= source (source-id resolver id))) cache))))
    (try
      (with-lock resolver source
        (fn []
          (let [entry (grant-entry resolver source)]
            (safe-call source :credentials-store :erase-failed
              #((:erase (:store resolver)) entry)))))
      (finally
        (swap! (:cache resolver)
          (fn [cache]
            (into {} (remove (fn [[id _]] (= source (source-id resolver id))) cache))))
        (swap! (:generations resolver) update source (fnil inc 0))
        (swap! (:invalidating resolver) disj source)))
    {:profile source :state :login-required}))

(defn close!
  "Fence all in-flight operations and discard only this resolver's memory state."
  [resolver]
  (reset! (:closed resolver) true)
  (doseq [id (keys (:profiles resolver))]
    (swap! (:generations resolver) update id (fnil inc 0)))
  (reset! (:cache resolver) {})
  (doseq [id (keys (:profiles resolver))]
    (with-lock resolver id (fn [] nil)))
  (reset! (:cache resolver) {})
  (reset! (:seen resolver) #{})
  {:state :closed})
