(ns attractor.pipeline
  (:require [attractor.engine :as engine]
            [attractor.context :as context]
            [attractor.parser :as parser]
            [attractor.status :as status]
            [attractor.transforms :as transforms]
            [attractor.validation :as validation]
            [attractor.workflow :as workflow]
            [clojure.string :as str]
            [os :as os]))

(defn prepare
  "Parse, transform, and validate DOT source without starting execution."
  ([dot-source] (prepare dot-source {}))
  ([dot-source options]
   (let [graph (parser/parse-dot dot-source)
         prepared-graph (transforms/apply-transforms
                          graph (or (:custom-transforms options) []))
         diagnostics (validation/validate
                       prepared-graph (or (:custom-rules options) []))]
     {:graph prepared-graph
     :diagnostics diagnostics
     :workflow (workflow/root-bundle dot-source prepared-graph options)})))

(def ^:private wrapper-option-keys
  [:custom-transforms
   :custom-rules
   :on-prepared
   :on-published
   :source-loader
   :source-path
   :base-dir
   :workflow-roots])

(defn execute-prepared
  "Validate and execute a prepared root workflow without reparsing its source."
  ([prepared] (execute-prepared prepared {}))
  ([prepared options]
   (let [diagnostics (validation/raise-on-errors (:diagnostics prepared))
         graph (:graph prepared)
         bundle (workflow/verify-bundle! (:workflow prepared) graph)
         engine-options
         (assoc (apply dissoc options wrapper-option-keys)
                :workflow-fingerprint (:fingerprint bundle)
                :workflow-manifest workflow/manifest-relative-path)
         outcome (engine/run-pipeline graph engine-options)]
     (assoc outcome :diagnostics diagnostics))))

(def ^:private resume-runtime-option-keys
  [:registry
   :on-event
   :cancelled?
   :max-steps
   :now-ms
   :random-fn
   :retry-policy
   :sleep-fn])

(defn- checkpoint-parent [checkpoint-path]
  (let [index (str/last-index-of checkpoint-path "/")]
    (cond
      (nil? index) "."
      (zero? index) "/"
      :else (subs checkpoint-path 0 index))))

(defn- snapshot-missing! [message data]
  (throw (ex-info message (merge {:category :workflow_snapshot_missing} data))))

(defn- snapshot-corrupt! [message data]
  (throw (ex-info message (merge {:category :workflow_snapshot_corrupt} data))))

(defn- resolve-checkpoint-path! [checkpoint-path]
  (when-not (and (string? checkpoint-path)
                 (not (str/blank? checkpoint-path)))
    (snapshot-missing! "Workflow checkpoint is missing"
                       {:kind :checkpoint :path checkpoint-path}))
  (try
    (os/canonical-path checkpoint-path)
    (catch Object _
      (snapshot-missing! "Workflow checkpoint is missing"
                         {:kind :checkpoint :path checkpoint-path}))))

(defn- load-pinned-checkpoint! [resolved-checkpoint-path]
  (try
    (context/load-checkpoint resolved-checkpoint-path)
    (catch Object cause
      (snapshot-corrupt! "Workflow checkpoint cannot be read"
                         {:kind :checkpoint
                          :path resolved-checkpoint-path
                          :cause (str cause)}))))

(defn- require-checkpoint-identity! [checkpoint]
  (let [manifest-path (:workflow_manifest checkpoint)
        fingerprint (:workflow_fingerprint checkpoint)]
    (when (nil? manifest-path)
      (snapshot-missing! "Workflow checkpoint has no snapshot manifest"
                         {:kind :manifest
                          :workflow-manifest manifest-path}))
    (when-not (= workflow/manifest-relative-path manifest-path)
      (snapshot-corrupt! "Workflow checkpoint manifest path is not canonical"
                         {:kind :checkpoint
                          :workflow-manifest manifest-path}))
    (when (nil? fingerprint)
      (snapshot-missing! "Workflow checkpoint has no snapshot fingerprint"
                         {:kind :fingerprint}))
    fingerprint))

(defn- failed-checkpoint-outcome? [outcome]
  (= :fail (:status (status/normalize-contract outcome :status))))

(defn- node-retry-target [node]
  (or (when-not (str/blank? (:retry_target node)) (:retry_target node))
      (when-not (str/blank? (:fallback_retry_target node))
        (:fallback_retry_target node))))

(defn- goal-gate-retry-target [node graph]
  (or (node-retry-target node)
      (when-not (str/blank? (:retry_target graph)) (:retry_target graph))
      (when-not (str/blank? (:fallback_retry_target graph))
        (:fallback_retry_target graph))))

(defn- outcome-field-present? [outcome field]
  (or (contains? outcome field)
      (contains? outcome (name field))))

(defn- outcome-field-value [outcome field]
  (if (contains? outcome field)
    (get outcome field)
    (get outcome (name field))))

(defn- declared-retry-transition? [graph outcomes prior-node-ids from-id to-id]
  (let [from-node (parser/find-node graph from-id)
        from-outcome (get outcomes from-id)]
    (or
      ;; Ordinary failure routing can jump from the just-completed node to its
      ;; declared node-local repair target.
      (and (failed-checkpoint-outcome? from-outcome)
           (= to-id (node-retry-target from-node)))
      ;; A terminal goal-gate check does not append the terminal node. Its
      ;; reroute therefore appears adjacent to whichever executed node preceded
      ;; that terminal, while the failed gate may be earlier in history.
      (some
        (fn [node-id]
          (let [node (parser/find-node graph node-id)]
            (and (:goal_gate node)
                 (failed-checkpoint-outcome? (get outcomes node-id))
                 (= to-id (goal-gate-retry-target node graph)))))
        prior-node-ids))))

(defn- valid-checkpoint-transition?
  [graph outcomes prior-node-ids [from-id to-id]]
  (or (some #(= to-id (:to %)) (parser/outgoing-edges graph from-id))
      (let [from-outcome (get outcomes from-id)]
        (and (outcome-field-present? from-outcome :next_node_id)
             (= to-id (outcome-field-value from-outcome :next_node_id))))
      (declared-retry-transition?
        graph outcomes prior-node-ids from-id to-id)))

(defn- validate-checkpoint-map! [checkpoint graph completed-set field]
  (let [records (get checkpoint field)]
    (when-not (and (map? records)
                   (every?
                     (fn [node-id]
                       (and (string? node-id)
                            (parser/find-node graph node-id)
                            (contains? completed-set node-id)))
                     (keys records)))
      (snapshot-corrupt! "Workflow checkpoint records do not match completed nodes"
                         {:kind :checkpoint
                          :field field
                          :node-ids (vec (keys records))}))))

(defn- invalid-checkpoint-value!
  [field node-id value & [outcome-field]]
  (snapshot-corrupt!
    "Workflow checkpoint contains an invalid value"
    (cond-> {:kind :checkpoint
             :field field
             :node-id node-id
             :value value}
      outcome-field (assoc :outcome-field outcome-field))))

(defn- validate-checkpoint-outcome! [graph node-id outcome]
  (when-not (map? outcome)
    (invalid-checkpoint-value! :node_outcomes node-id outcome))
  (when-not (status/normalize-contract outcome :status)
    (let [status-value (outcome-field-value outcome :status)
          invalid-optional
          (first
            (filter
              (fn [[field valid?]]
                (and (outcome-field-present? outcome field)
                     (not (valid? (outcome-field-value outcome field)))))
              [[:preferred_label string?]
               [:suggested_next_ids
                (fn [ids]
                  (and (sequential? ids) (every? string? ids)))]
               [:context_updates map?]
               [:notes string?]]))]
      (if invalid-optional
        (let [field (first invalid-optional)]
          (invalid-checkpoint-value!
            :node_outcomes node-id (outcome-field-value outcome field) field))
        (invalid-checkpoint-value!
          :node_outcomes node-id status-value :status))))
  (when (outcome-field-present? outcome :next_node_id)
    (let [next-node-id (outcome-field-value outcome :next_node_id)]
      (when-not (and (string? next-node-id)
                     (parser/find-node graph next-node-id))
        (invalid-checkpoint-value!
          :node_outcomes node-id next-node-id :next_node_id)))))

(defn- validate-checkpoint-values! [checkpoint graph]
  (doseq [[node-id retry-count] (:node_retries checkpoint)]
    (when-not (and (integer? retry-count) (not (neg? retry-count)))
      (invalid-checkpoint-value!
        :node_retries node-id retry-count)))
  (doseq [[node-id outcome] (:node_outcomes checkpoint)]
    (validate-checkpoint-outcome! graph node-id outcome)))

(defn- validate-checkpoint-graph! [checkpoint graph]
  (let [current-node (:current_node checkpoint)
        completed (:completed_nodes checkpoint)
        completed-set (if (vector? completed) (into #{} completed) #{})]
    (when-not (and (string? current-node)
                   (parser/find-node graph current-node))
      (snapshot-corrupt! "Workflow checkpoint node is not in the captured plan"
                         {:kind :checkpoint
                          :current-node current-node}))
    (when-not (and (vector? completed)
                   (= current-node (last completed))
                   (every? #(and (string? %)
                                 (parser/find-node graph %))
                           completed))
      (snapshot-corrupt! "Workflow checkpoint history does not match the captured plan"
                         {:kind :checkpoint
                          :current-node current-node
                          :completed-nodes completed}))
    (validate-checkpoint-map! checkpoint graph completed-set :node_outcomes)
    (validate-checkpoint-map! checkpoint graph completed-set :node_retries)
    (validate-checkpoint-values! checkpoint graph)
    (when-not
      (every?
        (fn [[index transition]]
          (valid-checkpoint-transition?
            graph
            (:node_outcomes checkpoint)
            (subvec completed 0 (inc index))
            transition))
        (map-indexed vector (partition 2 1 completed)))
      (snapshot-corrupt! "Workflow checkpoint history does not match the captured plan"
                         {:kind :checkpoint
                          :current-node current-node
                          :completed-nodes completed}))
    checkpoint))

(defn- drift-diagnostic [changes]
  {:rule "workflow_drift"
   :severity :warning
   :message (str "Pinned workflow differs from current sources: "
                 (pr-str changes))})

(defn resume
  "Resume from an immutable, fingerprint-verified workflow snapshot.

   Current source files are inspected only for drift diagnostics. Execution is
   always delegated with the exact decoded root graph from the published run."
  ([checkpoint-path] (resume checkpoint-path {}))
  ([checkpoint-path options]
   (let [resolved-checkpoint-path (resolve-checkpoint-path! checkpoint-path)
         checkpoint (load-pinned-checkpoint! resolved-checkpoint-path)
         expected-fingerprint (require-checkpoint-identity! checkpoint)
         run-root (checkpoint-parent resolved-checkpoint-path)
         verified (workflow/verify-published! run-root expected-fingerprint)
         _ (validate-checkpoint-graph! checkpoint (:graph verified))
         changes (workflow/current-drift (:workflow verified) options)
         caller-on-event (or (:on-event options) (fn [_] nil))
         engine-options
         (assoc (select-keys options resume-runtime-option-keys)
                :logs-root run-root
                :on-event caller-on-event
                :workflow-fingerprint expected-fingerprint
                :workflow-manifest workflow/manifest-relative-path)
         _ (when (seq changes)
             (caller-on-event {:type :workflow.drift_detected
                               :changes changes}))
         outcome (engine/resume-pipeline-from-checkpoint
                   checkpoint (:graph verified) engine-options)]
     (assoc outcome :diagnostics
            (if (seq changes) [(drift-diagnostic changes)] [])))))

(defn- fresh-logs-root []
  (let [printed (str (random-uuid))
        uuid (or (second (re-find #"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})"
                                  printed))
                 printed)]
    (str "attractor_runs/run_" (System/currentTimeMillis) "-" uuid)))

(defn run
  "Prepare DOT source, reject validation errors, then execute the prepared graph.

   The wrapper-only :on-prepared callback receives the exact prepare result once,
   after error gating and before the engine or its events start. It is not
   forwarded to the engine; if it throws, execution does not start and the
   exception propagates."
  ([dot-source] (run dot-source {}))
  ([dot-source options]
   (let [prepared (prepare dot-source options)
         diagnostics (:diagnostics prepared)
         diagnostics (validation/raise-on-errors diagnostics)
         _ (when-let [on-prepared (:on-prepared options)]
             (on-prepared prepared))
         logs-root (or (:logs-root options) (fresh-logs-root))
         manifest-path (workflow/publish! (:workflow prepared) logs-root)
         _ (when-let [on-published (:on-published options)]
             (on-published prepared manifest-path))]
     (execute-prepared
       (assoc prepared :diagnostics diagnostics)
       (assoc options :logs-root logs-root)))))
