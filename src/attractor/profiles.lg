(ns attractor.profiles
  (:require [clojure.string :as str] [attractor.tool-images :as tool-images]
            [attractor.patch :as patch]
            [attractor.execution :as execution]))

(defn- validate-registered-tool! [tool]
  (let [definition (:definition tool)
        tool-name (:name definition)
        parameters (:parameters definition)
        schema-type (or (:type parameters) (get parameters "type"))]
    (when (str/blank? tool-name)
      (throw (ex-info "Registered tool definition requires a name"
                      {:category :invalid-tool-definition})))
    (when-not (= "object" (if (keyword? schema-type)
                            (name schema-type)
                            schema-type))
      (throw
        (ex-info "Registered tool parameters must use an object schema"
                 {:category :invalid-tool-definition
                  :tool_name tool-name})))
    tool))

(defn make-tool-registry [& [tools]]
  (let [initial-tools (or tools [])]
    (doseq [tool initial-tools]
      (validate-registered-tool! tool))
    (atom (into {} (map (fn [tool]
                          [(get-in tool [:definition :name]) tool])
                        initial-tools)))))

(defn register-tool! [registry tool]
  (let [validated (validate-registered-tool! tool)
        name (get-in validated [:definition :name])]
    (swap! registry assoc name tool)
    tool))

(defn unregister-tool! [registry name]
  (swap! registry dissoc name)
  nil)

(defn registry-get [registry name]
  (get @registry name))

(defn registry-names [registry]
  (vec (sort (keys @registry))))

(defn registry-definitions [registry]
  (mapv (fn [name] (:definition (get @registry name)))
        (registry-names registry)))

;; Compatibility aliases for the original public registry API.
(defn register-tool [registry tool-definition executor]
  (register-tool! registry {:definition tool-definition :executor executor})
  registry)

(defn get-tool [registry name]
  (registry-get registry name))

(defn tool-definitions [registry]
  (registry-definitions registry))

(defn tool-names [registry]
  (registry-names registry))

(defn make-tool-definition [name description parameters]
  {:name name :description description :parameters parameters})

(defn make-profile [opts]
  (merge {:id "custom"
          :model ""
          :tool_registry (make-tool-registry)
          :provider_options {}
          :supports_reasoning true
          :supports_streaming true
          :supports_parallel_tool_calls true
          :context_window_size 128000
          :default_command_timeout_ms 10000
          :build_system_prompt
          (fn [environment project-docs]
            (str "You are a coding agent.\n"
                 "Working directory: " ((:working_directory environment)) "\n"
                 "Platform: " ((:platform environment))
                 (when (seq project-docs)
                   (str "\n\nProject instructions:\n"
                        (str/join "\n\n" project-docs)))))}
         opts))

(defn make-provider-profile
  [id model tool-registry system-prompt build-system-prompt
   supports-reasoning supports-streaming supports-parallel-tools
   context-window-size provider-options]
  (make-profile
    {:id id :model model :tool_registry tool-registry
     :system_prompt system-prompt :build_system_prompt build-system-prompt
     :supports_reasoning supports-reasoning
     :supports_streaming supports-streaming
     :supports_parallel_tool_calls supports-parallel-tools
     :context_window_size context-window-size
     :provider_options provider-options}))

(defn profile-tools [profile]
  (registry-definitions (:tool_registry profile)))

(defn build-system-prompt [profile environment project-docs]
  ((:build_system_prompt profile) environment project-docs))

(defn- arg [arguments key]
  (if (contains? arguments key)
    (get arguments key)
    (get arguments (keyword key))))

(defn- definition [name description properties required]
  {:name name :description description
   :parameters (cond-> {:type "object" :properties properties}
                 (seq required) (assoc :required required))})

(defn- registered [definition executor]
  {:definition definition :executor executor})

(defn- read-file-for-tool [environment path offset limit]
  (if-let [read-tool (or (:read_file_tool environment)
                        (when (= :tool (:read_file_format environment))
                          (:read_file environment)))]
    (read-tool path offset limit)
    (let [raw ((:read_file environment) path nil nil)]
      (if (string? raw)
        (execution/format-file-text raw offset limit)
        raw))))

(defn- read-edit-text [environment path]
  ;; The optional raw reader supports environments whose tool-facing
  ;; read_file adds line numbers or pagination (including the local adapter).
  ;; Spec-only environments provide full text through read_file(path,nil,nil).
  (let [content (if-let [read-text (:read_text environment)]
                  (read-text path)
                  (do
                    (when (= :tool (:read_file_format environment))
                      (throw (ex-info "Formatted file reader requires read_text for editing"
                                      {:category :unsupported-operation
                                       :operation :read_text :path path})))
                    ((:read_file environment) path nil nil)))]
    (when-not (string? content)
      (throw (ex-info "Editing requires a text file"
                      {:category :unsupported-binary-file :path path})))
    content))

(defn- edit-file-through-environment [environment path old-string new-string replace-all]
  (when (empty? old-string)
    (throw (ex-info "old_string must not be empty" {:category :invalid-edit})))
  (let [content (read-edit-text environment path)
        matches (loop [start 0 total 0]
                  (if-let [index (str/index-of content old-string start)]
                    (recur (+ index (count old-string)) (inc total))
                    total))]
    (when (zero? matches)
      (throw (ex-info "old_string was not found"
                      {:category :edit-not-found :path path})))
    (when (and (> matches 1) (not replace-all))
      (throw (ex-info "old_string is not unique; provide more context or set replace_all"
                      {:category :edit-not-unique :matches matches :path path})))
    ((:write_file environment) path
      (if replace-all
        (str/replace content old-string new-string)
        (str/replace-first content old-string new-string)))
    (if replace-all matches 1)))

(defn- patch-delete-operation [environment]
  (or (:delete_file environment)
      ;; The specified file interface omits deletion. POSIX environments can
      ;; perform it through their own command interface; other environments
      ;; can provide delete_file without emulating a shell. Never use os/sh.
      (when (and (:exec_command environment)
                 (:platform environment)
                 (contains? #{"linux" "darwin"} ((:platform environment))))
        (fn [path]
          (let [quoted (str "'" (str/replace path "'" "'\"'\"'") "'")
                result ((:exec_command environment) (str "rm -f -- " quoted)
                        (or (:default_command_timeout_ms environment) 10000) nil nil)]
            (when (or (not= 0 (:exit_code result))
                      (:timed_out result) (:cancelled result)
                      ((:file_exists environment) path))
              (throw (ex-info (str "Unable to delete file through execution environment: " path)
                              {:category :patch-delete-failed :path path
                               :exit_code (:exit_code result)
                               :stderr (:stderr result)}))))))))

(defn- apply-patch-through-environment [environment patch-text]
  (patch/apply-patch-with-files
    {:file_exists (:file_exists environment)
     ;; Missing raw access is a capability failure, so the patch engine must
     ;; detect it before an earlier add/delete operation changes anything.
     :read_file (when (or (:read_text environment)
                          (and (:read_file environment)
                               (not= :tool (:read_file_format environment))))
                  (fn [path] (read-edit-text environment path)))
     :write_file (:write_file environment)
     :delete_file (patch-delete-operation environment)}
    patch-text))

(defn- base-tools [edit-kind default-shell-timeout grep-output-modes]
  (let [read-def (definition "read_file" "Read a line-numbered file"
                             {:file_path {:type "string"}
                              :offset {:type "integer"}
                              :limit {:type "integer"}}
                             ["file_path"])
        write-def (definition "write_file" "Write a complete file"
                              {:file_path {:type "string"}
                               :content {:type "string"}}
                              ["file_path" "content"])
        edit-def (definition edit-kind "Modify files"
                             (if (= edit-kind "apply_patch")
                               {:patch {:type "string"}}
                               {:file_path {:type "string"}
                                :old_string {:type "string"}
                                :new_string {:type "string"}
                                :replace_all {:type "boolean"}})
                             (if (= edit-kind "apply_patch")
                               ["patch"]
                               ["file_path" "old_string" "new_string"]))
        shell-def (definition "shell" "Execute a shell command"
                              {:command {:type "string"}
                               :timeout_ms {:type "integer"}
                               :description {:type "string"}}
                              ["command"])
        grep-def (definition "grep" "Search file contents"
                             (cond->
                               {:pattern {:type "string"}
                                :path {:type "string"}
                                :glob_filter {:type "string"}
                                :case_insensitive {:type "boolean"}
                                :max_results {:type "integer"}}
                               grep-output-modes
                               (assoc :output_mode
                                      {:type "string"
                                       :enum ["content"
                                              "files_with_matches"
                                              "count"]}))
                             ["pattern"])
        glob-def (definition "glob" "Find files by pattern"
                             {:pattern {:type "string"} :path {:type "string"}}
                             ["pattern"])]
    (vec
      (remove
        nil?
        [(registered read-def
                 (fn [args env]
                   (read-file-for-tool env (arg args "file_path")
                                       (arg args "offset") (arg args "limit"))))
         (registered write-def
                 (fn [args env]
                   (let [content (arg args "content")
                         byte-count (count (.getBytes content "UTF-8"))]
                     ((:write_file env) (arg args "file_path") content)
                     (str "File written: " byte-count " bytes"))))
         (registered edit-def
                 (if (= edit-kind "apply_patch")
                   (fn [args env]
                     (if-let [apply-patch (:apply_patch env)]
                       (apply-patch (arg args "patch"))
                       (apply-patch-through-environment env (arg args "patch"))))
                   (fn [args env]
                     (let [edit (or (:edit_file env)
                                    (fn [path old-string new-string replace-all]
                                      (edit-file-through-environment
                                        env path old-string new-string replace-all)))]
                       (edit (arg args "file_path")
                             (arg args "old_string")
                             (arg args "new_string")
                             (boolean (arg args "replace_all")))))))
     (assoc (registered shell-def
                 (fn [args env]
                   ((:exec_command env) (arg args "command")
                    (min (or (:max_command_timeout_ms env) 600000)
                         (max 1 (or (arg args "timeout_ms")
                                    default-shell-timeout
                                    (:default_command_timeout_ms env)
                                    10000)))
                    nil nil)))
            ;; This classifier belongs to this registry entry. A custom shell
            ;; replacement does not inherit native command-result semantics.
            :result_is_error
            (fn [result]
              (and (map? result)
                   (or (true? (:timed_out result))
                       (true? (:cancelled result))
                       (and (number? (:exit_code result))
                            (not= 0 (:exit_code result)))))))
     (registered grep-def
                 (fn [args env]
                   ((:grep env) (arg args "pattern") (arg args "path") args)))
         (registered glob-def
                 (fn [args env]
                   ((:glob env) (arg args "pattern") (arg args "path"))))]))))

(defn- profile-registry
  [edit-kind default-shell-timeout grep-output-modes extra-tools]
  (make-tool-registry
    (concat (base-tools edit-kind default-shell-timeout grep-output-modes)
            extra-tools)))

(defn- provider-prompt [instructions]
  (fn [environment project-docs]
    (str instructions "\n\n"
         "Working directory: " ((:working_directory environment)) "\n"
         "Platform: " ((:platform environment))
         (when (seq project-docs)
           (str "\n\nProject instructions:\n" (str/join "\n\n" project-docs))))))

(defn create-openai-profile [& [model]]
  (make-profile
    {:id "openai" :model (or model "gpt-5.2-codex")
     :tool_registry (profile-registry "apply_patch" nil false [])
     :build_system_prompt
     (provider-prompt
       (str
         "You are an OpenAI Codex coding agent. Work directly in the repository "
         "and use the available tools to complete the user's request.\n"
         "Inspect relevant files before changing them. Use read_file and search "
         "tools to gather context, and use shell for commands that materially "
         "advance or verify the task.\n"
         "Use apply_patch for precise file modifications. Every patch must use "
         "the v4a envelope beginning with `*** Begin Patch` and ending with "
         "`*** End Patch`; keep each patch scoped and preserve unrelated work.\n"
         "Prefer root-cause fixes and maintain the project's existing style. "
         "If a tool reports an error, diagnose it from the evidence before "
         "retrying. Verify changes with focused tests and then the appropriate "
         "broader checks."))}))

(defn create-anthropic-profile [& [model]]
  (make-profile
    {:id "anthropic" :model (or model "claude-opus-4.6")
     :tool_registry (profile-registry "edit_file" 120000 true [])
     :default_command_timeout_ms 120000
     :build_system_prompt
     (provider-prompt
       (str
         "You are an Anthropic Claude coding agent. Use the available tools to "
         "understand the codebase, make requested changes, and validate them.\n"
         "Read before editing. Choose the narrowest suitable tool: search and "
         "read_file for investigation, edit_file for existing files, write_file "
         "for new or deliberately complete replacements, and shell for execution.\n"
         "With edit_file, old_string must match the file exactly and must be "
         "unique unless replace_all is intentionally true. Prefer editing an "
         "existing file over rewriting it with write_file, and preserve unrelated "
         "user changes.\n"
         "Fix underlying causes, follow repository conventions, handle tool errors "
         "from their evidence, and verify the result with focused and broader tests."))}))

(defn create-gemini-profile [& [model]]
  (let [read-many
        (registered
          (definition "read_many_files" "Read several files"
                      {:paths {:type "array" :items {:type "string"}}} ["paths"])
          (fn [args env]
            (let [paths (arg args "paths")
                  results (mapv (fn [path]
                                  (tool-images/normalize-output
                                    (read-file-for-tool env path nil nil))) paths)]
              (if-not (some tool-images/attachment-output? results) results
                {:content (str/join "\n\n"
                            (map (fn [path result]
                                   (str path "\n" (if (tool-images/attachment-output? result)
                                                     (:content result)
                                                     (if (string? result) result (pr-str result))))) paths results))
                 :images (vec (mapcat (fn [result]
                                       (if (tool-images/attachment-output? result)
                                         (or (:images result) [result]) [])) results))}))))
        list-dir
        (registered
          (definition "list_dir" "List directory entries"
                      {:path {:type "string"}
                       :depth {:type "integer"}} [])
          (fn [args env]
            ((:list_directory env)
             (or (arg args "path") ".")
             (or (arg args "depth") 1))))]
    (make-profile
      {:id "gemini" :model (or model "gemini-3-pro")
       :tool_registry (profile-registry "edit_file" nil false
                                        [read-many list-dir])
       :build_system_prompt
       (provider-prompt
         (str
           "You are a Google Gemini coding agent. Use the available tools to "
           "inspect, modify, and verify the repository.\n"
           "Treat applicable GEMINI.md files as project instructions. Use list_dir "
           "to understand directory structure, read_many_files when several files "
           "are relevant, search tools to locate code, edit_file for exact scoped "
           "changes, and shell to run commands.\n"
           "Read relevant code before editing, preserve unrelated work, follow the "
           "project's conventions, address root causes, recover thoughtfully from "
           "tool errors, and verify changes with focused tests and broader checks."))})))

(defn create-profile [provider model]
  (case provider
    "openai" (create-openai-profile model)
    "anthropic" (create-anthropic-profile model)
    "gemini" (create-gemini-profile model)
    (make-profile {:id provider :model model
                   :tool_registry (profile-registry "edit_file" nil false
                                                    [])})))

(defn get-profile-by-id [id]
  (case (str/lower-case (or id ""))
    "openai" (create-openai-profile)
    "anthropic" (create-anthropic-profile)
    "claude" (create-anthropic-profile)
    "gemini" (create-gemini-profile)
    nil))

(def available-providers ["openai" "anthropic" "gemini"])
