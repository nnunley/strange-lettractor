(ns attractor.capture
  (:require [clojure.string :as str]
            [io :as io]
            [os :as os]
            [attractor.composition :as composition]
            [attractor.workflow :as workflow]))

(defn- source-error! [reason reference]
  (throw (ex-info "Cannot resolve subpipeline source"
                  {:category :subpipeline_source :reason reason :reference reference})))

(defn- nonblank-string? [value]
  (and (string? value) (not (str/blank? value))))

(defn- valid-source [source reference]
  ;; seq decodes UTF-8, replacing malformed byte sequences. Re-encoding must
  ;; reproduce the exact input bytes, including valid literal replacement chars.
  (when-not (= source (apply str (seq source)))
    (source-error! :invalid-utf8 reference))
  source)

(defn- load-injected [loader containing reference]
  (let [record (try (loader containing reference)
                   (catch Exception _ (source-error! :loader-failed reference)))]
    (when-not (and (map? record)
                   (nonblank-string? (:logical-id record))
                   (nonblank-string? (:physical-id record))
                   (string? (:source record)))
      (source-error! :invalid-loader-result reference))
    {:logical-id (:logical-id record)
     :physical-id (:physical-id record)
     :source (valid-source (:source record) reference)}))

(defn- parent-path [path]
  (let [index (str/last-index-of path "/")]
    (cond (nil? index) "." (zero? index) "/" :else (subs path 0 index))))

(defn- root-prefix [root]
  (if (= "/" (:path root)) "/" (str (:path root) "/")))

(defn- authorized-root [roots physical-id]
  (first
    (sort (fn [left right]
            (let [length-order (compare (count (:path right)) (count (:path left)))]
              (if (zero? length-order)
                (compare (:id left) (:id right))
                length-order)))
          (filter (fn [root] (str/starts-with? physical-id (root-prefix root))) roots))))

(defn- load-filesystem [containing reference options]
  (when-not (nonblank-string? reference)
    (source-error! :invalid-reference reference))
  (when-not (str/ends-with? reference ".dot")
    (source-error! :invalid-extension reference))
  (let [base (if (:physical-id containing)
               (parent-path (:physical-id containing))
               (:base-dir options))]
    (when-not (nonblank-string? base)
      (source-error! :missing-base-dir reference))
    (let [roots (workflow/configured-roots options)
          ;; Do not lexical-clean before canonicalization: link/.. must follow
          ;; the link's actual parent, not its lexical parent.
          candidate (if (str/starts-with? reference "/") reference (str base "/" reference))
          physical-id (try (os/canonical-path candidate)
                           (catch Exception _ (source-error! :unavailable-source reference)))
          root (authorized-root roots physical-id)]
      (when-not root (source-error! :outside-roots reference))
      (when-not (str/ends-with? physical-id ".dot")
        (source-error! :invalid-extension reference))
      (let [source (try (io/slurp physical-id)
                       (catch Exception _ (source-error! :unavailable-source reference)))]
        {:logical-id (str "workflow://" (:id root) "/"
                          (subs physical-id (count (root-prefix root))))
         :physical-id physical-id
         :source (valid-source source reference)}))))

(defn resolve-source
  "Resolve one child source, without parsing or caching.
   Default filesystem loading canonicalizes symlinks and authorizes the path
   against :workflow-roots before reading bytes. Preserve the root bundle's
   :workflow-roots in recursive callers. In-memory parents require :base-dir.
   :source-loader is a trusted caller function of containing record and literal
   reference; it owns virtual-source authorization and stable physical identity.
   Injected results are validated but are not subject to filesystem confinement."
  [containing reference options]
  (if (contains? options :source-loader)
    (load-injected (:source-loader options) containing reference)
    (load-filesystem containing reference options)))

(defn- diagnostic [rule node message]
  {:rule rule :severity :error :node_id (:id node) :message message})

(defn- child-diagnostic [node chain d]
  {:rule (:rule d) :severity (:severity d) :node_id (:id node)
   :message (str "Subpipeline node '" (:id node) "' child '" (last chain)
                 "' (" (str/join " -> " chain) "): " (:rule d)
                 (when (:node_id d) (str " node '" (:node_id d) "'"))
                 (when (:edge d) (str " edge " (pr-str (:edge d))))
                 ": " (:message d))})

(defn prepare-closure
  "Capture a depth-first closure using a caller-owned single-source preparer.
   Physical plans are prepared once; logical aliases reuse their captured bytes."
  [source options prepare-source]
  (let [root-prepared (prepare-source source)
        root-bundle (workflow/root-bundle source (:graph root-prepared) options)
        root-record (first (:source-records root-bundle))
        options (assoc options :workflow-roots (:workflow-roots root-bundle))
        records (atom {}) plans (atom {}) completed (atom {})
        identities (atom {}) active (atom #{})
        diagnostics (atom (vec (:diagnostics root-prepared)))]
    (letfn [(physical [record] (:physical-id record))
            (emit! [d] (swap! diagnostics conj d))
            (preparation-error! [node reference chain error]
              (emit! (diagnostic "subpipeline_source" node
                       (str "Subpipeline node '" (:id node) "' cannot load '" reference "': "
                            "child '" (last chain) "' (" (str/join " -> " chain)
                            ") preparation failed: " (str error)))))
            (visit [record prepared chain]
              (let [id (:logical-id record) pid (physical record)]
                (swap! identities assoc id pid)
                (swap! active conj pid)
                (swap! records assoc id record)
                (let [graph (:graph prepared)
                      references (reduce
                        (fn [refs [_ node]]
                          (if (= "subpipeline" (:type node))
                            (if-let [config (:config (composition/node-config node graph))]
                              (if-let [target (capture-child record node (:dotfile config) chain)]
                                (conj refs {:node-id (:id node) :logical-reference (:dotfile config) :plan-id target}) refs)
                              refs)
                            refs)) [] (sort-by first (:nodes graph)))
                      plan (assoc (:captured-plan prepared) :references references)]
                  (swap! plans assoc id plan)
                  (swap! completed assoc pid {:record record :plan plan :diagnostics (:diagnostics prepared)})
                  (swap! active disj pid)
                  id)))
            (capture-child [containing node reference chain]
              (let [resolved (try {:record (resolve-source containing reference options)}
                                  (catch Exception e {:error e}))]
                (if-let [error (:error resolved)]
                  (do (emit! (diagnostic "subpipeline_source" node
                               (str "Subpipeline node '" (:id node) "' cannot load '" reference "': "
                                    (or (:reason (ex-data error)) (str error))))) nil)
                  (let [record (:record resolved) id (:logical-id record)
                        pid (physical record) child-chain (conj chain id)]
                    (cond
                      (contains? @active pid)
                      (do (emit! (diagnostic "subpipeline_cycle" node
                                   (str "Subpipeline node '" (:id node) "' introduces source cycle: "
                                        (str/join " -> " child-chain)))) nil)
                      (and (contains? @identities id) (not= pid (get @identities id)))
                      (do (emit! (diagnostic "workflow_identity_collision" node
                                   (str "Subpipeline node '" (:id node) "' has workflow identity collision for '" id
                                        "' (" (str/join " -> " child-chain) ")"))) nil)
                      (contains? @completed pid)
                      (let [known (get @completed pid)]
                        (swap! identities assoc id pid)
                        (if-let [error (:error known)]
                          (do (preparation-error! node reference child-chain error) nil)
                          (do
                            (swap! records assoc id (assoc (:record known) :logical-id id))
                            (swap! plans assoc id (:plan known))
                            (doseq [d (:diagnostics known)] (emit! (child-diagnostic node child-chain d)))
                            id)))
                      :else
                      (let [result (try
                                     (let [prepared (prepare-source (:source record))
                                           plan (workflow/captured-plan (:source record) (:graph prepared) id [])]
                                       {:prepared (assoc prepared :captured-plan plan)})
                                        (catch Exception e {:error e}))]
                        (if-let [error (:error result)]
                          (do (swap! identities assoc id pid)
                              (swap! completed assoc pid {:error error})
                              (preparation-error! node reference child-chain error) nil)
                          (let [prepared (:prepared result)]
                            (doseq [d (:diagnostics prepared)] (emit! (child-diagnostic node child-chain d)))
                            (visit record prepared child-chain)))))))))]
      (visit root-record (assoc root-prepared :captured-plan
                                (get-in root-bundle [:plans workflow/root-plan-id]))
             [workflow/root-plan-id])
      {:graph (:graph root-prepared) :diagnostics @diagnostics
       :workflow (workflow/captured-bundle (vec (vals @records)) @plans (:workflow-roots root-bundle))})))
