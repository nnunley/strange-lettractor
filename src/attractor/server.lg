(ns attractor.server
  (:require [attractor.ids :as ids] [clojure.string :as str] [clojure.core :as core]
            [json :as json]
            [io :as io]
            [os :as os]
            [attractor.pipeline :as pipeline]
            [attractor.context :as context]
            [attractor.handlers :as handlers]
            [attractor.interviewer :as interviewer]
            [attractor.workflow :as workflow-lib]
            [http :as http]))

;; In-memory pipeline registry: id -> pipeline state map
(def active-pipelines (atom {}))

;; Helper to make JSON response
(defn json-response [data & [status]]
  {:status (or status 200)
   :headers {"Content-Type" "application/json"
             "Access-Control-Allow-Origin" "*"}
   :body (json/write-json data)})

;; Helper to make plain text response
(defn text-response [text & [status]]
  {:status (or status 200)
   :headers {"Content-Type" "text/plain"
             "Access-Control-Allow-Origin" "*"}
   :body (str text)})

(defn svg-response [svg]
  {:status 200
   :headers {"Content-Type" "image/svg+xml"
             "Access-Control-Allow-Origin" "*"}
   :body svg})

(defn render-graph-svg [dot-source]
  (let [dot-path (str (os/temp-dir) "/strange-lettractor-" (ids/uuid-text) ".dot")]
    (try
      (io/spit dot-path dot-source)
      (let [result (os/sh "dot" "-Tsvg" dot-path)]
        (if (zero? (:exit result))
          (:out result)
          (throw (ex-info (str "Graphviz failed: " (:err result))
                          {:exit (:exit result)}))))
      (finally
        (os/sh "rm" "-f" dot-path)))))

;; Handle POST /pipelines (start pipeline)
(defn handle-start-pipeline [req]
  (try
    (let [body (:body req)
          body-data (if (string? body)
                      (if (str/starts-with? (str/trim body) "{")
                        (json/read-json body)
                        {"dot" body})
                      body)
          dot-source (or (get body-data "dot") (get body-data :dot) "")
          pipeline-id (ids/prefixed "pipe")
          events-atom (atom [])
          questions-atom (atom {})
          pending-answers (atom {})
          cancelled (atom false)
          ctx (context/make-context)
          logs-dir (str "attractor_runs/" pipeline-id)
          preparation-timeout-ms (or (:preparation-timeout-ms req) 30000)
          prepared-signal (promise)
          preparation-phase (atom :waiting)]

      ;; Custom interviewer for web human-gates
      (let [web-interviewer (reify interviewer/IInterviewer
                              (ask [_ q]
                                (let [qid (str "q-" (System/currentTimeMillis))]
                                  (swap! questions-atom assoc qid q)
                                  ;; Wait for answer to be posted or timeout
                                  (loop [wait-ms 0]
                                    (if @cancelled
                                      (do
                                        (swap! questions-atom dissoc qid)
                                        {:value :cancelled :text "cancelled"})
                                      (if-let [ans (get @pending-answers qid)]
                                      (do
                                        (swap! questions-atom dissoc qid)
                                        (swap! pending-answers dissoc qid)
                                        ans)
                                      (if (> wait-ms 30000) ; 30s timeout
                                        (do
                                          (swap! questions-atom dissoc qid)
                                          (or (:default q) {:value :timeout :text "timeout"}))
                                        (do
                                          (core/sleep 200)
                                          (recur (+ wait-ms 200)))))))))
                              (ask-multiple [this questions]
                                (vec (map (fn [q] (interviewer/ask this q)) questions)))
                              (inform [_ _ _] nil))

            registry (handlers/make-handler-registry web-interviewer nil)

            on-event (fn [ev]
                       (swap! events-atom conj ev))
            on-prepared
            (fn [_]
              ;; Preparation is a validation gate, not a durable publication.
              (when-not (= :waiting @preparation-phase)
                (reset! cancelled true)
                (throw (ex-info "Pipeline preparation was abandoned"
                                {:category :preparation_abandoned}))))
            matching-registration?
            (fn [fingerprint manifest-path]
              (let [registered (get @active-pipelines pipeline-id)]
                (and (= fingerprint (:workflow_fingerprint registered))
                     (= manifest-path (:workflow_manifest registered)))))
            require-matching-registration!
            (fn [fingerprint manifest-path]
              (when-not (matching-registration? fingerprint manifest-path)
                (throw (ex-info "Published workflow registration does not match"
                                {:category :workflow_snapshot_corrupt
                                 :path manifest-path}))))
            on-published
            (fn [{:keys [graph diagnostics workflow]} manifest-path]
              ;; The callback is the HTTP visibility boundary. Verify the exact
              ;; publication before racing the request timeout for ownership.
              (let [expected-path (str logs-dir "/" workflow-lib/manifest-relative-path)
                    fingerprint (:fingerprint workflow)
                    manifest (workflow-lib/read-manifest! manifest-path)
                    verified (workflow-lib/verify-published! logs-dir fingerprint)]
                (when-not (and (= expected-path manifest-path)
                               (= fingerprint (:fingerprint manifest))
                               (= fingerprint (get-in verified [:workflow :fingerprint])))
                  (throw (ex-info "Published workflow manifest does not match prepared workflow"
                                  {:category :workflow_snapshot_corrupt
                                   :path manifest-path})))
                (loop []
                  (case @preparation-phase
                    :registered
                    (require-matching-registration! fingerprint manifest-path)

                    :registering
                    (let [observed
                          (deref prepared-signal preparation-timeout-ms
                                 :attractor.server/registration-timeout)]
                      (if (= observed :attractor.server/registration-timeout)
                        (if (= :registered @preparation-phase)
                          (require-matching-registration! fingerprint manifest-path)
                          (throw (ex-info "Pipeline publication registration timed out"
                                          {:category :preparation_timeout})))
                        (if-let [error (:error observed)]
                          (throw error)
                          (require-matching-registration!
                            fingerprint manifest-path))))

                    :waiting
                    (if (compare-and-set! preparation-phase :waiting :registering)
                      (try
                        (swap! active-pipelines assoc pipeline-id
                               {:id pipeline-id
                                :graph graph
                                :dot dot-source
                                :status :running
                                :diagnostics diagnostics
                                :events events-atom
                                :questions questions-atom
                                :pending-answers pending-answers
                                :cancelled cancelled
                                :context ctx
                                :logs_root logs-dir
                                :workflow_fingerprint fingerprint
                                :workflow_manifest manifest-path})
                        (if (compare-and-set! preparation-phase
                                              :registering :registered)
                          (deliver prepared-signal {:graph graph})
                          (do
                            (swap! active-pipelines dissoc pipeline-id)
                            (throw (ex-info "Pipeline publication was abandoned"
                                            {:category :preparation_abandoned}))))
                        (catch Object e
                          (swap! active-pipelines dissoc pipeline-id)
                          (deliver prepared-signal {:error e})
                          (compare-and-set! preparation-phase
                                            :registering :failed)
                          (throw e)))
                      (recur))

                    :failed
                    (throw (ex-info "Pipeline publication registration failed"
                                    {:category :preparation_failed}))

                    :abandoned
                    (do
                      (reset! cancelled true)
                      (throw (ex-info "Pipeline publication was abandoned"
                                      {:category :preparation_abandoned})))))))]

        ;; Run in background future
        (core/future
          (try
            (let [outcome (pipeline/run dot-source
                                        {:context ctx
                                         :logs-root logs-dir
                                         :registry registry
                                         :cancelled? (fn [] @cancelled)
                                         :on-prepared on-prepared
                                         :on-published on-published
                                         :on-event on-event})]
              (swap! active-pipelines update pipeline-id assoc :status (:status outcome) :outcome outcome))
            (catch Object e
              (if (= :registered @preparation-phase)
                (swap! active-pipelines update pipeline-id assoc :status :fail :error (str e))
                (do
                  (swap! active-pipelines dissoc pipeline-id)
                  (deliver prepared-signal {:error e})
                  (compare-and-set! preparation-phase :waiting :failed)
                  (compare-and-set! preparation-phase :registering :failed))))))

        (let [timeout-error (ex-info "Pipeline preparation timed out"
                                     {:category :preparation_timeout})
              initial (deref prepared-signal preparation-timeout-ms
                             :attractor.server/preparation-timeout)
              prepared
              (if (= initial :attractor.server/preparation-timeout)
                (loop []
                  (case @preparation-phase
                    :waiting
                    (if (compare-and-set! preparation-phase :waiting :abandoned)
                      (do
                        (reset! cancelled true)
                        {:error timeout-error})
                      (recur))

                    :registering
                    (let [observed
                          (deref prepared-signal preparation-timeout-ms
                                 :attractor.server/registration-timeout)]
                      (if (= observed :attractor.server/registration-timeout)
                        (if (compare-and-set! preparation-phase
                                              :registering :abandoned)
                          (do
                            (reset! cancelled true)
                            (swap! active-pipelines dissoc pipeline-id)
                            {:error timeout-error})
                          (recur))
                        observed))

                    :registered
                    (if-let [registered (get @active-pipelines pipeline-id)]
                      {:graph (:graph registered)}
                      {:error (ex-info "Published pipeline registration is missing"
                                       {:category :preparation_failed})})

                    :failed
                    (deref prepared-signal 0
                           {:error (ex-info "Pipeline preparation failed"
                                            {:category :preparation_failed})})

                    :abandoned
                    (do
                      (reset! cancelled true)
                      {:error timeout-error})))
                initial)]
          (if-let [error (:error prepared)]
            (throw error)
            (json-response {:id pipeline-id
                            :status "started"
                            :graph_id (:id (:graph prepared))}
                           201)))))
    (catch Object e
      (json-response {:error (str "Failed to start pipeline: " e)} 400))))

;; Route HTTP requests (Section 9.5)
(def ^:private terminal-statuses #{:success :fail :cancelled :partial_success})

(defn- sse-frame [index event]
  (str "id: " index "\nevent: " (name (or (:type event) :event)) "\ndata: " (json/write-json event) "\n\n"))

(defn event-stream
  "Lazy SSE body for a pipeline: frames for recorded events from `from`, then
   new events as they are recorded, then one `end` frame once the pipeline is
   terminal or gone. Each element is realized on demand and flushed by the
   runtime, so a slow or disconnected client never blocks the pipeline; the
   wait loop stays inside one thunk to avoid nesting a lazy seq per poll."
  [pipeline-id from]
  (lazy-seq
    (loop []
      (let [pipe (get @active-pipelines pipeline-id)
            events (if pipe @(:events pipe) [])]
        (cond
          (< from (count events))
          (cons (sse-frame from (nth events from)) (event-stream pipeline-id (inc from)))
          (or (nil? pipe) (contains? terminal-statuses (:status pipe)))
          (list (str "event: end\ndata: " (json/write-json {:status (str (or (:status pipe) :gone)) :event_count from}) "\n\n"))
          :else (do (core/sleep 25) (recur)))))))

(defn app-handler [req]
  (let [path (or (:path req) "")
                ;; http/serve delivers the method as a keyword; tests pass strings.
        method (let [m (or (:request-method req) "get")]
                 (keyword (str/lower-case (if (keyword? m) (name m) (str m)))))]
    (cond
      ;; CORS preflight
      (= method :options)
      {:status 200
       :headers {"Access-Control-Allow-Origin" "*"
                 "Access-Control-Allow-Methods" "GET, POST, OPTIONS"
                 "Access-Control-Allow-Headers" "Content-Type"}
       :body ""}

      ;; POST /pipelines
      (and (= method :post) (= path "/pipelines"))
      (handle-start-pipeline req)

      ;; GET /pipelines
      (and (= method :get) (= path "/pipelines"))
      (json-response (map (fn [[id p]] {:id id :status (str (:status p)) :graph_id (:id (:graph p))})
                          @active-pipelines))

      ;; Routes with pipeline ID: /pipelines/:id/...
      (str/starts-with? path "/pipelines/")
      (let [parts (str/split (subs path 11) #"/")
            pipe-id (first parts)
            sub-route (second parts)
            pipe (get @active-pipelines pipe-id)]
        (if-not pipe
          (json-response {:error "Pipeline not found"} 404)
          (cond
            ;; GET /pipelines/:id
            (and (= method :get) (nil? sub-route))
            (json-response {:id pipe-id
                            :status (str (:status pipe))
                            :completed_nodes (or (:completed_nodes (:outcome pipe)) [])
                            :event_count (count @(:events pipe))})

            ;; GET /pipelines/:id/events — a maintained SSE stream (§9.5):
            ;; replay from Last-Event-ID, then hold the connection and deliver
            ;; later events until the pipeline reaches a terminal status.
            (and (= method :get) (= sub-route "events"))
            (let [last-id (some-> (or (get-in req [:headers "Last-Event-ID"]) (get-in req [:headers "last-event-id"]))
                                  str str/trim parse-long)]
              {:status 200
               :headers {"Content-Type" "text/event-stream"
                         "Cache-Control" "no-cache"
                         "Access-Control-Allow-Origin" "*"}
               :body (event-stream pipe-id (if last-id (inc last-id) 0))})

            ;; POST /pipelines/:id/cancel
            (and (= method :post) (= sub-route "cancel"))
            (do
              (when-let [cancelled (:cancelled pipe)]
                (reset! cancelled true))
              (swap! active-pipelines update pipe-id assoc :status :cancelled)
              (json-response {:id pipe-id :status "cancelled"}))

            ;; GET /pipelines/:id/graph
            (and (= method :get) (= sub-route "graph"))
            (svg-response (render-graph-svg (:dot pipe)))

            ;; GET /pipelines/:id/questions
            (and (= method :get) (= sub-route "questions"))
            (json-response (into {} (map (fn [[qid q]] [qid {:text (:text q) :type (name (:type q)) :options (:options q)}])
                                         @(:questions pipe))))

            ;; POST /pipelines/:id/questions/:qid/answer
            (and (= method :post) (= sub-route "questions") (= (count parts) 4) (= (nth parts 3) "answer"))
            (let [qid (nth parts 2)
                  ans-data (json/read-json (or (:body req) "{}"))
                  ans-val (get ans-data "answer")]
              (swap! (:pending-answers pipe) assoc qid {:value ans-val :text (str ans-val)})
              (json-response {:status "answer_submitted" :question_id qid}))

            ;; GET /pipelines/:id/checkpoint
            (and (= method :get) (= sub-route "checkpoint"))
            (let [cp-path (str (:logs_root pipe) "/checkpoint.edn")]
              (if (os/stat cp-path)
                (json-response (context/load-checkpoint cp-path))
                (json-response {:status "no_checkpoint_yet"})))

            ;; GET /pipelines/:id/context
            (and (= method :get) (= sub-route "context"))
            (json-response (context/ctx-snapshot (:context pipe)))

            :else
            (json-response {:error "Unknown sub-route"} 404))))

      :else
      (json-response {:error "Endpoint not found"} 404))))

;; Start HTTP server on specified port (e.g. ":7070")
(defn start-server [& [port]]
  (let [p (str (or port ":7070"))]
    (println (str "Attractor HTTP server listening on http://localhost" p))
    (http/serve app-handler p)))
