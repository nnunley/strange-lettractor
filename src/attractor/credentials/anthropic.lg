(ns attractor.credentials.anthropic
  "Fixed Anthropic Google federation exchange."
  (:require [json :as json]
            [attractor.credentials.google :as google]))

(def endpoint "https://api.anthropic.com/v1/oauth/token")
(def grant-type "urn:ietf:params:oauth:grant-type:jwt-bearer")

(defn exchange!
  "Exchange one Google ID token for a workspace-scoped Anthropic bearer token."
  [http assertion profile]
  (let [response (http {:method :post :url endpoint
                        :headers {"content-type" "application/json" "accept" "application/json"}
                        :body (json/write-json {:grant_type grant-type :assertion assertion
                                                :federation_rule_id (:federation_rule_id profile)
                                                :organization_id (:organization_id profile)
                                                :service_account_id (:service_account_id profile)
                                                :workspace_id (:workspace_id profile)})})
        body (try (json/read-json (str (:body response)))
                  (catch Object _ (google/fail! :invalid-federation-response)))]
    (when-not (= 200 (:status response)) (google/fail! :federation-rejected))
    (when-not (and (map? body) (google/safe-token? (get body "access_token"))
                   (integer? (get body "expires_in")) (pos? (get body "expires_in"))
                   (= "Bearer" (get body "token_type")))
      (google/fail! :invalid-federation-response))
    body))
