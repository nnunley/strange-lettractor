(ns attractor.credentials.google
  "Fixed Google OAuth and IAM Credentials protocol operations. No provider state."
  (:require [clojure.string :as str]
            [json :as json]
            [io :as io]
            [os :as os]
            [attractor.auth :as auth]))

(def authorization-endpoint "https://accounts.google.com/o/oauth2/v2/auth")
(def token-endpoint "https://oauth2.googleapis.com/token")
(def iam-origin "https://iamcredentials.googleapis.com")
(def audience "https://api.anthropic.com")

(defn fail! [reason]
  (throw (ex-info "Credentials: Google operation failed"
                  {:category :credentials-google :reason reason})))

(defn safe-token? [value]
  (and (string? value) (not (str/blank? value))
       (not (re-find #"[\x00-\x1f\x7f]" value))))

(defn- safe-id? [value]
  (and (safe-token? value) (not (str/includes? value " "))))

(defn- private-file! [path]
  (when-not (and (string? path) (str/starts-with? path "/"))
    (fail! :client-file-path))
  ;; stat's numeric mode and owner come from the OS; unknown permissions fail shut.
  (let [type-result (os/sh "stat" "-f" "%HT" path)
        mode-result (os/sh "stat" "-f" "%Lp" path)
        owner-result (os/sh "stat" "-f" "%u" path)
        user-result (os/sh "id" "-u")
        mode-text (str/trim (str (:out mode-result)))
        mode (when (re-matches #"[0-7]{3,4}" mode-text)
               (Integer/parseInt mode-text))]
    (when-not (and (= 0 (:exit type-result))
                   (= "Regular File" (str/trim (str (:out type-result))))
                   (= 0 (:exit mode-result)) (some? mode)
                   (zero? (mod mode 100))
                   (= 0 (:exit owner-result)) (= 0 (:exit user-result))
                   (= (str/trim (str (:out owner-result)))
                      (str/trim (str (:out user-result)))))
      (fail! :client-file-not-private))))

(defn default-client-reader
  "Read only the configured private Google installed desktop-client JSON file.
   Rejects missing, nonregular, nonowner, group/world-accessible or unknown-mode files."
  [path]
  (private-file! path)
  (try (json/read-json (io/slurp path))
       (catch Object _ (fail! :client-file-invalid))))

(defn client!
  "Validate an injected client-reader result. Reader receives one absolute path
   and returns parsed JSON with only the installed desktop-client section."
  [reader path]
  (let [document (try (reader path) (catch Object _ (fail! :client-file-invalid)))
        installed (get document "installed")
        auth-uri (get installed "auth_uri")
        token-uri (get installed "token_uri")]
    (when-not (and (map? document) (= #{"installed"} (set (keys document)))
                   (map? installed)
                   (safe-id? (get installed "client_id"))
                   (safe-token? (get installed "client_secret"))
                   (or (nil? auth-uri)
                       (contains? #{"https://accounts.google.com/o/oauth2/auth"
                                    authorization-endpoint} auth-uri))
                   (or (nil? token-uri) (= token-endpoint token-uri)))
      (fail! :client-metadata-invalid))
    {:client-id (get installed "client_id")
     :client-secret (get installed "client_secret")}))

(defn encode [text]
  (apply str (map (fn [character]
                    (if (or (<= (int \a) (int character) (int \z))
                            (<= (int \A) (int character) (int \Z))
                            (<= (int \0) (int character) (int \9))
                            (contains? #{\- \_ \. \~} character))
                      (str character)
                      (format "%%%02X" (int character))))
                  (str text))))

(defn granted-scopes! [provided requested required?]
  (if (nil? provided)
    (when required? (fail! :missing-granted-scopes))
    (let [granted (if (string? provided) (set (remove str/blank? (str/split provided #" +"))) #{})]
      (when-not (every? granted requested) (fail! :reduced-scopes)))))

(defn tokens!
  "Validate Google token response. First login requires refresh and explicit scopes;
   refresh may omit both, retaining the prior grant."
  [body scopes first-login?]
  (when-not (and (map? body) (safe-token? (get body "access_token"))
                 (integer? (get body "expires_in")) (pos? (get body "expires_in"))
                 (= "Bearer" (get body "token_type"))
                 (or (not first-login?) (safe-token? (get body "refresh_token")))
                 (or (nil? (get body "refresh_token"))
                     (safe-token? (get body "refresh_token"))))
    (fail! :invalid-token-response))
  (granted-scopes! (get body "scope") scopes first-login?)
  body)

(defn login!
  "Use auth/authorize with offline consent. The injected store writes one grant;
   validate-tokens runs before that write. Returns auth's in-memory result."
  [transport store browser profile client service-id timeout-ms]
  (let [validation-reason (atom nil)]
    (try
      (auth/authorize transport token-endpoint
        {:authorization-endpoint authorization-endpoint :token-endpoint token-endpoint
         :client-id (:client-id client) :client-secret (:client-secret client)
         :scope (str/join " " (:scopes profile)) :access-type "offline" :prompt "consent"}
        {:store store :service-id service-id :on-url browser :timeout-ms timeout-ms
         :persist-client-id? false
         :validate-tokens (fn [tokens]
           (try
             (tokens! {"access_token" (:access-token tokens)
                       "refresh_token" (:refresh-token tokens)
                       "expires_in" (:expires-in tokens)
                       "token_type" (:token-type tokens)
                       "scope" (:scope tokens)} (:scopes profile) true)
             (catch Object error
               (reset! validation-reason (:reason (ex-data error)))
               (throw error))))})
      (catch Object error
        (if @validation-reason
          (fail! @validation-reason)
          (throw error))))))

(defn refresh!
  "POST a refresh grant to Google's fixed token endpoint. Caller persists rotation."
  [http client grant scopes]
  (let [body (str "grant_type=refresh_token&refresh_token=" (encode grant)
                  "&client_id=" (encode (:client-id client))
                  "&client_secret=" (encode (:client-secret client)))
        response (http {:method :post :url token-endpoint
                        :headers {"content-type" "application/x-www-form-urlencoded"
                                  "accept" "application/json"} :body body})
        parsed (try (json/read-json (str (:body response)))
                    (catch Object _ (fail! :invalid-token-response)))]
    (when-not (= 200 (:status response)) (fail! :refresh-rejected))
    (tokens! parsed scopes false)))

(defn id-token!
  "POST to IAM Credentials for a Google-issued Anthropic-audience ID token."
  [http google-access service-account]
  (let [url (str iam-origin "/v1/projects/-/serviceAccounts/" (encode service-account)
                 ":generateIdToken")
        response (http {:method :post :url url
                        :headers {"authorization" (str "Bearer " google-access)
                                  "content-type" "application/json"}
                        :body (json/write-json {:audience audience :includeEmail true})})
        parsed (try (json/read-json (str (:body response)))
                    (catch Object _ (fail! :invalid-id-token-response)))]
    (when-not (= 200 (:status response)) (fail! :id-token-rejected))
    (when-not (safe-token? (get parsed "token")) (fail! :invalid-id-token-response))
    (get parsed "token")))
