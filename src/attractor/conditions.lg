(ns attractor.conditions
  (:require [clojure.string :as str] [attractor.parser :as parser]))

;; Parse a condition literal (strips surrounding quotes if present)
(defn parse-literal [v]
  (let [v (str/trim (str v))]
    (if (and (str/starts-with? v "\"") (str/ends-with? v "\"") (>= (count v) 2))
      (parser/unescape-string (subs v 1 (dec (count v))))
      v)))

(defn- lookup-context-value [values key]
  (let [keyword-key (keyword key)]
    (cond
      (contains? values key) (get values key)
      (contains? values keyword-key) (get values keyword-key)
      :else nil)))

;; Resolve a condition key against outcome and context
;; outcome is a map: {:status :success :preferred_label "..."}
;; context is a map or atom: key -> value
(defn resolve-key [key outcome context]
  (let [k (str/trim (str key))
        raw-context (if (map? context) context (if (nil? context) {} @context))
        ;; Runtime Context atoms wrap user values under :values; callers may
        ;; also pass a plain map for lightweight evaluation.
        ctx-vals (or (:values raw-context) raw-context)]
    (cond
      (= k "outcome")
      (let [st (or (:status outcome) (get outcome "status") "")]
        (if (keyword? st) (name st) (str st)))

      (= k "preferred_label")
      (str (or (:preferred_label outcome) (get outcome "preferred_label") ""))

      (str/starts-with? k "context.")
      (let [short-k (subs k 8)
            qualified (lookup-context-value ctx-vals k)
            value (if (nil? qualified) (lookup-context-value ctx-vals short-k) qualified)]
        (if (nil? value) "" (str value)))

      :else
      (let [value (lookup-context-value ctx-vals k)]
        (if (nil? value) "" (str value))))))

(defn- syntax-error! [message]
  (throw (ex-info message {:category :condition_syntax})))

(defn- split-clauses [source]
  (loop [index 0 start 0 quoted? false escaped? false clauses []]
    (if (= index (count source))
      (if quoted?
        (syntax-error! "Unterminated quoted condition literal")
        (conj clauses (subs source start)))
      (let [ch (subs source index (inc index))]
        (cond
          escaped? (recur (inc index) start quoted? false clauses)
          (and quoted? (= ch "\\")) (recur (inc index) start true true clauses)
          (= ch "\"") (recur (inc index) start (not quoted?) false clauses)
          (and (not quoted?) (str/starts-with? (subs source index) "&&"))
          (recur (+ index 2) (+ index 2) false false (conj clauses (subs source start index)))
          :else (recur (inc index) start quoted? false clauses))))))

(defn- parse-clause [source]
  (let [source (str/trim source)]
    (cond
      (str/blank? source) nil
      (re-matches #"^[A-Za-z_][A-Za-z0-9_.]*$" source) {:key source}
      :else
      (if-let [parts (re-matches #"(?s)^([A-Za-z_][A-Za-z0-9_.]*)\s*(!=|=)\s*(.+)$" source)]
        (let [value (str/trim (nth parts 3))]
          (when-not (or (re-matches #"^\"(?:\\.|[^\"\\])*\"$" value)
                        (re-matches #"^(?:-?[0-9]+|[A-Za-z_][A-Za-z0-9_.:-]*)$" value))
            (syntax-error! (str "Invalid condition literal: " value)))
          {:key (nth parts 1) :operator (nth parts 2) :literal (parse-literal value)})
        (syntax-error! (str "Invalid condition clause: " source))))))

(defn- evaluate-parsed-clause [clause outcome context]
  (if (nil? clause)
    true
    (let [resolved (resolve-key (:key clause) outcome context)]
      (case (:operator clause)
        "=" (= resolved (:literal clause))
        "!=" (not= resolved (:literal clause))
        ;; Preserve the existing bare-key extension separately from comparison.
        (let [value (str/trim resolved)]
          (and (not (str/blank? value)) (not= value "false") (not= value "0")))))))

(defn evaluate-clause [clause outcome context]
  (evaluate-parsed-clause (parse-clause clause) outcome context))

(defn evaluate-condition [condition outcome context]
  (if (str/blank? condition)
    true
    (let [clauses (mapv parse-clause (split-clauses condition))]
      (every? #(evaluate-parsed-clause % outcome context) clauses))))

(defn validate-condition-syntax [condition]
  (try
    (when-not (str/blank? condition)
      (doseq [clause (split-clauses condition)] (parse-clause clause)))
    nil
    (catch Object e (ex-message e))))
