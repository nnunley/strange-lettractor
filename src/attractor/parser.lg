(ns attractor.parser
  (:require [clojure.string :as str]))

;; Unescape string literals
(defn unescape-string [s]
  (-> s
      (str/replace "\\\"" "\"")
      (str/replace "\\n" "\n")
      (str/replace "\\t" "\t")
      (str/replace "\\\\" "\\")))

;; Helper to read a quoted string token
(defn- read-quoted-str [src start n]
  (loop [j (inc start)
         chars []]
    (if (>= j n)
      (throw (ex-info "Unterminated quoted string" {:offset start}))
      (let [ch (subs src j (inc j))]
        (cond
          (= ch "\\")
          (if (< (inc j) n)
            (let [escaped (subs src (inc j) (+ j 2))]
              (recur (+ j 2) (conj chars "\\" escaped)))
            (recur (inc j) (conj chars ch)))
          (= ch "\"")
          [(apply str chars) (inc j)]
          :else
          (recur (inc j) (conj chars ch)))))))

;; Parse a duration string like "900s", "15m", "2h", "250ms", "1d" into milliseconds
(defn parse-duration-ms [d-val]
  (if (number? d-val)
    d-val
    (let [m (re-matches #"^([0-9]+)(ms|s|m|h|d)$" (str d-val))]
      (if m
        (let [num (parse-long (nth m 1))
              unit (nth m 2)]
          (case unit
            "ms" num
            "s" (* num 1000)
            "m" (* num 60 1000)
            "h" (* num 60 60 1000)
            "d" (* num 24 60 60 1000)
            num))
        d-val))))

;; Derive CSS-like class name from a subgraph label (Section 2.10)
;; Lowercase, replace spaces with hyphens, strip non-alphanumerics except hyphens.
(defn derive-class [label]
  (if (str/blank? label)
    ""
    (-> label
        str/lower-case
        str/trim
        (str/replace #"\s+" "-")
        (str/replace #"[^a-z0-9-]" ""))))

(defn- add-class-once [classes derived-class]
  (let [classes (or classes "")
        existing (if (str/blank? classes)
                   #{}
                   (set (map str/trim (str/split classes #","))))]
    (cond
      (str/blank? derived-class) classes
      (contains? existing derived-class) classes
      (str/blank? classes) derived-class
      :else (str classes "," derived-class))))

(defn- apply-subgraph-class [node derived-class immediate?]
  (let [combined-class (add-class-once (:class node) derived-class)]
    (cond-> (-> node
                (assoc :class combined-class)
                (assoc-in [:attrs :class] combined-class))
      immediate? (assoc :subgraph_class derived-class)
      immediate? (assoc-in [:attrs :subgraph_class] derived-class))))

(defn- active-subgraph-classes [state]
  (->> (conj (:subgraph-stack state) (:current-subgraph state))
       (map :derived-class)
       (remove str/blank?)))

(defn- add-active-subgraph-classes [classes state]
  (reduce add-class-once classes (active-subgraph-classes state)))

(defn- apply-active-subgraph-classes [node state]
  (let [with-classes (reduce (fn [current-node derived-class]
                               (apply-subgraph-class current-node derived-class false))
                             node
                             (active-subgraph-classes state))
        current-subgraph (:current-subgraph state)
        immediate-class (:derived-class current-subgraph)]
    (cond-> with-classes
      current-subgraph (assoc :subgraph_class immediate-class)
      current-subgraph (assoc-in [:attrs :subgraph_class] immediate-class))))

;; Tokenize DOT source code
(defn tokenize-dot [src]
  (let [n (count src)]
    (loop [i 0
           tokens []]
      (if (>= i n)
        tokens
        (let [c (subs src i (inc i))]
          (cond
            ;; Whitespace
            (re-matches #"\s" c)
            (recur (inc i) tokens)

            ;; Line comment // ...
            (and (< (inc i) n) (= (subs src i (+ i 2)) "//"))
            (let [nl (str/index-of src "\n" (+ i 2))
                  next-i (if nl (inc nl) n)]
              (recur next-i tokens))

            ;; Block comment /* ... */
            (and (< (inc i) n) (= (subs src i (+ i 2)) "/*"))
            (let [end-pos (str/index-of src "*/" (+ i 2))
                  next-i (when end-pos (+ end-pos 2))]
              (if next-i
                (recur next-i tokens)
                (throw (ex-info "Unterminated block comment" {:offset i}))))

            ;; Undirected edges are outside the supported subset.
            (and (< (inc i) n) (= (subs src i (+ i 2)) "--"))
            (throw (ex-info "Undirected edges are not supported" {:offset i}))

            ;; Arrow ->
            (and (< (inc i) n) (= (subs src i (+ i 2)) "->"))
            (recur (+ i 2) (conj tokens {:type :arrow :val "->"}))

            ;; Quoted string "..."
            (= c "\"")
            (let [[raw-str next-i] (read-quoted-str src i n)]
              (recur next-i (conj tokens {:type :string :val (unescape-string raw-str)})))

            ;; Punctuation
            (#{"{" "}" "[" "]" "=" "," ";"} c)
            (recur (inc i) (conj tokens {:type :punct :val c}))

            ;; Word / Identifier / Number / Duration / BareValue
            :else
            (let [rest-s (subs src i)
                  m (re-find #"^-?[A-Za-z0-9_.:]+" rest-s)]
              (if m
                (let [val-len (count m)]
                  (recur (+ i val-len) (conj tokens {:type :word :val m})))
                (throw (ex-info (str "Unexpected character in DOT source: " c)
                                {:offset i :character c}))))))))))

;; Convert raw token value to typed value
(defn- convert-val [token]
  (if (= (:type token) :string)
    (:val token)
    (let [v (:val token)]
      (cond
        (= v "true") true
        (= v "false") false
        (re-matches #"^-?[0-9]+$" v) (parse-long v)
        (re-matches #"^-?[0-9]*\.[0-9]+$" v) (parse-double v)
        :else v))))

;; Parse an attribute block starting at token idx: [ key=val, key2=val2 ... ]
;; Returns [attrs next-idx]
(defn- parse-attr-block-tokens [tokens start-idx]
  (if (or (>= start-idx (count tokens))
          (not= (get-in tokens [start-idx :val]) "["))
    [{} start-idx]
    (loop [i (inc start-idx)
           attrs {}
           need-attr? false]
      (if (>= i (count tokens))
        (throw (ex-info "Unterminated attribute block" {:token-index start-idx}))
        (let [t (nth tokens i)]
          (cond
            (= (:val t) "]")
            (if need-attr?
              (throw (ex-info "Trailing comma in attribute block" {:token-index i}))
              [attrs (inc i)])

            (= (:val t) ",")
            (throw (ex-info "Unexpected comma in attribute block" {:token-index i}))

            ;; key = val
            (= (:type t) :word)
            (let [k-name (:val t)
                  next-t (get tokens (inc i))]
              (when-not (and next-t (= (:val next-t) "="))
                (throw (ex-info "Attribute requires '=' and a value"
                                {:attribute k-name :token-index i})))
              (let [v-token (get tokens (+ i 2))
                    separator (get tokens (+ i 3))]
                (when-not (and v-token
                               (or (= (:type v-token) :word)
                                   (= (:type v-token) :string)))
                  (throw (ex-info "Attribute value is missing"
                                  {:attribute k-name :token-index i})))
                (cond
                  (nil? separator)
                  (throw (ex-info "Unterminated attribute block"
                                  {:token-index start-idx}))

                  (= (:val separator) "]")
                  [(assoc attrs (keyword k-name) (convert-val v-token)) (+ i 4)]

                  (= (:val separator) ",")
                  (recur (+ i 4)
                         (assoc attrs (keyword k-name) (convert-val v-token))
                         true)

                  :else
                  (throw (ex-info "Attributes must be separated by commas"
                                  {:token-index (+ i 3)})))))

            :else
            (throw (ex-info "Expected attribute name" {:token-index i}))))))))

(defn- valid-identifier? [value]
  (and (string? value)
       (some? (re-matches #"[A-Za-z_][A-Za-z0-9_]*" value))))

(defn- require-identifier! [value context]
  (when-not (valid-identifier? value)
    (throw (ex-info (str "Invalid " context " identifier: " value)
                    {:identifier value :context context})))
  value)

;; Helper to collect chained edge node IDs: A -> B -> C ...
;; Returns [chain-vector next-idx]
(defn- collect-edge-chain [tokens start-idx n first-id]
  (loop [curr-idx (inc start-idx)
         chain [first-id]]
    (if (and (< curr-idx n) (= (get-in tokens [curr-idx :val]) "->"))
      (let [target-token (get tokens (inc curr-idx))
            target-id (:val target-token)]
        (when-not (and target-token (= (:type target-token) :word))
          (throw (ex-info "Directed edge is missing a target node"
                          {:token-index curr-idx})))
        (require-identifier! target-id "node")
        (recur (+ curr-idx 2) (conj chain target-id)))
      [chain curr-idx])))

;; Step function for parser state
(defn- step-parse [tokens n state]
  (let [idx (:idx state)
        tok (nth tokens idx)
        val (:val tok)]
    (cond
      ;; End of graph or subgraph
      (= val "}")
      (if (:current-subgraph state)
        ;; Exit subgraph back to parent scope
        (let [stack (:subgraph-stack state)
              closed-subgraph (:current-subgraph state)
              parent-subgraph (last stack)
              restored-parent (when parent-subgraph
                                (update parent-subgraph :node-ids into
                                        (:node-ids closed-subgraph)))]
          (-> state
              (update :idx inc)
              (update :subgraphs conj closed-subgraph)
              (assoc :current-subgraph restored-parent)
              (assoc :subgraph-stack (vec (butlast stack)))))
        ;; Exit graph
        (-> state (assoc :done? true) (update :idx inc)))

      (= val ";")
      (update state :idx inc)

      ;; graph [ ... ]
      (= val "graph")
      (let [[attrs next-idx] (parse-attr-block-tokens tokens (inc idx))]
        (-> state
            (assoc :idx next-idx)
            (update :graph-attrs merge attrs)
            (update :explicit-graph-attrs into (keys attrs))))

      ;; node [ ... ]
      (= val "node")
      (let [[attrs next-idx] (parse-attr-block-tokens tokens (inc idx))]
        (if (:current-subgraph state)
          (-> state
              (assoc :idx next-idx)
              (update-in [:current-subgraph :scoped-node-defaults] merge attrs))
          (-> state
              (assoc :idx next-idx)
              (update :node-defaults merge attrs))))

      ;; edge [ ... ]
      (= val "edge")
      (let [[attrs next-idx] (parse-attr-block-tokens tokens (inc idx))]
        (-> state
            (assoc :idx next-idx)
            (update :edge-defaults merge attrs)))

      ;; subgraph [name] { ... }
      (= val "subgraph")
      (let [has-name? (and (< (inc idx) n) (not= (get-in tokens [(inc idx) :val]) "{"))
            sub-name (if has-name? (get-in tokens [(inc idx) :val]) (str "subgraph_" (count (:subgraphs state))))
            brace-idx (if has-name? (+ idx 2) (inc idx))]
        (when has-name? (require-identifier! sub-name "subgraph"))
        (when-not (= "{" (get-in tokens [brace-idx :val]))
          (throw (ex-info "Expected '{' after subgraph declaration"
                          {:token-index brace-idx})))
        (-> state
            (assoc :idx (inc brace-idx))
            (cond-> (:current-subgraph state)
              (update :subgraph-stack conj (:current-subgraph state)))
            (assoc :current-subgraph {:id sub-name
                                      :scoped-node-defaults
                                      (or (get-in state [:current-subgraph :scoped-node-defaults])
                                          (:node-defaults state))
                                      :label ""
                                      :derived-class ""
                                      :node-ids #{}
                                      :direct-node-ids #{}})))

      ;; Top-level key = val statement (e.g. rankdir=LR or goal="...")
      (and (< (+ idx 2) n)
           (= (get-in tokens [(inc idx) :val]) "="))
      (let [k-name val
            v-tok (nth tokens (+ idx 2))
            v (convert-val v-tok)
            next-i (+ idx 3)]
        (if (:current-subgraph state)
          (let [derived-class (if (= k-name "label") (derive-class v) "")
                updated-sub (cond-> (assoc-in (:current-subgraph state) [:attrs (keyword k-name)] v)
                              (= k-name "label") (assoc :label v :derived-class derived-class))
                updated-nodes (if (= k-name "label")
                                (reduce (fn [nodes node-id]
                                          (update nodes node-id apply-subgraph-class
                                                  derived-class
                                                  (contains? (:direct-node-ids updated-sub)
                                                             node-id)))
                                        (:nodes state)
                                        (:node-ids updated-sub))
                                (:nodes state))]
            (-> state
                (assoc :idx next-i)
                (assoc :nodes updated-nodes)
                (assoc :current-subgraph updated-sub)))
          (-> state
              (assoc :idx next-i)
              (assoc-in [:graph-attrs (keyword k-name)] v)
              (update :explicit-graph-attrs conj (keyword k-name)))))

      ;; Node or Edge statement
      (= (:type tok) :word)
      (let [first-id val]
        (require-identifier! first-id "node")
        (if (and (< (inc idx) n) (= (get-in tokens [(inc idx) :val]) "->"))
          ;; Edge chain
          (let [[chain curr-idx] (collect-edge-chain tokens idx n first-id)
                [attrs next-idx] (parse-attr-block-tokens tokens curr-idx)
                merged-edge-attrs (merge (:edge-defaults state) attrs)
                merged-edge-attrs (update merged-edge-attrs :weight (fn [w] (if (number? w) w 0)))
                new-edges (map (fn [[from to]]
                                 {:from from
                                  :to to
                                  :label (or (:label merged-edge-attrs) "")
                                  :condition (or (:condition merged-edge-attrs) "")
                                  :weight (or (:weight merged-edge-attrs) 0)
                                  :fidelity (:fidelity merged-edge-attrs)
                                  :thread_id (:thread_id merged-edge-attrs)
                                  :loop_restart (boolean (:loop_restart merged-edge-attrs))
                                  :attrs merged-edge-attrs})
                               (partition 2 1 chain))
                defaults (if (:current-subgraph state)
                           (:scoped-node-defaults (:current-subgraph state))
                           (:node-defaults state))
                sub-class (if (:current-subgraph state)
                            (:derived-class (:current-subgraph state)) "")
                registered-nodes (reduce (fn [acc-nodes nid]
                                           (let [node (or (get acc-nodes nid)
                                                          {:id nid
                                                           :label nid
                                                           :shape (or (:shape defaults) "box")
                                                           :type (or (:type defaults) "")
                                                           :prompt ""
                                                           :max_retries (:max_retries defaults)
                                                           :goal_gate false
                                                           :retry_target ""
                                                           :fallback_retry_target ""
                                                           :fidelity (:fidelity defaults)
                                                           :thread_id (:thread_id defaults)
                                                           :class (or (:class defaults) "")
                                                           :subgraph_class sub-class
                                                           :attrs (assoc defaults
                                                                     :class (or (:class defaults) "")
                                                                     :subgraph_class sub-class)})]
                                             (assoc acc-nodes nid
                                                    (apply-active-subgraph-classes node state))))
                                         (:nodes state)
                                         chain)]
            (-> state
                (assoc :idx next-idx)
                (assoc :nodes registered-nodes)
                (cond-> (:current-subgraph state)
                  (update-in [:current-subgraph :node-ids] into chain)
                  (:current-subgraph state)
                  (update-in [:current-subgraph :direct-node-ids] into chain))
                (update :edges into new-edges)))

          ;; Node statement
          (let [[explicit-attrs next-idx] (parse-attr-block-tokens tokens (inc idx))
                effective-defaults (if (:current-subgraph state)
                                     (:scoped-node-defaults (:current-subgraph state))
                                     (:node-defaults state))
                sub-class (if (:current-subgraph state) (:derived-class (:current-subgraph state)) "")
                explicit-class (or (:class explicit-attrs) (:class effective-defaults) "")
                combined-class (add-active-subgraph-classes explicit-class state)
                merged-attrs (merge effective-defaults explicit-attrs)
                node-rec {:id first-id
                          :label (or (:label explicit-attrs) (:label effective-defaults) first-id)
                          :shape (or (:shape explicit-attrs) (:shape effective-defaults) "box")
                          :type (or (:type explicit-attrs) (:type effective-defaults) "")
                          :prompt (or (:prompt explicit-attrs) (:prompt effective-defaults) "")
                          :max_retries (or (:max_retries explicit-attrs) (:max_retries effective-defaults))
                          :goal_gate (boolean (or (:goal_gate explicit-attrs) (:goal_gate effective-defaults) false))
                          :retry_target (or (:retry_target explicit-attrs) (:retry_target effective-defaults) "")
                          :fallback_retry_target (or (:fallback_retry_target explicit-attrs) (:fallback_retry_target effective-defaults) "")
                          :fidelity (or (:fidelity explicit-attrs) (:fidelity effective-defaults))
                          :thread_id (or (:thread_id explicit-attrs) (:thread_id effective-defaults))
                          :class combined-class
                          :subgraph_class sub-class
                          :timeout (or (:timeout explicit-attrs) (:timeout effective-defaults))
                          :llm_model (or (:llm_model explicit-attrs) (:llm_model effective-defaults))
                          :llm_provider (or (:llm_provider explicit-attrs) (:llm_provider effective-defaults))
                          ;; Keep unset distinct from the system default so a
                          ;; stylesheet can supply this property.
                          :reasoning_effort (or (:reasoning_effort explicit-attrs) (:reasoning_effort effective-defaults))
                          :auto_status (boolean
                                         (if (contains? explicit-attrs :auto_status)
                                           (:auto_status explicit-attrs)
                                           (if (contains? effective-defaults :auto_status)
                                             (:auto_status effective-defaults)
                                             false)))
                          :allow_partial (boolean (or (:allow_partial explicit-attrs) (:allow_partial effective-defaults) false))
                          :attrs (assoc merged-attrs
                                        :class combined-class
                                        :subgraph_class sub-class)}]
            (-> state
                (assoc :idx next-idx)
                (assoc-in [:nodes first-id] node-rec)
                (cond-> (:current-subgraph state)
                  (update-in [:current-subgraph :node-ids] conj first-id)
                  (:current-subgraph state)
                  (update-in [:current-subgraph :direct-node-ids] conj first-id))))))

      :else
      (update state :idx inc))))

;; Main parser for DOT digraph
(defn parse-dot [src]
  (let [tokens (tokenize-dot src)
        n (count tokens)]
    (when (empty? tokens)
      (throw (ex-info "Empty DOT source" {})))

    (let [t0 (first tokens)]
      (when (not= (:val t0) "digraph")
        (throw (ex-info (str "Expected 'digraph', found: " (:val t0)) {}))))

    (let [graph-id (get-in tokens [1 :val])
          _ (require-identifier! graph-id "graph")
          open-brace-idx 2
          _ (when-not (= "{" (get-in tokens [open-brace-idx :val]))
              (throw (ex-info "Expected '{' immediately after graph identifier" {})))
          initial-state {:idx (inc open-brace-idx)
                         :done? false
                         :graph-attrs {:id graph-id
                                       :goal ""
                                       :label ""
                                       :model_stylesheet ""
                                       :default_max_retries 0
                                       :default_fidelity ""}
                         :node-defaults {:shape "box"}
                         :edge-defaults {:weight 0}
                         :explicit-graph-attrs #{}
                         :nodes {}
                         :edges []
                         :subgraphs []
                         :subgraph-stack []
                         :current-subgraph nil}]

      (loop [state initial-state]
        (if (or (:done? state) (>= (:idx state) n))
          ;; Construct final graph map
          (let [_ (when-not (:done? state)
                    (throw (ex-info "Missing closing '}'" {})))
                _ (when-not (= (:idx state) n)
                    (throw (ex-info "Unexpected tokens after graph closing '}'"
                                    {:token-index (:idx state)})))
                ga (:graph-attrs state)
                explicit-ga (:explicit-graph-attrs state)
                default-max-retries
                (cond
                  (contains? explicit-ga :default_max_retries)
                  (:default_max_retries ga)
                  (contains? explicit-ga :default_max_retry)
                  (:default_max_retry ga)
                  :else 0)]
            {:id graph-id
             :goal (or (:goal ga) "")
             :label (or (:label ga) "")
             :model_stylesheet (or (:model_stylesheet ga) "")
             :default_max_retries (or default-max-retries 0)
             :default_fidelity (or (:default_fidelity ga) "")
             :retry_target (or (:retry_target ga) "")
             :fallback_retry_target (or (:fallback_retry_target ga) "")
             :attrs ga
             :explicit_attrs explicit-ga
             :nodes (:nodes state)
             :edges (:edges state)
             :subgraphs (:subgraphs state)})
          (recur (step-parse tokens n state)))))))

;; Graph query functions
(defn find-node [graph node-id]
  (get-in graph [:nodes (str node-id)]))

(defn outgoing-edges [graph node-id]
  (filter (fn [e] (= (:from e) (str node-id))) (:edges graph)))

(defn incoming-edges [graph node-id]
  (filter (fn [e] (= (:to e) (str node-id))) (:edges graph)))

(defn find-start-node [graph]
  ;; Resolves by: (1) shape=Mdiamond, (2) id="start" or "Start"
  (or (first (filter (fn [[_ n]] (= (:shape n) "Mdiamond")) (:nodes graph)))
      (first (filter (fn [[_ n]] (#{"start" "Start"} (:id n))) (:nodes graph)))))

(defn find-exit-node [graph]
  ;; Resolves by: (1) shape=Msquare, (2) id="exit" or "end" or "Exit" or "End"
  (or (first (filter (fn [[_ n]] (= (:shape n) "Msquare")) (:nodes graph)))
      (first (filter (fn [[_ n]] (#{"exit" "end" "Exit" "End" "done"} (:id n))) (:nodes graph)))))
