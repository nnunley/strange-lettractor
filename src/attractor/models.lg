(defn get-model-info [model-id]
  (first
    (filter
      (fn [model]
        (or (= model-id (:id model))
            (some #{model-id} (:aliases model))))
      catalog)))

(defn list-models [& [provider]]
  (if provider
    (vec (filter (fn [model] (= provider (:provider model))) catalog))
    catalog))

(defn get-latest-model [provider & [capability]]
  (let [capability-key (case capability
                         "reasoning" :supports_reasoning
                         "vision" :supports_vision
                         "tools" :supports_tools
                         nil)]
    (first
      (filter
        (fn [model]
          (and (= provider (:provider model))
               (or (nil? capability-key) (true? (get model capability-key)))))
        catalog))))
