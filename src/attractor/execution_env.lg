(ns attractor.execution-env
  (:require [attractor.execution :as execution]))

;; Compatibility facade for the initial function-oriented environment API.
(defn make-exec-result [stdout stderr exit-code timed-out duration-ms]
  {:stdout stdout :stderr stderr :exit-code exit-code
   :timed-out timed-out :duration-ms duration-ms})

(defn make-dir-entry [name is-dir size]
  {:name name :is-dir is-dir :size size})

(defn make-local-execution-env [& [working-dir]]
  (execution/make-local-environment
    (when working-dir {:working_dir working-dir})))

(defn env-read-file
  ([env path] ((:read_file env) path nil nil))
  ([env path offset] ((:read_file env) path offset nil))
  ([env path offset limit] ((:read_file env) path offset limit)))

(defn env-write-file [env path content]
  ((:write_file env) path content))

(defn env-file-exists [env path]
  ((:file_exists env) path))

(defn env-list-directory [env path & [depth]]
  ((:list_directory env) path (or depth 1)))

(defn env-exec-command [env command & [timeout-ms working-dir env-vars]]
  (let [result ((:exec_command env) command timeout-ms working-dir env-vars)]
    (make-exec-result (:stdout result) (:stderr result) (:exit_code result)
                      (:timed_out result) (:duration_ms result))))

(defn env-grep [env pattern path & [options]]
  ((:grep env) pattern path (or options {})))

(defn env-glob [env pattern & [path]]
  ((:glob env) pattern path))

(defn env-working-directory [env]
  ((:working_directory env)))

(defn env-platform [env]
  ((:platform env)))

(defn env-os-version [env]
  ((:os_version env)))
