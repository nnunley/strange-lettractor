(ns attractor.validation
  (:require [clojure.string :as str]
            [clojure.set :as set]
            [attractor.conditions :as conditions]
            [attractor.stylesheet :as stylesheet]))

;; Known standard handler types
(def standard-types
  #{"start" "exit" "codergen" "wait.human" "conditional" "parallel" "parallel.fan_in" "tool" "stack.manager_loop"})

;; Known valid fidelity modes
(def valid-fidelity-modes
  #{"full" "truncate" "compact" "summary:low" "summary:medium" "summary:high"})

;; BFS reachability traversal from start node
(defn- reachable-node-ids [graph start-id]
  (loop [queue [start-id]
         visited #{start-id}]
    (if (empty? queue)
      visited
      (let [curr (first queue)
            outgoing (filter (fn [e] (= (:from e) curr)) (:edges graph))
            neighbors (map :to outgoing)
            unvisited (remove visited neighbors)]
        (recur (into (subvec queue 1) unvisited)
               (into visited unvisited))))))

;; Rule: start_node
(defn rule-start-node [graph]
  (let [start-nodes (filter (fn [[_ n]]
                              (or (= (:shape n) "Mdiamond")
                                  (#{"start" "Start"} (:id n))))
                            (:nodes graph))
        cnt (count start-nodes)]
    (cond
      (= cnt 0)
      [{:rule "start_node" :severity :error :message "Pipeline must have exactly one start node (shape=Mdiamond or id matching start/Start)"}]
      (> cnt 1)
      [{:rule "start_node" :severity :error :message (str "Pipeline has multiple start nodes: " (str/join ", " (map first start-nodes)))}]
      :else [])))

;; Rule: terminal_node
(defn rule-terminal-node [graph]
  (let [exit-nodes (filter (fn [[_ n]]
                             (or (= (:shape n) "Msquare")
                                 (#{"exit" "end" "Exit" "End" "done"} (:id n))))
                           (:nodes graph))
        cnt (count exit-nodes)]
    (cond
      (= cnt 0)
      [{:rule "terminal_node" :severity :error :message "Pipeline must have exactly one terminal node (shape=Msquare or id matching exit/end)"}]
      (> cnt 1)
      [{:rule "terminal_node" :severity :error :message (str "Pipeline has multiple terminal nodes: " (str/join ", " (map first exit-nodes)))}]
      :else [])))

;; Rule: start_no_incoming
(defn rule-start-no-incoming [graph]
  (let [start-node (or (first (filter (fn [[_ n]] (= (:shape n) "Mdiamond")) (:nodes graph)))
                       (first (filter (fn [[_ n]] (#{"start" "Start"} (:id n))) (:nodes graph))))]
    (if start-node
      (let [start-id (first start-node)
            incoming (filter (fn [e] (= (:to e) start-id)) (:edges graph))]
        (if (seq incoming)
          [{:rule "start_no_incoming" :severity :error :node-id start-id :message (str "Start node '" start-id "' must have no incoming edges")}]
          []))
      [])))

;; Rule: exit_no_outgoing
(defn rule-exit-no-outgoing [graph]
  (let [exit-node (or (first (filter (fn [[_ n]] (= (:shape n) "Msquare")) (:nodes graph)))
                      (first (filter (fn [[_ n]] (#{"exit" "end" "Exit" "End" "done"} (:id n))) (:nodes graph))))]
    (if exit-node
      (let [exit-id (first exit-node)
            outgoing (filter (fn [e] (= (:from e) exit-id)) (:edges graph))]
        (if (seq outgoing)
          [{:rule "exit_no_outgoing" :severity :error :node-id exit-id :message (str "Exit node '" exit-id "' must have no outgoing edges")}]
          []))
      [])))

;; Rule: edge_target_exists
(defn rule-edge-targets-exist [graph]
  (let [node-ids (set (keys (:nodes graph)))]
    (reduce (fn [acc e]
              (let [from-ok (contains? node-ids (:from e))
                    to-ok (contains? node-ids (:to e))]
                (cond-> acc
                  (not from-ok)
                  (conj {:rule "edge_target_exists" :severity :error :edge [(:from e) (:to e)]
                         :message (str "Edge source '" (:from e) "' does not exist in graph")})
                  (not to-ok)
                  (conj {:rule "edge_target_exists" :severity :error :edge [(:from e) (:to e)]
                         :message (str "Edge target '" (:to e) "' does not exist in graph")}))))
            []
            (:edges graph))))

;; Rule: reachability
(defn rule-reachability [graph]
  (let [start-node (or (first (filter (fn [[_ n]] (= (:shape n) "Mdiamond")) (:nodes graph)))
                       (first (filter (fn [[_ n]] (#{"start" "Start"} (:id n))) (:nodes graph))))]
    (if start-node
      (let [start-id (first start-node)
            reachable (reachable-node-ids graph start-id)
            all-ids (set (keys (:nodes graph)))
            unreachable (set/difference all-ids reachable)]
        (map (fn [nid]
               {:rule "reachability" :severity :error :node-id nid
                :message (str "Node '" nid "' is not reachable from start node '" start-id "'")})
             unreachable))
      [])))

;; Rule: condition_syntax
(defn rule-condition-syntax [graph]
  (reduce (fn [acc e]
            (let [cond-str (:condition e)]
              (if (str/blank? cond-str)
                acc
                (let [err (conditions/validate-condition-syntax cond-str)]
                  (if err
                    (conj acc {:rule "condition_syntax" :severity :error :edge [(:from e) (:to e)]
                               :message (str "Invalid condition on edge " (:from e) " -> " (:to e) ": " err)})
                    acc)))))
          []
          (:edges graph)))

;; Rule: stylesheet_syntax
(defn rule-stylesheet-syntax [graph]
  (let [css (:model_stylesheet graph)]
    (if (str/blank? css)
      []
      (let [err (stylesheet/validate-stylesheet-syntax css)]
        (if err
          [{:rule "stylesheet_syntax" :severity :error :message (str "Invalid model_stylesheet: " err)}]
          [])))))

;; Rule: type_known (WARNING)
(defn rule-type-known
  ([graph] (rule-type-known graph []))
  ([graph extra-types]
   (let [known (set/union standard-types (set (or extra-types [])))]
     (reduce (fn [acc [nid node]]
               (let [t (:type node)]
                 (if (and (not (str/blank? t)) (not (contains? known t)))
                   (conj acc {:rule "type_known" :severity :warning :node-id nid
                              :message (str "Unknown node type: '" t "' on node '" nid "'")})
                   acc)))
             []
             (:nodes graph)))))

;; Rule: fidelity_valid (WARNING)
(defn rule-fidelity-valid [graph]
  (let [graph-fid (:default_fidelity graph)
        graph-diags (if (and (not (str/blank? graph-fid)) (not (contains? valid-fidelity-modes graph-fid)))
                      [{:rule "fidelity_valid" :severity :warning
                        :message (str "Invalid graph default_fidelity: '" graph-fid "'")}]
                      [])
        node-diags (reduce (fn [acc [nid node]]
                             (let [fid (:fidelity node)]
                               (if (and (not (str/blank? fid)) (not (contains? valid-fidelity-modes fid)))
                                 (conj acc {:rule "fidelity_valid" :severity :warning :node-id nid
                                            :message (str "Invalid fidelity mode '" fid "' on node '" nid "'")})
                                 acc)))
                           []
                           (:nodes graph))]
    (into graph-diags node-diags)))

;; Rule: retry_target_exists (WARNING)
(defn rule-retry-target-exists [graph]
  (let [node-ids (set (keys (:nodes graph)))]
    (reduce (fn [acc [nid node]]
              (let [rt (:retry_target node)
                    frt (:fallback_retry_target node)
                    rt-err (when (and (not (str/blank? rt)) (not (contains? node-ids rt)))
                             {:rule "retry_target_exists" :severity :warning :node-id nid
                              :message (str "retry_target '" rt "' on node '" nid "' does not exist")})
                    frt-err (when (and (not (str/blank? frt)) (not (contains? node-ids frt)))
                              {:rule "retry_target_exists" :severity :warning :node-id nid
                               :message (str "fallback_retry_target '" frt "' on node '" nid "' does not exist")})]
                (cond-> acc
                  rt-err (conj rt-err)
                  frt-err (conj frt-err))))
            []
            (:nodes graph))))

;; Rule: goal_gate_has_retry (WARNING)
(defn rule-goal-gate-has-retry [graph]
  (let [graph-has-target? (or (not (str/blank? (:retry_target graph)))
                              (not (str/blank? (:fallback_retry_target graph))))]
    (reduce (fn [acc [nid node]]
              (if (:goal_gate node)
                (let [has-target? (or (not (str/blank? (:retry_target node)))
                                      (not (str/blank? (:fallback_retry_target node)))
                                      graph-has-target?)]
                  (if (not has-target?)
                    (conj acc {:rule "goal_gate_has_retry" :severity :warning :node-id nid
                               :message (str "Node '" nid "' has goal_gate=true but no retry_target or fallback_retry_target configured")})
                    acc))
                acc))
            []
            (:nodes graph))))

;; Rule: prompt_on_llm_nodes (WARNING)
(defn rule-prompt-on-llm-nodes [graph]
  (reduce (fn [acc [nid node]]
            (let [shape (or (:shape node) "box")
                  t (or (:type node) "")
                  is-codergen? (or (= t "codergen") (and (str/blank? t) (= shape "box")))]
              (if (and is-codergen? (str/blank? (:prompt node)) (str/blank? (:label node)))
                (conj acc {:rule "prompt_on_llm_nodes" :severity :warning :node-id nid
                           :message (str "Codergen node '" nid "' should have a prompt or label attribute")})
                acc)))
          []
          (:nodes graph)))

;; Full validation runner
(defn validate
  ([graph] (validate graph []))
  ([graph custom-rules]
   (let [built-in-rules [rule-start-node
                         rule-terminal-node
                         rule-start-no-incoming
                         rule-exit-no-outgoing
                         rule-edge-targets-exist
                         rule-reachability
                         rule-condition-syntax
                         rule-stylesheet-syntax
                         rule-type-known
                         rule-fidelity-valid
                         rule-retry-target-exists
                         rule-goal-gate-has-retry
                         rule-prompt-on-llm-nodes]
         all-rules (concat built-in-rules custom-rules)]
     (vec (mapcat (fn [r] (r graph)) all-rules)))))

;; Validate and throw exception if any errors
(defn validate-or-raise
  ([graph] (validate-or-raise graph []))
  ([graph custom-rules]
   (let [diags (validate graph custom-rules)
         errors (filter (fn [d] (= (:severity d) :error)) diags)]
     (if (seq errors)
       (let [msgs (map (fn [e] (str "[" (:rule e) "] " (:message e))) errors)]
         (throw (ex-info (str "Pipeline validation failed with " (count errors) " error(s):\n"
                              (str/join "\n" msgs)) {:errors errors})))
       diags))))
