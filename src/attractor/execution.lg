(ns attractor.execution
  (:require [clojure.string :as str]
            [io :as io]
            [os :as os]
            [attractor.patch :as patch]))

(defn make-environment [operations]
  (merge {:initialize (fn [] nil)
          :cleanup (fn [] nil)
          :working_directory (fn [] (os/cwd))
          :platform (fn [] (os/os-name))
          :os_version (fn [] "")}
         operations))

(defn- absolute-path? [path]
  (or (str/starts-with? path "/")
      (and (> (count path) 2) (= ":" (subs path 1 2)))))

(defn- resolve-path [working-dir path]
  (let [value (str (or path ""))]
    (if (absolute-path? value)
      value
      (str working-dir "/" value))))

(defn- parent-path [path]
  (let [index (str/last-index-of path "/")]
    (when (and (some? index) (> index 0))
      (subs path 0 index))))

(defn- numbered-lines [content offset limit]
  (let [lines (vec (str/split content #"\n"))
        start (max 0 (dec (or offset 1)))
        end (min (count lines) (+ start (or limit 2000)))]
    (if (>= start (count lines))
      ""
      (str/join
        "\n"
        (map-indexed (fn [index line]
                       (str (+ start index 1) " | " line))
                     (subvec lines start end))))))

(defn- occurrence-count [content needle]
  (when (str/blank? needle)
    (throw (ex-info "old_string must not be empty"
                    {:category :invalid-edit})))
  (loop [start 0 total 0]
    (if-let [index (str/index-of content needle start)]
      (recur (+ index (count needle)) (inc total))
      total)))

(def command-wrapper
  (str
    "set -m\n"
    "workdir=$1\n"
    "timeout_s=$2\n"
    "command_text=$3\n"
    "timeout_marker=$4\n"
    "shift 4\n"
    "cd \"$workdir\" || exit 126\n"
    "while IFS='=' read -r name value; do\n"
    "  case \"$name\" in\n"
    "    *_API_KEY|*_SECRET|*_TOKEN|*PASSWORD*|AWS_ACCESS_KEY_ID|AWS_SECRET_ACCESS_KEY|GOOGLE_APPLICATION_CREDENTIALS) unset \"$name\" ;;\n"
    "  esac\n"
    "done < <(env)\n"
    "while [ \"$#\" -ge 2 ]; do\n"
    "  export \"$1=$2\"\n"
    "  shift 2\n"
    "done\n"
    "( eval \"$command_text\" ) &\n"
    "child=$!\n"
    "(\n"
    "  sleep \"$timeout_s\"\n"
    "  : > \"$timeout_marker\"\n"
    "  kill -TERM -\"$child\" 2>/dev/null || exit 0\n"
    "  sleep 2\n"
    "  kill -KILL -\"$child\" 2>/dev/null || true\n"
    ") &\n"
    "watchdog=$!\n"
    "wait \"$child\"\n"
    "status=$?\n"
    "if [ -e \"$timeout_marker\" ]; then\n"
    "  wait \"$watchdog\" 2>/dev/null\n"
    "  exit 124\n"
    "fi\n"
    "kill \"$watchdog\" 2>/dev/null\n"
    "wait \"$watchdog\" 2>/dev/null\n"
    "exit \"$status\"\n"))

(defn make-local-environment [& [opts]]
  (let [options (or opts {})
        working-dir (or (:working_dir options) (os/cwd))
        default-timeout (max 1 (or (:default_command_timeout_ms options) 10000))
        max-timeout (max 1 (or (:max_command_timeout_ms options) 600000))
        path-for (fn [path] (resolve-path working-dir path))
        exec-command
        (fn [command timeout-ms requested-dir env-vars]
          (let [dir (or requested-dir working-dir)
                started (System/currentTimeMillis)
                timeout (min max-timeout (max 1 (or timeout-ms default-timeout)))
                marker (str (os/temp-dir) "/lettractor-timeout-" (random-uuid))
                environment-args
                (vec (mapcat (fn [[key value]] [(str key) (str value)])
                             (or env-vars {})))
                result (apply os/sh
                              (concat ["/bin/bash" "-c" command-wrapper
                                       "lettractor" dir
                                       (str (/ timeout 1000.0))
                                       (str command) marker]
                                      environment-args))
                timed-out (some? (os/stat marker))
                _cleanup (os/sh "rm" "-f" marker)
                duration (- (System/currentTimeMillis) started)
                timeout-message
                (str "[ERROR: Command timed out after " timeout
                     "ms. Partial output is shown above.\n"
                     "You can retry with a longer timeout by setting the timeout_ms parameter.]")]
            {:stdout (:out result)
             :stderr (if timed-out
                       (str (:err result)
                            (when-not (str/blank? (:err result)) "\n")
                            timeout-message)
                       (:err result))
             :exit_code (if timed-out 124 (:exit result))
             :timed_out timed-out
             :duration_ms duration}))]
    (make-environment
      {:working_directory (fn [] working-dir)
       :with_working_directory
       (fn [directory]
         (make-local-environment
           (assoc options :working_dir (path-for directory))))
       :platform (fn [] (os/os-name))
       :os_version (fn [] (str (os/os-name) "/" (os/arch)))
       :inspect_command
       (fn [command]
         (let [result (os/sh "/bin/bash" "-c"
                             "cd \"$1\" && eval \"$2\""
                             "lettractor-inspect" working-dir command)]
           {:exit_code (:exit result)
            :stdout (:out result)
            :stderr (:err result)}))
       :read_file
       (fn [path offset limit]
         (numbered-lines (io/slurp (path-for path)) offset limit))
       :read_text (fn [path] (io/slurp (path-for path)))
       :write_file
       (fn [path content]
         (let [resolved (path-for path)]
           (when-let [parent (parent-path resolved)] (io/mkdir parent))
           (io/spit resolved content)
           nil))
       :file_exists (fn [path] (some? (os/stat (path-for path))))
       :apply_patch (fn [patch-text] (patch/apply-patch working-dir patch-text))
       :edit_file
       (fn [path old-string new-string replace-all]
         (let [resolved (path-for path)
               content (io/slurp resolved)
               matches (occurrence-count content old-string)]
           (when (= matches 0)
             (throw (ex-info "old_string was not found"
                             {:category :edit-not-found :path resolved})))
           (when (and (> matches 1) (not replace-all))
             (throw (ex-info "old_string is not unique; provide more context or set replace_all"
                             {:category :edit-not-unique :matches matches
                              :path resolved})))
           (io/spit resolved
                    (if replace-all
                      (str/replace content old-string new-string)
                      (str/replace-first content old-string new-string)))
           (if replace-all matches 1)))
       :list_directory
       (fn [path depth]
         (let [resolved (path-for (or path "."))]
           (mapv (fn [entry]
                   (let [stat (os/stat (str resolved "/" entry))]
                     {:name entry :is_dir (:dir? stat) :size (:size stat)}))
                 (os/ls resolved))))
       :exec_command exec-command
       :grep
       (fn [pattern path grep-options]
         (let [result (exec-command
                        (str "rg --line-number --color never -- "
                             (pr-str pattern) " " (pr-str (or path ".")))
                        10000 working-dir nil)]
           (str (:stdout result) (:stderr result))))
       :glob
       (fn [pattern path]
         (let [result (exec-command
                        (str "find " (pr-str (or path "."))
                             " -type f -path " (pr-str pattern))
                        10000 working-dir nil)]
           (vec (remove str/blank? (str/split (:stdout result) #"\r?\n")))))})))
