(ns attractor.execution
  (:require [clojure.string :as str]
            [clojure.core :as core]
            [io :as io]
            [os :as os]
            [attractor.patch :as patch]))

(defn make-environment [operations]
  (merge {:initialize (fn [] nil)
          :cleanup (fn [] nil)
          :working_directory (fn [] (os/cwd))
          :platform (fn [] (os/os-name))
          :os_version (fn [] "")}
         operations))

(defn- absolute-path? [path]
  (or (str/starts-with? path "/")
      (and (> (count path) 2) (= ":" (subs path 1 2)))))

(defn- resolve-path [working-dir path]
  (let [value (str (or path ""))]
    (if (absolute-path? value)
      value
      (str working-dir "/" value))))

(defn- parent-path [path]
  (let [index (str/last-index-of path "/")]
    (when (and (some? index) (> index 0))
      (subs path 0 index))))

(defn- numbered-lines [content offset limit]
  (let [lines (vec (str/split content #"\n"))
        start (max 0 (dec (or offset 1)))
        end (min (count lines) (+ start (or limit 2000)))]
    (if (>= start (count lines))
      ""
      (str/join
        "\n"
        (map-indexed (fn [index line]
                       (str (+ start index 1) " | " line))
                     (subvec lines start end))))))

(defn- image-media-type [raw]
  ;; subs counts characters, so its bounded 12-character prefix can contain
  ;; up to 48 bytes. Preserve those raw bytes, then select exactly the first
  ;; 12 bytes before inspecting fixed signature offsets (not rune offsets).
  ;; This identifies formats, not image validity or model format support.
  (let [prefix (vec (take 12 (bytes (subs raw 0 (min 12 (count raw))))))
        starts? (fn [signature]
                  (and (>= (count prefix) (count signature))
                       (= signature (subvec prefix 0 (count signature)))))]
    (cond
      (starts? [137 80 78 71 13 10 26 10]) "image/png"
      (starts? [255 216 255]) "image/jpeg"
      (or (starts? [71 73 70 56 55 97])
          (starts? [71 73 70 56 57 97])) "image/gif"
      (and (= 12 (count prefix)) (starts? [82 73 70 70])
           (= [87 69 66 80] (subvec prefix 8 12))) "image/webp"
      :else nil)))

(defn- read-local-file [path offset limit]
  (let [raw (io/slurp path)]
    (if-let [media-type (image-media-type raw)]
      {:content (str "Image file (" media-type ").")
       :image_base64 (base64-encode raw)
       :image_media_type media-type}
      (do
        ;; Match capture/valid-source: decoding and re-encoding must preserve
        ;; every UTF-8 byte, including genuine replacement characters.
        (when (or (not= raw (apply str (seq raw)))
                  (re-find #"[\x00-\x08\x0e-\x1f\x7f]" raw))
          (throw (ex-info "Cannot read unsupported binary file as text"
                          {:category :unsupported-binary-file :path path})))
        (numbered-lines raw offset limit)))))

(defn- occurrence-count [content needle]
  ;; Whitespace is valid exact-match text; only an empty needle cannot advance.
  (when (empty? needle)
    (throw (ex-info "old_string must not be empty"
                    {:category :invalid-edit})))
  (loop [start 0 total 0]
    (if-let [index (str/index-of content needle start)]
      (recur (+ index (count needle)) (inc total))
      total)))

(defn- option [options key]
  (if (contains? options key)
    (get options key)
    (get options (keyword key))))

(defn- shell-quote [value]
  (str "'" (str/replace (str value) "'" "'\"'\"'") "'"))

(defn- child-path [parent child]
  (str (str/replace parent #"/$" "") "/" child))

(defn- list-directory-tree [root relative depth]
  (mapcat
    (fn [entry]
      (let [absolute (child-path root entry)
            name (if (str/blank? relative)
                   entry
                   (child-path relative entry))
            stat (os/stat absolute)
            item {:name name :is_dir (:dir? stat) :size (:size stat)}]
        (if (and (:dir? stat) (> depth 1))
          (cons item (list-directory-tree absolute name (dec depth)))
          [item])))
    (sort (os/ls root))))

(defn- symbolic-link? [path]
  (= 0 (:exit (os/sh "/bin/test" "-L" path))))

(defn- walk-files [root relative]
  (let [stat (when-not (symbolic-link? root) (os/stat root))]
    (when (nil? stat)
      (when (str/blank? relative)
        (throw (ex-info (str "Search path does not exist: " root)
                        {:category :path-not-found :path root}))))
    (cond
      (nil? stat) []
      (:dir? stat)
      (mapcat
        (fn [entry]
          (walk-files (child-path root entry)
                      (if (str/blank? relative)
                        entry
                        (child-path relative entry))))
        (sort (os/ls root)))
      :else [[root (if (str/blank? relative) (:name stat) relative)]])))

(defn- regex-quoted-character [character]
  (if (str/includes? "\\.^$|(){}+*?[]" character)
    (str "\\" character)
    character))

(defn- glob-regex-source [pattern]
  (loop [index 0 source ""]
    (if (>= index (count pattern))
      (str "^" source "$")
      (let [character (subs pattern index (inc index))]
        (cond
          (= character "\\")
          (if (< (inc index) (count pattern))
            (recur (+ index 2)
                   (str source
                        (regex-quoted-character
                          (subs pattern (inc index) (+ index 2)))))
            (recur (inc index) (str source "\\\\")))

          (= character "[")
          (if-let [end (str/index-of pattern "]" (inc index))]
            (let [body (subs pattern (inc index) end)
                  negated (or (str/starts-with? body "!")
                              (str/starts-with? body "^"))
                  body (if negated (subs body 1) body)]
              (recur (inc end)
                     (str source "[" (when negated "^") body "]")))
            (recur (inc index) (str source "\\[")))

          (= character "*")
          (let [end (loop [cursor (inc index)]
                      (if (and (< cursor (count pattern))
                               (= "*" (subs pattern cursor (inc cursor))))
                        (recur (inc cursor))
                        cursor))
                recursive? (> end (inc index))
                slash? (and recursive?
                            (< end (count pattern))
                            (= "/" (subs pattern end (inc end))))]
            (recur (if slash? (inc end) end)
                   (str source
                        (cond slash? "(.*/)?"
                              recursive? ".*"
                              :else "[^/]*"))))

          (= character "?")
          (recur (inc index) (str source "[^/]"))

          :else
          (recur (inc index)
                 (str source (regex-quoted-character character))))))))

(defn- compile-glob-filter [glob-filter]
  (when-not (str/blank? glob-filter)
    (let [negated (str/starts-with? glob-filter "!")
          pattern (if negated (subs glob-filter 1) glob-filter)
          rooted (str/starts-with? pattern "/")
          pattern (if rooted
                    (subs pattern 1)
                    pattern)]
      (try
        {:negated negated
         :match_path (or rooted (str/includes? pattern "/"))
         :regex (re-pattern (glob-regex-source pattern))}
        (catch Object error
          (throw (ex-info (str "Invalid grep glob: " error)
                          {:category :grep-failed
                           :glob_filter glob-filter})))))))

(defn- last-path-segment [path]
  (last (str/split path #"/")))

(defn- glob-includes? [compiled relative]
  (if (nil? compiled)
    true
    (let [candidate (if (:match_path compiled)
                      relative
                      (last-path-segment relative))
          matches (some? (re-matches (:regex compiled) candidate))]
      (if (:negated compiled) (not matches) matches))))

(defn- displayed-glob-path [requested-path relative]
  (let [requested (str/replace (or requested-path ".") #"^\./" "")]
    (cond
      (or (= requested ".") (str/blank? requested)) relative
      :else (child-path requested relative))))

(defn- displayed-search-path [root requested-path relative]
  (let [requested (str/replace (or requested-path ".") #"^\./" "")
        root-stat (os/stat root)]
    (if (:dir? root-stat)
      (displayed-glob-path requested relative)
      (if (or (= requested ".") (str/blank? requested))
        relative
        requested))))

(defn- numeric-modification-time [path]
  (let [result (if (= "darwin" (os/os-name))
                 (os/sh "/usr/bin/stat" "-f" "%m" "--" path)
                 (os/sh "/usr/bin/stat" "-c" "%Y" "--" path))
        value (when (= 0 (:exit result))
                (parse-long (str/trim (:out result))))]
    (when (nil? value)
      (throw (ex-info (str "Could not read modification time for " path)
                      {:category :file-stat-failed
                       :path path
                       :exit_code (:exit result)})))
    value))

(defn- native-glob [root requested-path pattern]
  (let [compiled (compile-glob-filter pattern)]
    (when (nil? compiled)
      (throw (ex-info "Glob pattern must not be empty"
                      {:category :invalid-glob :pattern pattern})))
    (->> (walk-files root "")
         (filter (fn [[_ relative]] (glob-includes? compiled relative)))
         (map (fn [[absolute relative]]
                (let [stat (os/stat absolute)]
                  {:path (displayed-search-path root requested-path relative)
                   ;; Epoch seconds keep ordering correct across UTC offset
                   ;; changes; the formatted nanosecond timestamp breaks ties
                   ;; for files modified within the same second.
                   :mod_time [(numeric-modification-time absolute)
                              (:mod-time stat)]})))
         (sort-by (fn [entry] [(:mod_time entry) (:path entry)]))
         reverse
         (map :path)
         vec)))

(defn- native-grep
  [root requested-path pattern case-insensitive glob-filter max-results
   output-mode]
  (let [regex
        (try
          (re-pattern (str (when case-insensitive "(?i)") pattern))
          (catch Object error
            (throw (ex-info (str "Invalid grep pattern: " error)
                            {:category :grep-failed :pattern pattern}))))
        compiled-glob (compile-glob-filter glob-filter)
        file-results
        (map
          (fn [[absolute relative]]
            (let [displayed (displayed-search-path root requested-path relative)]
              (if (not (glob-includes? compiled-glob relative))
                {:relative displayed :matches []}
                {:relative displayed
               :matches
               (vec
                 (keep-indexed
                   (fn [index line]
                     (when (re-find regex line)
                         {:line_number (inc index) :content line}))
                     (str/split (io/slurp absolute) #"\r?\n")))})))
          (walk-files root ""))
        results
        (case output-mode
          "files_with_matches"
          (keep (fn [result]
                  (when (seq (:matches result)) (:relative result)))
                file-results)

          "count"
          (keep (fn [result]
                  (when (seq (:matches result))
                    (str (:relative result) ":" (count (:matches result)))))
                file-results)

          (mapcat
            (fn [result]
              (map (fn [match]
                     (str (:relative result) ":" (:line_number match) ":"
                          (:content match)))
                   (:matches result)))
            file-results))]
    (str/join "\n" (take max-results results))))

(def command-wrapper
  (str
    "workdir=$1\n"
    "timeout_s=$2\n"
    "command_text=$3\n"
    "timeout_marker=$4\n"
    "cancel_marker=$5\n"
    "env_policy=$6\n"
    "shift 6\n"
    "cd \"$workdir\" || exit 126\n"
    ;; Bash establishes the job's process group at spawn, before returning $!.
    ;; An external setsid launcher can still be starting when the deadline fires,
    ;; leaving no group to signal and allowing the command to run after timeout.
    "set -m\n"
    ;; Explicit assignments are argv for the child, never exports into this
    ;; wrapper: valid caller names can otherwise overwrite its control state.
    "command_env=(/usr/bin/env)\n"
    "case \"$env_policy\" in\n"
    "  filtered)\n"
    "    shopt -s nocasematch\n"
    "    while IFS='=' read -r name value; do\n"
    "      case \"$name\" in\n"
    "        *_API_KEY|*_SECRET|*_TOKEN|*_PASSWORD|*_CREDENTIAL|*_CREDENTIALS|AWS_ACCESS_KEY_ID|AWS_SECRET_ACCESS_KEY) unset \"$name\" ;;\n"
    "      esac\n"
    "    done < <(env)\n"
    "    shopt -u nocasematch\n"
    "    ;;\n"
    "  all) ;;\n"
    ;; Bash synthesizes a default PATH when it is absent. Supplying an empty
    ;; value preserves the observable "inherit none" contract; an explicit
    ;; per-command PATH is appended later and therefore overrides it.
    "  none) command_env=(/usr/bin/env -i PATH=) ;;\n"
    "  core)\n"
    "    command_env=(/usr/bin/env -i)\n"
    "    for name in PATH HOME USER SHELL LANG TERM TMPDIR GOPATH GOROOT CARGO_HOME RUSTUP_HOME NVM_DIR NODE_PATH PYTHONPATH VIRTUAL_ENV JAVA_HOME CLASSPATH GEM_HOME GEM_PATH BUNDLE_PATH DOTNET_ROOT; do\n"
    "      if [ \"${!name+x}\" = x ]; then command_env+=(\"$name=${!name}\"); fi\n"
    "    done\n"
    "    ;;\n"
    "esac\n"
    "while [ \"$#\" -ge 2 ]; do\n"
    "  command_env+=(\"$1=$2\")\n"
    "  shift 2\n"
    "done\n"
    "\"${command_env[@]}\" /bin/bash -p -c '\n"
    "  [ ! -e \"$1\" ] || exit 124\n"
    "  [ ! -e \"$2\" ] || exit 130\n"
    "  exec /bin/bash -c \"$3\"\n"
    "' command-child \"$timeout_marker\" \"$cancel_marker\" \"$command_text\" &\n"
    "child=$!\n"
    ;; The group remains owned after monitor mode is disabled; helper jobs need
    ;; no separate group. Each helper is disowned as soon as it starts so bash
    ;; never prints a "Killed: 9" job notification into the captured stderr
    ;; when the wrapper kills it (the spec requires exact separate stderr).
    "set +m\n"
    "(\n"
    "  sleep \"$timeout_s\"\n"
    "  : > \"$timeout_marker\"\n"
    "  kill -TERM -\"$child\" 2>/dev/null || exit 0\n"
    "  sleep 2\n"
    "  kill -KILL -\"$child\" 2>/dev/null || true\n"
    ") >/dev/null 2>&1 &\n"
    "watchdog=$!\n"
    "disown \"$watchdog\" 2>/dev/null\n"
    "(\n"
    "  while [ ! -e \"$cancel_marker\" ]; do sleep 0.05; done\n"
    "  kill -TERM -\"$child\" 2>/dev/null || exit 0\n"
    "  sleep 2\n"
    "  kill -KILL -\"$child\" 2>/dev/null || true\n"
    ") >/dev/null 2>&1 &\n"
    "canceller=$!\n"
    "disown \"$canceller\" 2>/dev/null\n"
    "wait \"$child\" 2>/dev/null\n"
    "status=$?\n"
    "if [ -e \"$cancel_marker\" ]; then\n"
    "  kill -KILL \"$watchdog\" 2>/dev/null\n"
    "  wait \"$watchdog\" 2>/dev/null\n"
    "  wait \"$canceller\" 2>/dev/null\n"
    "  exit 130\n"
    "fi\n"
    "if [ -e \"$timeout_marker\" ]; then\n"
    "  kill -KILL \"$canceller\" 2>/dev/null\n"
    "  wait \"$canceller\" 2>/dev/null\n"
    "  wait \"$watchdog\" 2>/dev/null\n"
    "  exit 124\n"
    "fi\n"
    "kill -KILL \"$watchdog\" 2>/dev/null\n"
    "kill -KILL \"$canceller\" 2>/dev/null\n"
    "wait \"$watchdog\" 2>/dev/null\n"
    "wait \"$canceller\" 2>/dev/null\n"
    "exit \"$status\"\n"))

(defn make-local-environment [& [opts]]
  (let [options (or opts {})
        working-dir (or (:working_dir options) (os/cwd))
        default-timeout (max 1 (or (:default_command_timeout_ms options) 10000))
        max-timeout (max 1 (or (:max_command_timeout_ms options) 600000))
        raw-env-policy (or (:env_policy options) :filtered)
        env-policy (if (keyword? raw-env-policy)
                     (name raw-env-policy)
                     (str raw-env-policy))
        _ (when-not (contains? #{"filtered" "all" "none" "core"} env-policy)
            (throw
              (ex-info
                (str "Unknown environment inheritance policy: " raw-env-policy)
                {:category :invalid-environment-policy
                 :env_policy raw-env-policy})))
        rg-command (or (:rg_command options) "rg")
        lifecycle
        (or (:_lifecycle options)
            {:active_commands (atom {})
             :command_counter (atom 0)
             :environment_id (System/nanoTime)
             :control_lock (atom false)
             :closed (atom false)})
        active-commands (:active_commands lifecycle)
        command-counter (:command_counter lifecycle)
        environment-id (:environment_id lifecycle)
        control-lock (:control_lock lifecycle)
        closed (:closed lifecycle)
        acquire-control-lock!
        (fn []
          (loop []
            (when-not (compare-and-set! control-lock false true)
              (core/sleep 1)
              (recur))))
        with-control-lock
        (fn [operation]
          (acquire-control-lock!)
          (try
            (operation)
            (finally
              (reset! control-lock false))))
        path-for (fn [path] (resolve-path working-dir path))
        exec-command
        (fn [command timeout-ms requested-dir env-vars]
          (let [dir (if requested-dir (path-for requested-dir) working-dir)
                started (System/currentTimeMillis)
                timeout (min max-timeout (max 1 (or timeout-ms default-timeout)))
                command-id (str environment-id "-" started "-"
                                (swap! command-counter inc))
                timeout-marker (str (os/temp-dir) "/lettractor-timeout-" command-id)
                cancel-marker (str (os/temp-dir) "/lettractor-cancel-" command-id)
                explicit-environment (or env-vars {})
                _ (doseq [[key _] explicit-environment]
                    (when (nil? (re-matches #"[A-Za-z_][A-Za-z0-9_]*"
                                            (str key)))
                      (throw
                        (ex-info
                          (str "Invalid environment variable name: " key)
                          {:category :invalid-environment-variable
                           :name (str key)}))))
                environment-args
                (vec (mapcat (fn [[key value]] [(str key) (str value)])
                             explicit-environment))
                registered?
                (with-control-lock
                  (fn []
                    (when-not @closed
                      (swap! active-commands assoc command-id cancel-marker)
                      true)))]
            (if-not registered?
              {:stdout ""
               :stderr "[ERROR: Command cancelled because the execution environment is closed.]"
               :exit_code 130 :timed_out false :cancelled true
               :duration_ms 0}
              (try
                (let [result
                      (apply os/sh
                             ;; Privileged mode suppresses BASH_ENV, ENV,
                             ;; inherited functions, and startup-option imports
                             ;; before the wrapper has sanitized the child env.
                             (concat ["/bin/bash" "--noprofile" "--norc"
                                      "-p" "-c" command-wrapper
                                      "lettractor" dir
                                      (str (/ timeout 1000.0))
                                      (str command) timeout-marker cancel-marker
                                      env-policy]
                                     environment-args))
                      timed-out (some? (os/stat timeout-marker))
                      cancelled (some? (os/stat cancel-marker))
                      duration (- (System/currentTimeMillis) started)
                      timeout-message
                      (str "[ERROR: Command timed out after " timeout
                           "ms. Partial output is shown above.\n"
                           "You can retry with a longer timeout by setting the timeout_ms parameter.]")
                      cancel-message
                      "[ERROR: Command cancelled by session shutdown. Partial output is shown above.]"
                      message (cond cancelled cancel-message
                                    timed-out timeout-message
                                    :else nil)]
                  {:stdout (:out result)
                   :stderr (if message
                             (str (:err result)
                                  (when-not (str/blank? (:err result)) "\n")
                                  message)
                             (:err result))
                   :exit_code (cond cancelled 130
                                    timed-out 124
                                    :else (:exit result))
                   :timed_out (boolean timed-out)
                   :cancelled (boolean cancelled)
                   :duration_ms duration})
                (finally
                  (with-control-lock
                    (fn [] (swap! active-commands dissoc command-id)))
                  (os/sh "rm" "-f" timeout-marker)
                  (os/sh "rm" "-f" cancel-marker))))))
        exec-command-stdin
        (fn [command timeout-ms requested-dir env-vars input]
          (when-not (string? input)
            (throw (ex-info "Command stdin must be a string" {:category :invalid-command-stdin})))
          (let [created (os/sh "/usr/bin/mktemp" "-d" (str (os/temp-dir) "/lettractor-stdin.XXXXXXXX"))]
            (when-not (= 0 (:exit created))
              (throw (ex-info "Unable to create private stdin directory" {:category :stdin-temp-create :stderr (:err created)})))
            (let [directory (str/trim (:out created))
                  payload (atom nil)
                  primary-error (atom nil)
                  command-result (atom nil)
                  remove-owned (fn [& args]
                                 (try (apply os/sh args)
                                      (catch Object error {:exit -1 :error (ex-message error)
                                                           :data (ex-data error)})))]
              (try
                (let [file-result (os/sh "/usr/bin/mktemp" (str directory "/input.XXXXXXXX"))]
                  (when-not (= 0 (:exit file-result))
                    (throw (ex-info "Unable to create private stdin file" {:category :stdin-temp-create :stderr (:err file-result)})))
                  (reset! payload (str/trim (:out file-result)))
                  ;; mktemp creates the directory/file exclusively with 0700/0600.
                  ;; spit opens the existing file without widening its permissions.
                  (io/spit @payload input)
                  (reset! command-result
                    (exec-command
                      (str "/bin/bash --noprofile --norc -p -c " (shell-quote command)
                           " < " (shell-quote @payload))
                      timeout-ms requested-dir env-vars)))
                (catch Object error (reset! primary-error error) (throw error))
                (finally
                  (let [remove-result (when @payload (remove-owned "/bin/rm" "-f" "--" @payload))
                        directory-result (remove-owned "/bin/rmdir" "--" directory)
                        failures (vec (filter #(and % (not= 0 (:exit %))) [remove-result directory-result]))]
                    (when (seq failures)
                      (throw (ex-info (if @primary-error (ex-message @primary-error) "Unable to clean up command stdin")
                                      (merge (if @primary-error (ex-data @primary-error) {:category :stdin-temp-cleanup})
                                             (when @command-result {:command_result @command-result})
                                             {:stdin_cleanup {:file @payload :directory directory :failures failures}}))))))))))
        cleanup
        (fn []
          (let [signal-errors (atom [])]
            (with-control-lock
              (fn []
                (reset! closed true)
                (doseq [[command-id marker] @active-commands]
                  (try
                    (io/spit marker "")
                    (catch Object error
                      (swap! signal-errors conj
                             {:command_id command-id
                              :error (str error)}))))))
            (let [deadline (+ (System/currentTimeMillis) 3000)]
              (loop []
                (when (and (seq @active-commands)
                           (< (System/currentTimeMillis) deadline))
                  (core/sleep 10)
                  (recur))))
            (let [remaining (vec (keys @active-commands))]
              (when (or (seq @signal-errors) (seq remaining))
                (throw
                  (ex-info
                    "Execution environment cleanup did not terminate every command"
                    {:category :execution-cleanup-failed
                     :signal_errors @signal-errors
                     :active_command_ids remaining}))))))]
    (make-environment
      {:cleanup cleanup
       :working_directory (fn [] working-dir)
       :with_working_directory
       (fn [directory]
         (make-local-environment
           (assoc options
                  :working_dir (path-for directory)
                  :_lifecycle lifecycle)))
       :platform (fn [] (os/os-name))
       :os_version (fn [] (str (os/os-name) "/" (os/arch)))
       :inspect_command
       (fn [command]
         (let [result (os/sh "/bin/bash" "-c"
                             "cd \"$1\" && eval \"$2\""
                             "lettractor-inspect" working-dir command)]
           {:exit_code (:exit result)
            :stdout (:out result)
            :stderr (:err result)}))
       :read_file
       (fn [path offset limit]
         (read-local-file (path-for path) offset limit))
       :read_text (fn [path] (io/slurp (path-for path)))
       :write_file
       (fn [path content]
         (let [resolved (path-for path)]
           (when-let [parent (parent-path resolved)] (io/mkdir parent))
           (io/spit resolved content)
           nil))
       :file_exists (fn [path] (some? (os/stat (path-for path))))
       :apply_patch (fn [patch-text] (patch/apply-patch working-dir patch-text))
       :edit_file
       (fn [path old-string new-string replace-all]
         (let [resolved (path-for path)
               content (io/slurp resolved)
               matches (occurrence-count content old-string)]
           (when (= matches 0)
             (throw (ex-info "old_string was not found"
                             {:category :edit-not-found :path resolved})))
           (when (and (> matches 1) (not replace-all))
             (throw (ex-info "old_string is not unique; provide more context or set replace_all"
                             {:category :edit-not-unique :matches matches
                              :path resolved})))
           (io/spit resolved
                    (if replace-all
                      (str/replace content old-string new-string)
                      (str/replace-first content old-string new-string)))
           (if replace-all matches 1)))
       :list_directory
       (fn [path depth]
         (let [resolved (path-for (or path "."))
               requested-depth (max 1 (or depth 1))]
           (vec (list-directory-tree resolved "" requested-depth))))
       :exec_command exec-command
       :exec_command_stdin exec-command-stdin
       :grep
       (fn [pattern path grep-options]
         (let [options (or grep-options {})
               case-insensitive (boolean (option options "case_insensitive"))
               glob-filter (option options "glob_filter")
               requested-mode (or (option options "output_mode") "content")
               output-mode (if (keyword? requested-mode)
                             (name requested-mode)
                             requested-mode)
               _ (when-not (contains? #{"content" "files_with_matches" "count"}
                                      output-mode)
                   (throw
                     (ex-info (str "Unsupported grep output mode: " output-mode)
                              {:category :invalid-grep-output-mode
                               :output_mode output-mode})))
               requested-limit (or (option options "max_results") 100)
               max-results (max 1 requested-limit)
               mode-flag (case output-mode
                           "files_with_matches" "--files-with-matches"
                           "count" "--count"
                           "--line-number")
               flags (cond-> [mode-flag "--with-filename" "--sort" "path"
                              "--color" "never"]
                       case-insensitive (conj "--ignore-case")
                       (not (str/blank? glob-filter))
                       (conj "--glob" (shell-quote glob-filter)))
               command (str/join
                         " "
                         (concat [(shell-quote rg-command)] flags
                                 ["--" (shell-quote pattern)
                                  (shell-quote (or path "."))]))
               result (exec-command command 10000 working-dir nil)
               exit-code (:exit_code result)]
           (cond
             (= 127 exit-code)
             (native-grep (path-for (or path ".")) path pattern
                          case-insensitive glob-filter max-results output-mode)

             (or (= 0 exit-code) (= 1 exit-code))
             (str/join "\n"
                       (take max-results
                             (map (fn [line]
                                    (str/replace line #"^\./" ""))
                                  (remove str/blank?
                                          (str/split (:stdout result)
                                                     #"\r?\n")))))

             :else
             (throw
               (ex-info
                 (str "grep failed with exit code " exit-code
                      (when-not (str/blank? (:stderr result))
                        (str ": " (str/trim (:stderr result)))))
                 {:category :grep-failed
                  :exit_code exit-code
                  :timed_out (:timed_out result)
                  :cancelled (:cancelled result)})))))
       :glob
       (fn [pattern path]
         (try
           (native-glob (path-for (or path ".")) path pattern)
           (catch Object error
             (throw
               (ex-info
                 (str "glob failed: " error)
                 {:category :glob-failed
                  :cause_category (:category (ex-data error))})))))})))
