(ns attractor.llm
  (:require [attractor.ids :as ids] [clojure.string :as str]
            [clojure.core :as core]
            [json :as json]
            [os :as os]
            [io :as io]
            [math :as math]
            [http :as http]
            [attractor.context-discovery :as capacity]
            [attractor.models :as models]
            [attractor.providers :as providers]
            [attractor.operation-owner :as owner]))

(defn- response-header [response header-name]
  (let [headers (or (:headers response) {})
        lower-name (str/lower-case header-name)]
    (or (get headers header-name)
        (get headers lower-name)
        (get headers (keyword header-name))
        (get headers (keyword lower-name))
        (some (fn [[key value]]
                (when (= lower-name
                         (str/lower-case (if (keyword? key) (name key) (str key))))
                  value))
              headers))))

(def default-adapter-timeout
  "Seconds. :connect bounds establishing the connection, :request the time
   to a complete response (to the headers, for streams), :stream_read the
   longest silence between stream chunks."
  {:connect 10.0 :request 120.0 :stream_read 30.0})

(defn- transport-request-options [request options]
  (cond-> (assoc options :timeout (merge default-adapter-timeout (:adapter_timeout request)))
    (some? (:abort_signal request))
    (assoc :abort_signal (:abort_signal request))))

(defn transport-failure
  "Normalize a raw transport failure into a typed error: a connect or
   stream-read timeout and other socket failures are network errors
   (retryable); a request-scope timeout is a request timeout (not retried);
   a cancelled context is an abort. Typed errors are returned unchanged."
  [e]
  (if (or (some? (:category (ex-data e))) (contains? (or (ex-data e) {}) :retryable))
    e
    (let [message (str (ex-message e))
          lower (str/lower-case message)]
      (ex-info message
               (cond
                 (str/includes? lower "http request timeout")
                 {:category :request-timeout :retryable false :scope :request :cause e}
                 (str/includes? lower "http connect timeout")
                 {:category :network :retryable true :scope :connect :cause e}
                 (str/includes? lower "http stream_read timeout")
                 {:category :network :retryable true :scope :stream_read :cause e}
                 (or (str/includes? lower "context canceled")
                     (str/includes? lower "cancelled")
                     (str/includes? lower "canceled"))
                 {:category :abort :retryable false :cause e}
                 :else
                 {:category :network :retryable true :cause e})))))

(defn- invoke-transport
  "Call the HTTP transport, normalizing raw failures with transport-failure."
  [transport options]
  (try
    (transport options)
    (catch Object e (throw (transport-failure e)))))

(defn- http-date-delay [text]
  (let [current (.UTC (now))
        standard (re-matches #"(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun), ([0-9]{2}) ([A-Z][a-z]{2}) ([0-9]{4}) ([0-9]{2}:[0-9]{2}:[0-9]{2}) GMT" text)
        legacy (re-matches #"(?:Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday), ([0-9]{2})-([A-Z][a-z]{2})-([0-9]{2}) ([0-9]{2}:[0-9]{2}:[0-9]{2}) GMT" text)
        ascii-date (re-matches #"(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun) ([A-Z][a-z]{2}) ([ 0-9][0-9]) ([0-9]{2}:[0-9]{2}:[0-9]{2}) ([0-9]{4})" text)
        parts (or (when standard (vec (rest standard)))
                  (when legacy
                    (let [year (.Year current)
                          candidate (+ (* 100 (quot year 100)) (parse-long (get legacy 3)))
                          resolved (if (> candidate (+ year 50)) (- candidate 100) candidate)]
                      [(get legacy 1) (get legacy 2) (str resolved) (get legacy 4)]))
                  (when ascii-date [(str/trim (get ascii-date 2)) (get ascii-date 1)
                                    (get ascii-date 4) (get ascii-date 3)]))]
    (when parts
      (let [[day month year clock] parts
            months {"Jan" 1 "Feb" 2 "Mar" 3 "Apr" 4 "May" 5 "Jun" 6
                    "Jul" 7 "Aug" 8 "Sep" 9 "Oct" 10 "Nov" 11 "Dec" 12}
            m (get months month)
            d (parse-long day)
            y (parse-long year)
            pad (fn [n] (if (< n 10) (str "0" n) (str n)))
            ;; Validate calendar fields through the runtime's ISO date parser.
            ;; ISO parsing rejects leap seconds; preserve :60 in the arithmetic
            ;; below while validating its date using the preceding second.
            validation-clock (if (= clock "23:59:60") "23:59:59" clock)
            _ (read-string (str "#inst \"" year "-" (pad m) "-" (pad d) "T" validation-clock "Z\""))
            previous (dec y)
            leap? (and (zero? (mod y 4)) (or (not (zero? (mod y 100))) (zero? (mod y 400))))
            days (+ (* 365 previous) (quot previous 4) (- (quot previous 100))
                    (quot previous 400) -719162
                    (get [0 31 59 90 120 151 181 212 243 273 304 334] (dec m))
                    (if (and leap? (> m 2)) 1 0) (dec d))
            [hour minute second] (mapv parse-long (str/split clock #":"))
            target (* 1000 (+ (* days 86400) (* hour 3600) (* minute 60) second))]
        ;; A legacy date beyond fifty calendar years denotes the preceding
        ;; century. That date is necessarily past, hence a zero retry delay.
        (if (and legacy (> target (inst-ms (.AddDate current 50 0 0))))
          0.0
          (max 0.0 (/ (- target (inst-ms current)) 1000.0)))))))

(defn- parse-retry-after [response]
  (when-let [value (response-header response "Retry-After")]
    (try
      (let [text (str/trim (str value))]
        (try (let [delay (double (parse-double text))]
               ;; Infinity minus itself is NaN; finite values subtract to zero.
               (when (and (>= delay 0.0) (zero? (- delay delay))) delay))
             (catch Object _ (http-date-delay text))))
      (catch Object _ nil))))

(defn- error-body-map [body]
  (try
    (if (map? body) body (json/read-json (str body)))
    (catch Object _ nil)))

(defn- error-field [body-map key]
  (or (get-in body-map ["error" key])
      (get body-map key)))

(defn- classify-provider-error [status body-map body-text]
  (let [message (str/lower-case
                  (str (or (error-field body-map "message") body-text "")))
        grpc-code (error-field body-map "status")
        grpc-category (get {"NOT_FOUND" :not-found
                            "INVALID_ARGUMENT" :invalid-request
                            "UNAUTHENTICATED" :authentication
                            "PERMISSION_DENIED" :access-denied
                            "RESOURCE_EXHAUSTED" :rate-limit
                            "UNAVAILABLE" :server
                            "DEADLINE_EXCEEDED" :request-timeout
                            "INTERNAL" :server} grpc-code)
        error-code (error-field body-map "code")]
    (cond
      ;; Service names in an outage message do not turn a server failure into
      ;; a client-side policy or billing rejection. Native status takes priority.
      (or (= grpc-category :server)
          (and (nil? grpc-category) (number? status) (<= 500 status 599))) :server
      (or (str/includes? message "context length")
          (str/includes? message "too many tokens")) :context-length
      (or (str/includes? message "content filter")
          (str/includes? message "safety")) :content-filter
      (and (str/includes? message "quota")
           (not (str/includes? message "rate"))) :quota-exceeded
      (or (str/includes? message "credit balance")
          (str/includes? message "insufficient credit")
          (str/includes? message "billing")) :quota-exceeded
      (and (= error-code "insufficient_quota") (= status 429)) :quota-exceeded
      grpc-category grpc-category
      (or (= status 401)
          (str/includes? message "unauthorized")
          (str/includes? message "invalid key")) :authentication
      (= status 403) :access-denied
      (or (= status 404)
          (str/includes? message "not found")
          (str/includes? message "does not exist")) :not-found
      (or (= status 400) (= status 422)) :invalid-request
      (= status 408) :request-timeout
      (= status 413) :context-length
      (= status 429) :rate-limit
      (and (number? status) (>= status 500)) :server
      :else :provider)))

(def non-retryable-error-categories
  #{:authentication :access-denied :not-found :invalid-request
    :context-length :quota-exceeded :content-filter :request-timeout
    :configuration})

(defn provider-error [provider response]
  (let [status (:status response)
        body-text (str (:body response))
        raw (error-body-map (:body response))
        category (classify-provider-error status raw body-text)
        retryable (if (contains? non-retryable-error-categories category)
                    false
                    true)]
    (ex-info
      (str provider " API HTTP " status ": " body-text)
      {:category category
       :provider provider
       :status_code status
       :status status
       :error_code (or (error-field raw "code")
                       (get (or (get raw "error") raw) "type"))
       :retryable retryable
       :retry_after (parse-retry-after response)
       :raw raw})))

(defn malformed-body-error
  "A 2xx response whose body is not the provider's JSON object contract is a
   provider defect, not a transient transport signal: it is normalized to the
   generic provider category and never retried."
  [provider body-text cause]
  (ex-info
    (str provider " API returned a malformed response body")
    {:category :provider
     :provider provider
     :retryable false
     :malformed_body true
     :body (subs (str body-text) 0 (min 256 (count (str body-text))))
     :cause (when cause (ex-message cause))}))

(defn parse-response-body
  "Parse a provider's non-streaming success body, raising a normalized
   malformed-body error unless it is a JSON object."
  [provider body-text]
  (let [parsed (try (json/read-json (str body-text))
                    (catch Object e
                      (throw (malformed-body-error provider body-text e))))]
    (if (map? parsed)
      parsed
      (throw (malformed-body-error provider body-text nil)))))

(defn raise-provider-error! [provider response]
  (throw (provider-error provider response)))

;; Resolve base URL for a given provider: explicit value, <ID>_BASE_URL,
;; then the provider registry (built-ins, user and project attractor.edn).
(defn resolve-base-url [provider & [custom-base]]
  (let [p (str/lower-case (or provider "openai"))]
    (when (nil? (providers/protocol-of p))
      (throw (ex-info (str "Unknown LLM provider: " p "; configure it under :providers in attractor.edn")
                      {:category :configuration :provider p :retryable false})))
    (or (providers/base-url p custom-base)
        (throw (ex-info (str p " requires a base URL: set " (providers/env-name p "_BASE_URL")
                             ", pass :base_url, or add :base_url under :providers in attractor.edn")
                        {:category :configuration :provider p :retryable false})))))

;; Resolve API key for a given provider: explicit value, <ID>_API_KEY, then
;; the registry's :api_key_env. Chat-completions servers usually ignore the
;; bearer token but the contract still sends one, so they get a placeholder.
(defn resolve-api-key [provider & [custom-key]]
  (let [p (str/lower-case (or provider "openai"))]
    (providers/api-key p custom-key)))

;; Cache for discovered provider models
(defonce provider-models-cache (atom {}))

;; Query models list from provider API (GET /v1/models)
(defn fetch-models [provider & [opts]]
  (let [p (str/lower-case (or provider "openai"))
        protocol (providers/protocol-of p)
        _ (when-not (providers/model-discovery? p)
            (throw (ex-info (str p " does not support model discovery (:model_discovery false in attractor.edn)")
                            {:category :configuration :provider p :retryable false})))
        base (resolve-base-url p (:base_url opts))
        key (resolve-api-key p (:api_key opts))
        url (str base "/models")
        headers (merge (if (= protocol :anthropic-messages)
                         {"anthropic-version" "2023-06-01"}
                         {"Content-Type" "application/json"})
                       (providers/auth-headers p key protocol))]
    (try
      (let [resp (http/request {:method :get :url url :headers headers})
            status (:status resp)
            body-str (str (:body resp))]
        (if (= status 200)
          (let [body-map (json/read-json body-str)
                data (or (get body-map "data") (get body-map "models") [])
                models (mapv (fn [m]
                               (let [id (if (map? m)
                                          (or (get m "id") (get m "name") (str m))
                                          (str m))]
                                 ;; Gemini lists "models/<id>".
                                 (if (str/starts-with? id "models/") (subs id 7) id)))
                             data)]
            (swap! provider-models-cache assoc p models)
            models)
          (do
            (println (str "Failed to fetch models from " p " (" url "): HTTP " status))
            [])))
      (catch Object e
        (println (str "Error querying models from " p " (" url "): " e))
        []))))

;; Discover model identifiers from a live provider endpoint.
(defn discover-models [provider & [opts]]
  (let [p (str/lower-case (or provider "openai"))
        cached (get @provider-models-cache p)]
    (if (and cached (not (:refresh opts)))
      cached
      (fetch-models p opts))))

;; Advisory built-in model catalog.
(defn list-models [& [provider]] (models/list-models provider))
(defn get-model-info [model-id] (models/get-model-info model-id))
(defn get-latest-model [provider & [capability]]
  (models/get-latest-model provider capability))

;; Detect provider for a model by querying active provider endpoints
(defn detect-provider [model]
  (let [m (str (or model ""))]
    (cond
      (str/blank? m) "mock"

      ;; Check known provider model lists if available
      (some #{m} (get @provider-models-cache "openai-compat" []))
      "openai-compat"

      (some #{m} (get @provider-models-cache "openai" []))
      "openai"

      (some #{m} (get @provider-models-cache "anthropic" []))
      "anthropic"

      ;; Fallback heuristics when offline or uncached
      (or (str/starts-with? m "gpt-") (str/starts-with? m "o1") (str/starts-with? m "o3"))
      "openai"

      (str/starts-with? m "claude-")
      "anthropic"

      (str/starts-with? m "gemini-")
      "gemini"

      ;; Unprefixed names with no recognizable family fall back to the
      ;; built-in Chat Completions provider when it has a base URL; other
      ;; configured providers must be addressed by prefix.
      (providers/base-url "openai-compat")
      "openai-compat"

      :else
      "mock")))

;; Split string once by separator
(defn- split-once [s sep]
  (let [idx (str/index-of s sep)]
    (if idx
      [(subs s 0 idx) (subs s (+ idx (count sep)))]
      [s ""])))

;; Parse LiteLLM-style provider/model convention
;; e.g. "openai-compat/qwen3.5:397b" -> {:provider "openai-compat" :model "qwen3.5:397b"}
;;      "anthropic/claude-3-7-sonnet" -> {:provider "anthropic" :model "claude-3-7-sonnet"}
;;      "openai/gpt-4o" -> {:provider "openai" :model "gpt-4o"}
;;      "gpt-4o" -> {:provider "openai" :model "gpt-4o"}
(defn parse-model-spec [model-str & [explicit-provider]]
  (let [s (str (or model-str ""))]
    (if (and (str/includes? s "/") (not (str/starts-with? s "/")))
      (let [[provider-prefix actual-model] (split-once s "/")]
        {:provider (str/lower-case (str/trim provider-prefix))
         :model (str/trim actual-model)})
      {:provider (or explicit-provider (detect-provider s))
       :model s})))

;; Unified request construction
(defn make-request [model messages & [opts]]
  (let [parsed (parse-model-spec model (:provider opts))
        resolved-provider (or (:provider opts) (:provider parsed))
        resolved-model (:model parsed)]
    (merge (or opts {})
           {:provider resolved-provider
            :model resolved-model
            :messages messages
            :tools (or (:tools opts) [])})))

;; Mock Provider for reproducible offline execution & testing
(declare message-text-content)

(defn mock-complete [request & [mock-handler]]
  (if mock-handler
    (mock-handler request)
    (let [last-msg (last (:messages request))
          text (if (map? last-msg)
                 (message-text-content last-msg)
                 (str last-msg))
          response-text
          (str "[Mock LLM (" (:model request) ")]: Response to: "
               (subs text 0 (min (count text) 100)))
          parts [{:kind :text :text response-text}]]
      {:id (str "mock-" (System/currentTimeMillis))
       :model (:model request)
       :provider "mock"
       :message {:role :assistant
                 :content parts :parts parts :text response-text}
       :usage {:input_tokens 50 :output_tokens 50 :total_tokens 100}
       :finish_reason :stop
       :warnings []})))

;; Resolve and normalize OpenAI API endpoint URL
(defn resolve-openai-url [base-url]
  (let [env-url (let [u (os/getenv "OPENAI_BASE_URL")] (when-not (str/blank? u) u))
        b (str/trim (or (when-not (str/blank? base-url) base-url) env-url "https://api.openai.com/v1"))]
    (cond
      (str/ends-with? b "/responses") b
      (str/ends-with? b "/") (str b "responses")
      :else (str b "/responses"))))

(defn resolve-openai-compatible-url [base-url & [provider]]
  (let [b (resolve-base-url (or provider "openai-compat") base-url)]
    (cond
      (str/ends-with? b "/chat/completions") b
      (str/ends-with? b "/") (str b "chat/completions")
      :else (str b "/chat/completions"))))

;; Resolve and normalize Anthropic API endpoint URL
(defn resolve-anthropic-url [base-url]
  (let [env-url (let [u (os/getenv "ANTHROPIC_BASE_URL")] (when-not (str/blank? u) u))
        b (str/trim (or (when-not (str/blank? base-url) base-url) env-url "https://api.anthropic.com/v1"))]
    (cond
      (str/ends-with? b "/messages") b
      (str/ends-with? b "/") (str b "messages")
      :else (str b "/messages"))))

(defn resolve-gemini-url [base-url model]
  (let [base (resolve-base-url "gemini" base-url)
        clean-model (if (str/starts-with? (str model) "models/")
                      (subs (str model) 7)
                      (str model))]
    (str base "/models/" clean-model ":generateContent")))

;; OpenAI Adapter
(defn normalize-openai-tool-calls [tool-calls]
  (mapv
    (fn [tool-call]
      (let [function-data (or (get tool-call "function") tool-call)
            arguments-present? (contains? function-data "arguments")
            supplied-arguments (get function-data "arguments")
            raw-arguments (if arguments-present? supplied-arguments "{}")
            arguments (if (string? raw-arguments)
                        (try (json/read-json raw-arguments)
                             ;; Preserve malformed provider output so the tool
                             ;; execution layer can return an error result. An
                             ;; empty map could pass a permissive schema and
                             ;; incorrectly execute a side-effecting tool.
                             (catch Object _ raw-arguments))
                        raw-arguments)]
        (cond->
          {:id (or (get tool-call "call_id") (get tool-call "id") "")
           :name (or (get function-data "name") "")
           :arguments arguments}
          arguments-present?
          (assoc :raw_arguments supplied-arguments))))
    (or tool-calls [])))

(defn normalize-anthropic-tool-calls [content-blocks]
  (mapv (fn [block]
          {:id (or (get block "id") "")
           :name (or (get block "name") "")
           :arguments (or (get block "input") {})})
        (filter (fn [block] (= (get block "type") "tool_use"))
                (or content-blocks []))))

(defn- finish-reason [provider-reason]
  (case (str/lower-case (str (or provider-reason "")))
    ("stop" "end_turn" "stop_sequence") :stop
    ("max_tokens" "max_tokens_reached") :length
    ("tool_use" "tool_calls") :tool_calls
    ("safety" "content_filter") :content_filter
    :other))

(defn- request-api-key [request positional-key env-name]
  (if (contains? request :api_key)
    (:api_key request)
    (or positional-key (os/getenv env-name) "")))

(defn- require-api-key! [provider key & [protocol]]
  (when (and (str/blank? key) (providers/credential-required? provider protocol))
    (throw (ex-info (str "Missing API key for provider: " provider
                         " (set " (str/join " or " (providers/key-env-names provider))
                         ", :api_key in attractor.edn, or an :auth scheme that needs none)")
                    {:provider provider :category :configuration :retryable false})))
  key)

(defn- request-headers
  "Base headers plus the provider's credential presentation for `request`,
   which carries the registry id in :provider; `protocol` gives the default
   scheme for ids the registry does not know."
  [request key protocol base-headers]
  (merge base-headers (providers/auth-headers (or (:provider request) (name protocol)) key protocol)))

(defn- content-kind [part]
  (let [kind (or (:kind part) (:type part) (get part "kind") (get part "type"))]
    (when (some? kind)
      (if (keyword? kind) kind (keyword (str kind))))))

(defn- message-content-parts [message]
  (let [content (:content message)
        parts (:parts message)]
    (cond
      (seq parts) (vec parts)
      (vector? content) content
      (nil? content) []
      (and (string? content) (str/blank? content)) []
      :else [{:kind :text :text (str content)}])))

(defn- message-text [message]
  (str/join
    ""
    (map (fn [part]
           (let [kind (content-kind part)]
             (if (= kind :text)
               (or (:text part) (get part "text") (:content part) "")
               (throw
                 (ex-info "System and developer messages support text content only"
                          {:category :invalid-request
                           :role (:role message)
                           :content_kind kind})))))
         (message-content-parts message))))

(defn message-text-content [message]
  (let [content (:content message)]
    (if (string? content)
      content
      (str/join
        ""
        (map (fn [part]
               (if (= :text (content-kind part))
                 (or (:text part) (get part "text") (:content part) "")
                 ""))
             (message-content-parts message))))))

(defn response-text [response]
  (or (get-in response [:message :text])
      (when-let [message (:message response)]
        (message-text-content message))
      (:text response)
      ""))

(defn- local-file-url? [url]
  (and (string? url)
       (or (str/starts-with? url "/")
           (str/starts-with? url "./")
           (str/starts-with? url "~/"))))

(defn- expand-local-path [path]
  (if (str/starts-with? path "~/")
    (str (or (os/getenv "HOME") "") (subs path 1))
    path))

(defn- infer-media-type [location default-type]
  (let [value (str/lower-case (str (or location "")))]
    (cond
      (some? (re-find #"\\.png(?:[?#].*)?$" value)) "image/png"
      (some? (re-find #"\\.jpe?g(?:[?#].*)?$" value)) "image/jpeg"
      (some? (re-find #"\\.gif(?:[?#].*)?$" value)) "image/gif"
      (some? (re-find #"\\.webp(?:[?#].*)?$" value)) "image/webp"
      (some? (re-find #"\\.heic(?:[?#].*)?$" value)) "image/heic"
      (some? (re-find #"\\.heif(?:[?#].*)?$" value)) "image/heif"
      (some? (re-find #"\\.pdf(?:[?#].*)?$" value)) "application/pdf"
      (some? (re-find #"\\.wav(?:[?#].*)?$" value)) "audio/wav"
      (some? (re-find #"\\.mp3(?:[?#].*)?$" value)) "audio/mpeg"
      :else default-type)))

(defn- content-data [part data-key]
  (or (get part data-key)
      (get part (name data-key))
      part))

(defn- resolve-binary-content [part data-key default-type]
  (let [data-map (content-data part data-key)
        url (or (:url data-map) (get data-map "url"))
        data (or (:data data-map) (get data-map "data"))
        media-type (or (:media_type data-map) (get data-map "media_type")
                       (:media-type data-map) (get data-map "media-type"))]
    (when (= (some? url) (some? data))
      (throw (ex-info (str (name data-key) " content requires exactly one of url or data")
                      {:category :invalid-request :content_kind data-key})))
    (if (local-file-url? url)
      (let [path (expand-local-path url)]
        {:data (base64-encode (io/slurp path))
         :media_type (or media-type (infer-media-type path default-type))})
      (if (some? url)
        {:url url
         :media_type (or media-type (infer-media-type url default-type))}
        {:data (base64-encode data)
         :media_type (or media-type default-type)}))))

(defn- unsupported-content! [provider kind]
  (throw (ex-info (str provider " does not support " (name (or kind :unknown)) " content")
                  {:category :invalid-request
                   :provider provider
                   :content_kind kind})))

(defn- tool-result-data [part]
  (if (= (content-kind part) :tool_result)
    (content-data part :tool_result)
    part))

(defn- tool-call-data [part]
  (content-data part :tool_call))

(declare provider-tool-result-content tool-result-images)

(defn- openai-content-part [role part]
  (if (some? (:provider_data part))
    (:provider_data part)
    (if (some? (get part "type"))
    part
    (let [kind (content-kind part)]
      (case kind
        :text {:type (if (= role :assistant) "output_text" "input_text")
               :text (or (:text part) (:content part) "")}
        :image
        (let [image (resolve-binary-content part :image "image/png")
              image-data (content-data part :image)]
          (cond-> {:type "input_image"
                   :image_url (or (:url image)
                                  (str "data:" (:media_type image)
                                       ";base64," (:data image)))}
            (some? (or (:detail image-data) (get image-data "detail")))
            (assoc :detail (or (:detail image-data) (get image-data "detail")))))
        (:audio :document) (unsupported-content! "openai" kind)
        (unsupported-content! "openai" kind))))))

(defn- anthropic-content-part [part]
  (if (some? (:provider_data part))
    (:provider_data part)
    (if (some? (get part "type"))
    part
    (let [kind (content-kind part)
          thinking (:thinking part)]
      (case kind
        :thinking
        {:type "thinking"
         :thinking (or (:text thinking) (:text part) "")
         :signature (or (:signature thinking) (:signature part) "")}
        :redacted_thinking
        {:type "redacted_thinking"
         :data (or (:data thinking) (:data part) "")}
        :text {:type "text" :text (or (:text part) (:content part) "")}
        :image
        (let [image (resolve-binary-content part :image "image/png")]
          {:type "image"
           :source (if (:url image)
                     {:type "url" :url (:url image)}
                     {:type "base64" :media_type (:media_type image)
                      :data (:data image)})})
        :audio (unsupported-content! "anthropic" kind)
        :document
        (let [document (resolve-binary-content part :document "application/pdf")]
          {:type "document"
           :source (if (:url document)
                     {:type "url" :url (:url document)}
                     {:type "base64" :media_type (:media_type document)
                      :data (:data document)})})
        :tool_call
        (let [call (content-data part :tool_call)]
          {:type "tool_use"
           :id (or (:id call) (get call "id"))
           :name (or (:name call) (get call "name"))
           :input (or (:arguments call) (get call "arguments") {})})
        (unsupported-content! "anthropic" kind))))))

(defn- anthropic-message [message]
  (let [role (:role message)
        content (:content message)
        tool-calls (:tool_calls message)
        prior-parts (:parts message)]
    (cond
      (= role :tool)
      {:role "user"
       :content (mapv (fn [result]
                        (let [value (tool-result-data result)]
                          (let [text (provider-tool-result-content
                                       (or (:content value)
                                           (get value "content") ""))
                                images (tool-result-images value)]
                            {:type "tool_result"
                             :tool_use_id (or (:tool_call_id value)
                                              (get value "tool_call_id"))
                             :content (if (seq images)
                                        (into [{:type "text" :text text}]
                                              (map (fn [image]
                                                     {:type "image" :source {:type "base64"
                                                       :media_type (:media_type image) :data (:data image)}}) images))
                                        text)
                             :is_error (boolean (or (:is_error value)
                                                    (get value "is_error")))})))
                      content)}

      (= role :assistant)
      (let [source-parts (if (and (not (seq prior-parts))
                                  (not (vector? content))
                                  (str/blank? (str content)))
                           []
                           (message-content-parts message))
            embeds-tool-calls
            (some (fn [part]
                    (contains? #{:tool_call :tool_use} (content-kind part)))
                  source-parts)]
        {:role "assistant"
         :content (vec
                    (concat
                      (map anthropic-content-part source-parts)
                      (when-not embeds-tool-calls
                        (map (fn [call]
                               {:type "tool_use"
                                :id (:id call)
                                :name (:name call)
                                :input (:arguments call)})
                             (or tool-calls [])))))} )

      :else
      {:role "user"
       :content (mapv anthropic-content-part
                      (message-content-parts message))})))

(defn- merge-anthropic-messages [messages]
  (reduce
    (fn [merged message]
      (if (and (seq merged) (= (:role (last merged)) (:role message)))
        (conj (vec (butlast merged))
              (update (last merged) :content into (:content message)))
        (conj merged message)))
    []
    messages))

(defn- annotate-last-cacheable [blocks]
  (let [items (vec blocks)
        index (dec (count items))]
    (if (neg? index)
      items
      (assoc items index
             (assoc (get items index) :cache_control {:type "ephemeral"})))))

(defn- contains-cache-control? [value]
  (cond
    (map? value) (or (contains? value :cache_control)
                     (contains? value "cache_control")
                     (boolean (some contains-cache-control? (vals value))))
    (sequential? value) (boolean (some contains-cache-control? value))
    :else false))

(defn- cache-anthropic-prefix [messages]
  (let [items (vec messages)
        stable-index (- (count items) 2)]
    (if (neg? stable-index)
      items
      (update-in items [stable-index :content] annotate-last-cacheable))))

(defn- json-safe [value]
  (cond
    (map? value)
    (into {} (map (fn [[k v]]
                    [(keyword (if (keyword? k) (name k) (str k)))
                     (json-safe v)])
                  value))
    (vector? value) (mapv json-safe value)
    (seq? value) (mapv json-safe value)
    :else value))

(defn- provider-tool-result-content [content]
  (if (string? content)
    content
    (json/write-json (json-safe content))))

(defn- invalid-tool-image! [reason]
  (throw (ex-info "Invalid tool result image"
                  {:category :invalid-request :reason reason})))

(defn- image-field-present? [result field]
  (or (contains? result field) (contains? result (name field))))

(defn- image-field [result field]
  (let [left (get result field) right (get result (name field))
        nullable? (contains? #{:image_data :image_media_type} field)]
    ;; Legacy ToolResultData optionals accept None. A default-filled nil alias
    ;; must neither mask meaningful data nor conflict with the other alias.
    (when (and (contains? result field) (contains? result (name field))
               (or (not nullable?) (and (some? left) (some? right)))
               (not= left right))
      (invalid-tool-image! :conflicting-aliases))
    (if nullable? (if (some? left) left right)
      (if (contains? result field) left right))))

(defn- normalize-tool-image [result]
  (when-not (map? result) (invalid-tool-image! :invalid-image-map))
  (when (image-field-present? result :images) (invalid-tool-image! :nested-images))
  (let [encoded? (image-field-present? result :image_base64)
        raw? (some? (image-field result :image_data))
        encoded (image-field result :image_base64)
        raw (image-field result :image_data)
        supplied-media (image-field result :image_media_type)
        media (if (nil? supplied-media) "image/png" supplied-media)]
    (when (= encoded? raw?) (invalid-tool-image! :ambiguous-image-source))
    (when-not (and (string? media) (not (str/blank? media)))
      (invalid-tool-image! :invalid-media-type))
    {:media_type media
     :data (if encoded?
             (do
               (when-not (and (string? encoded) (not (empty? encoded)))
                 (invalid-tool-image! :invalid-base64))
               (try (when-not (= encoded (base64-encode (base64-decode encoded)))
                      (invalid-tool-image! :invalid-base64))
                    (catch Object _ (invalid-tool-image! :invalid-base64)))
               encoded)
             (try
               (when (nil? raw) (invalid-tool-image! :invalid-raw-image))
               (base64-encode raw)
               (catch Object _ (invalid-tool-image! :invalid-raw-image))))}))

(defn tool-result-images
  "Accepts a tool-result map; validates attachment fields independently of text. Returns
   ordered {:data base64-string :media_type string} maps, or [] for plain output."
  [result]
  (let [plural? (image-field-present? result :images)
        singular? (or (some? (image-field result :image_data))
                      (image-field-present? result :image_base64))]
    (when (and plural? singular?) (invalid-tool-image! :mixed-image-sources))
    (cond
      plural? (let [images (image-field result :images)]
                (when-not (and (vector? images) (seq images))
                  (invalid-tool-image! :invalid-images))
                (mapv normalize-tool-image images))
      singular? [(normalize-tool-image result)]
      :else [])))

(defn- canonical-option-map [options]
  (into {}
        (map (fn [[key value]]
               [(if (string? key) (keyword key) key) value])
             (or options {}))))

(defn- provider-options [request provider]
  (let [options (or (:provider_options request) {})]
    (canonical-option-map
      (or (get options (keyword provider))
          (get options provider)
          {}))))

(defn- merge-gemini-provider-options [payload options]
  (let [generation-options (:generationConfig options)
        body-options (dissoc options :generationConfig)
        merged (merge payload body-options)]
    (if (map? generation-options)
      (assoc merged :generationConfig
             (merge (or (:generationConfig payload) {})
                    (canonical-option-map generation-options)))
      (if (some? generation-options)
        (assoc merged :generationConfig generation-options)
        merged))))

(defn- field [m k]
  (cond
    (and (map? m) (contains? m k)) (get m k)
    (and (map? m) (contains? m (name k))) (get m (name k))
    :else nil))

(defn- portable-reasoning-effort [request]
  (when (some? (:reasoning_effort request))
    (let [value (:reasoning_effort request)
          normalized (str/lower-case
                       (if (keyword? value) (name value) (str value)))]
      (when-not (contains? #{"low" "medium" "high"} normalized)
        (throw
          (ex-info (str "Invalid reasoning_effort: " value)
                   {:category :invalid-reasoning-effort
                    :reasoning_effort value
                    :valid_values ["low" "medium" "high"]})))
      normalized)))

(defn- portable-warning [provider parameter]
  {:message (str provider " does not support the portable " parameter
                 " request parameter; it was omitted")
   :code "unsupported_parameter"
   :parameter parameter})

(defn- metadata-has-non-user-id? [metadata]
  (some (fn [[key _]]
          (not= "user_id" (if (keyword? key) (name key) (str key))))
        metadata))

(defn- adapter-warnings [provider request]
  (let [metadata (:metadata request)]
    (cond-> []
      (and (= provider "openai") (seq (:stop_sequences request)))
      (conj (portable-warning provider "stop_sequences"))

      (and (= provider "anthropic") (map? metadata)
           (metadata-has-non-user-id? metadata))
      (conj (portable-warning provider "metadata keys other than user_id"))

      (and (= provider "gemini") (seq metadata))
      (conj (portable-warning provider "metadata"))

      (and (= provider "openai-compatible") (seq metadata))
      (conj (portable-warning provider "metadata")))))

(defn- anthropic-metadata [request]
  (when-let [user-id (field (:metadata request) :user_id)]
    {:user_id user-id}))

(defn make-tool [tool-name description parameters & [execute]]
  (when (or (not (string? tool-name))
            (> (count tool-name) 64)
            (nil? (re-matches #"[A-Za-z][A-Za-z0-9_]*" tool-name)))
    (throw (ex-info
             "Tool name must start with a letter, contain only letters, numbers, or underscores, and be at most 64 characters"
             {:category :invalid-tool-definition :tool_name tool-name})))
  (when (or (not (map? parameters))
            (not= "object" (field parameters :type)))
    (throw (ex-info "Tool parameter schema root must have type object"
                    {:category :invalid-tool-definition
                     :tool_name tool-name})))
  (cond-> {:name tool-name
           :description (or description "")
           :parameters parameters}
    (some? execute) (assoc :execute execute)))

(defn- tool-choice-mode [request]
  (when-let [mode (field (:tool_choice request) :mode)]
    (let [normalized (str/lower-case (name mode))
          tool-name (field (:tool_choice request) :tool_name)]
      (when (and (= "named" normalized)
                 (or (not (string? tool-name)) (str/blank? tool-name)))
        (throw (ex-info "Named tool choice requires a nonempty string tool_name"
                        {:category :invalid-request :retryable false
                         :tool_choice normalized})))
      normalized)))

(defn- tool-choice-name [request]
  (field (:tool_choice request) :tool_name))

(defn- openai-tool-choice [request]
  (case (tool-choice-mode request)
    "auto" "auto"
    "none" "none"
    "required" "required"
    "named" {:type "function"
             :function {:name (tool-choice-name request)}}
    nil))

(defn- anthropic-tool-choice [request]
  (case (tool-choice-mode request)
    "auto" {:type "auto"}
    "required" {:type "any"}
    "named" {:type "tool" :name (tool-choice-name request)}
    nil))

(defn- gemini-tool-choice [request]
  (case (tool-choice-mode request)
    "auto" {:functionCallingConfig {:mode "AUTO"}}
    "none" {:functionCallingConfig {:mode "NONE"}}
    "required" {:functionCallingConfig {:mode "ANY"}}
    "named" {:functionCallingConfig
             {:mode "ANY"
              :allowedFunctionNames [(tool-choice-name request)]}}
    nil))

(defn- structured-schema [request]
  (let [format (:response_format request)]
    (when (= (field format :type) "json_schema")
      (field format :json_schema))))

(defn- openai-format [request]
  (let [format (:response_format request)
        format-type (field format :type)]
    (case format-type
      "json_schema"
      {:text {:format {:type "json_schema"
                       :name (or (field format :name) "response")
                       :schema (field format :json_schema)
                       :strict (boolean (field format :strict))}}}
      "json" {:text {:format {:type "json_object"}}}
      {})))

(defn- schema-instruction [request]
  (when-let [schema (structured-schema request)]
    (str "Return only valid JSON matching this JSON Schema: "
         (json/write-json (json-safe schema)))))

(defn- gemini-generation-config [request]
  (let [format (:response_format request)
        format-type (field format :type)
        effort (portable-reasoning-effort request)]
    (cond-> {}
      (some? (:temperature request))
      (assoc :temperature (:temperature request))
      (some? (:top_p request))
      (assoc :topP (:top_p request))
      (some? (:max_tokens request))
      (assoc :maxOutputTokens (:max_tokens request))
      (some? (:stop_sequences request))
      (assoc :stopSequences (:stop_sequences request))
      (some? effort)
      (assoc :thinkingConfig {:thinkingLevel effort})
      (or (= format-type "json") (= format-type "json_schema"))
      (assoc :responseMimeType "application/json")
      (= format-type "json_schema")
      (assoc :responseSchema (field format :json_schema)))))

(defn- openai-input-items [messages]
  (vec
    (mapcat
      (fn [message]
        (let [role (:role message)
              content (:content message)]
          (cond
            (or (= role :system) (= role :developer)) []

            (= role :tool)
            (map (fn [result]
                   (let [value (tool-result-data result)]
                     (let [text (provider-tool-result-content
                                  (or (:content value)
                                      (get value "content") ""))
                           images (tool-result-images value)]
                       {:type "function_call_output"
                        :call_id (or (:tool_call_id value)
                                     (get value "tool_call_id"))
                        :output (if (seq images)
                                  (into [{:type "input_text" :text text}]
                                        (map (fn [image]
                                               {:type "input_image" :image_url
                                                (str "data:" (:media_type image)
                                                     ";base64," (:data image))}) images))
                                  text)})))
                 content)

            (= role :assistant)
            (let [source-parts (message-content-parts message)
                  embedded-calls (map tool-call-data
                                      (filter (fn [part]
                                                (= :tool_call (content-kind part)))
                                              source-parts))
                  call-item
                  (fn [call]
                    {:type "function_call"
                     :call_id (or (:id call) (get call "id"))
                     :name (or (:name call) (get call "name"))
                     :arguments (json/write-json
                                  (json-safe
                                    (or (:arguments call)
                                        (get call "arguments") {})))})
                  ordered-items
                  (reduce
                    (fn [items part]
                      (cond
                        (= :tool_call (content-kind part))
                        (conj items (call-item (tool-call-data part)))

                        (= :input_item (:provider_location part))
                        (conj items (:provider_data part))

                        :else
                        (let [content-part (openai-content-part role part)]
                          (if (and (seq items)
                                   (= "message" (:type (last items))))
                            (conj (vec (butlast items))
                                  (update (last items) :content conj content-part))
                            (conj items {:type "message" :role "assistant"
                                         :content [content-part]})))))
                    []
                    source-parts)]
              (if (seq embedded-calls)
                ordered-items
                (into ordered-items
                      (map call-item (or (:tool_calls message) [])))))

            :else
            [{:type "message" :role "user"
              :content (mapv (fn [part] (openai-content-part role part))
                             (message-content-parts message))}])))
      messages)))

(defn- openai-output-text [output]
  (str/join ""
            (mapcat
              (fn [item]
                (map (fn [part]
                       (if (= (get part "type") "output_text")
                         (or (get part "text") "")
                         ""))
                     (or (get item "content") [])))
              (filter (fn [item] (= (get item "type") "message"))
                      (or output [])))))

(defn- normalize-openai-parts [output]
  (vec
    (mapcat
      (fn [item]
        (case (get item "type")
          "message"
          (mapcat
            (fn [part]
              (case (get part "type")
                "output_text" [{:kind :text :text (or (get part "text") "")}]
                "output_image"
                [{:kind :image
                  :image {:url (or (get part "image_url") (get part "url"))}}]
                [{:kind (keyword (or (get part "type") "provider_content"))
                  :provider_data part
                  :provider_location :content}]))
            (or (get item "content") []))
          "function_call"
          (map (fn [call] {:kind :tool_call :tool_call call})
               (normalize-openai-tool-calls [item]))
          [{:kind (keyword (or (get item "type") "provider_content"))
            :provider_data item
            :provider_location :input_item}]))
      (or output []))))

(defn- openai-compatible-content-part [part]
  (if (some? (:provider_data part))
    (:provider_data part)
    (let [kind (content-kind part)]
      (case kind
        :text {:type "text" :text (or (:text part) (:content part) "")}
        :image
        (let [image (resolve-binary-content part :image "image/png")
              image-data (content-data part :image)]
          {:type "image_url"
           :image_url
           (cond-> {:url (or (:url image)
                             (str "data:" (:media_type image)
                                  ";base64," (:data image)))}
             (some? (or (:detail image-data) (get image-data "detail")))
             (assoc :detail (or (:detail image-data)
                                (get image-data "detail"))))})
        (:audio :document)
        (unsupported-content! "openai-compatible" kind)
        (unsupported-content! "openai-compatible" kind)))))

(defn- normalize-openai-compatible-content [content]
  (if (string? content)
    (if (str/blank? content) [] [{:kind :text :text content}])
    (mapv
      (fn [part]
        (case (get part "type")
          "text" {:kind :text :text (or (get part "text") "")}
          "image_url"
          {:kind :image
           :image {:url (get-in part ["image_url" "url"])
                   :detail (get-in part ["image_url" "detail"])}}
          {:kind (keyword (or (get part "type") "provider_content"))
           :provider_data part}))
      (or content []))))

(defn- openai-compatible-messages [messages]
  (vec
    (mapcat
      (fn [message]
        (let [role (:role message)
              content (:content message)]
          (if (= role :tool)
            (map (fn [result]
                   (let [value (tool-result-data result)]
                     {:role "tool"
                      :tool_call_id (or (:tool_call_id value)
                                        (get value "tool_call_id"))
                      :content (provider-tool-result-content
                                 (or (:content value)
                                     (get value "content") ""))}))
                 content)
            (let [source-parts (message-content-parts message)
                  ordinary-parts (filter (fn [part]
                                           (not= :tool_call (content-kind part)))
                                         source-parts)
                  embedded-calls (map tool-call-data
                                      (filter (fn [part]
                                                (= :tool_call (content-kind part)))
                                              source-parts))
                  calls (if (seq embedded-calls)
                          embedded-calls
                          (or (:tool_calls message) []))]
              [(cond-> {:role (name role)
                        :content (if (or (= role :system) (= role :developer))
                                   (message-text message)
                                   (mapv openai-compatible-content-part
                                         ordinary-parts))}
               (seq calls)
               (assoc :tool_calls
                      (mapv (fn [call]
                              {:id (or (:id call) (get call "id"))
                               :type "function"
                               :function
                               {:name (or (:name call) (get call "name"))
                                :arguments
                                (json/write-json
                                  (json-safe
                                    (or (:arguments call)
                                        (get call "arguments") {})))}})
                            calls)))]))))
      messages)))

(defn- openai-compatible-request-data [request api-key base-url]
  (let [provider (or (:provider request) "openai-compatible")
        key (if (contains? request :api_key)
              (:api_key request)
              (resolve-api-key provider api-key))
        ;; An injected transport never reaches the network, so the base URL is
        ;; only mandatory when the real HTTP transport would be used.
        url (if (and (fn? (:transport request))
                     (str/blank? (or base-url (:base_url request)))
                     (str/blank? (os/getenv "OPENAI_COMPAT_BASE_URL")))
              "http://openai-compat.invalid/v1/chat/completions"
              (resolve-openai-compatible-url (or base-url (:base_url request)) provider))
        tools (mapv (fn [tool]
                      {:type "function"
                       :function {:name (:name tool)
                                  :description (:description tool)
                                  :parameters (:parameters tool)}})
                    (or (:tools request) []))
        payload (merge
                  (cond-> {:model (:model request)
                           :messages
                           (openai-compatible-messages (:messages request))}
                    (seq tools) (assoc :tools tools)
                    (some? (:temperature request))
                    (assoc :temperature (:temperature request))
                    (some? (:top_p request))
                    (assoc :top_p (:top_p request))
                    (some? (:max_tokens request))
                    (assoc :max_tokens (:max_tokens request))
                    (some? (:stop_sequences request))
                    (assoc :stop (:stop_sequences request)))
                  (provider-options request provider))
        headers (request-headers request key :openai-chat-completions {"Content-Type" "application/json"})]
    (require-api-key! provider key :openai-chat-completions)
    {:provider provider :url url :headers headers :payload payload}))

(defn- openai-compatible-usage [usage]
  {:input_tokens (or (get usage "prompt_tokens") 0)
   :output_tokens (or (get usage "completion_tokens") 0)
   :total_tokens (or (get usage "total_tokens") 0)})

(defn openai-compatible-complete [request & [api-key base-url]]
  (let [{:keys [provider url headers payload]}
        (openai-compatible-request-data request api-key base-url)
        transport (or (:transport request) http/request)
        resp (invoke-transport transport
               (transport-request-options
                 request
                 {:method :post :url url :headers headers
                  :body (json/write-json payload)}))
        status (:status resp)
        body-str (str (:body resp))]
    (if (and (number? status) (not= status 200))
      (raise-provider-error! provider resp)
      (let [body (parse-response-body provider body-str)
            choice (first (get body "choices"))
            message (or (get choice "message") {})
            text (if (string? (get message "content"))
                   (or (get message "content") "")
                   (str/join ""
                             (map (fn [part]
                                    (if (= (get part "type") "text")
                                      (or (get part "text") "") ""))
                                  (or (get message "content") []))))
            text-parts (normalize-openai-compatible-content (get message "content"))
            tool-calls (normalize-openai-tool-calls (get message "tool_calls"))
            parts (vec (concat text-parts
                               (map (fn [call]
                                      {:kind :tool_call :tool_call call})
                                    tool-calls)))
            usage (or (get body "usage") {})]
        {:id (get body "id")
         :model (or (get body "model") (:model request))
         :provider provider
         :message {:role :assistant :content parts :parts parts :text text}
         :tool_calls tool-calls
         :reasoning (when (string? (get message "reasoning_content"))
                      (get message "reasoning_content"))
         :usage (openai-compatible-usage usage)
         :finish_reason (finish-reason (get choice "finish_reason"))
         :warnings (adapter-warnings "openai-compatible" request)
         :raw body}))))

(defn- openai-request-data [request api-key base-url]
  (let [key (request-api-key request api-key "OPENAI_API_KEY")
        effort (portable-reasoning-effort request)
        url (resolve-openai-url (or base-url (:base_url request)))
        messages (or (:messages request) [])
        instructions (str/join "\n\n"
                               (map message-text
                                    (filter (fn [m]
                                              (or (= (:role m) :system)
                                                  (= (:role m) :developer)))
                                            messages)))
        ;; strict is the tool definition's own flag (default false): OpenAI's
        ;; strict mode rejects schemas whose optional properties are not all
        ;; listed as required, which is how profile tools are declared.
        openai-tools (mapv (fn [tool]
                             {:type "function"
                              :name (:name tool)
                              :description (:description tool)
                              :parameters (:parameters tool)
                              :strict (boolean (:strict tool))})
                           (or (:tools request) []))
        tool-choice (openai-tool-choice request)
        payload (merge
                  (cond-> {:model (:model request)
                           :input (openai-input-items messages)
                           :store false}
                    (not (str/blank? instructions)) (assoc :instructions instructions)
                    (seq openai-tools) (assoc :tools openai-tools)
                    (some? tool-choice) (assoc :tool_choice tool-choice)
                    (some? (:temperature request))
                    (assoc :temperature (:temperature request))
                    (some? (:top_p request))
                    (assoc :top_p (:top_p request))
                    (some? (:max_tokens request))
                    (assoc :max_output_tokens (:max_tokens request))
                    (some? (:metadata request))
                    (assoc :metadata (:metadata request))
                    (some? effort)
                    (assoc :reasoning {:effort effort}))
                  (openai-format request)
                  (provider-options request "openai"))
        headers (request-headers request key :openai-responses {"Content-Type" "application/json"})]
    (require-api-key! (or (:provider request) "openai") key :openai-responses)
    {:url url :headers headers :payload payload}))

(defn- normalize-openai-response [request body]
  (let [output (or (get body "output") [])
        call-items (filter (fn [item] (= (get item "type") "function_call"))
                           output)
        tool-calls (normalize-openai-tool-calls call-items)
        usage (or (get body "usage") {})
        input-details (or (get usage "input_tokens_details") {})
        output-details (or (get usage "output_tokens_details") {})
        parts (normalize-openai-parts output)]
    {:id (get body "id")
     :model (or (get body "model") (:model request))
     :provider "openai"
     :message {:role :assistant :content parts :parts parts
               :text (openai-output-text output)}
     :tool_calls tool-calls
     :usage {:input_tokens (or (get usage "input_tokens") 0)
             :output_tokens (or (get usage "output_tokens") 0)
             :reasoning_tokens (or (get output-details "reasoning_tokens") 0)
             :cache_read_tokens (or (get input-details "cached_tokens") 0)
             :total_tokens (or (get usage "total_tokens") 0)}
     :finish_reason (if (seq tool-calls)
                      :tool_calls
                      (if (= (get body "status") "completed") :stop :length))
     :warnings (adapter-warnings "openai" request)
     :raw body}))

(defn openai-complete [request & [api-key base-url]]
  (let [{:keys [url headers payload]} (openai-request-data request api-key base-url)
        transport (or (:transport request) http/request)
        resp (invoke-transport transport
               (transport-request-options
                 request
                 {:method :post :url url :headers headers
                  :body (json/write-json (json-safe payload))}))
        status (:status resp)
        body-str (str (:body resp))]
    (if (and (number? status) (not= status 200))
      (raise-provider-error! "openai" resp)
      (normalize-openai-response request (parse-response-body "openai" body-str)))))

;; Anthropic Adapter
(defn- anthropic-request-data [request api-key base-url]
  (let [key (request-api-key request api-key "ANTHROPIC_API_KEY")
        model-info (models/get-model-info (:model request))
        adaptive? (= :adaptive (:reasoning_mode model-info))
        effort (portable-reasoning-effort request)
        url (resolve-anthropic-url (or base-url (:base_url request)))
        system-messages (filter (fn [m]
                                  (or (= (:role m) :system)
                                      (= (:role m) :developer)))
                                (:messages request))
        schema-prompt (schema-instruction request)
        system-text (str/join "\n\n"
                              (filter (fn [text] (not (str/blank? (str text))))
                                      (concat (map message-text system-messages)
                                              [schema-prompt])))
        non-system (remove (fn [m]
                             (or (= (:role m) :system)
                                 (= (:role m) :developer)))
                           (:messages request))
        raw-msgs (merge-anthropic-messages (map anthropic-message non-system))
        raw-tools (if (= "none" (tool-choice-mode request))
                    []
                    (mapv (fn [tool]
                          {:name (:name tool)
                           :description (:description tool)
                           :input_schema (:parameters tool)})
                          (or (:tools request) [])))
        tool-choice (anthropic-tool-choice request)
        options (provider-options request "anthropic")
        beta-headers (or (:beta_headers options) (get options "beta_headers") [])
        auto-cache-setting (if (contains? options :auto_cache)
                             (:auto_cache options)
                             (if (contains? options "auto_cache")
                               (get options "auto_cache")
                               true))
        auto-cache? (not (= false auto-cache-setting))
        body-options (dissoc
                       (dissoc
                         (dissoc
                           (dissoc options :beta_headers)
                           "beta_headers")
                         :auto_cache)
                       "auto_cache")
        explicit-thinking (field body-options :thinking)
        thinking-budget (case effort
                          "low" 1024
                          "medium" 2048
                          "high" 3072
                          nil)
        max-tokens (or (:max_tokens request) 4096)
        portable-thinking
        (when (and (some? thinking-budget) (nil? explicit-thinking))
          (if adaptive? {:type "adaptive"}
              {:type "enabled" :budget_tokens thinking-budget}))
        effective-thinking (or explicit-thinking portable-thinking)
        explicit-cache? (contains-cache-control? body-options)
        effective-beta-headers
        (vec (distinct
               (concat beta-headers
                       (when (some? effective-thinking)
                         ["interleaved-thinking-2025-05-14"])
                       (when (or auto-cache? explicit-cache?)
                         ["prompt-caching-2024-07-31"]))))
        msgs (if auto-cache? (cache-anthropic-prefix raw-msgs) raw-msgs)
        anthropic-tools (if (and auto-cache? (seq raw-tools))
                          (annotate-last-cacheable raw-tools)
                          raw-tools)
        system-value (if auto-cache?
                       [{:type "text" :text system-text
                         :cache_control {:type "ephemeral"}}]
                       system-text)
        payload (merge
                  (cond-> {:model (:model request)
                           :messages msgs
                           :max_tokens max-tokens}
                    (not (str/blank? system-text)) (assoc :system system-value)
                    (seq anthropic-tools) (assoc :tools anthropic-tools)
                    (some? tool-choice) (assoc :tool_choice tool-choice)
                    (some? (:temperature request))
                    (assoc :temperature (:temperature request))
                    (some? (:top_p request))
                    (assoc :top_p (:top_p request))
                    (some? (:stop_sequences request))
                    (assoc :stop_sequences (:stop_sequences request))
                    (some? portable-thinking)
                    (assoc :thinking portable-thinking)
                    (some? (anthropic-metadata request))
                    (assoc :metadata (anthropic-metadata request)))
                  body-options)
        output-config (field payload :output_config)
        payload (if (and adaptive? effort (nil? (field output-config :effort)))
                  (assoc (dissoc payload "output_config") :output_config
                         (assoc (or output-config {}) :effort effort))
                  payload)
        _tool-choice-check
        (when (and (= false (:forced_tool_choice model-info))
                   (contains? #{"any" "tool"} (field (field payload :tool_choice) :type)))
          (throw (ex-info "This model does not support forced tool choice"
                          {:category :unsupported-tool-choice :retryable false
                           :provider (or (:provider request) "anthropic")
                           :model (:model request)})))
        final-thinking (field payload :thinking)
        final-thinking-type (field final-thinking :type)
        _thinking-mode-check
        (when (and (:adaptive_only model-info) (some? final-thinking)
                   (not= "adaptive" final-thinking-type))
          (throw (ex-info "This model requires adaptive thinking"
                          {:category :invalid-request :retryable false
                           :provider (or (:provider request) "anthropic")
                           :model (:model request)})))
        final-thinking-budget (field final-thinking :budget_tokens)
        final-max-tokens (field payload :max_tokens)
        _thinking-budget-check
        (when (and (= "enabled" final-thinking-type)
                   (number? final-thinking-budget)
                   (or (not (number? final-max-tokens))
                       (<= final-thinking-budget 0)
                       (>= final-thinking-budget final-max-tokens)))
          (throw
            (ex-info
              (str "Anthropic max_tokens must exceed the positive reasoning budget of "
                   final-thinking-budget)
              {:category :invalid-request
               :max_tokens final-max-tokens
               :reasoning_budget final-thinking-budget})))
        headers (request-headers request key :anthropic-messages
                                 (cond-> {"anthropic-version" "2023-06-01"
                                          "Content-Type" "application/json"}
                                   (seq effective-beta-headers)
                                   (assoc "anthropic-beta" (str/join "," effective-beta-headers))))]
    (require-api-key! (or (:provider request) "anthropic") key :anthropic-messages)
    {:url url :headers headers :payload payload}))

(defn- anthropic-usage [usage]
  (let [input (or (get usage "input_tokens") 0)
        output (or (get usage "output_tokens") 0)]
    {:input_tokens input
     :output_tokens output
     :cache_read_tokens (or (get usage "cache_read_input_tokens") 0)
     :cache_write_tokens (or (get usage "cache_creation_input_tokens") 0)
     :total_tokens (+ input output)}))

(defn- normalize-anthropic-part [block]
  (case (get block "type")
    "text" {:kind :text :text (or (get block "text") "")}
    "image"
    (let [source (or (get block "source") {})]
      {:kind :image
       :image (if (= (get source "type") "url")
                {:url (get source "url")
                 :media_type (get source "media_type")}
                {:data (base64-decode (or (get source "data") ""))
                 :media_type (get source "media_type")})})
    "document"
    (let [source (or (get block "source") {})]
      {:kind :document
       :document (if (= (get source "type") "url")
                   {:url (get source "url")
                    :media_type (get source "media_type")}
                   {:data (base64-decode (or (get source "data") ""))
                    :media_type (get source "media_type")})})
    "tool_use"
    {:kind :tool_call
     :tool_call {:id (or (get block "id") "")
                 :name (or (get block "name") "")
                 :arguments (or (get block "input") {})}}
    "thinking"
    {:kind :thinking
     :thinking {:text (or (get block "thinking") "")
                :signature (get block "signature")
                :redacted false}}
    "redacted_thinking"
    {:kind :redacted_thinking
     :thinking {:data (get block "data") :redacted true}}
    {:kind (keyword (or (get block "type") "provider_content"))
     :provider_data block}))

(defn- normalize-anthropic-response [request body-map]
  (let [content-blocks (or (get body-map "content") [])
        text (str/join ""
                       (map (fn [block]
                              (if (= (get block "type") "text")
                                (or (get block "text") "")
                                ""))
                            content-blocks))
        reasoning (str/join ""
                            (map (fn [block]
                                   (if (= (get block "type") "thinking")
                                     (or (get block "thinking") "")
                                     ""))
                                 content-blocks))
        tool-calls (normalize-anthropic-tool-calls content-blocks)
        base-usage (anthropic-usage (or (get body-map "usage") {}))
        usage (assoc base-usage :reasoning_tokens
                     (if (str/blank? reasoning)
                       0
                       (quot (+ (count reasoning) 3) 4)))
        parts (mapv normalize-anthropic-part content-blocks)]
    {:id (get body-map "id")
     :model (or (get body-map "model") (:model request))
     :provider "anthropic"
     :message {:role :assistant :content parts :parts parts :text text}
     :reasoning reasoning
     :tool_calls tool-calls
     :usage usage
     :finish_reason (if (seq tool-calls)
                      :tool_calls
                      (finish-reason (get body-map "stop_reason")))
     :warnings (adapter-warnings "anthropic" request)
     :raw body-map}))

(defn anthropic-complete [request & [api-key base-url]]
  (let [{:keys [url headers payload]}
        (anthropic-request-data request api-key base-url)]
    (try
        (let [transport (or (:transport request) http/request)
              resp (invoke-transport transport
                     (transport-request-options
                       request
                       {:method :post
                        :url url
                        :headers headers
                        :body (json/write-json (json-safe payload))}))
              status (:status resp)
              body-str (str (:body resp))]
          (if (and (number? status) (not= status 200))
            (raise-provider-error! "anthropic" resp)
            (normalize-anthropic-response request (parse-response-body "anthropic" body-str))))
        (catch Object e (throw e)))))

;; Gemini native generateContent adapter.
(defn- gemini-content-part [part]
  (if (some? (:provider_data part))
    (:provider_data part)
    (if (or (some? (get part "text"))
          (some? (get part "inlineData"))
          (some? (get part "fileData"))
          (some? (get part "functionCall"))
          (some? (get part "functionResponse")))
      part
      (let [kind (content-kind part)]
      (case kind
        :text {:text (or (:text part) (:content part) "")}
        (:image :audio :document)
        (let [binary (resolve-binary-content
                       part kind
                       (case kind
                         :image "image/png"
                         :audio "audio/wav"
                         "application/pdf"))]
          (if (:url binary)
            {:fileData {:mimeType (:media_type binary)
                        :fileUri (:url binary)}}
            {:inlineData {:mimeType (:media_type binary)
                          :data (:data binary)}}))
        :tool_call
        (let [call (content-data part :tool_call)]
          {:functionCall
           {:name (or (:name call) (get call "name"))
            :args (or (:arguments call) (get call "arguments") {})}})
        :thinking
        (let [thinking (content-data part :thinking)]
          {:text (or (:text thinking) (get thinking "text") "")
           :thought true})
        (unsupported-content! "gemini" kind))))))

(defn- gemini-message [message call-names]
  (let [role (:role message)
        content (:content message)
        tool-calls (:tool_calls message)]
    (cond
      (= role :tool)
      {:role "user"
       :parts (vec
                (mapcat
                  (fn [result]
                    (let [value (tool-result-data result)
                          images (tool-result-images value)
                          result-content (or (:content value)
                                             (get value "content"))
                          is-error (or (:is_error value)
                                       (get value "is_error"))]
                      (concat
                        [{:functionResponse
                          {:name (or (:tool_name value)
                                     (get value "tool_name")
                                     (when call-names
                                       (get @call-names
                                            (or (:tool_call_id value)
                                                (get value "tool_call_id"))))
                                     "")
                           :response (if is-error
                                       {:error result-content}
                                       (if (map? result-content)
                                         result-content
                                         {:result result-content}))}}]
                        (map (fn [image]
                               {:inlineData {:mimeType (:media_type image)
                                             :data (:data image)}}) images))))
                  content))}

      (= role :assistant)
      (let [source-parts (if (and (not (seq (:parts message)))
                                  (not (vector? content))
                                  (str/blank? (str content)))
                           []
                           (message-content-parts message))
            embeds-tool-calls
            (some (fn [part]
                    (or (= :tool_call (content-kind part))
                        (some? (get part "functionCall"))))
                  source-parts)]
        {:role "model"
         :parts (vec
                  (concat
                    (map gemini-content-part source-parts)
                    (when-not embeds-tool-calls
                      (map (fn [call]
                             {:functionCall {:name (:name call)
                                             :args (:arguments call)}})
                           (or tool-calls [])))))} )

      :else {:role "user"
             :parts (mapv gemini-content-part
                          (message-content-parts message))})))

(defn normalize-gemini-tool-calls [parts]
  (mapv (fn [part]
          (let [call (get part "functionCall")]
            {:id (or (get call "id") (str "call_" (ids/uuid-text)))
             :name (or (get call "name") "")
             :arguments (or (get call "args") {})}))
        (filter (fn [part] (some? (get part "functionCall"))) (or parts []))))

(defn- gemini-request-data [request api-key base-url]
  (let [key (request-api-key request api-key "GEMINI_API_KEY")
        url (resolve-gemini-url (or base-url (:base_url request)) (:model request))
        system-messages (filter (fn [m]
                                  (or (= (:role m) :system)
                                      (= (:role m) :developer)))
                                (:messages request))
        system-text (str/join "\n\n" (map message-text system-messages))
        call-names (:gemini_call_names request)
        contents (mapv (fn [message] (gemini-message message call-names))
                       (remove (fn [m]
                                 (or (= (:role m) :system)
                                     (= (:role m) :developer)))
                               (:messages request)))
        tools (or (:tools request) [])
        generation-config (gemini-generation-config request)
        tool-choice (gemini-tool-choice request)
        payload
        (merge-gemini-provider-options
          (cond-> {:contents contents}
            (not (str/blank? system-text))
            (assoc :systemInstruction {:parts [{:text system-text}]})
            (seq tools) (assoc :tools
                               [{:functionDeclarations
                                 (mapv (fn [tool]
                                         {:name (:name tool)
                                          :description (:description tool)
                                          :parameters (:parameters tool)})
                                       tools)}])
            (some? tool-choice) (assoc :toolConfig tool-choice)
            (seq generation-config) (assoc :generationConfig generation-config))
          (provider-options request "gemini"))
        headers (request-headers request key :gemini-generate-content {"Content-Type" "application/json"})]
    (require-api-key! (or (:provider request) "gemini") key :gemini-generate-content)
    {:url url :headers headers :payload payload}))

(defn- gemini-usage [usage]
  {:input_tokens (or (get usage "promptTokenCount") 0)
   :output_tokens (or (get usage "candidatesTokenCount") 0)
   :reasoning_tokens (or (get usage "thoughtsTokenCount") 0)
   :cache_read_tokens (or (get usage "cachedContentTokenCount") 0)
   :total_tokens (or (get usage "totalTokenCount") 0)})

(defn- content-kind-for-media-type [media-type]
  (let [mime (str/lower-case (str (or media-type "")))]
    (cond
      (str/starts-with? mime "image/") :image
      (str/starts-with? mime "audio/") :audio
      :else :document)))

(defn- normalize-gemini-parts [native-parts]
  (reduce
    (fn [[parts calls] part]
      (cond
        (some? (get part "functionCall"))
        (let [native (get part "functionCall")
              call {:id (or (get native "id") (str "call_" (ids/uuid-text)))
                    :name (or (get native "name") "")
                    :arguments (or (get native "args") {})}]
          [(conj parts {:kind :tool_call :tool_call call})
           (conj calls call)])

        (some? (get part "text"))
        (if (get part "thought")
          [(conj parts {:kind :thinking
                        :thinking {:text (or (get part "text") "")
                                   :redacted false}})
           calls]
          [(conj parts {:kind :text :text (or (get part "text") "")}) calls])

        (some? (get part "inlineData"))
        (let [inline (get part "inlineData")
              mime (get inline "mimeType")
              kind (content-kind-for-media-type mime)]
          [(conj parts {:kind kind
                        kind {:data (base64-decode (or (get inline "data") ""))
                              :media_type mime}})
           calls])

        (some? (get part "fileData"))
        (let [file (get part "fileData")
              mime (get file "mimeType")
              kind (content-kind-for-media-type mime)]
          [(conj parts {:kind kind
                        kind {:url (get file "fileUri") :media_type mime}})
           calls])

        :else
        [(conj parts {:kind :provider_content :provider_data part}) calls]))
    [[] []]
    (or native-parts [])))

(defn- normalize-gemini-response [request body]
  (let [candidate (first (get body "candidates"))
        parts (or (get-in candidate ["content" "parts"]) [])
        text (str/join "" (map (fn [part]
                                  (if (and (some? (get part "text"))
                                           (not (get part "thought")))
                                    (or (get part "text") "")
                                    ""))
                                parts))
        normalized (normalize-gemini-parts parts)
        content-parts (first normalized)
        tool-calls (second normalized)
        usage (gemini-usage (or (get body "usageMetadata") {}))]
    (when-let [call-names (:gemini_call_names request)]
      (doseq [call tool-calls]
        (swap! call-names assoc (:id call) (:name call))))
    {:id (get body "responseId")
     :model (or (get body "modelVersion") (:model request))
     :provider "gemini"
     :message {:role :assistant :content content-parts :parts content-parts
               :text text}
     :tool_calls tool-calls
     :usage usage
     :finish_reason (if (seq tool-calls)
                      :tool_calls
                      (finish-reason (get candidate "finishReason")))
     :warnings (adapter-warnings "gemini" request)
     :raw body}))

(defn gemini-complete [request & [api-key base-url]]
  (let [{:keys [url headers payload]}
        (gemini-request-data request api-key base-url)]
    (try
        (let [transport (or (:transport request) http/request)
              resp (invoke-transport transport
                     (transport-request-options
                       request
                       {:method :post :url url :headers headers
                        :body (json/write-json (json-safe payload))}))
              status (:status resp)
              body-str (str (:body resp))]
          (if (and (number? status) (not= status 200))
            (raise-provider-error! "gemini" resp)
            (normalize-gemini-response request (parse-response-body "gemini" body-str))))
        (catch Object e (throw e)))))

;; Unified Client Complete
(defn complete [request & [client-opts]]
  (let [opts (merge request client-opts)
        parsed (parse-model-spec (:model request) (or (:provider request) (:provider opts)))
        provider (:provider parsed)
        actual-model (:model parsed)
        req (assoc request :provider provider :model actual-model)]
    (case (providers/protocol-of provider)
      :openai-responses (openai-complete req (:api_key opts) (:base_url opts))
      :openai-chat-completions (openai-compatible-complete req (:api_key opts) (:base_url opts))
      :anthropic-messages (anthropic-complete req (:api_key opts) (:base_url opts))
      :gemini-generate-content (gemini-complete req (:api_key opts) (:base_url opts))
      :mock (mock-complete req (:mock_handler opts))
      (throw (ex-info (str "Unsupported LLM provider: " provider)
                      {:provider provider :category :configuration :retryable false})))))

(defn- sse-field-value [line prefix-length]
  (let [value (subs line prefix-length)]
    (if (str/starts-with? value " ") (subs value 1) value)))

(defn- sse-event [state]
  (cond-> {:event (:event state)
           :data (str/join "\n" (:data state))}
    (some? (:retry state)) (assoc :retry (:retry state))))

(defn parse-sse-lines [lines]
  (letfn [(step [remaining state]
            (lazy-seq
              (if-let [input (seq remaining)]
                (let [line (first input)
                      more (rest input)]
                  (cond
                    (str/blank? line)
                    (let [next-state {:event "" :data [] :retry (:retry state)}]
                      (if (seq (:data state))
                        (cons (sse-event state) (step more next-state))
                        (step more next-state)))

                    (str/starts-with? line ":")
                    (step more state)

                    (str/starts-with? line "event:")
                    (step more (assoc state :event
                                      (str/trim (sse-field-value line 6))))

                    (str/starts-with? line "data:")
                    (step more (update state :data conj
                                       (sse-field-value line 5)))

                    (str/starts-with? line "retry:")
                    (let [retry-value (try
                                        (parse-long
                                          (str/trim (sse-field-value line 6)))
                                        (catch Object _ nil))]
                      (step more (if (some? retry-value)
                                   (assoc state :retry retry-value)
                                   state)))

                    :else (step more state)))
                (when (seq (:data state))
                  (list (sse-event state))))))]
    (step lines {:event "" :data [] :retry nil})))

(defn- stream-lines [body]
  (if (string? body)
    (str/split body #"\r?\n")
    (io/line-seq body)))

(defn- register-provider-stream-close! [request body]
  (let [closed (atom false)
        close! (fn []
                 (when-not (first (swap-vals! closed (fn [_] true)))
                   (when (and (some? body) (not (string? body)))
                     (try (io/close body) (catch Object _ nil)))))]
    (when (fn? (:register_stream_close request))
      ((:register_stream_close request) close!))
    close!))

(defn- stream-error [provider error raw]
  (if (:category (ex-data error))
    error
    (let [payload (or (get-in raw ["response" "error"])
                      (get raw "error") error)
          code (or (get payload "code") (get payload "type"))
          ;; Gemini's native error.code is the HTTP status. Other providers'
          ;; numeric codes are not assumed to be HTTP statuses.
          status (when (and (= provider "gemini") (number? code)
                            (<= 400 code 599)) code)
          normalized (provider-error provider {:status status :body payload})
          data (ex-data normalized)
          category (if (= :provider (:category data))
                     (case code
                       ("server_error" "api_error" "overloaded_error") :server
                       ("rate_limit_exceeded" "rate_limit_error") :rate-limit
                       ("invalid_api_key" "authentication_error") :authentication
                       "permission_error" :access-denied
                       "not_found_error" :not-found
                       "invalid_request_error" :invalid-request
                       "insufficient_quota" :quota-exceeded
                       "context_length_exceeded" :context-length
                       "content_filter" :content-filter
                       :provider)
                     (:category data))]
      (ex-info (str provider " stream error: " (or (get payload "message") payload))
               (assoc data :category category
                           :retryable (not (contains? non-retryable-error-categories category))
                           :error_code (when (some? code) (str code))
                           :raw (or raw payload))))))

(defn- stream-ended-early-error [provider]
  (ex-info
    (str provider " stream ended without a finish event")
    {:category :provider
     :provider provider
     :retryable false
     :malformed_body true}))

(defn- terminal-stream-events
  "Normalize the tail of a provider stream: the first :error is normalized and
   closes the body; a stream that ends with no :finish (or :error) is a
   malformed body, so exactly one synthesized :error terminates it."
  ([events provider close!]
   (terminal-stream-events events provider close! false))
  ([events provider close! finished?]
   (terminal-stream-events events provider close! finished? false))
  ([events provider close! finished? delivered?]
   (lazy-seq
     (if-let [remaining (if delivered?
                          (try (seq events)
                               (catch Object e
                                 ;; A failure while reading later frames (stream-read
                                 ;; timeout, reset) is the stream's terminal error.
                                 ;; Before any event is delivered the failure
                                 ;; propagates so the opener can retry.
                                 (close!)
                                 (list {:type :error :error (transport-failure e) :raw nil :read_failure true})))
                          ;; Before delivery the failure still throws, typed, so
                          ;; the opener's retry policy can decide.
                          (try (seq events)
                               (catch Object e (throw (transport-failure e)))))]
       (let [event (first remaining)]
         (if (= :error (:type event))
           (do
             (close!)
             (list (assoc event :error (stream-error provider (:error event) (:raw event)))))
           (cons event (lazy-seq
                         (terminal-stream-events (rest remaining) provider close!
                                                 (or finished? (= :finish (:type event)))
                                                 true)))))
       (when-not finished?
         (close!)
         (list {:type :error :error (stream-ended-early-error provider) :raw nil}))))))

(defn- native-stream-events [request body provider normalize]
  ;; Register ownership before line-seq can read. Defer the next native frame
  ;; until every event from this frame has been consumed; error never reads it.
  (let [close! (register-provider-stream-close! request body)]
    (letfn [(step [frames]
              (lazy-seq
                (when-let [remaining (seq frames)]
                  (concat (normalize (first remaining))
                          (lazy-seq (step (rest remaining)))))))]
      (terminal-stream-events
        (step (parse-sse-lines (stream-lines body))) provider close!))))

(defn- raise-stream-provider-error! [provider request response]
  (let [body (:body response)]
    (if (or (nil? body) (string? body) (map? body))
      (raise-provider-error! provider response)
      (let [closed (atom false)
            close! (fn []
                     (when-not (first (swap-vals! closed (fn [_] true)))
                       (try (io/close body) (catch Object _ nil))))]
        (try
          ;; Publish ownership before a potentially blocking read. A cancelled
          ;; operation may invoke this immediately, or concurrently with finally.
          (when (fn? (:register_stream_close request))
            ((:register_stream_close request) close!))
          (let [text (try (io/slurp body) (catch Object _ nil))]
            ;; A broken body must not erase HTTP status/retry classification.
            (raise-provider-error! provider (assoc response :body text)))
          (finally (close!)))))))

(defn- mark-stream-part! [state key id]
  (let [seen? (contains? (get @state key #{}) id)]
    (when-not seen? (swap! state update key conj id))
    (not seen?)))

(defn- openai-segment-id [body kind]
  (let [item (or (get body "item_id") (name kind))
        index (or (get body "content_index") 0)]
    ;; Length-prefix indexed identities so provider item IDs cannot collide.
    (if (and (= index 0) (not (str/starts-with? item "segment:")))
      item (str "segment:" (count item) ":" item ":" index))))

(defn- openai-segment-events [state body kind action value]
  (let [id (openai-segment-id body kind)
        started (if (= kind :text) :text_started :reasoning_started)
        ended (if (= kind :text) :text_ended :reasoning_ended)
        start-type (if (= kind :text) :text_start :reasoning_start)
        end-type (if (= kind :text) :text_end :reasoning_end)
        delta-type (if (= kind :text) :text_delta :reasoning_delta)
        delta-key (if (= kind :text) :delta :reasoning_delta)
        start? (mark-stream-part! state started id)]
    (when start?
      (swap! state update :segment_order (fnil conj [])
             {:kind kind :item_id (get body "item_id") :content_index (or (get body "content_index") 0)})
      (when (and (= action :start) (string? value))
        (swap! state assoc-in [:segments kind id] value)))
    (vec
      (concat
        (when start? [{:type start-type :text_id id :raw body}])
        (case action
          :start []
          :delta (do
                   (swap! state update-in [:segments kind id] #(str (or % "") (or value "")))
                   [(assoc {:type delta-type :text_id id :raw body} delta-key (or value ""))])
          :end (when (mark-stream-part! state ended id)
                 [(assoc {:type end-type :text_id id :raw body} kind
                         (if (string? value) value (get-in @state [:segments kind id] "")))])
          [])))))

(defn- openai-part-events [state body action]
  (let [part (or (get body "part") {})]
    (case (get part "type")
      "output_text" (openai-segment-events state body :text action (get part "text"))
      "reasoning_text" (openai-segment-events state body :reasoning action (get part "text"))
      [{:type :provider_event :raw body}])))

(defn- openai-stream-events [request state event]
  (let [data (:data event)]
    (if (= data "[DONE]")
      []
      (let [body (json/read-json data)
            event-type (or (get body "type") (:event event))]
        (case event-type
          "response.created"
          [{:type :stream_start :raw body}]

          "response.output_item.added"
          (let [item (get body "item")]
            (case (get item "type")
              "function_call"
              (let [tool-call (first (normalize-openai-tool-calls [item]))]
                (swap! state assoc-in [:tools (get item "id")] tool-call)
                [{:type :tool_call_start :tool_call tool-call :raw body}])
              "message" []
              [{:type :provider_event :raw body}]))

          "response.content_part.added"
          (openai-part-events state body :start)

          "response.output_text.delta"
          (openai-segment-events state body :text :delta (get body "delta"))

          "response.output_text.done"
          (openai-segment-events state body :text :end (get body "text"))

          "response.content_part.done"
          (openai-part-events state body :end)

          "response.reasoning_text.delta"
          (openai-segment-events state body :reasoning :delta (get body "delta"))

          "response.reasoning_text.done"
          (openai-segment-events state body :reasoning :end (get body "text"))

          "response.function_call_arguments.delta"
          (let [item-id (or (get body "item_id") "")
                known (or (get-in @state [:tools item-id]) {:id item-id})]
            [{:type :tool_call_delta
              :tool_call (assoc known :arguments (or (get body "delta") ""))
              :raw body}])

          "response.output_item.done"
          (let [item (get body "item")]
            (case (get item "type")
              "function_call"
              [{:type :tool_call_end
                :tool_call (first (normalize-openai-tool-calls [item]))
                :raw body}]
              ("message" "reasoning")
              (if (and (= "reasoning" (get item "type"))
                       (empty? (get item "content"))
                       (not-any? #(= (get item "id") (:item_id %)) (:segment_order @state)))
                ;; Summary/encrypted-only items remain opaque provider events.
                ;; Known segments stay silent after their completion is deduplicated.
                [{:type :provider_event :raw body}]
                (vec (concat
                     (mapcat
                       (fn [[index part]]
                         (map #(assoc % :raw body)
                              (openai-part-events state
                                (assoc body "item_id" (get item "id") "content_index" index "part" part)
                                :end)))
                       (map-indexed vector (or (get item "content") [])))
                     (mapcat
                       (fn [segment]
                         (map #(assoc % :raw body)
                              (openai-segment-events state
                                (assoc body "item_id" (:item_id segment) "content_index" (:content_index segment))
                                (:kind segment) :end nil)))
                       (filter #(= (get item "id") (:item_id %)) (:segment_order @state))))))
              [{:type :provider_event :raw body}]))

          "response.completed"
          (let [response (normalize-openai-response request (get body "response"))]
            [{:type :finish
              :finish_reason (:finish_reason response)
              :usage (:usage response)
              :response response
              :raw body}])

          "response.failed"
          [{:type :error :error (or (get body "error") body) :raw body}]

          "error"
          [{:type :error :error body :raw body}]

          [{:type :provider_event :raw body}])))))

(defn openai-stream [request & [api-key base-url]]
  (let [{:keys [url headers payload]} (openai-request-data request api-key base-url)
        transport (or (:transport request) http/request)
        resp (invoke-transport transport
               (transport-request-options
                 request
                 {:method :post :url url :headers headers :as :stream
                  :body (json/write-json
                          (json-safe (assoc payload :stream true)))}))
        status (:status resp)]
    (if (and (number? status) (not= status 200))
      (raise-stream-provider-error! "openai" request resp)
      (let [state (atom {:text_started #{} :text_ended #{}
                           :reasoning_started #{} :reasoning_ended #{}
                           :tools {}})]
        (native-stream-events request (:body resp) "openai"
                              #(openai-stream-events request state %))))))

(defn- append-string [value delta]
  (str (or value "") (or delta "")))

(defn- compatible-stream-tool-delta! [state native raw]
  (let [index (or (get native "index") (count (:tool_order @state)))
        existing (get-in @state [:tools index])
        function-data (or (get native "function") {})
        arguments-present? (contains? function-data "arguments")
        argument-delta (or (get function-data "arguments") "")
        call {:id (or (get native "id") (:id existing) (str "call_" index))
              :name (or (get function-data "name") (:name existing) "")
              :arguments (append-string (:arguments existing) argument-delta)
              :arguments_present (or (:arguments_present existing)
                                     arguments-present?)}
        first-delta? (nil? existing)]
    (when first-delta?
      (swap! state update :tool_order conj index))
    (swap! state assoc-in [:tools index] call)
    {:type (if first-delta? :tool_call_start :tool_call_delta)
     :tool_call (assoc call :arguments argument-delta)
     :raw raw}))

(defn- compatible-stream-tool-call [call]
  (let [arguments (:arguments call)
        arguments-present? (:arguments_present call)]
    (cond->
      (assoc (dissoc call :arguments_present) :arguments
             (if (and (not arguments-present?) (str/blank? arguments))
               {}
               (try
                 (json/read-json arguments)
                 (catch Object _ arguments))))
      (and arguments-present? (string? arguments))
      (assoc :raw_arguments arguments))))

(defn- compatible-stream-response [request state]
  (let [snapshot @state
        text (:text snapshot)
        tool-calls (mapv
                     (fn [index]
                       (compatible-stream-tool-call
                         (get-in snapshot [:tools index])))
                     (:tool_order snapshot))
        parts (vec
                (concat
                  (when (not= "" text) [{:kind :text :text text}])
                  (map (fn [call] {:kind :tool_call :tool_call call})
                       tool-calls)))
        native-reason (:finish_reason snapshot)
        reason (if (some? native-reason)
                 (finish-reason native-reason)
                 (if (seq tool-calls) :tool_calls :other))]
    {:id (:id snapshot)
     :model (or (:model snapshot) (:model request))
     :provider (or (:provider request) "openai-compatible")
     :message {:role :assistant :content parts :parts parts :text text}
     :tool_calls tool-calls
     :reasoning (:reasoning snapshot)
     :usage (openai-compatible-usage (:usage snapshot))
     :finish_reason reason
     :warnings (adapter-warnings "openai-compatible" request)
     :raw (:raw snapshot)}))

(defn- compatible-stream-finish-events [request state]
  (let [snapshot @state
        response (compatible-stream-response request state)
        raw (:raw snapshot)]
    (vec
      (concat
        (when (:text_started snapshot)
          [{:type :text_end :text_id "text" :text (or (:text snapshot) "") :raw raw}])
        (when (:reasoning_started snapshot)
          [{:type :reasoning_end :text_id "reasoning"
            :reasoning (:reasoning snapshot) :raw raw}])
        (map (fn [index]
               {:type :tool_call_end
                :tool_call (compatible-stream-tool-call
                             (get-in snapshot [:tools index]))
                :raw raw})
             (:tool_order snapshot))
        [{:type :finish
          :finish_reason (:finish_reason response)
          :usage (:usage response)
          :response response
          :raw raw}]))))

(defn- compatible-stream-events [request state event]
  (let [data (str/trim (:data event))]
    (if (:failed @state)
      []
      (if (= data "[DONE]")
        (compatible-stream-finish-events request state)
        (let [body (json/read-json data)
            error (get body "error")
            first-event? (not (:started @state))]
        (if (some? error)
          (do
            (swap! state assoc :started true :failed true :raw body)
            (vec
              (concat
                (when first-event?
                  [{:type :stream_start
                    :warnings (adapter-warnings "openai-compatible" request)
                    :raw body}])
                [{:type :error :error error :raw body}])))
          (let [choice (first (or (get body "choices") []))
                delta (or (get choice "delta") {})
                content (get delta "content")
                reasoning (get delta "reasoning_content")
                first-reasoning? (and (string? reasoning)
                                      (not (:reasoning_started @state)))
                native-tools (or (get delta "tool_calls") [])
                first-text? (and (some? content)
                                 (not (:text_started @state)))]
            (swap! state assoc :started true :raw body)
            (when-let [id (get body "id")] (swap! state assoc :id id))
            (when-let [model (get body "model")] (swap! state assoc :model model))
            (when-let [usage (get body "usage")]
              (swap! state update :usage merge usage))
            (when-let [reason (get choice "finish_reason")]
              (swap! state assoc :finish_reason reason))
            (when first-reasoning? (swap! state assoc :reasoning_started true))
            (when (string? reasoning)
              (swap! state update :reasoning append-string reasoning))
            (when first-text? (swap! state assoc :text_started true))
            (when (some? content)
              (swap! state update :text append-string content))
            (vec
              (concat
                (when first-event?
                  [{:type :stream_start
                    :warnings (adapter-warnings "openai-compatible" request)
                    :raw body}])
                (when first-reasoning?
                  [{:type :reasoning_start :text_id "reasoning" :raw body}])
                (when (string? reasoning)
                  [{:type :reasoning_delta :reasoning_delta reasoning
                    :text_id "reasoning" :raw body}])
                (when first-text?
                  [{:type :text_start :text_id "text" :raw body}])
                (when (some? content)
                  [{:type :text_delta :delta content
                    :text_id "text" :raw body}])
                (map (fn [native]
                       (compatible-stream-tool-delta! state native body))
                     native-tools))))))))))

(defn openai-compatible-stream [request & [api-key base-url]]
  (let [{:keys [provider url headers payload]}
        (openai-compatible-request-data request api-key base-url)
        transport (or (:transport request) http/request)
        stream-payload (assoc payload
                              :stream true
                              :stream_options
                              (merge {:include_usage true}
                                     (canonical-option-map
                                       (:stream_options payload))))
        resp (invoke-transport transport
               (transport-request-options
                 request
                 {:method :post :url url :headers headers :as :stream
                  :body (json/write-json (json-safe stream-payload))}))
        status (:status resp)]
    (if (and (number? status) (not= status 200))
      (raise-stream-provider-error! provider request resp)
      (let [state (atom {:started false :text_started false :text ""
                           :tools {} :tool_order [] :usage {}})]
        (native-stream-events request (:body resp) provider
                              #(compatible-stream-events request state %))))))

(defn- anthropic-stream-event [request state event]
  ;; Some Messages-compatible gateways (OpenRouter) append a Chat Completions
  ;; style "[DONE]" sentinel after message_stop; it carries no event.
  (when-not (= "[DONE]" (str/trim (str (:data event))))
   (let [body (json/read-json (:data event))
         event-type (or (get body "type") (:event event))]
    (case event-type
      "message_start"
      (let [message (or (get body "message") {})]
        (swap! state assoc
               :id (get message "id")
               :model (or (get message "model") (:model request))
               :usage (or (get message "usage") {}))
        {:type :stream_start :raw body})

      "content_block_start"
      (let [index (or (get body "index") 0)
            block (or (get body "content_block") {})
            block-type (get block "type")]
        (swap! state assoc-in [:blocks index] block)
        (swap! state update :order conj index)
        (case block-type
          "text" {:type :text_start :text_id (str "text-" index) :raw body}
          "tool_use" {:type :tool_call_start
                      :tool_call {:id (or (get block "id") "")
                                  :name (or (get block "name") "")
                                  :arguments (or (get block "input") {})}
                      :raw body}
          ("thinking" "redacted_thinking")
          {:type :reasoning_start :text_id (str "reasoning-" index) :raw body}
          {:type :provider_event :raw body}))

      "content_block_delta"
      (let [index (or (get body "index") 0)
            delta (or (get body "delta") {})
            delta-type (get delta "type")]
        (case delta-type
          "text_delta"
          (let [text (or (get delta "text") "")]
            (swap! state update-in [:blocks index "text"] append-string text)
            {:type :text_delta :delta text :text_id (str "text-" index) :raw body})

          "input_json_delta"
          (let [partial (or (get delta "partial_json") "")
                block (get-in @state [:blocks index])]
            (swap! state update-in [:blocks index :partial_json] append-string partial)
            {:type :tool_call_delta
             :tool_call {:id (or (get block "id") "")
                         :name (or (get block "name") "")
                         :arguments partial}
             :raw body})

          "thinking_delta"
          (let [thinking (or (get delta "thinking") "")]
            (swap! state update-in [:blocks index "thinking"] append-string thinking)
            {:type :reasoning_delta :reasoning_delta thinking
             :text_id (str "reasoning-" index) :raw body})

          "signature_delta"
          (do
            (swap! state update-in [:blocks index "signature"]
                   append-string (or (get delta "signature") ""))
            nil)

          {:type :provider_event :raw body}))

      "content_block_stop"
      (let [index (or (get body "index") 0)
            block (or (get-in @state [:blocks index]) {})
            block-type (get block "type")]
        (case block-type
          "text" {:type :text_end :text_id (str "text-" index) :text (or (get block "text") "") :raw body}
          "tool_use"
          (let [raw-args (or (:partial_json block) "")
                args (if (str/blank? raw-args)
                       (or (get block "input") {})
                       (try (json/read-json raw-args)
                            (catch Object _ {})))
                tool-call {:id (or (get block "id") "")
                           :name (or (get block "name") "")
                           :arguments args}]
            (swap! state assoc-in [:blocks index "input"] args)
            {:type :tool_call_end :tool_call tool-call :raw body})
          ("thinking" "redacted_thinking")
          {:type :reasoning_end :text_id (str "reasoning-" index)
           :reasoning (if (= block-type "thinking") (or (get block "thinking") "") "") :raw body}
          {:type :provider_event :raw body}))

      "message_delta"
      (let [delta (or (get body "delta") {})]
        (swap! state update :usage merge (or (get body "usage") {}))
        (swap! state assoc :stop_reason (get delta "stop_reason"))
        nil)

      "message_stop"
      (let [snapshot @state
            blocks (mapv (fn [index] (get-in snapshot [:blocks index]))
                         (:order snapshot))
            response (normalize-anthropic-response
                       request
                       {"id" (:id snapshot)
                        "model" (:model snapshot)
                        "content" blocks
                        "usage" (:usage snapshot)
                        "stop_reason" (:stop_reason snapshot)})]
        {:type :finish
         :finish_reason (:finish_reason response)
         :usage (:usage response)
         :response response
         :raw body})

      "error" {:type :error :error (or (get body "error") body) :raw body}
      {:type :provider_event :raw body})))
)
(defn anthropic-stream [request & [api-key base-url]]
  (let [{:keys [url headers payload]}
        (anthropic-request-data request api-key base-url)
        transport (or (:transport request) http/request)
        resp (invoke-transport transport
               (transport-request-options
                 request
                 {:method :post :url url :headers headers :as :stream
                  :body (json/write-json
                          (json-safe (assoc payload :stream true)))}))
        status (:status resp)]
    (if (and (number? status) (not= status 200))
      (raise-stream-provider-error! "anthropic" request resp)
      (let [state (atom {:blocks {} :order [] :usage {}})]
        (native-stream-events request (:body resp) "anthropic"
                              #(when-let [event (anthropic-stream-event request state %)]
                                 (list event)))))))

(defn- gemini-stream-url [url]
  (str/replace url ":generateContent" ":streamGenerateContent?alt=sse"))

(defn- gemini-stream-response [request state raw]
  (let [snapshot @state
        tool-calls (:tool_calls snapshot)
        usage (gemini-usage (:usage snapshot))
        parts (vec
                (concat
                  (when-not (str/blank? (:reasoning snapshot))
                    [{:kind :thinking
                      :thinking {:text (:reasoning snapshot)
                                 :redacted false}}])
                  (when-not (str/blank? (:text snapshot))
                    [{:kind :text :text (:text snapshot)}])
                  (map (fn [call] {:kind :tool_call :tool_call call})
                       tool-calls)))]
    {:id (:id snapshot)
     :model (or (:model snapshot) (:model request))
     :provider "gemini"
     :message {:role :assistant :content parts :parts parts
               :text (:text snapshot)}
     :tool_calls tool-calls
     :usage usage
     :finish_reason (if (seq tool-calls)
                      :tool_calls
                      (finish-reason (:finish_reason snapshot)))
     :warnings (adapter-warnings "gemini" request)
     :raw raw}))

(defn- gemini-stream-events [request state event]
  (let [body (if (= "[DONE]" (str/trim (str (:data event)))) {} (json/read-json (:data event)))]
    (if-let [error (get body "error")]
      [{:type :error :error error :raw body}]
      (let [candidate (first (or (get body "candidates") []))
        parts (or (get-in candidate ["content" "parts"]) [])
        text-parts (filter (fn [part]
                             (and (some? (get part "text"))
                                  (not (get part "thought"))))
                           parts)
        reasoning-parts (filter (fn [part]
                                  (and (some? (get part "text"))
                                       (get part "thought")))
                                parts)
        provider-calls (filter (fn [part] (some? (get part "functionCall"))) parts)
        calls (mapv (fn [part]
                      (let [call (get part "functionCall")]
                        {:id (or (get call "id") (str "call_" (ids/uuid-text)))
                         :name (or (get call "name") "")
                         :arguments (or (get call "args") {})}))
                    provider-calls)
        first-event? (not (:started @state))
        first-text? (and (seq text-parts) (not (:text_started @state)))
        first-reasoning? (and (seq reasoning-parts) (not (:reasoning_started @state)))
        finish-provider (get candidate "finishReason")]
    (swap! state assoc :started true)
    (when-let [id (get body "responseId")] (swap! state assoc :id id))
    (when-let [model (get body "modelVersion")] (swap! state assoc :model model))
    (when-let [usage (get body "usageMetadata")] (swap! state update :usage merge usage))
    (when first-text? (swap! state assoc :text_started true))
    (when first-reasoning? (swap! state assoc :reasoning_started true))
    (doseq [part text-parts]
      (swap! state update :text append-string (get part "text")))
    (doseq [part reasoning-parts]
      (swap! state update :reasoning append-string (get part "text")))
    (when (seq calls) (swap! state update :tool_calls into calls))
    (when-let [call-names (:gemini_call_names request)]
      (doseq [call calls]
        (swap! call-names assoc (:id call) (:name call))))
    (when finish-provider (swap! state assoc :finish_reason finish-provider))
    (let [start-events (when first-event? [{:type :stream_start :raw body}])
          text-events (concat
                        (when first-text? [{:type :text_start :text_id "text" :raw body}])
                        (map (fn [part]
                               {:type :text_delta :delta (or (get part "text") "")
                                :text_id "text" :raw body})
                             text-parts))
          reasoning-events (concat
                             (when first-reasoning?
                               [{:type :reasoning_start :text_id "reasoning" :raw body}])
                             (map (fn [part]
                                    {:type :reasoning_delta
                                     :reasoning_delta (or (get part "text") "")
                                     :text_id "reasoning" :raw body})
                                  reasoning-parts))
          tool-events (mapcat (fn [call]
                                [{:type :tool_call_start :tool_call call :raw body}
                                 {:type :tool_call_end :tool_call call :raw body}])
                              calls)
          end-events (when finish-provider
                       (concat
                         (when (:text_started @state)
                           [{:type :text_end :text_id "text" :text (or (:text @state) "") :raw body}])
                         (when (:reasoning_started @state)
                           [{:type :reasoning_end :text_id "reasoning" :reasoning (or (:reasoning @state) "") :raw body}])
                         (let [response (gemini-stream-response request state body)]
                           [{:type :finish
                             :finish_reason (:finish_reason response)
                             :usage (:usage response)
                             :response response
                             :raw body}]))) ]
      (vec (concat start-events text-events reasoning-events tool-events end-events)))))))

(defn gemini-stream [request & [api-key base-url]]
  (let [{:keys [url headers payload]}
        (gemini-request-data request api-key base-url)
        transport (or (:transport request) http/request)
        resp (invoke-transport transport
               (transport-request-options
                 request
                 {:method :post :url (gemini-stream-url url)
                  :headers headers :as :stream
                  :body (json/write-json (json-safe payload))}))
        status (:status resp)]
    (if (and (number? status) (not= status 200))
      (raise-stream-provider-error! "gemini" request resp)
      (let [state (atom {:started false :text_started false
                           :reasoning_started false :text "" :reasoning ""
                           :tool_calls [] :usage {}})]
        (native-stream-events request (:body resp) "gemini"
                              #(gemini-stream-events request state %))))))

(defn- provider-stream [request & [client-opts]]
  (let [opts (merge request client-opts)
        parsed (parse-model-spec (:model request) (or (:provider request) (:provider opts)))
        provider (:provider parsed)
        req (assoc request :provider provider :model (:model parsed))]
    (case (providers/protocol-of provider)
      :openai-responses (openai-stream req (:api_key opts) (:base_url opts))
      :openai-chat-completions (openai-compatible-stream req (:api_key opts) (:base_url opts))
      :anthropic-messages (anthropic-stream req (:api_key opts) (:base_url opts))
      :gemini-generate-content (gemini-stream req (:api_key opts) (:base_url opts))
      (throw (ex-info (str "Streaming is not implemented for provider: " provider)
                      {:provider provider :category :configuration :retryable false})))))

(defn make-stream-accumulator []
  (atom {:started false
         :text ""
         :reasoning ""
         :tool_calls {}
         :tool_order []
         :error nil
         :response nil}))

(defn- stream-tool-id [tool-call]
  (or (:id tool-call) (get tool-call "id") ""))

(defn- update-stream-tool! [accumulator tool-call]
  (let [call-id (stream-tool-id tool-call)
        existing (get-in @accumulator [:tool_calls call-id])
        old-arguments (:arguments existing)
        new-arguments (:arguments tool-call)
        arguments
        (cond
          (and (string? old-arguments) (string? new-arguments))
          (str old-arguments new-arguments)

          (and (map? old-arguments) (map? new-arguments))
          (merge old-arguments new-arguments)

          (some? new-arguments) new-arguments
          :else old-arguments)
        merged (cond-> (merge existing tool-call)
                 (some? arguments) (assoc :arguments arguments))]
    (when-not (contains? (:tool_calls @accumulator) call-id)
      (swap! accumulator update :tool_order conj call-id))
    (swap! accumulator assoc-in [:tool_calls call-id] merged)))

(defn stream-accumulator-process! [accumulator event]
  (case (:type event)
    :stream_start (swap! accumulator assoc
                         :started true
                         :text ""
                         :reasoning ""
                         :tool_calls {}
                         :tool_order []
                         :error nil
                         :response nil
                         :finish_reason nil
                         :usage {})
    :text_delta (swap! accumulator update :text append-string (:delta event))
    :reasoning_delta
    (swap! accumulator update :reasoning append-string
           (:reasoning_delta event))
    :tool_call_start (update-stream-tool! accumulator (:tool_call event))
    :tool_call_delta (update-stream-tool! accumulator (:tool_call event))
    :tool_call_end (update-stream-tool! accumulator (:tool_call event))
    :error (swap! accumulator assoc :error (:error event))
    :finish (swap! accumulator assoc
                   :response (:response event)
                   :finish_reason (:finish_reason event)
                   :usage (:usage event))
    nil)
  event)

(defn stream-accumulator-response [accumulator]
  (let [snapshot @accumulator]
    (or (:response snapshot)
        (when (or (:started snapshot)
                  (seq (:text snapshot))
                  (not (str/blank? (:reasoning snapshot)))
                  (seq (:tool_order snapshot)))
          (let [tool-calls
                (mapv (fn [call-id]
                        (get-in snapshot [:tool_calls call-id]))
                      (:tool_order snapshot))
                parts
                (vec
                  (concat
                    (when-not (str/blank? (:reasoning snapshot))
                      [{:kind :thinking
                        :thinking {:text (:reasoning snapshot)}}])
                    (when (seq (:text snapshot))
                      [{:kind :text :text (:text snapshot)}])
                    (map (fn [call]
                           {:kind :tool_call :tool_call call})
                         tool-calls)))]
            {:message {:role :assistant
                       :content parts
                       :parts parts
                       :text (:text snapshot)}
             :reasoning (:reasoning snapshot)
             :tool_calls tool-calls
             :usage (or (:usage snapshot) {})
             :finish_reason (:finish_reason snapshot)})))))

;; Provider adapter and configurable Client layer
(defn make-adapter [name complete-fn stream-fn & [opts]]
  (when (str/blank? name)
    (throw (ex-info "Provider adapter name is required"
                    {:category :configuration :retryable false})))
  (when (nil? complete-fn)
    (throw (ex-info (str "Provider adapter " name " must implement complete")
                    {:provider name :category :configuration :retryable false})))
  {:name (str/lower-case name)
   :complete complete-fn
   :stream stream-fn
   :options (or (:options opts) {})
   :initialize (:initialize opts)
   :close (:close opts)
   :discover_context (:discover_context opts)
   :supports_tool_choice (:supports_tool_choice opts)})

(defn- probe-context [request options]
  (let [opts (merge options request)
        provider (str/lower-case (or (:provider opts) "openai"))
        protocol (providers/protocol-of provider)
        base (when (contains? #{:openai-responses :openai-chat-completions} protocol)
               (providers/base-url provider (:base_url opts)))]
    (if (or (nil? base)
            (= "https://api.openai.com/v1" base)
            (:transport opts))
      {:status :unsupported :reason :unsupported}
      (let [key (resolve-api-key provider (:api_key opts))]
        (capacity/probe!
          {:base_url base :model (:model opts)
           :headers (merge {"Content-Type" "application/json"}
                           (providers/auth-headers provider key protocol))
           :timeout_ms (or (:context_discovery_timeout_ms opts) 1000)
           :aborted? (:context_discovery_aborted? opts)})))))

(defn discover-context [request & [options]]
  (let [opts (merge options request)]
    (capacity/call! #(probe-context request options)
                    {:timeout_ms (or (:context_discovery_timeout_ms opts) 1000)
                     :aborted? (:context_discovery_aborted? opts)})))

(defn make-provider-adapter [provider & [opts]]
  (let [name (str/lower-case provider)
        options (or opts {})
        protocol (providers/protocol-of name)
        gemini-call-names (when (= protocol :gemini-generate-content) (atom {}))
        request-with-options
        (fn [request]
          (cond-> (merge options request)
            gemini-call-names (assoc :gemini_call_names gemini-call-names)))
        ;; Configured providers resolve their key and base URL from the
        ;; registry once, so the protocol functions never fall back to the
        ;; built-in provider's environment names for a custom id.
        with-credentials
        (fn [req]
          (if (= :mock protocol)
            req
            (cond-> req
              (not (contains? req :api_key)) (assoc :api_key (resolve-api-key name nil))
              (not (contains? req :base_url)) (assoc :base_url (providers/base-url name nil)))))
        complete-fn
        (fn [request]
          (let [req (with-credentials (request-with-options request))]
            (case protocol
              :openai-responses (openai-complete req (:api_key req) (:base_url req))
              :openai-chat-completions (openai-compatible-complete req (:api_key req) (:base_url req))
              :anthropic-messages (anthropic-complete req (:api_key req) (:base_url req))
              :gemini-generate-content (gemini-complete req (:api_key req) (:base_url req))
              :mock (mock-complete req (:mock_handler req))
              (throw (ex-info (str "Unsupported LLM provider: " name)
                              {:provider name :category :configuration :retryable false})))))
        stream-fn
        (fn [request]
          (let [req (with-credentials (request-with-options request))]
            (case protocol
              :openai-responses (openai-stream req (:api_key req) (:base_url req))
              :openai-chat-completions (openai-compatible-stream req (:api_key req) (:base_url req))
              :anthropic-messages (anthropic-stream req (:api_key req) (:base_url req))
              :gemini-generate-content (gemini-stream req (:api_key req) (:base_url req))
              (throw (ex-info (str "Streaming is not implemented for provider: " name)
                              {:provider name :category :configuration :retryable false})))))]
    (make-adapter name complete-fn stream-fn
                  {:options options
                   :supports_tool_choice
                   (or (:supports_tool_choice options)
                       (when (contains? #{:openai-responses :openai-chat-completions
                                          :anthropic-messages :gemini-generate-content} protocol)
                         (fn [mode] (contains? #{"auto" "none" "required" "named"} mode))))
                   :discover_context
                   (fn [request] (probe-context (assoc (request-with-options request) :provider name) nil))})))

(defn- normalize-provider-name [provider]
  (when (some? provider)
    (str/lower-case (name provider))))

(defn make-client [& [opts]]
  (let [options (or opts {})
        providers
        (into {}
              (map (fn [[provider adapter]]
                     [(normalize-provider-name provider) adapter])
                   (or (:providers options) {})))
        default-provider (normalize-provider-name (:default_provider options))]
    (when (and (some? default-provider)
               (nil? (get providers default-provider)))
      (throw (ex-info (str "Default provider is not registered: " default-provider)
                      {:provider default-provider :category :configuration :retryable false})))
    (doseq [[_ adapter] providers]
      (when-let [initialize (:initialize adapter)]
        (initialize)))
    {:providers providers
     :default_provider default-provider
     :middleware (vec (or (:middleware options) []))}))

(defn- routed-request
  "Resolve the provider for a request. A model written as `<id>/<name>` whose
   prefix is a registered provider selects that provider and strips the
   prefix from the model sent on the wire (an explicit :provider that differs
   keeps the model untouched, since ids like `google/gemma` are legitimate
   model names elsewhere). Returns the request with :provider and :model set."
  [client request]
  (let [spec (str (or (:model request) ""))
        prefixed (when (and (str/includes? spec "/") (not (str/starts-with? spec "/")))
                   (let [[prefix rest] (split-once spec "/")]
                     (when (contains? (:providers client) (normalize-provider-name prefix))
                       {:provider (normalize-provider-name prefix) :model rest})))
        explicit (normalize-provider-name (:provider request))
        provider (or explicit (:provider prefixed) (normalize-provider-name (:default_provider client)))]
    (when (nil? provider)
      (throw (ex-info "No provider specified and Client has no default provider"
                      {:category :configuration :retryable false})))
    (when (nil? (get (:providers client) provider))
      (throw (ex-info (str "Provider is not registered: " provider)
                      {:provider provider :category :configuration :retryable false})))
    (cond-> (assoc request :provider provider)
      (and prefixed (= provider (:provider prefixed))) (assoc :model (:model prefixed)))))

(defn- client-provider [client request]
  (let [routed (routed-request client request)
        provider (:provider routed)]
    [provider (get (:providers client) provider) routed]))

(defn- middleware-chain [middleware terminal]
  (reduce (fn [next middleware-fn]
            (fn [request] (middleware-fn request next)))
          terminal
          (reverse middleware)))

(defn- middleware-provider [client request]
  ;; Model-prefix normalization already ran before middleware. Only resolve
  ;; the possibly changed provider here: native model names may contain '/'.
  (let [[provider adapter] (client-provider client (dissoc request :model))]
    (when-let [mode (tool-choice-mode request)]
      (when-let [supports (:supports_tool_choice adapter)]
        (when-not (supports mode)
          (throw (ex-info (str "Provider does not support tool choice: " mode)
                          {:provider provider :category :unsupported-tool-choice
                           :tool_choice mode :retryable false})))))
    ;; Choose omitted models only after middleware has selected the provider.
    ;; Explicit requests and adapter configuration override the advisory catalog;
    ;; custom providers without a catalog entry retain their own default behavior.
    (let [model (or (:model request)
                    (get-in adapter [:options :model])
                    (:id (models/get-latest-model provider)))]
      [provider adapter (cond-> (assoc request :provider provider)
                          (some? model) (assoc :model model))])))

(defn client-complete [client request]
  (let [req (routed-request client request)
        invoke (middleware-chain
                 (:middleware client)
                 (fn [r]
                   (let [[_ adapter routed] (middleware-provider client r)]
                     ((:complete adapter) routed))))]
    (invoke req)))

(defn- client-stream-with [client request wrap-events]
  ;; High-level callers normalize adapter errors here, after routing. Keeping
  ;; the wrapper explicit preserves the low-level client's raw event contract.
  (let [req (routed-request client request)]
    ((middleware-chain (:middleware client)
                       (fn [r]
                         (let [[provider adapter routed] (middleware-provider client r)
                               stream-fn (:stream adapter)]
                           (when (nil? stream-fn)
                             (throw (ex-info (str "Provider does not implement streaming: " provider)
                                             {:provider provider :category :configuration :retryable false})))
                           (wrap-events (stream-fn routed) provider))))
     req)))

(defn client-stream [client request]
  (client-stream-with client request (fn [events _] events)))

(defn client-discover-context [client request]
  (let [[provider adapter] (client-provider client request)
        options (merge (:options adapter) request)]
    (if-let [discover (:discover_context adapter)]
      (capacity/call!
        (fn [] (discover (assoc request :provider provider)))
        {:timeout_ms (or (:context_discovery_timeout_ms options) 1000)
         :aborted? (:context_discovery_aborted? options)})
      {:status :unsupported :reason :unsupported})))

(defn client-close! [client]
  (doseq [[_ adapter] (:providers client)]
    (when-let [close (:close adapter)]
      (close)))
  nil)

(defn- env-get [environment key]
  (if (map? environment)
    (get environment key)
    (os/getenv key)))

(defn- present-env [environment key]
  (let [value (env-get environment key)]
    (when-not (str/blank? value) value)))

(defn client-from-env
  "Register every configured provider whose key is present:
   from the process environment or a config file, or, when an explicit
   environment map is given, from that map only. Chat-completions providers
   also need a base URL. The default provider is the first of openai,
   anthropic, gemini, then any other configured id in sorted order."
  [& [environment]]
  (let [env (or environment :process)
        get-env (fn [name] (env-get env name))
        key-for (if (map? env)
                  (fn [id] (some (fn [name] (present-env env name)) (providers/key-env-names id)))
                  (fn [id] (providers/api-key id nil get-env)))
        providers
        (into {}
              (keep (fn [id]
                      (let [key (key-for id)
                            base (providers/base-url id nil get-env)
                            protocol (providers/protocol-of id)]
                        (when (and key (or base (not= :openai-chat-completions protocol)))
                          [id (make-provider-adapter
                                id (cond-> {:api_key key :base_url base}
                                     (= "openai" id)
                                     (assoc :org_id (present-env env "OPENAI_ORG_ID")
                                            :project_id (present-env env "OPENAI_PROJECT_ID"))))])))
                    (providers/ids)))
        default-provider (some #(when (contains? providers %) %)
                               (concat ["openai" "anthropic" "gemini"] (sort (keys providers))))]
    (make-client {:providers providers :default_provider default-provider})))

(defonce default-client (atom nil))

(defn set-default-client! [client]
  (reset! default-client client)
  client)

(defn get-default-client []
  (loop []
    (if-let [installed @default-client]
      installed
      (let [client (client-from-env)]
        (if (compare-and-set! default-client nil client)
          client
          (do
            ;; An explicit setter or another initializer published first.
            ;; This candidate was never exposed to a caller and is ours to close.
            (client-close! client)
            (recur)))))))

(def default-retry-policy
  {:max_retries 2
   :base_delay 1.0
   :max_delay 60.0
   :backoff_multiplier 2.0
   :jitter true})

(defn make-abort-controller []
  (let [aborted (atom false)]
    {:signal {:aborted? (fn [] @aborted)}
     :abort (fn [] (reset! aborted true))}))

(defn- signal-aborted? [signal]
  (cond
    (nil? signal) false
    (map? signal)
    (let [value (or (:aborted? signal)
                    (:aborted signal)
                    (get signal "aborted"))]
      (if (fn? value) (boolean (value)) (boolean value)))
    (fn? signal) (boolean (signal))
    :else
    (try
      (boolean @signal)
      (catch Object _ false))))

(defn- abort-error []
  (ex-info "The LLM operation was aborted"
           {:category :abort :retryable false :local_control_error true}))

(defn- timeout-error [scope]
  (ex-info (str "The LLM operation exceeded its " (name scope) " timeout")
           {:category :request-timeout :scope scope :retryable false
            :local_control_error true}))

(defn- seconds->milliseconds [seconds]
  (when (some? seconds)
    (max 0 (long (* 1000.0 (double seconds))))))

(defn- operation-control [options]
  (let [timeout (:timeout options)
        total (if (map? timeout) (:total timeout) timeout)
        per-step (when (map? timeout) (:per_step timeout))
        started (System/currentTimeMillis)]
    {:external_signal (:abort_signal options)
     :timed_out (atom false)
     :stream_closer (atom nil)
     :terminal_reason (atom nil)
     :step_deadline (atom nil)
     :invoke_deadline (atom nil)
     ;; True while the owner drains an attempt (failure, retry, completion or
     ;; termination), so cooperative provider descendants polling the combined
     ;; signal stop before they are joined. The next attempt clears it.
     :attempt_done (atom false)
     ;; Attempt generation: advanced when a successor attempt starts after a
     ;; drain, so a close handle published late by the drained attempt cannot
     ;; replace its successor's. During the drain itself late handles are
     ;; still accepted and closed immediately.
     :attempt (atom 0)
     :total_deadline (when (some? total)
                       (+ started (seconds->milliseconds total)))
     :per_step_ms (seconds->milliseconds per-step)}))

(defn- control-aborted? [control]
  (or @(:timed_out control)
      @(:attempt_done control)
      (some? @(:terminal_reason control))
      (signal-aborted? (:external_signal control))))

(defn- combined-abort-signal [control]
  {:aborted? (fn [] (control-aborted? control))})

(defn- close-active-stream! [control]
  (when-let [close-fn (first (swap-vals! (:stream_closer control)
                                         (fn [_] nil)))]
    (try
      (close-fn)
      (catch Object _ nil)))
  nil)

(defn- register-stream-close! [control generation close-fn]
  (when (= generation @(:attempt control))
    (reset! (:stream_closer control) close-fn)
    ;; Cancellation can win the race before a connecting adapter publishes its
    ;; close handle. Close immediately if that happened.
    (when (control-aborted? control)
      (close-active-stream! control)))
  nil)

(defn- attempt-close-registration [control]
  ;; Called inside the owned job, after any predecessor attempt has drained,
  ;; so the captured generation is the one this attempt's resources belong to.
  (let [generation @(:attempt control)]
    (fn [close-fn] (register-stream-close! control generation close-fn))))

(defn- elect-terminal! [control reason]
  ;; First cause wins atomically. A local abort/timeout elected here must not
  ;; be replaced by the transport error it subsequently causes.
  (compare-and-set! (:terminal_reason control) nil reason))

(defn- terminal-control-error [control]
  (case @(:terminal_reason control)
    :abort (abort-error)
    :total (timeout-error :total)
    :per_step (timeout-error :per_step)
    nil))

(defn- control-check! [control]
  ;; Runs on the operation coordinator while a job is busy and while idle
  ;; between demanded reads. It replaces the former unowned monitor future.
  (let [now (System/currentTimeMillis)]
    (when (signal-aborted? (:external_signal control))
      (elect-terminal! control :abort))
    (when (and (:total_deadline control) (>= now (:total_deadline control)))
      (reset! (:timed_out control) true)
      (elect-terminal! control :total))
    (let [deadlines (remove nil? [@(:step_deadline control)
                                  @(:invoke_deadline control)])]
      (when (and (seq deadlines) (>= now (apply min deadlines)))
        (reset! (:timed_out control) true)
        (elect-terminal! control :per_step))))
  (when-let [error (terminal-control-error control)]
    (throw error)))

(defn- owned-control [options]
  ;; One persistent coordinator per high-level operation. It belongs to the
  ;; caller's scope and owns the child scope in which demanded provider work
  ;; runs; terminal acknowledgement waits for body closure and worker drainage.
  (let [control (operation-control options)]
    (assoc control
           :owner (owner/start! {:check! (fn [] (control-check! control))
                                 :cleanup! (fn []
                                             (reset! (:attempt_done control) true)
                                             (close-active-stream! control))}))))

(defn- close-owner! [control]
  ;; External callers join cleanup; owned callbacks only request closure.
  (when-let [o (:owner control)]
    (owner/close! o)))

(defn- close-owner-quietly! [control]
  (try (close-owner! control) (catch Object _ nil)))

(defn- close-stream! [control]
  ;; Public close joins cleanup but never throws: a consumer closing from a
  ;; finally block must not have its own error replaced by the terminal one.
  (elect-terminal! control :closed)
  (reset! (:step_deadline control) nil)
  (close-active-stream! control)
  (close-owner-quietly! control))

(defn- check-operation! [control]
  (when (signal-aborted? (:external_signal control))
    (elect-terminal! control :abort))
  (when (and (:total_deadline control)
             (>= (System/currentTimeMillis) (:total_deadline control)))
    (reset! (:timed_out control) true)
    (elect-terminal! control :total))
  (when-let [error (terminal-control-error control)]
    (close-active-stream! control)
    (throw error)))

(defn- invocation-deadline [control per-step?]
  (let [now (System/currentTimeMillis)
        step-deadline (when (and per-step? (:per_step_ms control))
                        (+ now (:per_step_ms control)))
        total-deadline (:total_deadline control)]
    (cond
      (and step-deadline total-deadline) (min step-deadline total-deadline)
      step-deadline step-deadline
      :else total-deadline)))

(defn- controlled-invoke [control per-step? operation & [fixed-deadline]]
  ;; Demanded work runs as a job owned by the operation coordinator, which
  ;; polls control, cancels and joins the job, closes registered bodies and
  ;; drains the owned scope before the terminal error reaches this caller.
  (check-operation! control)
  (let [deadline (or fixed-deadline
                     (invocation-deadline control per-step?))]
    (reset! (:invoke_deadline control) deadline)
    (when (first (swap-vals! (:attempt_done control) (fn [_] false)))
      (swap! (:attempt control) inc))
    (try
      (owner/invoke! (:owner control) operation)
      (finally
        (reset! (:invoke_deadline control) nil)))))

(defn- controlled-sleep! [control seconds]
  (let [finish (+ (System/currentTimeMillis)
                  (seconds->milliseconds seconds))]
    (loop []
      (check-operation! control)
      (let [remaining (- finish (System/currentTimeMillis))]
        (when (> remaining 0)
          (core/sleep (min 10 remaining))
          (recur))))))

(defn- controlled-retry-policy [control policy]
  (let [custom-sleep (:sleep_fn policy)
        custom-on-retry (:on_retry policy)]
    (assoc
      policy
      :sleep_fn
      (if custom-sleep
        (fn [seconds]
          (controlled-invoke control false #(custom-sleep seconds)))
        (fn [seconds] (controlled-sleep! control seconds)))
      :on_retry
      (fn [error attempt delay]
        (close-active-stream! control)
        (when custom-on-retry
          (custom-on-retry error attempt delay))))))

(defn retry-delay [attempt policy]
  (let [base (double (or (:base_delay policy) 1.0))
        multiplier (double (or (:backoff_multiplier policy) 2.0))
        max-delay (double (or (:max_delay policy) 60.0))
        calculated (min (* base (math/pow multiplier (double attempt)))
                        max-delay)
        jitter-factor (if (= false (:jitter policy))
                        1.0
                        (+ 0.5 (math/random)))]
    (* calculated jitter-factor)))

(defn retry
  "Retry an operation within policy bounds. Optional :should_retry receives the
   original exception and overrides its :retryable classification. It does not
   override :max_retries or the maximum accepted Retry-After delay."
  [operation & [policy-options]]
  (let [policy (merge default-retry-policy (or policy-options {}))
        max-retries (max 0 (:max_retries policy))
        max-delay (double (:max_delay policy))
        sleep-fn (or (:sleep_fn policy)
                     (fn [delay-seconds]
                       (core/sleep (long (* delay-seconds 1000.0)))))
        on-retry (or (:on_retry policy) (fn [_ _ _] nil))]
    (loop [attempt 0]
      (let [result (try
                     {:value (operation)}
                     (catch Object e {:error e}))]
        (if-let [error (:error result)]
          (let [data (or (ex-data error) {})
                retryable (if-let [should-retry (:should_retry policy)]
                            (should-retry error)
                            (if (contains? data :retryable)
                              (:retryable data)
                              true))
                retry-after (:retry_after data)
                delay (if (some? retry-after)
                        (double retry-after)
                        (retry-delay attempt policy))
                retry-after-too-long (and (some? retry-after)
                                          (> delay max-delay))]
            (if (and retryable
                     (< attempt max-retries)
                     (not retry-after-too-long))
              (do
                (on-retry error (inc attempt) delay)
                (sleep-fn delay)
                (recur (inc attempt)))
              (throw error)))
          (:value result))))))

(defn- generation-client [options]
  (or (:client options)
      (when (contains? options :mock_handler)
        (make-client
          {:providers {"mock" (make-provider-adapter
                                "mock" {:mock_handler (:mock_handler options)})}
           :default_provider "mock"}))
      (get-default-client)))

(defn- high-level-tool-name [value]
  (str (or (:name value) (get value "name") "")))

(defn- find-tool [tools tool-name]
  (first (filter (fn [tool] (= (high-level-tool-name tool) tool-name)) tools)))

(defn- tool-error-result [tool-call message]
  {:tool_call_id (or (:id tool-call) (get tool-call "id") "")
   :tool_name (high-level-tool-name tool-call)
   :content message
   :is_error true})

(defn- parse-tool-arguments [tool-call]
  (let [arguments (cond
                    (contains? tool-call :arguments)
                    (:arguments tool-call)
                    (contains? tool-call "arguments")
                    (get tool-call "arguments")
                    :else {})
        parsed (if (string? arguments)
                 (json/read-json arguments)
                 arguments)]
    (when-not (map? parsed)
      (throw
        (ex-info "Tool arguments must be a JSON object"
                 {:category :invalid-tool-arguments
                  :arguments parsed})))
    parsed))

(declare validate-json-schema)

(defn- validated-tool-arguments [tool tool-call]
  (let [arguments (parse-tool-arguments tool-call)
        schema (:parameters tool)
        [valid? reason] (if (some? schema)
                          (validate-json-schema arguments schema)
                          [true ""])]
    (when-not valid?
      (throw (ex-info reason {:category :invalid-tool-arguments
                              :tool_name (high-level-tool-name tool-call)})))
    arguments))

(defn- repair-tool-arguments [tool tool-call repair control]
  (let [validated (try {:arguments (validated-tool-arguments tool tool-call)}
                       (catch Object error {:error error}))]
    (if-let [error (:error validated)]
      (if repair
        (do
          (check-operation! control)
          (let [repaired (repair tool-call error)]
            (check-operation! control)
            (when-not (and (map? repaired)
                          (= (high-level-tool-name tool-call) (high-level-tool-name repaired))
                          (= (or (:id tool-call) (get tool-call "id") "")
                             (or (:id repaired) (get repaired "id") "")))
              (throw (ex-info "Repair must preserve the tool call ID and name"
                              {:category :invalid-tool-arguments})))
            ;; Exactly one repair attempt; invalid repairs become tool errors.
            (validated-tool-arguments tool repaired)))
        (throw error))
      (:arguments validated))))

(defn- execute-tool-call [tools tool-call repair control]
  (check-operation! control)
  (let [tool-name (high-level-tool-name tool-call)
        tool (find-tool tools tool-name)]
    (if (nil? tool)
      (tool-error-result tool-call (str "Unknown tool: " tool-name))
      (try
        (let [arguments (repair-tool-arguments tool tool-call repair control)]
          (check-operation! control)
          {:tool_call_id (or (:id tool-call) (get tool-call "id") "")
           :tool_name tool-name
           :content ((:execute tool) arguments)
           :is_error false})
        (catch Object e
          (check-operation! control)
          (tool-error-result tool-call (str "Tool error (" tool-name "): " e)))))))

(def ^:private tool-dispatch-window 32)

(defn- execute-tool-calls [tools tool-calls repair control]
  ;; Dispatch calls eagerly from this frame, in bounded windows, so each worker
  ;; inherits the owning operation scope and cancellation reaches it. pmap
  ;; realizes its futures lazily, which detaches them from that scope
  ;; (nooga/let-go#829). Input order is preserved while a window overlaps.
  (into []
        (mapcat (fn [window]
                  (mapv deref
                        (mapv (fn [tool-call]
                                (core/future (execute-tool-call tools tool-call repair control)))
                              window))))
        (partition-all tool-dispatch-window tool-calls)))

(defn- passive-tool-call? [tools tool-call]
  (let [tool (find-tool tools (high-level-tool-name tool-call))]
    (and (some? tool) (nil? (:execute tool)))))

(defn- tool-call-finish? [response]
  (let [reason (:finish_reason response)]
    (= :tool_calls (if (map? reason) (:reason reason) reason))))

(defn- step-result [response tool-results]
  {:text (response-text response)
   :reasoning (:reasoning response)
   :tool_calls (or (:tool_calls response) [])
   :tool_results tool-results
   :finish_reason (:finish_reason response)
   :usage (or (:usage response) {})
   :response response
   :warnings (or (:warnings response) [])})

(defn- generate-result [response tool-results steps total-usage]
  {:text (response-text response)
   :reasoning (:reasoning response)
   :tool_calls (or (:tool_calls response) [])
   :tool_results tool-results
   :finish_reason (:finish_reason response)
   :usage (or (:usage response) {})
   :total_usage total-usage
   :steps steps
   :response response
   :output nil})

(defn add-usage
  "Add standard token fields. Optional counters remain nil when both sides
   are unknown. Raw provider metadata stays on individual steps, not totals."
  [left right]
  (reduce (fn [total key]
            (let [a (get left key) b (get right key)]
              (assoc total key (when (or (some? a) (some? b))
                                 (+ (or a 0) (or b 0))))))
          {:input_tokens (+ (or (:input_tokens left) 0) (or (:input_tokens right) 0))
           :output_tokens (+ (or (:output_tokens left) 0) (or (:output_tokens right) 0))
           :total_tokens (+ (or (:total_tokens left) 0) (or (:total_tokens right) 0))}
          [:reasoning_tokens :cache_read_tokens :cache_write_tokens]))

;; High-level generate API
(defn generate [model prompt & [opts]]
  (let [options (or opts {})
        prompt-present (or (some? prompt) (contains? options :prompt))
        messages-present (contains? options :messages)
        prompt-value (if (some? prompt) prompt (:prompt options))]
    (when (= prompt-present messages-present)
      (throw (ex-info "Exactly one of prompt or messages must be provided"
                      {:category :invalid-request})))
    (let [input-messages (if messages-present
                           (:messages options)
                           [{:role :user :content prompt-value}])
          messages (if (some? (:system options))
                     (vec (cons {:role :system :content (:system options)}
                                input-messages))
                     (vec input-messages))
          request-options
          (dissoc
            (dissoc
              (dissoc
                (dissoc
                  (dissoc
                    (dissoc options :client)
                    :prompt)
                  :system)
                :messages)
              :max_tool_rounds)
            :stop_when)
          request (merge (dissoc request-options :repair_tool_call) {:model model :messages messages})
          client (generation-client options)
          tools (or (:tools options) [])
          max-tool-rounds (max 0 (or (:max_tool_rounds options) 1))
          stop-when (:stop_when options)
          retry-policy (cond-> (or (:retry_policy options) {})
                         (contains? options :max_retries)
                         (assoc :max_retries (:max_retries options)))
          ;; Everything that can reject options runs before the coordinator
          ;; starts, so a construction failure cannot leak it.
          control (owned-control options)
          retry-policy (controlled-retry-policy control retry-policy)
          outcome
          (try
            {:ok
      (loop [conversation messages
             round-number 0
             steps []
             total-usage {}]
        (check-operation! control)
        (let [response (retry
                         (fn []
                           (controlled-invoke
                             control true
                             #(client-complete
                                client
                                (assoc request
                                       :messages conversation
                                       :abort_signal
                                       (combined-abort-signal control)))))
                         retry-policy)
              tool-calls (or (:tool_calls response) [])
              can-execute
              (and (seq tool-calls)
                   (tool-call-finish? response)
                   (< round-number max-tool-rounds)
                   (empty? (filter (fn [call] (passive-tool-call? tools call))
                                   tool-calls)))
              tool-results (if can-execute
                             (controlled-invoke
                               control false
                               #(execute-tool-calls tools tool-calls (:repair_tool_call options) control))
                             [])
              step (step-result response tool-results)
              next-steps (conj steps step)
              next-total (add-usage total-usage (:usage response))
              stop? (and can-execute (some? stop-when) (stop-when next-steps))]
          (check-operation! control)
          (if (and can-execute (not stop?))
            (let [assistant-message
                  (assoc (or (:message response)
                             {:role :assistant :content ""})
                         :role :assistant
                         :tool_calls tool-calls)
                  tool-messages
                  (mapv (fn [result] {:role :tool :content [result]})
                        tool-results)]
              (recur (vec (concat conversation
                                  [assistant-message]
                                  tool-messages))
                     (inc round-number)
                     next-steps
                     next-total))
            (generate-result response tool-results next-steps next-total))))}
            (catch Object error {:error error}))
          ;; The operation is over: cooperative descendants polling the combined
          ;; abort signal must see it before the owner joins them. Cleanup never
          ;; masks the primary failure, but a cleanup error on an otherwise
          ;; successful operation still surfaces.
          _ (elect-terminal! control (if (contains? outcome :error) :error :complete))
          cleanup-error (try (close-owner! control) nil (catch Object e e))]
      (when (contains? outcome :error) (throw (:error outcome)))
      (when cleanup-error (throw cleanup-error))
      (:ok outcome))))

(defn- schema-value [m key]
  (let [string-key (if (keyword? key) (name key) (str key))
        keyword-key (keyword string-key)]
    (cond
      (contains? m key) {:present true :value (get m key)}
      (contains? m string-key) {:present true :value (get m string-key)}
      (contains? m keyword-key) {:present true :value (get m keyword-key)}
      :else {:present false :value nil})))

(defn- schema-type-valid? [value expected]
  (if (sequential? expected)
    (some (fn [candidate] (schema-type-valid? value candidate)) expected)
    (case (if (keyword? expected) (name expected) expected)
      "object" (map? value)
      "array" (vector? value)
      "string" (string? value)
      "integer" (and (number? value)
                     (= (double value) (math/floor (double value))))
      "number" (number? value)
      "boolean" (or (= value true) (= value false))
      "null" (nil? value)
      true)))

(defn- schema-field-entry [schema key]
  (let [string-key (name key)]
    (cond
      (contains? schema key) {:present true :value (get schema key)}
      (contains? schema string-key) {:present true :value (get schema string-key)}
      :else {:present false :value nil})))

(defn- schema-key-name [key]
  (if (keyword? key) (name key) (str key)))

(defn- schema-comparison-value [value]
  ;; JSON has one numeric type. Preserve exact integers rather than rounding
  ;; them through double, while making integral decimal values hash equally.
  (cond
    (integer? value) (bigint value)
    (and (number? value) (= (double value) (math/floor (double value)))) (bigint value)
    (vector? value) (mapv schema-comparison-value value)
    (map? value) (into {} (map (fn [[key child]] [key (schema-comparison-value child)]) value))
    :else value))

(defn- schema-values-equal? [left right]
  (= (schema-comparison-value left) (schema-comparison-value right)))

(defn- resolve-local-schema-ref [root reference]
  (let [reference (when (and (string? reference) (str/starts-with? reference "#"))
                    ;; io/decode uses query decoding; protect literal plus signs
                    ;; because a URI fragment does not use form-space encoding.
                    (try (str "#" (io/decode :url
                                    (str/replace (subs reference 1) "+" "%2B")))
                         (catch Object _ nil)))]
  (cond
    (= reference "#") root
    (and (string? reference) (str/starts-with? reference "#/"))
    (reduce
      (fn [current segment]
        (let [decoded (-> segment
                          (str/replace "~1" "/")
                          (str/replace "~0" "~"))]
          (cond
            (not (re-matches #"(?:[^~]|~[01])*" segment)) nil
            (map? current)
            (let [entry (schema-value current decoded)]
              (when (:present entry) (:value entry)))

            (and (vector? current) (re-matches #"0|[1-9][0-9]*" decoded))
            (let [index (try (parse-long decoded) (catch Object _ nil))]
              (when (and (some? index) (<= 0 index) (< index (count current)))
                (get current index)))

            :else nil)))
      root
      (str/split (subs reference 2) #"/"))
    :else nil)))

(declare validate-json-schema*)

(defn- validate-schema-reference [value schema state reference]
  (let [visit [reference value]]
    (when (contains? (:active_refs state) visit)
      ;; Propagate outside applicator boolean logic: `not` must not turn an
      ;; invalid cyclic schema into successful instance validation.
      (let [reason (str "Cyclic schema reference: " reference)]
        (throw (ex-info reason {:category :cyclic-schema-reference
                               :reason reason :reference reference}))))
    ;; Immutable ancestry is local to this branch and validation call. Repeated
    ;; sibling values and recursive references into smaller values remain valid.
    (validate-json-schema* value schema (update state :active_refs conj visit))))

(defn- validate-schema-list [value schemas root mode]
  (let [results (mapv (fn [candidate]
                        (validate-json-schema* value candidate root))
                      schemas)
        valid-count (count (filter first results))]
    (case mode
      :all (if (= valid-count (count results))
             [true ""]
             (or (first (filter (fn [result] (not (first result))) results))
                 [false "Value does not satisfy allOf"]))
      :any (if (pos? valid-count) [true ""]
             [false "Value does not satisfy anyOf"])
      :one (if (= 1 valid-count) [true ""]
             [false "Value does not satisfy exactly one oneOf schema"]))))

(defn- validate-object-schema [value schema root]
  (let [active-dependencies (fn [entries]
                              (filter (fn [[key _]] (:present (schema-value value key))) entries))
        legacy-dependencies (active-dependencies (field schema :dependencies))
        required (concat (or (field schema :required) [])
                         (mapcat second (active-dependencies (field schema :dependentRequired)))
                         (mapcat second (filter (fn [[_ dependency]] (sequential? dependency))
                                                legacy-dependencies)))
        dependent-schemas (concat (active-dependencies (field schema :dependentSchemas))
                                  (remove (fn [[_ dependency]] (sequential? dependency))
                                          legacy-dependencies))
        dependency-failure
        (first (keep (fn [[key dependency]]
                       (let [[valid? reason] (validate-json-schema* value dependency root)]
                         (when-not valid?
                           [false (str "Dependency of " (schema-key-name key) ": " reason)])))
                     dependent-schemas))
        missing (first (filter (fn [key]
                                 (not (:present (schema-value value key))))
                               required))
        properties (or (field schema :properties) {})
        name-schema (schema-field-entry schema :propertyNames)
        name-failure
        (when (:present name-schema)
          (first (keep (fn [[key _]]
                         (let [property-name (schema-key-name key)
                               [valid? reason]
                               (validate-json-schema* property-name (:value name-schema) root)]
                           (when-not valid?
                             [false (str "Property name " property-name ": " reason)])))
                       value)))
        patterns (mapv (fn [[pattern child-schema]]
                         [(re-pattern (schema-key-name pattern)) child-schema])
                       (or (field schema :patternProperties) {}))
        matching-patterns (fn [key]
                            (filter (fn [[pattern _]]
                                      (some? (re-find pattern (schema-key-name key))))
                                    patterns))
        pattern-entries (mapcat (fn [[key _]]
                                  (map (fn [[_ child-schema]] [key child-schema])
                                       (matching-patterns key)))
                                value)
        property-names (set (map (fn [[key _]] (schema-key-name key))
                                 properties))
        additional-entry (schema-field-entry schema :additionalProperties)
        extra-entries (filter (fn [[key _]]
                                (and (not (contains? property-names
                                                     (schema-key-name key)))
                                     (empty? (matching-patterns key))))
                              value)
        min-properties (field schema :minProperties)
        max-properties (field schema :maxProperties)]
    (cond
      missing [false (str "Missing required property: " missing)]
      dependency-failure dependency-failure
      name-failure name-failure
      (and (number? min-properties) (< (count value) min-properties))
      [false (str "Expected at least " min-properties " properties")]
      (and (number? max-properties) (> (count value) max-properties))
      [false (str "Expected at most " max-properties " properties")]
      (and (:present additional-entry)
           (= false (:value additional-entry))
           (seq extra-entries))
      [false (str "Unexpected property: " (schema-key-name (first (first extra-entries))))]
      :else
      (loop [entries (seq (concat properties pattern-entries))]
        (if (seq entries)
          (let [[key child-schema] (first entries)
                child (schema-value value key)]
            (if-not (:present child)
              (recur (next entries))
              (let [[valid? reason]
                    (validate-json-schema* (:value child) child-schema root)]
                (if valid?
                  (recur (next entries))
                  [false (str "Property " (schema-key-name key) ": " reason)]))))
          (if (and (:present additional-entry)
                   (map? (:value additional-entry)))
            (loop [extras (seq extra-entries)]
              (if (seq extras)
                (let [[key extra-value] (first extras)
                      [valid? reason]
                      (validate-json-schema* extra-value
                                             (:value additional-entry)
                                             root)]
                  (if valid?
                    (recur (next extras))
                    [false (str "Property " (schema-key-name key) ": " reason)]))
                [true ""]))
            [true ""]))))))

(defn- validate-array-schema [value schema root]
  (let [min-items (field schema :minItems)
        max-items (field schema :maxItems)
        unique-items (field schema :uniqueItems)
        item-schema (field schema :items)
        prefix (or (field schema :prefixItems)
                   (when (vector? item-schema) item-schema) [])
        tail-entry (schema-field-entry schema (if (vector? item-schema) :additionalItems :items))
        tail-schema (if (:present tail-entry) (:value tail-entry) true)
        contains-entry (schema-field-entry schema :contains)
        matching-count (when (:present contains-entry)
                         (count (filter (fn [item]
                                          (first (validate-json-schema* item (:value contains-entry) root)))
                                        value)))
        min-contains (or (field schema :minContains) 1)
        max-contains (field schema :maxContains)]
    (cond
      (and (number? min-items) (< (count value) min-items))
      [false (str "Expected at least " min-items " items")]
      (and (number? max-items) (> (count value) max-items))
      [false (str "Expected at most " max-items " items")]
      (and (= true unique-items)
           (not= (count value) (count (distinct (map schema-comparison-value value)))))
      [false "Array items must be unique"]
      (and (:present contains-entry) (< matching-count min-contains))
      [false (str "Expected at least " min-contains " matching items")]
      (and (:present contains-entry) (number? max-contains) (> matching-count max-contains))
      [false (str "Expected at most " max-contains " matching items")]
      :else
      (loop [items (seq value) index 0]
        (if (seq items)
          (let [position-schema (if (< index (count prefix)) (get prefix index) tail-schema)
                [valid? reason]
                (validate-json-schema* (first items) position-schema root)]
            (if valid?
              (recur (next items) (inc index))
              [false (str "Item " index ": " reason)]))
          [true ""])))))

(defn- validate-string-schema [value schema]
  (let [min-length (field schema :minLength)
        max-length (field schema :maxLength)
        pattern (field schema :pattern)]
    (cond
      (and (number? min-length) (< (count value) min-length))
      [false (str "Expected at least " min-length " characters")]
      (and (number? max-length) (> (count value) max-length))
      [false (str "Expected at most " max-length " characters")]
      (and (string? pattern) (nil? (re-find (re-pattern pattern) value)))
      [false (str "String does not match pattern: " pattern)]
      :else [true ""])))

(defn- json-multiple-of? [value divisor]
  (when (and (number? divisor) (pos? divisor))
    (let [quotient (/ (double value) (double divisor))
          nearest (math/round quotient)
          tolerance (min 1.0e-7
                         (max 1.0e-12
                              (* 1.0e-12 (math/abs quotient))))]
      (<= (math/abs (- quotient nearest)) tolerance))))

(defn- validate-number-schema [value schema]
  (let [minimum (field schema :minimum)
        maximum (field schema :maximum)
        exclusive-minimum (field schema :exclusiveMinimum)
        exclusive-maximum (field schema :exclusiveMaximum)
        multiple-of (field schema :multipleOf)]
    (cond
      (and (number? minimum) (< value minimum))
      [false (str "Number is below minimum " minimum)]
      (and (number? maximum) (> value maximum))
      [false (str "Number is above maximum " maximum)]
      (and (number? exclusive-minimum) (<= value exclusive-minimum))
      [false (str "Number must be greater than " exclusive-minimum)]
      (and (number? exclusive-maximum) (>= value exclusive-maximum))
      [false (str "Number must be less than " exclusive-maximum)]
      (and (number? multiple-of) (not (json-multiple-of? value multiple-of)))
      [false (str "Number must be a multiple of " multiple-of)]
      :else [true ""])))

(defn- validate-json-schema* [value schema root]
  (cond
    (= schema true) [true ""]
    (= schema false) [false "Schema rejects this value"]
    (not (map? schema)) [false "Schema must be an object or boolean"]
    :else
    (let [reference-entry (schema-field-entry schema :$ref)
          reference (:value reference-entry)
          resolved (when reference (resolve-local-schema-ref (:document root) reference))
          enum-entry (schema-field-entry schema :enum)
          const-entry (schema-field-entry schema :const)
          expected (field schema :type)
          all-of-entry (schema-field-entry schema :allOf)
          any-of-entry (schema-field-entry schema :anyOf)
          one-of-entry (schema-field-entry schema :oneOf)
          not-entry (schema-field-entry schema :not)
          if-entry (schema-field-entry schema :if)
          immediate-failure
          (cond
            (and (:present reference-entry) (nil? resolved))
            [false (str "Unresolved schema reference: " reference)]
            (and (:present enum-entry)
                 (not (some (fn [candidate] (schema-values-equal? value candidate))
                            (:value enum-entry))))
            [false "Value is not in enum"]
            (and (:present const-entry) (not (schema-values-equal? value (:value const-entry))))
            [false "Value does not match const"]
            (not (schema-type-valid? value expected))
            [false (str "Expected " expected)]
            :else nil)]
      (if immediate-failure
        immediate-failure
        (let [checks
              (concat
                (when (:present if-entry)
                  (let [condition-valid? (first (validate-json-schema* value (:value if-entry) root))
                        branch (schema-field-entry schema (if condition-valid? :then :else))]
                    (when (:present branch)
                      [(validate-json-schema* value (:value branch) root)])))
                (when (:present reference-entry)
                  [(validate-schema-reference value resolved root reference)])
                (when (:present all-of-entry)
                  [(validate-schema-list value (:value all-of-entry) root :all)])
                (when (:present any-of-entry)
                  [(validate-schema-list value (:value any-of-entry) root :any)])
                (when (:present one-of-entry)
                  [(validate-schema-list value (:value one-of-entry) root :one)])
                (when (:present not-entry)
                  [(if (first (validate-json-schema* value (:value not-entry) root))
                     [false "Value matches forbidden not schema"]
                     [true ""])])
                [(cond
                   (map? value) (validate-object-schema value schema root)
                   (vector? value) (validate-array-schema value schema root)
                   (string? value) (validate-string-schema value schema)
                   (number? value) (validate-number-schema value schema)
                   :else [true ""])])
              failed (first (filter (fn [result] (not (first result))) checks))]
          (or failed [true ""]))))))

(defn validate-json-schema [value schema]
  (try
    (validate-json-schema* value schema {:document schema :active_refs #{}})
    (catch Object e
      (if (= :cyclic-schema-reference (:category (ex-data e)))
        [false (:reason (ex-data e))]
        (throw e)))))

(defn- unfenced-json
  "Models without a strict JSON mode often wrap the object in a Markdown code
   fence or lead with prose; parse the fenced block or the outermost object
   when the raw text is not JSON. Valid JSON is returned untouched."
  [text]
  (let [t (str/trim (str text))
        fenced (re-find #"(?s)```(?:json)?\s*(.*?)\s*```" t)
        candidate (if fenced (str/trim (second fenced)) t)
        start (str/index-of candidate "{")
        end (str/last-index-of candidate "}")]
    (cond
      (or (str/starts-with? candidate "{") (str/starts-with? candidate "[")) candidate
      (and start end (< start end)) (subs candidate start (inc end))
      :else candidate)))

(defn- parse-validated-object [text schema]
  (let [parsed (try
                 (try (json/read-json text)
                      (catch Object _ (json/read-json (unfenced-json text))))
                 (catch Object e
                   (throw (ex-info "No object generated: response was not valid JSON"
                                   {:category :no-object-generated
                                    :cause (str e)}))))
        [valid? reason] (validate-json-schema parsed schema)]
    (when-not valid?
      (throw (ex-info (str "No object generated: " reason)
                      {:category :no-object-generated :reason reason})))
    parsed))

(defn generate-object [model prompt schema & [opts]]
  (let [result (generate
                 model prompt
                 (assoc (or opts {})
                        :response_format {:type "json_schema"
                                          :json_schema schema
                                          :strict true}))]
    (assoc result :output (parse-validated-object (:text result) schema))))

(defn- streamed-continuation-messages [conversation response tool-calls tool-results]
  (let [assistant-message
        (assoc (or (:message response)
                   {:role :assistant :content ""})
               :role :assistant
               :tool_calls tool-calls)
        tool-messages
        (mapv (fn [result] {:role :tool :content [result]}) tool-results)]
    (vec (concat conversation [assistant-message] tool-messages))))

(defn- cancellation-error? [error]
  (or (true? (:local_control_error (ex-data error)))
      (= :operation-cancelled (:category (ex-data error)))))

(defn- owner-closed-error? [error]
  (= :operation-closed (:category (ex-data error))))

(defn- safe-stream-tail [events control step-deadline]
  (lazy-seq
    (when-not (= :closed @(:terminal_reason control))
      (try
        (let [remaining
              (controlled-invoke
                control false #(seq events) step-deadline)]
          (if remaining
            (cons (first remaining)
                  (safe-stream-tail (rest remaining) control step-deadline))
            (do
              (reset! (:step_deadline control) nil)
              (close-active-stream! control)
              nil)))
        (catch Object e
          (reset! (:step_deadline control) nil)
          (close-active-stream! control)
          (cond
            (owner-closed-error? e) nil
            (cancellation-error? e) (throw e)
            :else (list {:type :error :error e})))))))

(defn- open-stream-events
  [client request retry-policy control step-deadline]
  (let [result
        (try
          {:opened
           (retry
             (fn []
               (controlled-invoke
                 control false
                 #(let [provider (first (client-provider client request))
                        request (assoc request :register_stream_close
                                       (attempt-close-registration control))
                        ;; The outer guard also handles streams synthesized or
                        ;; truncated by middleware without a terminal adapter.
                        events (seq (terminal-stream-events
                                      (client-stream-with client request
                                        (fn [events routed-provider]
                                          (terminal-stream-events events routed-provider
                                            (fn [] (close-active-stream! control))))) provider
                                      (fn [] (close-active-stream! control))))]
                    (if events
                      {:empty false
                       :first (first events)
                       :rest (lazy-seq (rest events))}
                      {:empty true}))
                 step-deadline))
             retry-policy)}
          (catch Object error {:error error}))]
    (if-let [error (:error result)]
      (do
        (reset! (:step_deadline control) nil)
        (close-active-stream! control)
        (elect-terminal! control :error)
        (close-owner-quietly! control)
        (throw error))
      (let [opened (:opened result)]
        (if (:empty opened)
          (do
            (reset! (:step_deadline control) nil)
            (close-active-stream! control)
            [])
          (cons (:first opened)
                (safe-stream-tail
                  (:rest opened) control step-deadline)))))))

(defn- high-level-stream-events
  [client request conversation tools round-number max-tool-rounds stop-when
   steps retry-policy accumulator control repair]
  (lazy-seq
    (when-not (= :closed @(:terminal_reason control))
      (check-operation! control)
      (let [step-deadline (invocation-deadline control true)
          provider-events
          (open-stream-events
            client
            (assoc request :messages conversation
                           :abort_signal (combined-abort-signal control))
            retry-policy control step-deadline)
          _ (reset! (:step_deadline control) step-deadline)
          observed-events
          (map (fn [event]
                 (stream-accumulator-process! accumulator event))
               provider-events)]
        (concat
        observed-events
        (lazy-seq
          (let [response (stream-accumulator-response accumulator)
                tool-calls (or (:tool_calls response) [])
                can-execute
                (and (seq tool-calls)
                     (nil? (:error @accumulator))
                     (tool-call-finish? response)
                     (< round-number max-tool-rounds)
                     (empty?
                       (filter (fn [call]
                                 (passive-tool-call? tools call))
                               tool-calls)))]
            (if can-execute
              (let [tool-results
                    (controlled-invoke
                      control false
                      #(execute-tool-calls tools tool-calls repair control))
                    step (step-result response tool-results)
                    next-steps (conj steps step)
                    stop? (and (some? stop-when) (stop-when next-steps))
                    step-event {:type :step_finish
                                :step step
                                :step_number (inc round-number)}]
                (when stop?
                  (elect-terminal! control :complete)
                  (close-owner-quietly! control))
                (cons
                  step-event
                  (when-not stop?
                    (high-level-stream-events
                      client request
                      (streamed-continuation-messages
                        conversation response tool-calls tool-results)
                      tools (inc round-number) max-tool-rounds stop-when
                      next-steps retry-policy accumulator control repair))))
              (do
                (elect-terminal! control :complete)
                (close-owner-quietly! control)
                nil)))))))))

(defn high-level-stream [model prompt & [opts]]
  (let [options (or opts {})
        prompt-present (or (some? prompt) (contains? options :prompt))
        messages-present (contains? options :messages)
        prompt-value (if (some? prompt) prompt (:prompt options))]
    (when (= prompt-present messages-present)
      (throw (ex-info "Exactly one of prompt or messages must be provided"
                      {:category :invalid-request})))
    (let [input-messages (if messages-present
                           (:messages options)
                           [{:role :user :content prompt-value}])
          messages (if (some? (:system options))
                     (vec (cons {:role :system :content (:system options)}
                                input-messages))
                     (vec input-messages))
          request-options
          (dissoc
            (dissoc
              (dissoc
                (dissoc
                  (dissoc
                    (dissoc
                      (dissoc
                        (dissoc options :client)
                        :prompt)
                      :system)
                    :messages)
                  :max_tool_rounds)
                :stop_when)
              :retry_policy)
            :max_retries)
          request (merge (dissoc request-options :repair_tool_call) {:model model :messages messages})
          client (generation-client options)
          tools (or (:tools options) [])
          max-tool-rounds (max 0 (or (:max_tool_rounds options) 1))
          retry-policy (cond-> (or (:retry_policy options) {})
                         (contains? options :max_retries)
                         (assoc :max_retries (:max_retries options)))
          accumulator (make-stream-accumulator)
          ;; Option validation precedes the coordinator so it cannot leak.
          control (owned-control options)
          retry-policy (controlled-retry-policy control retry-policy)
          events
          (high-level-stream-events
            client request messages tools 0 max-tool-rounds
            (:stop_when options) [] retry-policy accumulator control (:repair_tool_call options))]
      {:events events
       :text_stream
       (map :delta (filter (fn [event] (= :text_delta (:type event))) events))
       :close (fn [] (close-stream! control))
       :response (fn []
                   (when-let [error (:error @accumulator)] (throw error))
                   (stream-accumulator-response accumulator))
       :partial_response (fn [] (stream-accumulator-response accumulator))})))

;; A map request selects the low-level provider API. A model string selects
;; the high-level streaming API and returns a StreamResult-compatible map.
(defn stream
  ([request]
   (provider-stream request nil))
  ([request-or-model options-or-prompt]
   (if (map? request-or-model)
     (provider-stream request-or-model options-or-prompt)
     (high-level-stream request-or-model options-or-prompt {})))
  ([model prompt options]
   (high-level-stream model prompt options)))

(defn- partial-json-scan [text]
  (let [n (count text)]
    (loop [i 0
           stack []
           in-string? false
           escaped? false
           string-role nil
           string-start nil
           last-significant nil]
      (if (>= i n)
        {:stack stack
         :in_string in-string?
         :escaped escaped?
         :string_role string-role
         :string_start string-start
         :last_significant last-significant}
        (let [ch (subs text i (inc i))]
          (if in-string?
            (cond
              escaped?
              (recur (inc i) stack true false string-role string-start
                     last-significant)

              (= ch "\\")
              (recur (inc i) stack true true string-role string-start
                     last-significant)

              (= ch "\"")
              (recur (inc i) stack false false nil nil "\"")

              :else
              (recur (inc i) stack true false string-role string-start
                     last-significant))
            (cond
              (= ch "\"")
              (let [top (last stack)
                    role (if (and (= top "{")
                                  (or (= last-significant "{")
                                      (= last-significant ",")))
                           :key
                           :value)]
                (recur (inc i) stack true false role i last-significant))

              (or (= ch "{") (= ch "["))
              (recur (inc i) (conj stack ch) false false nil nil ch)

              (or (= ch "}") (= ch "]"))
              (recur (inc i) (if (seq stack) (pop stack) stack)
                     false false nil nil ch)

              (re-matches #"\\s" ch)
              (recur (inc i) stack false false nil nil last-significant)

              :else
              (recur (inc i) stack false false nil nil ch))))))))

(defn- trim-trailing-comma [text]
  (let [trimmed (str/trim text)]
    (if (str/ends-with? trimmed ",")
      (subs trimmed 0 (dec (count trimmed)))
      trimmed)))

(defn- complete-json-token [text]
  (cond
    (str/ends-with? text ":") (str text "null")
    (re-find #"(?:^|[^A-Za-z])tru$" text) (str text "e")
    (re-find #"(?:^|[^A-Za-z])fals$" text) (str text "e")
    (re-find #"(?:^|[^A-Za-z])nul$" text) (str text "l")
    :else text))

(defn- repair-partial-json [text]
  (let [scan (partial-json-scan text)
        key-in-progress (and (:in_string scan)
                             (= :key (:string_role scan)))
        prefix
        (if key-in-progress
          (trim-trailing-comma (subs text 0 (:string_start scan)))
          (let [trimmed (str/trim text)
                without-comma (trim-trailing-comma trimmed)
                without-dangling-escape
                (if (and (:in_string scan) (:escaped scan)
                         (str/ends-with? without-comma "\\"))
                  (subs without-comma 0 (dec (count without-comma)))
                  without-comma)
                with-string-end
                (if (:in_string scan)
                  (str without-dangling-escape "\"")
                  without-dangling-escape)]
            (complete-json-token with-string-end)))
        closers
        (apply str
               (map (fn [opening] (if (= opening "{") "}" "]"))
                    (reverse (:stack scan))))]
    (str prefix closers)))

(def ^:private invalid-partial-value :attractor.llm/invalid-partial-value)

(defn- partial-value-for-schema [value schema]
  (let [expected (field schema :type)]
    (cond
      (= expected "object")
      (if-not (map? value)
        invalid-partial-value
        (let [properties (or (field schema :properties) {})]
          (if (empty? properties)
            value
            (reduce
              (fn [result [key child-value]]
                (let [child-schema (or (get properties key)
                                       (get properties (keyword (str key))))]
                  (if (nil? child-schema)
                    result
                    (let [partial (partial-value-for-schema child-value child-schema)]
                      (if (= invalid-partial-value partial)
                        result
                        (assoc result key partial))))))
              {}
              value))))

      (= expected "array")
      (if-not (vector? value)
        invalid-partial-value
        (if-let [item-schema (field schema :items)]
          (vec (remove (fn [item] (= invalid-partial-value item))
                       (map (fn [item]
                              (partial-value-for-schema item item-schema))
                            value)))
          value))

      (schema-type-valid? value expected) value
      :else invalid-partial-value)))

(defn- parse-partial-object [text schema]
  (try
    (let [parsed (json/read-json (repair-partial-json text))
          partial (partial-value-for-schema parsed schema)]
      (when-not (= invalid-partial-value partial) partial))
    (catch Object _ nil)))

(defn- stream-object-updates [events schema state]
  (mapcat
    (fn [event]
      (case (:type event)
        :stream_start
        (do
          (reset! (:text state) "")
          (reset! (:partial state) nil)
          (reset! (:object state) nil)
          (reset! (:error state) nil)
          [])

        :text_delta
        (let [text (swap! (:text state) str (or (:delta event) ""))
              partial (parse-partial-object text schema)]
          (if (and (some? partial) (not= partial @(:partial state)))
            (do (reset! (:partial state) partial) [partial])
            []))

        :error
        (do (reset! (:error state) (:error event)) [])

        :finish
        (if (= :tool_calls (:finish_reason event))
          []
          (let [final-text (if (some? (:response event))
                             (response-text (:response event))
                             @(:text state))]
            (try
              (let [final-object (parse-validated-object final-text schema)]
                (reset! (:error state) nil)
                (reset! (:object state) final-object)
                (if (= final-object @(:partial state))
                  []
                  (do (reset! (:partial state) final-object) [final-object])))
              (catch Object error
                (reset! (:error state) error)
                []))))

        []))
    events))

(defn stream-object [model prompt schema & [opts]]
  (let [stream-result
        (high-level-stream
          model prompt
          (assoc (or opts {})
                 :response_format {:type "json_schema"
                                   :json_schema schema
                                   :strict true}))
        state {:text (atom "")
               :partial (atom nil)
               :object (atom nil)
               :error (atom nil)}
        objects (stream-object-updates (:events stream-result) schema state)]
    {:objects objects
     :events (:events stream-result)
     :partial_object (fn [] @(:partial state))
     :response (:response stream-result)
     :object
     (fn []
       (doall objects)
       (when-let [error @(:error state)]
         (throw error))
       (or @(:object state)
           (throw (ex-info "No object generated: stream did not finish"
                           {:category :no-object-generated}))))}))
