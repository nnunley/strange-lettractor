(ns attractor.stylesheet
  (:require [clojure.string :as str]))

;; Split string once by separator
(defn- split-once [s sep]
  (let [idx (str/index-of s sep)]
    (if idx
      [(subs s 0 idx) (subs s (+ idx (count sep)))]
      [s ""])))

(defn- syntax-error! [message]
  (throw (ex-info message {:category :stylesheet-syntax})))

;; Delimiters inside quoted strings are data, including escaped quotes.
(defn- declaration-end [text]
  (loop [i 0 quoted? false escaped? false]
    (if (= i (count text))
      (syntax-error! "Unterminated stylesheet rule or string")
      (let [ch (subs text i (inc i))]
        (cond
          escaped? (recur (inc i) quoted? false)
          (and quoted? (= ch "\\")) (recur (inc i) true true)
          (= ch "\"") (recur (inc i) (not quoted?) false)
          (and (not quoted?) (#{";" "}"} ch)) i
          (and (not quoted?) (= ch "{")) (syntax-error! "Unexpected opening brace")
          :else (recur (inc i) quoted? false))))))

(defn- custom-property? [property]
  (boolean (re-matches #"--[a-z][a-z0-9-]*" (name property))))

(defn- property-value [text custom?]
  (if (str/starts-with? text "\"")
    (do
      (when-not (re-matches #"\"(?:\\[\"nt\\]|[^\"\\])*\"" text)
        (syntax-error! "Invalid quoted property value"))
      (loop [i 1 chars []]
        (if (>= i (dec (count text)))
          (apply str chars)
          (let [ch (subs text i (inc i))]
            (if (= ch "\\")
              (let [escaped (subs text (inc i) (+ i 2))]
                (recur (+ i 2) (conj chars (case escaped "n" "\n" "t" "\t" escaped))))
              (recur (inc i) (conj chars ch)))))))
    (if (or (re-matches #"[A-Za-z_][A-Za-z0-9_.:-]*" text)
            (and custom? (re-matches #"[0-9]+" text)))
      text
      (syntax-error! "Invalid or missing property value"))))

(defn- read-declarations [text]
  (loop [remaining (str/trim text) properties {}]
    (let [end (declaration-end remaining)
          declaration (str/trim (subs remaining 0 end))
          delimiter (subs remaining end (inc end))
          [property value] (split-once declaration ":")
          property (keyword (str/trim property))]
      (when-not (or (#{:llm_model :llm_provider :reasoning_effort} property) (custom-property? property))
        (syntax-error! "Expected a model declaration or --custom-property"))
      (let [properties (assoc properties property (property-value (str/trim value) (custom-property? property)))
            tail (str/trim (subs remaining (inc end)))]
        (cond
          (= delimiter "}") [properties tail]
          (str/starts-with? tail "}") [properties (str/trim (subs tail 1))]
          :else (recur tail properties))))))

(defn- read-stylesheet [css-text]
  (loop [remaining (str/trim (or css-text "")) rules []]
    (if (str/blank? remaining)
      rules
      (let [prefix (re-find #"^(?:\*|#[A-Za-z_][A-Za-z0-9_]*|\.[a-z0-9-]+|[A-Za-z_][A-Za-z0-9_]*)\s*\{" remaining)]
        (when-not prefix (syntax-error! "Expected a stylesheet selector and opening brace"))
        (let [selector (str/trim (subs prefix 0 (dec (count prefix))))
              [properties tail] (read-declarations (subs remaining (count prefix)))
              specificity (cond (= selector "*") 0
                                (str/starts-with? selector "#") 3
                                (str/starts-with? selector ".") 2
                                :else 1)]
          (recur tail (conj rules {:selector selector :specificity specificity
                                   :order (count rules) :properties properties})))))))

;; Invalid input yields no rules so transforms cannot partially apply it before
;; the validation phase reports the canonical stylesheet_syntax diagnostic.
(defn parse-stylesheet [css-text]
  (try (read-stylesheet css-text)
       (catch Object error
         (if (= :stylesheet-syntax (:category (ex-data error)))
           []
           (throw error)))))

;; Check if a node matches a stylesheet rule
;; node is a map with :id, :shape, :class
(defn rule-matches-node? [rule node]
  (let [sel (:selector rule)
        shape (or (:shape node) "box")
        node-id (:id node)
        classes (if (str/blank? (:class node))
                  #{}
                  (set (map str/trim (str/split (:class node) #","))))]
    (cond
      (= sel "*") true
      (= sel shape) true
      (str/starts-with? sel "#") (= (subs sel 1) node-id)
      (str/starts-with? sel ".") (contains? classes (subs sel 1))
      :else false)))

;; Resolve model configuration for a specific node given stylesheet rules and graph defaults
;; Resolution precedence:
;; 1. Explicit node attribute
;; 2. Matching stylesheet rule by specificity (ID > class > shape > universal), later rules of equal specificity win
;; 3. Graph-level default attribute
;; 4. System default
(defn resolve-node-model-props [node rules graph-attrs]
  (let [matching-rules (filter (fn [r] (rule-matches-node? r node)) rules)
        ;; Sort matching rules: specificity ascending, order ascending
        sorted-rules (sort-by (juxt :specificity :order) matching-rules)
        ;; Fold matching rules from lowest to highest precedence
        stylesheet-props (reduce (fn [acc r] (merge acc (:properties r))) {} sorted-rules)
        ;; Explicit node attributes (only non-blank)
        explicit-model (when-not (str/blank? (:llm_model node)) (:llm_model node))
        explicit-provider (when-not (str/blank? (:llm_provider node)) (:llm_provider node))
        explicit-reasoning (when-not (str/blank? (:reasoning_effort node)) (:reasoning_effort node))

        final-model (or explicit-model
                        (:llm_model stylesheet-props)
                        (:llm_model graph-attrs)
                        nil)
        final-provider (or explicit-provider
                           (:llm_provider stylesheet-props)
                           (:llm_provider graph-attrs)
                           nil)
        final-reasoning (or explicit-reasoning
                            (:reasoning_effort stylesheet-props)
                            (:reasoning_effort graph-attrs)
                            "high")]
    (merge (into {} (filter (fn [[k _]] (custom-property? k))
                           (merge graph-attrs stylesheet-props (:attrs node))))
    {:llm_model final-model
     :llm_provider final-provider
     :reasoning_effort final-reasoning})))

(defn validate-stylesheet-syntax [css-text]
  (try (read-stylesheet css-text) nil
       (catch Object error
         (if (= :stylesheet-syntax (:category (ex-data error)))
           (ex-message error)
           (throw error)))))
