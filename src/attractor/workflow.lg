(ns attractor.workflow
  (:require [clojure.core :as core]
            [clojure.edn :as edn]
            [clojure.string :as str]
            [hash :as hash]
            [io :as io]
            [os :as os]))

(def root-plan-id "workflow://root")

(defn- not-serializable! [path]
  (throw
    (ex-info "Workflow value cannot be serialized canonically"
             {:category :workflow_not_serializable
              :path path})))

(declare canonical-tree-at)

(defn- canonical-scalar [value path tree]
  (try
    (when-not (= value (edn/read-string (pr-str value)))
      (not-serializable! path))
    tree
    (catch Object _
      (not-serializable! path))))

(defn- canonical-sequence [tag value path]
  [tag
   (mapv (fn [[index nested-value]]
           (canonical-tree-at nested-value (conj path index)))
         (map-indexed vector value))])

(defn- encoded-map-key [key path]
  (try
    (canonical-tree-at key (conj path :map-key))
    (catch ExceptionInfo error
      (if (= :workflow_not_serializable (:category (ex-data error)))
        (not-serializable! (conj path :map-key))
        (throw error)))))

(defn- canonical-map [value path]
  (let [encoded
        (reduce
          (fn [{:keys [pairs key-bytes]} [key nested-value]]
            (let [key-tree (encoded-map-key key path)
                  key-edn (pr-str key-tree)]
              (when (contains? key-bytes key-edn)
                (not-serializable! (conj path :map-key)))
              (let [value-tree (canonical-tree-at nested-value (conj path key))]
                {:pairs (conj pairs
                              {:key-tree key-tree
                               :value-tree value-tree
                               :key-bytes key-edn
                               :value-bytes (pr-str value-tree)})
                 :key-bytes (conj key-bytes key-edn)})))
          {:pairs [] :key-bytes #{}}
          value)
        ordered
        (sort
          (fn [left right]
            (let [key-order (compare (:key-bytes left) (:key-bytes right))]
              (if (zero? key-order)
                (compare (:value-bytes left) (:value-bytes right))
                key-order)))
          (:pairs encoded))]
    ["map" (mapv (fn [entry] [(:key-tree entry) (:value-tree entry)]) ordered)]))

(defn- encoded-set-element [element path]
  (try
    (canonical-tree-at element (conj path :set-element))
    (catch ExceptionInfo error
      (if (= :workflow_not_serializable (:category (ex-data error)))
        (not-serializable! (conj path :set-element))
        (throw error)))))

(defn- canonical-set [value path]
  (let [encoded
        (mapv (fn [element]
                (let [tree (encoded-set-element element path)]
                  {:tree tree :bytes (pr-str tree)}))
              value)
        ordered (sort (fn [left right]
                        (compare (:bytes left) (:bytes right)))
                      encoded)]
    ["set" (mapv :tree ordered)]))

(defn- canonical-tree-at [value path]
  (cond
    (nil? value) (canonical-scalar value path ["nil"])
    (or (true? value) (false? value))
    (canonical-scalar value path ["bool" value])
    (integer? value) (canonical-scalar value path ["int" (str value)])
    (float? value) (if (or (NaN? value) (infinite? value))
                     (not-serializable! path)
                     (canonical-scalar value path
                                       ["decimal" (pr-str value)]))
    (string? value) (canonical-scalar value path ["string" value])
    (keyword? value)
    (canonical-scalar value path ["keyword" (namespace value) (name value)])
    (symbol? value)
    (canonical-scalar value path ["symbol" (namespace value) (name value)])
    (vector? value) (canonical-sequence "vector" value path)
    (list? value) (canonical-sequence "list" value path)
    (map? value) (canonical-map value path)
    (set? value) (canonical-set value path)
    :else (not-serializable! path)))

(defn canonical-tree [value]
  (canonical-tree-at value [:graph]))

(defn canonical-edn [value]
  (pr-str (canonical-tree value)))

(declare decode-canonical-tree snapshot-error!)

(defn- qualified-name [constructor namespace-part local-name]
  (if namespace-part
    (constructor namespace-part local-name)
    (constructor local-name)))

(defn decode-canonical-tree [tree]
  (let [tag (first tree)
        payload (second tree)]
    (case tag
      "nil" nil
      "bool" payload
      "int" (edn/read-string payload)
      "decimal" (edn/read-string payload)
      "string" payload
      "keyword" (qualified-name keyword payload (get tree 2))
      "symbol" (qualified-name symbol payload (get tree 2))
      "vector" (mapv decode-canonical-tree payload)
      "list" (apply list (map decode-canonical-tree payload))
      "map" (reduce (fn [result pair]
                       (assoc result
                              (decode-canonical-tree (first pair))
                              (decode-canonical-tree (second pair))))
                     {}
                     payload)
      "set" (into #{} (map decode-canonical-tree payload))
      (snapshot-error! "Unknown canonical workflow value tag" {:tag tag}))))

(defn sha256-text [text]
  (hash/sha256 text))

(defn plan-fingerprint [graph]
  (sha256-text (canonical-edn graph)))

(defn closure-fingerprint [index]
  (sha256-text (canonical-edn index)))

(defn- configuration-error! [reason data]
  (throw
    (ex-info "Invalid workflow configuration"
             (merge {:category :workflow_configuration_error
                     :option :workflow-roots
                     :reason reason}
                    data))))

(defn- parent-path [path]
  (let [index (str/last-index-of path "/")]
    (cond
      (nil? index) "."
      (zero? index) "/"
      :else (subs path 0 index))))

(defn- root-record [record]
  (when-not (map? record)
    (configuration-error! :invalid-record {:record record}))
  (let [id (:id record)
        path (:path record)]
    (when-not (and (string? id) (not (str/blank? id)))
      (configuration-error! :invalid-id {:record record}))
    (when-not (and (string? path) (not (str/blank? path)))
      (configuration-error! :invalid-path {:id id :path path}))
    {:id id :path (os/canonical-path path)}))

(defn- normalize-roots [roots]
  (when-not (vector? roots)
    (configuration-error! :not-a-vector {:value roots}))
  (:roots
    (reduce
      (fn [{:keys [roots paths-by-id] :as normalized} record]
        (let [{:keys [id path] :as root} (root-record record)]
          (if-let [known-path (get paths-by-id id)]
            (if (= known-path path)
              normalized
              (configuration-error! :duplicate-id {:id id}))
            {:roots (conj roots root)
             :paths-by-id (assoc paths-by-id id path)})))
      {:roots [] :paths-by-id {}}
      roots)))

(defn- default-roots [source-path base-dir]
  (cond
    source-path [{:id "root" :path (parent-path source-path)}]
    base-dir [{:id "root" :path base-dir}]
    :else []))

(defn root-bundle
  "Capture a prepared root graph and exact DOT source as a portable workflow.

   Physical source and root paths are retained for diagnostics and future drift
   checks, but deliberately remain outside the fingerprinted index."
  [source graph options]
  (let [source-path (:source-path options)
        base-dir (:base-dir options)
        roots (normalize-roots
                (if (contains? options :workflow-roots)
                  (:workflow-roots options)
                  (default-roots source-path base-dir)))
        physical-id (when source-path (os/canonical-path source-path))
        source-sha (sha256-text source)
        plan-sha (plan-fingerprint graph)
        references []
        plan {:graph graph
              :plan-sha256 plan-sha
              :source-sha256 source-sha
              :primary-plan-id root-plan-id
              :references references}
        index {:format-version 1
               :root-plan-id root-plan-id
               :sources [{:logical-id root-plan-id
                          :source-sha256 source-sha}]
               :plans [{:logical-id root-plan-id
                        :primary-plan-id root-plan-id
                        :plan-sha256 plan-sha
                        :source-sha256 source-sha
                        :references references}]}]
    {:format-version 1
     :fingerprint (closure-fingerprint index)
     :root-plan-id root-plan-id
     :plans {root-plan-id plan}
     :index index
     :source-records [{:logical-id root-plan-id
                       :physical-id physical-id
                       :source source}]
     :workflow-roots roots}))

(def manifest-relative-path "workflow/manifest.edn")
(def publish-lock-wait-ms 500)
(def publish-lock-poll-ms 5)

(defn- uuid-text []
  (let [printed (str (random-uuid))]
    (or (second (re-find #"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})"
                         printed))
        printed)))

(defn- snapshot-error! [message data]
  (throw (ex-info message (merge {:category :workflow_snapshot_corrupt} data))))

(defn- already-published! [path]
  (throw (ex-info "A different workflow is already published for this run"
                  {:category :workflow_already_published
                   :path path})))

(defn- digest? [value]
  (and (string? value) (some? (re-matches #"[0-9a-f]{64}" value))))

(defn- exact-keys? [value expected]
  (= (set (keys value)) expected))

(defn- records-by-logical-id! [records kind]
  (when-not (vector? records)
    (snapshot-error! "Workflow records must be a vector" {:kind kind}))
  (reduce
    (fn [by-id record]
      (when-not (map? record)
        (snapshot-error! "Workflow record must be a map" {:kind kind}))
      (let [logical-id (:logical-id record)]
        (when-not (and (string? logical-id) (not (str/blank? logical-id)))
          (snapshot-error! "Workflow record has an invalid logical ID"
                           {:kind kind :logical-id logical-id}))
        (when (contains? by-id logical-id)
          (snapshot-error! "Workflow records contain a duplicate logical ID"
                           {:kind kind :logical-id logical-id}))
        (assoc by-id logical-id record)))
    {}
    records))

(defn- validate-index! [index]
  (when-not (map? index)
    (snapshot-error! "Workflow index must be a map" {}))
  (when-not (exact-keys? index #{:format-version :root-plan-id :sources :plans})
    (snapshot-error! "Workflow index has an invalid shape" {}))
  (when-not (= 1 (:format-version index))
    (snapshot-error! "Unsupported workflow index version"
                     {:format-version (:format-version index)}))
  (let [root-id (:root-plan-id index)
        sources (records-by-logical-id! (:sources index) :source-index)
        plans (records-by-logical-id! (:plans index) :plan-index)]
    (when-not (and (string? root-id) (contains? plans root-id))
      (snapshot-error! "Workflow index root plan is missing"
                       {:root-plan-id root-id}))
    (doseq [[logical-id source] sources]
      (when-not (and (exact-keys? source #{:logical-id :source-sha256})
                     (digest? (:source-sha256 source)))
        (snapshot-error! "Workflow source index has an invalid digest"
                         {:logical-id logical-id})))
    (doseq [[logical-id plan] plans]
      (when-not (and (exact-keys? plan #{:logical-id :primary-plan-id
                                         :plan-sha256 :source-sha256 :references})
                     (digest? (:plan-sha256 plan))
                     (digest? (:source-sha256 plan))
                     (string? (:primary-plan-id plan))
                     (vector? (:references plan)))
        (snapshot-error! "Workflow plan index has an invalid shape"
                         {:logical-id logical-id}))
      (when-not (= (:source-sha256 plan)
                   (:source-sha256 (get sources logical-id)))
        (snapshot-error! "Workflow plan source is not bound to its source index"
                         {:logical-id logical-id})))
    {:root-id root-id :sources sources :plans plans}))

(defn- same-logical-ids? [left right]
  (= (set (keys left)) (set (keys right))))

(defn- validate-manifest! [manifest]
  (when-not (map? manifest)
    (snapshot-error! "Workflow manifest must contain an EDN map" {}))
  (when-not (exact-keys? manifest #{:format-version :fingerprint :root-plan-id
                                    :index :sources :plans :workflow-roots})
    (snapshot-error! "Workflow manifest has an invalid shape" {}))
  (when-not (= 1 (:format-version manifest))
    (snapshot-error! "Unsupported workflow manifest version"
                     {:format-version (:format-version manifest)}))
  (let [{:keys [root-id sources plans]} (validate-index! (:index manifest))
        materialized-sources
        (records-by-logical-id! (:sources manifest) :source)
        materialized-plans
        (records-by-logical-id! (:plans manifest) :plan)]
    (when-not (= root-id (:root-plan-id manifest))
      (snapshot-error! "Workflow manifest root differs from its index"
                       {:root-plan-id (:root-plan-id manifest)}))
    (when-not (and (same-logical-ids? sources materialized-sources)
                   (same-logical-ids? plans materialized-plans))
      (snapshot-error! "Workflow manifest records are incomplete" {}))
    (doseq [[logical-id indexed] sources]
      (let [materialized (get materialized-sources logical-id)
            digest (:source-sha256 indexed)
            expected-path (str "workflow/sources/" digest ".dot")]
        (when-not (and (exact-keys? materialized
                                   #{:logical-id :source-sha256 :path :physical-id})
                       (= digest (:source-sha256 materialized))
                       (= expected-path (:path materialized))
                       (or (nil? (:physical-id materialized))
                           (string? (:physical-id materialized))))
          (snapshot-error! "Workflow source materialization does not match its index"
                           {:logical-id logical-id :path (:path materialized)}))))
    (doseq [[logical-id indexed] plans]
      (let [materialized (get materialized-plans logical-id)
            digest (:plan-sha256 indexed)
            expected-path (str "workflow/plans/" digest ".edn")]
        (when-not (and (exact-keys? materialized
                                   #{:logical-id :plan-sha256 :path})
                       (= digest (:plan-sha256 materialized))
                       (= expected-path (:path materialized)))
          (snapshot-error! "Workflow plan materialization does not match its index"
                           {:logical-id logical-id :path (:path materialized)}))))
    {:root-id root-id
     :sources materialized-sources
     :plans materialized-plans}))

(defn- manifest-for [bundle]
  (let [records-by-id
        (reduce (fn [records record]
                  (assoc records (:logical-id record) record))
                {}
                (:source-records bundle))]
    {:format-version (:format-version bundle)
     :fingerprint (:fingerprint bundle)
     :root-plan-id (:root-plan-id bundle)
     :index (:index bundle)
     :sources
     (mapv
       (fn [entry]
         (let [logical-id (:logical-id entry)
               source-sha (:source-sha256 entry)
               record (get records-by-id logical-id)]
           {:logical-id logical-id
            :source-sha256 source-sha
            :path (str "workflow/sources/" source-sha ".dot")
            :physical-id (:physical-id record)}))
       (get-in bundle [:index :sources]))
     :plans
     (mapv
       (fn [entry]
         {:logical-id (:logical-id entry)
          :plan-sha256 (:plan-sha256 entry)
          :path (str "workflow/plans/" (:plan-sha256 entry) ".edn")})
       (get-in bundle [:index :plans]))
     :workflow-roots (:workflow-roots bundle)}))

(defn read-manifest! [manifest-path]
  (when-not (io/file-exists? manifest-path)
    (throw (ex-info "Workflow manifest is missing"
                    {:category :workflow_snapshot_missing
                     :path manifest-path})))
  (try
    (let [manifest (edn/read-string (io/slurp manifest-path))]
      (when-not (map? manifest)
        (snapshot-error! "Workflow manifest must contain an EDN map"
                         {:path manifest-path}))
      manifest)
    (catch ExceptionInfo error
      (throw error))
    (catch Object cause
      (snapshot-error! "Workflow manifest is not valid EDN"
                       {:path manifest-path :cause (str cause)}))))

(defn- verify-file-bytes! [path expected-bytes kind]
  (when-not (io/file-exists? path)
    (throw (ex-info "Workflow snapshot content is missing"
                    {:category :workflow_snapshot_missing
                     :kind kind
                     :path path})))
  (let [actual (io/slurp path)]
    (when-not (= expected-bytes actual)
      (snapshot-error! "Workflow snapshot content does not match its address"
                       {:kind kind :path path})))
  path)

(defn- verify-manifest-files! [run-root manifest]
  (let [{:keys [sources plans]} (validate-manifest! manifest)
        source-records (atom [])]
  (doseq [source (:sources manifest)]
    (let [path (str run-root "/" (:path source))]
      (when-not (io/file-exists? path)
        (throw (ex-info "Workflow source is missing"
                        {:category :workflow_snapshot_missing
                         :kind :source :path path})))
      (let [bytes
            (try
              (io/slurp path)
              (catch Object cause
                (snapshot-error! "Workflow source cannot be read"
                                 {:kind :source :path path :cause (str cause)})))]
      (when-not (= (:source-sha256 source) (sha256-text bytes))
        (snapshot-error! "Workflow source digest does not match"
                         {:kind :source :path path
                          :logical-id (:logical-id source)}))
      (swap! source-records conj {:logical-id (:logical-id source)
                                  :physical-id (:physical-id source)
                                  :source bytes}))))
  (let [verified-plans (reduce
    (fn [verified-plans plan]
      (let [path (str run-root "/" (:path plan))]
        (when-not (io/file-exists? path)
          (throw (ex-info "Workflow plan is missing"
                          {:category :workflow_snapshot_missing
                           :kind :plan :path path})))
        (let [graph
              (try
                (let [bytes (io/slurp path)]
                  (when-not (= (:plan-sha256 plan) (sha256-text bytes))
                    (snapshot-error! "Workflow plan bytes do not match their address"
                                     {:kind :plan :path path
                                      :logical-id (:logical-id plan)}))
                  (decode-canonical-tree (edn/read-string bytes)))
                (catch Object cause
                  (snapshot-error! "Workflow plan is not valid EDN"
                                   {:kind :plan :path path :cause (str cause)})))]
          (when-not (= (:plan-sha256 plan) (plan-fingerprint graph))
            (snapshot-error! "Workflow plan digest does not match"
                             {:kind :plan :path path
                              :logical-id (:logical-id plan)}))
          (assoc verified-plans (:logical-id plan) graph))))
    {}
    (:plans manifest))]
    {:plans verified-plans :source-records @source-records})))

(defn verify-bundle! [bundle graph]
  (when-not (and (map? bundle)
                 (exact-keys? bundle #{:format-version :fingerprint :root-plan-id
                                       :plans :index :source-records
                                       :workflow-roots}))
    (snapshot-error! "Runtime workflow bundle has an invalid shape" {}))
  (when-not (= 1 (:format-version bundle))
    (snapshot-error! "Unsupported workflow format version"
                     {:format-version (:format-version bundle)}))
  (let [{:keys [root-id sources plans]} (validate-index! (:index bundle))]
  (when-not (= (:fingerprint bundle) (closure-fingerprint (:index bundle)))
    (snapshot-error! "Workflow fingerprint does not match its index"
                     {:expected (:fingerprint bundle)}))
  (when-not (= root-id (:root-plan-id bundle))
    (snapshot-error! "Workflow root plan differs from its index"
                     {:root-plan-id (:root-plan-id bundle)}))
  (let [runtime-plans (:plans bundle)
        runtime-sources
        (records-by-logical-id! (:source-records bundle) :runtime-source)]
    (when-not (and (map? runtime-plans)
                   (same-logical-ids? plans runtime-plans)
                   (same-logical-ids? sources runtime-sources))
      (snapshot-error! "Runtime workflow records are incomplete" {}))
    (doseq [[logical-id indexed] sources]
      (let [runtime (get runtime-sources logical-id)]
        (when-not (and (exact-keys? runtime #{:logical-id :physical-id :source})
                       (string? (:source runtime))
                       (= (:source-sha256 indexed)
                          (sha256-text (:source runtime))))
          (snapshot-error! "Runtime workflow source differs from its index"
                           {:logical-id logical-id}))))
    (doseq [[logical-id indexed] plans]
      (let [runtime (get runtime-plans logical-id)]
        (when-not (and (map? runtime)
                       (exact-keys? runtime #{:graph :plan-sha256 :source-sha256
                                              :primary-plan-id :references})
                       (= (:plan-sha256 indexed) (:plan-sha256 runtime))
                       (= (:source-sha256 indexed) (:source-sha256 runtime))
                       (= (:primary-plan-id indexed) (:primary-plan-id runtime))
                       (= (:references indexed) (:references runtime))
                       (= (:plan-sha256 indexed)
                          (plan-fingerprint (:graph runtime))))
          (snapshot-error! "Runtime workflow plan differs from its index"
                           {:logical-id logical-id}))))
  (let [plan (get runtime-plans root-id)]
    (when-not plan
      (snapshot-error! "Workflow root plan is missing" {:root-plan-id root-id}))
    (when-not (= graph (:graph plan))
      (snapshot-error! "Prepared graph does not match the workflow root plan"
                       {:root-plan-id root-id}))
    (when-not (= (:plan-sha256 plan) (plan-fingerprint (:graph plan)))
      (snapshot-error! "Workflow root plan digest does not match"
                       {:root-plan-id root-id})))
  bundle)))

(defn verify-published! [run-root expected-fingerprint]
  (let [manifest-path (str run-root "/" manifest-relative-path)
        manifest (read-manifest! manifest-path)
        {:keys [root-id]} (validate-manifest! manifest)]
    (when-not (= (:fingerprint manifest)
                 (closure-fingerprint (:index manifest)))
      (snapshot-error! "Workflow manifest fingerprint does not match its index"
                       {:path manifest-path}))
    (when-not (= expected-fingerprint (:fingerprint manifest))
      (snapshot-error! "Workflow fingerprint does not match the expected run"
                       {:path manifest-path
                        :expected expected-fingerprint
                        :actual (:fingerprint manifest)}))
    (let [contents (verify-manifest-files! run-root manifest)
          verified-plans (:plans contents)
          bundle {:format-version (:format-version manifest)
                  :fingerprint (:fingerprint manifest)
                  :root-plan-id root-id
                  :index (:index manifest)
                  :workflow-roots (:workflow-roots manifest)
                  :source-records (:source-records contents)
                  :plans (reduce
                           (fn [plans entry]
                             (assoc plans (:logical-id entry)
                                    (assoc (dissoc entry :logical-id)
                                           :graph (get verified-plans (:logical-id entry)))))
                           {} (get-in manifest [:index :plans]))}]
      {:graph (get verified-plans root-id)
       :diagnostics []
       :captured-bundle bundle
       :workflow manifest})))

(defn- unreadable-drift [record path]
  {:logical-id (:logical-id record)
   :state :unreadable
   :expected-sha256 (:source-sha256 record)
   :path path})

(defn- current-source-change [record root-plan-id options]
  (let [logical-id (:logical-id record)
        recorded-path (:physical-id record)
        override? (and (= logical-id root-plan-id)
                       (contains? options :current-source-path))
        selected-path (if override?
                        (:current-source-path options)
                        recorded-path)
        expected (:source-sha256 record)]
    ;; An in-memory workflow has no current file to compare. Its captured bytes
    ;; remain fully verified by verify-published! and it is not drift by itself.
    (when (and (string? selected-path) (not (str/blank? selected-path)))
      (if-not (io/file-exists? selected-path)
        {:logical-id logical-id
         :state :missing
         :expected-sha256 expected
         :path selected-path}
        (let [resolved
              (try
                (os/canonical-path selected-path)
                (catch Object _ nil))]
          (if (nil? resolved)
            (unreadable-drift record selected-path)
            (let [bytes
                  (try
                    {:value (io/slurp resolved)}
                    (catch Object _ {:unreadable true}))]
              (if (:unreadable bytes)
                (unreadable-drift record resolved)
                (let [actual (sha256-text (:value bytes))]
                  (if (not= expected actual)
                    {:logical-id logical-id
                     :state :changed
                     :expected-sha256 expected
                     :actual-sha256 actual
                     :path resolved}
                    (when override?
                      (let [recorded-resolved
                            (try
                              (when (and (string? recorded-path)
                                         (not (str/blank? recorded-path))
                                         (io/file-exists? recorded-path))
                                (os/canonical-path recorded-path))
                              (catch Object _ nil))]
                        (when (not= recorded-resolved resolved)
                          {:logical-id logical-id
                           :state :relocated
                           :expected-sha256 expected
                           :actual-sha256 actual
                           :path resolved})))))))))))))

(defn current-drift
  "Compare a published manifest's physical source records with current files.

   The returned records are diagnostic evidence only; captured source and plan
   bytes remain the sole execution inputs. :current-source-path applies only to
   the root plan, and :check-current? false disables all filesystem reads."
  ([manifest] (current-drift manifest {}))
  ([manifest options]
   (when (and (contains? options :current-source-path)
              (not (and (string? (:current-source-path options))
                        (not (str/blank? (:current-source-path options))))))
     (throw
       (ex-info "Invalid :current-source-path; expected a nonblank string"
                {:category :workflow_configuration_error
                 :option :current-source-path
                 :value (:current-source-path options)})))
   (if (= false (:check-current? options))
     []
     (->> (:sources manifest)
          (map #(current-source-change % (:root-plan-id manifest) options))
          (remove nil?)
          (sort-by :logical-id)
          vec))))

(defn- publish-content! [target bytes kind]
  (if (io/file-exists? target)
    (verify-file-bytes! target bytes kind)
    (let [temp-path (str target ".tmp-" (uuid-text))]
      (try
        (io/spit temp-path bytes)
        (os/rename temp-path target)
        target
        (catch Object cause
          (when (io/file-exists? temp-path)
            (io/delete-file temp-path))
          (throw cause))))))

(defn- verify-existing-publication! [bundle run-root manifest-path]
  (let [expected (manifest-for bundle)
        expected-bytes (pr-str expected)
        actual-bytes (io/slurp manifest-path)]
    (when-not (= expected-bytes actual-bytes)
      (already-published! manifest-path))
    (verify-manifest-files! run-root (edn/read-string actual-bytes))
    manifest-path))

(defn- acquire-publication-lock! [lock-dir manifest-path]
  (let [deadline (+ (System/currentTimeMillis) publish-lock-wait-ms)]
    (loop []
      (if (io/file-exists? manifest-path)
        :published
        (let [lock-result (os/sh "mkdir" lock-dir)]
          (cond
            (zero? (:exit lock-result)) :acquired
            (io/file-exists? manifest-path) :published
            (>= (System/currentTimeMillis) deadline)
            (throw (ex-info "Workflow publication lock remained incomplete"
                            {:category :workflow_publication_incomplete
                             :path lock-dir
                             :wait-ms publish-lock-wait-ms}))
            :else
            (do
              (core/sleep publish-lock-poll-ms)
              (recur))))))))

(defn publish!
  "Publish an immutable workflow bundle below run-root and return its manifest.

   Content-addressed source and plan files are committed before manifest.edn.
   The manifest is the only durable publication boundary."
  [bundle run-root]
  (verify-bundle! bundle
                  (get-in bundle [:plans (:root-plan-id bundle) :graph]))
  (let [workflow-dir (str run-root "/workflow")
        source-dir (str workflow-dir "/sources")
        plan-dir (str workflow-dir "/plans")
        lock-dir (str workflow-dir "/.publish.lock")
        manifest-path (str workflow-dir "/manifest.edn")
        expected-manifest (manifest-for bundle)]
    (if (io/file-exists? manifest-path)
      (verify-existing-publication! bundle run-root manifest-path)
      (do
        (io/mkdir workflow-dir)
        (let [lock-state (acquire-publication-lock! lock-dir manifest-path)]
          (if (= :published lock-state)
            (verify-existing-publication! bundle run-root manifest-path)
            (try
              (if (io/file-exists? manifest-path)
                (verify-existing-publication! bundle run-root manifest-path)
                (do
                  (io/mkdir source-dir)
                  (io/mkdir plan-dir)
                  (let [records-by-id
                        (reduce (fn [records record]
                                  (assoc records (:logical-id record) record))
                                {}
                                (:source-records bundle))]
                    (doseq [entry (:sources expected-manifest)]
                      (let [record (get records-by-id (:logical-id entry))]
                        (publish-content!
                          (str run-root "/" (:path entry))
                          (:source record)
                          :source)))
                    (doseq [entry (:plans expected-manifest)]
                      (publish-content!
                        (str run-root "/" (:path entry))
                        (canonical-edn
                          (get-in bundle [:plans (:logical-id entry) :graph]))
                        :plan))
                  (publish-content! manifest-path (pr-str expected-manifest) :manifest)
                  manifest-path)))
              (finally
                (when (io/file-exists? lock-dir)
                  (io/delete-file lock-dir))))))))))
