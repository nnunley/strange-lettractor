(ns attractor.workflow
  (:require [clojure.edn :as edn]
            [clojure.string :as str]
            [hash :as hash]
            [io :as io]
            [os :as os]))

(def root-plan-id "workflow://root")

(defn- not-serializable! [path]
  (throw
    (ex-info "Workflow value cannot be serialized canonically"
             {:category :workflow_not_serializable
              :path path})))

(declare canonical-tree-at)

(defn- canonical-scalar [value path tree]
  (try
    (when-not (= value (edn/read-string (pr-str value)))
      (not-serializable! path))
    tree
    (catch Object _
      (not-serializable! path))))

(defn- canonical-sequence [tag value path]
  [tag
   (mapv (fn [[index nested-value]]
           (canonical-tree-at nested-value (conj path index)))
         (map-indexed vector value))])

(defn- encoded-map-key [key path]
  (try
    (canonical-tree-at key (conj path :map-key))
    (catch ExceptionInfo error
      (if (= :workflow_not_serializable (:category (ex-data error)))
        (not-serializable! (conj path :map-key))
        (throw error)))))

(defn- canonical-map [value path]
  (let [encoded
        (reduce
          (fn [{:keys [pairs key-bytes]} [key nested-value]]
            (let [key-tree (encoded-map-key key path)
                  key-edn (pr-str key-tree)]
              (when (contains? key-bytes key-edn)
                (not-serializable! (conj path :map-key)))
              (let [value-tree (canonical-tree-at nested-value (conj path key))]
                {:pairs (conj pairs
                              {:key-tree key-tree
                               :value-tree value-tree
                               :key-bytes key-edn
                               :value-bytes (pr-str value-tree)})
                 :key-bytes (conj key-bytes key-edn)})))
          {:pairs [] :key-bytes #{}}
          value)
        ordered
        (sort
          (fn [left right]
            (let [key-order (compare (:key-bytes left) (:key-bytes right))]
              (if (zero? key-order)
                (compare (:value-bytes left) (:value-bytes right))
                key-order)))
          (:pairs encoded))]
    ["map" (mapv (fn [entry] [(:key-tree entry) (:value-tree entry)]) ordered)]))

(defn- encoded-set-element [element path]
  (try
    (canonical-tree-at element (conj path :set-element))
    (catch ExceptionInfo error
      (if (= :workflow_not_serializable (:category (ex-data error)))
        (not-serializable! (conj path :set-element))
        (throw error)))))

(defn- canonical-set [value path]
  (let [encoded
        (mapv (fn [element]
                (let [tree (encoded-set-element element path)]
                  {:tree tree :bytes (pr-str tree)}))
              value)
        ordered (sort (fn [left right]
                        (compare (:bytes left) (:bytes right)))
                      encoded)]
    ["set" (mapv :tree ordered)]))

(defn- canonical-tree-at [value path]
  (cond
    (nil? value) (canonical-scalar value path ["nil"])
    (or (true? value) (false? value))
    (canonical-scalar value path ["bool" value])
    (integer? value) (canonical-scalar value path ["int" (str value)])
    (float? value) (if (or (NaN? value) (infinite? value))
                     (not-serializable! path)
                     (canonical-scalar value path
                                       ["decimal" (pr-str value)]))
    (string? value) (canonical-scalar value path ["string" value])
    (keyword? value)
    (canonical-scalar value path ["keyword" (namespace value) (name value)])
    (symbol? value)
    (canonical-scalar value path ["symbol" (namespace value) (name value)])
    (vector? value) (canonical-sequence "vector" value path)
    (list? value) (canonical-sequence "list" value path)
    (map? value) (canonical-map value path)
    (set? value) (canonical-set value path)
    :else (not-serializable! path)))

(defn canonical-tree [value]
  (canonical-tree-at value [:graph]))

(defn canonical-edn [value]
  (pr-str (canonical-tree value)))

(declare decode-canonical-tree snapshot-error!)

(defn- qualified-name [constructor namespace-part local-name]
  (if namespace-part
    (constructor namespace-part local-name)
    (constructor local-name)))

(defn decode-canonical-tree [tree]
  (let [tag (first tree)
        payload (second tree)]
    (case tag
      "nil" nil
      "bool" payload
      "int" (edn/read-string payload)
      "decimal" (edn/read-string payload)
      "string" payload
      "keyword" (qualified-name keyword payload (get tree 2))
      "symbol" (qualified-name symbol payload (get tree 2))
      "vector" (mapv decode-canonical-tree payload)
      "list" (apply list (map decode-canonical-tree payload))
      "map" (reduce (fn [result pair]
                       (assoc result
                              (decode-canonical-tree (first pair))
                              (decode-canonical-tree (second pair))))
                     {}
                     payload)
      "set" (into #{} (map decode-canonical-tree payload))
      (snapshot-error! "Unknown canonical workflow value tag" {:tag tag}))))

(defn sha256-text [text]
  (hash/sha256 text))

(defn plan-fingerprint [graph]
  (sha256-text (canonical-edn graph)))

(defn closure-fingerprint [index]
  (sha256-text (canonical-edn index)))

(defn- configuration-error! [reason data]
  (throw
    (ex-info "Invalid workflow configuration"
             (merge {:category :workflow_configuration_error
                     :option :workflow-roots
                     :reason reason}
                    data))))

(defn- parent-path [path]
  (let [index (str/last-index-of path "/")]
    (cond
      (nil? index) "."
      (zero? index) "/"
      :else (subs path 0 index))))

(defn- root-record [record]
  (when-not (map? record)
    (configuration-error! :invalid-record {:record record}))
  (let [id (:id record)
        path (:path record)]
    (when-not (and (string? id) (not (str/blank? id)))
      (configuration-error! :invalid-id {:record record}))
    (when-not (and (string? path) (not (str/blank? path)))
      (configuration-error! :invalid-path {:id id :path path}))
    {:id id :path (os/canonical-path path)}))

(defn- normalize-roots [roots]
  (when-not (vector? roots)
    (configuration-error! :not-a-vector {:value roots}))
  (:roots
    (reduce
      (fn [{:keys [roots paths-by-id] :as normalized} record]
        (let [{:keys [id path] :as root} (root-record record)]
          (if-let [known-path (get paths-by-id id)]
            (if (= known-path path)
              normalized
              (configuration-error! :duplicate-id {:id id}))
            {:roots (conj roots root)
             :paths-by-id (assoc paths-by-id id path)})))
      {:roots [] :paths-by-id {}}
      roots)))

(defn- default-roots [source-path base-dir]
  (cond
    source-path [{:id "root" :path (parent-path source-path)}]
    base-dir [{:id "root" :path base-dir}]
    :else []))

(defn root-bundle
  "Capture a prepared root graph and exact DOT source as a portable workflow.

   Physical source and root paths are retained for diagnostics and future drift
   checks, but deliberately remain outside the fingerprinted index."
  [source graph options]
  (let [source-path (:source-path options)
        base-dir (:base-dir options)
        roots (normalize-roots
                (if (contains? options :workflow-roots)
                  (:workflow-roots options)
                  (default-roots source-path base-dir)))
        physical-id (when source-path (os/canonical-path source-path))
        source-sha (sha256-text source)
        plan-sha (plan-fingerprint graph)
        references []
        plan {:graph graph
              :plan-sha256 plan-sha
              :source-sha256 source-sha
              :primary-plan-id root-plan-id
              :references references}
        index {:format-version 1
               :root-plan-id root-plan-id
               :sources [{:logical-id root-plan-id
                          :source-sha256 source-sha}]
               :plans [{:logical-id root-plan-id
                        :primary-plan-id root-plan-id
                        :plan-sha256 plan-sha
                        :source-sha256 source-sha
                        :references references}]}]
    {:format-version 1
     :fingerprint (closure-fingerprint index)
     :root-plan-id root-plan-id
     :plans {root-plan-id plan}
     :index index
     :source-records [{:logical-id root-plan-id
                       :physical-id physical-id
                       :source source}]
     :workflow-roots roots}))

(def manifest-relative-path "workflow/manifest.edn")

(defn- uuid-text []
  (let [printed (str (random-uuid))]
    (or (second (re-find #"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})"
                         printed))
        printed)))

(defn- snapshot-error! [message data]
  (throw (ex-info message (merge {:category :workflow_snapshot_corrupt} data))))

(defn- already-published! [path]
  (throw (ex-info "A different workflow is already published for this run"
                  {:category :workflow_already_published
                   :path path})))

(defn- manifest-for [bundle]
  (let [records-by-id
        (reduce (fn [records record]
                  (assoc records (:logical-id record) record))
                {}
                (:source-records bundle))]
    {:format-version (:format-version bundle)
     :fingerprint (:fingerprint bundle)
     :root-plan-id (:root-plan-id bundle)
     :index (:index bundle)
     :sources
     (mapv
       (fn [entry]
         (let [logical-id (:logical-id entry)
               source-sha (:source-sha256 entry)
               record (get records-by-id logical-id)]
           {:logical-id logical-id
            :source-sha256 source-sha
            :path (str "workflow/sources/" source-sha ".dot")
            :physical-id (:physical-id record)}))
       (get-in bundle [:index :sources]))
     :plans
     (mapv
       (fn [entry]
         {:logical-id (:logical-id entry)
          :plan-sha256 (:plan-sha256 entry)
          :path (str "workflow/plans/" (:plan-sha256 entry) ".edn")})
       (get-in bundle [:index :plans]))
     :workflow-roots (:workflow-roots bundle)}))

(defn read-manifest! [manifest-path]
  (when-not (io/file-exists? manifest-path)
    (throw (ex-info "Workflow manifest is missing"
                    {:category :workflow_snapshot_missing
                     :path manifest-path})))
  (try
    (let [manifest (edn/read-string (io/slurp manifest-path))]
      (when-not (map? manifest)
        (snapshot-error! "Workflow manifest must contain an EDN map"
                         {:path manifest-path}))
      manifest)
    (catch ExceptionInfo error
      (throw error))
    (catch Object cause
      (snapshot-error! "Workflow manifest is not valid EDN"
                       {:path manifest-path :cause (str cause)}))))

(defn- verify-file-bytes! [path expected-bytes kind]
  (when-not (io/file-exists? path)
    (throw (ex-info "Workflow snapshot content is missing"
                    {:category :workflow_snapshot_missing
                     :kind kind
                     :path path})))
  (let [actual (io/slurp path)]
    (when-not (= expected-bytes actual)
      (snapshot-error! "Workflow snapshot content does not match its address"
                       {:kind kind :path path})))
  path)

(defn- verify-manifest-files! [run-root manifest]
  (doseq [source (:sources manifest)]
    (let [path (str run-root "/" (:path source))
          bytes (io/slurp path)]
      (when-not (= (:source-sha256 source) (sha256-text bytes))
        (snapshot-error! "Workflow source digest does not match"
                         {:kind :source :path path
                          :logical-id (:logical-id source)}))))
  (doseq [plan (:plans manifest)]
    (let [path (str run-root "/" (:path plan))]
      (when-not (io/file-exists? path)
        (throw (ex-info "Workflow plan is missing"
                        {:category :workflow_snapshot_missing
                         :kind :plan :path path})))
      (let [graph
            (try
              (decode-canonical-tree (edn/read-string (io/slurp path)))
              (catch Object cause
                (snapshot-error! "Workflow plan is not valid EDN"
                                 {:kind :plan :path path :cause (str cause)})))]
        (when-not (= (:plan-sha256 plan) (plan-fingerprint graph))
          (snapshot-error! "Workflow plan digest does not match"
                           {:kind :plan :path path
                            :logical-id (:logical-id plan)})))))
  manifest)

(defn verify-bundle! [bundle graph]
  (when-not (= 1 (:format-version bundle))
    (snapshot-error! "Unsupported workflow format version"
                     {:format-version (:format-version bundle)}))
  (when-not (= (:fingerprint bundle)
               (closure-fingerprint (:index bundle)))
    (snapshot-error! "Workflow fingerprint does not match its index"
                     {:expected (:fingerprint bundle)}))
  (let [root-id (:root-plan-id bundle)
        plan (get-in bundle [:plans root-id])]
    (when-not plan
      (snapshot-error! "Workflow root plan is missing" {:root-plan-id root-id}))
    (when-not (= graph (:graph plan))
      (snapshot-error! "Prepared graph does not match the workflow root plan"
                       {:root-plan-id root-id}))
    (when-not (= (:plan-sha256 plan) (plan-fingerprint (:graph plan)))
      (snapshot-error! "Workflow root plan digest does not match"
                       {:root-plan-id root-id})))
  bundle)

(defn verify-published! [run-root expected-fingerprint]
  (let [manifest-path (str run-root "/" manifest-relative-path)
        manifest (read-manifest! manifest-path)]
    (when-not (= 1 (:format-version manifest))
      (snapshot-error! "Unsupported workflow manifest version"
                       {:path manifest-path
                        :format-version (:format-version manifest)}))
    (when-not (= (:fingerprint manifest)
                 (closure-fingerprint (:index manifest)))
      (snapshot-error! "Workflow manifest fingerprint does not match its index"
                       {:path manifest-path}))
    (when-not (= expected-fingerprint (:fingerprint manifest))
      (snapshot-error! "Workflow fingerprint does not match the expected run"
                       {:path manifest-path
                        :expected expected-fingerprint
                        :actual (:fingerprint manifest)}))
    (verify-manifest-files! run-root manifest)
    (let [root-id (:root-plan-id manifest)
          plan-record (first (filter #(= root-id (:logical-id %))
                                     (:plans manifest)))]
      (when-not plan-record
        (snapshot-error! "Workflow root plan is absent from the manifest"
                         {:path manifest-path :root-plan-id root-id}))
      {:graph (decode-canonical-tree
                (edn/read-string
                  (io/slurp (str run-root "/" (:path plan-record)))))
       :diagnostics []
       :workflow manifest})))

(defn- publish-content! [target bytes kind]
  (if (io/file-exists? target)
    (verify-file-bytes! target bytes kind)
    (let [temp-path (str target ".tmp-" (uuid-text))]
      (try
        (io/spit temp-path bytes)
        (os/rename temp-path target)
        target
        (catch Object cause
          (when (io/file-exists? temp-path)
            (io/delete-file temp-path))
          (throw cause))))))

(defn- verify-existing-publication! [bundle run-root manifest-path]
  (let [expected (manifest-for bundle)
        actual (read-manifest! manifest-path)]
    (when-not (= expected actual)
      (already-published! manifest-path))
    (verify-manifest-files! run-root actual)
    manifest-path))

(defn publish!
  "Publish an immutable workflow bundle below run-root and return its manifest.

   Content-addressed source and plan files are committed before manifest.edn.
   The manifest is the only durable publication boundary."
  [bundle run-root]
  (verify-bundle! bundle
                  (get-in bundle [:plans (:root-plan-id bundle) :graph]))
  (let [workflow-dir (str run-root "/workflow")
        source-dir (str workflow-dir "/sources")
        plan-dir (str workflow-dir "/plans")
        lock-dir (str workflow-dir "/.publish.lock")
        manifest-path (str workflow-dir "/manifest.edn")
        expected-manifest (manifest-for bundle)]
    (if (io/file-exists? manifest-path)
      (verify-existing-publication! bundle run-root manifest-path)
      (do
        (io/mkdir workflow-dir)
        (let [lock-result (os/sh "mkdir" lock-dir)]
          (if-not (zero? (:exit lock-result))
            (if (io/file-exists? manifest-path)
              (verify-existing-publication! bundle run-root manifest-path)
              (throw (ex-info "Workflow publication lock exists without a manifest"
                              {:category :workflow_publication_incomplete
                               :path lock-dir}))))
            (try
              (if (io/file-exists? manifest-path)
                (verify-existing-publication! bundle run-root manifest-path)
                (do
                  (io/mkdir source-dir)
                  (io/mkdir plan-dir)
                  (let [records-by-id
                        (reduce (fn [records record]
                                  (assoc records (:logical-id record) record))
                                {}
                                (:source-records bundle))]
                    (doseq [entry (:sources expected-manifest)]
                      (let [record (get records-by-id (:logical-id entry))]
                        (publish-content!
                          (str run-root "/" (:path entry))
                          (:source record)
                          :source)))
                    (doseq [entry (:plans expected-manifest)]
                      (publish-content!
                        (str run-root "/" (:path entry))
                        (canonical-edn
                          (get-in bundle [:plans (:logical-id entry) :graph]))
                        :plan))
                  (publish-content! manifest-path (pr-str expected-manifest) :manifest)
                  manifest-path)))
              (finally
                (when (io/file-exists? lock-dir)
                  (io/delete-file lock-dir)))))))))
