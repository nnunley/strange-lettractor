(ns attractor.cli
  (:require [clojure.string :as str]
            [os :as os]
            [io :as io]
            [attractor.parser :as parser]
            [attractor.pipeline :as pipeline]
            [attractor.context :as context]
            [attractor.handlers :as handlers]
            [attractor.interviewer :as interviewer]
            [attractor.server :as server]
            [attractor.llm :as llm]
            [attractor.fan-in-llm :as fanin-llm]
            [attractor.agent :as agent]
            [attractor.agents.registry :as registry]
            [attractor.agents.backend :as backend]
            [attractor.hub :as hub]
            [attractor.console.session :as session]
            [attractor.console.line :as line]
            [attractor.console.tui :as tui]
            [attractor.dotenv :as dotenv]
            [attractor.ids :as ids]
            [attractor.providers :as providers]
            [clojure.core :as core]))

(defn- find-arg-val [args flag]
  (loop [rem args]
    (cond
      (empty? rem) nil
      (= (first rem) flag) (second rem)
      :else (recur (rest rem)))))

(def ^:private agent-option-flags
  #{"--prompt-file" "--cwd" "--model" "--tools" "--timeout-ms" "--permission-mode"
    "--sandbox" "--approval-policy" "--env-file"})

(defn- agent-options
  "Options for one external agent job. The agent is named explicitly (claude,
   codex); nothing is assumed when the name is absent."
  [agent-name args]
  (let [agent (registry/resolve-agent (or agent-name
                                          (throw (ex-info (str "agent name is required; available: "
                                                               (str/join ", " (registry/agent-names)))
                                                          {:category :configuration_error}))))
        mode (or (find-arg-val args "--permission-mode") "plan")
        tools (or (find-arg-val args "--tools") "Read")
        sandbox (or (find-arg-val args "--sandbox") "read-only")
        approval (or (find-arg-val args "--approval-policy") "never")
        raw-timeout (find-arg-val args "--timeout-ms")
        timeout (if raw-timeout (parse-long raw-timeout) 120000)]
    (when-not (contains? #{"plan" "acceptEdits" "dontAsk"} mode)
      (throw (ex-info "Unsupported permission mode" {:category :configuration_error})))
    (when-not (contains? #{"read-only" "workspace-write" "danger-full-access"} sandbox)
      (throw (ex-info "Unsupported sandbox" {:category :configuration_error})))
    (when-not (contains? #{"never" "on-request" "untrusted"} approval)
      (throw (ex-info "Unsupported approval policy" {:category :configuration_error})))
    (when-not (and (integer? timeout) (pos? timeout))
      (throw (ex-info "--timeout-ms must be a positive integer" {:category :configuration_error})))
    {:agent agent
     :working_dir (or (find-arg-val args "--cwd") (os/cwd))
     :model (find-arg-val args "--model")
     :tools (if (str/blank? tools) [] (mapv str/trim (str/split tools #",")))
     :permission_mode mode :sandbox sandbox :approval_policy approval :timeout_ms timeout
     :on_event (fn [event] (prn event))}))

(defn- hub-call!
  "Submit one hub request from the CLI and unwrap its reply."
  [hub op fields]
  (let [reply (deref (hub/request! hub (merge {:id (ids/uuid-text) :op op} fields))
                     30000 {:error {:category :request-timeout :message (str (name op) " timed out")}})]
    (if-let [error (:error reply)]
      (throw (ex-info (or (:message error) (str (name op) " failed"))
                      (assoc error :category (or (:category error) :hub-error))))
      (:value reply))))

(defn- pump-events!
  "Attach to the hub log and deliver every envelope to `on-envelope` in
   emission order until `completion` is realized, draining once more after
   it so trailing events are not lost. Returns the completion value."
  [hub completion on-envelope]
  (let [client (hub-call! hub :client/attach {})]
    (try
      (loop [cursor (:cursor client) final? false]
        (let [{:keys [events] next-cursor :cursor}
              (hub/events-since hub (:client_id client) cursor)]
          (doseq [envelope events] (on-envelope envelope))
          (cond
            final? (deref completion)
            (realized? completion) (recur next-cursor true)
            :else (do (core/sleep 20) (recur next-cursor false)))))
      (finally
        (try (hub-call! hub :client/detach {:client_id (:client_id client)})
             (catch Object _ nil))))))

(declare make-codergen-backend-from-args make-fan-in-ranker-from-args console-session-options)

(defn- workflow-hub
  "Every CLI command owns an in-process hub built the same way: workflow
   handler registries come from the hub's request (auto-approve or the
   hub-bound interviewer), the codergen backend and fan-in ranker from args."
  [args]
  (hub/start! {:session_options (console-session-options args)
               :workflow_registry_fn
               (fn [request]
                 (handlers/make-handler-registry
                   (if (:auto_approve request)
                     (interviewer/make-auto-approve-interviewer)
                     (:interviewer request))
                   (make-codergen-backend-from-args args)
                   {:fan-in-ranker (make-fan-in-ranker-from-args args)}))}))

(defn- with-hub
  "Run `f` with a hub started from `args` (a function of args, or nil for a
   bare hub) and stop the hub afterwards."
  [args f]
  (let [hub (if (fn? args) (hub/start! {}) (workflow-hub args))]
    (try
      (f hub)
      (finally
        (deref (hub/request! hub {:id "cli-stop" :op :hub/stop}) 10000 nil)))))

(defn- answer-questions-from-stdin!
  "Hub questions for a CLI-owned run are answered on this process's stdin
   through the console interviewer, then delivered back to the hub. Answer
   values are sent as text, the same contract the console uses."
  [hub stdin-interviewer]
  (fn [envelope]
    (when (= :question (:source envelope))
      (let [event (:event envelope)]
        (case (:type event)
          :question
          (let [answer (interviewer/ask stdin-interviewer (:question event))
                value (:value answer)
                text (if (keyword? value) (name value) (str (or (:text answer) value)))]
            (hub-call! hub :question/answer {:question_id (:question_id envelope) :value text :text text}))
          :inform (println (str "[" (:stage event) "] " (:message event)))
          nil)))))

(defn cmd-agent
  "agent <name> --prompt-file <file> [options]"
  [args]
  (let [exit-code
        (try
          (let [[agent-name & options] args]
            (when (or (str/blank? agent-name) (str/starts-with? (str agent-name) "--"))
              (throw (ex-info (str "usage: agent <" (str/join "|" (registry/agent-names)) "> --prompt-file <file>")
                              {:category :configuration_error})))
            (loop [remaining options]
              (when (seq remaining)
                (when-not (and (contains? agent-option-flags (first remaining))
                               (some? (second remaining)))
                  (throw (ex-info "Expected named option and value; use --prompt-file <file>"
                                  {:category :configuration_error})))
                (recur (drop 2 remaining))))
            (let [opts (agent-options agent-name options) path (find-arg-val options "--prompt-file")]
              (when (str/blank? path)
                (throw (ex-info "--prompt-file is required" {:category :configuration_error})))
              ;; The job is submitted to an in-process hub like every other
              ;; command; its events are the hub's agent envelopes, printed as
              ;; EDN in emission order.
              (with-hub (fn [_] nil)
                (fn [hub]
                  (let [started (hub-call! hub :agent/run
                                  (assoc (dissoc opts :agent :on_event) :agent (:agent opts) :prompt (io/slurp path)))
                        result (pump-events! hub (:completion started)
                                 (fn [envelope]
                                   (when (= :agent (:source envelope)) (prn (:event envelope)))))]
                    (when-let [error (:error result)]
                      (throw (ex-info (:message error) (dissoc error :message))))
                    0)))))
          (catch Object error
            (prn {:source :agent :type :error
                  :error (merge (select-keys (ex-data error) [:stderr :exit_code])
                                {:category (or (:category (ex-data error)) :agent-error)
                                 :message (ex-message error)})})
            1))]
    (os/exit exit-code)))

(defn- live-provider-configured?
  "Any registry provider with a key in the environment, or a chat-completions
   provider with a base URL (local servers need no key)."
  []
  (boolean (some (fn [row] (or (:key_present row)
                               (and (= :openai-chat-completions (:protocol row)) (:base_url row))))
                 (providers/effective))))

(defn- make-codergen-backend-from-args [args]
  (when (and (some #{"--agent"} args) (str/blank? (find-arg-val args "--agent")))
    (throw (ex-info "--agent requires a name" {:category :configuration_error})))
  (if-let [agent-name (find-arg-val args "--agent")]
    (let [agent (registry/resolve-agent agent-name)]
      (when (some #{"--mock"} args)
        (throw (ex-info "--agent cannot be combined with --mock" {:category :configuration_error})))
      (backend/make-backend agent (dissoc (agent-options agent-name args) :agent)))
  (let [force-mock? (some #{"--mock"} args)
        has-keys? (live-provider-configured?)
        use-live-llm? (and (not force-mock?) (or (some #{"--llm"} args) has-keys?))
        override-model (find-arg-val args "--model")
        override-provider (find-arg-val args "--provider")]
    (if use-live-llm?
      (agent/make-agent-codergen-backend
        {:session_options_fn
         (fn [node]
           (let [raw-model (or override-model (:llm_model node)
                               "claude-3-7-sonnet")
                 parsed (llm/parse-model-spec
                          raw-model (or override-provider (:llm_provider node)))]
             {:model (str (:provider parsed) "/" (:model parsed))
              :reasoning_effort (:reasoning_effort node)}))})
      nil))))

(defn- make-fan-in-ranker-from-args [args]
  (if (some #{"--mock"} args)
    (fn [_]
      (throw (ex-info
               "Prompted fan-in requires a real or injected ranker; --mock disables live ranking"
               {:category :configuration_error :retryable false})))
    (let [model (find-arg-val args "--model")
          provider (find-arg-val args "--provider")]
      (fanin-llm/make-ranker
        (cond-> {}
          (some? model) (assoc :model_override model)
          (some? provider) (assoc :provider_override provider))))))

(defn- live-llm-requested? [args]
  ;; Same gate as run/resume: --mock forces mock; otherwise --llm or any
  ;; configured provider credential selects a live model.
  (and (not (some #{"--mock"} args))
       (or (some #{"--llm"} args)
           (live-provider-configured?))))

(defn- console-session-options [args]
  ;; Trusted startup configuration for hub-owned agent sessions, resolved the
  ;; way run/resume resolve the codergen model.
  (if-not (live-llm-requested? args)
    {:model "mock/default"}
    (let [override-model (find-arg-val args "--model")
          override-provider (find-arg-val args "--provider")
          parsed (llm/parse-model-spec (or override-model "claude-3-7-sonnet") override-provider)]
      {:model (str (:provider parsed) "/" (:model parsed))})))

(defn- running-work [hub]
  (let [ask (fn [op] (:value (deref (hub/request! hub {:id (str "console-" (name op)) :op op}) 2000 {})))]
    (concat (map #(str "session " (:session_id %)) (filter :busy (ask :session/list)))
            (map #(str "run " (:run_id %)) (remove :done (ask :workflow/list)))
            (map #(str (name (or (:agent %) :agent)) " job " (:agent_id %)) (remove :done (ask :agent/list))))))

(defn cmd-console [args]
  (let [agent-defaults (cond-> {:working_dir (or (find-arg-val args "--agent-cwd") (os/cwd))}
                         (find-arg-val args "--agent-model") (assoc :model (find-arg-val args "--agent-model"))
                         (find-arg-val args "--agent-tools") (assoc :tools (str/split (find-arg-val args "--agent-tools") #","))
                         (find-arg-val args "--agent-permission-mode") (assoc :permission_mode (find-arg-val args "--agent-permission-mode"))
                         (find-arg-val args "--agent-sandbox") (assoc :sandbox (find-arg-val args "--agent-sandbox"))
                         (find-arg-val args "--agent-timeout-ms") (assoc :timeout_ms (parse-long (find-arg-val args "--agent-timeout-ms"))))
        ;; Human gates are hub questions answered from the console; the stdin
        ;; interviewer is never used here.
        hub (workflow-hub args)
        aliases (into {} (keep (fn [[flag value]] (when (= flag "--alias")
                                                     (let [[name expansion] (str/split (str value) #"=" 2)]
                                                       (when (and (seq name) (seq expansion)) [name expansion]))))
                               (partition 2 1 args)))
        console (session/open! hub {:agent_defaults agent-defaults
                                    :run_defaults {:auto_approve (boolean (some #{"--auto-approve"} args))}
                                    :aliases aliases})
        outcome (try
                  (if (some #{"--tui"} args)
                    (tui/run! console {})
                    (line/run! console {}))
                  :ok
                  (catch Object e
                    (println (str "console failed: " (ex-message e)))
                    :failed)
                  (finally (session/close! console)))]
    ;; The console process owns this in-process hub, so exiting stops it. Say
    ;; so when that cancels work the client was told would keep running.
    (let [running (running-work hub)]
      (when (seq running)
        (println (str "stopping the in-process hub cancels: " (str/join ", " running)))))
    (deref (hub/request! hub {:id "console-stop" :op :hub/stop}) 10000 nil)
    (os/exit (if (= :ok outcome) 0 1))))

(defn print-usage []
  (println "Attractor - Workflow Orchestration Engine for Multi-Stage LLM Pipelines")
  (println "")
  (println "Usage: attractor <command> [options] [args]")
  (println "")
  (println "Commands:")
  (println "  run <dotfile> [--logs-root <dir>] [--auto-approve]   Execute a DOT pipeline")
  (println "  validate <dotfile>                                  Validate pipeline structure & syntax")
  (println "  graph <dotfile>                                     Inspect graph nodes, edges, and flow")
  (println "  resume [dotfile] --checkpoint <path>                Resume pipeline from checkpoint")
  (println "  serve [--port <port>]                               Start HTTP management server")
  (println "  models [--provider <p>] [--base-url <u>]             List available models from provider API")
  (println "  providers                                           Show the effective provider registry (attractor.edn)")
  (println (str "  agent <" (str/join "|" (registry/agent-names)) "> --prompt-file <file>          Run one external agent job, EDN events"))
  (println "    [--cwd <dir>] [--model <m>] [--timeout-ms <ms>] [--tools Read,Edit] [--permission-mode plan|acceptEdits|dontAsk]")
  (println "    [--sandbox read-only|workspace-write|danger-full-access] [--approval-policy never|on-request|untrusted]")
  (println "    DOT run/resume accept --agent <name> with the same options")
  (println "  console [--tui] [--mock|--llm] [--model <provider/name>] [--alias name=expansion]")
  (println "                                                      Interactive console: chat, : eval, /run, /agent <name>")
  (println "  clean [--all]                                       Clean execution artifacts, logs, and checkpoints")
  (println "  help                                                Show this help message")
  (println ""))

(defn format-validation-diagnostic [diagnostic]
  (let [prefix (case (:severity diagnostic)
                 :error "[ERROR]"
                 :warning "[WARN]"
                 :info "[INFO]")
        target (or (:node_id diagnostic)
                   (when (:edge diagnostic)
                     (str/join " -> " (:edge diagnostic)))
                   "")]
    (str "  " prefix " [" (:rule diagnostic) "] "
         (when (seq target) (str target ": "))
         (:message diagnostic))))

(defn cmd-validate [args]
  (let [dot-file (first args)]
    (if (str/blank? dot-file)
      (do
        (println "Error: Please provide a DOT file to validate.")
        (print-usage)
        (os/exit 1))
      (if-not (os/stat dot-file)
        (do
          (println (str "Error: File '" dot-file "' does not exist."))
          (os/exit 1))
        (try
          (let [dot-content (io/slurp dot-file)
                prepared (pipeline/prepare dot-content {:source-path dot-file})
                graph (:graph prepared)
                diags (:diagnostics prepared)]
            (if (empty? diags)
              (do
                (println (str "✓ Pipeline '" (:id graph) "' is valid (0 errors, 0 warnings)."))
                (println (str "  Nodes: " (count (:nodes graph)) ", Edges: " (count (:edges graph)))))
              (let [errors (filter (fn [d] (= (:severity d) :error)) diags)
                    warnings (filter (fn [d] (= (:severity d) :warning)) diags)]
                (println (str "Validation results for '" (:id graph) "': "
                              (count errors) " error(s), " (count warnings) " warning(s)"))
                (doseq [d diags]
                  (println (format-validation-diagnostic d)))
                (if (seq errors)
                  (os/exit 1)
                  (os/exit 0)))))
          (catch Object e
            (println (str "Error parsing or validating pipeline: " e))
            (os/exit 1)))))))

(defn cmd-graph [args]
  (let [dot-file (first args)]
    (if (or (str/blank? dot-file) (not (os/stat dot-file)))
      (do
        (println "Error: Valid DOT file required.")
        (os/exit 1))
      (let [prepared (pipeline/prepare (io/slurp dot-file) {:source-path dot-file})
            graph (:graph prepared)
            start-node (parser/find-start-node graph)
            exit-node (parser/find-exit-node graph)]
        (println (str "Pipeline Graph: " (:id graph)))
        (println (str "  Goal: " (or (:goal graph) "(none)")))
        (println (str "  Start Node: " (if start-node (first start-node) "NONE")))
        (println (str "  Exit Node:  " (if exit-node (first exit-node) "NONE")))
        (println (str "  Total Nodes: " (count (:nodes graph))))
        (println (str "  Total Edges: " (count (:edges graph))))
        (println "\nNodes:")
        (doseq [[nid n] (:nodes graph)]
          (println (str "  * " nid " [shape=" (:shape n)
                        (when (:type n) (str " type=" (:type n)))
                        (when (:label n) (str " label=\"" (:label n) "\""))
                        (when (:goal_gate n) " (goal_gate)")
                        "]")))
        (println "\nEdges:")
        (doseq [e (:edges graph)]
          (println (str "  * " (:from e) " -> " (:to e)
                        (when (seq (:condition e)) (str " [condition=\"" (:condition e) "\"]"))
                        (when (seq (:label e)) (str " [label=\"" (:label e) "\"]"))
                        (when (> (:weight e) 0) (str " [weight=" (:weight e) "]")))))))))

(defn- run-through-hub!
  "Submit a workflow run or resume to a CLI-owned hub, render its workflow
   events with `on-event`, answer its questions on stdin and return the
   pipeline outcome. An error raised by the pipeline is rethrown with its
   category and retryable flag, exactly as a direct call would have thrown."
  [args op request on-event]
  (with-hub args
    (fn [hub]
      (let [stdin (interviewer/make-console-interviewer)
            questions (answer-questions-from-stdin! hub stdin)
            started (hub-call! hub op request)
            result (pump-events! hub (:completion started)
                     (fn [envelope]
                       (case (:source envelope)
                         :workflow (on-event (:event envelope))
                         :question (questions envelope)
                         nil)))]
        (if-let [error (:error result)]
          (throw (ex-info (or (:message error) "workflow failed") (dissoc error :message)))
          (:value result))))))

(defn cmd-run [args]
  (let [dot-file (first args)]
    (if (or (str/blank? dot-file) (not (os/stat dot-file)))
      (do
        (println "Error: Valid DOT file required.")
        (os/exit 1))
      (let [auto-approve? (boolean (some #{"--auto-approve"} args))
            custom-root (find-arg-val args "--logs-root")
            logs-root (or custom-root (str "attractor_runs/run_" (System/currentTimeMillis)))
            on-event (fn [ev]
                       (case (:type ev)
                         :pipeline.started
                         (println (str "▶ Pipeline started: " (:id ev) " | Goal: " (:goal ev)))
                         :stage.started
                         (println (str "  • Stage '" (:node_id ev) "' started (attempt " (:attempt ev) ")"))
                         :stage.completed
                         (println (str "  ✓ Stage '" (:node_id ev) "' completed -> " (:status ev)))
                         :stage.failed
                         (println (str "  ✗ Stage '" (:node_id ev) "' failed!"))
                         :stage.retrying
                         (println (str "  ⟳ Retrying stage '" (:node_id ev) "' after " (:delay_ms ev) "ms..."))
                         :checkpoint.saved
                         (println (str "    [checkpoint saved]"))
                         :goal_gate.retrying
                         (println (str "  ⚠ Goal gate unsatisfied for '" (:unsatisfied_node ev) "', jumping to retry target '" (:target ev) "'"))
                         :pipeline.completed
                         (println (str "✔ Pipeline successfully completed in " (:duration_steps ev) " steps!"))
                         :pipeline.failed
                         (println (str "✖ Pipeline failed: " (:error ev)))
                         nil))
            outcome (run-through-hub! args :workflow/run
                      {:dot_source (io/slurp dot-file) :logs_root logs-root
                       :source_path dot-file :auto_approve auto-approve?}
                      on-event)]
        (println (str "\nExecution finished with status: " (:status outcome)))
        (println (str "Artifacts and checkpoints saved in: " logs-root))
        (if (= (:status outcome) :success)
          (os/exit 0)
          (os/exit 1))))))

(defn cmd-resume [args]
  (let [first-arg (first args)
        dot-file (when (and (string? first-arg)
                            (not (str/starts-with? first-arg "--")))
                   first-arg)
        cp-path (find-arg-val args "--checkpoint")]
    (if (or (str/blank? cp-path) (not (os/stat cp-path)))
      (do
        (println "Error: Valid --checkpoint path required.")
        (os/exit 1))
      (let [outcome (run-through-hub! args :workflow/resume
                      (cond-> {:checkpoint_path cp-path :auto_approve false}
                        (not (str/blank? dot-file)) (assoc :current_source_path dot-file))
                      (fn [_] nil))]
        (doseq [diagnostic (:diagnostics outcome)]
          (println (format-validation-diagnostic diagnostic)))
        (println (str "Resumed execution finished with status: " (:status outcome)))
        (if (= (:status outcome) :success)
          (os/exit 0)
          (os/exit 1))))))

(defn cmd-serve [args]
  (let [port (or (find-arg-val args "--port") ":7070")]
    (server/start-server port)))

(defn cmd-clean [args]
  (let [all? (some #{"--all" "-a"} args)
        dirs-to-clean ["attractor_runs" "smoke_test_run_dir"]
        extra-dirs (if all? ["bin"] [])
        targets (concat dirs-to-clean extra-dirs)]
    (println "Cleaning pipeline execution artifacts and logs...")
    (doseq [d targets]
      (when (os/stat d)
        (os/sh "rm" "-rf" d)
        (println (str "  ✓ Removed " d "/"))))
    (when (os/stat ".nrepl-port")
      (os/sh "rm" "-f" ".nrepl-port")
      (println "  ✓ Removed .nrepl-port"))
    (println "Cleanup complete.")
    (os/exit 0)))

(defn cmd-providers
  "providers: show the effective provider registry with each value's source."
  [_]
  (println "Providers (built-ins, then ~/.config/attractor/attractor.edn, then ./attractor.edn or ATTRACTOR_CONFIG):")
  (doseq [row (try (providers/effective)
                   (catch Object error
                     (if (= :configuration (:category (ex-data error)))
                       (do (println (str "Error: " (ex-message error))) (os/exit 1))
                       (throw error))))]
    (println (str "  " (:id row)))
    (println (str "    protocol:        " (name (:protocol row)) "  [" (if (keyword? (:source row)) (name (:source row)) (:source row)) "]"))
    (println (str "    base_url:        " (or (:base_url row) "(unset)")
                  "  [" (name (:base_url_source row)) "]"))
    (println (str "    api_key_env:     " (str/join ", " (:api_key_env row))
                  (case (:key_source row)
                    :environment "  [key present in environment]"
                    :file "  [key held in config file]"
                    "  [no key]")))
    (println (str "    model_discovery: " (:model_discovery row))))
  (os/exit 0))

(defn cmd-models [args]
  (let [provider (or (find-arg-val args "--provider")
                     ;; First configured provider that can be queried: has a key
                     ;; (or is a local chat-completions server) and allows discovery.
                     (some (fn [row] (when (and (:model_discovery row)
                                                (or (:key_present row)
                                                    (and (= :openai-chat-completions (:protocol row)) (:base_url row))))
                                       (:id row)))
                           (providers/effective))
                     "openai")
        base-url (find-arg-val args "--base-url")
        api-key (find-arg-val args "--api-key")]
    (let [outcome (try
                    (println (str "Querying models from " provider " (" (llm/resolve-base-url provider base-url) ")..."))
                    (let [models (llm/fetch-models provider {:base_url base-url :api_key api-key})]
                      (if (seq models)
                        (do
                          (println (str "Found " (count models) " available model(s):"))
                          (doseq [m (sort models)]
                            (println (str "  • " m))))
                        (println "No models found or request failed. Check your API key and base URL."))
                      0)
                    (catch Object error
                      (if (= :configuration (:category (ex-data error)))
                        (do (println (str "Error: " (ex-message error))) 1)
                        (throw error))))]
      (os/exit outcome))))

;; CLI Entry Point
(defn -main [& args]
  (let [raw (or (seq args) (seq *command-line-args*) [])
        clean-args (if (= (first raw) "--") (vec (rest raw)) (vec raw))
        env-path (find-arg-val clean-args "--env-file")
        _ (dotenv/load-dotenv! env-path)
        cmd (first clean-args)
        rest-args (vec (rest clean-args))]
    (case cmd
      "run" (cmd-run rest-args)
      "validate" (cmd-validate rest-args)
      "lint" (cmd-validate rest-args)
      "graph" (cmd-graph rest-args)
      "resume" (cmd-resume rest-args)
      "serve" (cmd-serve rest-args)
      "clean" (cmd-clean rest-args)
      "cleanup" (cmd-clean rest-args)
      "models" (cmd-models rest-args)
      "providers" (cmd-providers rest-args)
      "agent" (cmd-agent rest-args)
      "console" (cmd-console rest-args)
      "help" (print-usage)
      nil (print-usage)
      (do
        (println (str "Unknown command: " cmd))
        (print-usage)
        (os/exit 1)))))
