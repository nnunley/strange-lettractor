(ns attractor.context
  (:require [clojure.string :as str]
            [clojure.edn :as edn]
            [clojure.core :as core]
            [json :as json]
            [io :as io]
            [os :as os]
            [attractor.status :as status]))

;; Default file-backing threshold: 100KB
(def file-backing-threshold (* 100 1024))

;; Create a new Context
(defn make-context
  ([] (make-context {}))
  ([initial-values]
   (atom {:values (or initial-values {})
          :logs []})))

;; Get a context value
(defn ctx-get
  ([ctx key] (ctx-get ctx key nil))
  ([ctx key default-val]
   (let [vals (:values @ctx)
         k-str (str key)
         k-kw (keyword k-str)]
     (cond
       (contains? vals k-str) (get vals k-str)
       (contains? vals k-kw) (get vals k-kw)
       :else default-val))))

;; Get a context value as string
(defn ctx-get-string
  ([ctx key] (ctx-get-string ctx key ""))
  ([ctx key default-val]
   (let [v (ctx-get ctx key nil)]
     (if (nil? v) default-val (str v)))))

;; Set a context value
(defn ctx-set! [ctx key val]
  (let [k-str (str key)]
    (swap! ctx update :values assoc k-str val)
    val))

;; Apply a map of updates to the context
(defn ctx-apply-updates! [ctx updates]
  (when (seq updates)
    (swap! ctx update :values
           (fn [vals]
             (reduce (fn [acc [k v]] (assoc acc (str k) v)) vals updates))))
  ctx)

;; Append a log entry
(defn ctx-append-log! [ctx entry]
  (swap! ctx update :logs conj (str entry))
  ctx)

(defn- restart-bookkeeping-key? [key]
  (let [key-name
        (cond
          (string? key) key
          (and (keyword? key) (nil? (namespace key))) (name key)
          :else nil)]
    (and key-name
         (or (contains? #{"run.id" "current_node" "outcome" "preferred_label"}
                        key-name)
             (str/starts-with? key-name "internal.retry_count.")))))

(defn ctx-reset-for-restart!
  "Remove run-segment bookkeeping while retaining the context atom, semantic
  values (including their identities), and accumulated logs."
  [ctx]
  (swap! ctx update :values
         (fn [values]
           (into {}
                 (remove (fn [[key _]] (restart-bookkeeping-key? key))
                         values))))
  ctx)

(defn- unsupported-context-value! [path]
  (throw (ex-info "Context contains a value that cannot round-trip through EDN"
                  {:category :unsupported-context-value
                   :path path})))

(defn- copy-context-value [value path]
  (cond
    (map? value)
    (reduce (fn [copied [key nested-value]]
              (let [key-path (conj path :map-key)
                    copied-key
                    (try
                      (copy-context-value key key-path)
                      (catch Object error
                        (if (= :unsupported-context-value
                               (:category (ex-data error)))
                          (unsupported-context-value! key-path)
                          (throw error))))]
                (assoc copied
                       copied-key
                       (copy-context-value nested-value (conj path key)))))
            {}
            value)

    (vector? value)
    (reduce (fn [copied [index nested-value]]
              (conj copied
                    (copy-context-value nested-value (conj path index))))
            []
            (map-indexed vector value))

    (list? value)
    (apply list
           (map-indexed
             (fn [index nested-value]
               (copy-context-value nested-value (conj path index)))
             value))

    (set? value)
    (reduce (fn [copied member]
              (let [member-path (conj path :set-member)
                    copied-member
                    (try
                      (copy-context-value member member-path)
                      (catch Object error
                        (if (= :unsupported-context-value
                               (:category (ex-data error)))
                          (unsupported-context-value! member-path)
                          (throw error))))]
                (conj copied copied-member)))
            (hash-set)
            value)

    :else
    (try
      (let [copied (edn/read-string (pr-str value))]
        (if (= value copied)
          copied
          (unsupported-context-value! path)))
      (catch Object error
        (if (= :unsupported-context-value (:category (ex-data error)))
          (throw error)
          (unsupported-context-value! path))))))

;; Deep snapshot of context values
(defn ctx-snapshot [ctx]
  (copy-context-value (:values @ctx) [:values]))

;; Deep clone of context (for parallel branch isolation)
(defn ctx-clone [ctx]
  (let [cur @ctx]
    (atom {:values (copy-context-value (:values cur) [:values])
           :logs (copy-context-value (:logs cur) [:logs])})))

;; Mirror graph attributes into context at initialization (Section 3.2 & 5.1)
(defn mirror-graph-attributes! [graph ctx]
  (when (:goal graph)
    (ctx-set! ctx "graph.goal" (:goal graph)))
  (when (:id graph)
    (ctx-set! ctx "graph.id" (:id graph)))
  (when (:label graph)
    (ctx-set! ctx "graph.label" (:label graph)))
  (when (:attrs graph)
    (doseq [[k v] (:attrs graph)]
      (ctx-set! ctx (str "graph." (name k)) v)))
  ctx)

;; Fidelity resolution order (Section 5.4):
;; 1. Edge fidelity attribute
;; 2. Target node fidelity attribute
;; 3. Graph default_fidelity attribute
;; 4. Default fallback: "compact"
(defn resolve-fidelity [incoming-edge target-node graph]
  (or (when (and incoming-edge (not (str/blank? (:fidelity incoming-edge))))
        (:fidelity incoming-edge))
      (when (and target-node (not (str/blank? (:fidelity target-node))))
        (:fidelity target-node))
      (when (not (str/blank? (:default_fidelity graph)))
        (:default_fidelity graph))
      "compact"))

;; Thread key resolution for "full" fidelity session reuse (Section 5.4):
;; 1. Target node thread_id attribute
;; 2. Incoming edge thread_id attribute
;; 3. Graph-level thread_id
;; 4. Enclosing subgraph derived class
;; 5. Fallback: previous node ID
(defn resolve-thread-id [incoming-edge target-node graph prev-node-id]
  (or (when (and target-node (not (str/blank? (:thread_id target-node))))
        (:thread_id target-node))
      (when (and incoming-edge (not (str/blank? (:thread_id incoming-edge))))
        (:thread_id incoming-edge))
      (when (not (str/blank? (get-in graph [:attrs :thread_id])))
        (get-in graph [:attrs :thread_id]))
      (when (and target-node
                 (not (str/blank? (:subgraph_class target-node))))
        (:subgraph_class target-node))
      (str prev-node-id)))

;; Synthesize context carryover text based on fidelity mode
(defn synthesize-context-preamble [fidelity-mode graph ctx completed-nodes node-outcomes]
  (let [goal (or (:goal graph) (ctx-get-string ctx "graph.goal" ""))
        completed-count (count completed-nodes)]
    (case fidelity-mode
      "truncate"
      (str "Pipeline Goal: " goal "\n"
           "Run ID: " (ctx-get-string ctx "run.id" "") "\n")

      "summary:low"
      (let [stages-str (str/join ", " completed-nodes)]
        (str "Pipeline Goal: " goal "\nCompleted stages: " stages-str "\nTotal completed: " completed-count "\n"))

      "summary:medium"
      (let [lines (map (fn [nid]
                         (let [out (get node-outcomes nid)]
                           (str "- Stage '" nid "': outcome=" (:status out)
                                (when (:notes out) (str ", notes=" (:notes out))))))
                       completed-nodes)]
        (str "Pipeline Goal: " goal "\nRecent stage outcomes:\n"
             (str/join "\n" lines) "\n"
             "Key Context:\n"
             (str/join "\n" (map (fn [[k v]] (str "  " k ": " (subs (str v) 0 (min (count (str v)) 100))))
                                 (take 10 (:values @ctx)))) "\n"))

      "summary:high"
      (let [lines (map (fn [nid]
                         (let [out (get node-outcomes nid)]
                           (str "- Stage '" nid "': outcome=" (:status out)
                                (when (:preferred_label out) (str ", preferred_label=" (:preferred_label out)))
                                (when (:notes out) (str ", notes=" (:notes out))))))
                       completed-nodes)]
        (str "Pipeline Goal: " goal "\nComprehensive stage history:\n"
             (str/join "\n" lines) "\n"
             "Context Values:\n"
             (str/join "\n" (map (fn [[k v]] (str "  " k " = " v)) (:values @ctx))) "\n"))

      ;; "compact" (default)
      (let [lines (map (fn [nid]
                         (let [out (get node-outcomes nid)]
                           (str "* Stage [" nid "] -> " (:status out))))
                       completed-nodes)
            key-context
            (map (fn [[key value]] (str "* " key ": " value))
                 (take 10 (:values @ctx)))]
        (str "Goal: " goal "\nCompleted Stages:\n"
             (str/join "\n" lines) "\n"
             "Last stage: " (ctx-get-string ctx "last_stage" "none") "\n"
             "Key Context:\n" (str/join "\n" key-context) "\n")))))

;; Create an ArtifactStore
(defn make-artifact-store [base-dir]
  (atom {:base-dir base-dir
         :artifacts {}
         :lock (atom false)}))

(defn- acquire-artifact-lock! [lock]
  (loop []
    (when-not (compare-and-set! lock false true)
      (core/sleep 1)
      (recur))))

(defn- with-artifact-lock [store operation]
  (let [lock (:lock @store)]
    (acquire-artifact-lock! lock)
    (try
      (operation)
      (finally
        (reset! lock false)))))

(defn- validate-artifact-id! [artifact-id]
  (let [id (str artifact-id)]
    (when (or (nil? (re-matches #"[A-Za-z0-9._-]+" id))
              (str/includes? id ".."))
      (throw (ex-info "Artifact ID must be a safe filename component"
                      {:category :invalid-artifact-id
                       :artifact_id id})))
    id))

(defn- delete-file-backed-entry! [entry]
  (when (and entry (get-in entry [:info :is_file_backed]))
    (let [path (:data entry)]
      (when (io/file-exists? path)
        (io/delete-file path)))))

(defn- validate-edn-round-trip! [data serialized]
  (let [round-tripped
        (try
          (edn/read-string serialized)
          (catch Object cause
            (throw (ex-info "Artifact value is not EDN-serializable"
                            {:category :unsupported-artifact-value
                             :cause (str cause)}))))]
    (when-not (= data round-tripped)
      (throw (ex-info "Artifact value does not round-trip through EDN"
                      {:category :unsupported-artifact-value})))
    serialized))

(defn- move-artifact-file! [source target]
  (let [result (os/sh "mv" source target)]
    (when-not (zero? (:exit result))
      (throw (ex-info "Failed to publish artifact file"
                      {:category :artifact-write-failed
                       :source source
                       :target target
                       :exit (:exit result)
                       :error (:err result)})))))

;; Store an artifact (in memory if <= 100KB, file-backed if > 100KB)
(defn store-artifact! [store artifact-id name data]
  (let [id (validate-artifact-id! artifact-id)]
    (with-artifact-lock
      store
      (fn []
        (let [base-dir (:base-dir @store)
              serialized (pr-str data)
              _ (validate-edn-round-trip! data serialized)
              size-source (if (string? data) data serialized)
              size (count (.getBytes size-source "UTF-8"))
              is-file-backed
              (and (> size file-backing-threshold)
                   (not (str/blank? base-dir)))
              old-entry (get-in @store [:artifacts id])
              stored-data
              (if is-file-backed
                (let [art-dir (str base-dir "/artifacts")
                      _ (io/mkdir art-dir)
                      file-path (str art-dir "/" id ".edn")
                      temp-path (str file-path ".tmp-" (random-uuid))]
                  (try
                    (io/spit temp-path serialized)
                    (move-artifact-file! temp-path file-path)
                    file-path
                    (catch Object cause
                      (when (io/file-exists? temp-path)
                        (io/delete-file temp-path))
                      (throw cause))))
                data)
              info {:id id
                    :name (str name)
                    :size_bytes size
                    :stored_at (str (System/currentTimeMillis))
                    :is_file_backed is-file-backed}]
          (when (and old-entry
                     (get-in old-entry [:info :is_file_backed])
                     (not is-file-backed))
            (delete-file-backed-entry! old-entry))
          (swap! store update :artifacts assoc id
                 {:info info :data stored-data})
          info)))))

;; Retrieve an artifact
(defn retrieve-artifact [store artifact-id]
  (with-artifact-lock
    store
    (fn []
      (let [entry (get-in @store [:artifacts (str artifact-id)])]
        (when (nil? entry)
          (throw (ex-info "Artifact not found"
                          {:category :artifact-not-found
                           :artifact_id (str artifact-id)})))
        (let [{:keys [info data]} entry]
          (if (:is_file_backed info)
            (edn/read-string (io/slurp data))
            data))))))

;; Check if artifact exists
(defn has-artifact? [store artifact-id]
  (with-artifact-lock
    store
    (fn [] (contains? (:artifacts @store) (str artifact-id)))))

;; List all artifacts
(defn list-artifacts [store]
  (with-artifact-lock
    store
    (fn [] (mapv :info (vals (:artifacts @store))))))

(defn remove-artifact! [store artifact-id]
  (with-artifact-lock
    store
    (fn []
      (let [id (str artifact-id)
            entry (get-in @store [:artifacts id])]
        (when entry
          (delete-file-backed-entry! entry)
          (swap! store update :artifacts dissoc id))
        (some? entry)))))

(defn clear-artifacts! [store]
  (with-artifact-lock
    store
    (fn []
      (doseq [[id entry] (:artifacts @store)]
        (delete-file-backed-entry! entry)
        (swap! store update :artifacts dissoc id))
      nil)))

;; Initialize the run directory structure (Section 5.6)
(defn init-run-dir [logs-root graph]
  (let [root (or logs-root "attractor_runs/run_latest")
        art-dir (str root "/artifacts")]
    (os/sh "mkdir" "-p" root)
    (os/sh "mkdir" "-p" art-dir)
    (let [manifest {:id (:id graph)
                    :goal (:goal graph)
                    :start_time (str (System/currentTimeMillis))}]
      (io/spit (str root "/manifest.json") (json/write-json manifest)))
    root))

;; Write stage artifacts (Section 5.6)
(defn write-stage-artifacts [logs-root stage-id prompt response outcome]
  (let [stage-dir (str logs-root "/" stage-id)]
    (os/sh "mkdir" "-p" stage-dir)
    (when prompt
      (io/spit (str stage-dir "/prompt.md") (str prompt)))
    (when response
      (io/spit (str stage-dir "/response.md") (str response)))
    (io/spit (str stage-dir "/status.json")
             (status/outcome->status-json outcome))
    stage-dir))

;; Save a checkpoint (Section 5.3)
(defn save-checkpoint [checkpoint path]
  (let [checkpoint-data {:timestamp (:timestamp checkpoint)
                         :current_node (:current_node checkpoint)
                         :completed_nodes (or (:completed_nodes checkpoint) [])
                         :node_retries (or (:node_retries checkpoint) {})
                         :node_outcomes (or (:node_outcomes checkpoint) {})
                         :context_values (or (:context_values checkpoint) {})
                         :logs (or (:logs checkpoint) [])}]
    (io/spit path (pr-str checkpoint-data))
    checkpoint))

;; Load a checkpoint (Section 5.3)
(defn load-checkpoint [path]
  (let [raw (io/slurp path)
        data (try
               (edn/read-string raw)
               (catch Object _ (json/read-json raw)))]
    {:timestamp (or (:timestamp data) (get data "timestamp"))
     :current_node (or (:current_node data) (get data "current_node"))
     :completed_nodes (or (:completed_nodes data) (get data "completed_nodes") [])
     :node_retries (or (:node_retries data) (get data "node_retries") {})
     :node_outcomes (or (:node_outcomes data) (get data "node_outcomes") {})
     :context_values (or (:context_values data)
                         (get data "context_values")
                         (get data "context") {})
     :logs (or (:logs data) (get data "logs") [])}))
