(ns attractor.agent
  (:require [clojure.string :as str]
            [os :as os]
            [io :as io]
            [json :as json]
            [attractor.llm :as llm]
            [attractor.execution :as execution]
            [attractor.profiles :as profiles]))

;; Provider-profile tool output limits from Coding Agent Loop §5.
(def default-tool-output-limits
  {"read_file" 50000
   "shell" 30000
   "execute_command" 30000
   "grep" 20000
   "glob" 20000
   "directory_list" 20000
   "edit_file" 10000
   "apply_patch" 10000
   "write_file" 1000
   "spawn_agent" 20000})

(def default-tool-line-limits
  {"shell" 256
   "execute_command" 256
   "grep" 200
   "glob" 500
   "directory_list" 500})

(def head-tail-tools
  #{"read_file" "shell" "execute_command" "spawn_agent"})

(defn truncate-output [output max-chars mode]
  (let [text (str (or output ""))
        limit (max 0 (or max-chars (count text)))]
    (if (<= (count text) limit)
      text
      (let [removed (- (count text) limit)]
        (if (= mode "head_tail")
          (let [head-size (quot limit 2)
                tail-size (- limit head-size)]
            (str (subs text 0 head-size)
                 "\n\n[WARNING: Tool output was truncated. " removed
                 " characters were removed from the middle. "
                 "The full output is available in the event stream. "
                 "If you need to see specific parts, re-run the tool with more targeted parameters.]\n\n"
                 (subs text (- (count text) tail-size))))
          (str "[WARNING: Tool output was truncated. First " removed
               " characters were removed. The full output is available in the event stream.]\n\n"
               (subs text (- (count text) limit))))))))

(defn truncate-lines [output max-lines]
  (let [text (str (or output ""))
        lines (vec (str/split text #"\n"))
        limit (or max-lines (count lines))]
    (if (or (nil? max-lines) (<= (count lines) limit))
      text
      (let [head-count (quot limit 2)
            tail-count (- limit head-count)
            omitted (- (count lines) limit)]
        (str (str/join "\n" (subvec lines 0 head-count))
             "\n[... " omitted " lines omitted ...]\n"
             (str/join "\n" (subvec lines (- (count lines) tail-count))))))))

(defn truncate-tool-output [output tool-name config]
  (let [configured-char-limits (or (:tool_output_limits config) {})
        configured-line-limits (or (:tool_line_limits config) {})
        max-chars (or (get configured-char-limits tool-name)
                      (get default-tool-output-limits tool-name)
                      20000)
        max-lines (if (contains? configured-line-limits tool-name)
                    (get configured-line-limits tool-name)
                    (get default-tool-line-limits tool-name))
        mode (if (contains? head-tail-tools tool-name) "head_tail" "tail")]
    (truncate-lines (truncate-output output max-chars mode) max-lines)))

;; Tool definitions
(defn tool-read-file [path & [start-line end-line]]
  (try
    (let [content (io/slurp path)]
      (if (or start-line end-line)
        (let [lines (str/split content #"\n")
              s (max 0 (dec (or start-line 1)))
              e (min (count lines) (or end-line (count lines)))
              sliced (subvec (vec lines) s e)]
          (str/join "\n" sliced))
        content))
    (catch Object e
      (str "Error reading file " path ": " e))))

(defn tool-write-file [path content]
  (try
    (io/spit path content)
    (str "Successfully wrote to " path)
    (catch Object e
      (str "Error writing file " path ": " e))))

(defn tool-edit-file [path old-string new-string]
  (try
    (let [content (io/slurp path)]
      (if (str/includes? content old-string)
        (let [updated (str/replace-first content old-string new-string)]
          (io/spit path updated)
          (str "Successfully edited " path))
        (str "Error: old_string not found in " path)))
    (catch Object e
      (str "Error editing file " path ": " e))))

(defn tool-execute-command [cmd & [timeout-ms]]
  (try
    (let [args (str/split (str/trim cmd) #"\s+")
          res (apply os/sh args)]
      {:exit (:exit res)
       :stdout (:out res)
       :stderr (:err res)})
    (catch Object e
      {:exit 1 :stdout "" :stderr (str "Execution error: " e)})))

(defn tool-directory-list [dir]
  (try
    (let [entries (os/ls (or dir "."))]
      (str/join "\n" (map (fn [e] (str (if (:dir? e) "[DIR]  " "[FILE] ") (:name e))) entries)))
    (catch Object e
      (str "Error listing directory " dir ": " e))))

(defn- acquire-session-lock! [lock]
  (loop []
    (when-not (compare-and-set! lock false true)
      (core/sleep 1)
      (recur))))

(defn- with-session-lock [session operation]
  (let [lock (:lifecycle_lock @session)]
    (acquire-session-lock! lock)
    (try
      (operation)
      (finally
        (reset! lock false)))))

(def ^:dynamic *delivering-session-id* nil)

(defn- deliver-event! [session stamped listener]
  (binding [*delivering-session-id* (:id @session)]
    (let [stored-listener (:event_fn @session)]
      (when stored-listener
        (try
          (stored-listener stamped)
          (catch Object e
            (swap! (:listener_errors @session) conj e))))
      (when (and listener (not= listener stored-listener))
        (try
          (listener stamped)
          (catch Object e
            (swap! (:listener_errors @session) conj e))))))
  stamped)

(defn- drain-event-deliveries! [session]
  (let [active (:delivery_active @session)]
    (when (compare-and-set! active false true)
      (loop []
        (let [delivery
              (with-session-lock
                session
                (fn []
                  (let [queued @(:delivery_queue @session)]
                    (if (seq queued)
                      (do
                        (reset! (:delivery_queue @session)
                                (vec (rest queued)))
                        (first queued))
                      (do
                        (reset! active false)
                        nil)))))]
          (when delivery
            (deliver-event! session (:event delivery) (:listener delivery))
            (when-let [delivered (:delivered delivery)]
              (deliver delivered true))
            (recur)))))))

(defn- stamped-event [session event]
  (assoc event
         :timestamp (System/currentTimeMillis)
         :session_id (:id @session)))

(defn- emit-event! [session event & [listener]]
  (let [stamped
        (with-session-lock
          session
          (fn []
            (when (and (not= :closed (:state @session))
                       (not @(:session_end_emitted @session)))
              (let [value (stamped-event session event)]
                (swap! (:events @session) conj value)
                (swap! (:delivery_queue @session) conj
                       {:event value :listener listener})
                value))))]
    (when stamped (drain-event-deliveries! session))
    stamped))

(defn- publish-session-end! [session event listener]
  (let [delivered (promise)
        stamped
        (with-session-lock
          session
          (fn []
            (when (compare-and-set! (:session_end_emitted @session)
                                    false true)
              (let [value
                    (stamped-event
                      session
                      (merge {:type :session_end :state :closed} event))]
                (swap! (:events @session) conj value)
                (swap! (:delivery_queue @session) conj
                       {:event value :listener listener
                        :delivered delivered})
                value))))]
    (when stamped (drain-event-deliveries! session))
    (when (and stamped
               (not= *delivering-session-id* (:id @session)))
      @delivered)
    stamped))

(defn session-events [session]
  (vec @(:events @session)))

(defn- environment-command [environment command]
  (when-let [execute (or (:inspect_command environment)
                         (when-let [exec-command (:exec_command environment)]
                           (fn [cmd] (exec-command cmd 5000 nil nil))))]
    (try
      (let [result (execute command)]
        (when (= 0 (:exit_code result))
          (str/trim (:stdout result))))
      (catch Object _ nil))))

(defn- directory-chain [root working-dir]
  (if (or (str/blank? root)
          (not (str/starts-with? working-dir root)))
    [working-dir]
    (let [suffix (subs working-dir (count root))
          parts (vec (remove str/blank? (str/split suffix #"/")))]
      (loop [remaining parts current root directories [root]]
        (if (empty? remaining)
          directories
          (let [next-dir (str current "/" (first remaining))]
            (recur (subvec remaining 1) next-dir
                   (conj directories next-dir))))))))

(defn- provider-doc-paths [provider]
  (case (str/lower-case (or provider ""))
    "openai" ["AGENTS.md" ".codex/instructions.md"]
    "anthropic" ["AGENTS.md" "CLAUDE.md"]
    "gemini" ["AGENTS.md" "GEMINI.md"]
    ["AGENTS.md"]))

(defn discover-project-docs [environment provider]
  (let [working-dir ((:working_directory environment))
        git-root (environment-command environment "git rev-parse --show-toplevel")
        directories (directory-chain (or git-root working-dir) working-dir)
        candidates (for [directory directories
                         relative-path (provider-doc-paths provider)]
                     (str directory "/" relative-path))
        exists? (:file_exists environment)
        read-text (or (:read_text environment)
                      (when-let [read-file (:read_file environment)]
                        (fn [path] (read-file path nil nil))))]
    (if (or (nil? exists?) (nil? read-text))
      []
      (loop [remaining candidates docs [] used 0]
        (if (empty? remaining)
          docs
          (let [path (first remaining)]
            (if-not (exists? path)
              (recur (rest remaining) docs used)
              (let [content (str (read-text path))
                    available (- 32768 used)]
                (if (<= (count content) available)
                  (recur (rest remaining)
                         (conj docs (str "# " path "\n" content))
                         (+ used (count content)))
                  (conj docs
                        (str "# " path "\n"
                             (subs content 0 (max 0 available))
                             "\n[Project instructions truncated at 32KB]")))))))))))

(defn- environment-snapshot [environment model]
  (let [working-dir ((:working_directory environment))
        git-root (environment-command environment "git rev-parse --show-toplevel")
        branch (when git-root
                 (environment-command environment "git branch --show-current"))
        status (when git-root
                 (environment-command environment "git status --short"))
        recent (when git-root
                 (environment-command environment "git log -5 --pretty=%s"))]
    {:working_directory working-dir
     :is_git_repository (boolean git-root)
     :git_branch (or branch "")
     :git_status_count (if (str/blank? status)
                         0
                         (count (str/split status #"\r?\n")))
     :recent_commits (or recent "")
     :platform ((:platform environment))
     :os_version ((:os_version environment))
     :date (or (environment-command environment "date +%F") "unknown")
     :model model}))

(defn- assemble-system-prompt [profile environment snapshot project-docs user-instructions]
  (let [base (profiles/build-system-prompt profile environment [])
        tool-text
        (str/join "\n"
                  (map (fn [tool]
                         (str (:name tool) ": " (:description tool)))
                       (profiles/profile-tools profile)))
        environment-text
        (str "<environment>\n"
             "Working directory: " (:working_directory snapshot) "\n"
             "Is git repository: " (:is_git_repository snapshot) "\n"
             "Git branch: " (:git_branch snapshot) "\n"
             "Git changed files: " (:git_status_count snapshot) "\n"
             (when-not (str/blank? (:recent_commits snapshot))
               (str "Recent commits:\n" (:recent_commits snapshot) "\n"))
             "Platform: " (:platform snapshot) "\n"
             "OS version: " (:os_version snapshot) "\n"
             "Today's date: " (:date snapshot) "\n"
             "Model: " (:model snapshot) "\n"
             "</environment>")]
    (str base
         "\n\n" environment-text
         "\n\n<tools>\n" tool-text "\n</tools>"
         (when (seq project-docs)
           (str "\n\n<project_instructions>\n"
                (str/join "\n\n" project-docs)
                "\n</project_instructions>"))
         (when-not (str/blank? user-instructions)
           (str "\n\n" user-instructions)))))

(declare register-subagent-tools! close-subagent!)

(def subagent-tool-names #{"spawn_agent" "send_input" "wait" "close_agent"})

;; Tool Dispatcher
(defn execute-tool [tool-name args]
  (case tool-name
    "read_file" (tool-read-file (get args "path") (get args "start_line") (get args "end_line"))
    "write_file" (tool-write-file (get args "path") (get args "content"))
    "edit_file" (tool-edit-file (get args "path") (get args "old_string") (get args "new_string"))
    "execute_command" (tool-execute-command (get args "command") (get args "timeout_ms"))
    "directory_list" (tool-directory-list (get args "path"))
    (str "Unknown tool: " tool-name)))

;; Create an Agent Session
(defn make-session [& [opts]]
  (let [options (or opts {})
        parsed-model (llm/parse-model-spec (or (:model options) "mock/default"))
        base-profile (or (:provider_profile options)
                         (profiles/create-profile (:provider parsed-model)
                                                  (:model parsed-model)))
        profile (assoc base-profile :tool_registry
                       (atom @(get base-profile :tool_registry)))
        _depth-tools
        (when (>= (or (:subagent_depth options) 0)
                  (or (:max_subagent_depth options) 1))
          (swap! (:tool_registry profile)
                 (fn [tools] (apply dissoc tools subagent-tool-names))))
        environment (assoc (or (:execution_env options)
                               (execution/make-local-environment
                                 {:default_command_timeout_ms
                                  (or (:default_command_timeout_ms options)
                                      (:default_command_timeout_ms profile)
                                      10000)
                                  :max_command_timeout_ms
                                  (or (:max_command_timeout_ms options) 600000)}))
                           :default_command_timeout_ms
                           (or (:default_command_timeout_ms options)
                               (:default_command_timeout_ms profile)
                               10000)
                           :max_command_timeout_ms
                           (or (:max_command_timeout_ms options) 600000))]
    ((:initialize environment))
    (let [project-docs
          (if (contains? options :project_docs)
            (vec (:project_docs options))
            (discover-project-docs environment (:id profile)))
          snapshot (environment-snapshot environment (:model profile))
          session
          (atom {:id (or (:id options) (str "agent-" (random-uuid)))
                 :model (:model profile)
                 :provider_profile profile
                 :execution_env environment
                 :llm_client (:llm_client options)
                 :event_fn (:on_event options)
                 :events (atom [])
                 :lifecycle_lock (atom false)
                 :delivery_queue (atom [])
                 :delivery_active (atom false)
                 :listener_errors (atom [])
                 :context_warning_emitted (atom false)
                 :project_docs project-docs
                 :environment_snapshot snapshot
                 :state :idle
                 :abort_signaled false
                 :llm_abort_controller (llm/make-abort-controller)
                 :active_stream_close nil
                 :cleanup_started (atom false)
                 :cleanup_error (atom nil)
                 :cleanup_done false
                 :session_end_emitted (atom false)
                 :history []
                 :steering-queue []
                 :followup-queue []
                 :subagents {}
                 :subagent_depth (or (:subagent_depth options) 0)
                 :config (merge {:max_turns 0
                                 :max_tool_rounds_per_input 0
                                 :default_command_timeout_ms 10000
                                 :max_command_timeout_ms 600000
                                 :reasoning_effort nil
                                 :enable_loop_detection true
                                 :loop_detection_window 10
                                 :max_subagent_depth 1}
                                options)})]
      (when (< (:subagent_depth @session)
               (or (get-in @session [:config :max_subagent_depth]) 1))
        (register-subagent-tools! session))
      (emit-event! session {:type :session_start})
      session)))

;; Inject a steering message into the session
(defn- enqueue-session-message! [session queue-key msg]
  (let [queued?
        (with-session-lock
          session
          (fn []
            (when (and (not= :closed (:state @session))
                       (not @(:session_end_emitted @session)))
              (swap! session update queue-key conj msg)
              true)))]
    (if queued?
      session
      (throw (ex-info "Cannot enqueue input after the session is closed"
                      {:category :session-closed
                       :session_id (:id @session)})))))

(defn steer-session! [session msg]
  (enqueue-session-message! session :steering-queue msg))

(defn follow-up-session! [session msg]
  (enqueue-session-message! session :followup-queue msg))

(defn- cleanup-session! [session]
  (if (compare-and-set! (:cleanup_started @session) false true)
    (let [errors (atom [])]
      (try
        (when-let [close-stream (:active_stream_close @session)]
          (try
            (close-stream)
            (catch Object e (swap! errors conj e))))
        (swap! session assoc :active_stream_close nil)
        (when-let [cleanup (get-in @session [:execution_env :cleanup])]
          (try
            (cleanup)
            (catch Object e (swap! errors conj e))))
        (doseq [[agent-id _] (:subagents @session)]
          (try
            (close-subagent! session agent-id)
            (catch Object e (swap! errors conj e))))
        (finally
          (when (seq @errors)
            (reset! (:cleanup_error @session) (first @errors)))
          (swap! session assoc :cleanup_done true))))
    (loop []
      (when-not (:cleanup_done @session)
        (core/sleep 1)
        (recur))))
  (when-let [error @(:cleanup_error @session)]
    (throw error))
  session)

(defn- emit-session-end! [session event on-event]
  (publish-session-end! session event on-event))

(defn close-session! [session & [on-event]]
  (with-session-lock session (fn [] (swap! session assoc :state :closed)))
  (let [cleanup-error
        (try
          (cleanup-session! session)
          nil
          (catch Object e e))]
    (emit-session-end!
      session
      (if cleanup-error {:cleanup_error (str cleanup-error)} {})
      on-event)
    (if cleanup-error
      (throw cleanup-error)
      session)))

(defn- close-session-after-error! [session error on-event]
  (with-session-lock session (fn [] (swap! session assoc :state :closed)))
  (let [cleanup-error
        (try
          (cleanup-session! session)
          nil
          (catch Object e e))]
    (emit-session-end!
      session
      (cond-> {:error (str error)}
        cleanup-error (assoc :cleanup_error (str cleanup-error)))
      on-event)))

(defn abort-session! [session & [on-event]]
  (with-session-lock
    session
    (fn [] (swap! session assoc :abort_signaled true :state :closed)))
  (when-let [abort (get-in @session [:llm_abort_controller :abort])]
    (abort))
  (close-session! session on-event))

(defn- session-stopped? [session]
  (or (:abort_signaled @session)
      (= :closed (:state @session))))

(defn- register-active-stream-close! [session close-fn]
  (let [closed (atom false)
        close-once
        (fn []
          (when (compare-and-set! closed false true)
            (close-fn)))]
    (swap! session assoc :active_stream_close close-once)
    (when (session-stopped? session)
      (close-once))))

(defn- append-history-if-open! [session turn]
  (with-session-lock
    session
    (fn []
      (when (and (not= :closed (:state @session))
                 (not @(:session_end_emitted @session)))
        (swap! session update :history conj turn)
        true))))

(defn- drain-steering! [session event-fn]
  (let [queued (:steering-queue @session)]
    (doseq [msg queued]
      (when (append-history-if-open!
              session
              {:type :steering :role :user :content msg
               :timestamp (System/currentTimeMillis)})
        (event-fn {:type :steering_injected :content msg})))
    (swap! session assoc :steering-queue [])))

(defn- history-to-messages [history]
  (mapv
    (fn [turn]
      (case (:type turn)
        :tool_results {:role :tool :content (:results turn)}
        :assistant (cond-> {:role :assistant :content (:content turn)}
                     (seq (:tool_calls turn)) (assoc :tool_calls (:tool_calls turn)))
        {:role :user :content (:content turn)}))
    history))

(defn- value-character-count [value]
  (cond
    (nil? value) 0
    (string? value) (count value)
    (map? value)
    (reduce + 0
            (map (fn [[key item]]
                   (+ (value-character-count key)
                      (value-character-count item)))
                 value))
    (sequential? value) (reduce + 0 (map value-character-count value))
    :else (count (str value))))

(defn- turn-character-count [turn]
  (case (:type turn)
    :assistant (+ (value-character-count (:content turn))
                  (value-character-count (:reasoning turn))
                  (value-character-count (:tool_calls turn)))
    :tool_results (value-character-count (:results turn))
    (value-character-count (:content turn))))

(defn- check-context-usage! [session event-fn]
  (let [window (or (get-in @session [:provider_profile :context_window_size]) 0)
        characters (reduce + 0 (map turn-character-count (:history @session)))]
    (when (and (> window 0)
               (> (* characters 5) (* window 16))
               (compare-and-set! (:context_warning_emitted @session)
                                 false true))
      (let [approx-tokens (quot (+ characters 3) 4)
            percent (quot (+ (* characters 25) (quot window 2)) window)]
        (event-fn {:type :warning
                   :category :context_usage
                   :message (str "Context usage at ~" percent
                                 "% of context window")
                   :approx_tokens approx-tokens
                   :context_window_size window
                   :percent percent})))))

(def built-in-tool-names
  #{"read_file" "write_file" "edit_file" "execute_command" "directory_list"})

(def built-in-tool-definitions
  [{:name "read_file" :description "Read a file"
    :parameters {:type "object" :properties {:path {:type "string"}} :required ["path"]}}
   {:name "write_file" :description "Write a complete file"
    :parameters {:type "object"
                 :properties {:path {:type "string"} :content {:type "string"}}
                 :required ["path" "content"]}}
   {:name "edit_file" :description "Replace one exact string in a file"
    :parameters {:type "object"
                 :properties {:path {:type "string"}
                              :old_string {:type "string"}
                              :new_string {:type "string"}}
                 :required ["path" "old_string" "new_string"]}}
   {:name "execute_command" :description "Execute a command"
    :parameters {:type "object"
                 :properties {:command {:type "string"} :timeout_ms {:type "integer"}}
                 :required ["command"]}}
   {:name "directory_list" :description "List a directory"
    :parameters {:type "object" :properties {:path {:type "string"}}}}])

(defn- normalize-tool-arguments [arguments]
  (if (string? arguments)
    (try
      (json/read-json arguments)
      (catch Object _ {}))
    (or arguments {})))

(defn- execute-single-tool [session tool-call event-fn]
  (let [tool-name (or (:name tool-call) (get tool-call "name") "")
        call-id (or (:id tool-call) (get tool-call "id") "")
        args (normalize-tool-arguments
               (or (:arguments tool-call) (get tool-call "arguments") {}))
        registered (profiles/registry-get
                     (get-in @session [:provider_profile :tool_registry])
                     tool-name)]
    (event-fn {:type :tool_call_start :tool_name tool-name :call_id call-id})
    (if (nil? registered)
      (let [error-msg (str "Unknown tool: " tool-name)
            result {:tool_call_id call-id :tool_name tool-name
                    :content error-msg :is_error true}]
        (event-fn {:type :tool_call_end :call_id call-id :error error-msg})
        result)
      (try
        (let [[valid? reason]
              (llm/validate-json-schema
                args (get-in registered [:definition :parameters]))
              _ (when-not valid?
                  (throw (ex-info reason {:category :invalid-tool-arguments})))
              raw-output ((:executor registered) args (:execution_env @session))
              raw-text (if (string? raw-output) raw-output (pr-str raw-output))
              truncated (truncate-tool-output raw-text tool-name (:config @session))
              result {:tool_call_id call-id :tool_name tool-name
                      :content truncated :is_error false}]
          (event-fn {:type :tool_call_end :call_id call-id :output raw-text})
          result)
        (catch Object e
          (let [error-msg (str "Tool error (" tool-name "): " e)
                result {:tool_call_id call-id :tool_name tool-name
                        :content error-msg :is_error true}]
            (event-fn {:type :tool_call_end :call_id call-id :error error-msg})
            result))))))

(defn- response-content [response]
  (or (when (:message response) (llm/response-text response))
      (:text response)
      (:content response)
      ""))

(defn- response-tool-calls [response]
  (or (:tool_calls response)
      (get-in response [:message :tool_calls])
      []))

(defn- stream-response! [session stream-fn request event-fn]
  (let [accumulator (llm/make-stream-accumulator)
        text-started (atom false)
        finish-seen (atom false)
        ensure-text-start!
        (fn []
          (when (compare-and-set! text-started false true)
            (event-fn {:type :assistant_text_start})))
        stream-request
        (assoc request
               :register_stream_close
               (fn [close-fn]
                 (register-active-stream-close! session close-fn)))]
    (try
      (doseq [event (stream-fn stream-request)]
        (when-not (session-stopped? session)
          (llm/stream-accumulator-process! accumulator event)
          (case (:type event)
            :stream_start (ensure-text-start!)
            :text_start (ensure-text-start!)
            :text_delta
            (do
              (ensure-text-start!)
              (event-fn {:type :assistant_text_delta
                         :delta (:delta event)
                         :text_id (:text_id event)}))
            :text_end nil
            :finish (reset! finish-seen true)
            :error
            (throw
              (ex-info (str "LLM stream failed: " (:error event))
                       {:category :provider-stream
                        :provider_error (:error event)}))
            nil)))
      (if (session-stopped? session)
        nil
        (do
          (when-not @finish-seen
            (throw (ex-info "LLM stream ended before a finish event"
                            {:category :provider-stream})))
          (ensure-text-start!)
          (or (llm/stream-accumulator-response accumulator)
              {:message {:role :assistant :content ""}
               :tool_calls []})))
      (finally
        (when-let [close-stream (:active_stream_close @session)]
          (try
            (close-stream)
            (catch Object _ nil)))
        (swap! session assoc :active_stream_close nil)))))

(defn- tool-call-signature [tool-call]
  [(or (:name tool-call) (get tool-call "name"))
   (or (:arguments tool-call) (get tool-call "arguments"))])

(defn detect-loop [history window-size]
  (let [signatures
        (vec (mapcat
               (fn [turn]
                 (if (= :assistant (:type turn))
                   (map tool-call-signature (or (:tool_calls turn) []))
                   []))
               history))
        window (max 1 (or window-size 10))]
    (if (< (count signatures) window)
      false
      (let [recent (subvec signatures (- (count signatures) window))]
        (boolean
          (some
            (fn [pattern-length]
              (and (<= pattern-length window)
                   (= 0 (mod window pattern-length))
                   (every?
                     (fn [index]
                       (= (get recent index)
                          (get recent (mod index pattern-length))))
                     (range pattern-length window))))
            [1 2 3]))))))

;; Process one user input through LLM -> tools -> LLM until natural completion.
(defn- process-input-cycle! [session prompt on-event followup?]
  (let [event-fn (fn [event] (emit-event! session event on-event))
        config (:config @session)
        profile (:provider_profile @session)
        environment (:execution_env @session)
        client (:llm_client @session)
        stream-fn
        (cond
          (:stream_fn config) (:stream_fn config)
          (:complete_fn config) nil
          (or (= "mock" (:id profile))
              (not (:supports_streaming profile))) nil
          client (fn [request] (llm/client-stream client request))
          :else (fn [request] (llm/stream request)))
        complete-fn
        (when-not stream-fn
          (or (:complete_fn config)
              (when client
                (fn [request] (llm/client-complete client request)))
              (fn [request] (llm/complete request))))
        round-limit (or (:max_tool_rounds_per_input config) 0)
        turn-limit (or (:max_turns config) 0)]
    (when-not
      (with-session-lock
        session
        (fn []
          (when (and (if followup?
                       (= :processing (:state @session))
                       (contains? #{:idle :awaiting_input}
                                  (:state @session)))
                     (not @(:session_end_emitted @session)))
            (swap! session
                   (fn [state]
                     (-> state
                         (assoc :state :processing)
                         (update :history conj
                                 {:type :user :role :user :content prompt
                                  :timestamp (System/currentTimeMillis)}))))
            true)))
      (let [closed? (session-stopped? session)]
        (throw
          (ex-info
            (if closed?
              "Cannot process input after the session is closed"
              "Cannot process concurrent input while the session is busy")
            {:category (if closed? :session-closed :session-busy)
             :session_id (:id @session)}))))
    (event-fn {:type :user_input :content prompt})
    (drain-steering! session event-fn)
    (let [result
          (loop [round-count 0
                 last-text ""]
            (let [assistant-count (count (filter (fn [turn] (= :assistant (:type turn)))
                                                 (:history @session)))]
              (check-context-usage! session event-fn)
              (cond
                (session-stopped? session) last-text

                (or (and (> round-limit 0) (>= round-count round-limit))
                    (and (> turn-limit 0) (>= assistant-count turn-limit)))
                (do
                  (event-fn {:type :turn_limit :round round-count
                             :total_turns assistant-count})
                  last-text)

                :else
                (let [system-prompt
                      (assemble-system-prompt
                        profile environment
                        (:environment_snapshot @session)
                        (:project_docs @session)
                        (:user_instructions config))
                      request {:model (:model profile)
                               :provider (:id profile)
                               :messages
                               (vec (cons {:role :system :content system-prompt}
                                          (history-to-messages (:history @session))))
                               :tools (profiles/profile-tools profile)
                               :tool_choice {:mode "auto"}
                               :reasoning_effort (:reasoning_effort config)
                               :provider_options (:provider_options profile)
                               :abort_signal
                               (get-in @session [:llm_abort_controller :signal])}
                      response
                      (try
                        (if stream-fn
                          (stream-response! session stream-fn request event-fn)
                          (do
                            (event-fn {:type :assistant_text_start})
                            (complete-fn request)))
                        (catch Object e
                          (if (session-stopped? session)
                            nil
                            (do
                              (event-fn {:type :error :error (str e)
                                         :category (:category (ex-data e))})
                              (close-session-after-error! session e on-event)
                              (throw e)))))]
                  (if (session-stopped? session)
                    last-text
                    (let [text (response-content response)
                          tool-calls (response-tool-calls response)
                          assistant-turn {:type :assistant
                                          :role :assistant
                                          :content text
                                          :tool_calls tool-calls
                                          :reasoning (:reasoning response)
                                          :usage (:usage response)
                                          :response_id (:id response)
                                          :timestamp (System/currentTimeMillis)}]
                      (if-not (append-history-if-open! session assistant-turn)
                        last-text
                        (do
                          (check-context-usage! session event-fn)
                          (event-fn {:type :assistant_text_end :text text
                                     :reasoning (:reasoning response)})
                          (if (empty? tool-calls)
                            text
                            (if (session-stopped? session)
                              text
                              (let [execute-call
                                    (fn [tool-call]
                                      (execute-single-tool session tool-call event-fn))
                                    results
                                    (if (and (:supports_parallel_tool_calls profile)
                                             (> (count tool-calls) 1))
                                      (vec (pmap execute-call tool-calls))
                                      (mapv execute-call tool-calls))
                                    recorded?
                                    (append-history-if-open!
                                      session
                                      {:type :tool_results :role :tool
                                       :results results
                                       :timestamp (System/currentTimeMillis)})]
                                (if-not recorded?
                                  text
                                  (do
                                    (drain-steering! session event-fn)
                                    (check-context-usage! session event-fn)
                                    (when (and (:enable_loop_detection config)
                                               (detect-loop
                                                 (:history @session)
                                                 (:loop_detection_window config)))
                                      (let [warning
                                            (str "Loop detected: recent tool calls repeat. "
                                                 "Try a different approach.")]
                                        (when (append-history-if-open!
                                                session
                                                {:type :steering :role :user
                                                 :content warning
                                                 :timestamp (System/currentTimeMillis)})
                                          (event-fn
                                            {:type :loop_detection
                                             :message warning}))))
                                    (recur (inc round-count) text))))))))))))))]
      (let [decision
            (with-session-lock
              session
              (fn []
                (cond
                  (= :closed (:state @session)) {:kind :stopped}
                  (seq (:followup-queue @session))
                  (let [next-input (first (:followup-queue @session))]
                    (swap! session update :followup-queue
                           (fn [queued] (vec (rest queued))))
                    {:kind :followup :input next-input})
                  :else
                  (do
                    (swap! session assoc :state :idle)
                    {:kind :idle}))))]
        (case (:kind decision)
          :stopped result
          :followup
          (try
            (process-input-cycle! session (:input decision) on-event true)
            (catch Object e
              (if (and (session-stopped? session)
                       (= :session-closed (:category (ex-data e))))
                result
                (throw e))))
          (do
            (event-fn {:type :processing_end})
            result))))))

(defn process-input! [session prompt & [on-event]]
  (process-input-cycle! session prompt on-event false))

;; Compatibility name used by the Attractor codergen backend.
(defn run-agent-turn! [session prompt & [on-event]]
  (process-input! session prompt on-event))

(defn- subagent-arg [arguments key]
  (or (get arguments key) (get arguments (keyword key))))

(defn- subagent-turn-count [session]
  (count (filter (fn [turn] (= :assistant (:type turn)))
                 (:history @session))))

(defn- start-subagent-run! [parent agent-id input]
  (let [child (get-in @parent [:subagents agent-id :session])]
    (when (nil? child)
      (throw (ex-info (str "Unknown subagent: " agent-id)
                      {:category :unknown-subagent :agent_id agent-id})))
    (swap! parent update-in [:subagents agent-id]
           assoc :status :running :result nil)
    (let [task
          (core/future
            (try
              (let [output (process-input! child input)
                    result {:output output :success true
                            :turns_used (subagent-turn-count child)}]
                (swap! parent update-in [:subagents agent-id]
                       assoc :status :completed :result result)
                result)
              (catch Object e
                (let [result {:output (str e) :success false
                              :turns_used (subagent-turn-count child)}]
                  (swap! parent update-in [:subagents agent-id]
                         assoc :status :failed :result result)
                  result))))]
      (swap! parent assoc-in [:subagents agent-id :future] task)
      {:agent_id agent-id :status :running})))

(defn spawn-subagent! [parent arguments]
  (let [depth (:subagent_depth @parent)
        max-depth (or (get-in @parent [:config :max_subagent_depth]) 1)]
    (when (>= depth max-depth)
      (throw (ex-info "Subagent depth limit reached"
                      {:category :subagent-depth-limit
                       :depth depth :max_depth max-depth})))
    (let [task (subagent-arg arguments "task")
          _ (when (str/blank? task)
              (throw (ex-info "Subagent task is required"
                              {:category :invalid-subagent-task})))
          requested-dir (subagent-arg arguments "working_dir")
          parent-environment (:execution_env @parent)
          scoped-environment
          (if (and (not (str/blank? requested-dir))
                   (:with_working_directory parent-environment))
            ((:with_working_directory parent-environment) requested-dir)
            parent-environment)
          ;; The parent owns shared-environment lifecycle cleanup.
          child-environment (assoc scoped-environment
                              :initialize (fn [] nil)
                              :cleanup (fn [] nil))
          parent-profile (:provider_profile @parent)
          requested-model (subagent-arg arguments "model")
          child-profile (if (str/blank? requested-model)
                          parent-profile
                          (profiles/create-profile (:id parent-profile)
                                                   requested-model))
          child-id (str "agent-" (random-uuid))
          child
          (make-session
            {:id child-id
             :provider_profile child-profile
             :execution_env child-environment
             :llm_client (:llm_client @parent)
             :complete_fn (get-in @parent [:config :complete_fn])
             :max_turns (or (subagent-arg arguments "max_turns") 0)
             :max_tool_rounds_per_input
             (get-in @parent [:config :max_tool_rounds_per_input])
             :max_subagent_depth max-depth
             :subagent_depth (inc depth)
             :on_event
             (fn [event]
               (emit-event! parent
                            {:type :subagent_event
                             :agent_id child-id
                             :event event}))})
          agent-id (:id @child)]
      (swap! parent assoc-in [:subagents agent-id]
             {:id agent-id :session child :status :starting
              :future nil :result nil})
      (start-subagent-run! parent agent-id task))))

(defn send-subagent-input! [parent agent-id message]
  (let [handle (get-in @parent [:subagents agent-id])]
    (when (nil? handle)
      (throw (ex-info (str "Unknown subagent: " agent-id)
                      {:category :unknown-subagent :agent_id agent-id})))
    (if (= :running (:status handle))
      (do
        (follow-up-session! (:session handle) message)
        {:agent_id agent-id :status :running :queued true})
      (start-subagent-run! parent agent-id message))))

(defn wait-subagent! [parent agent-id]
  (let [handle (get-in @parent [:subagents agent-id])]
    (when (nil? handle)
      (throw (ex-info (str "Unknown subagent: " agent-id)
                      {:category :unknown-subagent :agent_id agent-id})))
    (if-let [task (:future handle)]
      @task
      (:result handle))))

(defn close-subagent! [parent agent-id]
  (let [handle (get-in @parent [:subagents agent-id])]
    (when (nil? handle)
      (throw (ex-info (str "Unknown subagent: " agent-id)
                      {:category :unknown-subagent :agent_id agent-id})))
    (abort-session! (:session handle))
    (swap! parent update-in [:subagents agent-id] assoc :status :closed)
    {:agent_id agent-id :status :closed}))

(defn- subagent-tool [name description properties required executor]
  {:definition
   {:name name :description description
    :parameters (cond-> {:type "object" :properties properties}
                  (seq required) (assoc :required required))}
   :executor executor})

(defn register-subagent-tools! [session]
  (let [registry (get-in @session [:provider_profile :tool_registry])
        tools
        [(subagent-tool
           "spawn_agent" "Spawn a scoped coding subagent"
           {:task {:type "string"} :working_dir {:type "string"}
            :model {:type "string"} :max_turns {:type "integer"}}
           ["task"]
           (fn [arguments _] (spawn-subagent! session arguments)))
         (subagent-tool
           "send_input" "Send another input to a subagent"
           {:agent_id {:type "string"} :message {:type "string"}}
           ["agent_id" "message"]
           (fn [arguments _]
             (send-subagent-input! session
                                   (subagent-arg arguments "agent_id")
                                   (subagent-arg arguments "message"))))
         (subagent-tool
           "wait" "Wait for a subagent and return its result"
           {:agent_id {:type "string"}} ["agent_id"]
           (fn [arguments _]
             (wait-subagent! session (subagent-arg arguments "agent_id"))))
         (subagent-tool
           "close_agent" "Terminate a subagent"
           {:agent_id {:type "string"}} ["agent_id"]
           (fn [arguments _]
             (close-subagent! session (subagent-arg arguments "agent_id"))))]]
    (doseq [tool tools] (profiles/register-tool! registry tool))
    session))

;; CodergenBackend implementation backed by the Coding Agent Loop
(defn make-agent-codergen-backend [& [session-opts]]
  (let [base-options (or session-opts {})]
    (fn [node prompt _ctx]
      (let [options-fn (:session_options_fn base-options)
            dynamic-options (if options-fn (or (options-fn node) {}) {})
            static-options (dissoc base-options :session_options_fn)
            node-model (:llm_model node)
            session-options
            (assoc (merge static-options dynamic-options)
                   :model (or (:model dynamic-options)
                              (when-not (str/blank? node-model) node-model)
                              (:model static-options)
                              "default"))
            full? (= "full" (:resolved_fidelity node))
            thread-key (:resolved_thread_id node)
            threads (:fidelity_threads node)]
        (if (and full? thread-key threads)
          (let [existing (get @threads thread-key)
                session (or (:session existing)
                            (let [created (make-session session-options)]
                              (swap! threads assoc thread-key
                                     {:session created
                                      :close #(close-session! created)})
                              created))]
            (try
              (run-agent-turn! session prompt)
              (catch Object e
                (when-not (= :closed (:state @session))
                  (close-session! session))
                (swap! threads dissoc thread-key)
                (throw e))))
          (let [session (make-session session-options)]
            (try
              (run-agent-turn! session prompt)
              (finally
                (close-session! session)))))))))
