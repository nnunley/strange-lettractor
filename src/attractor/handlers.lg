(ns attractor.handlers
  (:require [clojure.string :as str]
            [clojure.core :as core]
            [io :as io]
            [os :as os]
            [attractor.execution :as execution]
            [attractor.context :as context]
            [attractor.conditions :as conditions]
            [attractor.parser :as parser]
            [attractor.interviewer :as interviewer]
            [attractor.status :as status]))

;; Shape to handler type mapping (Section 2.8)
(def shape-to-type
  {"Mdiamond" "start"
   "Msquare" "exit"
   "box" "codergen"
   "hexagon" "wait.human"
   "diamond" "conditional"
   "component" "parallel"
   "tripleoctagon" "parallel.fan_in"
   "parallelogram" "tool"
   "house" "stack.manager_loop"})

(def parallel-executor-key :attractor.handlers/parallel-executor)
(def manager-runtime-key :attractor.handlers/manager-runtime)
(def parallel-default-handler-key :attractor.handlers/parallel-default-handler)
(def manager-default-handler-key :attractor.handlers/manager-default-handler)

;; Start Handler (Section 4.3)
(defn handle-start [_node _context _graph _logs-root]
  {:status :success :notes "Start node"})

;; Exit Handler (Section 4.4)
(defn handle-exit [_node _context _graph _logs-root]
  {:status :success :notes "Exit node"})

;; Conditional Handler (Section 4.7)
(defn handle-conditional [node _context _graph _logs-root]
  {:status :success :notes (str "Conditional node evaluated: " (:id node))})

;; Tool Handler (Section 4.10)
(def ^:dynamic *tool-environment-factory* execution/make-local-environment)

(defn- parsed-tool-timeout-ms [node]
  (when (some? (:timeout node))
    (let [parsed (try
                   (parser/parse-duration-ms (:timeout node))
                   (catch Object _ ::invalid-timeout))]
      (if (and (number? parsed) (> parsed 0) (<= parsed Long/MAX_VALUE))
        (long parsed)
        (throw
          (ex-info (str "Invalid or non-positive node timeout for '"
                        (:id node) "'")
                   {:category :configuration_error
                    :retryable false}))))))

(defn- tool-environment-options [timeout-ms]
  {:working_dir (os/cwd)
   :default_command_timeout_ms timeout-ms
   :max_command_timeout_ms timeout-ms})

(defn- tool-context-updates [stdout stderr]
  {"tool.output" (or stdout "")
   "tool.error" (or stderr "")})

(defn- handle-unbounded-tool [cmd]
  (let [res (os/sh "/bin/bash" "--noprofile" "--norc" "-c" cmd)]
    (if (zero? (:exit res))
      {:status :success
       :context_updates {"tool.output" (:out res)}
       :notes (str "Tool completed: " cmd)}
      {:status :fail
       :failure_reason (str "Tool exited with code " (:exit res) ": " (:err res))
       :context_updates {"tool.output" (:out res)
                         "tool.error" (:err res)}})))

(defn- handle-timed-tool [node cmd timeout-ms]
  (let [environment (*tool-environment-factory*
                      (tool-environment-options timeout-ms))
        cancelled? (:cancelled? node)
        stop-watcher (atom false)
        watcher (core/future
                  (loop []
                    (cond
                      @stop-watcher nil
                      (and cancelled? (cancelled?))
                      (try
                        ((:cleanup environment))
                        (catch Object _ nil))
                      :else
                      (do
                        (core/sleep 2)
                        (recur)))))]
    (try
      (let [res ((:exec_command environment) cmd timeout-ms (os/cwd) nil)
            context-updates (tool-context-updates (:stdout res) (:stderr res))]
        (cond
          (or (and cancelled? (cancelled?)) (:cancelled res))
          {:status :cancelled
           :failure_reason "Pipeline cancelled"
           :context_updates context-updates}

          (:timed_out res)
          {:status :fail
           :category :timeout_error
           :retryable true
           :failure_reason (str "Tool timed out after " timeout-ms "ms")
           :context_updates context-updates}

          (zero? (:exit_code res))
          {:status :success
           :context_updates context-updates
           :notes (str "Tool completed: " cmd)}

          :else
          {:status :fail
           :failure_reason (str "Tool exited with code " (:exit_code res)
                                ": " (:stderr res))
           :context_updates context-updates}))
      (catch Object e
        {:status :fail :failure_reason (str "Tool execution exception: " e)})
      (finally
        (reset! stop-watcher true)
        @watcher
        (try
          ((:cleanup environment))
          (catch Object _ nil))))))

(defn handle-tool [node _context _graph _logs-root]
  (try
    (let [cmd (or (:tool_command (:attrs node)) (:tool_command node) "")
          timeout-ms (parsed-tool-timeout-ms node)]
      (if (str/blank? cmd)
        {:status :fail :failure_reason "No tool_command specified"}
        (if timeout-ms
          (handle-timed-tool node cmd timeout-ms)
          (handle-unbounded-tool cmd))))
    (catch Object e
      (merge {:status :fail
              :failure_reason (str "Tool execution exception: " e)}
             (select-keys (or (ex-data e) {}) [:category :retryable])))))

;; Codergen Handler (Section 4.5)
(defn make-codergen-handler
  ([] (make-codergen-handler nil))
  ([backend]
   (fn [node ctx graph logs-root]
     (let [node-id (:id node)
           goal (or (:goal graph) (context/ctx-get-string ctx "graph.goal" ""))
           raw-prompt (let [p (:prompt node)]
                        (if (str/blank? p)
                          (or (:label node) node-id)
                          p))
           base-prompt (str/replace raw-prompt "$goal" goal)
           preamble (or (:context_preamble node) "")
           prompt (if (str/blank? preamble)
                    base-prompt
                    (str preamble "\n" base-prompt))
           stage-dir (str (or logs-root "attractor_runs/run_latest") "/" node-id)]

       (os/sh "mkdir" "-p" stage-dir)
       (io/spit (str stage-dir "/prompt.md") prompt)

       (try
         (let [backend-result (if backend
                                (backend node prompt ctx)
                                (str "[Simulated] Response for stage: " node-id))]
           (if (and (map? backend-result) (:status backend-result))
             ;; Backend returned an Outcome directly
             (do
               (when-not (os/stat (str stage-dir "/response.md"))
                 (io/spit (str stage-dir "/response.md") (or (:notes backend-result) (str backend-result))))
               (io/spit (str stage-dir "/status.json")
                        (status/outcome->status-json backend-result))
               backend-result)

             ;; Backend returned a response string
             (let [resp-str (str backend-result)
                   truncated-resp (subs resp-str 0 (min (count resp-str) 200))
                   outcome {:status :success
                            :notes (str "Stage completed: " node-id)
                            :context_updates {"last_stage" node-id
                                              "last_response" truncated-resp}}]
               (io/spit (str stage-dir "/response.md") resp-str)
               (io/spit (str stage-dir "/status.json")
                        (status/outcome->status-json outcome))
               outcome)))
         (catch Object e
           (let [fail-outcome {:status :fail :failure_reason (str e)}]
             (io/spit (str stage-dir "/status.json")
                      (status/outcome->status-json fail-outcome))
             (throw e))))))))

;; Wait.human Handler (Section 4.6)
(defn make-wait-human-handler [interviewer]
  (fn [node ctx graph _logs-root]
    (let [outgoing (filter (fn [e] (= (:from e) (:id node))) (:edges graph))
          choices (map (fn [e]
                         (let [label (if (str/blank? (:label e)) (:to e) (:label e))
                               key (interviewer/parse-accelerator-key label)]
                           {:key key :label label :to (:to e)}))
                       outgoing)]
      (if (empty? choices)
        {:status :fail :failure_reason "No outgoing edges for human gate"}
        (let [opts (map (fn [c] {:key (:key c) :label (:label c)}) choices)
              question {:text (or (:label node) "Select an option:")
                        :type :multiple_choice
                        :options opts
                        :stage (:id node)}
              answer (interviewer/ask interviewer question)]

          (cond
            (= (:value answer) :timeout)
            (let [def-choice (get-in node [:attrs :human.default_choice])]
              (if def-choice
                (let [matched (or (first (filter (fn [c] (= (:to c) def-choice)) choices))
                                  (first choices))]
                  {:status :success
                   :suggested_next_ids [(:to matched)]
                   :preferred_label (:label matched)
                   :context_updates {"human.gate.selected" (:key matched)
                                     "human.gate.label" (:label matched)}})
                {:status :retry :failure_reason "human gate timeout, no default"}))

            (= (:value answer) :skipped)
            {:status :fail :failure_reason "human skipped interaction"}

            :else
            (let [ans-val (str (:value answer))
                  ans-text (str (:text answer))
                  matched (or (first (filter (fn [c] (or (= (str/lower-case (:key c)) (str/lower-case ans-val))
                                                         (= (str/lower-case (:label c)) (str/lower-case ans-val))
                                                         (= (str/lower-case (:label c)) (str/lower-case ans-text))))
                                             choices))
                              (first choices))]
              {:status :success
               :suggested_next_ids [(:to matched)]
               :preferred_label (:label matched)
               :context_updates {"human.gate.selected" (:key matched)
                                 "human.gate.label" (:label matched)}})))))))

;; Parallel Handler (Section 4.8)
;; Executes multiple branches concurrently with bounded parallelism
(defn- make-parallel-handler* [execute-branch-fn pass-edge? cancellation-aware?]
  (fn [node ctx graph logs-root]
    (let [branches (filter (fn [e] (= (:from e) (:id node))) (:edges graph))
          cancelled? (or (:cancelled? node) (fn [] false))
          join-policy (or (get-in node [:attrs :join_policy]) "wait_all")
          max-parallel (let [mp (get-in node [:attrs :max_parallel])]
                         (if (and (number? mp) (> mp 0)) mp 4))]
      (if (empty? branches)
        {:status :fail :failure_reason "Parallel node has no outgoing branches"}
        (let [results
              (loop [remaining branches
                     accumulated []]
                (if (or (empty? remaining) (cancelled?))
                  accumulated
                  (let [batch (vec (take max-parallel remaining))
                        batch-results
                        (doall
                          (pmap (fn [branch-edge]
                                  (let [target-id (:to branch-edge)
                                        branch-ctx (context/ctx-clone ctx)
                                        branch-logs (str logs-root "/branches/" target-id)
                                        branch-start (if pass-edge? branch-edge target-id)
                                        result (if cancellation-aware?
                                                 (execute-branch-fn branch-start branch-ctx graph branch-logs cancelled?)
                                                 (execute-branch-fn branch-start branch-ctx graph branch-logs))]
                                    (assoc result :id target-id :node_id target-id)))
                                batch))]
                    (recur (drop max-parallel remaining)
                           (into accumulated batch-results)))))
              boundary-ids (vec (distinct (keep :boundary_node_id results)))
              next-node-id (when (= 1 (count boundary-ids)) (first boundary-ids))
              success-count (count (filter (fn [r] (= (:status r) :success)) results))
              fail-count (count (filter (fn [r] (= (:status r) :fail)) results))
              base {:context_updates {"parallel.results" (vec results)}}
              base (if next-node-id (assoc base :next_node_id next-node-id) base)]
          (if (cancelled?)
            (merge base {:status :cancelled :failure_reason "Pipeline cancelled"})
            (if (= join-policy "first_success")
            (if (> success-count 0)
              (merge base {:status :success :notes "Parallel first_success satisfied"})
              (merge base {:status :fail :failure_reason "All parallel branches failed"}))
            (if (= fail-count 0)
              (merge base {:status :success :notes "All parallel branches succeeded"})
              (merge base {:status :partial_success
                           :notes (str fail-count " parallel branch(es) failed")})))))))))

(defn make-parallel-handler
  ([execute-branch-fn]
   (make-parallel-handler* execute-branch-fn false false))
  ([execute-branch-fn pass-edge?]
   (make-parallel-handler* execute-branch-fn pass-edge? false))
  ([execute-branch-fn pass-edge? cancellation-aware?]
   (make-parallel-handler* execute-branch-fn pass-edge? cancellation-aware?)))

;; Fan-In Handler (Section 4.9)
(defn handle-fan-in [node ctx _graph _logs-root]
  (let [results (context/ctx-get ctx "parallel.results" [])]
    (if (empty? results)
      {:status :fail :failure_reason "No parallel results to evaluate"}
      (let [eligible (filter (fn [r] (#{:success :partial_success} (:status r))) results)]
        (if (empty? eligible)
          {:status :fail :failure_reason "All parallel branches failed"}
          ;; Prefer SUCCESS over PARTIAL_SUCCESS; use candidate ID as the
          ;; deterministic tiebreak when no explicit scoring backend exists.
          (let [status-rank {:success 0 :partial_success 1}
                sorted-candidates
                (sort-by (fn [r]
                           [(get status-rank (:status r) 9)
                            (str (or (:id r) (:node_id r) ""))])
                         eligible)
                best (first sorted-candidates)
                best-id (or (:id best) (:node_id best) "winner")]
            {:status :success
             :context_updates {"parallel.fan_in.best_id" best-id
                               "parallel.fan_in.best_outcome" (str (:status best))}
             :notes (str "Selected best candidate: " best-id)}))))))

;; Manager Loop Handler (Section 4.11). Runtime callbacks keep child
;; orchestration injectable and avoid a handlers -> engine dependency cycle.
(defn- runtime-value [runtime]
  (if (map? runtime) runtime @runtime))

(defn- setting-true? [value default-value]
  (if (nil? value)
    default-value
    (or (= true value)
        (= "true" (str/lower-case (str value))))))

(defn- manager-setting [node graph key default-value]
  (let [node-attrs (or (:attrs node) {})
        graph-attrs (or (:attrs graph) {})]
    (cond
      (contains? node-attrs key) (get node-attrs key)
      (contains? graph-attrs key) (get graph-attrs key)
      :else default-value)))

(defn- manager-actions [value]
  (set (map (fn [action] (str/lower-case (str/trim action)))
            (str/split (str value) #","))))

(defn- manager-int [value default-value]
  (cond
    (number? value) (long value)
    (string? value) (or (parse-long value) default-value)
    :else default-value))

(defn- telemetry-string [value]
  (if (keyword? value) (name value) (str value)))

(defn- ingest-child-telemetry! [ctx telemetry]
  (doseq [[key value] (or (:context_updates telemetry) {})]
    (context/ctx-set! ctx key value))
  (doseq [[source-key suffix]
          [[:status "status"]
           [:outcome "outcome"]
           [:active_stage "active_stage"]
           [:node_outcomes "node_outcomes"]
           [:retry_counts "retry_counts"]
           [:artifacts "artifacts"]]]
    (when (contains? telemetry source-key)
      (let [value (get telemetry source-key)]
        (context/ctx-set!
          ctx (str "context.stack.child." suffix)
          (if (#{:status :outcome} source-key)
            (telemetry-string value)
            value)))))
  telemetry)

(defn make-manager-loop-handler [runtime]
  (fn [node ctx graph logs-root]
    (try
      (let [callbacks (runtime-value runtime)
            child-dotfile (manager-setting node graph :stack.child_dotfile nil)
            autostart? (setting-true?
                         (manager-setting node graph :stack.child_autostart true)
                         true)
            poll-value (manager-setting node graph :manager.poll_interval "45s")
            parsed-poll (parser/parse-duration-ms poll-value)
            poll-ms (if (number? parsed-poll) parsed-poll 45000)
            cooldown-value (manager-setting node graph
                                            :manager.steer_cooldown poll-value)
            parsed-cooldown (parser/parse-duration-ms cooldown-value)
            cooldown-ms (if (number? parsed-cooldown)
                          parsed-cooldown poll-ms)
            max-cycles (max 1 (manager-int
                                (manager-setting node graph
                                                 :manager.max_cycles 1000)
                                1000))
            stop-condition (str
                             (manager-setting node graph
                                              :manager.stop_condition ""))
            actions (manager-actions
                      (manager-setting node graph :manager.actions
                                       "observe,wait"))
            start-child (:start-child callbacks)
            runtime-cancelled? (or (:cancelled? callbacks) (fn [] false))
            cancelled? (fn [] (or (runtime-cancelled?)
                                  (when-let [attempt-cancelled? (:cancelled? node)]
                                    (attempt-cancelled?))))
            stop-child (:stop-child callbacks)
            now-fn (or (:now-fn callbacks) #(System/currentTimeMillis))
            sleep-fn (or (:sleep-fn callbacks) core/sleep)
            cooperative-sleep
            (fn [duration]
              (loop [remaining duration]
                (when (and (> remaining 0) (not (cancelled?)))
                  (let [chunk (min remaining 100)]
                    (sleep-fn chunk)
                    (recur (- remaining chunk))))))
            existing-child (or (:child callbacks)
                               (when-let [get-child (:get-child callbacks)]
                                 (get-child)))
            validation-error
            (cond
              (and autostart? (str/blank? (str child-dotfile)))
              "Manager child dotfile is required"
              (and autostart? (nil? start-child))
              "Manager child runtime is not configured"
              (and (not autostart?) (nil? existing-child))
              "Manager child is not available"
              :else nil)]
        (if validation-error
          {:status :fail :failure_reason validation-error}
          (let [child-logs (str logs-root "/" (:id node) "/child")
                child-node (assoc node :cancelled? cancelled?)
                child (if autostart?
                        (start-child child-dotfile child-logs child-node)
                        existing-child)
                stop-owned-child
                (fn []
                  (when (and autostart? stop-child)
                    (stop-child child)))]
            (loop [cycle 1
                   last-steered-at nil]
              (if (cancelled?)
                (do
                  (stop-owned-child)
                  {:status :cancelled
                   :failure_reason "Pipeline cancelled"})
                (let [observation
                      (if (contains? actions "observe")
                        (if-let [observe-child (:observe-child callbacks)]
                          (or (observe-child child) {})
                          {})
                        {})
                      _ (ingest-child-telemetry! ctx observation)
                      child-status
                      (context/ctx-get-string
                        ctx "context.stack.child.status" "")
                      child-outcome
                      (context/ctx-get-string
                        ctx "context.stack.child.outcome" "")
                      stop-satisfied?
                      (and (not (str/blank? stop-condition))
                           (conditions/evaluate-condition
                             stop-condition {:status :success} ctx))]
                  (cond
                    (and (= child-status "completed")
                         (= child-outcome "success"))
                    {:status :success :notes "Child completed"}

                    (or (= child-status "failed")
                        (and (= child-status "completed")
                             (not= child-outcome "success")))
                    {:status :fail
                     :failure_reason (or (:failure_reason observation)
                                         "Child failed")}

                    stop-satisfied?
                    (do
                      (stop-owned-child)
                      {:status :success :notes "Stop condition satisfied"})

                    (>= cycle max-cycles)
                    (do
                      (stop-owned-child)
                      {:status :fail :failure_reason "Max cycles exceeded"})

                    :else
                    (let [now (when (contains? actions "steer") (now-fn))
                          steer-ready?
                          (and now
                               (or (nil? last-steered-at)
                                   (>= (- now last-steered-at) cooldown-ms)))
                          next-last-steered-at
                          (if steer-ready?
                            (do
                              (when-let [steer-child (:steer-child callbacks)]
                                (steer-child child node ctx))
                              now)
                            last-steered-at)]
                      (when (contains? actions "wait")
                        (cooperative-sleep poll-ms))
                      (recur (inc cycle) next-last-steered-at)))))))))
      (catch Object e
        {:status :fail
         :failure_reason (str "Manager loop failed: " e)}))))

(def handle-manager-loop (make-manager-loop-handler {}))

;; Handler Registry (Section 4.2)
(defn make-handler-registry
  ([] (make-handler-registry (interviewer/make-auto-approve-interviewer) nil))
  ([interviewer codergen-backend]
   (let [branch-executor (atom nil)
         manager-runtime (atom {})
         parallel-handler
         (make-parallel-handler
           (fn [branch-edge branch-ctx graph logs-root branch-cancelled?]
             (if-let [execute-fn @branch-executor]
               (execute-fn branch-edge branch-ctx graph logs-root branch-cancelled?)
               {:status :fail
                :failure_reason "Parallel branch executor is not initialized"}))
           true true)
         manager-handler (make-manager-loop-handler manager-runtime)]
     (atom {"start" handle-start
            "exit" handle-exit
            "codergen" (make-codergen-handler codergen-backend)
            "wait.human" (make-wait-human-handler interviewer)
            "conditional" handle-conditional
            "tool" handle-tool
            "parallel" parallel-handler
            "parallel.fan_in" handle-fan-in
            "stack.manager_loop" manager-handler
            parallel-executor-key branch-executor
            manager-runtime-key manager-runtime
            parallel-default-handler-key parallel-handler
            manager-default-handler-key manager-handler}))))

;; Register a custom handler
(defn register-handler! [registry type-str handler-fn]
  (swap! registry assoc (str type-str) handler-fn)
  registry)

;; Resolve handler for a node (Section 4.2):
;; 1. Explicit type attribute
;; 2. Shape-based mapping
;; 3. Default handler (codergen)
(defn resolve-handler [registry node]
  (let [reg @registry
        explicit-type (:type node)
        shape-type (get shape-to-type (or (:shape node) "box"))
        default-handler (get reg "codergen")]
    (or (when (and (not (str/blank? explicit-type)) (contains? reg explicit-type))
          (get reg explicit-type))
        (when (and (not (str/blank? shape-type)) (contains? reg shape-type))
          (get reg shape-type))
        default-handler)))
