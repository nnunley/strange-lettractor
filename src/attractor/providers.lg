(ns attractor.providers
  "Provider registry: which providers exist, which wire protocol each speaks,
   its base URL, which environment variable holds its key, and whether its
   `/models` endpoint can be queried.

   Sources, lowest to highest precedence:
   1. built-in definitions (openai, anthropic, gemini, openai-compat)
   2. user file   $XDG_CONFIG_HOME/attractor/attractor.edn
                  (default ~/.config/attractor/attractor.edn)
   3. project file <cwd>/attractor.edn, or the path in ATTRACTOR_CONFIG
   4. environment <ID>_BASE_URL and <ID>_API_KEY (or the entry's :api_key_env)
   5. explicit values passed by the caller

   Files are data only: read with clojure.edn in data mode and validated
   against the keys below. An entry may name the environment variable that
   holds its key (:api_key_env) or hold the key or bearer token itself
   (:api_key). A file that holds a key must be readable by its owner only;
   otherwise it is refused with a chmod hint."
  (:require [clojure.string :as str]
            [clojure.edn :as edn]
            [io :as io]
            [os :as os]))

(def protocols
  #{:openai-responses :anthropic-messages :gemini-generate-content :openai-chat-completions})

(def built-in
  {"openai" {:protocol :openai-responses
             :base_url "https://api.openai.com/v1"
             :api_key_env "OPENAI_API_KEY"
             :model_discovery true}
   "anthropic" {:protocol :anthropic-messages
                :base_url "https://api.anthropic.com/v1"
                :api_key_env "ANTHROPIC_API_KEY"
                :model_discovery true}
   "gemini" {:protocol :gemini-generate-content
             :base_url "https://generativelanguage.googleapis.com/v1beta"
             :api_key_env ["GEMINI_API_KEY" "GOOGLE_API_KEY"]
             :model_discovery true}
   ;; Spec §7.10: no canonical host, so the base URL must be configured.
   "openai-compat" {:protocol :openai-chat-completions
                    :base_url nil
                    :api_key_env "OPENAI_COMPAT_API_KEY"
                    :model_discovery true}})

(def entry-keys #{:protocol :base_url :api_key :api_key_env :model_discovery})
;; Other secret-shaped keys are rejected by name so a typo cannot hide a key
;; under an ignored field.
(def secret-keys #{:key :token :bearer :secret :password :credential})

(defn- configuration-error [message data]
  (ex-info message (merge {:category :configuration :retryable false} data)))

(defn env-name
  "Environment variable name derived from a provider id: `openai-compat` and
   `_BASE_URL` give `OPENAI_COMPAT_BASE_URL`."
  [id suffix]
  (str (str/replace (str/upper-case (str id)) "-" "_") suffix))

(defn- present [value] (when (and (string? value) (not (str/blank? value))) (str/trim value)))

(defn- strip-slash [url]
  (let [u (str/trim url)]
    (if (str/ends-with? u "/") (subs u 0 (dec (count u))) u)))

(defn- env-var-name? [value]
  (and (string? value) (some? (re-matches #"[A-Z][A-Z0-9_]*" value))))

(defn validate-entry
  "Validate one provider entry from a file. Returns the normalized entry or
   throws a :configuration error naming the file, provider and problem. The
   error messages never repeat a value."
  [source id entry]
  (let [allowed entry-keys
        fail (fn [problem] (throw (configuration-error
                                    (str "attractor.edn " source ": provider " (pr-str id) " " problem)
                                    {:source source :provider id})))]
    (when-not (and (string? id) (re-matches #"[a-z0-9][a-z0-9-]*" id))
      (fail "id must be a lowercase string of letters, digits and dashes"))
    (when-not (map? entry) (fail "must be a map"))
    (doseq [k (keys entry)]
      (when (contains? secret-keys k)
        (fail (str "must not contain " k "; hold the key or bearer token in :api_key")))
      (when-not (contains? allowed k)
        (fail (str "has unknown key " k "; allowed: " (str/join ", " (map name (sort-by name allowed)))))))
    (when-not (contains? protocols (:protocol entry))
      (fail (str ":protocol must be one of " (str/join ", " (map name (sort-by name protocols))))))
    (when (and (contains? entry :base_url) (some? (:base_url entry)) (not (present (:base_url entry))))
      (fail ":base_url must be a non-empty string or nil"))
    (when (and (contains? entry :base_url) (some? (:base_url entry))
               (not (re-find #"^https?://" (str/trim (:base_url entry)))))
      (fail ":base_url must start with http:// or https://"))
    (when (and (contains? entry :api_key_env)
               (not (or (env-var-name? (:api_key_env entry))
                        (and (vector? (:api_key_env entry)) (seq (:api_key_env entry))
                             (every? env-var-name? (:api_key_env entry))))))
      (fail (str ":api_key_env must be an environment variable NAME such as " (env-name id "_API_KEY")
                 " (a vector of names is allowed); a key value itself belongs in :api_key")))
    (when (and (contains? entry :api_key) (not (present (:api_key entry))))
      (fail ":api_key must be a non-empty string"))
    (when (and (contains? entry :model_discovery) (not (boolean? (:model_discovery entry))))
      (fail ":model_discovery must be true or false"))
    (cond-> {:protocol (:protocol entry)
             :base_url (when (present (:base_url entry)) (strip-slash (:base_url entry)))
             :api_key_env (or (:api_key_env entry) (env-name id "_API_KEY"))
             :model_discovery (if (contains? entry :model_discovery) (:model_discovery entry) true)
             :source source}
      (present (:api_key entry)) (assoc :api_key (str/trim (:api_key entry))))))

(defn- reader-position
  "Line and column from a reader error, without the offending token: a
   configuration file may contain a key, and it must never be echoed."
  [message]
  (if-let [[_ line col] (re-find #":(\d+):(\d+)\)" (str message))]
    (str "line " line ", column " col)
    "unknown position"))

(defn parse-config
  "Parse one attractor.edn text into {id entry}. Only the :providers key is
   understood; anything else is an error so typos cannot silently disappear."
  [source text]
  (let [forms (try (edn/read-all-string (str text))
                   (catch Object e (throw (configuration-error
                                            (str "attractor.edn " source " is not readable EDN at "
                                                 (reader-position (ex-message e))
                                                 " (check quotes and brackets near there)")
                                            {:source source}))))
        _ (when (not= 1 (count forms))
            (throw (configuration-error (str "attractor.edn " source " must contain exactly one map") {:source source})))
        config (first forms)]
    (when-not (map? config)
      (throw (configuration-error (str "attractor.edn " source " must be a map") {:source source})))
    (doseq [k (keys config)]
      (when-not (= :providers k)
        (throw (configuration-error (str "attractor.edn " source " has unknown top-level key " k "; only :providers is supported")
                                    {:source source}))))
    (let [providers (get config :providers {})]
      (when-not (map? providers)
        (throw (configuration-error (str "attractor.edn " source ": :providers must be a map of id to entry") {:source source})))
      (into {} (map (fn [[id entry]] [(str id) (validate-entry source (str id) entry)]) providers)))))

(defn- file-mode
  "Octal permission string of a file, or nil when it cannot be determined."
  [path]
  (let [attempt (fn [& args] (let [r (try (apply os/sh args) (catch Object _ nil))]
                               (when (and r (= 0 (:exit r))) (str/trim (:out r)))))]
    (or (attempt "/usr/bin/stat" "-f" "%Lp" path)
        (attempt "/usr/bin/stat" "-c" "%a" path)
        (attempt "stat" "-c" "%a" path))))

(defn- require-private! [path]
  (when-let [mode (file-mode path)]
    ;; Octal text: the last two digits are the group and other bits.
    (let [shared (take-last 2 mode)]
      (when (some #(not= \0 %) shared)
        (throw (configuration-error
                 (str "attractor.edn " path " holds keys but is readable by others (mode " mode "); run: chmod 600 " path)
                 {:source path}))))))

(defn user-config-path []
  (let [xdg (present (os/getenv "XDG_CONFIG_HOME"))
        home (present (os/getenv "HOME"))]
    (cond xdg (str (strip-slash xdg) "/attractor/attractor.edn")
          home (str (strip-slash home) "/.config/attractor/attractor.edn")
          :else nil)))

(defn project-config-path []
  (or (present (os/getenv "ATTRACTOR_CONFIG"))
      (str (os/cwd) "/attractor.edn")))

(defn- read-file
  "Read one file. A file that holds :api_key values must be private to its
   owner."
  [path]
  (when (and path (os/stat path))
    (let [parsed (parse-config path (io/slurp path))]
      (when (some :api_key (vals parsed))
        (require-private! path))
      parsed)))

(defn load-registry
  "Merge built-ins, the user file and the project file (in that order). Pass
   :paths to override the file list, e.g. in tests."
  [& [{:keys [paths]}]]
  (let [files (or paths [(user-config-path) (project-config-path)])
        built (into {} (map (fn [[id e]] [id (assoc e :source :built-in)]) built-in))]
    (reduce (fn [registry path]
              (merge registry (or (read-file path) {})))
            built
            files)))

(defonce ^:private registry (atom nil))

(defn reload!
  "Re-read configuration files. Returns the registry."
  [& [options]]
  (reset! registry (load-registry options)))

(defn definitions []
  (or @registry (reload!)))

(defn definition [id]
  (when id (get (definitions) (str/lower-case (str id)))))

(defn protocol-of
  "Wire protocol for a provider id; :mock for the mock provider; nil when the
   id is not configured."
  [id]
  (let [p (str/lower-case (str id))]
    (if (= p "mock") :mock (:protocol (definition p)))))

(defn ids [] (vec (sort (keys (definitions)))))

(defn- env-get [env-fn name] (present (env-fn name)))

(defn base-url
  "Effective base URL: explicit value, <ID>_BASE_URL, then the definition.
   nil when nothing is configured."
  [id & [explicit env-fn]]
  (let [get-env (or env-fn os/getenv)
        p (str/lower-case (str id))]
    (or (when (present explicit) (strip-slash explicit))
        (when-let [u (env-get get-env (env-name p "_BASE_URL"))] (strip-slash u))
        (:base_url (definition p)))))

(defn key-env-names
  "Environment variable names consulted for a provider's key, in order."
  [id]
  (let [p (str/lower-case (str id))
        configured (:api_key_env (definition p))
        names (cond (nil? configured) []
                    (string? configured) [configured]
                    :else (vec configured))]
    (vec (distinct (concat [(env-name p "_API_KEY")] names)))))

(defn api-key
  "Effective API key: explicit value, the first present variable from
   key-env-names, then a key held in a config file. nil when none is set."
  [id & [explicit env-fn]]
  (let [get-env (or env-fn os/getenv)]
    (or (present explicit)
        (some (fn [name] (env-get get-env name)) (key-env-names id))
        (:api_key (definition id)))))

(defn key-source
  "Where the effective key comes from: :environment, :file or nil."
  [id & [env-fn]]
  (let [get-env (or env-fn os/getenv)]
    (cond (some (fn [name] (env-get get-env name)) (key-env-names id)) :environment
          (:api_key (definition id)) :file
          :else nil)))

(defn model-discovery? [id]
  (boolean (:model_discovery (definition id))))

(defn effective
  "One row per configured provider with its effective values and sources,
   for `attractor providers`. Keys are never printed, only their presence."
  [& [env-fn]]
  (let [get-env (or env-fn os/getenv)]
    (mapv (fn [id]
            (let [d (definition id)]
              {:id id
               :protocol (:protocol d)
               :base_url (base-url id nil get-env)
               :base_url_source (cond (env-get get-env (env-name id "_BASE_URL")) :environment
                                      (:base_url d) (:source d)
                                      :else :unset)
               :api_key_env (key-env-names id)
               :key_present (some? (api-key id nil get-env))
               :key_source (key-source id get-env)
               :model_discovery (:model_discovery d)
               :source (:source d)}))
          (ids))))
