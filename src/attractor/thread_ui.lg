(ns attractor.thread-ui "Self-contained same-origin conversation workbench.")

(def page
  (str
    "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Attractor conversations</title>\n"
    "<style>\n"
    "*{box-sizing:border-box}body{margin:0;height:100vh;height:100dvh;display:grid;grid-template-rows:auto minmax(0,1fr);font:16px system-ui;background:#f7f6f2;color:#242b2a}header{padding:16px 24px;background:#193f3b;color:white}main{display:grid;grid-template-columns:280px minmax(0,1fr);min-height:0}aside{padding:20px;border-right:1px solid #ccc;display:flex;flex-direction:column;min-height:0}section{padding:20px 24px;min-width:0;min-height:0;display:flex;flex-direction:column;gap:8px}h1{font-size:22px;line-height:1.3;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}#metadata{font-size:12px;color:#52635d;overflow-wrap:anywhere}button,select,textarea{font:inherit;padding:9px;border:1px solid #aaa;border-radius:5px}button{cursor:pointer;background:white}button[aria-current=true]{background:#d7eee5}#tree{overflow:auto;min-height:0;margin-top:10px}#tree button{display:block;max-width:100%;text-align:left;margin:6px 0;overflow-wrap:anywhere}article{background:white;border:1px solid #ddd;margin:10px 0;padding:14px;border-radius:8px}pre{white-space:pre-wrap;overflow-wrap:anywhere}#compose{flex:none;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;width:100%}#compose label,textarea{grid-column:1/-1}textarea{width:100%;height:76px;min-height:50px;max-height:20vh;resize:vertical}select{min-width:0;max-width:100%}#status,#persistence{color:#804100;font-size:14px;overflow-wrap:anywhere}#status:empty,#persistence:empty{display:none}summary{cursor:pointer}#transcript{flex:1;min-height:0;overflow:auto}#controls{flex:none;display:flex;gap:8px}\n"
    "@media(max-width:700px){body{height:auto;min-height:100dvh;display:block}main{display:block}aside{border:0;padding:12px 16px}section{padding:16px;min-height:65vh}#tree{max-height:140px}#transcript{flex:auto;min-height:160px;max-height:55vh}h1{font-size:20px}textarea{max-height:30vh}}\n"
    "</style>\n"
    "<header>Attractor · Conversations</header><main><aside><button id=\"new\">New conversation</button><nav id=\"tree\" aria-label=\"Conversation threads\"></nav></aside><section><h1 id=\"title\">New conversation</h1><div id=\"metadata\"></div><div id=\"status\" role=\"status\"></div><div id=\"persistence\" role=\"status\"></div><div id=\"controls\"><button id=\"cancel\" disabled>Cancel work</button> <button id=\"resume\" disabled>Resume archive</button></div><div id=\"transcript\" aria-label=\"Transcript\"></div><form id=\"compose\"><label for=\"draft\">Message</label><textarea id=\"draft\" required placeholder=\"Type a message. Enter to send; Shift+Enter for a newline.\"></textarea><select id=\"behavior\" aria-label=\"Input behavior\"><option value=\"steer\">Steer at next boundary</option><option value=\"followup\">Follow up after current work</option></select> <button id=\"send\">Send</button></form></section></main>\n"
    "<script>\n"
    "const $=id=>document.getElementById(id);let selected=null,lastSnapshot='',refreshing=false,selectionReady=false,selectedArchived=false,sending=false;\n"
    "function selectThread(id){selected=id;lastSnapshot='';selectionReady=false;$('send').disabled=true;$('cancel').disabled=true;$('resume').disabled=true;$('title').textContent='Loading conversation…';$('metadata').textContent=id;$('persistence').textContent='';$('transcript').replaceChildren()}\n"
    "function node(tag,text){const e=document.createElement(tag);e.textContent=text;return e}\n"
    "function report(e){$('status').textContent=e.message||String(e)}\n"
    "async function api(path,body){const options={credentials:'same-origin'};if(body!==undefined){options.method='POST';options.headers={'Content-Type':'application/json'};options.body=JSON.stringify(body)}const r=await fetch(path,options);const v=await r.json();if(!r.ok)throw Error(v.error+(v.outcome_unknown?' (outcome unknown; inspect before retrying)':''));return v}\n"
    "function path(id){return '/threads/'+encodeURIComponent(id)}\n"
    "function details(parent,label,value,id,type){const d=node('details','');d.dataset.type=type;d.dataset.id=id||'';d.append(node('summary',label),node('pre',typeof value==='string'?value:JSON.stringify(value,null,2)));parent.append(d)}\n"
    "function transcript(t){const signature=JSON.stringify(t);if(signature===lastSnapshot)return;lastSnapshot=signature;const area=$('transcript'),bottom=area.scrollHeight-area.scrollTop-area.clientHeight<40;const expanded=new Set(Array.from(area.querySelectorAll('details[open]')).map(e=>e.dataset.id+e.dataset.type));area.replaceChildren();$('title').textContent=t.task||'Conversation';$('title').title=t.task||'Conversation';$('metadata').textContent=[t.thread_id,t.model,t.state,t.archived?'archive':null].filter(Boolean).join(' · ');$('persistence').textContent=t.persistence_error?'Conversation could not be saved: '+(typeof t.persistence_error==='string'?t.persistence_error:JSON.stringify(t.persistence_error)):'';selectionReady=true;selectedArchived=!!t.archived;$('send').disabled=selectedArchived||sending;$('cancel').disabled=!!t.archived;$('resume').disabled=!t.archived;\n"
    "for(const turn of t.history||[]){const row=node('article','');row.append(node('strong',turn.role||turn.type||'message'));if(turn.content)row.append(node('pre',typeof turn.content==='string'?turn.content:JSON.stringify(turn.content,null,2)));for(const call of turn.tool_calls||[])details(row,'Tool call · '+(call.name||call.function?.name||'tool')+' · '+call.id,call,call.id,'tool-call');for(const result of turn.results||[])details(row,'Tool result · '+result.tool_call_id,result,result.tool_call_id,'tool-result');area.append(row)}\n"
    "for(const pending of t.pending||[])area.append(node('article','Queued '+(pending.behavior||'input')+': '+pending.text));for(const e of area.querySelectorAll('details'))e.open=expanded.has(e.dataset.id+e.dataset.type);if(bottom)area.scrollTop=area.scrollHeight}\n"
    "function tree(threads){const nav=$('tree');nav.replaceChildren();const seen=new Set();function add(t,depth){if(seen.has(t.thread_id))return;seen.add(t.thread_id);const b=node('button',(t.task||'Conversation')+' · '+t.state+(t.archived?' · archive':''));b.title=t.thread_id;b.dataset.type='thread';b.dataset.id=t.thread_id;b.style.marginLeft=Math.min(depth,8)*12+'px';b.setAttribute('aria-current',String(t.thread_id===selected));b.onclick=()=>{selectThread(t.thread_id);refresh()};nav.append(b);for(const child of threads.filter(c=>c.parent_id===t.thread_id))add(child,depth+1)}for(const t of threads.filter(t=>!t.parent_id||!threads.some(p=>p.thread_id===t.parent_id)))add(t,0);for(const t of threads)add(t,0)}\n"
    "async function refresh(){if(refreshing)return;refreshing=true;try{const threads=await api('/threads');tree(threads);const id=selected;if(id){const t=await api(path(id));if(id===selected)transcript(t)}}catch(e){report(e)}finally{refreshing=false}}\n"
    "async function action(f){try{$('status').textContent='';await f();await refresh()}catch(e){report(e)}}\n"
    "$('new').onclick=()=>action(async()=>{const t=await api('/threads',{});selectThread(t.thread_id||t.session_id)});\n"
    "$('cancel').onclick=()=>action(()=>api(path(selected)+'/cancel',{}));\n"
    "$('resume').onclick=()=>action(async()=>{const t=await api(path(selected)+'/resume',{});selectThread(t.thread_id)});\n"
    "$('compose').onsubmit=e=>{e.preventDefault();if(sending||(selected&&(!selectionReady||selectedArchived)))return;let id=selected;const text=$('draft').value,behavior=$('behavior').value;if(!text.trim())return;sending=true;$('send').disabled=true;action(async()=>{if(!id){const t=await api('/threads',{});id=t.thread_id||t.session_id;selectThread(id)}await api(path(id)+'/messages',{text,behavior});if($('draft').value===text)$('draft').value='';lastSnapshot=''}).finally(()=>{sending=false;$('send').disabled=!!selected&&(!selectionReady||selectedArchived)})};\n"
    "$('draft').onkeydown=e=>{if(e.key==='Enter'&&!e.shiftKey&&!e.isComposing){e.preventDefault();$('compose').requestSubmit()}};\n"
    "refresh();setInterval(refresh,1000);\n"
    "</script></html>\n"
  ))
