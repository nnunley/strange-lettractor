(ns attractor.hub
  (:require [attractor.ids :as ids] [clojure.core :as core] [async :as async] [clojure.string :as str]
            [attractor.agent :as agent] [attractor.pipeline :as pipeline]
            [attractor.interviewer :as interviewer]
            [attractor.agents.registry :as registry]))

(defn- locked [lock f]
  (loop [] (when-not (compare-and-set! lock false true) (core/sleep 1) (recur)))
  (try (f) (finally (reset! lock false))))
(defn- fail! [category] (throw (ex-info (name category) {:category category})))
(defn- fresh-id [prefix] (ids/prefixed prefix))
(defn- error-data [error]
  {:category (or (:category (ex-data error)) :hub-error) :message (ex-message error)})
(defn- reply! [packet result] (deliver (:reply packet) (assoc result :id (:id (:request packet)))))
(defn- append-envelope! [hub envelope]
  ;; Every source (session, eval, workflow, agent) shares one bounded log and
  ;; one sequence so a client sees interleaved events in emission order.
  (locked (:event_lock hub)
    (fn []
      (let [log @(:log hub) seq (inc (:cursor log))
            events (conj (:events log) (assoc envelope :seq seq))
            excess (- (count events) (:event_capacity hub))]
        (reset! (:log hub) (assoc log :cursor seq :events (if (pos? excess) (subvec events excess) events)))))))
(defn- append-event! [hub id event]
  (append-envelope! hub {:source :session :session_id id
                         :turn_id (:hub_turn_id (:origin event)) :event event}))

(defn events-since [hub client-id cursor]
  (locked (:event_lock hub)
    (fn []
      (let [{:keys [events clients] newest :cursor} @(:log hub)]
        (when-not (contains? clients client-id) (fail! :unknown-client))
        (when-not (and (integer? cursor) (<= 0 cursor newest)) (fail! :invalid-cursor))
        (when (and (seq events) (< cursor (dec (:seq (first events))))) (fail! :cursor-expired))
        {:cursor newest :events (vec (filter #(> (:seq %) cursor) events))}))))

(defn- entry! [hub id]
  (or (get @(:sessions hub) id) (fail! :unknown-session)))
(defn- launch! [f & [publisher completion]]
  ;; Callers that must register an entry before the work can complete pass
  ;; their own completion promise and register it first.
  (let [completion (or completion (promise)) publish (or publisher deliver)]
    (try
      (core/future (publish completion (try {:value (f)} (catch Object e {:error (error-data e)}))))
      (catch Object e (publish completion {:error (error-data e)})))
    completion))
(defn- cancel-entry! [hub entry]
  ;; Cancellation and final result publication share one linearization lock.
  ;; Abort/cleanup may invoke listeners, so always launch it after releasing.
  ;; Capture the unfinished target turn's ID under that same lock; completed or
  ;; idle sessions have no unfinished turn, so their close binds nil origin.
  (let [turn-id (locked (:event_lock hub)
                  (fn []
                    (reset! (:closed entry) true)
                    (let [turn (:turn entry)]
                      (when (and turn (not (realized? (:completion turn))))
                        (:turn_id turn)))))]
    (or @(:cancellation entry)
        (let [completion (launch! #(binding [agent/*event-origin* (when turn-id {:hub_turn_id turn-id})]
                                      (agent/abort-session! (:agent entry))
                                      {:cancelled true}))]
          (reset! (:cancellation entry) completion)
          completion))))

(def ^:private user-ns-counter (atom 0))
(defn- user-ns-name
  ;; The first hub in a process owns the documented `attractor.console.user`
  ;; namespace; later hubs (tests, embedded use) get their own so helpers and
  ;; definitions never leak between hubs.
  []
  (let [n (swap! user-ns-counter inc)]
    (if (= 1 n) 'attractor.console.user (symbol (str "attractor.console.user" n)))))
(def ^:private eval-lock (atom false))
(defn- eval-in-user-ns! [hub code session-id run-id]
  ;; let-go's `*ns*` is process-global and `binding` does not restore it, so
  ;; switch explicitly and restore in finally under one process-wide lock:
  ;; the busy flag serializes evaluations within a hub, the lock across hubs.
  (let [ns (:user_ns hub)]
    (intern ns '*session* session-id)
    (intern ns '*run* run-id)
    (locked eval-lock
      (fn []
        (let [saved (ns-name *ns*)]
          (try
            (in-ns (ns-name ns))
            (let [forms (read-string (str "[" code "\n]"))
                  holder (atom nil)
                  printed (with-out-str (reset! holder (reduce (fn [_ form] (eval form)) nil forms)))]
              {:value @holder :printed printed})
            (finally (in-ns saved))))))))

(defn- finish-under-lock! [hub f]
  (locked (:event_lock hub) f))

(defn- question-entry! [hub id]
  (or (get @(:questions hub) id) (fail! :unknown-question)))

(defn- ask-through-hub!
  "Publish a question as a hub event and wait for :question/answer, honoring
   timeout_seconds with a deadline on the answer promise and releasing on run
   cancellation. Never touches stdin."
  [hub run-id cancelled? question]
  (let [id (fresh-id "question") answer (promise)
        deadline (when-let [seconds (:timeout_seconds question)]
                   (+ (System/currentTimeMillis) (long (* 1000.0 (double seconds)))))]
    (swap! (:questions hub) assoc id {:question_id id :run_id run-id :question question :answer answer})
    (append-envelope! hub {:source :question :question_id id :run_id run-id
                           :event {:type :question :question question}})
    (let [result (loop []
                   (let [value (deref answer 50 ::pending)]
                     (cond
                       (not= ::pending value) value
                       (cancelled?) {:value :skipped :text "run cancelled"}
                       (and deadline (>= (System/currentTimeMillis) deadline))
                       (or (:default question) {:value :timeout})
                       :else (recur))))]
      (swap! (:questions hub) dissoc id)
      (append-envelope! hub {:source :question :question_id id :run_id run-id
                             :event {:type :answered :answer result}})
      result)))

(deftype HubInterviewer [hub runid cancelled]
  ;; let-go's deftype rewrites field references in call forms but not inside
  ;; map literals, so each method binds the fields it needs first.
  interviewer/IInterviewer
  (ask [_ question] (ask-through-hub! hub runid cancelled question))
  (ask-multiple [this questions] (vec (map (fn [q] (interviewer/ask this q)) questions)))
  (inform [_ message stage]
    (let [h hub r runid]
      (append-envelope! h {:source :question :run_id r
                           :event {:type :inform :message message :stage stage}}))))

(defn- workflow-entry! [hub id]
  (or (get @(:workflows hub) id) (fail! :unknown-run)))
(defn- agent-entry! [hub id]
  (or (get @(:agents hub) id) (fail! :unknown-agent-job)))

(defn- operation! [hub request]
  (case (:op request)
    :eval/submit
    (let [code (:code request)]
      (when-not (string? code) (fail! :invalid-request))
      (when (:busy @(:eval hub)) (fail! :busy))
      (swap! (:eval hub) assoc :busy true)
      (let [eval-id (fresh-id "eval")
            base {:source :eval :eval_id eval-id :session_id (:session_id request) :run_id (:run_id request)}
            _ (append-envelope! hub (assoc base :event {:type :eval_start :code code}))
            completion
            (launch! (fn []
                       (try (eval-in-user-ns! hub code (:session_id request) (:run_id request))
                            (catch Object e
                              (throw (ex-info (str e) {:category :eval-error :cause (ex-data e)})))))
                     (fn [done result]
                       ;; The event lock is not reentrant: publish the result
                       ;; event first, then flip busy and deliver under it.
                       (append-envelope! hub (assoc base :event (if (:error result)
                                                                 {:type :eval_result :status :error :error (:error result)}
                                                                 {:type :eval_result :status :ok :value (:value (:value result))
                                                                  :printed (:printed (:value result))})))
                       (finish-under-lock! hub
                         (fn []
                           (swap! (:eval hub) assoc :busy false)
                           (deliver done result)))))]
        {:eval_id eval-id :completion completion}))
    :workflow/run
    (let [source (:dot_source request)]
      (when-not (string? source) (fail! :invalid-request))
      (when-not (:workflow_registry_fn hub) (fail! :workflows-unavailable))
      (let [run-id (fresh-id "run") cancelled (atom false) completion (promise)
            base {:source :workflow :run_id run-id}
            emit (fn [event] (append-envelope! hub (assoc base :event event)))
            ;; The registry factory receives a hub-backed interviewer bound to
            ;; this run; it may still choose auto-approve.
            registry ((:workflow_registry_fn hub)
                      (assoc request :interviewer (->HubInterviewer hub run-id (fn [] @cancelled))))
            ;; Register before launching so a fast failure cannot publish
            ;; :done ahead of the entry and be overwritten.
            _ (swap! (:workflows hub) assoc run-id {:run_id run-id :cancelled cancelled :completion completion
                                                    :source_path (:source_path request) :done false})]
        (launch! (fn []
                       (let [outcome (pipeline/run source
                                       {:logs-root (:logs_root request) :source-path (:source_path request)
                                        :registry registry :on-event emit :cancelled? (fn [] @cancelled)})]
                         (if @cancelled (assoc outcome :cancelled true) outcome)))
                     (fn [done result]
                       (finish-under-lock! hub
                         (fn []
                           (swap! (:workflows hub) assoc-in [run-id :done] true)
                           (deliver done result))))
                 completion)
        {:run_id run-id :completion completion}))
    :workflow/cancel
    (let [entry (workflow-entry! hub (:run_id request))]
      (reset! (:cancelled entry) true)
      {:run_id (:run_id request) :completion (:completion entry)})
    :question/list
    (mapv (fn [[id e]] {:question_id id :run_id (:run_id e) :question (:question e)}) @(:questions hub))
    :question/answer
    (let [entry (question-entry! hub (:question_id request))
          value (or (:value request) (:text request))]
      (when-not (string? value) (fail! :invalid-request))
      ;; Claim the question atomically so a second answer is rejected even
      ;; before the waiting interviewer wakes up.
      (swap! (:questions hub) dissoc (:question_id request))
      (deliver (:answer entry) {:value value :text (or (:text request) value)})
      {:question_id (:question_id request) :answered true})
    :workflow/list
    (mapv (fn [[id e]] {:run_id id :source_path (:source_path e) :done (:done e) :cancelled @(:cancelled e)})
          @(:workflows hub))
    :agent/run
    (let [agent (try (registry/resolve-agent (:agent request)) (catch Object _ (fail! :unknown-agent)))]
      (when-not (string? (:prompt request)) (fail! :invalid-request))
      (let [job-id (fresh-id "agent") cancelled (atom false) completion (promise)
            base {:source :agent :agent agent :agent_id job-id}
            ;; Commands are trusted startup configuration per agent. :scenario is
            ;; a fixture-only argv extension a request may only add when the hub
            ;; was started allowing it.
            configured (get (:agent_commands hub) agent)
            command (cond-> configured
                      (and configured (:allow_agent_scenario hub) (:scenario request)) (conj (:scenario request)))
            options (cond-> {:prompt (:prompt request) :cancelled? (fn [] @cancelled)
                             :on_event (fn [event] (append-envelope! hub (assoc base :event event)))}
                      command (assoc :command command)
                      (:working_dir request) (assoc :working_dir (:working_dir request))
                      (:model request) (assoc :model (:model request))
                      (:tools request) (assoc :tools (:tools request))
                      (:permission_mode request) (assoc :permission_mode (:permission_mode request))
                      (:sandbox request) (assoc :sandbox (:sandbox request))
                      (:approval_policy request) (assoc :approval_policy (:approval_policy request))
                      (:timeout_ms request) (assoc :timeout_ms (:timeout_ms request)))
            _ (swap! (:agents hub) assoc job-id {:agent_id job-id :agent agent :cancelled cancelled
                                                 :completion completion :done false})]
        (launch! (fn [] (registry/run! agent options))
                     (fn [done result]
                       (finish-under-lock! hub
                         (fn []
                           (swap! (:agents hub) assoc-in [job-id :done] true)
                           (deliver done (if (and @cancelled (:error result))
                                           {:error {:category :cancelled :message "Agent job cancelled"}}
                                           result)))))
                 completion)
        {:agent_id job-id :completion completion}))
    :agent/cancel
    (let [entry (agent-entry! hub (:agent_id request))]
      (reset! (:cancelled entry) true)
      {:agent_id (:agent_id request) :completion (:completion entry)})
    :agent/list
    (mapv (fn [[id e]] {:agent_id id :agent (:agent e) :done (:done e) :cancelled @(:cancelled e)})
          @(:agents hub))
    :session/open
    (let [id (fresh-id "session")
          session (binding [agent/*event-origin* nil]
                    (agent/make-session
                      (assoc (:session_options hub) :id id :on_event #(append-event! hub id %))))
          entry {:agent session :closed (atom false) :cancellation (atom nil) :turn nil}]
      (swap! (:sessions hub) assoc id entry)
      {:session_id id})
    :session/list
    (mapv (fn [[id entry]] {:session_id id :closed (or @(:closed entry) (= :closed (:state @(:agent entry))))
                            :busy (boolean (and (:turn entry) (not (realized? (:completion (:turn entry))))))})
          @(:sessions hub))
    :session/submit
    (let [id (:session_id request) entry (entry! hub id) session (:agent entry)]
      (when (or @(:closed entry) (= :closed (:state @session))) (fail! :session-closed))
      (when (and (:turn entry) (not (realized? (:completion (:turn entry))))) (fail! :busy))
      (when-not (string? (:text request)) (fail! :invalid-request))
      (let [turn-id (fresh-id "turn")
            completion (launch! (fn []
                                  (let [output (binding [agent/*event-origin* {:hub_turn_id turn-id}]
                                                 (agent/process-input! session (:text request)))]
                                    (when (or @(:closed entry) (:abort_signaled @session)) (fail! :cancelled))
                                    output))
                         (fn [done result]
                           (locked (:event_lock hub)
                             (fn []
                               ;; Realization and final-result publication share
                               ;; event sequencing with cancellation.
                               (deliver done (if (or @(:closed entry) (:abort_signaled @session))
                                               {:error {:category :cancelled :message "Turn cancelled"}}
                                               result))))))
            turn {:session_id id :turn_id turn-id :completion completion}]
        (swap! (:sessions hub) assoc-in [id :turn] turn)
        turn))
    :session/cancel
    (let [entry (entry! hub (:session_id request))]
      {:session_id (:session_id request) :completion (cancel-entry! hub entry)})
    :client/attach
    (locked (:event_lock hub)
      (fn [] (let [id (fresh-id "client")]
               (swap! (:log hub) update :clients conj id)
               {:client_id id :cursor (:cursor @(:log hub))})))
    :client/detach
    (locked (:event_lock hub)
      (fn [] (let [id (:client_id request)]
               (when-not (contains? (:clients @(:log hub)) id) (fail! :unknown-client))
               (swap! (:log hub) update :clients disj id)
               {:client_id id :detached true})))
    (fail! :unknown-operation)))

(defn- shutdown! [hub scope failure]
  ;; The supervisor goroutine belongs to its host scope, not this child scope.
  ;; Admission is closed before draining queued replies. Never wait on workers
  ;; while holding admission/event locks, and never publish via the mailbox.
  (locked (:admission_lock hub) #(swap! (:admission hub) assoc :stopped true))
  (loop [] (when-let [packet (async/poll! (:mailbox hub))]
             (reply! packet {:error {:category :stopped}}) (recur)))
  (let [entries (vals @(:sessions hub))]
    ;; Hub-owned workflows and agent jobs stop cooperatively, then the scope
    ;; close below cancels and joins whatever they spawned.
    (doseq [e (vals @(:workflows hub))] (reset! (:cancelled e) true))
    (doseq [e (vals @(:agents hub))] (reset! (:cancelled e) true))
    (doseq [entry entries] (cancel-entry! hub entry))
    ;; Allocation of abort futures is not proof they ran. Observe actual abort
    ;; entry or a tagged failure before cancellation/drain of their native scope.
    (doseq [entry entries]
      (loop []
        (when-not (or (:abort_signaled @(:agent entry)) (realized? @(:cancellation entry)))
          (core/sleep 1) (recur))))
    (core/scope-close! scope 0)
    (let [error (or failure (first (keep #(get (deref @(:cancellation %)) :error) entries)))
          result (if error {:error error} {:value {:stopped true}})]
      (locked (:admission_lock hub)
        (fn []
          (swap! (:admission hub) assoc :done true :stop_result result)
          (doseq [packet (:stop_replies @(:admission hub))] (reply! packet result))
          (swap! (:admission hub) assoc :stop_replies []))))))

(defn request!
  "Nonblocking bounded mailbox admission. IDs correlate replies only: mutation
   retries are NOT deduplicated. Client timeouts do not revoke admitted requests."
  [hub request]
  (let [packet {:request request :reply (promise)}]
    (locked (:admission_lock hub)
      (fn []
        (let [state @(:admission hub)]
          (cond
            (not (and (map? request) (contains? request :id) (keyword? (:op request))))
            (reply! packet {:error {:category :invalid-request}})
            (= :hub/stop (:op request))
            (cond
              (:done state) (reply! packet (:stop_result state))
              (or (:stop_requested state) (:stopped state)) (swap! (:admission hub) update :stop_replies conj packet)
              (async/offer! (:mailbox hub) packet)
              (swap! (:admission hub) assoc :stop_requested true :stop_replies [packet])
              :else (reply! packet {:error {:category :mailbox-full}}))
            (:stopped state) (reply! packet {:error {:category :stopped}})
            (not (async/offer! (:mailbox hub) packet)) (reply! packet {:error {:category :mailbox-full}})))))
    (:reply packet)))

(defn- init-user-ns! [hub]
  ;; One persistent namespace for explicit human evaluation. Helpers are
  ;; interned, never read from data; user code runs with the user's authority.
  (let [ns (:user_ns hub)]
    (intern ns 'hub hub)
    (intern ns 'request! (fn [op & [fields]]
                           (deref (request! hub (merge {:id (ids/uuid-text) :op op} fields)))))
    (intern ns 'events-since (fn [client-id cursor] (events-since hub client-id cursor)))
    (intern ns '*session* nil)
    (intern ns '*run* nil)
    hub))

(defn start!
  "Start under a host scope kept alive for the service lifetime. Session options
   are trusted startup values, never remote request configuration/code."
  [opts]
  (let [capacity (get opts :event_capacity 1024) mailbox-capacity (get opts :mailbox_capacity 64)]
    (when-not (and (integer? capacity) (pos? capacity) (integer? mailbox-capacity) (pos? mailbox-capacity))
      (fail! :invalid-capacity))
    (let [ready (promise)
          hub {:event_capacity capacity :session_options (:session_options opts)
               :workflow_registry_fn (:workflow_registry_fn opts)
               ;; {:claude [argv...] :codex [argv...]}; an agent without an entry
               ;; uses its connector's default command.
               :agent_commands (or (:agent_commands opts) {})
               :allow_agent_scenario (boolean (:allow_agent_scenario opts))
               :mailbox (async/chan mailbox-capacity) :admission_lock (atom false)
               :event_lock (atom false) :admission (atom {:stop_replies []})
               :eval (atom {:busy false}) :workflows (atom {}) :agents (atom {}) :questions (atom {})
               :user_ns (create-ns (user-ns-name))
               :sessions (atom {}) :log (atom {:events [] :cursor 0 :clients #{}})}
          hub (init-user-ns! hub)]
      (try
        (core/future
          (try
            (let [scope (core/scope-open) failure (atom nil)]
              (deliver ready {:value true})
              (try
                (loop []
                  (let [packet (async/<! (:mailbox hub))]
                    (when-not packet (fail! :supervisor-stopped))
                    (when-not (= :hub/stop (:op (:request packet)))
                      (reply! packet (try {:value (operation! hub (:request packet))}
                                          (catch Object e {:error (error-data e)})))
                      (recur))))
                (catch Object e (reset! failure (error-data e)))
                (finally (shutdown! hub scope @failure))))
            (catch Object e (deliver ready {:error (error-data e)}))))
        (catch Object e (deliver ready {:error (error-data e)})))
      (when-let [error (:error @ready)] (throw (ex-info "Hub startup failed" error)))
      hub)))
