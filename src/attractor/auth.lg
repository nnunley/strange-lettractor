(ns attractor.auth
  "OAuth 2.0 authorization-code + PKCE handoff as framework capability.
   Protocol-neutral: MCP servers, REST APIs, any HTTP service.

   Flow: RFC 9728 discovery, RFC 7591 dynamic public-client registration,
   PKCE S256, loopback listener echo-back capture, single-use code
   exchange, memory-only access tokens, OS-keychain refresh persistence.
   Access tokens never leave process memory. Refresh tokens persist only
   in the OS keychain (never files, logs, evidence, shell history, or
   argv). Every failure is fail-closed with an :auth-* category."
  (:require [clojure.string :as str]
            [clojure.core :as core]
            [json :as json]
            [hash :as hash]
            [net :as net]
            [io :as io]
            [os :as os]
            [attractor.context-discovery :as capacity]))

(def default-timeout-ms 15000)
(def keychain-service-namespace "dev.attractor.oauth")

(defn- fail! [category data]
  (throw (ex-info (str "Auth: " (name category)) (assoc data :category category))))

(defn- non-blank-string? [value]
  (and (string? value) (not (str/blank? value))))

(defn- url-encode [text]
  (let [safe? (fn [character]
                (or (and (<= (int \a) (int character)) (<= (int character) (int \z)))
                    (and (<= (int \A) (int character)) (<= (int character) (int \Z)))
                    (and (<= (int \0) (int character)) (<= (int character) (int \9)))
                    (contains? #{\- \_ \. \~} character)))]
    (apply str (map (fn [character]
                      (if (safe? character)
                        (str character)
                        (format "%%%02x" (int character))))
                    (str text)))))

(defn- percent-decode [text]
  (let [hex-value (fn [character]
                    (cond (and (<= (int \0) (int character)) (<= (int character) (int \9)))
                          (- (int character) (int \0))
                          (and (<= (int \a) (int character)) (<= (int character) (int \f)))
                          (+ 10 (- (int character) (int \a)))
                          (and (<= (int \A) (int character)) (<= (int character) (int \F)))
                          (+ 10 (- (int character) (int \A)))
                          :else nil))]
    (loop [remaining (seq (str text)) output ""]
      (if (empty? remaining)
        output
        (let [character (first remaining)]
          (cond (= character \+)
                (recur (rest remaining) (str output " "))

                (and (= character \%) (>= (count remaining) 3))
                (let [high (hex-value (second remaining))
                      low (hex-value (nth remaining 2))]
                  (if (and (some? high) (some? low))
                    (recur (drop 3 remaining) (str output (char (+ (* 16 high) low))))
                    (recur (rest remaining) (str output character))))

                :else
                (recur (rest remaining) (str output character))))))))

;; ---------------------------------------------------------------------------
;; PKCE (RFC 7636, S256).
;; ---------------------------------------------------------------------------

(defn pkce-verifier []
  "64-hex-char verifier: SHA-256 hex of two crypto-random UUIDs.
   Fixed length by construction (avoids UUID string-format details),
   unreserved charset, ~244 bits of entropy."
  (hash/sha256 (str (random-uuid) (random-uuid))))

(defn- openssl-version-ok? [command]
  (try
    (= 0 (:exit (capacity/call!
                  (fn [] (os/sh command "version"))
                  {:timeout_ms 10000})))
    (catch Object _ false)))

(defn openssl-available? []
  "True when an openssl binary answers --version within budget."
  (boolean (or (openssl-version-ok? "/usr/bin/openssl")
               (openssl-version-ok? "openssl"))))

(defn- openssl-pipeline [verifier]
  (let [candidates [["/usr/bin/openssl"] ["openssl"]]
        attempt (fn [command]
                  (let [outcome (capacity/call!
                                  (fn []
                                    (let [process (os/with-stdin
                                                    (apply os/exec (conj command "dgst" "-sha256" "-binary"))
                                                    verifier)]
                                      (try (.Output process)
                                           (catch Object _ :failed))))
                                  {:timeout_ms 15000})]
                    (if (and (map? outcome) (= :unavailable (:status outcome)))
                      :failed
                      outcome)))]
    (loop [remaining candidates]
      (if (empty? remaining)
        (fail! :auth-pkce-unavailable {:reason :openssl-missing})
        (let [output (attempt (first remaining))]
          (if (= :failed output)
            (recur (rest remaining))
            output))))))

(defn pkce-challenge
  "S256 challenge for a verifier: BASE64URL(SHA256(verifier)). The digest
   flows through a bounded openssl pipeline with the verifier on stdin
   only, never argv. run-openssl injects (fn [verifier] -> base64-string)
   for tests; the default runs the real pipeline."
  [verifier & [run-openssl]]
  (let [digest-string (if (some? run-openssl)
                        (try (run-openssl verifier)
                             (catch Object _
                               (fail! :auth-pkce-unavailable {:reason :challenge-failed})))
                        (openssl-pipeline verifier))
        standard (try (base64-encode digest-string)
                      (catch Object _
                        (fail! :auth-pkce-unavailable {:reason :base64-failed})))]
    (-> standard
        (str/replace "+" "-")
        (str/replace "/" "_")
        (str/replace #"=+$" ""))))

(defn authorization-url
  "Build the authorization redirect target. Values are URL-encoded."
  [{:keys [authorization-endpoint client-id redirect-uri scope state code-challenge
           access-type prompt]}]
  (let [required [(str "response_type=code")
                  (str "client_id=" (url-encode client-id))
                  (str "redirect_uri=" (url-encode redirect-uri))
                  (str "scope=" (url-encode scope))
                  (str "state=" (url-encode state))
                  (str "code_challenge=" (url-encode code-challenge))
                  "code_challenge_method=S256"]
        optional (concat (when (some? access-type)
                           [(str "access_type=" (url-encode access-type))])
                         (when (some? prompt)
                           [(str "prompt=" (url-encode prompt))]))]
    (str authorization-endpoint
         (if (str/includes? (str authorization-endpoint) "?") "&" "?")
         (str/join "&" (concat required optional)))))

;; ---------------------------------------------------------------------------
;; Credential store: OS keychain through git credential-osxkeychain.
;; ---------------------------------------------------------------------------
;; Secrets travel on STDIN ONLY (git-credential protocol), never argv.
;; The store map {:store :fetch :erase} takes {:host :username :secret?}
;; where username carries the service-id (e.g. "mcp:trading"), so keychain
;; items stay service-scoped without collisions.

(defn- default-run-command [argv stdin-text]
  (let [command (apply os/exec argv)
        fed (os/with-stdin command (str stdin-text))]
    (try
      (let [output (.Output fed)]
        {:exit 0 :out (str output) :err ""})
      (catch Object error
        {:exit 1 :out "" :err (ex-message error)}))))

(defn osxkeychain-store
  "Production macOS credential store over git credential-osxkeychain
   (store/get/erase). :run-command injects (fn [argv stdin] -> map) for
   tests; the default shells out with secrets on stdin only."
  [& [opts]]
  (let [run-command (or (:run-command opts) default-run-command)
        invoke (fn [verb entry]
                 (try
                   (run-command ["git" "credential-osxkeychain" verb]
                                (str "protocol=https\n"
                                     "host=" (:host entry) "\n"
                                     "username=" (:username entry) "\n"
                                     (when (:secret entry)
                                       (str "password=" (:secret entry) "\n"))
                                     "\n"))
                   (catch Object error
                     {:exit 1 :out "" :err (ex-message error)})))]
    {:store (fn [{:keys [host username secret]}]
              (let [result (invoke "store" {:host host :username username :secret secret})]
                (when-not (= 0 (:exit result))
                  (fail! :auth-store-failed {:op :store :host host :username username}))
                nil))
     :fetch (fn [{:keys [host username]}]
              (let [result (invoke "get" {:host host :username username})]
                (when-not (= 0 (:exit result))
                  (fail! :auth-store-failed {:op :fetch :host host :username username}))
                (let [lines (str/split (str (:out result)) #"\r?\n")
                      password (some (fn [line]
                                       (when (str/starts-with? line "password=")
                                         (subs line (count "password="))))
                                     lines)]
                  (when-not (str/blank? password) password))))
     :erase (fn [{:keys [host username]}]
              (let [result (invoke "erase" {:host host :username username})]
                (when-not (= 0 (:exit result))
                  (fail! :auth-store-failed {:op :erase :host host :username username}))
                nil))}))

(defn default-token-reader
  "Admission-time reader: explicit process env first, then the keychain
   entry for (token-host, service-id). Returns the value or nil."
  [store service-id token-host]
  (fn [env-name]
    (let [from-env (os/getenv (str env-name))]
      (if-not (str/blank? from-env)
        from-env
        (when (and (some? store) (non-blank-string? token-host))
          (try ((:fetch store) {:host token-host :username service-id})
               (catch Object _ nil)))))))

(defn auth-status
  "Presence probe without values: is a refresh token stored for this
   service identity? Returns {:refresh-present bool}."
  [store service-id token-host]
  {:refresh-present
   (boolean (try (some? ((:fetch store) {:host token-host :username service-id}))
                 (catch Object _ false)))})

;; ---------------------------------------------------------------------------
;; Discovery (RFC 9728 + RFC 8414) and dynamic registration (RFC 7591).
;; ---------------------------------------------------------------------------

(defn- bounded-call [transport request timeout-ms]
  ;; capacity/call! accepts 1..60000ms; the authorize flow timeout may be
  ;; larger (browser wait), so clamp per-request HTTP timeouts here.
  (let [per-request-ms (min 60000 (max 1 (or timeout-ms default-timeout-ms)))
        outcome (capacity/call! (fn [] (transport request))
                                {:timeout_ms per-request-ms})]
    (if (and (map? outcome) (= :unavailable (:status outcome)))
      (fail! :auth-transport-error {:reason (:reason outcome)})
      outcome)))

(defn discover-resource
  "Fetch unauthenticated protected-resource metadata for a resource URL.
   Returns the raw metadata map or throws :auth-discovery-failed."
  [transport resource-url & [opts]]
  (when-not (str/starts-with? (str resource-url) "https://")
    (fail! :auth-endpoint-not-https {:reason :resource-url-must-be-https}))
  (let [parts (str/split (str/replace (str resource-url) #"^https://" "") #"/")
        host (first parts)
        path (str/join "/" (rest parts))
        well-known (str "https://" host "/.well-known/oauth-protected-resource/" path)
        response (bounded-call
                   transport
                   {:method :get
                    :url well-known
                    :headers {"accept" "application/json"}}
                   (:timeout-ms opts))
        body (try (json/read-json (str (:body response)))
                  (catch Object _
                    (fail! :auth-discovery-failed {:reason :metadata-not-json})))]
    (when-not (map? body)
      (fail! :auth-discovery-failed {:reason :metadata-not-an-object}))
    (let [servers (get body "authorization_servers")]
      (when-not (or (and (vector? servers) (seq servers))
                    (non-blank-string? servers))
        (fail! :auth-discovery-failed {:reason :missing-authorization-servers})))
    body))

(defn- discover-server-metadata [transport issuer opts]
  (when-not (str/starts-with? (str issuer) "https://")
    (fail! :auth-endpoint-not-https {:reason :issuer-must-be-https}))
  (let [resource-url (str (:resource-url opts))
        bare (str/replace resource-url #"^https://" "")
        host (first (str/split bare #"/"))
        path (str/join "/" (rest (str/split bare #"/")))
        candidates [(str issuer "/.well-known/oauth-authorization-server")
                    (str issuer "/.well-known/openid-configuration")
                    (str "https://" host "/.well-known/oauth-authorization-server/" path)]]
    (loop [remaining candidates]
      (if (empty? remaining)
        (fail! :auth-discovery-failed {:reason :server-metadata-not-found})
        (let [response (try
                         (bounded-call
                           transport
                           {:method :get :url (first remaining)
                            :headers {"accept" "application/json"}}
                           (:timeout-ms opts))
                         (catch Object _ nil))
              body (when (and (some? response) (= 200 (:status response)))
                     (try (json/read-json (str (:body response)))
                          (catch Object _ nil)))]
          (if (map? body)
            body
            (recur (rest remaining))))))))

(defn resolve-endpoints
  "Resolve OAuth endpoints: explicit descriptor fields win, otherwise
   RFC 9728 + RFC 8414 discovery. Returns {:authorization-endpoint
   :token-endpoint :registration-endpoint :scope :token-auth-methods}."
  [transport resource-url descriptor & [opts]]
  (let [explicit {:authorization-endpoint (:authorization-endpoint descriptor)
                  :token-endpoint (:token-endpoint descriptor)
                  :registration-endpoint (:registration-endpoint descriptor)
                  :scope (:scope descriptor)}
        https-only! (fn [endpoints]
                      (doseq [key [:authorization-endpoint :token-endpoint
                                   :registration-endpoint]]
                        (let [url (get endpoints key)]
                          (when (and (some? url)
                                     (or (not (string? url))
                                         (not (str/starts-with? url "https://"))))
                            (fail! :auth-endpoint-not-https
                                   {:reason :oauth-endpoints-must-be-https
                                    :field key}))))
                      endpoints)]
    (if (and (non-blank-string? (:authorization-endpoint explicit))
             (non-blank-string? (:token-endpoint explicit)))
      (https-only! (assoc explicit :token-auth-methods nil))
      (let [resource (discover-resource transport resource-url opts)
            servers (get resource "authorization_servers")
            issuer (if (vector? servers) (first servers) servers)
            server-meta (discover-server-metadata transport (str issuer) opts)
            scopes (or (get resource "scopes_supported") [])]
        (https-only!
          {:authorization-endpoint (get server-meta "authorization_endpoint")
           :token-endpoint (get server-meta "token_endpoint")
           :registration-endpoint (get server-meta "registration_endpoint")
           :scope (or (:scope explicit)
                      (when (vector? scopes)
                        (when (seq scopes) (str (first scopes))))
                      (when (non-blank-string? scopes) scopes)
                      "internal")
           :token-auth-methods (get server-meta "token_endpoint_auth_methods_supported")})))))

(defn- check-public-client! [methods]
  (when (and (some? methods)
             (not (some #(= "none" %) methods)))
    (fail! :auth-policy-mismatch
           {:reason :confidential-auth-method-required
            :methods methods})))

(defn register-public-client
  "Send public-client registration metadata through the bounded auth transport.
   Only successful registration statuses may supply a client ID. Server-issued
   secrets and transport details never escape the response validator."
  [transport registration-url metadata & [opts]]
  (let [response (bounded-call
                   transport
                   {:method :post :url registration-url
                    :body (json/write-json metadata)
                    :headers {"content-type" "application/json"
                              "accept" "application/json"}}
                   (:timeout-ms opts))]
    (when-not (contains? #{200 201} (:status response))
      (fail! :auth-registration-failed {:reason :registration-rejected
                                        :status (:status response)}))
    (let [body (try (json/read-json (str (:body response)))
                    (catch Object _
                      (fail! :auth-registration-failed {:reason :registration-malformed})))]
      (when-not (map? body)
        (fail! :auth-registration-failed {:reason :registration-not-an-object}))
      (when (non-blank-string? (get body "client_secret"))
        (fail! :auth-registration-conflict
               {:reason :server-issued-secret-for-public-client}))
      (when-not (non-blank-string? (get body "client_id"))
        (fail! :auth-registration-failed {:reason :registration-without-client-id}))
      {:client-id (get body "client_id")})))

(defn register-client
  "Register an OAuth authorization-code public client. Response validation and
   bounded transport are shared with metadata-driven MCP registration."
  [transport registration-url client-name redirect-uri scope & [opts]]
  (register-public-client transport registration-url
    {:client_name client-name :redirect_uris [redirect-uri]
     :grant_types ["authorization_code"] :response_types ["code"]
     :token_endpoint_auth_method "none" :scope scope}
    opts))

(defn exchange-code
  "Single authorization-code exchange. Returns {:access-token
   :refresh-token :expires-in}, plus optional :scope and :token-type.
   Callers enforce single-use per code."
  [transport token-endpoint code redirect-uri client-id code-verifier & [opts]]
  (let [form (str "grant_type=authorization_code"
                  "&code=" (url-encode code)
                  "&redirect_uri=" (url-encode redirect-uri)
                  "&client_id=" (url-encode client-id)
                  "&code_verifier=" (url-encode code-verifier)
                  (when (non-blank-string? (:client-secret opts))
                    (str "&client_secret=" (url-encode (:client-secret opts)))))
        response (bounded-call
                   transport
                   {:method :post :url token-endpoint
                    :headers {"content-type" "application/x-www-form-urlencoded"
                              "accept" "application/json"}
                    :body form}
                   (:timeout-ms opts))
        body (try (json/read-json (str (:body response)))
                  (catch Object _
                    (fail! :auth-exchange-failed {:reason :exchange-malformed})))]
    (when-not (map? body)
      (fail! :auth-exchange-failed {:reason :exchange-not-an-object}))
    (let [server-error (get body "error")]
      (when (some? server-error)
        (fail! :auth-exchange-failed {:reason :exchange-rejected
                                     :error-code (when (map? server-error)
                                                   (get server-error "code"))})))
    (when-not (= 200 (:status response))
      (fail! :auth-exchange-failed {:reason :exchange-http-status
                                    :status (when (integer? (:status response))
                                              (:status response))}))
    (when-not (non-blank-string? (get body "access_token"))
      (fail! :auth-exchange-failed {:reason :exchange-without-token}))
    (cond-> {:access-token (get body "access_token")
             :refresh-token (get body "refresh_token")
             :expires-in (get body "expires_in")}
      (contains? body "scope") (assoc :scope (get body "scope"))
      (contains? body "token_type") (assoc :token-type (get body "token_type")))))

;; ---------------------------------------------------------------------------
;; Loopback listener: echo-back capture, single-shot, off-chat.
;; ---------------------------------------------------------------------------

(defn- split-first
  "Split text on the first occurrence of a literal separator, returning
   [before after]. Limit-bounded split is unavailable, so index into it."
  [text separator]
  (let [s (str text)
        sep (str separator)
        idx (str/index-of s sep)]
    (if (nil? idx)
      [s ""]
      [(subs s 0 idx)
       (subs s (+ idx (count sep)))])))

(defn- buffer-text [bytes]
  (let [buffer (io/buffer)]
    (.Write buffer bytes)
    (io/buffer-str buffer)))

(defn- read-request-text [connection max-bytes]
  (loop [chunks [] total 0]
    (let [piece (try (net/read! connection (min 4096 (- max-bytes total)))
                     (catch Object _ nil))]
      (if (nil? piece)
        (str/join "" chunks)
        (let [text (buffer-text piece)
              combined (str (str/join "" chunks) text)]
          (if (or (str/includes? combined "\r\n\r\n")
                  (>= (count (bytes combined)) max-bytes))
            combined
            (recur (conj chunks text) (count (bytes combined)))))))))

(defn- reason-phrase [status]
  (if (= status 200) "OK" "Bad Request"))

(defn- write-response! [connection status text]
  (let [body (str text)
        response (str "HTTP/1.0 " status " " (reason-phrase status) "\r\n"
                      "Content-Type: text/plain\r\n"
                      "Content-Length: " (count (bytes body)) "\r\n"
                      "Connection: close\r\n\r\n" body)]
    (try (net/write! connection response) (catch Object _ nil))
    (try (net/close! connection) (catch Object _ nil))
    nil))

(defn- handle-one-redirect! [state-atom connection expected-state path]
  (let [request-text (read-request-text connection 8192)
        request-line (first (str/split request-text #"\r\n"))
        parts (str/split (or request-line "") #" ")
        method (first parts)
        target (second parts)
        split-target (split-first (or target "") "?")
        target-path (first split-target)
        query (second split-target)
        params (if (str/blank? query)
                 {}
                 (into {} (map (fn [pair]
                                 (let [kv (split-first pair "=")]
                                   [(percent-decode (first kv))
                                    (percent-decode (second kv))]))
                               (str/split query #"&"))))
        code (get params "code")
        state (get params "state")]
    (swap! state-atom update :requests inc)
    (cond (not (and (= "GET" method) (= path target-path)))
          (do (swap! state-atom update :mismatches inc)
              (write-response! connection 404 "Not found."))

          (or (str/blank? code) (not (= expected-state state)))
          (do (swap! state-atom update :mismatches inc)
              (write-response! connection 400 "Missing or mismatched code/state."))

          (some? (:captured @state-atom))
          (do (swap! state-atom update :mismatches inc)
              (write-response! connection 400 "Code already captured."))

          :else
          (do (swap! state-atom assoc :captured {:code code}
                     :captured-count (inc (:captured-count @state-atom 0)))
              (write-response! connection 200 "Authorized. You may close this window.")))))

(defn start-listener
  "Bind 127.0.0.1 (ephemeral port by default) for one OAuth echo-back.
   Only GETs to path with a matching state are captured; everything else
   is counted and answered 400/404. Returns {:server :port :state-atom}."
  [expected-state opts]
  (when (str/blank? (str expected-state))
    (fail! :auth-configuration {:reason :listener-requires-non-blank-state}))
  (let [options (or opts {})
        listener (net/listen "127.0.0.1" (or (:port options) 0))
        port (:port (net/local-address listener))
        state-atom (atom {:expected expected-state
                          :path (or (:path options) "/callback")
                          :requests 0 :mismatches 0
                          :captured nil :captured-count 0
                          :closed false})]
    (core/future
      (try
        (loop []
          (let [state @state-atom
                live? (and (not (:closed state))
                           (< (:requests state) (or (:max-requests options) 32))
                           (nil? (:captured state)))]
            (if live?
              (do (let [connection (try (net/accept listener) (catch Object _ nil))]
                    (when (some? connection)
                      (try
                        (let [outcome (capacity/call!
                                        (fn []
                                          (handle-one-redirect! state-atom connection expected-state
                                                                (:path @state-atom))
                                          :done)
                                        {:timeout_ms 30000})]
                          (when (and (map? outcome) (= :unavailable (:status outcome)))
                            (try (net/close! connection) (catch Object _ nil))))
                        (catch Object _ nil))))
                  (recur))
              nil)))
        (catch Object _ nil)
        (finally (try (net/close! listener) (catch Object _ nil)))))
    {:server listener :port port :state-atom state-atom}))

(defn close-code-listener!
  "Idempotent listener teardown."
  [server]
  (try (swap! (:state-atom server) assoc :closed true) (catch Object _ nil))
  (try (net/close! (:server server)) (catch Object _ nil))
  nil)

(defn await-code!
  "Wait up to timeout-ms for the captured code. Closes the listener in
   both outcomes, then returns {:code} or throws :auth-timeout."
  [server timeout-ms]
  (let [deadline (+ (System/currentTimeMillis) (or timeout-ms 300000))]
    (loop []
      (let [state @(:state-atom server)]
        (if (some? (:captured state))
          (do (close-code-listener! server)
              {:code (get (:captured state) :code)})
          (if (>= (System/currentTimeMillis) deadline)
            (do (close-code-listener! server)
                (fail! :auth-timeout {:reason :authorization-not-completed}))
            (do (core/sleep 50)
                (recur))))))))
(defn token-host
  "Canonical keychain host for a token endpoint: scheme stripped, path
   stripped, port KEPT (explicit ports are distinct identities). This is
   the single shared host function: writers (authorize persistence) and
   readers (session refresh lookup) must agree exactly."
  [url]
  (let [s (str url)
        after (if-let [idx (str/index-of s "://")] (subs s (+ idx 3)) s)
        end (or (str/index-of after "/") (count after))]
    (subs after 0 end)))

(defn client-id-username
  "Credential-store username holding the client id a service's stored
   refresh token is bound to."
  [service-id]
  (str service-id ":client-id"))

(defn authorize
  "Full OAuth authorization-code + PKCE handoff for one service.
   descriptor: {:authorization-endpoint :token-endpoint
   :registration-endpoint? :scope :client-id? :access-type? :prompt?
   :client-secret?}. When endpoints are blank,
   resource-url enables RFC 9728 discovery. opts: :store (credential store
   map for refresh persistence; absent means memory-only), :service-id
   (required with :store), :on-url (fn [url], default prints), :timeout-ms,
   :port, :pkce-run (openssl injection for tests), :client-name,
   :validate-tokens (callback before persistence), :persist-client-id?
   (default true).

   The code is exchanged exactly once; refresh tokens persist only via
   :store, access tokens stay memory-only. Returns {:service-id
   :access-token :expires-in :expires-at-ms :refresh-stored :flow-evidence,
   with optional :scope and :token-type when returned by the server}
   with no secret values anywhere in the evidence."
  [transport resource-url descriptor & [opts]]
  (let [options (or opts {})
        timeout-ms (or (:timeout-ms options) 300000)
        store (:store options)
        service-id (or (:service-id options) resource-url)
        resolved {:authorization-endpoint (or (:authorization-endpoint descriptor)
                                              (:authorization-url descriptor))
                  :token-endpoint (or (:token-endpoint descriptor)
                                      (:token-url descriptor))
                  :registration-endpoint (or (:registration-endpoint descriptor)
                                             (:registration-url descriptor))
                  :scope (or (:scope descriptor) "internal")
                  :access-type (:access-type descriptor)
                  :prompt (:prompt descriptor)
                  :client-id (:client-id descriptor)}
        ;; Explicit endpoints skip the public-client check: there is no
        ;; metadata to check against, so explicit configuration asserts a
        ;; public client by operator intent. Discovery always enforces it.
        endpoints (if (and (non-blank-string? (:authorization-endpoint resolved))
                           (non-blank-string? (:token-endpoint resolved)))
                    (assoc resolved :token-auth-methods nil)
                    (let [discovered (resolve-endpoints transport resource-url resolved
                                             (assoc options :resource-url resource-url))]
                      (check-public-client! (:token-auth-methods discovered))
                      discovered))]
    (when-not (and (non-blank-string? (:authorization-endpoint endpoints))
                   (non-blank-string? (:token-endpoint endpoints)))
      (fail! :auth-configuration {:reason :oauth-endpoints-unresolved}))
    (let [verifier (pkce-verifier)
          challenge (pkce-challenge verifier (:pkce-run options))
          state (pkce-verifier)
          server (start-listener state {:port (:port options) :timeout-ms timeout-ms})
          redirect-uri (str "http://127.0.0.1:" (:port server) "/callback")
          exchanged? (atom false)
          started-at (System/currentTimeMillis)]
      (try
        (let [client-id (or (:client-id endpoints)
                            (:client-id resolved)
                            (when (:registration-endpoint endpoints)
                              (:client-id (register-client
                                            transport
                                            (:registration-endpoint endpoints)
                                            (or (:client-name options) "attractor-client")
                                            redirect-uri
                                            (:scope endpoints)))))
              _ (when (str/blank? (str client-id))
                  (fail! :auth-configuration {:reason :client-id-unresolved}))
              auth-url (authorization-url
                         {:authorization-endpoint (:authorization-endpoint endpoints)
                          :client-id client-id
                          :redirect-uri redirect-uri
                          :scope (:scope endpoints)
                          :state state
                          :code-challenge challenge
                          :access-type (:access-type resolved)
                          :prompt (:prompt resolved)})]
          ((or (:on-url options)
               (fn [url]
                 (println "Open this URL to authorize:")
                 (println url)
                 (println "Waiting for the loopback callback; complete the browser step.")
                 nil))
           auth-url)
          (let [captured (await-code! server timeout-ms)
                tokens (do (when @exchanged?
                             (fail! :auth-code-reused {:reason :exchange-already-attempted}))
                           (reset! exchanged? true)
                           (exchange-code transport (:token-endpoint endpoints)
                                          (:code captured) redirect-uri client-id verifier
                                          (assoc options :client-secret
                                                 (or (:client-secret options)
                                                     (:client-secret descriptor)))))
                _ (when-let [validate (:validate-tokens options)]
                    (let [accepted? (try (validate tokens)
                                         (catch Object _
                                           (fail! :auth-validation-failed
                                                  {:reason :token-validation-rejected})))]
                      (when (= false accepted?)
                        (fail! :auth-validation-failed
                               {:reason :token-validation-rejected}))))
                expires-at (when (integer? (:expires-in tokens))
                             (+ (System/currentTimeMillis)
                                (* 1000 (max 0 (:expires-in tokens)))))
                refresh-token (:refresh-token tokens)
                refresh-stored (boolean
                                 (when (and (some? store)
                                            (non-blank-string? service-id)
                                            (non-blank-string? refresh-token))
                                   ((:store store) {:host (token-host (:token-endpoint endpoints))
                                                    :username service-id
                                                    :secret refresh-token})
                                   ;; A refresh token only redeems with the client it
                                   ;; was issued to, and a registered id is new each
                                   ;; handoff, so a later process needs both.
                                   (when (not= false (:persist-client-id? options))
                                     ((:store store) {:host (token-host (:token-endpoint endpoints))
                                                      :username (client-id-username service-id)
                                                      :secret client-id}))
                                   true))
                completed-at (System/currentTimeMillis)
                stats @(:state-atom server)]
            (cond-> {:service-id service-id
                     :client-id client-id
                     :access-token (:access-token tokens)
                     :expires-in (:expires-in tokens)
                     :expires-at-ms expires-at
                     :refresh-stored refresh-stored
                     :flow-evidence {:service-id service-id
                                     :token-host (token-host (:token-endpoint endpoints))
                                     :redirect-port (:port server)
                                     :requests-seen (:requests stats)
                                     :mismatches (:mismatches stats)
                                     :exchanges 1
                                     :refresh-stored refresh-stored
                                     :expires-in (:expires-in tokens)
                                     :started-at started-at
                                     :completed-at completed-at}}
              (contains? tokens :scope) (assoc :scope (:scope tokens))
              (contains? tokens :token-type) (assoc :token-type (:token-type tokens)))))
        (finally (close-code-listener! server))))))
