(ns attractor.engine
  (:require [clojure.string :as str]
            [os :as os]
            [io :as io]
            [json :as json]
            [math :as math]
            [attractor.parser :as parser]
            [attractor.conditions :as conditions]
            [attractor.context :as context]
            [attractor.handlers :as handlers]
            [attractor.interviewer :as interviewer]
            [attractor.status :as status]))

(defn- write-stage-status! [logs-root node-id outcome]
  (let [stage-dir (str logs-root "/" node-id)]
    (os/sh "mkdir" "-p" stage-dir)
    (io/spit (str stage-dir "/status.json")
             (status/outcome->status-json outcome))))

(defn- normalize-node-outcomes [outcomes]
  (into {}
        (map (fn [[node-id outcome]]
               (let [status (or (:status outcome) (get outcome "status"))]
                 [(str node-id)
                  {:status (if (keyword? status) status (keyword (str status)))
                   :preferred_label (or (:preferred_label outcome)
                                        (get outcome "preferred_label") "")
                   :suggested_next_ids (or (:suggested_next_ids outcome)
                                           (get outcome "suggested_next_ids") [])
                   :context_updates (or (:context_updates outcome)
                                        (get outcome "context_updates") {})
                   :notes (or (:notes outcome) (get outcome "notes") "")
                   :failure_reason (or (:failure_reason outcome)
                                       (get outcome "failure_reason") "")}]))
             (or outcomes {}))))

;; Best edge by weight descending, then target node id ascending (lexical tiebreak)
(defn best-by-weight-then-lexical [edges]
  (first
    (sort (fn [a b]
            (let [wa (or (:weight a) 0)
                  wb (or (:weight b) 0)]
              (if (not= wa wb)
                (compare wb wa) ; Higher weight wins
                (compare (str (:to a)) (str (:to b)))))) ; Lexical tiebreak
          edges)))

;; Edge Selection Algorithm (Section 3.3)
(defn select-edge [node outcome ctx graph]
  (let [edges (parser/outgoing-edges graph (:id node))]
    (if (empty? edges)
      nil
      ;; Step 1: Condition matching
      (let [cond-matched (filter (fn [e]
                                   (and (not (str/blank? (:condition e)))
                                        (conditions/evaluate-condition (:condition e) outcome ctx)))
                                 edges)]
        (if (seq cond-matched)
          (best-by-weight-then-lexical cond-matched)

          ;; Step 2: Preferred label match (unconditional edges only)
          (let [pref (or (:preferred_label outcome) (context/ctx-get ctx "preferred_label" ""))]
            (if-let [matched (when (not (str/blank? pref))
                               (first (filter (fn [e]
                                                (and (str/blank? (:condition e))
                                                     (= (interviewer/normalize-label (:label e))
                                                        (interviewer/normalize-label pref))))
                                              edges)))]
              matched

              ;; Step 3: Suggested next IDs (unconditional edges only)
              (let [suggested (or (:suggested_next_ids outcome) [])]
                (if-let [matched (when (seq suggested)
                                   (first (for [s suggested
                                                e edges
                                                :when (and (str/blank? (:condition e))
                                                           (= (:to e) s))]
                                            e)))]
                  matched

                  ;; Step 4 & 5: Unconditional edges by weight then lexical
                  (let [unconditional (filter (fn [e] (str/blank? (:condition e))) edges)]
                    (when (seq unconditional)
                      (best-by-weight-then-lexical unconditional))))))))))))

(defn- select-failure-edge [node outcome ctx graph]
  (let [matching (filter (fn [edge]
                           (and (= "outcome=fail"
                                   (str/lower-case
                                     (str/replace (or (:condition edge) "")
                                                  #"\s+" "")))
                                (conditions/evaluate-condition
                                  (:condition edge) outcome ctx)))
                         (parser/outgoing-edges graph (:id node)))]
    (when (seq matching)
      (best-by-weight-then-lexical matching))))

;; Check if a node is terminal (shape=Msquare or id matches exit/end/done)
(defn terminal-node? [node]
  (or (= (:shape node) "Msquare")
      (#{"exit" "end" "Exit" "End" "done"} (:id node))))

;; Goal Gate Enforcement (Section 3.4)
(defn check-goal-gates [graph node-outcomes]
  (let [failed-gate (first (filter (fn [[nid out]]
                                     (let [n (parser/find-node graph nid)]
                                       (and (:goal_gate n)
                                            (not (#{:success :partial_success} (:status out))))))
                                   node-outcomes))]
    (if failed-gate
      [false (parser/find-node graph (first failed-gate))]
      [true nil])))

;; Resolve retry target on goal gate failure or node failure
(defn resolve-retry-target [node graph]
  (let [t1 (when node (let [t (:retry_target node)] (when-not (str/blank? t) t)))
        t2 (when node (let [t (:fallback_retry_target node)] (when-not (str/blank? t) t)))
        t3 (let [t (:retry_target graph)] (when-not (str/blank? t) t))
        t4 (let [t (:fallback_retry_target graph)] (when-not (str/blank? t) t))]
    (or t1 t2 t3 t4)))

(defn- resolve-node-retry-target [node]
  (let [primary (when node
                  (let [target (:retry_target node)]
                    (when-not (str/blank? target) target)))
        fallback (when node
                   (let [target (:fallback_retry_target node)]
                     (when-not (str/blank? target) target)))]
    (or primary fallback)))

;; Named retry policies from Section 3.6. A node or graph max_retries value
;; remains authoritative unless max_attempts is explicitly supplied by a caller.
(def retry-policy-presets
  {:none {:max_attempts 1 :initial_delay_ms 0 :backoff_factor 1.0}
   :standard {:max_attempts 5 :initial_delay_ms 200 :backoff_factor 2.0}
   :aggressive {:max_attempts 5 :initial_delay_ms 500 :backoff_factor 2.0}
   :linear {:max_attempts 3 :initial_delay_ms 500 :backoff_factor 1.0}
   :patient {:max_attempts 3 :initial_delay_ms 2000 :backoff_factor 3.0}})

(defn retryable-error? [error]
  (let [data (or (ex-data error) {})
        explicit (:retryable data)
        status (or (:status data) (:status_code data))
        category (keyword
                   (str/replace (name (or (:category data) :unknown))
                                "-" "_"))
        message (str/lower-case (str error))]
    (cond
      (some? explicit) (true? explicit)
      (= status 429) true
      (and (number? status) (>= status 500) (< status 600)) true
      (#{:network_error :rate_limit_error :server_error
         :timeout_error :transient_error} category) true
      (or (str/includes? message "timed out")
          (str/includes? message "timeout")
          (str/includes? message "connection reset")
          (str/includes? message "connection refused")) true
      :else false)))

(defn build-retry-policy [node graph options]
  (let [requested (or (:retry-policy options) {})
        preset-name (when (:name requested)
                      (keyword (name (:name requested))))
        preset (if preset-name
                 (or (get retry-policy-presets preset-name) {})
                 {})
        configured (merge {:initial_delay_ms 200
                           :backoff_factor 2.0
                           :max_delay_ms 60000
                           :jitter true}
                          preset
                          requested)
        node-max-retries (:max_retries node)
        graph-max-retries (or (:default_max_retries graph) 0)
        explicit-attrs (or (:explicit_attrs graph) #{})
        graph-explicit? (or (contains? explicit-attrs :default_max_retries)
                            (contains? explicit-attrs :default_max_retry))]
    (assoc configured
           :max_attempts (max 1 (or (:max_attempts requested)
                                    (when (some? node-max-retries)
                                      (inc node-max-retries))
                                    (when graph-explicit?
                                      (inc graph-max-retries))
                                    (:max_attempts preset)
                                    (inc graph-max-retries)))
           :should_retry (or (:should_retry requested) retryable-error?))))

;; Backoff delay calculation in milliseconds. The four-argument form is kept
;; for callers of the original API; the policy form also supports jitter.
(defn delay-for-attempt
  ([attempt initial-delay-ms backoff-factor max-delay-ms]
   (delay-for-attempt attempt
                      {:initial_delay_ms initial-delay-ms
                       :backoff_factor backoff-factor
                       :max_delay_ms max-delay-ms
                       :jitter false}
                      (fn [] 0.5)))
  ([attempt policy random-fn]
   (let [initial (or (:initial_delay_ms policy) 200)
         factor (or (:backoff_factor policy) 2.0)
         cap (or (:max_delay_ms policy) 60000)
         computed (min (* initial
                          (math/pow factor (double (dec attempt))))
                       (double cap))
         jittered (if (:jitter policy)
                    (* computed (+ 0.5 (double (random-fn))))
                    computed)]
     (long jittered))))

(defn- schedule-retry! [runtime policy node-id attempt on-event]
  (let [delay-ms (delay-for-attempt attempt policy (:random-fn runtime))]
    (swap! (:retry-counts runtime) assoc node-id attempt)
    (on-event {:type :stage.retrying :node_id node-id
               :attempt attempt :delay_ms delay-ms})
    ((:sleep-fn runtime) delay-ms)))

(defn- timeout-configuration-error [node]
  (ex-info (str "Invalid or non-positive node timeout for '" (:id node) "'")
           {:category :configuration_error
            :retryable false
            :node_id (:id node)}))

(defn- resolve-node-timeout [node]
  (let [configured-timeout (:timeout node)]
    (if (nil? configured-timeout)
      {:timeout-ms nil}
      (let [parsed (try
                     (parser/parse-duration-ms configured-timeout)
                     (catch Object _ ::invalid-timeout))]
        (if (and (number? parsed) (pos? parsed)
                 (<= parsed Long/MAX_VALUE))
          {:timeout-ms (long parsed)}
          {:error (timeout-configuration-error node)})))))

(defn- error-outcome [error]
  (let [details (or (ex-data error) {})]
    (merge {:status :fail :failure_reason (str error)}
           (select-keys details [:retryable :category :context_updates]))))

(def ^:private status-values
  #{:success :retry :fail :partial_success})

(defn- status-contract-failure [reason]
  {:status :fail
   :category :status_contract_error
   :retryable false
   :failure_reason reason})

(defn- status-field-present? [value field]
  (or (contains? value field)
      (contains? value (name field))))

(defn- status-field [value field]
  (if (contains? value field)
    (get value field)
    (get value (name field))))

(defn- normalize-status-value [value]
  (let [status (cond
                 (keyword? value) value
                 (string? value) (keyword value)
                 :else nil)]
    (when (contains? status-values status) status)))

(defn- valid-status-optionals? [value]
  (and
    (or (not (status-field-present? value :preferred_label))
        (string? (status-field value :preferred_label)))
    (or (not (status-field-present? value :suggested_next_ids))
        (let [ids (status-field value :suggested_next_ids)]
          (and (sequential? ids) (every? string? ids))))
    (or (not (status-field-present? value :context_updates))
        (map? (status-field value :context_updates)))
    (or (not (status-field-present? value :notes))
        (string? (status-field value :notes)))))

(defn- normalize-status-contract [value status-field-name]
  (let [status (normalize-status-value (status-field value status-field-name))]
    (when (and (map? value)
               (status-field-present? value status-field-name)
               status
               (valid-status-optionals? value))
      (cond-> {:status status}
        (status-field-present? value :preferred_label)
        (assoc :preferred_label (status-field value :preferred_label))
        (status-field-present? value :suggested_next_ids)
        (assoc :suggested_next_ids (vec (status-field value :suggested_next_ids)))
        (status-field-present? value :context_updates)
        (assoc :context_updates (status-field value :context_updates))
        (status-field-present? value :notes)
        (assoc :notes (status-field value :notes))))))

(defn- normalize-handler-outcome [value]
  (when-let [contract (and (map? value)
                           (normalize-status-contract value :status))]
    ;; Handler outcomes may contain engine-only details such as artifacts or a
    ;; failure reason. Preserve those while canonicalizing contract fields.
    (merge (dissoc value
                   "status" "preferred_label" "suggested_next_ids"
                   "context_updates" "notes")
           contract)))

(defn- attempt-status-path [logs-root node-id]
  (str logs-root "/" node-id "/status.json"))

(defn- clear-attempt-status! [logs-root node-id]
  (let [path (attempt-status-path logs-root node-id)]
    (try
      (when (io/file-exists? path)
        (io/delete-file path))
      nil
      (catch Object error
        (status-contract-failure
          (str "Unable to clear stale status file '" path "': " error))))))

(defn- read-attempt-status [logs-root node-id]
  (let [path (attempt-status-path logs-root node-id)]
    (if-not (io/file-exists? path)
      {:present? false}
      (try
        (let [value (json/read-json (io/slurp path))
              outcome (and (map? value)
                           (normalize-status-contract value :outcome))]
          (if outcome
            {:present? true :outcome outcome}
            {:present? true
             :failure (status-contract-failure
                        (str "Invalid status file '" path "'"))}))
        (catch Object error
          {:present? true
           :failure (status-contract-failure
                      (str "Malformed status file '" path "': " error))})))))

(defn- resolve-attempt-outcome [logs-root node handler-outcome]
  (let [file-result (read-attempt-status logs-root (:id node))]
    (cond
      (:failure file-result)
      (:failure file-result)

      (:present? file-result)
      (:outcome file-result)

      :else
      (or (normalize-handler-outcome handler-outcome)
          (when (:auto_status node)
            {:status :success
             :notes "auto-status: handler completed without writing status"})
          (status-contract-failure
            (str "Handler for node '" (:id node)
                 "' produced neither status.json nor a valid Outcome"))))))

(defn- signal-cancellation! [controller reason]
  (swap! controller
         (fn [current]
           (cond
             (= reason :pipeline_cancelled) :pipeline_cancelled
             (= current :pipeline_cancelled) :pipeline_cancelled
             (= current :running) reason
             :else current))))

(defn- execute-with-attempt-timeout
  [handler node ctx graph logs-root options timeout-ms]
  (let [now-ms (or (:now-ms options) (fn [] (System/currentTimeMillis)))
        started-at (now-ms)]
    (if (> started-at (- Long/MAX_VALUE timeout-ms))
      {:error (timeout-configuration-error node)}
      (let [controller (atom :running)
            pipeline-cancelled? (or (:cancelled? options) (fn [] false))
            inherited-cancelled? (or (:cancelled? node) (fn [] false))
            timed-node (assoc node
                              :cancelled? (fn [] (or (inherited-cancelled?)
                                                     (not= :running @controller)))
                              :cancellation_reason (fn [] @controller))
            deadline (+ started-at timeout-ms)
            task (core/future
                   (try
                     {:outcome (handler timed-node ctx graph logs-root)}
                     (catch Object e {:error e})))
            pending ::pending]
        (loop []
      (when (pipeline-cancelled?)
        (signal-cancellation! controller :pipeline_cancelled))
      (let [execution (deref task 5 pending)]
        (when (pipeline-cancelled?)
          (signal-cancellation! controller :pipeline_cancelled))
        (cond
          (= :pipeline_cancelled @controller)
          (do
            ;; A handler may own resources beyond the engine's reach; join it
            ;; after signal before the pipeline moves on.
            @task
            {:outcome {:status :cancelled
                       :failure_reason "Pipeline cancelled"}})

          ;; Check the clock before accepting a completed future.  A future
          ;; that completes during the final polling interval is still late.
          (>= (now-ms) deadline)
          (do
            (signal-cancellation! controller :deadline)
            (let [joined
                  (loop []
                    ;; The handler may still be cooperatively winding down
                    ;; after its deadline. Keep observing pipeline
                    ;; cancellation so it can take precedence before join.
                    (when (pipeline-cancelled?)
                      (signal-cancellation! controller :pipeline_cancelled))
                    (let [result (deref task 5 pending)]
                      (when (pipeline-cancelled?)
                        (signal-cancellation! controller :pipeline_cancelled))
                      (if (= pending result)
                        (recur)
                        result)))]
              ;; A concurrent pipeline cancellation overrides a deadline,
              ;; including one detected while waiting for handler quiescence.
              (when (pipeline-cancelled?)
                (signal-cancellation! controller :pipeline_cancelled))
              (if (= :pipeline_cancelled @controller)
                {:outcome {:status :cancelled
                           :failure_reason "Pipeline cancelled"}}
                (let [joined-outcome (:outcome joined)
                      joined-error (:error joined)
                      context-updates
                      (or (:context_updates joined-outcome)
                          (:context_updates (or (ex-data joined-error) {})))]
                  {:error
                   (ex-info (str "Node '" (:id node) "' timed out")
                            (cond-> {:category :timeout_error
                                     :retryable true
                                     :node_id (:id node)}
                              context-updates
                              (assoc :context_updates context-updates)))}))))

          (not= pending execution)
          execution

          :else
          (recur))))))))

;; Execute node with retry logic (Section 3.5 & 3.6)
(defn execute-with-retry
  ([handler node ctx graph logs-root on-event]
   (execute-with-retry handler node ctx graph logs-root on-event {}))
  ([handler node ctx graph logs-root on-event options]
   (let [policy (build-retry-policy node graph options)
         max-attempts (:max_attempts policy)
         node-id (:id node)
         retry-counts (or (:retry-counts options) (atom {}))
         runtime {:retry-counts retry-counts
                  :sleep-fn (or (:sleep-fn options) core/sleep)
                  :random-fn (or (:random-fn options) rand)}
         pipeline-cancelled? (or (:cancelled? options) (fn [] false))
         timeout-config (resolve-node-timeout node)
         prior-retries (or (get @retry-counts node-id)
                           (get @retry-counts (keyword node-id))
                           0)]

    (loop [attempt (inc prior-retries)]
      (if (pipeline-cancelled?)
        {:status :cancelled :failure_reason "Pipeline cancelled"}
        (let [_ (on-event {:type :stage.started :node_id node-id
                           :attempt attempt :max_attempts max-attempts})
            cleanup-failure (clear-attempt-status! logs-root node-id)
            execution (if cleanup-failure
                        {:resolved-outcome cleanup-failure}
                        (if-let [configuration-error (:error timeout-config)]
                          {:error configuration-error}
                          (if-let [timeout-ms (:timeout-ms timeout-config)]
                            (execute-with-attempt-timeout handler node ctx graph logs-root
                                                          options timeout-ms)
                            (try
                              {:outcome (handler node ctx graph logs-root)}
                              (catch Object e {:error e})))))
            error (:error execution)
            handler-outcome (:outcome execution)
            outcome (cond
                      (pipeline-cancelled?)
                      {:status :cancelled :failure_reason "Pipeline cancelled"}

                      error
                      (error-outcome error)

                      (:resolved-outcome execution)
                      (:resolved-outcome execution)

                      (= :cancelled (:status handler-outcome))
                      handler-outcome

                      :else
                      (let [resolved (resolve-attempt-outcome
                                       logs-root node handler-outcome)]
                        ;; Resolution performs filesystem I/O. Cancellation
                        ;; that arrives during it must win before routing or
                        ;; lifecycle events observe the resolved status.
                        (if (pipeline-cancelled?)
                          {:status :cancelled
                           :failure_reason "Pipeline cancelled"}
                          resolved)))
            st (:status outcome)]

        (cond
          error
          (if (and ((:should_retry policy) error)
                   (< attempt max-attempts))
            (do
              (on-event {:type :stage.failed :node_id node-id
                         :outcome outcome :will_retry true})
              (if (pipeline-cancelled?)
                {:status :cancelled :failure_reason "Pipeline cancelled"}
                (do
                  (schedule-retry! runtime policy node-id attempt on-event)
                  (recur (inc attempt)))))
            (do
              (on-event {:type :stage.failed :node_id node-id
                         :outcome outcome :will_retry false})
              outcome))

          ;; Success or Partial Success
          (#{:success :partial_success} st)
          (do
            (swap! retry-counts assoc node-id 0)
            (context/ctx-set! ctx (str "internal.retry_count." node-id) 0)
            (on-event {:type :stage.completed :node_id node-id :status st :outcome outcome})
            outcome)

          ;; Retry requested
          (= st :retry)
          (if (< attempt max-attempts)
            (do
              (context/ctx-set! ctx (str "internal.retry_count." node-id) attempt)
              (schedule-retry! runtime policy node-id attempt on-event)
              (recur (inc attempt)))
            (if (:allow_partial node)
              (let [res {:status :partial_success :notes "retries exhausted, partial accepted"}]
                (swap! retry-counts assoc node-id 0)
                (context/ctx-set! ctx (str "internal.retry_count." node-id) 0)
                (on-event {:type :stage.completed :node_id node-id :status :partial_success :outcome res})
                res)
              (let [res {:status :fail :failure_reason (or (:failure_reason outcome) "max retries exceeded")}]
                (on-event {:type :stage.failed :node_id node-id :outcome res :will_retry false})
                res)))

          ;; Permanent Failure
          (= st :fail)
          (do
            (on-event {:type :stage.failed :node_id node-id :outcome outcome :will_retry false})
            outcome)

          :else
          (do
            (on-event {:type :stage.completed :node_id node-id :status st :outcome outcome})
            outcome))))))))

(defn- incoming-edge-for [graph completed-nodes node-id]
  (when-let [previous-node-id (last completed-nodes)]
    (first
      (filter (fn [edge]
                (and (= previous-node-id (:from edge))
                     (= node-id (:to edge))))
              (:edges graph)))))

(defn- execution-node [node incoming-edge graph ctx completed-nodes
                       node-outcomes fidelity-threads fidelity-override]
  (let [resolved-fidelity (context/resolve-fidelity incoming-edge node graph)
        effective-fidelity (or fidelity-override resolved-fidelity)
        previous-node-id (or (last completed-nodes) (:from incoming-edge))
        resolved-thread-id
        (when (= "full" effective-fidelity)
          (context/resolve-thread-id incoming-edge node graph previous-node-id))
        preamble
        (if (= "full" effective-fidelity)
          ""
          (context/synthesize-context-preamble
            effective-fidelity graph ctx completed-nodes node-outcomes))]
    (assoc node
           :resolved_fidelity effective-fidelity
           :resolved_thread_id resolved-thread-id
           :context_preamble preamble
           :fidelity_threads fidelity-threads)))

(defn execute-subgraph [branch-start ctx graph logs-root registry on-event retry-options]
  (let [start-node-id (if (map? branch-start) (:to branch-start) branch-start)
        cancelled? (fn [] (or (when-let [pipeline-cancelled? (:cancelled? retry-options)]
                               (pipeline-cancelled?))
                             (when-let [branch-cancelled? (:branch-cancelled? retry-options)]
                               (branch-cancelled?))))
        incoming-branch-edge
        (if (map? branch-start)
          branch-start
          (first (filter (fn [edge] (= start-node-id (:to edge)))
                         (:edges graph))))]
   (loop [current-node (parser/find-node graph start-node-id)
         last-outcome {:status :success}
         step-count 0
         incoming-edge incoming-branch-edge
         completed-nodes []
         node-outcomes {}]
    (cond
      (or (= :cancelled (:status last-outcome)) (cancelled?))
      {:status :cancelled :failure_reason "Pipeline cancelled"}

      (nil? current-node)
      {:status :fail
       :failure_reason (str "Parallel branch target '" start-node-id "' does not exist")}

      (> step-count 500)
      {:status :fail
       :failure_reason "Parallel branch step limit exceeded (500 steps)"}

      (or (= (:shape current-node) "tripleoctagon")
          (terminal-node? current-node))
      (assoc last-outcome :boundary_node_id (:id current-node))

      :else
      (let [prepared-node
            (execution-node current-node incoming-edge graph ctx completed-nodes
                            node-outcomes
                            (or (:fidelity-threads retry-options) (atom {})) nil)
            prepared-node (assoc prepared-node
                                 :cancelled? (fn [] (or (when-let [cancelled? (:cancelled? retry-options)]
                                                          (cancelled?))
                                                        (when-let [branch-cancelled? (:branch-cancelled? retry-options)]
                                                          (branch-cancelled?)))))
            handler (handlers/resolve-handler registry prepared-node)
            outcome (execute-with-retry handler prepared-node ctx graph logs-root
                                        on-event retry-options)
            node-id (:id current-node)
            next-completed (conj completed-nodes node-id)
            next-outcomes (assoc node-outcomes node-id outcome)]
        (if (= :cancelled (:status outcome))
          (clear-attempt-status! logs-root node-id)
          (write-stage-status! logs-root node-id outcome))
        (context/ctx-apply-updates! ctx (:context_updates outcome))
        (context/ctx-set! ctx "outcome"
                          (if (keyword? (:status outcome))
                            (name (:status outcome))
                            (str (:status outcome))))
        (let [next-edge (if (= :fail (:status outcome))
                          (select-failure-edge current-node outcome ctx graph)
                          (select-edge current-node outcome ctx graph))]
          (if (nil? next-edge)
            (if (= :fail (:status outcome))
              (let [retry-target (resolve-node-retry-target current-node)]
                (if (and retry-target (parser/find-node graph retry-target))
                  (recur (parser/find-node graph retry-target)
                         outcome
                         (inc step-count)
                         nil
                         next-completed
                         next-outcomes)
                  outcome))
              outcome)
            (recur (parser/find-node graph (:to next-edge))
                   outcome
                   (inc step-count)
                   next-edge
                   next-completed
                   next-outcomes))))))))

(declare run-pipeline)
(declare close-fidelity-threads!)

(defn- clone-handler-registry [registry]
  (let [original @registry
        branch-executor (atom nil)
        manager-runtime (atom {})
        parallel-handler
        (handlers/make-parallel-handler
          (fn [branch-edge branch-ctx graph logs-root branch-cancelled?]
            (if-let [execute-fn @branch-executor]
              (execute-fn branch-edge branch-ctx graph logs-root branch-cancelled?)
              {:status :fail
               :failure_reason
               "Parallel branch executor is not initialized"}))
          true true)
        manager-handler (handlers/make-manager-loop-handler manager-runtime)
        default-parallel? (identical?
                            (get original "parallel")
                            (get original handlers/parallel-default-handler-key))
        default-manager? (identical?
                           (get original "stack.manager_loop")
                           (get original handlers/manager-default-handler-key))]
    (atom
      (cond->
        (assoc original
               handlers/parallel-executor-key branch-executor
               handlers/manager-runtime-key manager-runtime)
        default-parallel?
        (assoc "parallel" parallel-handler
               handlers/parallel-default-handler-key parallel-handler)
        default-manager?
        (assoc "stack.manager_loop" manager-handler
               handlers/manager-default-handler-key manager-handler)))))

(defn- child-outcome-status [result]
  (cond
    (#{:success :partial_success} (:status result))
    {:status :completed :outcome :success}

    (= :cancelled (:status result))
    {:status :cancelled :outcome :cancelled
     :failure_reason (or (:failure_reason result)
                         "Child pipeline cancelled")}

    :else
    {:status :failed :outcome :fail
     :failure_reason (or (:failure_reason result)
                         "Child pipeline failed")}))

(defn- run-child-pipeline! [child-graph child-registry child-logs child-context
                            cancelled? child-event retry-policy state]
  (try
    (let [result
          (run-pipeline
            child-graph
            (cond-> {:registry child-registry
                     :logs-root child-logs
                     :context child-context
                     :cancelled? cancelled?
                     :on-event child-event}
              retry-policy (assoc :retry-policy retry-policy)))]
      (swap! state merge (child-outcome-status result) {:result result})
      result)
    (catch Object e
      (swap! state assoc
             :status :failed :outcome :fail
             :failure_reason (str e))
      {:status :fail :failure_reason (str e)})))

(defn- make-child-runtime [registry on-event cancelled? options]
  {:child (:manager-child options)

   :start-child
   (fn [dotfile child-logs manager-node]
     (let [child-graph (parser/parse-dot (io/slurp dotfile))
           child-registry (clone-handler-registry registry)
           child-context (context/make-context)
           child-stop (atom false)
           manager-cancelled? (or (:cancelled? manager-node) (fn [] false))
           child-cancelled? (fn [] (or @child-stop
                                       (cancelled?)
                                       (manager-cancelled?)))
           manager-node-id (:id manager-node)
           state (atom {:status :running :outcome :running
                        :active_stage "" :node_outcomes {}
                        :retry_counts {} :artifacts []})
           child-event
           (fn [event]
             (case (:type event)
               :stage.started
               (swap! state assoc :active_stage (:node_id event))
               :stage.completed
               (do
                 (swap! state assoc-in [:node_outcomes (:node_id event)]
                        (:outcome event))
                 (when-let [artifacts (get-in event [:outcome :artifacts])]
                   (swap! state update :artifacts into artifacts)))
               :stage.failed
               (do
                 (swap! state assoc-in [:node_outcomes (:node_id event)]
                        (:outcome event))
                 (when-let [artifacts (get-in event [:outcome :artifacts])]
                   (swap! state update :artifacts into artifacts)))
               :stage.retrying
               (swap! state assoc-in [:retry_counts (:node_id event)]
                      (:attempt event))
               nil)
             (on-event {:type :manager.child_event
                        :manager_node_id manager-node-id
                        :child_logs child-logs
                        :event event}))
           task
           (core/future
             (run-child-pipeline! child-graph child-registry child-logs
                                  child-context child-cancelled? child-event
                                  (:retry-policy options) state))]
       {:state state :future task :logs-root child-logs
        :context child-context :cancelled? child-stop}))

   :observe-child
   (fn [child]
     (if (:state child) @(:state child) child))

   :stop-child
   (fn [child]
     (when-let [child-cancelled? (:cancelled? child)]
       (reset! child-cancelled? true))
     (when-let [task (:future child)]
       @task))

   :cancelled? cancelled?

   :steer-child
   (fn [child node ctx]
     (let [state @(:state child)
           active-stage (:active_stage state)
           target-dir (if (str/blank? active-stage)
                        (:logs-root child)
                        (str (:logs-root child) "/" active-stage))
           instruction (or (get-in node [:attrs :manager.steer_prompt])
                           (context/ctx-get-string
                             ctx "manager.steering" "Continue toward the goal."))]
       (os/sh "mkdir" "-p" target-dir)
       (io/spit (str target-dir "/steering.md") instruction)))

   :sleep-fn
   (fn [delay-ms]
     (loop [remaining delay-ms]
       (when (and (> remaining 0) (not (cancelled?)))
         (let [chunk (min remaining 100)]
           (core/sleep chunk)
           (recur (- remaining chunk))))))})

;; Main execution loop (Section 3.2)
(defn- run-pipeline*
  ([graph] (run-pipeline* graph {}))
  ([graph options]
   (let [ctx (or (:context options) (context/make-context))
         logs-root (context/init-run-dir (:logs-root options) graph)
         on-event (or (:on-event options) (fn [_] nil))
         cancelled? (or (:cancelled? options) (fn [] false))
         registry-template (or (:registry options)
                               (handlers/make-handler-registry))
         registry (if (or (get @registry-template handlers/parallel-executor-key)
                          (get @registry-template handlers/manager-runtime-key))
                    (clone-handler-registry registry-template)
                    registry-template)
         retry-counts (or (:retry-counts options)
                          (atom (or (:node-retries options) {})))
         fidelity-threads (or (:fidelity-threads options) (atom {}))
         retry-options (assoc options :retry-counts retry-counts)
         parallel-executor (get @registry handlers/parallel-executor-key)
         manager-runtime (get @registry handlers/manager-runtime-key)
         _parallel-init (when parallel-executor
                          (reset! parallel-executor
                                  (fn [branch-edge branch-ctx branch-graph branch-logs branch-cancelled?]
                                    (let [branch-threads (atom {})]
                                      (try
                                        (execute-subgraph
                                          branch-edge branch-ctx branch-graph
                                          branch-logs registry on-event
                                          (assoc retry-options
                                                 :retry-counts (atom {})
                                                 :branch-cancelled? (fn [] (or (cancelled?)
                                                                                (branch-cancelled?)))
                                                 :fidelity-threads branch-threads))
                                        (finally
                                          (close-fidelity-threads!
                                            branch-threads)))))))
         _manager-init (when manager-runtime
                         (reset! manager-runtime
                                 (or (:manager-runtime options)
                                     (make-child-runtime registry on-event
                                                         cancelled? options))))
         initial-start-node (if (:start-at options)
                              (parser/find-node graph (:start-at options))
                              (val (parser/find-start-node graph)))]

     (when (nil? initial-start-node)
       (throw (ex-info "Pipeline start node could not be resolved" {})))

     (context/mirror-graph-attributes! graph ctx)
     (context/ctx-set! ctx "run.id" logs-root)
     (on-event {:type :pipeline.started :id (:id graph) :goal (:goal graph) :logs_root logs-root})

     (loop [current-node initial-start-node
            completed-nodes (or (:completed-nodes options) [])
            node-outcomes (normalize-node-outcomes (:node-outcomes options))
            incoming-edge (:initial-incoming-edge options)
            step-count 0]

       (cond
         (cancelled?)
         (let [res {:status :cancelled
                    :failure_reason "Pipeline cancelled"
                    :completed_nodes completed-nodes
                    :context (context/ctx-snapshot ctx)}]
           (on-event {:type :pipeline.cancelled
                      :completed_nodes completed-nodes})
           res)

         ;; Safety limit on steps to avoid infinite loops (10,000 steps max)
         (> step-count 10000)
         (let [res {:status :fail :failure_reason "Pipeline step limit exceeded (10000 steps)" :completed_nodes completed-nodes}]
           (on-event {:type :pipeline.failed :error (:failure_reason res)})
           res)

         :else
         (let [node-id (:id current-node)]
           (context/ctx-set! ctx "current_node" node-id)

           ;; Step 1: Check for terminal node
           (if (terminal-node? current-node)
             (let [[gates-ok? failed-gate] (check-goal-gates graph node-outcomes)]
               (if (not gates-ok?)
                 (let [retry-id (resolve-retry-target failed-gate graph)]
                   (if (and retry-id (parser/find-node graph retry-id))
                     (do
                       (on-event {:type :goal_gate.retrying :unsatisfied_node (:id failed-gate) :target retry-id})
                       (recur (parser/find-node graph retry-id)
                              completed-nodes
                              node-outcomes
                              nil
                              (inc step-count)))
                     (let [fail-res {:status :fail
                                     :failure_reason "Goal gate unsatisfied and no retry target"
                                     :unsatisfied_gate (:id failed-gate)
                                     :completed_nodes completed-nodes}]
                       (on-event {:type :pipeline.failed :error (:failure_reason fail-res)})
                       fail-res)))
                 ;; Terminal node reached, goal gates satisfied!
                 (let [success-res {:status :success
                                    :notes "Pipeline completed"
                                    :completed_nodes (conj completed-nodes node-id)
                                    :context (context/ctx-snapshot ctx)}]
                   ;; Write final checkpoint
                   (let [cp {:timestamp (str (System/currentTimeMillis))
                             :current_node node-id
                             :completed_nodes (conj completed-nodes node-id)
                             :node_retries @retry-counts
                             :node_outcomes node-outcomes
                             :context_values (context/ctx-snapshot ctx)
                             :logs (:logs @ctx)}]
                     (context/save-checkpoint cp (str logs-root "/checkpoint.edn")))
                   (on-event {:type :pipeline.completed :duration_steps step-count :completed_nodes (:completed_nodes success-res)})
                   success-res)))

             ;; Step 2: Execute node handler with retry policy
             (let [prepared-node
                   (execution-node
                     current-node incoming-edge graph ctx completed-nodes
                     node-outcomes fidelity-threads
                     (when (and (zero? step-count)
                                (:first-node-fidelity-override options))
                       (:first-node-fidelity-override options)))
                   prepared-node (assoc prepared-node :cancelled? cancelled?)
                   handler (handlers/resolve-handler registry prepared-node)
                   outcome (execute-with-retry handler prepared-node ctx graph logs-root
                                               on-event retry-options)
                   st (:status outcome)]

               ;; The engine owns the status-file contract for every handler,
               ;; including no-op, human, tool, and custom handlers.
               (if (= :cancelled st)
                 (clear-attempt-status! logs-root node-id)
                 (write-stage-status! logs-root node-id outcome))

               (if (= st :cancelled)
                 (let [cancelled-result
                       {:status :cancelled
                        :failure_reason (or (:failure_reason outcome)
                                            "Pipeline cancelled")
                        :completed_nodes completed-nodes
                        :context (context/ctx-snapshot ctx)}]
                   (on-event {:type :pipeline.cancelled
                              :completed_nodes completed-nodes})
                   cancelled-result)

                 ;; Step 3: Record completion
                 (let [new-completed (conj completed-nodes node-id)
                       new-outcomes (assoc node-outcomes node-id outcome)]

                 ;; Step 4: Apply context updates from outcome
                 (context/ctx-apply-updates! ctx (:context_updates outcome))
                 (context/ctx-set! ctx "outcome" (if (keyword? st) (name st) (str st)))
                 (when-not (str/blank? (:preferred_label outcome))
                   (context/ctx-set! ctx "preferred_label" (:preferred_label outcome)))

                 ;; Step 5: Save checkpoint
                 (let [cp {:timestamp (str (System/currentTimeMillis))
                           :current_node node-id
                           :completed_nodes new-completed
                           :node_retries @retry-counts
                           :node_outcomes new-outcomes
                           :current_fidelity (:resolved_fidelity prepared-node)
                           :context_values (context/ctx-snapshot ctx)
                           :logs (:logs @ctx)}]
                   (context/save-checkpoint cp (str logs-root "/checkpoint.edn"))
                   (on-event {:type :checkpoint.saved :node_id node-id}))

                 ;; Step 6: Select next edge
                 (let [next-edge (if (= st :fail)
                                   (select-failure-edge current-node outcome ctx graph)
                                   (if-let [next-node-id (:next_node_id outcome)]
                                     {:to next-node-id}
                                     (select-edge current-node outcome ctx graph)))]
                   (if (nil? next-edge)
                     ;; No edge selected: handle failure routing or exit
                     (if (= st :fail)
                       ;; Try failure routing (Section 3.7)
                       (let [retry-target (resolve-node-retry-target current-node)]
                         (if (and retry-target (parser/find-node graph retry-target))
                           (recur (parser/find-node graph retry-target)
                                  new-completed
                                  new-outcomes
                                  nil
                                  (inc step-count))
                           (let [fail-res {:status :fail
                                           :failure_reason (or (:failure_reason outcome) "Stage failed and no route found")
                                           :completed_nodes new-completed}]
                             (on-event {:type :pipeline.failed :error (:failure_reason fail-res)})
                             fail-res)))
                       ;; Succeeded with no outgoing edges
                       (let [succ-res {:status :success
                                       :notes "Pipeline completed (no outgoing edges)"
                                       :completed_nodes new-completed
                                       :context (context/ctx-snapshot ctx)}]
                         (on-event {:type :pipeline.completed :duration_steps step-count})
                         succ-res))

                     ;; Step 7: Handle loop_restart
                     (if (:loop_restart next-edge)
                       (let [fresh-logs (str logs-root "_restart_" (System/currentTimeMillis))]
                         (on-event {:type :pipeline.restarting :target (:to next-edge) :new_logs fresh-logs})
                         (close-fidelity-threads! fidelity-threads)
                         (run-pipeline
                           graph
                           (assoc (dissoc options :fidelity-threads)
                                  :start-at (:to next-edge)
                                  :logs-root fresh-logs
                                  :initial-incoming-edge next-edge
                                  :retry-counts retry-counts)))

                       ;; Step 8: Advance to next node
                       (let [next-node (parser/find-node graph (:to next-edge))]
                         (if (nil? next-node)
                           (let [fail-res {:status :fail
                                           :failure_reason (str "Target node '" (:to next-edge) "' does not exist")
                                           :completed_nodes new-completed}]
                             (on-event {:type :pipeline.failed :error (:failure_reason fail-res)})
                             fail-res)
                           (recur next-node
                                  new-completed
                                  new-outcomes
                                  next-edge
                                  (inc step-count)))))))))))))))))

(defn- close-fidelity-threads! [threads]
  (doseq [[_ entry] @threads]
    (when-let [close-fn (:close entry)]
      (close-fn)))
  (reset! threads {}))

(defn run-pipeline
  ([graph] (run-pipeline graph {}))
  ([graph options]
   (let [owns-threads? (nil? (:fidelity-threads options))
         threads (or (:fidelity-threads options) (atom {}))]
     (try
       (run-pipeline* graph (assoc options :fidelity-threads threads))
       (finally
         (when owns-threads?
           (close-fidelity-threads! threads)))))))

;; Resume pipeline execution from a saved checkpoint (Section 5.3)
(defn resume-pipeline [checkpoint-path graph options]
  (let [cp (context/load-checkpoint checkpoint-path)
        last-node-id (:current_node cp)
        ctx (context/make-context (:context_values cp))
        completed-nodes (:completed_nodes cp)
        last-node (parser/find-node graph last-node-id)
        last-incoming-edge
        (incoming-edge-for graph (vec (butlast completed-nodes)) last-node-id)
        last-fidelity
        (or (:current_fidelity cp)
            (when last-node
              (context/resolve-fidelity last-incoming-edge last-node graph)))
        node-outcomes (normalize-node-outcomes (:node_outcomes cp))
        saved-outcome (get node-outcomes last-node-id)
        outcome (or saved-outcome
                    {:status (keyword
                               (context/ctx-get-string ctx "outcome" "success"))
                     :preferred_label
                     (context/ctx-get-string ctx "preferred_label" "")})
        failed? (= :fail (:status outcome))
        next-edge (when last-node
                    (if failed?
                      (select-failure-edge last-node outcome ctx graph)
                      (select-edge last-node outcome ctx graph)))
        retry-target (when (and failed? (nil? next-edge))
                       (resolve-node-retry-target last-node))
        next-id (or (:to next-edge) retry-target)]

    (cond
      (and next-id (parser/find-node graph next-id))
      (run-pipeline
        graph
        (cond->
          (assoc options
                 :context ctx
                 :start-at next-id
                 :completed-nodes completed-nodes
                 :node-outcomes node-outcomes
                 :node-retries (:node_retries cp)
                 :initial-incoming-edge next-edge)
          (= "full" last-fidelity)
          (assoc :first-node-fidelity-override "summary:high")))

      failed?
      (cond-> {:status :fail
               :failure_reason (or (:failure_reason outcome)
                                   "Stage failed and no route found")
               :completed_nodes completed-nodes
               :context (context/ctx-snapshot ctx)}
        (:goal_gate last-node) (assoc :unsatisfied_gate last-node-id))

      :else
      {:status :success
       :notes "Pipeline checkpoint already represents a completed run"
       :completed_nodes completed-nodes
       :context (context/ctx-snapshot ctx)})))
