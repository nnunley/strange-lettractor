(ns attractor.agents.claude
  (:require [attractor.execution :as execution] [clojure.core :as core]
            [clojure.string :as str] [io :as io] [os :as os] [json :as json]))

(defn- fail! [category message] (throw (ex-info message {:category category :source :claude})))
(defn- quote-arg [s] (str "'" (str/replace s "'" "'\"'\"'") "'"))
(defn- checked-sh [& args]
  (let [r (apply os/sh args)]
    (when-not (= 0 (:exit r)) (fail! :claude-io "Claude agent temporary-file operation failed"))
    (:out r)))
(defn- validate! [opts]
  (when-not (and (string? (:prompt opts)) (string? (:working_dir opts))
                (not (str/blank? (:working_dir opts)))
                (vector? (:command opts)) (seq (:command opts))
                (every? #(and (string? %) (not (str/blank? %)) (not (str/includes? % "\u0000"))) (:command opts))
                (vector? (:tools opts)) (every? #(and (string? %) (not (str/blank? %))) (:tools opts))
                (contains? #{"plan" "acceptEdits" "dontAsk"} (:permission_mode opts))
                (integer? (:timeout_ms opts)) (pos? (:timeout_ms opts))
                (or (nil? (:model opts)) (and (string? (:model opts)) (not (str/blank? (:model opts))))))
    (fail! :invalid-request "Invalid Claude agent options")))

(defn run!
  "Run Claude Code's tool loop. Prompt is private stdin; callbacks receive identified
  protocol records and text deltas. Completion requires a terminal result and exit 0."
  [options]
  (let [opts (merge {:command ["claude"] :tools ["Read"] :permission_mode "plan"
                    :timeout_ms 120000 :working_dir (os/cwd)} options)
        _ (validate! opts)
        job-id (str (random-uuid)) session-id (atom nil) terminal (atom nil)
        callback (or (:on_event opts) (fn [_] nil)) cancelled? (or (:cancelled? opts) (fn [] false))
        directory (str/trim (checked-sh "/usr/bin/mktemp" "-d"))
        files (atom []) reader (atom nil) completion (promise)
        environment (execution/make-local-environment {:working_dir (:working_dir opts)
                     :max_command_timeout_ms (:timeout_ms opts) :env_policy :all})
        started (atom false)
        emit! (fn [type record text]
                (try (callback (cond-> {:source :claude :job_id job-id :session_id @session-id
                                         :type type :event record} text (assoc :text text)))
                     (catch Object e (fail! :claude-callback "Claude agent event callback failed"))))
        record! (fn [line]
                  (when (> (count (bytes line)) 1048576) (fail! :claude-output-limit "Claude record exceeds 1 MiB"))
                  (let [record (try (json/read-json line) (catch Object e (fail! :claude-protocol "Malformed Claude JSON record")))
                        type (get record "type") sid (get record "session_id")]
                    (when-not (and (map? record) (string? type)) (fail! :claude-protocol "Invalid Claude record"))
                    (when @terminal (fail! :claude-protocol "Claude emitted a record after its terminal result"))
                    (when sid
                      (when-not (and (string? sid) (not (str/blank? sid)) (or (nil? @session-id) (= sid @session-id)))
                        (fail! :claude-protocol "Claude session identity changed"))
                      (reset! session-id sid))
                    (emit! :protocol record nil)
                    (when (= type "stream_event")
                      (let [delta (get-in record ["event" "delta"])]
                        (when (= "text_delta" (get delta "type"))
                          (when-not (string? (get delta "text")) (fail! :claude-protocol "Invalid Claude text delta"))
                          (emit! :text_delta record (get delta "text")))))
                    (when (= type "result")
                      (when-not (and (contains? record "is_error") (boolean? (get record "is_error")))
                        (fail! :claude-protocol "Invalid Claude terminal result"))
                      (when (get record "is_error") (fail! :claude-result "Claude reported an unsuccessful result"))
                      (when-not (string? (get record "result")) (fail! :claude-protocol "Claude result has no text"))
                      (reset! terminal record))))]
    (try
      (let [stdout (str/trim (checked-sh "/usr/bin/mktemp" (str directory "/stdout.XXXXXX")))
            _ (swap! files conj stdout)
            stderr (str/trim (checked-sh "/usr/bin/mktemp" (str directory "/stderr.XXXXXX")))
            _ (swap! files conj stderr)
            argv (concat (:command opts) ["-p" "--output-format" "stream-json" "--verbose"
                          "--include-partial-messages" "--safe-mode" "--permission-prompts" "none"
                          "--permission-mode" (:permission_mode opts) "--tools" (str/join "," (:tools opts))]
                         (when (:model opts) ["--model" (:model opts)]))
            command (str (str/join " " (map quote-arg argv)) " > " (quote-arg stdout) " 2> " (quote-arg stderr))
            deadline (+ (System/currentTimeMillis) (:timeout_ms opts))]
        (reset! reader (io/open stdout :read))
        (when (cancelled?) (fail! :cancelled "Claude agent cancelled"))
        (future (try (deliver completion {:value ((:exec_command_stdin environment) command (:timeout_ms opts) nil nil (:prompt opts))})
                     (catch Object e (deliver completion {:error e}))))
        (reset! started true)
        (loop [pending "" total 0]
          (when (cancelled?) (fail! :cancelled "Claude agent cancelled"))
          (when (> (System/currentTimeMillis) deadline) (fail! :timeout "Claude agent timed out"))
          (when (> (or (:size (os/stat stderr)) 0) 16777216) (fail! :claude-output-limit "Claude stderr exceeds 16 MiB"))
          ;; Observe process completion BEFORE reading EOF: otherwise the child
          ;; can append its last record between EOF and completion observation.
          (let [completed-before-read (realized? completion)]
          (if-let [chunk (core/read-bytes @reader 4096)]
            (let [size (+ total (count (bytes chunk))) parts (str/split (str pending chunk) #"\n")]
              (when (> size 16777216) (fail! :claude-output-limit "Claude stdout exceeds 16 MiB"))
              (doseq [line (butlast parts)] (when-not (str/blank? line) (record! line)))
              (when (> (count (bytes (last parts))) 1048576) (fail! :claude-output-limit "Claude record exceeds 1 MiB"))
              (recur (last parts) size))
            (if completed-before-read
              (let [done @completion result (:value done)]
                (when (:error done) (throw (:error done)))
                (when (:cancelled result) (fail! :cancelled "Claude agent cancelled"))
                (when (:timed_out result) (fail! :timeout "Claude agent timed out"))
                (when-not (= 0 (:exit_code result))
                  (let [error-reader (io/open stderr :read)
                        diagnostic (try (or (core/read-bytes error-reader 4096) "") (finally (io/close! error-reader)))]
                    (throw (ex-info (str "Claude exited with code " (:exit_code result))
                                   {:category :claude-exit :source :claude :exit_code (:exit_code result) :stderr diagnostic}))))
                (when-not (str/blank? pending) (fail! :claude-protocol "Truncated Claude JSON record"))
                (when-not @terminal (fail! :claude-protocol "Claude exited without a terminal result"))
                (emit! :completed @terminal nil)
                {:job_id job-id :session_id @session-id :text (get @terminal "result") :result @terminal :exit_code 0})
              (do (core/sleep 10) (recur pending total)))))))
      (finally
        ;; cleanup signals the owned process group. The explicit completion join
        ;; also covers the short window before execution registers its command.
        (try ((:cleanup environment))
             (finally
               (when @started @completion)
               (when @reader (io/close! @reader))
               (doseq [file @files] (checked-sh "/bin/rm" "--" file))
               (checked-sh "/bin/rmdir" "--" directory)))))))
