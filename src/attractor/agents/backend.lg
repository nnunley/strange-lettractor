(ns attractor.agents.backend
  "Adapt any registered external agent to the codergen backend contract.
   These one-shot connectors do not implement full-fidelity session reuse or
   intercept the agent's internal tool calls for Attractor tool hooks."
  (:require [clojure.string :as str]
            [attractor.agents.registry :as registry]))

(defn make-backend
  [agent opts]
  (let [agent (registry/resolve-agent agent)]
    (fn [node prompt _context]
      (when (= "full" (:resolved_fidelity node))
        (throw (ex-info (str (name agent) " does not yet support full-fidelity sessions")
                        {:category :configuration_error :retryable false})))
      (when (some #(not (str/blank? %))
                  (vals (select-keys (:attractor.tool-hooks/invocation node) [:pre :post])))
        (throw (ex-info (str "Attractor tool hooks cannot intercept " (name agent) "'s tools")
                        {:category :configuration_error :retryable false})))
      (:text
        (registry/run! agent
          (assoc opts :prompt prompt
                 :model (or (:model opts) (:llm_model node))
                 :cancelled? (fn [] (boolean (or (when-let [cancelled? (:cancelled? node)] (cancelled?))
                                                (when-let [cancelled? (:cancelled? opts)] (cancelled?)))))
                 :on_event (fn [event]
                             (when-let [listener (:on_event opts)]
                               (listener (assoc event :node_id (:id node)))))))))))
