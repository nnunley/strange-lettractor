(ns attractor.agents.codex
  "Owned Codex app-server agent: one thread, one turn, streamed agent message
   deltas, identified events. Approval and permission requests from the server
   are refused with a JSON-RPC error; this agent never grants authority on the
   user's behalf. Completion requires a completed turn."
  (:require [attractor.ids :as ids] [clojure.string :as str] [clojure.core :as core] [os :as os]
            [attractor.codex.transport :as transport]))

(defn- fail! [category message & [data]]
  (throw (ex-info message (merge {:category category :source :codex} data))))

(defn- validate! [opts]
  (when-not (and (string? (:prompt opts)) (not (str/blank? (:prompt opts)))) (fail! :invalid-request "Codex agent needs a prompt"))
  (when-not (and (vector? (:command opts)) (seq (:command opts))) (fail! :invalid-request "Codex agent needs a command"))
  (when-not (and (integer? (:timeout_ms opts)) (pos? (:timeout_ms opts))) (fail! :invalid-request "Codex agent needs a positive timeout"))
  (when-not (contains? #{"read-only" "workspace-write" "danger-full-access"} (:sandbox opts))
    (fail! :invalid-request "Codex sandbox must be read-only, workspace-write or danger-full-access")))

(defn run!
  "Options: :prompt, :working_dir, :model, :sandbox (\"read-only\" default;
   the live app-server's thread/start takes the kebab-case sandbox mode),
   :approval_policy (\"never\" default), :timeout_ms (120000), :command
   ([\"codex\" \"app-server\" \"--stdio\"]), :on_event, :cancelled?.
   Returns {:job_id :thread_id :turn_id :text :status} or throws."
  [options]
  (let [opts (merge {:command ["codex" "app-server" "--stdio"] :sandbox "read-only" :approval_policy "never"
                     :timeout_ms 120000 :working_dir (os/cwd)} options)
        _ (validate! opts)
        job-id (ids/uuid-text)
        callback (or (:on_event opts) (fn [_] nil)) cancelled? (or (:cancelled? opts) (fn [] false))
        next-id (atom 0) replies (atom {}) text (atom "") turn (atom nil) thread (atom nil)
        done (promise) failure (atom nil)
        emit! (fn [type record & [delta]]
                (callback (cond-> {:source :codex :job_id job-id :thread_id @thread :turn_id @turn :type type :event record}
                            delta (assoc :text delta))))
        t (atom nil)
        request! (fn [method params]
                   (let [id (swap! next-id inc) reply (promise)]
                     (swap! replies assoc id reply)
                     (transport/send! @t {"id" id "method" method "params" params})
                     (let [deadline (:timeout_ms opts)
                           response (deref reply deadline ::timeout)]
                       (cond
                         (= ::timeout response) (fail! :timeout (str "Codex did not answer " method))
                         (contains? response "error") (fail! :codex-error (str method " failed: " (get-in response ["error" "message"])) {:error (get response "error")})
                         :else (get response "result")))))
        on-message (fn [message]
                     (emit! :protocol message)
                     (cond
                       ;; Response to one of our requests.
                       (and (contains? message "id") (not (contains? message "method")))
                       (when-let [reply (get @replies (get message "id"))] (deliver reply message))
                       ;; Server request: refuse, never grant.
                       (and (contains? message "id") (contains? message "method"))
                       (transport/send! @t {"id" (get message "id")
                                            "error" {"code" -32000 "message" (str "refused by attractor agent: " (get message "method"))}})
                       ;; Notifications.
                       :else
                       (case (get message "method")
                         "item/agentMessage/delta" (let [d (get-in message ["params" "delta"])]
                                                     (swap! text str d) (emit! :text_delta message d))
                         "turn/completed" (let [status (get-in message ["params" "turn" "status"])]
                                            (deliver done {:status status :error (get-in message ["params" "turn" "error"])}))
                         "error" (reset! failure (get-in message ["params" "message"]))
                         nil)))]
    (reset! t (transport/open! {:command (:command opts) :on-message on-message
                                :on-failure (fn [e] (reset! failure (str e)) (deliver done {:status "transport-failed" :error {"message" (str e)}}))
                                :shutdown-ms 2000}))
    (try
      (request! "initialize" {"clientInfo" {"name" "strange-lettractor" "version" "0.1"} "capabilities" {}})
      (transport/send! @t {"method" "initialized" "params" {}})
      (let [started (request! "thread/start" (cond-> {"cwd" (:working_dir opts) "approvalPolicy" (:approval_policy opts)
                                                       "sandbox" (:sandbox opts)}
                                                (:model opts) (assoc "model" (:model opts))))]
        (reset! thread (get-in started ["thread" "id"]))
        (when (str/blank? @thread) (fail! :codex-protocol "thread/start returned no thread id")))
      (let [turn-result (request! "turn/start" {"threadId" @thread "input" [{"type" "text" "text" (:prompt opts)}]})]
        (reset! turn (get-in turn-result ["turn" "id"])))
      (let [deadline (+ (System/currentTimeMillis) (:timeout_ms opts))]
        (loop []
          (cond
            (realized? done) nil
            (cancelled?) (do (try (transport/send! @t {"id" (swap! next-id inc) "method" "turn/interrupt"
                                                       "params" {"threadId" @thread "turnId" @turn}})
                                  (catch Object _ nil))
                             (deref done 2000 nil)
                             (fail! :cancelled "Codex agent cancelled"))
            (> (System/currentTimeMillis) deadline) (fail! :timeout "Codex agent timed out")
            :else (do (core/sleep 10) (recur)))))
      (let [{:keys [status error]} @done]
        (case status
          "completed" (do (emit! :completed {"status" status "text" @text})
                          {:job_id job-id :thread_id @thread :turn_id @turn :text @text :status status})
          "interrupted" (fail! :cancelled "Codex turn interrupted")
          "transport-failed" (fail! :codex-protocol (str "Codex transport failed: " (get error "message")))
          (fail! :codex-result (str "Codex turn " status ": " (get error "message")) {:status status :error error})))
      (finally
        (try (transport/close! @t) (catch Object _ nil))))))
