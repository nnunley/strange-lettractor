(ns attractor.mcp-client
  "Minimal MCP Streamable HTTP client (Slice E, WP-3 follow-up scope).

   Modern-first per the current spec revision: stateless single-POST calls
   with per-request SSE streams, no protocol sessions, no session headers.
   On HTTP 400 the body decides: a recognized modern JSON-RPC error means
   the request itself is wrong (stay modern, report it); an empty or
   unrecognized body means a legacy-era server, and the client falls back
   to the initialize handshake plus Mcp-Session-Id session behavior
   (required by legacy pilots that advertise Mcp-Session-Id).

   Transport is an injectable fn shaped like http/request: it takes
   {:method :url :headers :body} and returns {:status :headers :body}.
   The default transport is http/request itself. Calls are bounded by
   timeout plus an optional abort poll through capacity/call!, whose worker
   errors stay redacted. Empty or malformed successes fail closed; a
   transport-level throw means :mcp-unavailable, never empty data."
  (:require [attractor.codex.transport :as codex.transport]
            [attractor.context-discovery :as capacity]
            [attractor.llm :as llm]
            [clojure.core :as core]
            [clojure.string :as str]
            [http :as http]
            [json :as json]))

(def default-timeout-ms 10000)
(def modern-protocol-version "2026-07-28")

(defn- fail! [category data]
  (throw (ex-info (str "MCP: " (name category)) (assoc data :category category))))

(defn- non-blank-string? [value]
  (and (string? value) (not (str/blank? value))))

;; stdio transport: owned subprocess, newline-delimited JSON-RPC.
;; ---------------------------------------------------------------------------
;; The child is launched through the owned codex duplex transport
;; (exact-PID management, FIFO plus files, reader future, TERM/KILL
;; reaping). stdin/stdout carry JSONL frames, stderr is logs only and is
;; never parsed. The server MUST NOT send requests: any server request is
;; answered method-not-found and counted. Cancellation goes out as
;; notifications/cancelled. Responses correlate by request id; unknown or
;; late ids are ignored and counted, never failed.

(defn- real-open-transport [{:keys [command on-message on-failure max-frame-bytes shutdown-ms]}]
  (let [link (codex.transport/open! {:command command
                                     :on-message on-message
                                     :on-failure on-failure
                                     :max-frame-bytes max-frame-bytes
                                     :shutdown-ms shutdown-ms})]
    {:send (fn [message] (codex.transport/send! link message))
     :close (fn [] (codex.transport/close! link))
     :pid (fn [] (try (codex.transport/pid link) (catch Object _ nil)))}))

(defn- fail-stdio-pending! [handle reason]
  (let [state @handle
        waiting (vals @(:pending state))]
    (reset! (:pending state) {})
    (doseq [box (map :deliver waiting)]
      (try (deliver box {:transport-failed true :reason reason})
           (catch Object _ nil)))))

(defn- dispatch-stdio-message! [handle message]
  (swap! (:stats @handle) update :received inc)
  (cond (and (map? message) (contains? message "id") (contains? message "method"))
        (do (swap! (:stats @handle) update :server-requests-rejected inc)
            (try ((:send (:link @handle))
                  {"jsonrpc" "2.0" "id" (get message "id")
                                     "error" {"code" -32601
                                              "message" "server-to-client requests are not supported"}})
                 (catch Object _ nil)))

        (and (map? message) (contains? message "id"))
        (let [key (str (get message "id"))
              waiting (get @(:pending @handle) key)]
          (if (nil? waiting)
            (swap! (:stats @handle) update :stale inc)
            (do (swap! (:pending @handle) dissoc key)
                (deliver (:deliver waiting) message))))

        (and (map? message) (contains? message "method"))
        (swap! (:stats @handle) update :notifications inc)

        :else
        (swap! (:stats @handle) update :malformed inc)))

(defn- send-cancelled! [handle request-id]
  (try
    ((:send (:link @handle))
     {"jsonrpc" "2.0" "method" "notifications/cancelled"
                        "params" {"requestId" request-id}})
    (catch Object _ nil))
  nil)

(defn- await-stdio-response! [handle request-id box]
  (let [state @handle
        timeout-ms (or (:timeout-ms state) default-timeout-ms)
        aborted? (:aborted? state)
        deadline (+ (System/currentTimeMillis) timeout-ms)
        pending-key (str request-id)
        waiting ::stdio-waiting]
    (loop []
      (let [value (deref box 50 waiting)]
        (cond (not= value waiting)
              (if (and (map? value) (:transport-failed value))
                (fail! :mcp-unavailable {:reason (:reason value)})
                value)

              (and (some? aborted?) (aborted?))
              (do (send-cancelled! handle request-id)
                  (swap! (:pending @handle) dissoc pending-key)
                  (fail! :mcp-cancelled {}))

              (>= (System/currentTimeMillis) deadline)
              (do (send-cancelled! handle request-id)
                  (swap! (:pending @handle) dissoc pending-key)
                  (fail! :mcp-timeout {:timeout-ms timeout-ms}))

              :else (recur))))))

(defn- stdio-request! [handle method params]
  (let [state @handle
        request-id (swap! (:next-id state) inc)
        box (core/promise)
        _ (swap! (:pending state) assoc (str request-id) {:deliver box})
        _ (swap! (:stats state) update :sent inc)]
    (try
      ((:send (:link state))
       {"jsonrpc" "2.0" "id" request-id
                          "method" method "params" (or params {})})
      (catch Object error
        (swap! (:pending state) dissoc (str request-id))
        (fail! :mcp-unavailable {:reason :stdio-send-failed})))
    (let [response (await-stdio-response! handle request-id box)]
      (cond (and (map? response) (contains? response "result"))
            {:result (get response "result")}

            (and (map? response) (contains? response "error"))
            (fail! :mcp-remote-error {:code (get-in response ["error" "code"])
                                     :message (get-in response ["error" "message"])})

            :else
            (fail! :mcp-protocol-error {:reason :stdio-neither-result-nor-error})))))

(defn- open-stdio-session! [opts]
  (let [{:keys [command timeout-ms aborted? max-frame-bytes shutdown-ms open-transport]} (or opts {})
        _ (when-not (and (vector? command) (seq command)
                         (every? non-blank-string? command))
            (fail! :mcp-configuration {:reason :command-must-be-non-empty-strings}))
        opener (or open-transport real-open-transport)
        handle (atom {:mode :stdio
                      :timeout-ms (or timeout-ms default-timeout-ms)
                      :aborted? aborted?
                      :pending (atom {})
                      :stats (atom {:sent 0 :received 0 :server-requests-rejected 0
                                    :notifications 0 :malformed 0 :stale 0})
                      :next-id (atom 0)})
        link (try
               (opener {:command command
                        :max-frame-bytes (or max-frame-bytes 1048576)
                        :shutdown-ms (or shutdown-ms 2000)
                        :on-message (fn [message] (dispatch-stdio-message! handle message))
                        :on-failure (fn [error] (fail-stdio-pending! handle error))})
               (catch Object error
                 (fail! :mcp-unavailable {:reason :spawn-failed})))]
    (swap! handle assoc :link link)
    handle))

(defn server-pid
  "Exact child PID of a stdio handle, or nil when unknown. With
   wait-ms, polls briefly because the shell echoes $! asynchronously
   after spawn."
  [handle & [wait-ms]]
  (let [state (when (some? handle) @handle)]
    (when (= :stdio (:mode state))
      (let [read-pid (fn [] (try ((:pid (:link state))) (catch Object _ nil)))
            deadline (+ (System/currentTimeMillis) (or wait-ms 0))]
        (loop [pid (read-pid)]
          (if (or (some? pid) (>= (System/currentTimeMillis) deadline))
            pid
            (do (core/sleep 25)
                (recur (read-pid)))))))))

(defn- header-value [headers name]
  (let [wanted (str/lower-case (str name))]
    (some (fn [[key value]]
            (when (= wanted (str/lower-case (str key)))
              value))
          headers)))

(defn- rpc-envelope [method params id notify?]
  (cond-> {:jsonrpc "2.0" :method method}
    (some? params) (assoc :params params)
    (not notify?) (assoc :id id)))

(defn- parse-rpc-text [text]
  (let [message (try (json/read-json (str text))
                     (catch Object _
                       (fail! :mcp-protocol-error {:reason :malformed-json})))]
    (when-not (map? message)
      (fail! :mcp-protocol-error {:reason :rpc-not-an-object}))
    (cond (contains? message "result") {:ok true :result (get message "result")
                                        :id (get message "id")}
          (contains? message "error") {:ok false :error (get message "error")
                                       :id (get message "id")}
          :else (fail! :mcp-protocol-error {:reason :rpc-neither-result-nor-error}))))

(defn- sse-payload-text [body]
  (let [events (llm/parse-sse-lines (str/split (str body) #"\r?\n"))
        chunks (vec (remove str/blank? (map :data events)))]
    (when (empty? chunks)
      (fail! :mcp-protocol-error {:reason :empty-sse-stream}))
    (str/join "\n" chunks)))

(defn- decode-body [headers body]
  (let [content-type (str/lower-case (str (or (header-value headers "content-type") "")))]
    (if (str/includes? content-type "text/event-stream")
      (parse-rpc-text (sse-payload-text body))
      (parse-rpc-text body))))

(defn- bounded-post [handle url headers body-text]
  (let [transport (or (:transport @handle) http/request)
        outcome (capacity/call!
                  (fn [] (transport {:method :post :url url
                                     :headers headers :body body-text}))
                  {:timeout_ms (or (:timeout-ms @handle) default-timeout-ms)
                   :aborted? (:aborted? @handle)})]
    (if (and (map? outcome) (= :unavailable (:status outcome)))
      (fail! (case (:reason outcome)
               :timeout :mcp-timeout
               :abort :mcp-cancelled
               :mcp-unavailable)
             {:url url})
      outcome)))

(defn- check-rpc-id [parsed request-id]
  (when-not (= request-id (:id parsed))
    (fail! :mcp-protocol-error {:reason :rpc-id-mismatch
                               :request request-id :response (:id parsed)}))
  parsed)

(defn- post-request [handle method params]
  (let [state @handle
        request-id (swap! (:next-id state) inc)
        body-text (json/write-json (rpc-envelope method params request-id false))
        headers (cond-> (merge {"content-type" "application/json"
                                  "accept" "application/json, text/event-stream"}
                                 (:headers state))
                  (some? (:session-id state))
                  (assoc "mcp-session-id" (:session-id state)))
        response (bounded-post handle (:endpoint state) headers body-text)
        status (:status response)
        body (or (:body response) "")]
    (cond (= 401 status)
          (fail! :mcp-auth-failed {:url (:endpoint state)})

          (= 400 status)
          (let [parsed (try (json/read-json (str body)) (catch Object _ nil))]
            (if (and (map? parsed) (map? (get parsed "error")))
              (fail! :mcp-request-error {:code (get-in parsed ["error" "code"])
                                        :message (get-in parsed ["error" "message"])})
              (fail! :mcp-legacy-fallback-required {:url (:endpoint state)})))

          (contains? #{200 201} status)
          (let [parsed (check-rpc-id (decode-body (:headers response) body) request-id)]
            (if (:ok parsed)
              {:result (:result parsed)}
              (fail! :mcp-remote-error {:code (get-in parsed [:error "code"])
                                       :message (get-in parsed [:error "message"])})))

          :else
          (fail! :mcp-transport-error {:url (:endpoint state) :status status}))))

(defn- post-notification [handle method params]
  (let [state @handle
        body-text (json/write-json (rpc-envelope method params nil true))
        headers (cond-> (merge {"content-type" "application/json"
                                  "accept" "application/json, text/event-stream"}
                                 (:headers state))
                  (some? (:session-id state))
                  (assoc "mcp-session-id" (:session-id state)))]
    (bounded-post handle (:endpoint state) headers body-text)
    nil))

(defn open-session
  "Open a client handle (an atom). Streamable HTTP mode takes :endpoint
   (modern, stateless; upgrades to legacy on first fallback). stdio mode
   takes :command (owned subprocess); both together is a configuration
   error. Common opts: :transport (HTTP) or :open-transport (stdio),
   :timeout-ms, :aborted?, :headers (HTTP authorization)."
  [opts]
  (let [{:keys [transport endpoint timeout-ms aborted? headers command]} (or opts {})]
    (cond (some? command)
          (do (when (some? endpoint)
                (fail! :mcp-configuration {:reason :command-and-endpoint-exclusive}))
              (open-stdio-session! opts))

          (str/blank? (str endpoint))
          (fail! :mcp-configuration {:reason :endpoint-required})

          :else
          (atom {:transport transport :endpoint endpoint
                 :timeout-ms (or timeout-ms default-timeout-ms)
                 :aborted? aborted?
                 :headers (or headers {})
                 :mode :modern :session-id nil
                 :next-id (atom 0)}))))

(defn set-headers!
  "Replace the extra headers merged into every request (used for token
   refresh without rebuilding the handle)."
  [handle headers]
  (swap! handle assoc :headers (or headers {}))
  nil)

(defn- do-handshake! [handle]
  "Legacy initialize handshake. Captures the session id, marks the
   handle legacy, and sends notifications/initialized."
  (let [state @handle
        request-id (swap! (:next-id state) inc)
        body-text (json/write-json (rpc-envelope "initialize"
                                                 {:protocolVersion modern-protocol-version
                                                  :capabilities {}
                                                  :clientInfo {:name "attractor" :version "0"}}
                                                 request-id false))
        headers (merge {"content-type" "application/json"
                         "accept" "application/json, text/event-stream"}
                        (:headers state))
        response (bounded-post handle (:endpoint state) headers body-text)
        session-id (header-value (:headers response) "mcp-session-id")]
    (when (str/blank? (str session-id))
      (fail! :mcp-protocol-error {:reason :legacy-handshake-without-session-id}))
    (swap! handle assoc :mode :legacy :session-id session-id)
    (post-notification handle "notifications/initialized" {})
    session-id))

(defn session-request!
  "POST one JSON-RPC method and return {:result :mode}. Modern-first with
   automatic legacy fallback: when the endpoint answers 400 with an empty
   or unrecognized body, the handle handshakes once and retries with the
   legacy session id. Modern JSON-RPC errors never trigger the fallback."
  [handle method params]
  (if (= :stdio (:mode @handle))
    (assoc (stdio-request! handle method params) :mode :stdio)
    (try
      (assoc (post-request handle method params) :mode (:mode @handle))
    (catch Object error
      (when-not (= :mcp-legacy-fallback-required (:category (ex-data error)))
        (throw error))
      (when (= :legacy (:mode @handle))
        (fail! :mcp-transport-error {:url (:endpoint @handle)
                                    :reason :legacy-retry-rejected}))
      (do-handshake! handle)
      (assoc (post-request handle method params) :mode (:mode @handle))))))

(defn close-session!
  "Best-effort teardown. Legacy handles issue DELETE with the session
   id; stdio handles terminate the owned child (exact PID) and fail any
   in-flight calls; modern handles hold no server state, so closing is a
   local no-op. Teardown failures are swallowed: server-side expiry is
   the backstop."
  [handle]
  (let [state (when (some? handle) @handle)]
    (cond (= :stdio (:mode state))
          (do (fail-stdio-pending! handle :closing)
              (try ((:close (:link state)))
                   (catch Object _ {:closed? false})))

          (and (= :legacy (:mode state)) (not (str/blank? (str (:session-id state)))))
          (try
            (let [transport (or (:transport state) http/request)]
              ;; Cleanup gets its own budget; an already-aborted request must
              ;; not skip the DELETE or make teardown unbounded.
              (capacity/call!
                #(transport {:method :delete :url (:endpoint state)
                             :headers (assoc (:headers state) "mcp-session-id" (:session-id state))
                             :body ""})
                {:timeout_ms (min 60000 (or (:timeout-ms state) default-timeout-ms))}))
            (catch Object _ nil))))
)

