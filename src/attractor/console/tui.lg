(ns attractor.console.tui
  "Full-screen tiny-tui frontend over attractor.console.session. The stock
   tiny-tui loop only wakes on keys and consumes Ctrl-C as exit, so this
   adapter feeds run's :read-key-fn from a channel that merges keystrokes with
   periodic hub-event ticks, and translates Ctrl-C into a console interrupt
   that the dispatcher routes by state (discard draft, cancel focus, or quit
   when idle)."
  (:require [attractor.ids :as ids] [clojure.string :as str] [clojure.core :as core] [async :as async]
            [term :as term] [tiny-tui.screen :as screen]
            [tiny-tui.core :as tui] [tiny-tui.input :as tinput]
            [tiny-tui.layout :as layout] [tiny-tui.style :as style] [tiny-tui.key :as key]
            [attractor.console.session :as session]))

(def ^:private max-transcript 2000)

(defn- append-lines [state lines]
  (let [all (into (:transcript state) lines)
        excess (- (count all) max-transcript)]
    (assoc state :pending (into (:pending state) lines) :transcript (if (pos? excess) (subvec all excess) all))))

(defn- status-line [state]
  (let [{:keys [kind id]} (session/focus (:console state))
        parts (remove nil? [(when kind (str ({:session "session" :run "run" :agent "agent"} kind) " "
                                            (ids/short id)))
                            (when (:buffering state) "multiline eval draft")])]
    (style/bold (str "attractor console" (when (seq parts) (str " — " (str/join " · " parts)))
                     "  (Ctrl-C: discard/cancel/quit)"))))

(defn- safe-text [text]
  (str/replace (style/strip (str text)) #"[\x00-\x1f\x7f-\x9f]" " "))

(defn- character-cells [c] (if (< (int c) 128) 1 2))

(defn- clip [text width]
  (loop [chars (seq (safe-text text)) out "" left (max 0 width)]
    (if-let [c (first chars)]
      (let [cells (character-cells c)]
        (if (<= cells left) (recur (rest chars) (str out c) (- left cells)) out))
      out)))

(defn- editor-view [state width]
  ;; Window the model, not the ANSI-rendered widget, retaining its real caret.
  (let [input (:input state) text (safe-text (:text input))
        prompt (if (> width 2) "> " "")
        space (max 1 (- width (count prompt)))
        cursor (max 0 (min (count text) (:cursor input)))
        chars (vec (seq text))
        caret-cells (if (< cursor (count chars)) (character-cells (get chars cursor)) 1)
        [start used] (loop [start cursor used 0]
                       (let [cells (when (pos? start) (character-cells (get chars (dec start))))]
                         (if (and cells (<= (+ used cells) (- space (min space caret-cells))))
                           (recur (dec start) (+ used cells))
                           [start used])))
        visible (str (subs text start cursor) (clip (subs text cursor) (- space used)))]
    (str prompt (tinput/view (assoc input :text visible :cursor (- cursor start)
                               :placeholder (clip (:placeholder input) (dec space)))))))

(defn view [state]
  (let [[w height] (or (:tui/size state) [80 24]) width (max 1 (dec w))
        rows (max 0 (- height 3)) transcript (:transcript state)
        visible (if (> (count transcript) rows) (subvec transcript (- (count transcript) rows)) transcript)
        activity (clip (session/activity-text (:console state)) width)
        editor (editor-view state width)]
    (if (:inline? state)
      (if (< height 2) editor (layout/vstack activity editor))
      (str/join "\n" (take-last (max 1 height)
                       (concat [(clip (style/strip (status-line state)) width)]
                               (map #(clip % width) visible)
                               [activity editor]))))))

(defn- submit! [state text]
  (let [{:keys [lines buffering]} (session/handle! (:console state) {:type :line :text text})]
    (-> state
        (append-lines (cons (str (if (:buffering state) "…  " "> ") text) lines))
        (assoc :buffering buffering
               :input (tinput/create {:placeholder (if buffering ":} submits the draft" "message, : form, /help")})))))

(defn- interrupt! [state]
  (cond
    (or (:buffering state) (not (empty? (get-in state [:input :text]))))
    (do (when (:buffering state)
          (session/handle! (:console state) {:type :interrupt}))
        (-> state (append-lines ["(draft discarded)"]) (assoc :buffering false :input (tinput/create {:placeholder "message, : form, /help"}))))
    (session/busy? (:console state))
    (append-lines state (:lines (session/handle! (:console state) {:type :interrupt})))
    ;; Nothing to discard or cancel: Ctrl-C when idle quits.
    :else (do (session/close! (:console state)) (append-lines state ["bye"]))))

(defn update [state msg]
  (let [state (cond
                (= msg ::tick) (append-lines state (:lines (session/drain! (:console state))))
                (= msg ::interrupt) (interrupt! state)
                (= msg :ctrl-d) (if (empty? (get-in state [:input :text]))
                                           (do (session/close! (:console state)) state)
                                           (assoc state :input (first (tinput/update (:input state) :delete))))
                (= msg :enter) (let [text (get-in state [:input :text])]
                                 (if (str/blank? text) state (submit! state text)))
                :else (assoc state :input (first (tinput/update (:input state) msg))))]
    (when (and (:inline? state) (seq (:pending state)))
      ((:flush-lines state) (:pending state)))
    [(assoc state :pending []) (when (session/closed? (:console state)) :quit)]))

(defn- merged-key-reader
  "Return a read-key-fn: a keystroke from the reader future when one is
   pending, otherwise a ::tick after poll-ms so hub events keep flowing."
  [read-key poll-ms]
  (let [keys (async/chan)]
    (core/future
      (loop []
        (let [k (read-key)]
          (async/>!! keys (if (nil? k) ::eof k))
          (when-not (nil? k) (recur)))))
    (fn []
      (let [[value _] (async/alts! [keys (async/timeout poll-ms)])]
        (cond
          (nil? value) ::tick
          (= value ::eof) nil
          (= value :ctrl-c) ::interrupt
          :else value)))))

(defn run!
  "Run the full-screen console until it quits. Options: :read-key (defaults to
   tiny-tui.key/read), :render-fn and :screen (tiny-tui testing hooks),
   :poll-ms (default 50)."
  [console & [opts]]
  (swap! console assoc :presentation true)
  (let [help (:lines (session/handle! console {:type :line :text "/help"}))
        flush-lines (or (:flush-lines opts)
                        (fn [lines]
                          (screen/erase-widget!)
                          (doseq [line lines] (term/write (str (safe-text line) "\r\n")))
                          (term/flush)))
        init {:console console :transcript (vec help) :buffering false
              :inline? (:inline? opts) :flush-lines flush-lines :pending []
              :input (tinput/create {:placeholder "message, : form, /help"})}
        read-key-fn (merged-key-reader (or (:read-key opts) key/read) (get opts :poll-ms 50))
        _ (when (:inline? opts) (doseq [line help] (println line)))
        [final event] (tui/run (cond-> {:init init :update update :view view :read-key-fn read-key-fn :inline? (:inline? opts)}
                                 (contains? opts :screen) (assoc :screen (:screen opts))
                                 (:render-fn opts) (assoc :render-fn (:render-fn opts))))]
    (when-not (session/closed? console) (session/close! console))
    (let [late (:lines (session/drain! console))]
      (when (:inline? opts) (doseq [line late] (println (safe-text line))))
      {:transcript (into (:transcript final) late) :event event})))
