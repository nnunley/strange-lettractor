(ns attractor.console.session
  "Frontend-independent console dispatcher. It owns a hub client attachment,
   the focus (selected session/run/worker), the input reducer state and the
   rendering of hub event envelopes into lines. Line and TUI frontends feed
   it input events and print what it returns; they never touch the hub."
  (:require [clojure.string :as str] [clojure.core :as core] [io :as io] [os :as os]
            [attractor.hub :as hub] [attractor.console.input :as input]))

(defn- fail! [message] (throw (ex-info message {:category :console})))
(defn- short-id [id] (if (string? id) (last (str/split id #"-")) (str id)))
(defn- request! [console op fields]
  (let [reply (deref (hub/request! (:hub console) (merge {:id (str (random-uuid)) :op op} fields))
                     (:request_timeout_ms console) {:error {:category :request-timeout}})]
    (if-let [error (:error reply)]
      (fail! (str (name op) " failed: " (name (or (:category error) :error))
                  (when (:message error) (str " " (:message error)))))
      (:value reply))))

(defn open!
  "Attach to a running hub. Options: :request_timeout_ms, :worker_defaults
   (cwd/model/tools/permission_mode/timeout_ms for /claude), :run_defaults
   (:logs_root_fn, :auto_approve)."
  [hub & [opts]]
  (let [console {:hub hub :request_timeout_ms (get opts :request_timeout_ms 5000)
                 :worker_defaults (or (:worker_defaults opts) {})
                 :run_defaults (or (:run_defaults opts) {})}
        client (request! console :client/attach {})]
    (atom (assoc console :client client :cursor (:cursor client)
                 ;; One focus at a time: {:kind :session|:run|:worker :id ...}.
                 ;; :session remembers the agent session for unprefixed text
                 ;; while a run or worker is focused.
                 :focus nil :session nil :input {} :quit false :text_buffers {}
                 :final_lines []))))

(defn closed? [console] (:quit @console))
(defn focus
  "The single focused object, {:kind :id}, or nil."
  [console] (:focus @console))
(defn selection
  "Selection captured at submission: the agent session plus whichever run or
   worker is focused."
  [console]
  (let [c @console f (:focus c)]
    {:session_id (:session c)
     :run_id (when (= :run (:kind f)) (:id f))
     :worker_id (when (= :worker (:kind f)) (:id f))}))
(declare drain!)

(defn close!
  "Detach this client. Hub-owned sessions, runs and workers keep running.
   Events published up to the detach are drained first and delivered by the
   next drain! so nothing rendered late is lost."
  [console]
  (let [c @console]
    (when-not (:detached c)
      (let [late (try (:lines (drain! console)) (catch Object _ []))]
        (try (request! c :client/detach {:client_id (get-in c [:client :client_id])}) (catch Object _ nil))
        (swap! console assoc :detached true :quit true :final_lines late)))))

;; --- rendering --------------------------------------------------------------

(def ^:private max-buffered-text 65536)
(defn- buffer-text! [console key text]
  ;; Bound per-key accumulation; a runaway response is truncated, not hoarded.
  (swap! console update-in [:text_buffers key]
         (fn [buffered] (let [joined (str (or buffered "") text)]
                          (if (> (count joined) max-buffered-text) (subs joined 0 max-buffered-text) joined)))))
(defn- take-buffer! [console key]
  (let [buffered (get-in @console [:text_buffers key])]
    (swap! console update :text_buffers dissoc key)
    buffered))
(defn- text-lines [tag text]
  (if (str/blank? text) [] (mapv #(str tag " " %) (str/split text #"\n"))))

(defn- agent-lines [console envelope]
  (let [tag (str "[agent " (short-id (:session_id envelope)) "]") event (:event envelope)
        sid (:session_id envelope)]
    (case (:type event)
      :session_start [(str tag " session started")]
      :assistant_text_delta (do (buffer-text! console sid (:delta event)) [])
      :assistant_text_end (let [buffered (take-buffer! console sid)]
                            (text-lines tag (or (:text event) buffered)))
      :tool_call_start [(str tag " tool " (:tool_name event) " …")]
      :tool_call_end [(str tag " tool " (short-id (:call_id event)) (if (:error event) " failed" " done"))]
      :error (do (take-buffer! console sid) [(str tag " error: " (:error event))])
      :processing_end (into (text-lines tag (take-buffer! console sid)) [(str tag " turn complete")])
      :session_end (do (take-buffer! console sid) [(str tag " session ended")])
      :warning [(str tag " warning: " (or (:message event) (pr-str event)))]
      [])))

(defn- eval-lines [envelope]
  (let [event (:event envelope)]
    (case (:type event)
      :eval_result
      (if (= :error (:status event))
        [(str "[eval] error: " (get-in event [:error :message]))]
        (vec (concat (when-not (str/blank? (:printed event)) (str/split (:printed event) #"\n"))
                     [(str "[eval] => " (pr-str (:value event)))])))
      [])))

(defn- workflow-lines [envelope]
  (let [tag (str "[run " (short-id (:run_id envelope)) "]") ev (:event envelope)]
    (case (:type ev)
      :pipeline.started [(str tag " started: " (:goal ev))]
      :stage.started [(str tag " stage " (:node_id ev) " started (attempt " (:attempt ev) ")")]
      :stage.completed [(str tag " stage " (:node_id ev) " -> " (name (or (:status ev) :unknown)))]
      :stage.failed [(str tag " stage " (:node_id ev) " failed")]
      :stage.retrying [(str tag " retrying " (:node_id ev) " after " (:delay_ms ev) "ms")]
      :pipeline.completed [(str tag " completed in " (:duration_steps ev) " steps")]
      :pipeline.failed [(str tag " failed: " (:error ev))]
      [])))

(defn- worker-lines [console envelope]
  (let [wid (:worker_id envelope) tag (str "[claude " (short-id wid) "]") ev (:event envelope)]
    (case (:type ev)
      :text_delta (do (buffer-text! console wid (:text ev)) [])
      :completed (into (text-lines tag (take-buffer! console wid)) [(str tag " completed")])
      :error (into (text-lines tag (take-buffer! console wid)) [(str tag " failed: " (get-in ev [:error :message]))])
      :protocol (let [type (get-in ev [:event "type"])]
                  (if (= "assistant" type)
                    (let [tools (keep #(get % "name") (get-in ev [:event "message" "content"]))]
                      (if (seq tools) [(str tag " tool " (str/join ", " tools))] []))
                    []))
      [])))

(defn render-envelope [console envelope]
  (case (:source envelope)
    :agent (agent-lines console envelope)
    :eval (eval-lines envelope)
    :workflow (workflow-lines envelope)
    :worker (worker-lines console envelope)
    []))

(defn drain!
  "Render every hub event published since the last drain."
  [console]
  (let [c @console]
    (if (:detached c)
      (let [late (:final_lines c)]
        (swap! console assoc :final_lines [])
        {:lines (vec late)})
      (try
        (let [{:keys [events cursor]} (hub/events-since (:hub c) (get-in c [:client :client_id]) (:cursor c))]
          (swap! console assoc :cursor cursor)
          {:lines (vec (mapcat #(render-envelope console %) events))})
        (catch Object e
          (if (= :cursor-expired (:category (ex-data e)))
            ;; Fell behind the bounded log: resync to its newest cursor and say so.
            (let [{:keys [cursor events]} (hub/events-since (:hub c) (get-in c [:client :client_id])
                                                            (dec (:seq (first (:events @(:log (:hub c)))))))]
              (swap! console assoc :cursor cursor)
              {:lines (into ["… older events dropped (client fell behind the hub log)"]
                            (mapcat #(render-envelope console %) events))})
            {:lines [(str "error: " (ex-message e))]}))))))

;; --- commands ---------------------------------------------------------------

(def help-lines
  ["Console input:"
   "  text            message the focused agent session"
   "  : form          evaluate let-go in the hub console namespace"
   "  :{ / :}         begin / submit a multiline evaluation"
   "  \\text           literal agent text"
   "  /help /agents /new /focus <id> /run <file.dot> --auto-approve"
   "  /claude <prompt> [--cwd d] [--model m] [--tools a,b] [--permission-mode p]"
   "  /cancel         cancel the focused turn, run or worker"
   "  /quit           detach this client (an in-process hub stops with the command)"])

(defn- focus! [console kind id]
  (swap! console (fn [c] (cond-> (assoc c :focus {:kind kind :id id})
                           (= kind :session) (assoc :session id)))))

(defn- ensure-session! [console]
  (or (:session @console)
      (let [{:keys [session_id]} (request! @console :session/open {})]
        (focus! console :session session_id)
        session_id)))

(def ^:private boolean-flags #{:auto-approve})
(defn- parse-flags
  "Words plus --flag values. Boolean flags never consume a value, and no flag
   consumes a following token that is itself a flag; a value-less flag is
   reported under :missing so callers can reject it."
  [args]
  (loop [tokens (remove str/blank? (str/split (str/trim args) #"\s+")) words [] flags {} missing []]
    (if (empty? tokens)
      {:words words :flags flags :missing missing}
      (let [t (first tokens) value (second tokens)]
        (cond
          (not (str/starts-with? t "--")) (recur (rest tokens) (conj words t) flags missing)
          (contains? boolean-flags (keyword (subs t 2))) (recur (rest tokens) words (assoc flags (keyword (subs t 2)) true) missing)
          (and value (not (str/starts-with? value "--"))) (recur (drop 2 tokens) words (assoc flags (keyword (subs t 2)) value) missing)
          :else (recur (rest tokens) words flags (conj missing t)))))))

(defn- agents-lines [console]
  (let [c @console
        sessions (request! c :session/list {}) runs (request! c :workflow/list {}) workers (request! c :worker/list {})
        f (:focus c) mark (fn [kind id] (if (= f {:kind kind :id id}) "* " "  "))]
    (vec (concat
           (map #(str (mark :session (:session_id %)) "session " (short-id (:session_id %))
                      (when (:busy %) " busy") (when (:closed %) " closed")) sessions)
           (map #(str (mark :run (:run_id %)) "run " (short-id (:run_id %)) " " (:source_path %)
                      (cond (:cancelled %) " cancelled" (:done %) " done" :else " running")) runs)
           (map #(str (mark :worker (:worker_id %)) "claude " (short-id (:worker_id %))
                      (cond (:cancelled %) " cancelled" (:done %) " done" :else " running")) workers)
           (when (and (empty? sessions) (empty? runs) (empty? workers)) ["nothing running"])))))

(defn- focus-by-id! [console id]
  (let [c @console
        match (fn [key items] (filter #(or (= id (get % key)) (= id (short-id (get % key)))) items))
        sessions (match :session_id (request! c :session/list {}))
        runs (match :run_id (request! c :workflow/list {}))
        workers (match :worker_id (request! c :worker/list {}))
        candidates (concat (map (fn [x] [:session (:session_id x)]) sessions)
                           (map (fn [x] [:run (:run_id x)]) runs)
                           (map (fn [x] [:worker (:worker_id x)]) workers))
        label {:session "session" :run "run" :worker "claude"}]
    (cond
      (empty? candidates) [(str "no session, run or worker matches " id)]
      (next candidates) [(str "ambiguous: " (str/join ", " (map (fn [[k v]] (str (label k) " " (short-id v))) candidates)))]
      :else (let [[kind full] (first candidates)]
              (focus! console kind full)
              [(str "focus: " (label kind) " " (short-id full))]))))

(defn- run! [console args]
  (let [{:keys [words flags missing]} (parse-flags args) path (first words) c @console
        defaults (:run_defaults c)
        auto-approve? (boolean (or (:auto-approve flags) (:auto_approve defaults)))]
    (cond
      (seq missing) [(str "flag needs a value: " (str/join ", " missing))]
      (str/blank? path) ["usage: /run <file.dot> --auto-approve [--logs-root dir]"]
      (not (os/stat path)) [(str "no such file: " path)]
      ;; Human gates would read the terminal out from under this frontend;
      ;; until questions arrive as hub events, the console only runs
      ;; auto-approved workflows.
      (not auto-approve?) ["this console cannot answer human gates yet: add --auto-approve"]
      :else
      (let [logs-root (or (:logs-root flags) (when-let [f (:logs_root_fn defaults)] (f path))
                          (str "attractor_runs/run_" (System/currentTimeMillis)))
            {:keys [run_id]} (request! c :workflow/run {:dot_source (io/slurp path) :source_path path
                                                        :logs_root logs-root :auto_approve true})]
        (focus! console :run run_id)
        [(str "run " (short-id run_id) " started from " path " (logs: " logs-root ")")]))))

(defn- claude! [console args]
  (let [{:keys [words flags missing]} (parse-flags args) prompt (str/join " " words) c @console d (:worker_defaults c)]
    (cond
      (seq missing) [(str "flag needs a value: " (str/join ", " missing))]
      (str/blank? prompt) ["usage: /claude <prompt> [--cwd d] [--model m] [--tools a,b] [--permission-mode p]"]
      :else
      (let [fields (cond-> {:kind :claude :prompt prompt}
                     (or (:cwd flags) (:working_dir d)) (assoc :working_dir (or (:cwd flags) (:working_dir d)))
                     (or (:model flags) (:model d)) (assoc :model (or (:model flags) (:model d)))
                     (or (:tools flags) (:tools d)) (assoc :tools (if-let [t (:tools flags)] (str/split t #",") (:tools d)))
                     (or (:permission-mode flags) (:permission_mode d))
                     (assoc :permission_mode (or (:permission-mode flags) (:permission_mode d)))
                     (:timeout_ms d) (assoc :timeout_ms (:timeout_ms d))
                     (:scenario flags) (assoc :scenario (:scenario flags)))
            {:keys [worker_id]} (request! c :worker/run fields)]
        (focus! console :worker worker_id)
        [(str "claude " (short-id worker_id) " started")]))))

(defn- cancel! [console]
  (let [c @console {:keys [kind id]} (:focus c)]
    (case kind
      :worker (do (request! c :worker/cancel {:worker_id id}) [(str "cancel requested: claude " (short-id id))])
      :run (do (request! c :workflow/cancel {:run_id id}) [(str "cancel requested: run " (short-id id))])
      :session (do (request! c :session/cancel {:session_id id}) [(str "cancel requested: session " (short-id id))])
      ["nothing focused to cancel"])))

(defn busy?
  "True when the focused session has an unfinished turn or the focused run or
   worker is still running. Frontends use it to route an interrupt; a hub that
   cannot answer counts as not busy so an idle interrupt can still quit."
  [console]
  (try
    (let [c @console {:keys [kind id]} (:focus c)
          find (fn [key op] (first (filter #(= id (get % key)) (request! c op {}))))]
      (boolean
        (case kind
          :session (:busy (find :session_id :session/list))
          :run (when-let [run (find :run_id :workflow/list)] (not (:done run)))
          :worker (when-let [worker (find :worker_id :worker/list)] (not (:done worker)))
          false)))
    (catch Object _ false)))

(defn- command! [console command args]
  (case command
    :help help-lines
    :agents (agents-lines console)
    :new (let [{:keys [session_id]} (request! @console :session/open {})]
           (focus! console :session session_id)
           [(str "focus: session " (short-id session_id))])
    :focus (if (str/blank? args)
             [(if-let [{:keys [kind id]} (:focus @console)] (str "focus: " (name kind) " " (short-id id)) "focus: none")]
             (focus-by-id! console (str/trim args)))
    :run (run! console args)
    :claude (claude! console args)
    :cancel (cancel! console)
    :quit (do (close! console) ["bye"])
    [(str "unknown command /" (name command))]))

(defn- dispatch! [console action]
  (case (:type action)
    :agent (let [sid (ensure-session! console)
                 {:keys [turn_id]} (request! @console :session/submit {:session_id sid :text (:text action)})]
             [(str "→ agent " (short-id sid) " turn " (short-id turn_id))])
    :eval (let [f (:selection action)
                {:keys [eval_id]} (request! @console :eval/submit {:code (:text action) :session_id (:session_id f) :run_id (:run_id f)})]
            [(str "→ eval " (short-id eval_id))])
    :command (command! console (:command action) (:args action))
    :cancel (cancel! console)
    :quit (do (close! console) ["bye"])
    :error [(str "input error: " (:message action))]
    [(str "unhandled action " (pr-str action))]))

(defn handle!
  "Feed one input event ({:type :line :text s} | {:type :interrupt} | {:type :eof}).
   Returns {:lines [...]} to render. Selection is captured at submission."
  [console event]
  (let [c @console
        {:keys [state action]} (input/accept (:input c) event (selection console))]
    (swap! console assoc :input state)
    {:lines (cond
              action (try (dispatch! console action)
                          (catch Object e [(str "error: " (ex-message e))]))
              (contains? state :buffer) []
              :else [])
     :buffering (contains? state :buffer)}))
