(ns attractor.console.session
  "Frontend-independent console dispatcher. It owns a hub client attachment,
   the focus (selected session/run/agent job), the input reducer state and the
   rendering of hub event envelopes into lines. Line and TUI frontends feed
   it input events and print what it returns; they never touch the hub."
  (:require [attractor.ids :as ids] [clojure.string :as str] [clojure.core :as core] [io :as io] [os :as os]
            [attractor.hub :as hub] [attractor.console.input :as input]
            [attractor.agents.registry :as registry]))

(defn- fail! [message] (throw (ex-info message {:category :console})))
(defn- short-id [id] (ids/short id))
(defn- request! [console op fields]
  (let [reply ((:request_fn console) (merge {:id (ids/uuid-text) :op op} fields))]
    (if-let [error (:error reply)]
      ;; hub/fail! throws with the category as its ex-message, so printing both
      ;; repeats the same word: "submit failed: busy busy".
      (let [category (name (or (:category error) :error)) message (:message error)]
        (fail! (str (name op) " failed: " category
                    (when (and message (not= message category)) (str " " message)))))
      (:value reply))))

(defn open!
  "Attach to a running hub. Options: :request_timeout_ms, :agent_defaults
   (cwd/model/tools/permission_mode/sandbox/approval_policy/timeout_ms for
   /agent), :run_defaults (:logs_root_fn, :auto_approve), :aliases
   ({\"claude\" \"agent claude\"}: explicit slash shortcuts, none by default).
   :request_fn takes a request and returns its envelope; :events_fn takes client
   ID and cursor. Supply both to attach without an in-process hub."
  [hub & [opts]]
  (let [timeout (get opts :request_timeout_ms 5000)
        console {:hub hub :request_timeout_ms timeout
                 :request_fn (or (:request_fn opts)
                                 (fn [request] (deref (hub/request! hub request) timeout
                                                      {:error {:category :request-timeout}})))
                 :events_fn (or (:events_fn opts) (fn [client cursor] (hub/events-since hub client cursor)))
                 :agent_defaults (or (:agent_defaults opts) {})
                 :run_defaults (or (:run_defaults opts) {})
                 :aliases (or (:aliases opts) {})}
        client (request! console :client/attach {})]
    (atom (assoc console :client client :cursor (:cursor client)
                 ;; One focus at a time: {:kind :session|:run|:agent :id ...}.
                 ;; :session remembers the agent session for unprefixed text
                 ;; while a run or agent job is focused.
                 :focus nil :session nil :input {} :quit false :text_buffers {}
                 :final_lines []))))

(defn closed? [console] (:quit @console))
(defn focus
  "The single focused object, {:kind :id}, or nil."
  [console] (:focus @console))
(defn selection
  "Selection captured at submission: the native session plus whichever run or
   agent job is focused."
  [console]
  (let [c @console f (:focus c)]
    {:session_id (:session c)
     :run_id (when (= :run (:kind f)) (:id f))
     :agent_id (when (= :agent (:kind f)) (:id f))}))
(declare drain! history-lines)

(defn close!
  "Detach this client. Hub-owned sessions, runs and agent jobs keep running.
   Events published up to the detach are drained first and delivered by the
   next drain! so nothing rendered late is lost."
  [console]
  (let [c @console]
    (when-not (:detached c)
      (let [late (try (:lines (drain! console)) (catch Object _ []))]
        (try (request! c :client/detach {:client_id (get-in c [:client :client_id])}) (catch Object _ nil))
        (swap! console assoc :detached true :quit true :activity nil :final_lines late)))))

;; --- rendering --------------------------------------------------------------

(def ^:private max-buffered-text 65536)
(defn- buffer-text! [console key text]
  ;; Bound per-key accumulation; a runaway response is truncated, not hoarded.
  (swap! console update-in [:text_buffers key]
         (fn [buffered] (let [joined (str (or buffered "") text)]
                          (if (> (count joined) max-buffered-text) (subs joined 0 max-buffered-text) joined)))))
(defn- take-buffer! [console key]
  (let [buffered (get-in @console [:text_buffers key])]
    (swap! console update :text_buffers dissoc key)
    buffered))
;; A tag identifies which session/run/job a line came from. The focused session
;; gets an empty one: in a single-session REPL every line would carry the same
;; prefix, which is noise, not attribution. `tagged` is what keeps an empty tag
;; from leaving a leading space.
(defn- tagged [tag text] (if (str/blank? tag) text (str tag " " text)))

(defn- text-lines [tag text]
  (if (str/blank? text) [] (mapv #(tagged tag %) (str/split text #"\n"))))

(defn- session-lines [console envelope]
  (let [sid (:session_id envelope)
        tag (if (= sid (:session @console)) "" (str "[session " (short-id sid) "]"))
        event (:event envelope)]
    (case (:type event)
      :session_start [(tagged tag "session started")]
      :subagent_event (let [child (:event event)]
                        (when (or (= :error (:type child))
                                  (and (= :tool_call_end (:type child)) (:error child)))
                          [(str "[agent " (short-id (:agent_id event)) "] "
                                (if (= :tool_call_end (:type child)) (str "tool " (:tool_name child) " failed: ") "error: ")
                                (:error child))]))
      :assistant_text_delta (do (buffer-text! console sid (:delta event)) [])
      :assistant_text_end (let [buffered (take-buffer! console sid)]
                            (text-lines tag (or (:text event) buffered)))
      :tool_call_start (if (:presentation @console) [] [(tagged tag (str "tool " (:tool_name event) " …"))])
      ;; Name, not call id: the id is only useful for correlating with a
      ;; transcript, and the start line already showed the name.
      :tool_call_end (if (and (:presentation @console) (not (:error event))) [] [(tagged tag (str "tool " (or (:tool_name event) (short-id (:call_id event)))
                                       (if (:error event) " failed" " done")))])
      :error (do (take-buffer! console sid) [(tagged tag (str "error: " (:error event)))])
      :processing_end (into (text-lines tag (take-buffer! console sid)) [(tagged tag "turn complete")])
      :session_end (do (take-buffer! console sid) [(tagged tag "session ended")])
      :compaction_start [(tagged tag "Preparing context checkpoint")]
      :compaction_end [(tagged tag "Context checkpoint applied; full history retained")]
      :compaction_failed [(tagged tag "Context checkpoint failed; original context retained")]
      :repair_status [(tagged tag (str "Repair " (:repair_id event) ": " (name (:status event))
                                         (when (:summary event) (str " — " (:summary event)))))]
      :refine_complete [(tagged tag (str "Harness refinement complete: " (get-in event [:result :summary])))]
      :refine_error [(tagged tag (str "Harness refinement failed: " (:error event)))]
      :warning [(tagged tag (str "warning: " (or (:message event) (pr-str event))))]
      [])))

(defn- eval-lines [envelope]
  (let [event (:event envelope)]
    (case (:type event)
      :eval_result
      (if (= :error (:status event))
        [(str "[eval] error: " (get-in event [:error :message]))]
        (vec (concat (when-not (str/blank? (:printed event)) (str/split (:printed event) #"\n"))
                     [(str "[eval] => " (if (contains? event :value_repr) (:value_repr event) (pr-str (:value event))))])))
      [])))

(defn- workflow-lines [envelope]
  (let [tag (str "[run " (short-id (:run_id envelope)) "]") ev (:event envelope)]
    (case (:type ev)
      :pipeline.started [(str tag " started: " (:goal ev))]
      :stage.started [(str tag " stage " (:node_id ev) " started (attempt " (:attempt ev) ")")]
      :stage.completed [(str tag " stage " (:node_id ev) " -> " (name (or (:status ev) :unknown)))]
      :stage.failed [(str tag " stage " (:node_id ev) " failed")]
      :stage.retrying [(str tag " retrying " (:node_id ev) " after " (:delay_ms ev) "ms")]
      :pipeline.completed [(str tag " completed in " (:duration_steps ev) " steps")]
      :pipeline.failed [(str tag " failed: " (:error ev))]
      :parallel.started [(str tag " parallel: " (:branch_count ev) " branches")]
      :parallel.branch_completed [(str tag " branch " (:branch ev) (if (:success ev) " ok" " failed") " (" (:duration_ms ev) "ms)")]
      :parallel.completed [(str tag " parallel done: " (:success_count ev) " ok, " (:failure_count ev) " failed")]
      :interview.timeout [(str tag " gate " (:stage ev) " timed out after " (:duration_ms ev) "ms")]
      [])))

(defn- agent-lines [console envelope]
  (let [wid (:agent_id envelope) tag (str "[" (name (or (:agent envelope) :agent)) " " (short-id wid) "]") ev (:event envelope)]
    (case (:type ev)
      :text_delta (do (buffer-text! console wid (:text ev)) [])
      :completed (into (text-lines tag (take-buffer! console wid)) [(str tag " completed")])
      :error (into (text-lines tag (take-buffer! console wid)) [(str tag " failed: " (get-in ev [:error :message]))])
      :protocol (let [type (get-in ev [:event "type"])]
                  (if (= "assistant" type)
                    (let [tools (keep #(get % "name") (get-in ev [:event "message" "content"]))]
                      (if (seq tools) [(str tag " tool " (str/join ", " tools))] []))
                    []))
      [])))

(defn- question-lines [envelope]
  (let [tag (str "[run " (short-id (:run_id envelope)) "]") ev (:event envelope)]
    (case (:type ev)
      :question (let [q (:question ev)]
                  (into [(str tag " ? " (:text q)
                              (when (:timeout_seconds q) (str " (" (:timeout_seconds q) "s)")))]
                        (concat (map #(str tag "   [" (:key %) "] " (:label %)) (:options q))
                                [(str tag "   answer with /answer <key or text>")])))
      :answered [(str tag " answered: " (let [a (:answer ev)] (if (keyword? (:value a)) (name (:value a)) (:value a))))]
      :inform [(str tag " " (:stage ev) ": " (:message ev))]
      [])))

(defn- activity-event [state event child]
  (let [state (or state {:active {} :done 0 :phase "Ready"})
        id [child (:call_id event)]
        active (:active state)
        retire-child (fn [] (assoc state :active (into {} (remove (fn [[key _]] (= child (first key))) active))))]
    (case (:type event)
      :subagent_event (activity-event state (:event event) (:agent_id event))
      :tool_call_start (if (and (:call_id event) (< (count active) 1024))
                         (assoc state :active (assoc active id (:tool_name event)) :phase "Working") state)
      :tool_call_end (if (contains? active id)
                       (assoc state :active (dissoc active id) :done (inc (:done state))) state)
      :assistant_text_delta (assoc state :phase "Responding")
      :repair_phase (assoc state :phase (str "Repair: " (name (:phase event))))
      :repair_status (assoc state :phase (str "Repair: " (name (:status event))))
      :compaction_start (assoc state :phase "Preparing context checkpoint")
      :compaction_end (assoc state :phase "Working")
      :compaction_failed (assoc state :phase "Checkpoint failed")
      :processing_end (if child (retire-child) (assoc state :active {} :phase "Ready"))
      :session_end (if child (retire-child) (assoc state :active {} :phase "Session ended"))
      :error (if child (retire-child) (assoc state :active {} :phase "Error"))
      :pipeline.started (assoc state :phase "Running workflow")
      :stage.started (assoc state :phase (str "Running " (:node_id event)))
      :pipeline.completed (assoc state :active {} :phase "Complete")
      :pipeline.failed (assoc state :active {} :phase "Failed")
      :completed (assoc state :active {} :phase "Complete")
      state)))

(defn activity-text
  "Current focused activity. Derived from event identities, never transcript text."
  [console]
  (let [{:keys [active done phase]} (:activity @console)
        names (set (vals active))
        label (cond
                (contains? names "wait") "Waiting for agents"
                (= names #{"read_file"}) "Reading files"
                (= names #{"glob"}) "Finding files"
                (= names #{"shell"}) "Running commands"
                (= names #{"spawn_agent"}) "Starting agents"
                (seq names) "Running tools"
                :else (or phase "Ready"))]
    (str label (when (or (seq active) (pos? (or done 0)))
                 (str " · " (count active) " active · " (or done 0) " done")))))

(defn- selected-thread-event
  "Project a root envelope onto the selected thread's subtree. Sibling events
   never reach activity accounting or notices for a child selection."
  [id envelope]
  (when (= :session (:source envelope))
    (if (= id (:session_id envelope)) (:event envelope)
      (loop [event (:event envelope)]
        (when (= :subagent_event (:type event))
          (if (= id (:agent_id event)) (:event event)
            (recur (:event event))))))))

(defn- track-activity! [console envelope]
  (let [{:keys [kind id]} (:focus @console)
        event (if (= kind :thread) (selected-thread-event id envelope)
                (when (case kind
                        :session (= id (:session_id envelope))
                        :run (= id (:run_id envelope))
                        :agent (= id (:agent_id envelope)) false)
                  (:event envelope)))]
    (when event (swap! console update :activity activity-event event nil))))

(defn- thread-notices [id event]
  (if (= :subagent_event (:type event))
    (thread-notices (:agent_id event) (:event event))
    (let [tag (str "[thread " (short-id id) "] ")]
      (case (:type event)
        :error [(str tag "error: " (:error event))]
        :warning [(str tag "warning: " (or (:message event) (pr-str event)))]
        :repair_status [(str tag "Repair " (:repair_id event) ": " (name (:status event))
                             (when (:summary event) (str " — " (:summary event))))]
        :refine_error [(str tag "Harness refinement failed: " (:error event))]
        :compaction_failed [(str tag "Context checkpoint failed; original context retained")]
        []))))

(defn render-envelope [console envelope]
  (track-activity! console envelope)
  (if (and (= :thread (get-in @console [:focus :kind])) (= :session (:source envelope)))
    (let [id (get-in @console [:focus :id])]
      (if-let [event (selected-thread-event id envelope)] (thread-notices id event) []))
    (case (:source envelope)
      :session (session-lines console envelope)
      :question (question-lines envelope)
      :eval (eval-lines envelope)
      :workflow (workflow-lines envelope)
      :agent (agent-lines console envelope)
      [])))

(defn- thread-updates! [console]
  (when (= :thread (get-in @console [:focus :kind]))
    (let [id (get-in @console [:focus :id]) t (request! @console :thread/read {:thread_id id})
          seen (get-in @console [:thread_seen id] 0) history (vec (:history t))
          start (if (> seen (count history)) 0 seen)]
      (swap! console assoc-in [:thread_seen id] (count history))
      (rest (history-lines (assoc t :history (subvec history start) :pending []))))))

(defn drain!
  "Render every hub event published since the last drain."
  [console]
  (let [c @console]
    (if (:detached c)
      (let [late (:final_lines c)]
        (swap! console assoc :final_lines [])
        {:lines (vec late)})
      (try
        (let [{:keys [events cursor]} ((:events_fn c) (get-in c [:client :client_id]) (:cursor c))]
          (swap! console assoc :cursor cursor)
          {:lines (if (= :thread (get-in @console [:focus :kind]))
                    (into (vec (mapcat #(render-envelope console %) events)) (thread-updates! console))
                    (vec (mapcat #(render-envelope console %) events)))})
        (catch Object e
          (if (= :cursor-expired (:category (ex-data e)))
            ;; Fell behind the bounded log: resync to its newest cursor and say so.
            (let [{:keys [cursor events]} ((:events_fn c) (get-in c [:client :client_id])
                                                       (:oldest_cursor (ex-data e)))]
              (swap! console assoc :cursor cursor :activity {:active {} :done 0 :phase "Activity unknown (events dropped)"})
              {:lines (into ["… older events dropped (client fell behind the hub log)"]
                            (if (= :thread (get-in @console [:focus :kind]))
                              (into (vec (mapcat #(render-envelope console %) events)) (thread-updates! console))
                              (mapcat #(render-envelope console %) events)))})
            {:lines [(str "error: " (ex-message e))]}))))))

;; --- commands ---------------------------------------------------------------

(def help-lines
  ["Console input:"
   "  text            message the native agent session"
   "  : form          evaluate let-go in the hub console namespace"
   "  :{ / :}         begin / submit a multiline evaluation"
   "  \\text           literal agent text"
   "  /threads /thread <id> /resume <id>   inspect or explicitly resume a conversation"
   "  /help /list /new /focus <id> /run <file.dot> [--auto-approve]"
   "  /answer <key or text>   answer the waiting human gate (focused run first)"
   "  /agent <name> <prompt> [--cwd d] [--model m] [--tools a,b] [--permission-mode p]"
   "                        [--sandbox s] [--approval-policy p]   names: see /agent"
   "  /alias <name> <expansion>   define /<name> as a shortcut, e.g. /alias codex agent codex"
   "  /followup text  queue input after the current response and tools"
   "  /repair [ID | cancel ID | activate ID]  inspect or activate framework repairs"
   "  /harness        show durable harness status and path"
   "  /context        show context estimate, capacity and checkpoint status"
   "  /compact        checkpoint before the next model request"
   "  /refine [text]  plan refinement in the background"
   "  /cancel         cancel the focused turn, run or agent job"
   "  /quit           detach this client (an in-process hub stops with the command)"])

(defn- focus! [console kind id]
  (swap! console (fn [c] (cond-> (assoc c :focus {:kind kind :id id} :activity nil)
                           (= kind :session) (assoc :session id)))))

(defn- ensure-session! [console]
  (or (:session @console)
      (let [{:keys [session_id]} (request! @console :session/open {})]
        (focus! console :session session_id)
        session_id)))

(defn- thread-record [console id]
  (let [matches (filter #(or (= id (:thread_id %)) (= id (short-id (:thread_id %))))
                        (request! @console :thread/list {}))]
    (when-not (= 1 (count matches)) (fail! (str "Expected one thread matching " id)))
    (request! @console :thread/read {:thread_id (:thread_id (first matches))})))

(defn history-lines [thread]
  (vec (concat
    [(str "thread " (:thread_id thread) " · " (or (:state thread) "unknown")
          (when (:archived thread) " (archive; /resume to continue)"))]
    (mapcat (fn [turn]
              (concat [(str (name (or (:role turn) (:type turn) :message)) ": " (:content turn))]
                      (map #(str "tool call " (:id %) " · " (:name %) " " (pr-str (:arguments %))) (:tool_calls turn))
                      (map #(str "tool result " (:tool_call_id %) " · " (or (:tool_name %) (:name %) "") " " (pr-str (:content %))) (:results turn))))
            (:history thread))
    (map #(str "pending: " (:text %)) (:pending thread)))))

(defn- submit-text! [console text behavior]
  (let [c @console f (:focus c)]
    (if (= :thread (:kind f))
      (request! c :thread/submit {:thread_id (:id f) :text text :behavior behavior})
      (request! @console :session/submit {:session_id (ensure-session! console) :text text :queue true :behavior behavior}))))

(def ^:private boolean-flags #{:auto-approve})
(def ^:private agent-flag-keys
  {:cwd :working_dir :model :model :tools :tools :permission-mode :permission_mode
   :sandbox :sandbox :approval-policy :approval_policy :timeout-ms :timeout_ms})
(defn- parse-flags
  "Words plus --flag values. Boolean flags never consume a value, and no flag
   consumes a following token that is itself a flag; a value-less flag is
   reported under :missing so callers can reject it."
  [args]
  (loop [tokens (remove str/blank? (str/split (str/trim args) #"\s+")) words [] flags {} missing []]
    (if (empty? tokens)
      {:words words :flags flags :missing missing}
      (let [t (first tokens) value (second tokens)]
        (cond
          (not (str/starts-with? t "--")) (recur (rest tokens) (conj words t) flags missing)
          (contains? boolean-flags (keyword (subs t 2))) (recur (rest tokens) words (assoc flags (keyword (subs t 2)) true) missing)
          (and value (not (str/starts-with? value "--"))) (recur (drop 2 tokens) words (assoc flags (keyword (subs t 2)) value) missing)
          :else (recur (rest tokens) words flags (conj missing t)))))))

(defn- list-lines [console]
  (let [c @console
        sessions (request! c :session/list {}) runs (request! c :workflow/list {}) jobs (request! c :agent/list {})
        waiting (set (map :run_id (request! c :question/list {})))
        f (:focus c) mark (fn [kind id] (if (= f {:kind kind :id id}) "* " "  "))]
    (vec (concat
           (map #(str (mark :session (:session_id %)) "session " (short-id (:session_id %))
                      (when (:busy %) " busy") (when (:closed %) " closed")) sessions)
           (map #(str (mark :run (:run_id %)) "run " (short-id (:run_id %)) " " (:source_path %)
                      (cond (:cancelled %) " cancelled" (:done %) " done"
                            (contains? waiting (:run_id %)) " waiting for an answer" :else " running")) runs)
           (map #(str (mark :agent (:agent_id %)) (name (or (:agent %) :agent)) " " (short-id (:agent_id %))
                      (cond (:cancelled %) " cancelled" (:done %) " done" :else " running")) jobs)
           (when (and (empty? sessions) (empty? runs) (empty? jobs)) ["nothing running"])))))

(defn- focus-by-id! [console id]
  (let [c @console
        match (fn [key items] (filter #(or (= id (get % key)) (= id (short-id (get % key)))) items))
        sessions (match :session_id (request! c :session/list {}))
        runs (match :run_id (request! c :workflow/list {}))
        jobs (match :agent_id (request! c :agent/list {}))
        candidates (concat (map (fn [x] [:session (:session_id x) "session"]) sessions)
                           (map (fn [x] [:run (:run_id x) "run"]) runs)
                           (map (fn [x] [:agent (:agent_id x) (name (or (:agent x) :agent))]) jobs))]
    (cond
      (empty? candidates) [(str "no session, run or agent job matches " id)]
      (next candidates) [(str "ambiguous: " (str/join ", " (map (fn [[_ v label]] (str label " " (short-id v))) candidates)))]
      :else (let [[kind full label] (first candidates)]
              (focus! console kind full)
              [(str "focus: " label " " (short-id full))]))))

(defn- run! [console args]
  (let [{:keys [words flags missing]} (parse-flags args) path (first words) c @console
        defaults (:run_defaults c)
        auto-approve? (boolean (or (:auto-approve flags) (:auto_approve defaults)))]
    (cond
      (seq missing) [(str "flag needs a value: " (str/join ", " missing))]
      (str/blank? path) ["usage: /run <file.dot> [--auto-approve] [--logs-root dir]"]
      (not (os/stat path)) [(str "no such file: " path)]
      :else
      ;; Human gates arrive as hub question events and are answered with
      ;; /answer; --auto-approve selects the first option instead.
      (let [logs-root (or (:logs-root flags) (when-let [f (:logs_root_fn defaults)] (f path))
                          (str "attractor_runs/run_" (System/currentTimeMillis)))
            {:keys [run_id]} (request! c :workflow/run {:dot_source (io/slurp path) :source_path path
                                                        :logs_root logs-root :auto_approve auto-approve?})]
        (focus! console :run run_id)
        [(str "run " (short-id run_id) " started from " path " (logs: " logs-root ")")]))))

(defn- agent! [console args]
  (let [{:keys [words flags missing]} (parse-flags args) [agent-name & prompt-words] words
        prompt (str/join " " prompt-words) c @console d (:agent_defaults c)
        names (str/join ", " (registry/agent-names))]
    (cond
      (seq missing) [(str "flag needs a value: " (str/join ", " missing))]
      (nil? agent-name) [(str "usage: /agent <" names "> <prompt> [--cwd d] [--model m] [--tools a,b] [--permission-mode p] [--sandbox s] [--approval-policy p]")]
      (not (contains? (set (registry/agent-names)) agent-name)) [(str "unknown agent " agent-name "; available: " names)]
      (str/blank? prompt) [(str "usage: /agent " agent-name " <prompt>")]
      :else
      (let [agent (keyword agent-name)
            merged (reduce (fn [m [flag key]]
                             (if-let [v (or (get flags flag) (get d key))] (assoc m key v) m))
                           {} agent-flag-keys)
            fields (cond-> (assoc merged :agent agent :prompt prompt)
                     (string? (:tools merged)) (assoc :tools (str/split (:tools merged) #","))
                     (string? (:timeout_ms merged)) (assoc :timeout_ms (parse-long (:timeout_ms merged)))
                     (:scenario flags) (assoc :scenario (:scenario flags)))
            {:keys [agent_id]} (request! c :agent/run fields)]
        (focus! console :agent agent_id)
        [(str agent-name " " (short-id agent_id) " started")]))))

(defn- alias! [console args]
  (let [[_ name expansion] (re-matches #"\s*([^\s/]+)\s+(.+)" (or args ""))]
    (cond
      (str/blank? args) (let [aliases (:aliases @console)]
                          (if (empty? aliases) ["no aliases defined"]
                              (mapv (fn [[k v]] (str "/" k " -> /" v)) (sort aliases))))
      (nil? name) ["usage: /alias <name> <expansion>, e.g. /alias codex agent codex"]
      (input/command? name) [(str "/" name " is a built-in command")]
      :else (do (swap! console assoc-in [:aliases name] (str/replace expansion #"^/" ""))
                [(str "/" name " -> /" (str/replace expansion #"^/" ""))]))))

(defn- expand-alias [console text]
  ;; /name rest -> /expansion rest, only for explicitly defined aliases.
  (if-let [[_ name rest] (re-matches #"/([^\s/]+)(?:\s+(.*))?" text)]
    (if-let [expansion (get (:aliases @console) name)]
      (str "/" expansion (when rest (str " " rest)))
      text)
    text))

(defn- answer! [console text]
  (let [c @console f (:focus c)
        pending (request! c :question/list {})
        focused (filter #(= (:id f) (:run_id %)) pending)
        chosen (cond (seq focused) (first focused) (= 1 (count pending)) (first pending) :else nil)]
    (cond
      (str/blank? text) ["usage: /answer <key or text>"]
      (empty? pending) ["no question is waiting"]
      (nil? chosen) (into ["several runs are waiting; /focus one first:"]
                          (map #(str "  run " (short-id (:run_id %)) " ? " (get-in % [:question :text])) pending))
      :else (do (request! c :question/answer {:question_id (:question_id chosen) :value (str/trim text)})
                [(str "answered run " (short-id (:run_id chosen)) ": " (str/trim text))]))))

(defn- cancel! [console]
  (let [c @console {:keys [kind id]} (:focus c)]
    (case kind
      :thread (do (request! c :thread/cancel {:thread_id id}) [(str "cancel requested: thread " (short-id id))])
      :agent (do (request! c :agent/cancel {:agent_id id}) [(str "cancel requested: agent " (short-id id))])
      :run (do (request! c :workflow/cancel {:run_id id}) [(str "cancel requested: run " (short-id id))])
      :session (do (request! c :session/cancel {:session_id id}) (swap! console assoc :activity {:active {} :done 0 :phase "Cancelled"}) [(str "cancel requested: session " (short-id id))])
      ["nothing focused to cancel"])))

(defn busy?
  "True when the focused session has an unfinished turn or the focused run or
   agent job is still running. Frontends use it to route an interrupt; a hub that
   cannot answer counts as not busy so an idle interrupt can still quit."
  [console]
  (try
    (let [c @console {:keys [kind id]} (:focus c)
          find (fn [key op] (first (filter #(= id (get % key)) (request! c op {}))))]
      (boolean
        (case kind
          :thread (contains? #{:processing :running :busy :active} (:state (request! c :thread/read {:thread_id id})))
          :session (:busy (find :session_id :session/list))
          :run (when-let [run (find :run_id :workflow/list)] (not (:done run)))
          :agent (when-let [job (find :agent_id :agent/list)] (not (:done job)))
          false)))
    (catch Object _ false)))

(defn- command! [console command args]
  (case command
    :threads (let [threads (request! @console :thread/list {})
                   by-id (into {} (map (fn [t] [(:thread_id t) t]) threads))
                   depth (fn [t] (loop [id (:parent_id t) seen #{(:thread_id t)} n 0]
                                   (if (or (nil? id) (contains? seen id) (nil? (get by-id id))) n
                                     (recur (:parent_id (get by-id id)) (conj seen id) (inc n)))))]
               (mapv (fn [t] (str (apply str (repeat (depth t) "  ")) (when (:parent_id t) "↳ ")
                                  (:thread_id t) " · " (:task t) " · " (:state t)
                                  (when (:archived t) " (archive)"))) threads))
    :thread (let [t (thread-record console (str/trim args))]
              (focus! console :thread (:thread_id t))
              (swap! console assoc-in [:thread_seen (:thread_id t)] (count (:history t)))
              (history-lines t))
    :resume (let [t (thread-record console (str/trim args))
                  resumed (request! @console :thread/resume {:thread_id (:thread_id t)})]
              (focus! console :thread (:thread_id resumed))
              [(str "resumed as thread " (:thread_id resumed))])
    :help help-lines
    :list (list-lines console)
    :new (let [{:keys [session_id]} (request! @console :session/open {})]
           (focus! console :session session_id)
           [(str "focus: session " (short-id session_id))])
    :focus (if (str/blank? args)
             [(if-let [{:keys [kind id]} (:focus @console)] (str "focus: " (name kind) " " (short-id id)) "focus: none")]
             (focus-by-id! console (str/trim args)))
    :repair
    (let [[action id extra] (str/split (str/trim args) #"\s+")]
      (cond
        (str/blank? action)
        (let [status (request! @console :repair/status {})]
          (if-not (:enabled status) ["Repair supervisor disabled; configure --repair-config on the host"]
            (into (vec (remove nil?
                    [(str "Repair supervisor " (if (:running status) "enabled" "stopped") " — " (:repository status))
                     (when (:error status) (str "Error: " (:error status)))
                     (str "Ledger: " (:path status))
                     (when (pos? (:dropped status)) (str "Incident limit reached; dropped: " (:dropped status)))]))
                  (map (fn [job] (str (:id job) "  " (name (:status job))
                                     (when-let [summary (get-in job [:diagnosis :summary])] (str " — " summary))))
                       (:jobs status)))))
        (and (contains? #{"cancel" "activate"} action) (not (str/blank? id)) (nil? extra))
        (do (request! @console (if (= "cancel" action) :repair/cancel :repair/activate) {:repair_id id})
            [(str "Repair " action " requested: " id
                  (when (= "activate" action) "; watch status, then restart after successful activation"))])
        (and (not (contains? #{"cancel" "activate"} action)) (nil? id))
        (let [record (request! @console :repair/detail {:repair_id action})]
          (vec (remove nil? [(str (:id record) "  " (name (:status record)))
                            (when (:diagnosis record) (pr-str (:diagnosis record)))
                            (:error record)
                            (when (:worktree record) (str "Worktree: " (:worktree record)))
                            (when (:commit record) (str "Commit: " (:commit record)))
                            (when (:restart_required record) "Activation complete; restart the harness to use this version.")])) )
        :else ["usage: /repair [ID | cancel ID | activate ID]"]))
    :harness (let [id (ensure-session! console) status (request! @console :session/harness {:session_id id})]
               [(str "Harness " (if (:enabled status) "enabled" "disabled")
                     (when (:frozen status) " (frozen)")
                     (when (:path status) (str " — " (:path status))))
                (str "Entries: " (pr-str (:entries status)) "; refinements: " (:refinements status))])
    :context (let [id (ensure-session! console)]
               [(str "Context: " (pr-str (request! @console :session/context {:session_id id})))])
    :compact (let [id (ensure-session! console)]
               (request! @console :session/compact {:session_id id})
               ["Context checkpoint requested for the next model request"])
    :refine (let [id (ensure-session! console)]
              (request! @console :session/refine {:session_id id :instructions args})
              ["Harness refinement planning started"])
    :followup (if (str/blank? args) ["usage: /followup <text>"]
                (let [result (submit-text! console args :followup)]
                  [(str (if (:queued result) "Queued follow-up" "Started follow-up") " for turn " (short-id (:turn_id result)))]))
    :run (run! console args)
    :answer (answer! console args)
    :agent (agent! console args)
    :alias (alias! console args)
    :cancel (cancel! console)
    :quit (do (close! console) ["bye"])
    [(str "unknown command /" (name command))]))

(defn- dispatch! [console action]
  (case (:type action)
    :agent (let [{:keys [turn_id queued]} (submit-text! console (:text action) :steer)]
             [(str (if queued "→ queued steering " "→ agent ") "turn " (short-id turn_id))])
    :eval (let [f (:selection action)
                {:keys [eval_id]} (request! @console :eval/submit {:code (:text action) :session_id (:session_id f) :run_id (:run_id f)})]
            [(str "→ eval " (short-id eval_id))])
    :command (command! console (:command action) (:args action))
    :cancel (cancel! console)
    :quit (do (close! console) ["bye"])
    :error [(str "input error: " (:message action))]
    [(str "unhandled action " (pr-str action))]))

(defn handle!
  "Feed one input event ({:type :line :text s} | {:type :interrupt} | {:type :eof}).
   Returns {:lines [...]} to render. Selection is captured at submission."
  [console event]
  (let [c @console
        event (if (and (= :line (:type event)) (string? (:text event)) (not (contains? (:input c) :buffer)))
                (assoc event :text (expand-alias console (:text event)))
                event)
        {:keys [state action]} (input/accept (:input c) event (selection console))]
    (swap! console assoc :input state)
    {:lines (cond
              action (try (dispatch! console action)
                          (catch Object e [(str "error: " (ex-message e))]))
              (contains? state :buffer) []
              :else [])
     :buffering (contains? state :buffer)}))
