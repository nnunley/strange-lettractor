(ns attractor.workers.registry
  "Agentic frameworks: streaming wrappers around external coding agents, as
   distinct from providers (network model clients) and models (names). Every
   framework exposes the same contract: (run! options) with :prompt,
   :working_dir, :model, :timeout_ms, :on_event, :cancelled? plus
   framework-specific options, returning {:text ...} or throwing a tagged
   error. Nothing here assumes a default framework; callers select one."
  (:require [clojure.string :as str]
            [attractor.workers.claude :as claude]
            [attractor.workers.codex :as codex]))

(def frameworks
  ;; Wrappers resolve the connector var per call so redefinitions (tests,
  ;; instrumentation) take effect.
  {:claude {:run! (fn [options] (claude/run! options))
            :description "Claude Code CLI (stream-json); options: --tools, --permission-mode"
            :options #{:tools :permission_mode}}
   :codex {:run! (fn [options] (codex/run! options))
           :description "Codex app-server (JSON-RPC over stdio); options: --sandbox, --approval-policy"
           :options #{:sandbox :approval_policy}}})

(defn framework-names [] (sort (map name (keys frameworks))))

(defn resolve-framework
  "Return the framework keyword for a string or keyword, or throw a
   configuration error naming the available frameworks."
  [value]
  (let [k (cond (keyword? value) value (string? value) (keyword value) :else nil)]
    (if (contains? frameworks k)
      k
      (throw (ex-info (str "Unknown agent framework " (pr-str value) "; available: " (str/join ", " (framework-names)))
                      {:category :configuration_error :framework value :available (framework-names)})))))

(defn run!
  "Run one worker of the given framework."
  [framework options]
  ((:run! (get frameworks (resolve-framework framework))) options))
