(ns attractor.mcp
  "Digest-pinned MCP manifests with explicit admission (Slice E).

   Servers are declared data-only in mcp.edn files under project and user
   roots. Admission is explicit per session (:mcp [ids], same shape as
   :skills): manifests are digest-verified and registered as namespaced
   tools after collision checks. Writes additionally require host approvals
   pinned to the resolved manifest digest and each declared write tool.
   Credentials travel by reference (env names) and live in memory only;
   evidence carries digests and redaction flags, never secret values.
   Every failure is fail-closed with an :mcp-* category."
  (:require [attractor.auth :as auth]
            [attractor.url :as url]
            [attractor.manifests :as manifests]
            [attractor.text :as text]
             [attractor.context-discovery :as capacity]
            [attractor.ids :as ids]
            [attractor.mcp-client :as mcp-client]
            [attractor.profiles :as profiles]
            [attractor.skills :as skills]
            [clojure.edn :as edn]
            [clojure.string :as str]
            [hash :as hash]
            [clojure.core :as core]
            [http :as http]
            [io :as io]
            [os :as os]
            [json :as json]))

(def manifest-file "mcp.edn")
(def approvals-file-name "mcp-approvals.edn")
(def allowed-tool-classes #{:pure-tool :idempotent-tool :read-only-resource :write-tool})
(def allowed-side-effects #{:none :read :write})
(def resource-tool-suffix "read_resource")
(def result-truncation-marker "[MCP result truncated at byte budget]")

(defn- fail! [category data]
  (throw (ex-info (str "MCP: " (name category)) (assoc data :category category))))

(defn- non-blank-string? [value]
  (and (string? value) (not (str/blank? value))))

(defn- valid-id? [value]
  (and (string? value) (boolean (re-matches #"[a-z0-9-]+" value))))

(defn- valid-tool-name? [value]
  (and (string? value) (boolean (re-matches #"[A-Za-z0-9_-]+" value))))

(defn- authority-of [url]
  (let [s (str url)
        after (if-let [idx (str/index-of s "://")] (subs s (+ idx 3)) s)
        end (or (str/index-of after "/") (count after))]
    (subs after 0 end)))

(defn- host-of [authority]
  (if (str/starts-with? authority "[")
    (let [close (str/index-of authority "]")]
      (when (some? close) (subs authority 0 (inc close))))
    (let [colon (str/index-of authority ":")]
      (if (some? colon) (subs authority 0 colon) authority))))

(defn- ipv4-loopback? [host]
  (let [parts (str/split (str host) #"[.]")]
    (and (= 4 (count parts))
         (= "127" (first parts))
         (every? (fn [part]
                   (and (boolean (re-matches #"[0-9]{1,3}" part))
                        (let [n (parse-long part)]
                          (and (some? n) (<= 0 n 255)))))
                 parts))))

(defn- loopback-host? [host]
  (let [h (str/lower-case (str host))]
    (or (= h "localhost")
        (= h "[::1]")
        (ipv4-loopback? h))))

(defn- endpoint-ok? [endpoint]
  (let [url (str endpoint)]
    (and (capacity/safe-endpoint? url)
         (or (str/starts-with? url "https://")
             (and (str/starts-with? url "http://")
                  (loopback-host? (host-of (authority-of url))))))))

;; ---------------------------------------------------------------------------
;; Roots and approvals.
;; ---------------------------------------------------------------------------

(defn project-mcp-root [git-root working-dir]
  (str (or git-root working-dir) "/.attractor/mcp"))

(defn user-mcp-root []
  (when-let [base (skills/home-base)]
    (str base "/.attractor/mcp")))

(defn default-approvals-path []
  (when-let [base (skills/home-base)]
    (str base "/.attractor/" approvals-file-name)))

(defn read-default-approvals [access]
  (skills/read-approvals (:read-text access) (:file-exists access)
                         (default-approvals-path)))

;; ---------------------------------------------------------------------------
;; Manifest schema (data-only).
;; ---------------------------------------------------------------------------

(defn- validate-tool-entry! [entry id]
  (when-not (and (map? entry)
                 (valid-tool-name? (:name entry))
                 (non-blank-string? (:description entry))
                 (contains? allowed-tool-classes (:class entry))
                 (contains? allowed-side-effects (:side-effects entry)))
    (fail! :mcp-manifest-invalid {:server_id id :reason :invalid-tool-entry
                                 :tool (:name entry)}))
  (when (or (and (= :write-tool (:class entry))
                 (not= :write (:side-effects entry)))
            (and (= :write (:side-effects entry))
                 (not (contains? #{:write-tool :idempotent-tool} (:class entry)))))
    (fail! :mcp-manifest-invalid {:server_id id :reason :contradictory-tool-effects
                                 :tool (:name entry)}))
  (when (some? (:schema entry))
    (when-not (map? (:schema entry))
      (fail! :mcp-manifest-invalid {:server_id id :reason :tool-schema-must-be-a-map
                                   :tool (:name entry)})))
  entry)

(defn- validate-resource-entry! [entry id]
  (when-not (and (map? entry)
                 (non-blank-string? (:uri entry))
                 (non-blank-string? (:description entry))
                 (= :read-only-resource (:class entry)))
    (fail! :mcp-manifest-invalid {:server_id id :reason :invalid-resource-entry}))
  entry)

(defn- check-required-string! [manifest id field]
  (when-not (non-blank-string? (get manifest field))
    (fail! :mcp-manifest-invalid {:server_id id :reason :missing-field :field field}))
  manifest)

(defn- stdio-transport? [manifest]
  (contains? #{:stdio "stdio"} (:transport manifest)))

(defn- check-transport! [manifest id]
  (let [transport (:transport manifest)]
    (when-not (contains? #{:streamable-http "streamable-http" :stdio "stdio"} transport)
      (fail! :mcp-manifest-invalid {:server_id id :reason :transport-must-be-streamable-http-or-stdio})))
  manifest)

(defn- check-endpoint! [manifest id]
  (if (stdio-transport? manifest)
    (when (some? (:endpoint manifest))
      (fail! :mcp-manifest-invalid {:server_id id :reason :endpoint-forbidden-for-stdio}))
    (when-not (endpoint-ok? (:endpoint manifest))
      (fail! :mcp-manifest-invalid {:server_id id :reason :endpoint-must-be-https-or-loopback})))
  manifest)

(defn- check-command! [manifest id]
  (if (stdio-transport? manifest)
    (when-not (and (vector? (:command manifest))
                   (seq (:command manifest))
                   (every? non-blank-string? (:command manifest)))
      (fail! :mcp-manifest-invalid {:server_id id :reason :stdio-needs-command-vector}))
    (when (some? (:command manifest))
      (fail! :mcp-manifest-invalid {:server_id id :reason :command-forbidden-for-http})))
  manifest)

(defn- check-collections! [manifest id]
  (let [tools (or (:tools manifest) [])
        resources (or (:resources manifest) [])]
    (when-not (and (vector? tools) (vector? resources))
      (fail! :mcp-manifest-invalid {:server_id id :reason :tools-and-resources-must-be-vectors}))
    (when-not (or (seq tools) (seq resources))
      (fail! :mcp-manifest-invalid {:server_id id :reason :needs-tools-or-resources}))
    (let [entries (mapv #(validate-tool-entry! % id) tools)
          rentries (mapv #(validate-resource-entry! % id) resources)]
      (when-not (= (count tools) (count (distinct (map :name tools))))
        (fail! :mcp-manifest-invalid {:server_id id :reason :duplicate-tool-name}))
      (when-not (= (count resources) (count (distinct (map :uri resources))))
        (fail! :mcp-manifest-invalid {:server_id id :reason :duplicate-resource-uri}))
      {:tools entries :resources rentries})))

(defn- check-task-types! [manifest id]
  (let [task-types (:task-types manifest)]
    (when-not (and (vector? task-types) (seq task-types))
      (fail! :mcp-manifest-invalid {:server_id id :reason :task-types-must-be-non-empty}))
    (when-not (every? non-blank-string? task-types)
      (fail! :mcp-manifest-invalid {:server_id id :reason :task-types-must-be-strings})))
  manifest)

(defn- check-limits! [manifest id]
  (let [limits (:limits manifest)
        timeout (:timeout-ms limits)
        max-bytes (:max-bytes limits)]
    (when-not (and (map? limits)
                   (integer? timeout) (>= timeout 1) (<= timeout 60000)
                   (integer? max-bytes) (>= max-bytes 1) (<= max-bytes 1048576))
      (fail! :mcp-manifest-invalid {:server_id id :reason :limits-must-bound-timeout-and-bytes})))
  manifest)

(defn- check-oauth-absent! [manifest id key]
  (when (some? (get manifest key))
    (fail! :mcp-manifest-invalid {:server_id id :reason :oauth-fields-forbidden-for-stdio
                                 :field key}))
  manifest)

(defn- check-stdio-credentials! [manifest id]
  (when (some? (:token-env manifest))
    (when-not (non-blank-string? (:token-env manifest))
      (fail! :mcp-manifest-invalid {:server_id id :reason :token-env-must-be-a-name})))
  (when (some? (:env manifest))
    (fail! :mcp-manifest-invalid {:server_id id :reason :env-not-supported-use-process-inheritance}))
  (doseq [key [:refresh-token-env :token-endpoint :registration-endpoint :registration :scope :authorization-endpoint]]
    (check-oauth-absent! manifest id key))
  manifest)

(defn- check-credentials! [manifest id]
  (if (stdio-transport? manifest)
    (check-stdio-credentials! manifest id)
    (let [tokenless-oauth? (and (not (stdio-transport? manifest))
                                (non-blank-string? (:endpoint manifest))
                                (or (non-blank-string? (:registration-endpoint manifest))
                                    (non-blank-string? (:authorization-url manifest))))]
      (when-not (or (non-blank-string? (:token-env manifest)) tokenless-oauth?)
        (fail! :mcp-manifest-invalid {:server_id id :reason :token-env-required}))))
  manifest)

(defn- check-refresh! [manifest id]
  (when (some? (:refresh-token-env manifest))
    (when-not (non-blank-string? (:refresh-token-env manifest))
      (fail! :mcp-manifest-invalid {:server_id id :reason :refresh-token-env-must-be-a-name}))
    (when-not (and (non-blank-string? (:token-endpoint manifest))
                   (str/starts-with? (str (:token-endpoint manifest)) "https://"))
      (fail! :mcp-manifest-invalid {:server_id id :reason :refresh-needs-https-token-endpoint}))
    ;; :client-id is optional: a dynamically registered client has no id
    ;; until the first handoff, which stores it beside the refresh token.
    (when (some? (:client-id manifest))
      (when-not (non-blank-string? (:client-id manifest))
        (fail! :mcp-manifest-invalid {:server_id id :reason :client-id-must-be-a-string}))))
  manifest)

(defn- validate-manifest! [manifest id]
  (when-not (map? manifest)
    (fail! :mcp-manifest-invalid {:server_id id :reason :manifest-not-a-map}))
  (when-not (= id (:id manifest))
    (fail! :mcp-id-mismatch {:server_id id :manifest_id (:id manifest)}))
  (when-not (valid-id? (:id manifest))
    (fail! :mcp-manifest-invalid {:server_id id :reason :invalid-id}))
  (doseq [field [:revision :name :description]]
    (check-required-string! manifest id field))
  (check-transport! manifest id)
  (check-endpoint! manifest id)
  (check-command! manifest id)
  (check-collections! manifest id)
  (check-task-types! manifest id)
  (check-limits! manifest id)
  (check-credentials! manifest id)
  (check-refresh! manifest id)
  (when (some? (:registration-endpoint manifest))
    (when-not (and (non-blank-string? (:registration-endpoint manifest))
                   (str/starts-with? (str (:registration-endpoint manifest)) "https://"))
      (fail! :mcp-manifest-invalid {:server_id id :reason :registration-endpoint-must-be-https})))
  (when (some? (:registration manifest))
    (when-not (map? (:registration manifest))
      (fail! :mcp-manifest-invalid {:server_id id :reason :registration-must-be-a-map})))
  (when-not (map? (:provenance manifest))
    (fail! :mcp-manifest-invalid {:server_id id :reason :provenance-required}))
  (when (some? (:signature manifest))
    (when-not (map? (:signature manifest))
      (fail! :mcp-manifest-invalid {:server_id id :reason :invalid-signature})))
  ;; Signatures are record-only provenance in this slice: carried into
  ;; evidence, never verified. Verification belongs to promotion policy.
  manifest)

(defn- parse-manifest! [text id manifest-path]
  (let [manifest (try (edn/read-string text)
                      (catch Object _
                        (fail! :mcp-manifest-invalid {:server_id id :reason :manifest-not-edn
                                                     :path manifest-path})))]
    (validate-manifest! manifest id)
    manifest))

(defn- read-or-nil [read-text path]
  (when read-text
    (try (read-text path) (catch Object _ nil))))

(defn- present? [file-exists path]
  (try (boolean (when file-exists (file-exists path)))
       (catch Object _ true)))

(defn- manifest-info [root id read-text file-exists]
  (when (and (string? root) (not (str/blank? root)))
    (let [manifest-path (str root "/" id "/" manifest-file)]
      (when (present? file-exists manifest-path)
        (let [text (read-or-nil read-text manifest-path)]
          (when (nil? text)
            (fail! :mcp-manifest-invalid {:server_id id :reason :manifest-unreadable
                                         :path manifest-path}))
          {:manifest (parse-manifest! text id manifest-path)
           :manifest-digest (hash/sha256 text)})))))

;; ---------------------------------------------------------------------------
;; Resolution with sticky approvals.
;; ---------------------------------------------------------------------------

(defn- resolve-one [id roots read-text file-exists approvals]
  (let [project-info (manifest-info (:project-root roots) id read-text file-exists)
        user-info (manifest-info (:user-root roots) id read-text file-exists)
        {:keys [status winner root cross-root loser-digest approval]}
        (manifests/select-root project-info user-info (get approvals id))]
    (case status
      :missing (fail! :mcp-not-found {:server_id id})
      :conflict (fail! :mcp-cross-root-conflict
                      {:server_id id
                       :project-digest (:manifest-digest project-info)
                       :user-digest (:manifest-digest user-info)
                       :hint "Record a sticky approval naming winning-root plus both digests."})
      (cond-> (assoc winner :root root :cross-root cross-root
                     :approval (when approval {id approval}))
        approval (assoc :loser-digest loser-digest)))))

(defn propose-approval
  "Build the sticky approval entry for a cross-root-divergent server id
   from both roots' manifest digests. Fails closed when a root is absent
   (:mcp-not-found) or no approval is needed (:mcp-approval-unneeded)."
  [opts id winner]
  (when-not (valid-id? id)
    (fail! :mcp-selection-invalid {:reason :ids-must-match-server-id-grammar
                                  :server_ids [id]}))
  (when-not (contains? #{"project" "user"} winner)
    (fail! :mcp-selection-invalid {:reason :winner-must-be-project-or-user
                                  :server_id id}))
  (let [{:keys [project-root user-root read-text file-exists]} opts]
    (when (or (nil? read-text) (nil? file-exists))
      (fail! :mcp-configuration {:reason :no-file-accessors}))
    (let [project-info (manifest-info project-root id read-text file-exists)
          user-info (manifest-info user-root id read-text file-exists)]
      (cond (and (nil? project-info) (nil? user-info))
            (fail! :mcp-not-found {:server_id id})

            (or (nil? project-info) (nil? user-info)
                (manifests/same-digest? project-info user-info))
            (fail! :mcp-approval-unneeded {:server_id id})

            :else
            {id {:winning-root winner
                 :project-digest (:manifest-digest project-info)
                 :user-digest (:manifest-digest user-info)}}))))

(defn discover
  "Best-effort roster of declared servers across both roots for operators."
  [opts]
  (mapv #(dissoc % :cross-root)
        (manifests/discover opts manifest-file valid-id?
          (fn [manifest]
            {:endpoint (when (:endpoint manifest) (str (:endpoint manifest)))
             :command (:command manifest)
             :stdio (contains? #{:stdio "stdio"} (:transport manifest))}))))

(defn find-manifest
  "Locate and validate one server manifest across both roots. Returns
   {:manifest :manifest-digest :root} or nil when undeclared. Invalid
   manifests fail closed."
  [opts id]
  (let [{:keys [project-root user-root read-text file-exists]} opts
        project-info (manifest-info project-root id read-text file-exists)
        user-info (manifest-info user-root id read-text file-exists)]
    (cond (and (nil? project-info) (nil? user-info)) nil
          (nil? user-info) (assoc project-info :root "project")
          (nil? project-info) (assoc user-info :root "user")
          (manifests/same-digest? project-info user-info)
          (assoc project-info :root "project" :cross-root :agree)
          :else (assoc project-info :root "project" :cross-root :divergent))))

(defn format-servers-table [discovered]
  (if (empty? discovered)
    "(no MCP servers declared)"
    (str/join "\n"
              (mapv (fn [{:keys [id revision description endpoint command stdio root manifest-digest]}]
                      (str "  " id " @ " revision " [" root "]\n"
                           "    endpoint: " (or endpoint (str "stdio: " (str/join " " (or command [])))) "\n"
                           "    inherits: " (if stdio "process environment (operator consent via selection)" "n/a (remote server)") "\n"
                           "    digest:   " (or manifest-digest "(unverified)") "\n"
                           "    " description))
                    discovered))))

(defn authorize-guidance
  "Pure operator guidance for the manual token handoff. Names the
   authorization endpoint and scope from the manifest; the harness never
   handles token values. stdio servers are local subprocesses: no browser
   step, tokens (if any) flow from process inheritance."
  [manifest]
  (if (contains? #{:stdio "stdio"} (:transport manifest))
    (str/join "\n"
              (cond-> [(str "  server:  " (:id manifest))
                       "Local subprocess server: no browser authorization step."
                       "Declared tokens flow from process inheritance;"
                       "export them before launching attractor."]
                (non-blank-string? (:token-env manifest))
                (conj (str "  export " (:token-env manifest) "=<token>"))))
    (let [lines ["Complete the browser authorization step out of band, then place"
                 "the resulting tokens in the OS keychain or process environment."
                 "Nothing credential-shaped belongs in the repo, configs, or logs."
                 (str "  server:                " (:id manifest))
                 (str "  endpoint:              " (:endpoint manifest))]]
      (str/join "\n"
                (cond-> lines
                  (non-blank-string? (:authorization-endpoint manifest))
                  (conj (str "  authorization endpoint: " (:authorization-endpoint manifest)))
                  (non-blank-string? (:scope manifest))
                  (conj (str "  scope:                  " (:scope manifest)))
                  (non-blank-string? (:token-env manifest))
                  (conj (str "  export " (:token-env manifest) "=<access-token>"))
                  (non-blank-string? (:refresh-token-env manifest))
                  (conj (str "  export " (:refresh-token-env manifest) "=<refresh-token>")))))))

;; Token refresh and dynamic registration (memory only, never persisted).
;; ---------------------------------------------------------------------------

(defn- form-body [pairs]
  (str/join "&" (map (fn [[key value]] (str (url/encode-component key) "=" (url/encode-component value)))
                     pairs)))

(defn refresh-access-token
  "Exchange a refresh token for a fresh access token. Returns
   {:access-token :expires-in :refresh-token} for memory-only use. The exchange runs
   bounded (timeout plus optional abort) so a hung endpoint cannot stall
   a session; worker errors stay redacted. Fails closed with
   :mcp-auth-failed; nothing is written anywhere."
  [transport token-endpoint client-id refresh-token & [opts]]
  (let [bounds (or opts {})
        sender (or transport http/request)
        outcome (capacity/call!
                  (fn []
                    (sender {:method :post
                             :url token-endpoint
                             :headers {"content-type" "application/x-www-form-urlencoded"
                                       "accept" "application/json"}
                             :body (form-body [["grant_type" "refresh_token"]
                                               ["refresh_token" refresh-token]
                                               ["client_id" client-id]])}))
                  {:timeout_ms (or (:timeout-ms bounds) 10000)
                   :aborted? (:aborted? bounds)})
        response (if (and (map? outcome) (= :unavailable (:status outcome)))
                   (fail! :mcp-auth-failed {:reason :refresh-unavailable
                                           :cause (:reason outcome)})
                   outcome)]
    (when-not (= 200 (:status response))
      (fail! :mcp-auth-failed {:reason :refresh-rejected :status (:status response)}))
    (let [body (try (json/read-json (str (:body response)))
                    (catch Object _
                      (fail! :mcp-auth-failed {:reason :refresh-malformed})))]
      (when-not (non-blank-string? (get body "access_token"))
        (fail! :mcp-auth-failed {:reason :refresh-without-token}))
      ;; A rotating server invalidates the presented refresh token; the
      ;; caller must persist :refresh-token when present or lose the grant.
      {:access-token (get body "access_token")
       :expires-in (get body "expires_in")
       :refresh-token (when (non-blank-string? (get body "refresh_token"))
                        (get body "refresh_token"))})))

(defn perform-registration
  "Register caller-supplied public-client metadata using the bounded auth
   transport (15s default), preserving MCP failure categories."
  [transport registration-endpoint client-metadata]
  (try
    (auth/register-public-client transport registration-endpoint client-metadata)
    (catch Object error
      (let [data (ex-data error)]
        (case (:category data)
          :auth-registration-conflict (throw error)
          :auth-registration-failed
          (fail! :mcp-protocol-error (select-keys data [:reason :status]))
          (fail! :mcp-protocol-error {:reason :registration-transport-failed}))))))

;; ---------------------------------------------------------------------------
;; Result text, labels, and audit.
;; ---------------------------------------------------------------------------

(defn- block-text [block]
  (or (get block "text") (get block "data") ""))

(defn extract-text
  "Render an MCP result payload as text: content/contents blocks joined,
   anything else printed as data. Bounded by the caller."
  [result]
  (let [result (or result {})]
    (cond (and (map? result) (vector? (get result "content")))
          (str/join "\n" (map block-text (get result "content")))
          (and (map? result) (vector? (get result "contents")))
          (str/join "\n" (map block-text (get result "contents")))
          :else (pr-str result))))

(defn- escape-label-text [text]
  (-> (str text)
      (str/replace "&" "&amp;")
      (str/replace "<" "&lt;")
      (str/replace ">" "&gt;")))

(defn label-output
  "Wrap result text as externally supplied evidence with provenance the
   deterministic gates can recognize and exclude. Server text is escaped
   so embedded markup (notably a forged </mcp>) cannot break out of the
   labeled block."
  [server-id tool-name revision received-at text]
  (str "<mcp server=\"" server-id "\" tool=\"" tool-name
       "\" revision=\"" revision "\" received-at=\"" received-at
       "\" provenance=\"externally-supplied\">\n"
       (escape-label-text text) "\n</mcp>"))


(defn- truncate-output [text max-bytes]
  (let [size (count (bytes (str text)))]
    (if (<= size max-bytes)
      {:text (str text) :truncated false}
      (let [marker (str "\n" result-truncation-marker)
            room (max 0 (- max-bytes (count (bytes marker))))]
        {:text (str (text/utf8-prefix (str text) room) marker)
         :truncated true}))))

(defn- audit-entry [base]
  (merge {:type :mcp-call
          :redacted true}
         base))

;; ---------------------------------------------------------------------------
;; Tool-call core.
;; ---------------------------------------------------------------------------

(defn- auth-headers [token]
  {"authorization" (str "Bearer " token)
   "content-type" "application/json"
   "accept" "application/json, text/event-stream"})

(def expiry-leeway-ms
  "Refresh ahead of tracked expiry by this margin so server-side clock
   skew cannot turn a fresh token stale mid-call."
  30000)

(defn- track-token!
  "Record a live access token, its optional expiry, and origin in the
   per-server token state. A nil origin preserves the existing one.
   Values stay in this atom only, never in logs."
  [server-ctx token expires-in-secs & [origin]]
  (let [expires-at (when (integer? expires-in-secs)
                     (+ (System/currentTimeMillis) (* 1000 (max 0 expires-in-secs))))]
    (reset! (:token-state server-ctx) {:token token :expires-at-ms expires-at
                                       :origin (or origin (:origin @(:token-state server-ctx)))})
    token))

(defn- refresh-configured? [server-ctx]
  (let [manifest (:manifest server-ctx)]
    (and (non-blank-string? (:refresh-token-env manifest))
         (non-blank-string? (:token-endpoint manifest))
         (some? (:token-reader server-ctx)))))

(defn- with-refresh-lock! [server-ctx f]
  "Serialize token refresh per server so concurrent expiries single-flight:
   the winner refreshes once while the rest wait, then re-check."
  (let [lock (:refresh-lock server-ctx)]
    (loop []
      (if (compare-and-set! lock false true)
        (try (f) (finally (reset! lock false)))
        (do (core/sleep 5)
            (recur))))))

(defn- refresh-material [server-ctx]
  "Current refresh material as {:token :origin} or nil: explicit env
   first, then the keychain entry for this service identity."
  (let [manifest (:manifest server-ctx)
        refresh-env (:refresh-token-env manifest)
        reader (:token-reader server-ctx)
        env-token (when (and (non-blank-string? refresh-env) (some? reader))
                    (reader refresh-env))]
    (cond (non-blank-string? env-token)
          {:token env-token :origin "environment"}

          (and (non-blank-string? refresh-env)
               (non-blank-string? (:token-endpoint manifest))
               (some? (:credential-store server-ctx)))
          (let [service-id (str "mcp:" (:id manifest))
                host (auth/token-host (str (:token-endpoint manifest)))
                store (:credential-store server-ctx)
                stored (try ((:fetch store) {:host host :username service-id})
                            (catch Object error
                              (fail! :auth-store-failed
                                     {:server_id (:id manifest)
                                      :reason :keychain-unavailable})))]
            (when (non-blank-string? stored)
              {:token stored :origin "keychain"})))))

(defn- keychain-entry [server-ctx username]
  {:host (auth/token-host (str (:token-endpoint (:manifest server-ctx))))
   :username username})

(defn- refresh-client-id [server-ctx]
  "Client id for the refresh grant: the manifest's when declared, else
   the id the last handoff stored beside the refresh token."
  (let [manifest (:manifest server-ctx)
        store (:credential-store server-ctx)]
    (if (non-blank-string? (:client-id manifest))
      (:client-id manifest)
      (when (some? store)
        (try ((:fetch store)
              (keychain-entry server-ctx
                              (auth/client-id-username (str "mcp:" (:id manifest)))))
             (catch Object error
               (fail! :auth-store-failed
                      {:server_id (:id manifest) :reason :keychain-unavailable})))))))

(defn- persist-rotated-refresh! [server-ctx material rotated]
  "Write a rotated refresh token back where the old one came from. Only
   keychain material is ours to replace; an env-supplied token belongs
   to the operator."
  (when (and (non-blank-string? rotated)
             (= "keychain" (:origin material))
             (not= rotated (:token material)))
    ((:store (:credential-store server-ctx))
     (assoc (keychain-entry server-ctx (str "mcp:" (:id (:manifest server-ctx))))
            :secret rotated))))

(defn- try-refresh-locked! [server-ctx]
  "Refresh body; caller must hold the server refresh lock so headers
   and token state update atomically with respect to other refreshers."
  (let [manifest (:manifest server-ctx)
        material (refresh-material server-ctx)
        refresh-token (:token material)]
    (when (str/blank? (str refresh-token))
      (fail! :mcp-auth-failed {:server (:id manifest) :reason :no-refresh-token}))
    (let [client-id (refresh-client-id server-ctx)
          _ (when (str/blank? (str client-id))
              (fail! :mcp-auth-failed {:server (:id manifest) :reason :no-client-id}))
          fresh (refresh-access-token (:transport server-ctx)
                                      (:token-endpoint manifest)
                                      client-id
                                      refresh-token
                                      {:timeout-ms (:timeout-ms server-ctx)
                                       :aborted? (:aborted? server-ctx)})]
      (persist-rotated-refresh! server-ctx material (:refresh-token fresh))
      (mcp-client/set-headers! (:handle server-ctx)
                               (auth-headers (:access-token fresh)))
      (track-token! server-ctx (:access-token fresh) (:expires-in fresh)
                      (:origin material))
      (:access-token fresh))))


(defn- try-refresh [server-ctx]
  "Attempt one refresh using the live refresh token. Serialized per
   server. Returns the fresh access token or throws :mcp-auth-failed."
  (with-refresh-lock! server-ctx (fn [] (try-refresh-locked! server-ctx))))

(defn- token-expired? [server-ctx]
  (let [{:keys [expires-at-ms]} @(:token-state server-ctx)]
    (boolean (and (some? expires-at-ms)
                  (refresh-configured? server-ctx)
                  (>= (System/currentTimeMillis) (- expires-at-ms expiry-leeway-ms))))))

(defn- ensure-fresh-token! [server-ctx]
  "Return {:reused bool}. Fast path reuses the cached token. A possibly
   expired token takes the refresh lock and re-checks inside, so
   concurrent expiries single-flight to exactly one refresh. Without a
   tracked expiry the token is reused until a 401 says otherwise.
   Without refresh configuration an expired token is used as-is and
   left to fail closed."
  [server-ctx]
  (let [manifest (:manifest server-ctx)
        token-env (:token-env manifest)
        cached (:token @(:token-state server-ctx))]
    (if (and (str/blank? (str cached))
             (non-blank-string? (:refresh-token-env manifest))
             (non-blank-string? (:token-endpoint manifest)))
      (with-refresh-lock! server-ctx
        (fn []
          (if (str/blank? (str (:token @(:token-state server-ctx))))
            (do (try-refresh-locked! server-ctx)
                {:reused false})
            {:reused true})))
      (if-not (non-blank-string? token-env)
        {:reused true}
        (if-not (token-expired? server-ctx)
          {:reused true}
          (with-refresh-lock! server-ctx
            (fn []
              (if (token-expired? server-ctx)
                (do (try-refresh-locked! server-ctx)
                    {:reused false})
                {:reused true}))))))))
(defn- refreshable? [server-ctx error]
  (and (= :mcp-auth-failed (:category (ex-data error)))
       (non-blank-string? (:refresh-token-env (:manifest server-ctx)))
       (non-blank-string? (:token-endpoint (:manifest server-ctx)))
       (some? (:token-reader server-ctx))))

(defn- default-oauth-authorizer [transport endpoint descriptor opts]
  (auth/authorize transport endpoint descriptor opts))

(defn- oauth-capable? [server-ctx error]
  (and (= :mcp-auth-failed (:category (ex-data error)))
       (not (stdio-transport? (:manifest server-ctx)))
       (non-blank-string? (:endpoint (:manifest server-ctx)))
       (some? (:transport server-ctx))))

(defn- run-oauth-handoff! [server-ctx expected-token]
  (let [manifest (:manifest server-ctx)
        authorizer (or (:oauth-authorizer server-ctx) default-oauth-authorizer)]
    (with-refresh-lock! server-ctx
      (fn []
        (when (= (:token @(:token-state server-ctx)) expected-token)
          (let [tokens (authorizer (:transport server-ctx)
                         (:endpoint manifest)
                         {:token-url (:token-url manifest)
                          :authorization-url (:authorization-url manifest)
                          :registration-url (:registration-endpoint manifest)
                          :scope (:scope manifest)
                          :client-id (:client-id manifest)}
                         {:service-id (str "mcp:" (:id manifest))
                          :store (:credential-store server-ctx)})]
            (track-token! server-ctx (:access-token tokens) (:expires-in tokens)
                          "oauth-handoff")
            (mcp-client/set-headers! (:handle server-ctx)
                                     (auth-headers (:access-token tokens)))
            tokens))))))

(defn mcp-tool-call!
  "Execute one admitted MCP tool or resource read. params pass through as
   JSON-RPC params. Returns provenance-labeled text and appends a full
   audit entry (digests, never secrets) to the session :mcp_evidence atom.
   Failures propagate with :mcp-* categories. {:raw? true} returns the
   bounded text without the provenance label, for programs that parse it;
   anything a model reads must keep the label."
  [session server-ctx tool-name method params & [opts]]
  (let [manifest (:manifest server-ctx)
        server-id (:id manifest)
        max-bytes (get-in manifest [:limits :max-bytes])
        request-id (ids/prefixed "mcp")
        t0 (System/currentTimeMillis)
        refreshed-this-call (atom false)
        oauth-this-call (atom false)
        expected-token (:token @(:token-state server-ctx))
        outcome (try
                  (let [freshness (ensure-fresh-token! server-ctx)]
                    (assoc
                      (try
                        {:status :ok
                         :response (mcp-client/session-request!
                                     (:handle server-ctx) method params)}
                        (catch Object error
                          (cond
                            (refreshable? server-ctx error)
                            (try
                              (try-refresh server-ctx)
                              (reset! refreshed-this-call true)
                              {:status :ok
                               :response (mcp-client/session-request!
                                           (:handle server-ctx) method params)}
                              (catch Object refresh-error
                                {:status :error :error refresh-error}))

                            (oauth-capable? server-ctx error)
                            (try
                              (let [handoff (run-oauth-handoff! server-ctx expected-token)]
                                (reset! refreshed-this-call true)
                                (reset! oauth-this-call true)
                                {:status :ok
                                 :response (mcp-client/session-request!
                                             (:handle server-ctx) method params)
                                 :oauth-evidence (:flow-evidence handoff)})
                              (catch Object oauth-error
                                {:status :error :error oauth-error}))

                            :else
                            {:status :error :error error})))
                      :freshness freshness))
                  (catch Object error
                    {:status :error :error error :freshness {:reused false}}))
        received-at (System/currentTimeMillis)
        base {:request-id request-id
              :server server-id
              :tool tool-name
              :revision (str (:revision manifest))
              :manifest-digest (:manifest-digest server-ctx)
              :args-digest (hash/sha256 (pr-str params))
              :timeout-ms (get-in manifest [:limits :timeout-ms])
                     :token-source (:token-env manifest)
                     :token-origin (:origin @(:token-state server-ctx))
                     :token-reused (boolean (and (:reused (:freshness outcome))
                                              (not @refreshed-this-call)))
                     :token-expires-at (:expires-at-ms @(:token-state server-ctx))
                     :oauth-authorized @oauth-this-call
                     :oauth-evidence (:oauth-evidence outcome)
              :received-at received-at
              :latency-ms (- received-at t0)}]
    (if (= :ok (:status outcome))
      (let [text (extract-text (:result (:response outcome)))
            empty-label (label-output server-id tool-name (str (:revision manifest))
                                      received-at "")
            room (max 0 (- max-bytes (count (bytes empty-label))))
            shaped (truncate-output text room)
            labeled (label-output server-id tool-name (str (:revision manifest))
                                  received-at (:text shaped))]
        (swap! (:mcp_evidence @session) conj
               (audit-entry (assoc base
                                   :result-digest (hash/sha256 (:text shaped))
                                   :truncated (:truncated shaped)
                                   :status :ok)))
        (if (:raw? opts) (:text shaped) labeled))
      (do (swap! (:mcp_evidence @session) conj
                 (audit-entry (assoc base
                                     :status :error
                                     :error-category (:category (ex-data (:error outcome))))))
          (throw (:error outcome))))))

;; ---------------------------------------------------------------------------
;; Admission.
;; ---------------------------------------------------------------------------

(defn- tool-definition [server-id tool]
  {:name (str server-id "__" (:name tool))
   :description (str (:description tool) " [mcp:" server-id "]")
   :parameters (or (:schema tool) {:type "object"})})

(defn- keychain-refresh-for [store server-id manifest]
  "Read a stored refresh token for a service identity. Returns the
   token or nil when absent. Helper failures throw :auth-store-failed
   instead of degrading silently into re-handoff loops."
  (let [service-id (str "mcp:" server-id)
        host (auth/token-host (str (:token-endpoint manifest)))]
    (try ((:fetch store) {:host host :username service-id})
         (catch Object error
           (fail! :auth-store-failed {:server_id server-id :reason :keychain-unavailable})))))

(defn- admit-one-server [session resolved token-reader transport oauth-authorizer credential-store]
  (let [manifest (:manifest resolved)
        server-id (:id manifest)
        stdio? (stdio-transport? manifest)
        token-env (:token-env manifest)
        refresh-env (:refresh-token-env manifest)
        reader (or token-reader (fn [name] (os/getenv name)))
        token (when (non-blank-string? token-env) (reader token-env))
        env-refresh (when (non-blank-string? refresh-env) (reader refresh-env))
        keychain-refresh (when (and (str/blank? (str env-refresh))
                                    (non-blank-string? refresh-env)
                                    (non-blank-string? (:token-endpoint manifest))
                                    (some? credential-store))
                           (keychain-refresh-for credential-store server-id manifest))
        refresh-available? (or (non-blank-string? env-refresh)
                               (non-blank-string? keychain-refresh))
        origin (cond (non-blank-string? (str token)) "environment"
                     (non-blank-string? env-refresh) "environment"
                     (non-blank-string? keychain-refresh) "keychain")]
    (if (and (non-blank-string? token-env)
             (str/blank? (str token))
             (not refresh-available?))
      (fail! :mcp-auth-missing {:server_id server-id
                               :token_env token-env
                               :hint (str "export " token-env
                                          " with a handoff token; values never enter the repo")})
      ;; Without usable tokens, OAuth-capable manifests proceed to first-401 handoff.
      (when (and (str/blank? (str token))
                 (not refresh-available?)
                 (or (:registration-endpoint manifest) (:authorization-url manifest)))
        (println (str "[mcp] " server-id ": no token configured, OAuth will trigger on first 401."))))
    (let [registry (get-in @session [:provider_profile :tool_registry])
          _ (when (nil? registry)
              (fail! :mcp-configuration {:server_id server-id
                                        :reason :no-tool-registry}))
          tool-names (mapv #(str server-id "__" (:name %)) (:tools manifest))
          resource-tool (when (seq (:resources manifest))
                          (str server-id "__" resource-tool-suffix))
          all-names (cond-> tool-names resource-tool (conj resource-tool))]
      (doseq [tool-name all-names]
        (when (profiles/registry-get registry tool-name)
          (fail! :mcp-tool-collision {:server_id server-id :tool tool-name})))
      (let [aborted? (fn [] (boolean (:abort_signaled @session)))
            timeout-ms (get-in manifest [:limits :timeout-ms])
            handle (if stdio?
                     (try
                       (mcp-client/open-session
                         {:command (:command manifest)
                          :timeout-ms timeout-ms
                          :aborted? aborted?})
                       (catch Object error
                         (fail! :mcp-unavailable {:server_id server-id
                                                 :reason :spawn-failed
                                                 :cause (ex-message error)})))
                     (mcp-client/open-session
                       {:transport transport
                        :endpoint (:endpoint manifest)
                        :timeout-ms timeout-ms
                        :aborted? aborted?
                         :headers (if (str/blank? (str token))
                                     {}
                                     (auth-headers token))}))
            server-ctx {:manifest manifest
                        :manifest-digest (:manifest-digest resolved)
                        :token-state (atom {:token token :expires-at-ms nil :origin origin})
                        :refresh-lock (atom false)
                        :transport-kind (if stdio? :stdio :streamable-http)
                        :timeout-ms timeout-ms
                        :aborted? aborted?
                        :server-pid (when stdio? (mcp-client/server-pid handle 2000))
                        :env-inheritance (when stdio? "process")
                        :root (:root resolved)
                        :cross-root (:cross-root resolved)
                        :loser-digest (:loser-digest resolved)
                        :approval (:approval resolved)
                        :handle handle
                        :transport transport
                        :oauth-authorizer (or oauth-authorizer default-oauth-authorizer)
                        :token-reader (or token-reader
                                          (fn [name] (os/getenv name)))
                        :credential-store credential-store}
            tool-entries
            (mapv (fn [tool]
                    (let [tool-name (str server-id "__" (:name tool))]
                      {:name tool-name
                       :tool {:definition (tool-definition server-id tool)
                              :executor (fn [arguments _]
                                          (mcp-tool-call! session server-ctx
                                                           (:name tool)
                                                           "tools/call"
                                                           {:name (:name tool)
                                                            :arguments (or arguments {})}))}}))
                  (:tools manifest))
            resource-entries
            (if (seq (:resources manifest))
              (let [allowed (into #{} (map :uri (:resources manifest)))
                    tool-name (str server-id "__" resource-tool-suffix)]
                [{:name tool-name
                  :tool {:definition {:name tool-name
                                      :description (str "Read an allowlisted resource [mcp:" server-id "]")
                                      :parameters {:type "object"
                                                   :properties {:uri {:type "string"}}
                                                   :required ["uri"]}}
                         :executor (fn [arguments _]
                                     (let [args (or arguments {})
                                           uri (or (:uri args) (get args "uri") "")]
                                       (when-not (contains? allowed uri)
                                         (fail! :mcp-resource-denied
                                                {:server_id server-id :uri uri}))
                                       (mcp-tool-call! session server-ctx tool-name
                                                        "resources/read" {:uri uri})))}}])
              [])]
        (doseq [{:keys [tool]} (concat tool-entries resource-entries)]
          (profiles/register-tool! registry tool))
        {:server-ctx server-ctx
         :tool-names (mapv :name (concat tool-entries resource-entries))
         :evidence {:type :mcp-server-admitted
                    :server_id server-id
                    :revision (str (:revision manifest))
                    :manifest-digest (:manifest-digest resolved)
                    :root (:root resolved)
                    :cross-root (:cross-root resolved)
                    :loser-digest (:loser-digest resolved)
                    :endpoint (:endpoint manifest)
                    :command (:command manifest)
                    :transport (if stdio? :stdio :streamable-http)
                    :server-pid (:server-pid server-ctx)
                    :tools (mapv :name tool-entries)
                    :write-tools (mapv #(str server-id "__" %) (:admitted-write-tools resolved))
                    :resources (mapv :uri (:resources manifest))
                    :token-source (:token-env manifest)
                    :redacted true
                    :approvals-used (:approval resolved)}}))))

(defn- require-write-approval! [resolved approvals]
  (let [manifest (:manifest resolved)
        server-id (:id manifest)
        writes (mapv :name (filter #(= :write (:side-effects %)) (:tools manifest)))
        grant (get approvals server-id)]
    (when (seq writes)
      (when-not (and (map? grant)
                     (= (:manifest-digest resolved) (:manifest-digest grant))
                     (set? (:tools grant))
                     (every? #(contains? (:tools grant) %) writes))
        (fail! :mcp-write-approval-required
               {:server_id server-id
                :manifest-digest (:manifest-digest resolved)
                :tools writes
                :hint "Host write-approvals must pin this manifest digest and explicitly name every write tool."})))
    (assoc resolved :admitted-write-tools writes)))

(defn mcp-config-digest [admitted]
  (hash/sha256
    (pr-str (sort-by first (mapv (fn [entry] [(:server_id entry) (str (:revision entry))
                                              (:manifest-digest entry)])
                                 admitted)))))

(defn admit-servers!
  "Admit explicitly selected MCP servers into a live session. Resolves
   manifests across project/user roots with sticky approvals, verifies
   digests, requires handoff tokens, registers namespaced tools after
   collision checks, and records per-server evidence. Write tools additionally
   require :write-approvals {server-id {:manifest-digest digest :tools #{names}}}
   from the host; manifest fields and cross-root approvals grant no write access.
   Every selected server is checked before any is opened. Returns
   {:servers [...] :config-digest ...}. Every failure is fail-closed."
  [session selected-ids opts]
  (let [{:keys [project-root user-root read-text file-exists approvals
                transport token-reader oauth-authorizer credential-store write-approvals]} (or opts {})]
    (when-not (and (vector? selected-ids) (seq selected-ids)
                   (every? non-blank-string? selected-ids))
      (fail! :mcp-selection-invalid {:reason :ids-must-be-non-empty-strings}))
    (when-not (every? valid-id? selected-ids)
      (fail! :mcp-selection-invalid {:reason :ids-must-match-server-id-grammar
                                    :server_ids (vec (remove valid-id? selected-ids))}))
    (when (nil? read-text)
      (fail! :mcp-configuration {:reason :no-read-text-accessor}))
    (when (nil? file-exists)
      (fail! :mcp-configuration {:reason :no-file-exists-accessor}))
    (when-not (= (count selected-ids) (count (distinct selected-ids)))
      (fail! :mcp-selection-invalid {:reason :duplicate-selected-id}))
    (when (nil? (:mcp_evidence @session))
      (swap! session assoc :mcp_evidence (atom [])))
    (let [resolved (mapv #(resolve-one % {:project-root project-root :user-root user-root}
                                       read-text file-exists (or approvals {}))
                         selected-ids)
          ;; Preflight the whole selection before credentials, transports, or
          ;; registry mutation: an unapproved later server opens none of them.
          authorized (mapv #(require-write-approval! % write-approvals) resolved)
          admitted (mapv #(admit-one-server session % token-reader transport oauth-authorizer credential-store) authorized)
          config-digest (mcp-config-digest (map :evidence admitted))]
      (swap! session assoc :mcp_servers (mapv :evidence admitted))
      (swap! session assoc :mcp_config_digest config-digest)
      (swap! session update :mcp_close_fns
             (fn [existing]
               (vec (concat (or existing [])
                            (map (fn [entry]
                                   (let [handle (:handle (:server-ctx entry))]
                                     (fn [] (mcp-client/close-session! handle))))
                                 admitted)))))
      {:servers (mapv :evidence admitted)
       :config-digest config-digest})))

;; ---------------------------------------------------------------------------
;; Programmatic access.
;; ---------------------------------------------------------------------------

(defn open-server!
  "Open one manifest-declared server for a program rather than a model
   session. Same gates as admission: manifest resolution and approvals,
   declared tools only, keychain refresh with rotation, OAuth handoff on
   a first 401, and an audit entry per call. Defaults suit a local CLI
   (real files, user and cwd roots, OS keychain, real HTTP); opts
   override any admit-servers! key. Returns {:call! (fn [tool args]) ->
   raw result text, :evidence (fn []) -> audit entries, :close! (fn [])}."
  [server-id & [opts]]
  (let [access (skills/local-file-access)
        options (merge {:project-root (project-mcp-root nil (os/cwd))
                        :user-root (user-mcp-root)
                        :read-text (:read-text access)
                        :file-exists (:file-exists access)
                        :transport http/request
                        :credential-store (auth/osxkeychain-store)}
                       (or opts {}))
        approvals (if (contains? options :approvals)
                    (or (:approvals options) {})
                    (read-default-approvals access))
        session (atom {:id (ids/prefixed "mcp-program")
                       :provider_profile {:tool_registry (profiles/make-tool-registry)}
                       :mcp_evidence (atom [])})
        resolved (resolve-one server-id options (:read-text options)
                              (:file-exists options) approvals)
        authorized (require-write-approval! resolved (:write-approvals options))
        admitted (admit-one-server session authorized (:token-reader options)
                                   (:transport options) (:oauth-authorizer options)
                                   (:credential-store options))
        server-ctx (:server-ctx admitted)
        declared (into #{} (map :name (:tools (:manifest server-ctx))))]
    {:call! (fn [tool-name arguments]
              (when-not (contains? declared tool-name)
                (fail! :mcp-tool-not-declared {:server_id server-id :tool tool-name}))
              (mcp-tool-call! session server-ctx tool-name "tools/call"
                              {:name tool-name :arguments (or arguments {})}
                              {:raw? true}))
     :evidence (fn [] @(:mcp_evidence @session))
     :close! (fn [] (mcp-client/close-session! (:handle server-ctx)))}))
