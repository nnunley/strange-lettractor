(ns attractor.status
  (:require [json :as json]))

(def ^:private allowed-statuses
  #{:success :retry :fail :partial_success})

(defn- explicit-status [outcome]
  (let [present? (and (map? outcome)
                      (or (contains? outcome :status)
                          (contains? outcome "status")))
        value (when present?
                (if (contains? outcome :status)
                  (:status outcome)
                  (get outcome "status")))
        normalized (cond
                     (keyword? value) value
                     (string? value) (keyword value)
                     :else nil)]
    (if (and present? (contains? allowed-statuses normalized))
      normalized
      (throw
        (ex-info "Outcome requires an explicit allowed status"
                 {:category :status_contract_error
                  :retryable false
                  :status value})))))

(defn json-safe-object-keys [value]
  (cond
    (map? value)
    (into {}
          (map (fn [[key nested]]
                 [(if (keyword? key) key (keyword (str key)))
                  (json-safe-object-keys nested)]))
          value)

    (sequential? value)
    (mapv json-safe-object-keys value)

    :else value))

(defn- field-present? [outcome field]
  (or (contains? outcome field)
      (contains? outcome (name field))))

(defn- field-value [outcome field]
  (if (contains? outcome field)
    (get outcome field)
    (get outcome (name field))))

(defn outcome->status-map [outcome]
  (let [status-name (name (explicit-status outcome))]
    (cond-> {:outcome status-name}
      (field-present? outcome :preferred_label)
      (assoc :preferred_label (field-value outcome :preferred_label))

      (field-present? outcome :suggested_next_ids)
      (assoc :suggested_next_ids (field-value outcome :suggested_next_ids))

      (field-present? outcome :context_updates)
      (assoc :context_updates
             (json-safe-object-keys
               (field-value outcome :context_updates)))

      (field-present? outcome :notes)
      (assoc :notes (field-value outcome :notes)))))

(defn outcome->status-json [outcome]
  (json/write-json (outcome->status-map outcome)))
