(ns claude-cli-tests
  (:require [clojure.test :as test]
            [attractor.claude-cli-test]
            [attractor.cli-test]
            [os :as os]))
(defn -main [& _]
  (let [output (with-out-str (test/run-tests))]
    (prn test/*report-counters*)
    (when-not test/*test-result* (println output))
    (os/exit (if test/*test-result* 0 1))))
(when *command-line-args* (apply -main *command-line-args*))
