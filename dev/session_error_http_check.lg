(ns session-error-http-check
  (:require [attractor.agent :as agent] [attractor.llm :as llm]
            [attractor.profiles :as profiles] [attractor.execution :as execution]
            [http :as http] [os :as os] [clojure.string :as str]))

(defn caught [f] (try (f) nil (catch Object e (ex-data e))))
(defn types [session] (mapv :type (agent/session-events session)))
(defn counts [base token]
  (read-string (:body (http/request {:url (str base "/" token "/counts")}))))

(defn check-case [base token provider kind]
  (let [profile (assoc (profiles/create-profile provider "fixture") :supports_streaming true)
        cleaned (atom 0)
        client (llm/make-client {:default_provider provider :providers
                  {provider (llm/make-provider-adapter provider
                              {:api_key "fixture" :base_url (str base "/" token "/" provider "/" kind)})}})
        session (agent/make-session {:provider_profile profile :llm_client client :project_docs []
                                     :execution_env (execution/make-environment {:cleanup #(swap! cleaned inc)})})
        category (if (= kind "auth") :authentication :context-length)]
    (try
      (let [failure (caught #(agent/process-input! session "first"))
            first-events (types session)
            first-count (get (counts base token) (str provider "/" kind))
            first-state (:state @session)
            history (mapv :type (:history @session))
            cleanups-before @cleaned
            recovered (if (= kind "auth")
                        (caught #(agent/process-input! session "second"))
                        (agent/process-input! session "second"))
            final-count (get (counts base token) (str provider "/" kind))
            relevant (first (filter #(= (:type %) (if (= kind "auth") :error :warning))
                                    (agent/session-events session)))
            pass (and (= category (:category failure)) (false? (:retryable failure))
                      (= provider (:provider failure)) (= (if (= kind "auth") 401 413) (:status_code failure))
                      (= "fixture_error" (:error_code failure)) (= category (:category relevant))
                      (= [:user] history) (= 1 first-count)
                      (= (if (= kind "auth") [:session_start :user_input :error :session_end]
                             [:session_start :user_input :warning :processing_end]) first-events)
                      (= (if (= kind "auth") :closed :idle) first-state)
                      (= (if (= kind "auth") 1 0) cleanups-before)
                      (if (= kind "auth")
                        (and (= :session-closed (:category recovered)) (= 1 final-count))
                        (and (= "recovered" recovered) (= 2 final-count)
                             (= :idle (:state @session))
                             (= [:user :user :assistant] (mapv :type (:history @session))))))]
        (agent/close-session! session)
        {:provider provider :case kind :pass (and pass (= 1 @cleaned)
                                                    (= 1 (count (filter #(= :session_end %) (types session)))))
         :failure (select-keys failure [:category :provider :status_code :retryable :error_code])
         :first-events first-events :events (types session)
         :requests-before-next-input first-count :requests-final final-count
         :recovered recovered :cleanups @cleaned})
      (finally (agent/close-session! session)))))

(defn await-ready [base token worker]
  (loop [remaining 100]
    (let [reply (try (http/request {:url (str base "/ready")}) (catch Object _ nil))]
      (cond
        reply (when-not (and (= 200 (:status reply)) (= token (:body reply)))
                (throw (ex-info "Port collision: ready token mismatch" {})))
        (not= ::pending (deref worker 1 ::pending)) (throw (ex-info "Owned fixture exited before readiness" {}))
        (zero? remaining) (throw (ex-info "Fixture readiness deadline exceeded" {}))
        :else (do (sleep 20) (recur (dec remaining)))))))

(defn quote-shell [s] (str "'" (str/replace s "'" "'\"'\"'") "'"))
(defn run-checks [port]
  (let [token (str "session-" (rand-int 1000000000))
        base (str "http://127.0.0.1:" port)
        env (execution/make-local-environment {:working_dir (os/cwd) :env_policy :none :max_command_timeout_ms 30000})
        command (str "/Users/ndn/development/let-go/lg " (quote-shell (str (os/cwd) "/dev/session_error_http_server.lg"))
                     " " port " " token)
        worker (future ((:exec_command env) command 30000 nil {"PATH" "/usr/bin:/bin:/usr/sbin:/sbin"}))]
    (try
      (await-ready base token worker)
      (let [results (mapv (fn [[provider kind]] (check-case base token provider kind))
                         (for [provider ["openai" "anthropic" "gemini" "ollama"] kind ["auth" "context"]]
                           [provider kind]))]
        (doseq [result results] (prn result))
        results)
      (finally
        ((:cleanup env))
        (let [closed (deref worker 3000 ::pending)]
          (when (= ::pending closed) (throw (ex-info "Owned fixture process did not settle" {})))
          (prn {:fixture-cleanup true :child-exit (:exit_code closed) :cancelled (:cancelled closed)}))))))

(defn -main [& args]
  (if (= "--help" (first args))
    (println "session_error_http_check.lg run [PORT] — owns a bounded let-go loopback fixture; no model calls.")
    (let [port (if (second args) (parse-long (second args)) (+ 30000 (rand-int 20000)))]
      (when-not (and (= "run" (first args)) port (<= 1024 port 65535))
        (throw (ex-info "Expected run and optional nonprivileged port" {})))
      (let [results (run-checks port)]
        (prn {:cases (count results) :passed (every? :pass results)})
        (os/exit (if (every? :pass results) 0 1))))))
(when *command-line-args* (apply -main *command-line-args*))
