(ns main
  (:require [attractor.llm]
            [attractor.stream-completion-test]))

;; Explicit requires let the bundler include the production and test namespaces.
;; No top-level exit: lg executes top-level forms while creating a bundle.
(defn -main [& _]
  (let [output (with-out-str (clojure.test/run-tests))]
    (prn clojure.test/*report-counters*)
    (when-not clojure.test/*test-result* (println output))
    (os/exit (if clojure.test/*test-result* 0 1))))

(when *command-line-args* (apply -main *command-line-args*))
