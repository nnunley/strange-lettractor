(require '[clojure.test :refer [deftest is run-tests]]
         '[session-error-http-bounded :as bounded])
(deftest bounded-command-validation
  (let [base "/Users/ndn/development/let-go/lg -source-paths src:test:dev dev/session_error_http_check.lg run"]
    (is (= base (bounded/command [])))
    (is (= (str base " 31001") (bounded/command ["31001"])))
    (doseq [args [["0"] ["65536"] ["bad"] ["31001; echo bad"] ["31001" "extra"]]]
      (is (try (bounded/command args) false (catch Object _ true))))))
(run-tests)
(os/exit (if clojure.test/*test-result* 0 1))
