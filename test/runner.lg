(ns main
  "Test entry point: load the named test namespaces and hand them to
   clojure.test, which owns execution, fixtures and reporting.
     lg -source-paths src:test test/runner.lg attractor.providers-test [more...]
     lg -source-paths src:test test/runner.lg --all
   Exits 0 on success, 1 on failure.

   The full suite uses lgx 0.3.2+'s built-in `lgx test` harness. This
   entry point provides namespace selection, optional diagnostic deadlines,
   and the machine-readable summary consumed by test/runners.sh.

   There is no default deadline: a test that can hang bounds itself.
   `--deadline-ms N` is for chasing a hang: past N the run exits 124 and
   names the namespace that was running."
  (:require [clojure.test :as test]
            [clojure.string :as str]
            [os :as os]
            [harness.deadline :as deadline]))

(defn- all-test-namespaces []
  (->> (str/split (str (:out (os/sh "ls" "test/attractor"))) #"\n")
       (filter #(str/ends-with? % "_test.lg"))
       sort
       (mapv #(str "attractor." (str/replace (subs % 0 (- (count %) 3)) "_" "-")))))

(defn -main [& raw-args]
  (let [all? (boolean (some #(= "--all" %) raw-args))
        {:keys [timeout-ms args]} (deadline/split-args
                                    (remove #{"--all"} raw-args) nil)
        names (if all? (all-test-namespaces) args)]
    (when (empty? names)
      (println "usage: test/runner.lg <namespace> [namespace...] | --all   [--deadline-ms N]")
      (os/exit 2))
    (let [running (atom "startup")
          watch (when timeout-ms
                  (deadline/start! {:timeout-ms timeout-ms :describe (fn [] @running)}))]
      ;; Probes required by a test run their own -main when *command-line-args*
      ;; is non-empty; the runner's arguments are not theirs.
      (binding [*command-line-args* nil]
        (doseq [n names]
          (reset! running (str "load of " n))
          (require (symbol n))))
      (reset! running (str/join ", " names))
      (let [summary (apply test/run-tests (map symbol names))
            failures (+ (:fail summary) (:error summary))]
        (when watch ((:cancel! watch)))
        ;; Key order is a contract: test/runners.sh greps this line.
        (prn (array-map :error (:error summary) :fail (:fail summary)
                        :pass (:pass summary) :test (:test summary)))
        (os/exit (if (zero? failures) 0 1))))))

(when *command-line-args* (apply -main *command-line-args*))
