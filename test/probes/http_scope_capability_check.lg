(ns main (:require [clojure.test :refer [deftest is]] [http :as http]
                    [harness.tests :as tests]))

(deftest http-client-vars-advertise-native-scope-cancellation
  (doseq [v [#'http/get #'http/post #'http/request]]
    (is (true? (:scope-cancellation (meta v))))))

(defn -main [& _]
  (tests/run-and-exit! 'main))
(when *command-line-args* (apply -main *command-line-args*))
