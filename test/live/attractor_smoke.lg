(ns main
  "SCN-ATTR-SMOKE-LIVE: the upstream smoke pipeline through one real model.
   Opt-in: set ATTRACTOR_LIVE_MODEL to provider/name (for example
   openai-compat/qwen3.8-27b with OPENAI_COMPAT_BASE_URL pointing at llama.cpp). Without it
   the run exits 3 and prints a skip record; a skip is never a pass."
  (:require [clojure.test :refer [deftest is]] [clojure.string :as str]
            [os :as os] [io :as io] [json :as json]
            [attractor.pipeline :as pipeline] [attractor.handlers :as handlers]
            [attractor.interviewer :as interviewer] [attractor.agent :as agent]
            [attractor.execution :as execution] [attractor.context :as ctx]))

(def ^:private dot
  (str/join "\n"
    ["digraph smoke {" "graph [goal=\"Create a hello world Python script\"]"
     "start [shape=Mdiamond]"
     "plan [shape=box, prompt=\"Plan, in three short numbered steps, how to create a hello world script for: $goal\"]"
     "implement [shape=box, prompt=\"Write only the Python source for a hello world script based on the plan\", goal_gate=true]"
     "review [shape=box, prompt=\"Review the code for correctness in two sentences\"]"
     "done [shape=Msquare]"
     "start -> plan" "plan -> implement"
     "implement -> review [condition=\"outcome=success\"]"
     "implement -> plan [condition=\"outcome=fail\", label=\"Retry\"]"
     "review -> done [condition=\"outcome=success\"]"
     "review -> implement [condition=\"outcome=fail\", label=\"Fix\"]" "}"]))

(def model (os/getenv "ATTRACTOR_LIVE_MODEL"))

(deftest live-smoke-routes-persists-and-completes
  (let [root (str/trim (:out (os/sh "/usr/bin/mktemp" "-d"))) logs-root (str root "/logs")
        events (atom [])
        ;; Confine the live agent's tools to the temporary root, never the repo.
        workdir (str root "/work") _ (os/sh "/bin/mkdir" "-p" workdir)
        backend (agent/make-agent-codergen-backend
                  {:model model
                   :execution_env (execution/make-local-environment {:working_dir workdir})})
        registry (handlers/make-handler-registry (interviewer/make-auto-approve-interviewer) backend)
        started (System/currentTimeMillis)
        outcome (pipeline/run dot {:logs-root logs-root :registry registry :on-event #(swap! events conj %)})]
    (try
      (is (= :success (:status outcome)) (pr-str (dissoc outcome :context)))
      (is (= ["start" "plan" "implement" "review" "done"] (:completed_nodes outcome)) "routing followed the success edges")
      (doseq [stage ["plan" "implement" "review"]]
        (let [dir (str logs-root "/" stage)]
          (is (os/stat (str dir "/prompt.md")) stage)
          (is (os/stat (str dir "/response.md")) stage)
          (is (not (str/blank? (io/slurp (str dir "/response.md")))) (str stage " has model output"))
          (is (= "success" (get (json/read-json (io/slurp (str dir "/status.json"))) "outcome")) stage)))
      (is (str/includes? (str/lower-case (io/slurp (str logs-root "/implement/response.md"))) "print") "the model wrote Python")
      (let [checkpoint (ctx/load-checkpoint (str logs-root "/checkpoint.edn"))]
        (is (= "done" (:current_node checkpoint)))
        (is (= #{"start" "plan" "implement" "review" "done"} (set (:completed_nodes checkpoint)))))
      (is (= :pipeline.completed (:type (last @events))))
      (is (= 3 (count (filter #(and (= :stage.completed (:type %)) (contains? #{"plan" "implement" "review"} (:node_id %))) @events))))
      (is (nil? (os/stat "hello_world.py")) "the agent did not write into the process working directory")
      (println (str "live smoke: model " model ", " (- (System/currentTimeMillis) started) "ms, "
                    (count @events) " events, logs " logs-root))
      (finally (os/sh "/bin/rm" "-rf" "--" root)))))

(defn -main [& _]
  (if (str/blank? model)
    (do (prn {:scenario "SCN-ATTR-SMOKE-LIVE" :status :skipped :reason "ATTRACTOR_LIVE_MODEL not set"})
        (os/exit 3))
    (let [output (with-out-str (clojure.test/run-tests))]
      (prn clojure.test/*report-counters*)
      (when-not clojure.test/*test-result* (println output))
      (os/exit (if clojure.test/*test-result* 0 1)))))
(when *command-line-args* (apply -main *command-line-args*))
