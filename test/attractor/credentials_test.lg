(ns attractor.credentials-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string :as str]
            [clojure.core :as core]
            [json :as json]
            [io :as io]
            [os :as os]
            [attractor.credentials :as credentials]))

(def source {:type :google-browser :client_file "/private/google.json"
             :scopes ["scope-b" "scope-a" "scope-a"]})
(def profiles {"google" source
               "gemini" {:type :google-oauth :source "google" :quota_project "funded-project"}
               "claude" {:type :anthropic-google-oidc :source "google"
                         :google_service_account "desktop@project.iam.gserviceaccount.com"
                         :organization_id "org-1" :service_account_id "svac_1"
                         :federation_rule_id "fdrl_1" :workspace_id "default"}})
(def client {"installed" {"client_id" "desktop.apps.googleusercontent.com"
                          "client_secret" "client-secret"
                          "auth_uri" "https://accounts.google.com/o/oauth2/auth"
                          "token_uri" "https://oauth2.googleapis.com/token"}})

(defn caught [f] (try (f) nil (catch Object e e)))
(defn store []
  (let [items (atom {}) writes (atom [])]
    {:items items :writes writes
     :ops {:fetch (fn [entry] (get @items [(:host entry) (:username entry)]))
           :store (fn [entry] (swap! writes conj entry)
                    (swap! items assoc [(:host entry) (:username entry)] (:secret entry)))
           :erase (fn [entry] (swap! items dissoc [(:host entry) (:username entry)]))}}))

(deftest validates-typed-reference-graph
  (let [v (credentials/validate-profiles :local profiles)]
    (is (= ["scope-a" "scope-b"] (get-in v ["google" :scopes]))))
  (doseq [p [(assoc-in profiles ["gemini" :source] "missing")
             (assoc-in profiles ["gemini" :source] "claude")
             (assoc-in profiles ["google" :extra] "bad")
             (assoc-in profiles ["google" :scopes] [])]]
    (is (= :credentials-config (:category (ex-data (caught #(credentials/validate-profiles :local p))))))))

(deftest refresh-wire-cache-federation-and-logout
  (let [now (atom 1000000) s (store) calls (atom [])
        p (credentials/validate-profiles :local profiles)
        r (credentials/make-resolver p {:clock (fn [] @now) :store (:ops s)
              :client-reader (fn [_] client)
              :transport (fn [req]
                (swap! calls conj req)
                (cond
                  (= "https://oauth2.googleapis.com/token" (:url req))
                  {:status 200 :body (json/write-json {:access_token "google-access" :expires_in 120
                                                      :token_type "Bearer" :scope "scope-a scope-b"})}
                  (str/includes? (:url req) ":generateIdToken")
                  {:status 200 :body (json/write-json {:token "google-id"})}
                  (= "https://api.anthropic.com/v1/oauth/token" (:url req))
                  {:status 200 :body (json/write-json {:access_token "anthropic-access" :expires_in 120
                                                      :token_type "Bearer"})}))})]
    (is (= :login-required (:state (credentials/status r "google"))))
    (is (empty? @calls))
    ;; Credential identity is deliberately derived by resolver after client inspection.
    (let [entry (credentials/grant-entry r "google")]
      ((:store (:ops s)) (assoc entry :secret "refresh-one")))
    (is (= "google-access" (:token (credentials/resolve! r "gemini"))))
    (is (= "Bearer google-access" (get-in (credentials/resolve! r "gemini") [:headers "authorization"])))
    (is (= "funded-project" (get-in (credentials/resolve! r "gemini") [:headers "x-goog-user-project"])))
    (is (= "anthropic-access" (:token (credentials/resolve! r "claude"))))
    (is (= 1 (count (filter #(= "https://oauth2.googleapis.com/token" (:url %)) @calls))))
    (let [refresh (first @calls)]
      (is (= :post (:method refresh)))
      (is (str/includes? (:body refresh) "grant_type=refresh_token"))
      (is (str/includes? (:body refresh) "refresh_token=refresh-one"))
      (is (str/includes? (:body refresh) "client_secret=client-secret")))
    (is (= "https://iamcredentials.googleapis.com/v1/projects/-/serviceAccounts/desktop%40project.iam.gserviceaccount.com:generateIdToken"
           (:url (second @calls))))
    (is (= {"audience" "https://api.anthropic.com" "includeEmail" true}
           (json/read-json (:body (first (filter #(str/includes? (:url %) ":generateIdToken") @calls))))))
    (let [body (json/read-json (:body (last @calls)))]
      (is (= "urn:ietf:params:oauth:grant-type:jwt-bearer" (get body "grant_type")))
      (is (= "google-id" (get body "assertion")))
      (is (= "org-1" (get body "organization_id")))
      (is (= "fdrl_1" (get body "federation_rule_id")))
      (is (= "svac_1" (get body "service_account_id")))
      (is (= "default" (get body "workspace_id"))))
    (credentials/logout! r "google")
    (is (= :login-required (:state (credentials/status r "claude"))))
    (is (= :credentials-login-required (:category (ex-data (caught #(credentials/resolve! r "gemini"))))))))

(deftest refresh-rotation-expiry-concurrency-and-client-binding
  (let [now (atom 1000000) s (store) calls (atom 0)
        p (credentials/validate-profiles :local {"google" source})
        transport (fn [req]
                    (swap! calls inc)
                    (core/sleep 30)
                    {:status 200 :body (json/write-json
                      {:access_token (str "access-" @calls) :refresh_token "rotated-grant"
                       :expires_in 120 :token_type "Bearer" :scope "scope-a scope-b"})})
        opts {:clock (fn [] @now) :store (:ops s) :client-reader (fn [_] client)
              :transport transport}
        r (credentials/make-resolver p opts)
        entry (credentials/grant-entry r "google")]
    ((:store (:ops s)) (assoc entry :secret "original-grant"))
    (let [a (core/future (credentials/resolve! r "google"))
          b (core/future (credentials/resolve! r "google"))]
      (is (= "access-1" (:token (deref a 2000 nil))))
      (is (= "access-1" (:token (deref b 2000 nil)))))
    (is (= 1 @calls))
    (is (= "rotated-grant" ((:fetch (:ops s)) entry)))
    (is (contains? (credentials/secrets r) "rotated-grant"))
    (swap! now + 91000)
    (is (= "access-2" (:token (credentials/resolve! r "google"))))
    (is (= 2 @calls))
    (let [other-client (assoc-in client ["installed" "client_id"] "other.apps.googleusercontent.com")
          other (credentials/make-resolver p (assoc opts :client-reader (fn [_] other-client)))]
      (is (= :login-required (:state (credentials/status other "google"))))
      (is (= :credentials-login-required (:category (ex-data
              (caught #(credentials/resolve! other "google")))))))
    (let [changed-scopes (credentials/make-resolver
                           (credentials/validate-profiles :local
                             {"google" (assoc source :scopes ["scope-a"])}) opts)]
      (is (= :login-required (:state (credentials/status changed-scopes "google")))))))

(deftest failed-refresh-recovers-without-stale-token
  (let [s (store) calls (atom 0)
        r (credentials/make-resolver
            (credentials/validate-profiles :local {"google" source})
            {:store (:ops s) :client-reader (fn [_] client)
             :transport (fn [_]
               (if (= 1 (swap! calls inc))
                 {:status 403 :body (json/write-json {:error "SECRET-DIAGNOSTIC"})}
                 {:status 200 :body (json/write-json {:access_token "good-token"
                   :expires_in 90 :token_type "Bearer" :scope "scope-a scope-b"})}))})]
    ((:store (:ops s)) (assoc (credentials/grant-entry r "google") :secret "grant"))
    (let [error (caught #(credentials/resolve! r "google"))]
      (is (= :credentials-google (:category (ex-data error))))
      (is (not (str/includes? (pr-str (ex-data error)) "SECRET-DIAGNOSTIC"))))
    (is (= "good-token" (:token (credentials/resolve! r "google"))))
    (is (= 2 @calls))))

(deftest refresh-rejects-reduced-scopes-and-unsafe-rotation
  (doseq [response [{:access_token "good" :expires_in 60 :token_type "Bearer" :scope "scope-a"}
                    {:access_token "good" :refresh_token "bad\nsecret" :expires_in 60
                     :token_type "Bearer" :scope "scope-a scope-b"}]]
    (let [s (store)
          r (credentials/make-resolver
              (credentials/validate-profiles :local {"google" source})
              {:store (:ops s) :client-reader (fn [_] client)
               :transport (fn [_] {:status 200 :body (json/write-json response)})})
          entry (credentials/grant-entry r "google")]
      ((:store (:ops s)) (assoc entry :secret "old-grant"))
      (is (= :credentials-google (:category (ex-data (caught #(credentials/resolve! r "google"))))))
      (is (= "old-grant" ((:fetch (:ops s)) entry))))))

(deftest failed-keychain-rotation-never-returns-access-token
  (let [items (atom {})
        store-ops {:fetch (fn [entry] (get @items [(:host entry) (:username entry)]))
                   :store (fn [_] (throw (ex-info "secret-store-diagnostic" {})))
                   :erase (fn [entry] (swap! items dissoc [(:host entry) (:username entry)]))}
        r (credentials/make-resolver
            (credentials/validate-profiles :local {"google" source})
            {:store store-ops :client-reader (fn [_] client)
             :transport (fn [_] {:status 200 :body (json/write-json
               {:access_token "uncommitted-access" :refresh_token "rotated-grant"
                :expires_in 60 :token_type "Bearer" :scope "scope-a scope-b"})})})
        entry (credentials/grant-entry r "google")]
    (swap! items assoc [(:host entry) (:username entry)] "old-grant")
    (let [error (caught #(credentials/resolve! r "google"))]
      (is (= :credentials-store (:category (ex-data error))))
      (is (not (str/includes? (pr-str (ex-data error)) "secret-store-diagnostic"))))
    (is (= "old-grant" (get @items [(:host entry) (:username entry)])))
    (is (not (contains? @(:cache r) "google")))))

(deftest logout-fences-an-inflight-refresh
  (let [s (store) entered (promise) release (promise)
        r (credentials/make-resolver
            (credentials/validate-profiles :local {"google" source})
            {:store (:ops s) :client-reader (fn [_] client)
             :transport (fn [_]
               (deliver entered true)
               (deref release 2000 nil)
               {:status 200 :body (json/write-json {:access_token "late-token"
                 :refresh_token "late-grant" :expires_in 60 :token_type "Bearer"
                 :scope "scope-a scope-b"})})})
        entry (credentials/grant-entry r "google")]
    ((:store (:ops s)) (assoc entry :secret "old-grant"))
    (let [resolving (core/future (caught #(credentials/resolve! r "google")))]
      (is (= true (deref entered 2000 nil)))
      (let [logging-out (core/future (credentials/logout! r "google"))]
        (loop [i 0]
          (when (and (< i 200) (zero? (get @(:generations r) "google" 0)))
            (core/sleep 5) (recur (inc i))))
        (deliver release true)
        (is (= :credentials-invalidated (:category (ex-data (deref resolving 2000 nil)))))
        (is (= :login-required (:state (deref logging-out 2000 nil))))
        (is (nil? ((:fetch (:ops s)) entry)))
        (is (not (contains? (credentials/secrets r) "late-token")))))))

(deftest public-mode-client-file-is-refused-before-read
  (let [path (str "/tmp/attractor-client-permission-test-" (System/nanoTime) ".json")]
    (try
      (io/spit path (json/write-json client))
      (os/sh "chmod" "0644" path)
      (let [r (credentials/make-resolver
                (credentials/validate-profiles :local
                  {"google" (assoc source :client_file path)})
                {:store (:ops (store)) :transport (fn [_] (throw (ex-info "must not run" {})))})]
        (is (= :error (:state (credentials/status r "google"))))
        (is (= :credentials-google (:category
                 (ex-data (caught #(credentials/grant-entry r "google")))))))
      (finally (os/sh "rm" "-f" path)))))

(deftest close-discards-memory-and-fences-resolution
  (let [calls (atom 0) s (store)
        r (credentials/make-resolver
            (credentials/validate-profiles :local {"google" source})
            {:store (:ops s) :client-reader (fn [_] client)
             :transport (fn [_]
               (swap! calls inc)
               {:status 200 :body (json/write-json {:access_token "seen-access"
                 :expires_in 90 :token_type "Bearer" :scope "scope-a scope-b"})})})
        entry (credentials/grant-entry r "google")]
    ((:store (:ops s)) (assoc entry :secret "refresh-grant"))
    (is (= "seen-access" (:token (credentials/resolve! r "google"))))
    (is (contains? (credentials/secrets r) "seen-access"))
    (is (= :closed (:state (credentials/close! r))))
    (is (empty? (credentials/secrets r)))
    (is (= :closed (:state (credentials/status r "google"))))
    (is (= :credentials-closed (:category (ex-data (caught #(credentials/resolve! r "google"))))))
    (is (= 1 @calls))))
