(ns attractor.repair-incident-test
  (:require [clojure.test :refer [deftest is]] [attractor.agent :as agent]
            [attractor.execution :as execution] [clojure.string :as str] [io :as io] [os :as os]))

(deftest delegated-missing-path-preserves-incident-context
  (let [events (atom []) calls (atom 0)
        root (str (os/cwd) "/attractor_runs/repair-capture-" (random-uuid))
        _ (io/mkdir (str root "/src/attractor"))
        _ (io/spit (str root "/src/attractor/engine.lg") "real source")
        env (execution/make-local-environment {:working_dir root})
        parent (agent/make-session
                 {:model "mock/default" :project_docs [] :execution_env env
                  :on_event #(swap! events conj %)
                  :complete_fn (fn [_]
                    (if (= 1 (swap! calls inc))
                      {:message {:content "" :tool_calls [{:id "missing" :name "read_file" :arguments {"file_path" "engine.lg"}}]}}
                      {:message {:content "done"}}))})]
    (try
      (let [paths ((:glob env) "engine.lg" "src/attractor")
            child (agent/spawn-subagent! parent {"task" (str "Read " (first paths))})
            _ (agent/wait-subagent! parent (:agent_id child))
            event (first (filter #(and (= :subagent_event (:type %)) (= :tool_call_end (get-in % [:event :type]))) @events))
            incident (get-in event [:event :incident])]
        (is (= ["src/attractor/engine.lg"] paths))
        (is (= root (:cwd incident)))
        (is (= {"file_path" "engine.lg"} (:arguments incident)))
        (is (= "Read src/attractor/engine.lg" (:delegation_task incident)))
        (is (= (:id @parent) (:parent_session_id incident)))
        (is (str/includes? (or (get-in incident [:exception :message]) "") "no such file"))
        (is (seq (:history incident)))
        (is (= "1 | real source" ((:read_file env) (first paths) nil nil))))
      (finally (agent/close-session! parent)))))
