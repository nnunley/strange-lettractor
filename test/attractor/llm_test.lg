(ns attractor.llm-test
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.string :as str]
            [json :as json]
            [attractor.llm :as llm]))

(deftest test-model-catalog-supports-provider-capability-and-alias-lookups
  (is (= "claude-opus-4-6" (:id (llm/get-model-info "opus"))))
  (is (= "gpt-5.2" (:id (llm/get-latest-model "openai" "reasoning"))))
  (is (every? #(= "gemini" (:provider %)) (llm/list-models "gemini")))
  (is (> (count (llm/list-models)) 5))
  (is (nil? (llm/get-model-info "future-model-not-yet-cataloged"))))

(deftest test-provider-errors-have-portable-taxonomy-and-retry-after
  (let [error
        (try
          (llm/openai-complete
            {:model "gpt-test" :api_key "bad" :messages []
             :transport
             (fn [_]
               {:status 429 :headers {"retry-after" "2.5"}
                :body "{\"error\":{\"code\":\"rate_limit\",\"message\":\"slow down\"}}"})})
          nil
          (catch Object e e))
        data (ex-data error)]
    (is (= :rate-limit (:category data)))
    (is (true? (:retryable data)))
    (is (= 429 (:status_code data)))
    (is (= "rate_limit" (:error_code data)))
    (is (= 2.5 (:retry_after data))))
  (let [error
        (try
          (llm/gemini-complete
            {:model "gemini-test" :api_key "bad" :messages []
             :transport
             (fn [_]
               {:status 400
                :body "{\"error\":{\"status\":\"UNAUTHENTICATED\",\"message\":\"bad\"}}"})})
          nil
          (catch Object e e))]
    (is (= :authentication (:category (ex-data error))))
    (is (false? (:retryable (ex-data error))))))

(deftest test-retry-policy-honors-backoff-and-retry-after
  (let [calls (atom 0)
        delays (atom [])
        callbacks (atom [])
        result
        (llm/retry
          (fn []
            (if (< (swap! calls inc) 3)
              (throw (ex-info "temporary" {:retryable true}))
              :ok))
          {:max_retries 2 :base_delay 1.0 :backoff_multiplier 2.0
           :max_delay 10.0 :jitter false
           :sleep_fn (fn [delay] (swap! delays conj delay))
           :on_retry (fn [_ attempt delay]
                       (swap! callbacks conj [attempt delay]))})]
    (is (= :ok result))
    (is (= [1.0 2.0] @delays))
    (is (= [[1 1.0] [2 2.0]] @callbacks)))
  (let [calls (atom 0)
        error (try
                (llm/retry
                  (fn []
                    (swap! calls inc)
                    (throw (ex-info "wait too long"
                                    {:retryable true :retry_after 90.0})))
                  {:max_retries 2 :max_delay 60.0
                   :sleep_fn (fn [_] nil)})
                nil
                (catch Object e e))]
    (is (= 1 @calls))
    (is (= 90.0 (:retry_after (ex-data error))))))

(deftest test-generate-retries-each-llm-step-without-reexecuting-tools
  (let [llm-calls (atom 0)
        tool-calls (atom 0)
        adapter
        (llm/make-adapter
          "mock"
          (fn [_]
            (let [call (swap! llm-calls inc)]
              (case call
                1 (throw (ex-info "first transient" {:retryable true}))
                2 {:provider "mock" :message {:role :assistant :content ""}
                   :tool_calls [{:id "call-1" :name "work" :arguments {}}]
                   :usage {} :finish_reason :tool_calls}
                3 (throw (ex-info "second transient" {:retryable true}))
                {:provider "mock" :message {:role :assistant :content "done"}
                 :tool_calls [] :usage {} :finish_reason :stop})))
          (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result
        (llm/generate
          "model" "prompt"
          {:client client :max_tool_rounds 1
           :retry_policy {:max_retries 1 :base_delay 0.0 :jitter false
                          :sleep_fn (fn [_] nil)}
           :tools [{:name "work" :parameters {:type "object"}
                    :execute (fn [_] (swap! tool-calls inc) "ok")}]})]
    (is (= "done" (:text result)))
    (is (= 4 @llm-calls))
    (is (= 1 @tool-calls)))
  (let [calls (atom 0)
        error (try
                (llm/retry
                  (fn []
                    (swap! calls inc)
                    (throw (ex-info "bad request" {:retryable false})))
                  {:max_retries 3 :sleep_fn (fn [_] nil)})
                nil
                (catch Object e e))]
    (is (= 1 @calls))
    (is (= "bad request" (ex-message error)))))

(deftest test-openai-url-resolution
  (testing "Resolves default OpenAI URL when unset"
    (is (= "https://api.openai.com/v1/responses"
           (llm/resolve-openai-url nil))))

  (testing "Appends /responses when omitted"
    (is (= "https://my-proxy.com/v1/responses"
           (llm/resolve-openai-url "https://my-proxy.com/v1"))))

  (testing "Handles trailing slash properly"
    (is (= "https://my-proxy.com/v1/responses"
           (llm/resolve-openai-url "https://my-proxy.com/v1/"))))

  (testing "Preserves full endpoint path when already present"
    (is (= "https://my-proxy.com/v1/responses"
           (llm/resolve-openai-url "https://my-proxy.com/v1/responses")))))

(deftest test-anthropic-url-resolution
  (testing "Resolves default Anthropic URL when unset"
    (is (= "https://api.anthropic.com/v1/messages"
           (llm/resolve-anthropic-url nil))))

  (testing "Appends /messages when omitted"
    (is (= "https://my-proxy.com/v1/messages"
           (llm/resolve-anthropic-url "https://my-proxy.com/v1")))))

(deftest test-provider-detection
  (is (= "openai" (llm/detect-provider "gpt-4o")))
  (is (= "openai" (llm/detect-provider "o1-preview")))
  (is (= "openai" (llm/detect-provider "o3-mini")))
  (is (= "anthropic" (llm/detect-provider "claude-3-7-sonnet")))
  (is (= "gemini" (llm/detect-provider "gemini-2.5-pro")))
  (is (= "mock" (llm/detect-provider "local-test-model"))))

(deftest test-litellm-provider-model-convention
  (testing "Parses provider/model format (LiteLLM convention)"
    (is (= {:provider "ollama" :model "qwen3.5:397b"}
           (llm/parse-model-spec "ollama/qwen3.5:397b")))
    (is (= {:provider "ollama" :model "deepseek-v4-pro:0813"}
           (llm/parse-model-spec "ollama/deepseek-v4-pro:0813")))
    (is (= {:provider "anthropic" :model "claude-3-7-sonnet"}
           (llm/parse-model-spec "anthropic/claude-3-7-sonnet")))
    (is (= {:provider "openai" :model "gpt-4o"}
           (llm/parse-model-spec "openai/gpt-4o")))
    (is (= {:provider "gemini" :model "gemini-2.5-pro"}
           (llm/parse-model-spec "gemini/gemini-2.5-pro"))))

  (testing "Handles un-prefixed models using auto-detection or explicit provider"
    (is (= {:provider "openai" :model "gpt-4o"}
           (llm/parse-model-spec "gpt-4o")))
    (is (= {:provider "anthropic" :model "claude-3-5-haiku"}
           (llm/parse-model-spec "claude-3-5-haiku")))
    (is (= {:provider "ollama" :model "custom-llama"}
           (llm/parse-model-spec "custom-llama" "ollama")))))

(deftest test-request-omits-unspecified-generation-settings
  (let [request (llm/make-request "openai/gpt-test"
                                  [{:role :user :content "hello"}])]
    (is (= "openai" (:provider request)))
    (is (= "gpt-test" (:model request)))
    (is (nil? (:temperature request)))
    (is (nil? (:max_tokens request)))
    (is (nil? (:reasoning_effort request)))))

(deftest test-mock-provider-uses-canonical-content-parts
  (let [response
        (llm/complete
          {:provider "mock" :model "mock-test"
           :messages [{:role :user
                       :content [{:kind :text :text "hello"}]}]})]
    (is (= :text (get-in response [:message :content 0 :kind])))
    (is (str/includes? (llm/response-text response) "hello"))))

(deftest test-provider-options-pass-through
  (let [openai-captured (atom nil)
        anthropic-captured (atom nil)
        gemini-captured (atom nil)
        _ (llm/openai-complete
            {:model "gpt-test" :api_key "key"
             :messages [{:role :user :content "hello"}]
             :provider_options
             {:openai {:metadata {:trace_id "trace-1"}
                       :service_tier "flex"}}
             :transport
             (fn [request]
               (reset! openai-captured request)
               {:status 200
                :body (json/write-json
                        {:id "r" :model "gpt-test" :status "completed"
                         :output [] :usage {}})})})
        _ (llm/anthropic-complete
            {:model "claude-test" :api_key "key" :messages []
             :provider_options
             {:anthropic {:beta_headers ["feature-a" "feature-b"]
                          :thinking {:type "enabled" :budget_tokens 128}}}
             :transport
             (fn [request]
               (reset! anthropic-captured request)
               {:status 200
                :body (json/write-json
                        {:id "m" :content [] :stop_reason "end_turn"
                         :usage {}})})})
        _ (llm/gemini-complete
            {:model "gemini-test" :api_key "key" :messages []
             :provider_options
             {:gemini {:cachedContent "cachedContents/1"
                       :safetySettings [{:category "HARM_CATEGORY_HATE_SPEECH"
                                         :threshold "BLOCK_NONE"}]}}
             :transport
             (fn [request]
               (reset! gemini-captured request)
               {:status 200
                :body (json/write-json
                        {:responseId "g" :candidates [] :usageMetadata {}})})})
        openai-body (json/read-json (:body @openai-captured))
        anthropic-body (json/read-json (:body @anthropic-captured))
        gemini-body (json/read-json (:body @gemini-captured))]
    (is (= "trace-1" (get-in openai-body ["metadata" "trace_id"])))
    (is (= "flex" (get openai-body "service_tier")))
    (is (str/includes?
          (get-in @anthropic-captured [:headers "anthropic-beta"])
          "feature-a,feature-b"))
    (is (str/includes?
          (get-in @anthropic-captured [:headers "anthropic-beta"])
          "prompt-caching-2024-07-31"))
    (is (= 128 (get-in anthropic-body ["thinking" "budget_tokens"])))
    (is (= "cachedContents/1" (get gemini-body "cachedContent")))
    (is (= "BLOCK_NONE"
           (get-in gemini-body ["safetySettings" 0 "threshold"])))))

(deftest test-multimodal-image-parts-translate-across-native-providers
  (let [messages
        [{:role :system
          :content [{:kind :text :text "Analyze precisely"}]}
         {:role :developer
          :content [{:kind :text :text "Follow policy"}]}
         {:role :user
          :content
          [{:kind :text :text "Describe these images"}
           {:kind :image
            :image {:url "https://example.test/chart.png"
                    :media_type "image/png" :detail "high"}}
           {:kind :image
            :image {:data (byte-array [137 80 78 71])
                    :media_type "image/png"}}]}]
        openai-captured (atom nil)
        anthropic-captured (atom nil)
        gemini-captured (atom nil)
        complete-response
        (fn [provider]
          (case provider
            :openai {:id "o" :status "completed" :output [] :usage {}}
            :anthropic {:id "a" :content [] :stop_reason "end_turn" :usage {}}
            {:responseId "g" :candidates [] :usageMetadata {}}))
        _ (llm/openai-complete
            {:model "gpt-test" :api_key "key" :messages messages
             :transport (fn [request]
                          (reset! openai-captured request)
                          {:status 200
                           :body (json/write-json (complete-response :openai))})})
        _ (llm/anthropic-complete
            {:model "claude-test" :api_key "key" :messages messages
             :transport (fn [request]
                          (reset! anthropic-captured request)
                          {:status 200
                           :body (json/write-json (complete-response :anthropic))})})
        _ (llm/gemini-complete
            {:model "gemini-test" :api_key "key" :messages messages
             :transport (fn [request]
                          (reset! gemini-captured request)
                          {:status 200
                           :body (json/write-json (complete-response :gemini))})})
        openai-content
        (get-in (json/read-json (:body @openai-captured)) ["input" 0 "content"])
        anthropic-content
        (get-in (json/read-json (:body @anthropic-captured)) ["messages" 0 "content"])
        gemini-parts
        (get-in (json/read-json (:body @gemini-captured)) ["contents" 0 "parts"])]
    (is (= "Analyze precisely\n\nFollow policy"
           (get (json/read-json (:body @openai-captured)) "instructions")))
    (is (= "Analyze precisely\n\nFollow policy"
           (get-in (json/read-json (:body @anthropic-captured))
                   ["system" 0 "text"])))
    (is (= "Analyze precisely\n\nFollow policy"
           (get-in (json/read-json (:body @gemini-captured))
                   ["systemInstruction" "parts" 0 "text"])))
    (is (= {"type" "input_text" "text" "Describe these images"}
           (get openai-content 0)))
    (is (= {"type" "input_image"
            "image_url" "https://example.test/chart.png"
            "detail" "high"}
           (get openai-content 1)))
    (is (= "data:image/png;base64,iVBORw=="
           (get-in openai-content [2 "image_url"])))
    (is (= {"type" "url" "url" "https://example.test/chart.png"}
           (get-in anthropic-content [1 "source"])))
    (is (= {"type" "base64" "media_type" "image/png"
            "data" "iVBORw=="}
           (get-in anthropic-content [2 "source"])))
    (is (= {"mimeType" "image/png"
            "fileUri" "https://example.test/chart.png"}
           (get-in gemini-parts [1 "fileData"])))
    (is (= {"mimeType" "image/png" "data" "iVBORw=="}
           (get-in gemini-parts [2 "inlineData"])))))

(deftest test-local-image-path-is-inlined-and-mime-type-is-inferred
  (let [path (str "/tmp/strange-lettractor-image-" (random-uuid) ".png")
        captured (atom nil)]
    (spit path (byte-array [0 255]))
    (try
      (llm/gemini-complete
        {:model "gemini-test" :api_key "key"
         :messages [{:role :user
                     :content [{:kind :image :image {:url path}}]}]
         :transport
         (fn [request]
           (reset! captured request)
           {:status 200
            :body (json/write-json
                    {:responseId "g" :candidates [] :usageMetadata {}})})})
      (let [inline-data
            (get-in (json/read-json (:body @captured))
                    ["contents" 0 "parts" 0 "inlineData"])]
        (is (= "image/png" (get inline-data "mimeType")))
        (is (= "AP8=" (get inline-data "data"))))
      (finally
        (delete-file path)))))

(deftest test-binary-content-requires-exactly-one-source
  (doseq [image [{:url "https://example.test/x.png" :data "PNG"}
                 {}]]
    (let [error
          (try
            (llm/openai-complete
              {:model "gpt" :api_key "key"
               :messages [{:role :user
                           :content [{:kind :image :image image}]}]
               :transport (fn [_] (throw (ex-info "network called" {})))})
            nil
            (catch Object e e))]
      (is (= :invalid-request (:category (ex-data error))))
      (is (= :image (:content_kind (ex-data error)))))))

(deftest test-provider-specific-content-parts-replay-verbatim
  (let [openai-captured (atom nil)
        anthropic-captured (atom nil)
        gemini-captured (atom nil)
        send
        (fn [complete model part capture response]
          (complete
            {:model model :api_key "key"
             :messages [{:role :assistant
                         :content [{:kind :provider_content
                                    :provider_data part}]}]
             :transport
             (fn [request]
               (reset! capture request)
               {:status 200 :body (json/write-json response)})}))]
    (send llm/openai-complete "gpt"
          {"type" "refusal" "refusal" "cannot"}
          openai-captured
          {:id "o" :status "completed" :output [] :usage {}})
    (send llm/anthropic-complete "claude"
          {"type" "server_tool_use" "name" "search"}
          anthropic-captured
          {:id "a" :content [] :stop_reason "end_turn" :usage {}})
    (send llm/gemini-complete "gemini"
          {"executableCode" {"language" "PYTHON" "code" "1+1"}}
          gemini-captured
          {:responseId "g" :candidates [] :usageMetadata {}})
    (is (= "cannot"
           (get-in (json/read-json (:body @openai-captured))
                   ["input" 0 "content" 0 "refusal"])))
    (is (= "search"
           (get-in (json/read-json (:body @anthropic-captured))
                   ["messages" 0 "content" 0 "name"])))
    (is (= "1+1"
           (get-in (json/read-json (:body @gemini-captured))
                   ["contents" 0 "parts" 0 "executableCode" "code"])))))

(deftest test-openai-top-level-provider-items-replay-at-top-level
  (let [first-response
        (llm/openai-complete
          {:model "gpt" :api_key "key" :messages []
           :transport
           (fn [_]
             {:status 200
              :body (json/write-json
                      {:id "o1" :status "completed" :usage {}
                       :output [{:type "computer_call" :id "computer-1"
                                 :action {:type "screenshot"}}]})})})
        captured (atom nil)
        _ (llm/openai-complete
            {:model "gpt" :api_key "key"
             :messages [(:message first-response)]
             :transport
             (fn [request]
               (reset! captured request)
               {:status 200
                :body (json/write-json
                        {:id "o2" :status "completed"
                         :output [] :usage {}})})})
        replay-input (get (json/read-json (:body @captured)) "input")]
    (is (= :input_item
           (get-in first-response
                   [:message :content 0 :provider_location])))
    (is (= "computer_call" (get-in replay-input [0 "type"])))
    (is (nil? (get-in replay-input [0 "content"])))))

(deftest test-openai-preserves-interleaved-top-level-item-order
  (let [first-response
        (llm/openai-complete
          {:model "gpt" :api_key "key" :messages []
           :transport
           (fn [_]
             {:status 200
              :body (json/write-json
                      {:id "o1" :status "completed" :usage {}
                       :output [{:type "reasoning" :id "reasoning-1"
                                 :summary []}
                                {:type "function_call" :call_id "call-1"
                                 :name "inspect" :arguments "{}"}
                                {:type "computer_call" :id "computer-1"
                                 :action {:type "screenshot"}}]})})})
        captured (atom nil)
        _ (llm/openai-complete
            {:model "gpt" :api_key "key"
             :messages [(:message first-response)]
             :transport
             (fn [request]
               (reset! captured request)
               {:status 200
                :body (json/write-json
                        {:id "o2" :status "completed"
                         :output [] :usage {}})})})
        replay-input (get (json/read-json (:body @captured)) "input")]
    (is (= ["reasoning" "function_call" "computer_call"]
           (mapv (fn [item] (get item "type")) replay-input)))))

(deftest test-provider-media-responses-normalize-and-replay
  (let [anthropic-response
        (llm/anthropic-complete
          {:model "claude" :api_key "key" :messages []
           :transport
           (fn [_]
             {:status 200
              :body (json/write-json
                      {:id "a" :stop_reason "end_turn" :usage {}
                       :content
                       [{:type "image"
                         :source {:type "base64" :media_type "image/png"
                                  :data "iVBORw=="}}]})})})
        anthropic-replay (atom nil)
        _ (llm/anthropic-complete
            {:model "claude" :api_key "key"
             :messages [(:message anthropic-response)]
             :transport
             (fn [request]
               (reset! anthropic-replay request)
               {:status 200
                :body (json/write-json
                        {:id "a2" :stop_reason "end_turn" :usage {}
                         :content []})})})
        gemini-response
        (llm/gemini-complete
          {:model "gemini" :api_key "key" :messages []
           :transport
           (fn [_]
             {:status 200
              :body (json/write-json
                      {:responseId "g"
                       :candidates
                       [{:finishReason "STOP"
                         :content {:parts
                                   [{:inlineData
                                     {:mimeType "image/png"
                                      :data "iVBORw=="}}]}}]
                       :usageMetadata {}})})})
        gemini-replay (atom nil)
        _ (llm/gemini-complete
            {:model "gemini" :api_key "key"
             :messages [(:message gemini-response)]
             :transport
             (fn [request]
               (reset! gemini-replay request)
               {:status 200
                :body (json/write-json
                        {:responseId "g2" :candidates []
                         :usageMetadata {}})})})]
    (is (= :image
           (get-in anthropic-response [:message :content 0 :kind])))
    (is (= "iVBORw=="
           (get-in (json/read-json (:body @anthropic-replay))
                   ["messages" 0 "content" 0 "source" "data"])))
    (is (= :image (get-in gemini-response [:message :content 0 :kind])))
    (is (= "iVBORw=="
           (get-in (json/read-json (:body @gemini-replay))
                   ["contents" 0 "parts" 0 "inlineData" "data"])))))

(deftest test-audio-and-document-parts-translate-or-fail-explicitly
  (let [captured (atom nil)
        _ (llm/gemini-complete
            {:model "gemini-test" :api_key "key"
             :messages
             [{:role :user
               :content
               [{:kind :audio
                 :audio {:data "WAV" :media_type "audio/wav"}}
                {:kind :document
                 :document {:url "https://example.test/report.pdf"}}]}]
             :transport
             (fn [request]
               (reset! captured request)
               {:status 200
                :body (json/write-json
                        {:responseId "g" :candidates [] :usageMetadata {}})})})
        parts (get-in (json/read-json (:body @captured))
                      ["contents" 0 "parts"])]
    (is (= "audio/wav" (get-in parts [0 "inlineData" "mimeType"])))
    (is (= "V0FW" (get-in parts [0 "inlineData" "data"])))
    (is (= "application/pdf" (get-in parts [1 "fileData" "mimeType"])))
    (doseq [[provider complete message]
            [["openai" llm/openai-complete
              {:kind :document :document {:data "PDF"}}]
             ["anthropic" llm/anthropic-complete
              {:kind :audio :audio {:data "WAV"}}]]]
      (let [error
            (try
              (complete
                {:model "test" :api_key "key"
                 :messages [{:role :user :content [message]}]
                 :transport (fn [_] (throw (ex-info "should not send" {})))})
              nil
              (catch Object e e))]
        (is (= :invalid-request (:category (ex-data error))))
        (is (= provider (:provider (ex-data error))))))))

(deftest test-portable-tool-content-parts-round-trip
  (let [assistant
        {:role :assistant
         :content
         [{:kind :text :text "checking"}
          {:kind :tool_call
           :tool_call {:id "call-9" :name "lookup"
                       :arguments {:query "weather"}}}]}
        tool-result
        {:role :tool
         :content
         [{:kind :tool_result
           :tool_result {:tool_call_id "call-9" :tool_name "lookup"
                         :content "sunny" :is_error false}}]}
        openai-captured (atom nil)
        anthropic-captured (atom nil)
        gemini-captured (atom nil)
        _ (llm/openai-complete
            {:model "gpt-test" :api_key "key"
             :messages [assistant tool-result]
             :transport
             (fn [request]
               (reset! openai-captured request)
               {:status 200
                :body (json/write-json
                        {:id "o" :status "completed" :output [] :usage {}})})})
        _ (llm/anthropic-complete
            {:model "claude-test" :api_key "key"
             :messages [assistant tool-result]
             :transport
             (fn [request]
               (reset! anthropic-captured request)
               {:status 200
                :body (json/write-json
                        {:id "a" :content [] :stop_reason "end_turn" :usage {}})})})
        _ (llm/gemini-complete
            {:model "gemini-test" :api_key "key"
             :messages [assistant tool-result]
             :transport
             (fn [request]
               (reset! gemini-captured request)
               {:status 200
                :body (json/write-json
                        {:responseId "g" :candidates [] :usageMetadata {}})})})
        openai-input (get (json/read-json (:body @openai-captured)) "input")
        anthropic-messages
        (get (json/read-json (:body @anthropic-captured)) "messages")
        gemini-contents
        (get (json/read-json (:body @gemini-captured)) "contents")]
    (is (= ["message" "function_call" "function_call_output"]
           (mapv #(get % "type") openai-input)))
    (is (= "call-9" (get-in openai-input [2 "call_id"])))
    (is (= "tool_use"
           (get-in anthropic-messages [0 "content" 1 "type"])))
    (is (= "tool_result"
           (get-in anthropic-messages [1 "content" 0 "type"])))
    (is (= "lookup"
           (get-in gemini-contents [0 "parts" 1 "functionCall" "name"])))
    (is (= "sunny"
           (get-in gemini-contents
                   [1 "parts" 0 "functionResponse" "response" "result"])))))

(deftest test-gemini-adapter-retains-synthetic-call-name-mapping
  (let [requests (atom [])
        responses
        (atom
          [{:responseId "g1"
            :candidates
            [{:finishReason "STOP"
              :content {:role "model"
                        :parts [{:text "considering" :thought true}
                                {:functionCall
                                 {:name "lookup" :args {:q "x"}}}]}}]
            :usageMetadata {}}
           {:responseId "g2" :candidates [] :usageMetadata {}}])
        adapter
        (llm/make-provider-adapter
          "gemini"
          {:api_key "key"
           :transport
           (fn [request]
             (swap! requests conj request)
             (let [body (first @responses)]
               (swap! responses #(vec (rest %)))
               {:status 200 :body (json/write-json body)}))})
        client (llm/make-client {:providers {"gemini" adapter}
                                 :default_provider "gemini"})
        first-response
        (llm/client-complete client {:model "gemini-test"
                                     :messages [{:role :user :content "go"}]})
        call-id (get-in first-response [:tool_calls 0 :id])
        _ (llm/client-complete
            client
            {:model "gemini-test"
             :messages
             [{:role :assistant
               :content (get-in first-response [:message :parts])}
              {:role :tool
               :content [{:kind :tool_result
                          :tool_result {:tool_call_id call-id
                                        :content "ok"
                                        :is_error false}}]}]})
        replay (json/read-json (:body (second @requests)))]
    (is (str/starts-with? call-id "call_"))
    (is (= true
           (get-in replay ["contents" 0 "parts" 0 "thought"])))
    (is (= "lookup"
           (get-in replay ["contents" 0 "parts" 1 "functionCall" "name"])))
    (is (= "lookup"
           (get-in replay
                   ["contents" 1 "parts" 0 "functionResponse" "name"])))
    (is (nil?
          (get-in replay
                  ["contents" 1 "parts" 0 "functionResponse" "id"])))))

(deftest test-structured-tool-results-use-provider-safe-encoding
  (let [result
        {:role :tool
         :content [{:kind :tool_result
                    :tool_result {:tool_call_id "call-1"
                                  :tool_name "lookup"
                                  :content {:forecast "sunny" :degrees 72}
                                  :image_data (byte-array [137 80 78 71])
                                  :image_media_type "image/png"
                                  :is_error false}}]}
        captures (atom {})
        response-for
        (fn [provider]
          (case provider
            :openai {:id "o" :status "completed" :output [] :usage {}}
            :anthropic {:id "a" :content [] :stop_reason "end_turn" :usage {}}
            {:responseId "g" :candidates [] :usageMetadata {}}))
        transport
        (fn [provider]
          (fn [request]
            (swap! captures assoc provider request)
            {:status 200 :body (json/write-json (response-for provider))}))]
    (llm/openai-complete {:model "gpt" :api_key "key" :messages [result]
                          :transport (transport :openai)})
    (llm/anthropic-complete {:model "claude" :api_key "key" :messages [result]
                             :transport (transport :anthropic)})
    (llm/gemini-complete {:model "gemini" :api_key "key" :messages [result]
                          :transport (transport :gemini)})
    (let [openai-body (json/read-json (:body (:openai @captures)))
          anthropic-body (json/read-json (:body (:anthropic @captures)))
          gemini-body (json/read-json (:body (:gemini @captures)))]
      (is (= "sunny"
             (get (json/read-json
                    (get-in openai-body ["input" 0 "output" 0 "text"]))
                  "forecast")))
      (is (= "data:image/png;base64,iVBORw=="
             (get-in openai-body ["input" 0 "output" 1 "image_url"])))
      (is (= 72
             (get (json/read-json
                    (get-in anthropic-body
                            ["messages" 0 "content" 0 "content" 0 "text"]))
                  "degrees")))
      (is (= "iVBORw=="
             (get-in anthropic-body
                     ["messages" 0 "content" 0 "content" 1 "source" "data"])))
      (is (= "sunny"
             (get-in gemini-body
                     ["contents" 0 "parts" 0 "functionResponse"
                      "response" "forecast"])))
      (is (= "iVBORw=="
             (get-in gemini-body
                     ["contents" 0 "parts" 1 "inlineData" "data"]))))))

(deftest test-structured-response-format-translation
  (let [schema {:type "object"
                :properties {:name {:type "string"}}
                :required ["name"]}
        response-format {:type "json_schema" :json_schema schema :strict true}
        openai-captured (atom nil)
        anthropic-captured (atom nil)
        gemini-captured (atom nil)
        _ (llm/openai-complete
            {:model "gpt-test" :api_key "key" :messages []
             :response_format response-format
             :transport
             (fn [request]
               (reset! openai-captured request)
               {:status 200
                :body (json/write-json
                        {:id "r" :model "gpt-test" :status "completed"
                         :output [] :usage {}})})})
        _ (llm/anthropic-complete
            {:model "claude-test" :api_key "key"
             :messages [{:role :system :content "Be concise"}]
             :response_format response-format
             :transport
             (fn [request]
               (reset! anthropic-captured request)
               {:status 200
                :body (json/write-json
                        {:id "m" :content [] :stop_reason "end_turn"
                         :usage {}})})})
        _ (llm/gemini-complete
            {:model "gemini-test" :api_key "key" :messages []
             :response_format response-format
             :transport
             (fn [request]
               (reset! gemini-captured request)
               {:status 200
                :body (json/write-json
                        {:responseId "g" :candidates [] :usageMetadata {}})})})
        openai-body (json/read-json (:body @openai-captured))
        anthropic-body (json/read-json (:body @anthropic-captured))
        gemini-body (json/read-json (:body @gemini-captured))]
    (is (= "json_schema" (get-in openai-body ["text" "format" "type"])))
    (is (= true (get-in openai-body ["text" "format" "strict"])))
    (is (str/includes? (get-in anthropic-body ["system" 0 "text"])
                       "required"))
    (is (= "application/json"
           (get-in gemini-body ["generationConfig" "responseMimeType"])))
    (is (= ["name"]
           (get-in gemini-body ["generationConfig" "responseSchema" "required"])))))

(deftest test-provider-tool-choice-translation
  (let [tool {:name "lookup" :description "Look up a value"
              :parameters {:type "object"}}
        openai-captured (atom nil)
        anthropic-captured (atom nil)
        anthropic-none-captured (atom nil)
        gemini-captured (atom nil)
        _ (llm/openai-complete
            {:model "gpt-test" :api_key "key" :messages [] :tools [tool]
             :tool_choice {:mode "named" :tool_name "lookup"}
             :transport
             (fn [request]
               (reset! openai-captured request)
               {:status 200
                :body (json/write-json
                        {:id "r" :status "completed" :output [] :usage {}})})})
        _ (llm/anthropic-complete
            {:model "claude-test" :api_key "key" :messages [] :tools [tool]
             :tool_choice {:mode "required"}
             :transport
             (fn [request]
               (reset! anthropic-captured request)
               {:status 200
                :body (json/write-json
                        {:id "a" :content [] :stop_reason "end_turn" :usage {}})})})
        _ (llm/anthropic-complete
            {:model "claude-test" :api_key "key" :messages [] :tools [tool]
             :tool_choice {:mode "none"}
             :transport
             (fn [request]
               (reset! anthropic-none-captured request)
               {:status 200
                :body (json/write-json
                        {:id "a2" :content [] :stop_reason "end_turn" :usage {}})})})
        _ (llm/gemini-complete
            {:model "gemini-test" :api_key "key" :messages [] :tools [tool]
             :tool_choice {:mode "named" :tool_name "lookup"}
             :transport
             (fn [request]
               (reset! gemini-captured request)
               {:status 200
                :body (json/write-json
                        {:responseId "g" :candidates [] :usageMetadata {}})})})
        openai-body (json/read-json (:body @openai-captured))
        anthropic-body (json/read-json (:body @anthropic-captured))
        anthropic-none-body (json/read-json (:body @anthropic-none-captured))
        gemini-body (json/read-json (:body @gemini-captured))]
    (is (= "function" (get-in openai-body ["tool_choice" "type"])))
    (is (= "lookup"
           (get-in openai-body ["tool_choice" "function" "name"])))
    (is (= "any" (get-in anthropic-body ["tool_choice" "type"])))
    (is (nil? (get anthropic-none-body "tools")))
    (is (nil? (get anthropic-none-body "tool_choice")))
    (is (= "ANY"
           (get-in gemini-body
                   ["toolConfig" "functionCallingConfig" "mode"])))
    (is (= ["lookup"]
           (get-in gemini-body
                   ["toolConfig" "functionCallingConfig"
                    "allowedFunctionNames"])))))

(deftest test-tool-definition-validates-portable-name-and-schema
  (let [execute (fn [_] "ok")
        tool (llm/make-tool "lookup_weather" "Look up weather"
                            {:type "object" :properties {}}
                            execute)]
    (is (= "lookup_weather" (:name tool)))
    (is (= execute (:execute tool)))
    (doseq [[name schema]
            [["9invalid" {:type "object"}]
             ["contains-dash" {:type "object"}]
             [(apply str (repeat 65 "a")) {:type "object"}]
             ["valid_name" {:type "array"}]]]
      (is (true?
            (try
              (do (llm/make-tool name "bad" schema) false)
              (catch Object _ true)))))))

(deftest test-generate-object-parses-and-validates-schema
  (let [schema {:type "object"
                :properties {:name {:type "string"} :age {:type "integer"}}
                :required ["name" "age"]}
        handler (fn [request]
                  {:id "mock-object"
                   :model (:model request)
                   :provider "mock"
                   :message {:role :assistant
                             :content "{\"name\":\"Alice\",\"age\":30}"}
                   :tool_calls []
                   :usage {:input_tokens 2 :output_tokens 4 :total_tokens 6}
                   :finish_reason :stop})
        result (llm/generate-object "mock/test" "Extract the person" schema
                                    {:mock_handler handler})]
    (is (= "Alice" (get-in result [:output "name"])))
    (is (= 30 (get-in result [:output "age"])))
    (is (= 6 (get-in result [:total_usage :total_tokens])))
    (is (true?
          (try
            (do (llm/generate-object
                  "mock/test" "bad" schema
                  {:mock_handler
                   (fn [request]
                     {:model (:model request) :provider "mock"
                      :message {:role :assistant :content "{\"name\":\"Alice\"}"}
                      :usage {} :finish_reason :stop})})
                false)
            (catch Object _ true))))))

(deftest test-client-routes-default-and-explicit-providers
  (let [calls (atom [])
        adapter (fn [provider]
                  (llm/make-adapter
                    provider
                    (fn [request]
                      (swap! calls conj [provider (:model request)])
                      {:provider provider :model (:model request)
                       :message {:role :assistant :content provider}
                       :tool_calls [] :usage {} :finish_reason :stop})
                    (fn [_] [])))
        client (llm/make-client
                 {:providers {"alpha" (adapter "alpha")
                              "beta" (adapter "beta")}
                  :default_provider "alpha"})]
    (is (= "alpha" (:provider (llm/client-complete
                                client {:model "native-model" :messages []}))))
    (is (= "beta" (:provider (llm/client-complete
                               client {:provider "beta"
                                       :model "other-model" :messages []}))))
    (is (= [["alpha" "native-model"] ["beta" "other-model"]] @calls))
    (is (true?
          (try
            (do (llm/client-complete (llm/make-client {:providers {}})
                                     {:model "ambiguous" :messages []})
                false)
            (catch Object _ true))))))

(deftest test-client-middleware-uses-onion-order
  (let [events (atom [])
        middleware
        [(fn [request next]
           (swap! events conj :one-before)
           (let [response (next request)]
             (swap! events conj :one-after)
             response))
         (fn [request next]
           (swap! events conj :two-before)
           (let [response (next request)]
             (swap! events conj :two-after)
             response))]
        adapter (llm/make-adapter
                  "mock"
                  (fn [_]
                    (swap! events conj :adapter)
                    {:provider "mock" :message {:content "ok"}
                     :tool_calls [] :usage {} :finish_reason :stop})
                  (fn [_] [{:type :finish}]))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"
                                 :middleware middleware})]
    (llm/client-complete client {:model "test" :messages []})
    (is (= [:one-before :two-before :adapter :two-after :one-after]
           @events))))

(deftest test-client-middleware-wraps-streams
  (let [adapter (llm/make-adapter
                  "mock" (fn [_] {})
                  (fn [_] [{:type :text_delta :delta "hi"}]))
        middleware (fn [request next]
                     (map (fn [event] (assoc event :observed true))
                          (next request)))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"
                                 :middleware [middleware]})
        events (vec (llm/client-stream client {:model "test" :messages []}))]
    (is (= "hi" (:delta (first events))))
    (is (true? (:observed (first events))))))

(deftest test-client-initializes-and-closes-adapters
  (let [events (atom [])
        adapter (llm/make-adapter
                  "mock" (fn [_] {}) (fn [_] [])
                  {:initialize (fn [] (swap! events conj :initialize))
                   :close (fn [] (swap! events conj :close))})
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})]
    (is (= [:initialize] @events))
    (llm/client-close! client)
    (is (= [:initialize :close] @events))))

(deftest test-client-from-env-registers-only-configured-providers
  (let [client (llm/client-from-env
                 {"OPENAI_API_KEY" "openai-key"
                  "GOOGLE_API_KEY" "google-key"})]
    (is (= #{"openai" "gemini"} (set (keys (:providers client)))))
    (is (= "openai" (:default_provider client)))
    (is (= "google-key"
           (get-in client [:providers "gemini" :options :api_key])))))

(deftest test-high-level-generate-standardizes-input-and-result
  (let [captured (atom nil)
        adapter (llm/make-adapter
                  "mock"
                  (fn [request]
                    (reset! captured request)
                    {:id "response-1" :provider "mock" :model (:model request)
                     :message {:role :assistant :content "Hello"}
                     :reasoning "because"
                     :tool_calls []
                     :usage {:input_tokens 2 :output_tokens 1 :total_tokens 3}
                     :finish_reason :stop})
                  (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result (llm/generate "native-model" "Hi"
                             {:system "Be kind" :client client})]
    (is (= [{:role :system :content "Be kind"}
            {:role :user :content "Hi"}]
           (:messages @captured)))
    (is (= "Hello" (:text result)))
    (is (= "because" (:reasoning result)))
    (is (= 3 (get-in result [:total_usage :total_tokens])))
    (is (= 1 (count (:steps result))))
    (is (= "response-1" (get-in result [:response :id])))
    (is (= "Hello"
           (:text (llm/generate
                    "native-model" nil
                    {:messages [{:role :user :content "From history"}]
                     :client client}))))
    (is (= [{:role :user :content "From history"}] (:messages @captured)))
    (is (true?
          (try
            (do (llm/generate "native-model" nil
                              {:messages [{:role :user :content "Hi"}]
                               :prompt "also hi" :client client})
                false)
            (catch Object _ true))))))

(deftest test-generate-executes-active-tools-and-aggregates-steps
  (let [requests (atom [])
        tool-arguments (atom [])
        adapter
        (llm/make-adapter
          "mock"
          (fn [request]
            (swap! requests conj request)
            (if (= 1 (count @requests))
              {:id "step-1" :provider "mock" :model (:model request)
               :message {:role :assistant :content "Checking"}
               :tool_calls [{:id "call-1" :name "lookup"
                             :arguments {"query" "weather"}}]
               :usage {:input_tokens 2 :output_tokens 1 :total_tokens 3}
               :finish_reason :tool_calls}
              {:id "step-2" :provider "mock" :model (:model request)
               :message {:role :assistant :content "Sunny"}
               :tool_calls []
               :usage {:input_tokens 4 :output_tokens 2 :total_tokens 6}
               :finish_reason :stop}))
          (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result
        (llm/generate
          "native-model" "What is the weather?"
          {:client client :max_tool_rounds 2
           :tools [{:name "lookup" :description "Look up weather"
                    :parameters {:type "object"}
                    :execute (fn [arguments]
                               (swap! tool-arguments conj arguments)
                               {:forecast "sunny"})}]})]
    (is (= [{"query" "weather"}] @tool-arguments))
    (is (= 2 (count @requests)))
    (is (= "Sunny" (:text result)))
    (is (= 9 (get-in result [:total_usage :total_tokens])))
    (is (= 2 (count (:steps result))))
    (is (= {:forecast "sunny"}
           (get-in result [:steps 0 :tool_results 0 :content])))
    (is (= :assistant (get-in @requests [1 :messages 1 :role])))
    (is (= :tool (get-in @requests [1 :messages 2 :role])))
    (is (= "call-1"
           (get-in @requests [1 :messages 2 :content 0 :tool_call_id])))))

(deftest test-generate-does-not-execute-passive-tools-or-exceed-budget
  (let [calls (atom 0)
        executions (atom 0)
        adapter
        (llm/make-adapter
          "mock"
          (fn [request]
            (swap! calls inc)
            {:provider "mock" :model (:model request)
             :message {:role :assistant :content ""}
             :tool_calls [{:id "call-1" :name "lookup" :arguments {}}]
             :usage {} :finish_reason :tool_calls})
          (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})]
    (llm/generate "model" "prompt"
                  {:client client :max_tool_rounds 3
                   :tools [{:name "lookup" :parameters {:type "object"}}]})
    (is (= 1 @calls))
    (llm/generate "model" "prompt"
                  {:client client :max_tool_rounds 0
                   :tools [{:name "lookup" :parameters {:type "object"}
                            :execute (fn [_] (swap! executions inc))}]})
    (is (= 2 @calls))
    (is (= 0 @executions))))

(deftest test-generate-returns-tool-errors-to-model
  (let [requests (atom [])
        adapter
        (llm/make-adapter
          "mock"
          (fn [request]
            (swap! requests conj request)
            (if (= 1 (count @requests))
              {:provider "mock" :message {:role :assistant :content ""}
               :tool_calls [{:id "bad-1" :name "missing" :arguments {}}]
               :usage {} :finish_reason :tool_calls}
              {:provider "mock" :message {:role :assistant :content "recovered"}
               :tool_calls [] :usage {} :finish_reason :stop}))
          (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result (llm/generate "model" "prompt"
                             {:client client :max_tool_rounds 1 :tools []})]
    (is (= "recovered" (:text result)))
    (is (true? (get-in result [:steps 0 :tool_results 0 :is_error])))
    (is (str/includes?
          (get-in result [:steps 0 :tool_results 0 :content])
          "Unknown tool"))))

(deftest test-generate-validates-tool-arguments-before-execution
  (let [executed (atom false)
        requests (atom 0)
        adapter
        (llm/make-adapter
          "mock"
          (fn [_]
            (swap! requests inc)
            (if (= 1 @requests)
              {:provider "mock" :message {:role :assistant :content ""}
               :tool_calls [{:id "bad-args" :name "lookup" :arguments {}}]
               :usage {} :finish_reason :tool_calls}
              {:provider "mock" :message {:role :assistant :content "fixed"}
               :tool_calls [] :usage {} :finish_reason :stop}))
          (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result
        (llm/generate
          "model" "prompt"
          {:client client :max_tool_rounds 1
           :tools [{:name "lookup"
                    :parameters {:type "object"
                                 :properties {:query {:type "string"}}
                                 :required ["query"]}
                    :execute (fn [_] (reset! executed true))}]})]
    (is (false? @executed))
    (is (true? (get-in result [:steps 0 :tool_results 0 :is_error])))
    (is (str/includes? (get-in result [:steps 0 :tool_results 0 :content])
                       "Missing required property"))))

(deftest test-generate-executes-parallel-tools-concurrently-in-order
  (let [started (atom 0)
        gate (promise)
        requests (atom 0)
        handler (fn [arguments]
                  (let [count-started (swap! started inc)]
                    (when (= count-started 2) (deliver gate :go))
                    (if (= :go (deref gate 1000 :timeout))
                      (get arguments "value")
                      :did-not-overlap)))
        adapter
        (llm/make-adapter
          "mock"
          (fn [_]
            (swap! requests inc)
            (if (= 1 @requests)
              {:provider "mock" :message {:role :assistant :content ""}
               :tool_calls [{:id "a" :name "first"
                             :arguments {"value" "one"}}
                            {:id "b" :name "second"
                             :arguments {"value" "two"}}]
               :usage {} :finish_reason :tool_calls}
              {:provider "mock" :message {:role :assistant :content "done"}
               :tool_calls [] :usage {} :finish_reason :stop}))
          (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result
        (llm/generate
          "model" "prompt"
          {:client client :max_tool_rounds 1
           :tools [{:name "first" :parameters {:type "object"} :execute handler}
                   {:name "second" :parameters {:type "object"} :execute handler}]})]
    (is (= 2 @started))
    (is (= ["one" "two"]
           (mapv :content (get-in result [:steps 0 :tool_results]))))))

(deftest test-openai-stream-normalizes-responses-sse
  (let [captured (atom nil)
        sse (str
              "event: response.created\n"
              "data: {\"type\":\"response.created\",\"response\":{\"id\":\"resp-stream\"}}\n\n"
              "event: response.output_item.added\n"
              "data: {\"type\":\"response.output_item.added\",\"item\":{\"id\":\"msg-1\",\"type\":\"message\",\"content\":[]}}\n\n"
              "event: response.content_part.added\n"
              "data: {\"type\":\"response.content_part.added\",\"item_id\":\"msg-1\",\"part\":{\"type\":\"output_text\",\"text\":\"\"}}\n\n"
              "event: response.output_text.delta\n"
              "data: {\"type\":\"response.output_text.delta\",\"item_id\":\"msg-1\",\"delta\":\"Hel\"}\n\n"
              "event: response.output_text.delta\n"
              "data: {\"type\":\"response.output_text.delta\",\"item_id\":\"msg-1\",\"delta\":\"lo\"}\n\n"
              "event: response.output_text.done\n"
              "data: {\"type\":\"response.output_text.done\",\"item_id\":\"msg-1\",\"text\":\"Hello\"}\n\n"
              "event: response.completed\n"
              "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp-stream\",\"model\":\"gpt-test\",\"status\":\"completed\",\"output\":[{\"type\":\"message\",\"content\":[{\"type\":\"output_text\",\"text\":\"Hello\"}]}],\"usage\":{\"input_tokens\":2,\"output_tokens\":1,\"total_tokens\":3}}}")
        events (vec
                 (llm/stream
                   {:provider "openai" :model "gpt-test" :api_key "key"
                    :messages [{:role :user :content "hello"}]
                    :transport (fn [request]
                                 (reset! captured request)
                                 {:status 200 :body sse})}))]
    (is (= true (get (json/read-json (:body @captured)) "stream")))
    (is (= :stream (:as @captured)))
    (is (= [:stream_start :text_start :text_delta :text_delta :text_end :finish]
           (mapv :type events)))
    (is (= ["Hel" "lo"]
           (mapv :delta (filter (fn [event] (= (:type event) :text_delta)) events))))
    (is (= "Hello" (get-in (last events) [:response :message :text])))
    (is (= 3 (get-in (last events) [:usage :total_tokens])))))

(deftest test-sse-parser-handles-multiline-retry-comments-and-eof
  (let [events (vec
                 (llm/parse-sse-lines
                   [": keepalive"
                    "event: update"
                    "retry: 1500"
                    "data: first"
                    "data: second"]))]
    (is (= 1 (count events)))
    (is (= "update" (:event (first events))))
    (is (= 1500 (:retry (first events))))
    (is (= "first\nsecond" (:data (first events))))))

(deftest test-anthropic-stream-normalizes-native-sse
  (let [captured (atom nil)
        sse (str
              "event: message_start\n"
              "data: {\"type\":\"message_start\",\"message\":{\"id\":\"msg-stream\",\"model\":\"claude-test\",\"usage\":{\"input_tokens\":3}}}\n\n"
              "event: content_block_start\n"
              "data: {\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"text\",\"text\":\"\"}}\n\n"
              "event: content_block_delta\n"
              "data: {\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"Hel\"}}\n\n"
              "event: content_block_delta\n"
              "data: {\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"lo\"}}\n\n"
              "event: content_block_stop\n"
              "data: {\"type\":\"content_block_stop\",\"index\":0}\n\n"
              "event: message_delta\n"
              "data: {\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"end_turn\"},\"usage\":{\"output_tokens\":2}}\n\n"
              "event: message_stop\n"
              "data: {\"type\":\"message_stop\"}\n\n")
        events (vec
                 (llm/stream
                   {:provider "anthropic" :model "claude-test" :api_key "key"
                    :messages [{:role :user :content "hello"}]
                    :transport (fn [request]
                                 (reset! captured request)
                                 {:status 200 :body sse})}))]
    (is (= true (get (json/read-json (:body @captured)) "stream")))
    (is (= :stream (:as @captured)))
    (is (= [:stream_start :text_start :text_delta :text_delta :text_end :finish]
           (mapv :type events)))
    (is (= ["Hel" "lo"]
           (mapv :delta (filter (fn [event] (= (:type event) :text_delta)) events))))
    (is (= "Hello" (get-in (last events) [:response :message :text])))
    (is (= 5 (get-in (last events) [:usage :total_tokens])))
    (is (= :stop (get-in (last events) [:finish_reason])))))

(deftest test-gemini-stream-normalizes-native-sse
  (let [captured (atom nil)
        sse (str
              "data: {\"responseId\":\"gem-stream\",\"modelVersion\":\"gemini-test\",\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"Hel\"}]}}],\"usageMetadata\":{\"promptTokenCount\":4}}\n\n"
              "data: {\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"lo\"},{\"functionCall\":{\"name\":\"lookup\",\"args\":{\"q\":\"x\"}}}]},\"finishReason\":\"STOP\"}],\"usageMetadata\":{\"promptTokenCount\":4,\"candidatesTokenCount\":2,\"thoughtsTokenCount\":1,\"totalTokenCount\":7}}\n\n")
        events (vec
                 (llm/stream
                   {:provider "gemini" :model "gemini-test" :api_key "key"
                    :messages [{:role :user :content "hello"}]
                    :transport (fn [request]
                                 (reset! captured request)
                                 {:status 200 :body sse})}))
        tool-events (filter (fn [event]
                              (or (= (:type event) :tool_call_start)
                                  (= (:type event) :tool_call_end)))
                            events)]
    (is (str/includes? (:url @captured) ":streamGenerateContent?alt=sse"))
    (is (= :stream (:as @captured)))
    (is (= [:stream_start :text_start :text_delta :text_delta
            :tool_call_start :tool_call_end :text_end :finish]
           (mapv :type events)))
    (is (= ["Hel" "lo"]
           (mapv :delta (filter (fn [event] (= (:type event) :text_delta)) events))))
    (is (= 2 (count tool-events)))
    (is (not (str/blank? (get-in (first tool-events) [:tool_call :id]))))
    (is (= (get-in (first tool-events) [:tool_call :id])
           (get-in (second tool-events) [:tool_call :id])))
    (is (= "Hello" (get-in (last events) [:response :message :text])))
    (is (= 1 (get-in (last events) [:usage :reasoning_tokens])))))

(deftest test-gemini-stream-thought-and-call-state-survive-continuation
  (let [replay-captured (atom nil)
        adapter
        (llm/make-provider-adapter
          "gemini"
          {:api_key "key"
           :transport
           (fn [request]
             (if (= :stream (:as request))
               {:status 200
                :body
                (str "data: {\"responseId\":\"g1\","
                     "\"candidates\":[{\"content\":{\"parts\":["
                     "{\"text\":\"thinking\",\"thought\":true},"
                     "{\"functionCall\":{\"name\":\"lookup\",\"args\":{}}}]},"
                     "\"finishReason\":\"STOP\"}],\"usageMetadata\":{}}\n\n")}
               (do
                 (reset! replay-captured request)
                 {:status 200
                  :body (json/write-json
                          {:responseId "g2" :candidates []
                           :usageMetadata {}})})))})
        client (llm/make-client {:providers {"gemini" adapter}
                                 :default_provider "gemini"})
        events (vec (llm/client-stream
                      client {:model "gemini-test"
                              :messages [{:role :user :content "go"}]}))
        response (:response (last events))
        call-id (get-in response [:tool_calls 0 :id])
        _ (llm/client-complete
            client
            {:model "gemini-test"
             :messages
             [(:message response)
              {:role :tool
               :content [{:kind :tool_result
                          :tool_result {:tool_call_id call-id
                                        :content "ok" :is_error false}}]}]})
        replay (json/read-json (:body @replay-captured))]
    (is (= [:thinking :tool_call]
           (mapv :kind (get-in response [:message :content]))))
    (is (= "lookup"
           (get-in replay
                   ["contents" 1 "parts" 0 "functionResponse" "name"])))))

(deftest test-provider-tool-call-normalization
  (let [openai (llm/normalize-openai-tool-calls
                 [{"id" "call-1"
                   "function" {"name" "read_file"
                               "arguments" "{\"path\":\"README.md\"}"}}])
        anthropic (llm/normalize-anthropic-tool-calls
                    [{"type" "text" "text" "working"}
                     {"type" "tool_use" "id" "call-2"
                      "name" "write_file" "input" {"path" "x" "content" "y"}}])]
    (is (= "read_file" (:name (first openai))))
    (is (= "README.md" (get-in openai [0 :arguments "path"])))
    (is (= "write_file" (:name (first anthropic))))
    (is (= "x" (get-in anthropic [0 :arguments "path"])))))

(deftest test-gemini-native-request-and-response
  (let [captured (atom nil)
        transport (fn [request]
                    (reset! captured request)
                    {:status 200
                     :body (json/write-json
                             {:responseId "gem-1"
                              :modelVersion "gemini-test"
                              :candidates
                              [{:finishReason "STOP"
                                :content {:role "model"
                                          :parts [{:text "Checking"}
                                                  {:functionCall
                                                   {:id "call-1"
                                                    :name "read_file"
                                                    :args {:path "README.md"}}}]}}]
                              :usageMetadata {:promptTokenCount 4
                                              :candidatesTokenCount 2
                                              :totalTokenCount 6
                                              :thoughtsTokenCount 1}})})
        response (llm/gemini-complete
                   {:provider "gemini"
                    :model "gemini-test"
                    :api_key "test-key"
                    :transport transport
                    :messages [{:role :system :content "Be exact"}
                               {:role :user :content "Read it"}]
                    :tools [{:name "read_file"
                             :description "Read a file"
                             :parameters {:type "object"}}]})
        payload (json/read-json (:body @captured))]
    (is (= "https://generativelanguage.googleapis.com/v1beta/models/gemini-test:generateContent"
           (:url @captured)))
    (is (= "test-key" (get-in @captured [:headers "x-goog-api-key"])))
    (is (= "Be exact" (get-in payload ["systemInstruction" "parts" 0 "text"])))
    (is (= "read_file"
           (get-in payload ["tools" 0 "functionDeclarations" 0 "name"])))
    (is (= "Checking" (get-in response [:message :text])))
    (is (= "read_file" (get-in response [:tool_calls 0 :name])))
    (is (= :text (get-in response [:message :parts 0 :kind])))
    (is (= :tool_call (get-in response [:message :parts 1 :kind])))
    (is (= (get-in response [:tool_calls 0 :id])
           (get-in response [:message :parts 1 :tool_call :id])))
    (is (= (get-in response [:message :parts])
           (get-in response [:message :content])))
    (is (= 1 (get-in response [:usage :reasoning_tokens])))
    (is (= :tool_calls (:finish_reason response)))))

(deftest test-anthropic-native-tool-result-round-trip
  (let [captured (atom nil)
        transport (fn [request]
                    (reset! captured request)
                    {:status 200
                     :body (json/write-json
                             {:id "msg-1"
                              :model "claude-test"
                              :stop_reason "end_turn"
                              :content [{:type "text" :text "Done"}]
                              :usage {:input_tokens 5 :output_tokens 1}})})
        response (llm/anthropic-complete
                   {:model "claude-test"
                    :api_key "test-key"
                    :transport transport
                    :messages [{:role :assistant :content ""
                                :tool_calls [{:id "call-1"
                                              :name "read_file"
                                              :arguments {"path" "README.md"}}]}
                               {:role :tool
                                :content [{:tool_call_id "call-1"
                                           :tool_name "read_file"
                                           :content "hello"
                                           :is_error false}]}]})
        payload (json/read-json (:body @captured))]
    (is (= "tool_use" (get-in payload ["messages" 0 "content" 0 "type"])))
    (is (= "tool_result" (get-in payload ["messages" 1 "content" 0 "type"])))
    (is (= "call-1" (get-in payload ["messages" 1 "content" 0 "tool_use_id"])))
    (is (= "Done" (get-in response [:message :text])))
    (is (= :stop (:finish_reason response)))))

(deftest test-anthropic-alternation-thinking-and-prompt-caching
  (let [captured (atom nil)
        response-body
        {:id "msg-thinking"
         :model "claude-test"
         :stop_reason "end_turn"
         :content [{:type "thinking" :thinking "reasoning" :signature "sig-1"}
                   {:type "redacted_thinking" :data "opaque"}
                   {:type "text" :text "answer"}]
         :usage {:input_tokens 5 :output_tokens 8
                 :cache_read_input_tokens 20
                 :cache_creation_input_tokens 10}}
        transport (fn [request]
                    (reset! captured request)
                    {:status 200 :body (json/write-json response-body)})
        response
        (llm/anthropic-complete
          {:model "claude-test" :api_key "key" :transport transport
           :messages
           [{:role :system :content "system"}
            {:role :developer :content "developer"}
            {:role :user :content "first"}
            {:role :user :content "second"}
            {:role :assistant :content "prior"}
            {:role :assistant :content "continued"}
            {:role :tool
             :content [{:tool_call_id "call-1" :tool_name "lookup"
                        :content "result" :is_error false}]}
            {:role :user :content "now finish"}]
           :tools [{:name "lookup" :description "Look up"
                    :parameters {:type "object"}}]})
        payload (json/read-json (:body @captured))
        messages (get payload "messages")
        parts (get-in response [:message :parts])
        replay-captured (atom nil)
        _ (llm/anthropic-complete
            {:model "claude-test" :api_key "key"
             :provider_options {:anthropic {:auto_cache false}}
             :transport (fn [request]
                          (reset! replay-captured request)
                          {:status 200 :body (json/write-json response-body)})
             :messages [{:role :user :content "question"}
                        {:role :assistant :content "answer" :parts parts}
                        {:role :user :content "continue"}]})
        replay-payload (json/read-json (:body @replay-captured))]
    (is (= ["user" "assistant" "user"] (mapv #(get % "role") messages)))
    (is (= ["first" "second"]
           (mapv #(get % "text") (get-in messages [0 "content"]))))
    (is (= ["prior" "continued"]
           (mapv #(get % "text") (get-in messages [1 "content"]))))
    (is (= "ephemeral"
           (get-in messages [1 "content" 1 "cache_control" "type"])))
    (is (= ["tool_result" "text"]
           (mapv #(get % "type") (get-in messages [2 "content"]))))
    (is (= "system\n\ndeveloper"
           (get-in payload ["system" 0 "text"])))
    (is (= "ephemeral" (get-in payload ["system" 0 "cache_control" "type"])))
    (is (= "ephemeral" (get-in payload ["tools" 0 "cache_control" "type"])))
    (is (str/includes? (str (get-in @captured [:headers "anthropic-beta"]))
                       "prompt-caching-2024-07-31"))
    (is (= "reasoning" (:reasoning response)))
    (is (= 3 (get-in response [:usage :reasoning_tokens])))
    (is (= :thinking (get-in response [:message :parts 0 :kind])))
    (is (= "sig-1"
           (get-in response [:message :parts 0 :thinking :signature])))
    (is (= :redacted_thinking (get-in response [:message :parts 1 :kind])))
    (is (= "opaque"
           (get-in response [:message :parts 1 :thinking :data])))
    (is (= parts (get-in response [:message :content])))
    (is (= 20 (get-in response [:usage :cache_read_tokens])))
    (is (= 10 (get-in response [:usage :cache_write_tokens])))
    (is (= "thinking" (get-in replay-payload ["messages" 1 "content" 0 "type"])))
    (is (= "sig-1" (get-in replay-payload ["messages" 1 "content" 0 "signature"])))
    (is (nil? (get replay-payload "auto_cache")))
    (is (nil? (get replay-payload "cache_control")))
    (is (nil? (get-in @replay-captured [:headers "anthropic-beta"])))))

(deftest test-provider-failures-are-not-mock-successes
  (testing "Unknown providers are rejected"
    (is (true?
          (try
            (do (llm/complete {:provider "unknown" :model "x" :messages []}) false)
            (catch Object _ true)))))

  (testing "Provider HTTP failures are raised"
    (let [transport (fn [_] {:status 401 :body "{\"error\":{\"message\":\"bad key\"}}"})]
      (is (true?
            (try
              (do (llm/anthropic-complete
                    {:model "claude-test" :api_key "bad"
                     :transport transport :messages []})
                  false)
              (catch Object _ true))))))

  (testing "Explicitly missing credentials are configuration errors"
    (doseq [call [(fn [] (llm/openai-complete
                           {:model "gpt-test" :api_key "" :messages []}))
                  (fn [] (llm/anthropic-complete
                           {:model "claude-test" :api_key "" :messages []}))
                  (fn [] (llm/gemini-complete
                           {:model "gemini-test" :api_key "" :messages []}))]]
      (is (true? (try (do (call) false) (catch Object _ true)))))))

(deftest test-openai-native-responses-request-and-response
  (let [captured (atom nil)
        transport
        (fn [request]
          (reset! captured request)
          {:status 200
           :body (json/write-json
                   {:id "resp-1"
                    :model "gpt-test"
                    :status "completed"
                    :output
                    [{:id "msg-1" :type "message" :role "assistant"
                      :content [{:type "output_text" :text "I will read it"}]}
                     {:id "fc-1" :type "function_call" :call_id "call-1"
                      :name "read_file" :arguments "{\"path\":\"README.md\"}"}]
                    :usage {:input_tokens 10 :output_tokens 7 :total_tokens 17
                            :input_tokens_details {:cached_tokens 3}
                            :output_tokens_details {:reasoning_tokens 2}}})})
        response
        (llm/openai-complete
          {:model "gpt-test" :api_key "test-key" :transport transport
           :reasoning_effort "high" :max_tokens 123
           :messages
           [{:role :system :content "Be exact"}
            {:role :user
             :content [{:kind :text :text "Read it"}
                       {:kind :image
                        :image {:url "https://example.test/file.png"}}]}
            {:role :assistant :content ""
             :tool_calls [{:id "old-call" :name "directory_list"
                           :arguments {"path" "."}}]}
            {:role :tool
             :content [{:tool_call_id "old-call" :tool_name "directory_list"
                        :content "README.md" :is_error false}]}]
           :tools [{:name "read_file" :description "Read a file"
                    :parameters {:type "object"}}]})
        payload (json/read-json (:body @captured))]
    (is (= "https://api.openai.com/v1/responses" (:url @captured)))
    (is (= "Be exact" (get payload "instructions")))
    (is (= "message" (get-in payload ["input" 0 "type"])))
    (is (= "function_call" (get-in payload ["input" 1 "type"])))
    (is (= "function_call_output" (get-in payload ["input" 2 "type"])))
    (is (= "read_file" (get-in payload ["tools" 0 "name"])))
    (is (= "high" (get-in payload ["reasoning" "effort"])))
    (is (= 123 (get payload "max_output_tokens")))
    (is (= "I will read it" (get-in response [:message :text])))
    (is (= "read_file" (get-in response [:tool_calls 0 :name])))
    (is (= [:text :tool_call]
           (mapv :kind (get-in response [:message :parts]))))
    (is (= [:text :tool_call]
           (mapv :kind (get-in response [:message :content]))))
    (is (= "call-1"
           (get-in response [:message :parts 1 :tool_call :id])))
    (is (= 2 (get-in response [:usage :reasoning_tokens])))
    (is (= 3 (get-in response [:usage :cache_read_tokens])))
    (is (= :tool_calls (:finish_reason response)))))

(deftest test-ollama-uses-openai-compatible-chat-completions
  (let [captured (atom nil)
        transport
        (fn [request]
          (reset! captured request)
          {:status 200
           :body (json/write-json
                   {:id "chatcmpl-1"
                    :model "qwen-test"
                    :choices
                    [{:finish_reason "tool_calls"
                      :message
                      {:role "assistant"
                       :content "Checking"
                       :tool_calls
                       [{:id "call-2" :type "function"
                         :function {:name "read_file"
                                    :arguments "{\"path\":\"README.md\"}"}}]}}]
                    :usage {:prompt_tokens 8 :completion_tokens 3
                            :total_tokens 11}})})
        response
        (llm/complete
          {:provider "ollama" :model "qwen-test"
           :base_url "http://localhost:11434/v1"
           :transport transport
           :messages
           [{:role :system :content "Be exact"}
            {:role :user
             :content [{:kind :text :text "Read it"}
                       {:kind :image
                        :image {:url "https://example.test/file.png"}}]}
            {:role :assistant :content ""
             :tool_calls [{:id "call-1" :name "directory_list"
                           :arguments {"path" "."}}]}
            {:role :tool
             :content [{:tool_call_id "call-1" :tool_name "directory_list"
                        :content "README.md" :is_error false}]}]
           :tools [{:name "read_file" :description "Read a file"
                    :parameters {:type "object"}}]})
        payload (json/read-json (:body @captured))]
    (is (= "http://localhost:11434/v1/chat/completions" (:url @captured)))
    (is (= "messages" (if (some? (get payload "messages")) "messages" "input")))
    (is (= "function" (get-in payload ["tools" 0 "type"])))
    (is (= "https://example.test/file.png"
           (get-in payload
                   ["messages" 1 "content" 1 "image_url" "url"])))
    (is (= "directory_list"
           (get-in payload ["messages" 2 "tool_calls" 0 "function" "name"])))
    (is (= "tool" (get-in payload ["messages" 3 "role"])))
    (is (= "Checking" (get-in response [:message :text])))
    (is (= "read_file" (get-in response [:tool_calls 0 :name])))
    (is (= 8 (get-in response [:usage :input_tokens])))
    (is (= :tool_calls (:finish_reason response)))))
