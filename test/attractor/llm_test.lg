(deftest test-stream-object-resets-partial-state-after-a-tool-call-step
  (let [calls (atom 0)
        schema {:type "object"
                :properties {:name {:type "string"}}
                :required ["name"]}
        adapter
        (llm/make-adapter
          "mock" (fn [_] nil)
          (fn [_]
            (swap! calls inc)
            (if (= 1 @calls)
              [{:type :stream_start}
               {:type :text_delta :delta "calling tool"}
               {:type :tool_call_start
                :tool_call {:id "call-1" :name "lookup" :arguments {}}}
               {:type :tool_call_end
                :tool_call {:id "call-1" :name "lookup" :arguments {}}}
               {:type :finish :finish_reason :tool_calls :usage {}
                :response {:message {:text "calling tool"}
                           :tool_calls [{:id "call-1" :name "lookup"
                                         :arguments {}}]
                           :usage {} :finish_reason :tool_calls}}]
              [{:type :stream_start}
               {:type :text_delta :delta "{\"name\":\"Ad"}
               {:type :text_delta :delta "a\"}"}
               {:type :finish :finish_reason :stop :usage {}
                :response {:message {:text "{\"name\":\"Ada\"}"}
