    (is (= "iVBORw=="
           (get-in (json/read-json (:body @gemini-replay))
                   ["contents" 0 "parts" 0 "inlineData" "data"])))))

(deftest test-audio-and-document-parts-translate-or-fail-explicitly
  (let [captured (atom nil)
        _ (llm/gemini-complete
            {:model "gemini-test" :api_key "key"
             :messages
             [{:role :user
               :content
               [{:kind :audio
                 :audio {:data "WAV" :media_type "audio/wav"}}
                {:kind :document
                 :document {:url "https://example.test/report.pdf"}}]}]
             :transport
             (fn [request]
               (reset! captured request)
               {:status 200
                :body (json/write-json
                        {:responseId "g" :candidates [] :usageMetadata {}})})})
        parts (get-in (json/read-json (:body @captured))
                      ["contents" 0 "parts"])]
    (is (= "audio/wav" (get-in parts [0 "inlineData" "mimeType"])))
    (is (= "V0FW" (get-in parts [0 "inlineData" "data"])))
    (is (= "application/pdf" (get-in parts [1 "fileData" "mimeType"])))
    (doseq [[provider complete message]
            [["openai" llm/openai-complete
              {:kind :document :document {:data "PDF"}}]
             ["anthropic" llm/anthropic-complete
              {:kind :audio :audio {:data "WAV"}}]]]
      (let [error
            (try
              (complete
                {:model "test" :api_key "key"
                 :messages [{:role :user :content [message]}]
                 :transport (fn [_] (throw (ex-info "should not send" {})))})
              nil
              (catch Object e e))]
        (is (= :invalid-request (:category (ex-data error))))
        (is (= provider (:provider (ex-data error))))))))

(deftest test-portable-tool-content-parts-round-trip
  (let [assistant
        {:role :assistant
         :content
         [{:kind :text :text "checking"}
          {:kind :tool_call
           :tool_call {:id "call-9" :name "lookup"
                       :arguments {:query "weather"}}}]}
        tool-result
        {:role :tool
         :content
         [{:kind :tool_result
           :tool_result {:tool_call_id "call-9" :tool_name "lookup"
                         :content "sunny" :is_error false}}]}
        openai-captured (atom nil)
        anthropic-captured (atom nil)
        gemini-captured (atom nil)
        _ (llm/openai-complete
            {:model "gpt-test" :api_key "key"
             :messages [assistant tool-result]
             :transport
             (fn [request]
               (reset! openai-captured request)
               {:status 200
                :body (json/write-json
                        {:id "o" :status "completed" :output [] :usage {}})})})
        _ (llm/anthropic-complete
            {:model "claude-test" :api_key "key"
             :messages [assistant tool-result]
             :transport
             (fn [request]
               (reset! anthropic-captured request)
               {:status 200
                :body (json/write-json
                        {:id "a" :content [] :stop_reason "end_turn" :usage {}})})})
        _ (llm/gemini-complete
            {:model "gemini-test" :api_key "key"
             :messages [assistant tool-result]
             :transport
             (fn [request]
               (reset! gemini-captured request)
               {:status 200
                :body (json/write-json
                        {:responseId "g" :candidates [] :usageMetadata {}})})})
        openai-input (get (json/read-json (:body @openai-captured)) "input")
        anthropic-messages
        (get (json/read-json (:body @anthropic-captured)) "messages")
        gemini-contents
        (get (json/read-json (:body @gemini-captured)) "contents")]
    (is (= ["message" "function_call" "function_call_output"]
           (mapv #(get % "type") openai-input)))
    (is (= "call-9" (get-in openai-input [2 "call_id"])))
    (is (= "tool_use"
           (get-in anthropic-messages [0 "content" 1 "type"])))
    (is (= "tool_result"
           (get-in anthropic-messages [1 "content" 0 "type"])))
    (is (= "lookup"
           (get-in gemini-contents [0 "parts" 1 "functionCall" "name"])))
    (is (= "sunny"
           (get-in gemini-contents
                   [1 "parts" 0 "functionResponse" "response" "result"])))))

(deftest test-gemini-adapter-retains-synthetic-call-name-mapping
  (let [requests (atom [])
        responses
        (atom
          [{:responseId "g1"
            :candidates
            [{:finishReason "STOP"
              :content {:role "model"
                        :parts [{:text "considering" :thought true}
                                {:functionCall
                                 {:name "lookup" :args {:q "x"}}}]}}]
            :usageMetadata {}}
           {:responseId "g2" :candidates [] :usageMetadata {}}])
        adapter
        (llm/make-provider-adapter
          "gemini"
          {:api_key "key"
           :transport
           (fn [request]
             (swap! requests conj request)
             (let [body (first @responses)]
               (swap! responses #(vec (rest %)))
               {:status 200 :body (json/write-json body)}))})
        client (llm/make-client {:providers {"gemini" adapter}
                                 :default_provider "gemini"})
        first-response
        (llm/client-complete client {:model "gemini-test"
                                     :messages [{:role :user :content "go"}]})
        call-id (get-in first-response [:tool_calls 0 :id])
        _ (llm/client-complete
            client
            {:model "gemini-test"
             :messages
             [{:role :assistant
               :content (get-in first-response [:message :parts])}
              {:role :tool
               :content [{:kind :tool_result
                          :tool_result {:tool_call_id call-id
                                        :content "ok"
                                        :is_error false}}]}]})
        replay (json/read-json (:body (second @requests)))]
    (is (str/starts-with? call-id "call_"))
    (is (= true
           (get-in replay ["contents" 0 "parts" 0 "thought"])))
    (is (= "lookup"
           (get-in replay ["contents" 0 "parts" 1 "functionCall" "name"])))
    (is (= "lookup"
           (get-in replay
                   ["contents" 1 "parts" 0 "functionResponse" "name"])))
    (is (nil?
          (get-in replay
                  ["contents" 1 "parts" 0 "functionResponse" "id"])))))

(deftest test-structured-tool-results-use-provider-safe-encoding
  (let [result
        {:role :tool
         :content [{:kind :tool_result
                    :tool_result {:tool_call_id "call-1"
                                  :tool_name "lookup"
                                  :content {:forecast "sunny" :degrees 72}
                                  :image_data (byte-array [137 80 78 71])
                                  :image_media_type "image/png"
                                  :is_error false}}]}
        captures (atom {})
        response-for
        (fn [provider]
          (case provider
            :openai {:id "o" :status "completed" :output [] :usage {}}
            :anthropic {:id "a" :content [] :stop_reason "end_turn" :usage {}}
            {:responseId "g" :candidates [] :usageMetadata {}}))
        transport
        (fn [provider]
          (fn [request]
            (swap! captures assoc provider request)
            {:status 200 :body (json/write-json (response-for provider))}))]
    (llm/openai-complete {:model "gpt" :api_key "key" :messages [result]
                          :transport (transport :openai)})
    (llm/anthropic-complete {:model "claude" :api_key "key" :messages [result]
                             :transport (transport :anthropic)})
    (llm/gemini-complete {:model "gemini" :api_key "key" :messages [result]
                          :transport (transport :gemini)})
    (let [openai-body (json/read-json (:body (:openai @captures)))
          anthropic-body (json/read-json (:body (:anthropic @captures)))
          gemini-body (json/read-json (:body (:gemini @captures)))]
      (is (= "sunny"
             (get (json/read-json
                    (get-in openai-body ["input" 0 "output" 0 "text"]))
                  "forecast")))
      (is (= "data:image/png;base64,iVBORw=="
             (get-in openai-body ["input" 0 "output" 1 "image_url"])))
      (is (= 72
             (get (json/read-json
                    (get-in anthropic-body
                            ["messages" 0 "content" 0 "content" 0 "text"]))
                  "degrees")))
      (is (= "iVBORw=="
             (get-in anthropic-body
                     ["messages" 0 "content" 0 "content" 1 "source" "data"])))
      (is (= "sunny"
             (get-in gemini-body
                     ["contents" 0 "parts" 0 "functionResponse"
                      "response" "forecast"])))
      (is (= "iVBORw=="
             (get-in gemini-body
                     ["contents" 0 "parts" 1 "inlineData" "data"]))))))

(deftest test-structured-response-format-translation
  (let [schema {:type "object"
                :properties {:name {:type "string"}}
                :required ["name"]}
        response-format {:type "json_schema" :json_schema schema :strict true}
        openai-captured (atom nil)
        anthropic-captured (atom nil)
        gemini-captured (atom nil)
        _ (llm/openai-complete
            {:model "gpt-test" :api_key "key" :messages []
             :response_format response-format
             :transport
             (fn [request]
               (reset! openai-captured request)
               {:status 200
                :body (json/write-json
                        {:id "r" :model "gpt-test" :status "completed"
                         :output [] :usage {}})})})
        _ (llm/anthropic-complete
            {:model "claude-test" :api_key "key"
             :messages [{:role :system :content "Be concise"}]
             :response_format response-format
             :transport
             (fn [request]
               (reset! anthropic-captured request)
               {:status 200
                :body (json/write-json
                        {:id "m" :content [] :stop_reason "end_turn"
                         :usage {}})})})
        _ (llm/gemini-complete
            {:model "gemini-test" :api_key "key" :messages []
             :response_format response-format
             :transport
             (fn [request]
               (reset! gemini-captured request)
               {:status 200
                :body (json/write-json
                        {:responseId "g" :candidates [] :usageMetadata {}})})})
        openai-body (json/read-json (:body @openai-captured))
        anthropic-body (json/read-json (:body @anthropic-captured))
        gemini-body (json/read-json (:body @gemini-captured))]
    (is (= "json_schema" (get-in openai-body ["text" "format" "type"])))
    (is (= true (get-in openai-body ["text" "format" "strict"])))
    (is (str/includes? (get-in anthropic-body ["system" 0 "text"])
                       "required"))
    (is (= "application/json"
           (get-in gemini-body ["generationConfig" "responseMimeType"])))
    (is (= ["name"]
           (get-in gemini-body ["generationConfig" "responseSchema" "required"])))))

(deftest test-provider-tool-choice-translation
  (let [tool {:name "lookup" :description "Look up a value"
              :parameters {:type "object"}}
        openai-captured (atom nil)
        anthropic-captured (atom nil)
        anthropic-none-captured (atom nil)
        gemini-captured (atom nil)
        _ (llm/openai-complete
            {:model "gpt-test" :api_key "key" :messages [] :tools [tool]
             :tool_choice {:mode "named" :tool_name "lookup"}
             :transport
             (fn [request]
               (reset! openai-captured request)
               {:status 200
                :body (json/write-json
                        {:id "r" :status "completed" :output [] :usage {}})})})
        _ (llm/anthropic-complete
            {:model "claude-test" :api_key "key" :messages [] :tools [tool]
             :tool_choice {:mode "required"}
             :transport
             (fn [request]
               (reset! anthropic-captured request)
               {:status 200
                :body (json/write-json
                        {:id "a" :content [] :stop_reason "end_turn" :usage {}})})})
        _ (llm/anthropic-complete
            {:model "claude-test" :api_key "key" :messages [] :tools [tool]
             :tool_choice {:mode "none"}
             :transport
             (fn [request]
               (reset! anthropic-none-captured request)
               {:status 200
                :body (json/write-json
                        {:id "a2" :content [] :stop_reason "end_turn" :usage {}})})})
        _ (llm/gemini-complete
            {:model "gemini-test" :api_key "key" :messages [] :tools [tool]
             :tool_choice {:mode "named" :tool_name "lookup"}
             :transport
             (fn [request]
               (reset! gemini-captured request)
               {:status 200
                :body (json/write-json
                        {:responseId "g" :candidates [] :usageMetadata {}})})})
        openai-body (json/read-json (:body @openai-captured))
        anthropic-body (json/read-json (:body @anthropic-captured))
        anthropic-none-body (json/read-json (:body @anthropic-none-captured))
        gemini-body (json/read-json (:body @gemini-captured))]
    (is (= "function" (get-in openai-body ["tool_choice" "type"])))
    (is (= "lookup"
           (get-in openai-body ["tool_choice" "function" "name"])))
    (is (= "any" (get-in anthropic-body ["tool_choice" "type"])))
    (is (nil? (get anthropic-none-body "tools")))
    (is (nil? (get anthropic-none-body "tool_choice")))
    (is (= "ANY"
           (get-in gemini-body
                   ["toolConfig" "functionCallingConfig" "mode"])))
    (is (= ["lookup"]
           (get-in gemini-body
                   ["toolConfig" "functionCallingConfig"
                    "allowedFunctionNames"])))))

(deftest test-tool-definition-validates-portable-name-and-schema
  (let [execute (fn [_] "ok")
        tool (llm/make-tool "lookup_weather" "Look up weather"
                            {:type "object" :properties {}}
                            execute)]
    (is (= "lookup_weather" (:name tool)))
    (is (= execute (:execute tool)))
    (doseq [[name schema]
            [["9invalid" {:type "object"}]
             ["contains-dash" {:type "object"}]
             [(apply str (repeat 65 "a")) {:type "object"}]
             ["valid_name" {:type "array"}]]]
      (is (true?
            (try
              (do (llm/make-tool name "bad" schema) false)
              (catch Object _ true)))))))

(deftest test-generate-object-parses-and-validates-schema
  (let [schema {:type "object"
                :properties {:name {:type "string"} :age {:type "integer"}}
                :required ["name" "age"]}
        handler (fn [request]
                  {:id "mock-object"
                   :model (:model request)
                   :provider "mock"
                   :message {:role :assistant
                             :content "{\"name\":\"Alice\",\"age\":30}"}
                   :tool_calls []
                   :usage {:input_tokens 2 :output_tokens 4 :total_tokens 6}
                   :finish_reason :stop})
        result (llm/generate-object "mock/test" "Extract the person" schema
                                    {:mock_handler handler})]
    (is (= "Alice" (get-in result [:output "name"])))
    (is (= 30 (get-in result [:output "age"])))
    (is (= 6 (get-in result [:total_usage :total_tokens])))
    (is (true?
          (try
            (do (llm/generate-object
                  "mock/test" "bad" schema
                  {:mock_handler
                   (fn [request]
                     {:model (:model request) :provider "mock"
                      :message {:role :assistant :content "{\"name\":\"Alice\"}"}
                      :usage {} :finish_reason :stop})})
                false)
            (catch Object _ true))))))

(deftest test-client-routes-default-and-explicit-providers
  (let [calls (atom [])
        adapter (fn [provider]
                  (llm/make-adapter
                    provider
                    (fn [request]
                      (swap! calls conj [provider (:model request)])
                      {:provider provider :model (:model request)
                       :message {:role :assistant :content provider}
                       :tool_calls [] :usage {} :finish_reason :stop})
                    (fn [_] [])))
        client (llm/make-client
                 {:providers {"alpha" (adapter "alpha")
                              "beta" (adapter "beta")}
                  :default_provider "alpha"})]
    (is (= "alpha" (:provider (llm/client-complete
                                client {:model "native-model" :messages []}))))
    (is (= "beta" (:provider (llm/client-complete
                               client {:provider "beta"
                                       :model "other-model" :messages []}))))
    (is (= [["alpha" "native-model"] ["beta" "other-model"]] @calls))
    (is (true?
          (try
            (do (llm/client-complete (llm/make-client {:providers {}})
                                     {:model "ambiguous" :messages []})
                false)
            (catch Object _ true))))))

(deftest test-client-middleware-uses-onion-order
  (let [events (atom [])
        middleware
        [(fn [request next]
           (swap! events conj :one-before)
           (let [response (next request)]
             (swap! events conj :one-after)
             response))
         (fn [request next]
           (swap! events conj :two-before)
           (let [response (next request)]
             (swap! events conj :two-after)
             response))]
        adapter (llm/make-adapter
                  "mock"
                  (fn [_]
                    (swap! events conj :adapter)
                    {:provider "mock" :message {:content "ok"}
                     :tool_calls [] :usage {} :finish_reason :stop})
                  (fn [_] [{:type :finish}]))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"
                                 :middleware middleware})]
    (llm/client-complete client {:model "test" :messages []})
    (is (= [:one-before :two-before :adapter :two-after :one-after]
           @events))))

(deftest test-client-middleware-wraps-streams
  (let [adapter (llm/make-adapter
                  "mock" (fn [_] {})
                  (fn [_] [{:type :text_delta :delta "hi"}]))
        middleware (fn [request next]
                     (map (fn [event] (assoc event :observed true))
                          (next request)))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"
                                 :middleware [middleware]})
        events (vec (llm/client-stream client {:model "test" :messages []}))]
    (is (= "hi" (:delta (first events))))
    (is (true? (:observed (first events))))))

(deftest test-stream-accumulator-builds-a-response
  (let [acc (llm/make-stream-accumulator)]
    (llm/stream-accumulator-process! acc {:type :stream_start})
    (llm/stream-accumulator-process!
      acc {:type :text_delta :delta "Hel"})
    (is (= "Hel"
           (get-in (llm/stream-accumulator-response acc)
                   [:message :text])))
    (llm/stream-accumulator-process!
      acc {:type :finish
           :response {:id "done" :message {:text "Hello"}
                      :usage {:total_tokens 3}
                      :finish_reason :stop}})
    (is (= "done" (:id (llm/stream-accumulator-response acc))))))

(deftest test-stream-accumulator-includes-partial-tool-calls
  (let [acc (llm/make-stream-accumulator)
        call {:id "call-1" :name "lookup" :arguments {}}]
    (llm/stream-accumulator-process! acc {:type :stream_start})
    (llm/stream-accumulator-process!
      acc {:type :tool_call_start :tool_call call})
    (llm/stream-accumulator-process!
      acc {:type :tool_call_delta
           :tool_call (assoc call :arguments "{\"q\":")})
    (is (= "{\"q\":"
           (get-in (llm/stream-accumulator-response acc)
                   [:tool_calls 0 :arguments])))
    (llm/stream-accumulator-process!
      acc {:type :tool_call_end
           :tool_call (assoc call :arguments {"q" "x"})})
    (let [response (llm/stream-accumulator-response acc)]
      (is (= {"q" "x"} (get-in response [:tool_calls 0 :arguments])))
      (is (= :tool_call
             (get-in response [:message :content 0 :kind]))))))

(deftest test-high-level-stream-exposes-events-text-and-final-response
  (let [adapter
        (llm/make-adapter
          "mock"
          (fn [_] nil)
          (fn [_]
            [{:type :stream_start}
             {:type :text_start :text_id "text"}
             {:type :text_delta :text_id "text" :delta "Hi"}
             {:type :text_end :text_id "text"}
             {:type :finish :finish_reason :stop :usage {}
              :response {:id "response" :message {:text "Hi"}
                         :tool_calls [] :usage {}
                         :finish_reason :stop}}]))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result (llm/stream "mock/model" "hello" {:client client})
        events (vec (:events result))]
    (is (= [:stream_start :text_start :text_delta :text_end :finish]
           (mapv :type events)))
    (is (= ["Hi"] (vec (:text_stream result))))
    (is (= "Hi" (get-in ((:response result)) [:message :text])))))

(deftest test-high-level-stream-executes-tools-between-streaming-steps
  (let [requests (atom [])
        executions (atom [])
        adapter
        (llm/make-adapter
          "mock"
          (fn [_] nil)
          (fn [request]
            (swap! requests conj request)
            (if (= 1 (count @requests))
              [{:type :stream_start}
               {:type :tool_call_start
                :tool_call {:id "call-1" :name "lookup"
                            :arguments {"q" "x"}}}
               {:type :tool_call_end
                :tool_call {:id "call-1" :name "lookup"
                            :arguments {"q" "x"}}}
               {:type :finish :finish_reason :tool_calls :usage {}
                :response
                {:message {:role :assistant :content ""}
                 :tool_calls [{:id "call-1" :name "lookup"
                               :arguments {"q" "x"}}]
                 :usage {} :finish_reason :tool_calls}}]
              [{:type :stream_start}
               {:type :text_start :text_id "text"}
               {:type :text_delta :text_id "text" :delta "done"}
               {:type :text_end :text_id "text"}
               {:type :finish :finish_reason :stop :usage {}
                :response {:message {:text "done"}
                           :tool_calls [] :usage {}
                           :finish_reason :stop}}])))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        tool {:name "lookup"
              :parameters {:type "object"
                           :properties {"q" {:type "string"}}
                           :required ["q"]}
              :execute (fn [args]
                         (swap! executions conj args)
                         "found")}
        result (llm/stream "mock/model" "go"
                           {:client client :tools [tool]
                            :max_tool_rounds 1})
        events (vec (:events result))]
    (is (= 2 (count @requests)))
    (is (= [{"q" "x"}] @executions))
    (is (= 1 (count (filter #(= :step_finish (:type %)) events))))
    (is (= :tool (get-in @requests [1 :messages 2 :role])))
    (is (= "done" (get-in ((:response result)) [:message :text])))))

(deftest test-high-level-stream-retries-failure-before-first-event
  (let [attempts (atom 0)
        adapter
        (llm/make-adapter
          "mock" (fn [_] nil)
          (fn [_]
            (let [attempt (swap! attempts inc)]
              (if (= attempt 1)
                (lazy-seq
                  (throw (ex-info "connect failed" {:retryable true})))
                [{:type :stream_start}
                 {:type :finish :finish_reason :stop :usage {}
                  :response {:message {:text "ok"}
                             :tool_calls [] :usage {}
                             :finish_reason :stop}}]))))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result (llm/stream
                 "mock/model" "go"
                 {:client client :max_retries 1
                  :retry_policy {:sleep_fn (fn [_] nil)}})
        events (vec (:events result))]
    (is (= 2 @attempts))
    (is (= [:stream_start :finish] (mapv :type events)))))

(deftest test-high-level-stream-emits-error-after-partial-delivery
  (let [attempts (atom 0)
        adapter
        (llm/make-adapter
          "mock" (fn [_] nil)
          (fn [_]
            (swap! attempts inc)
            (lazy-seq
              (cons {:type :text_delta :delta "partial"}
                    (lazy-seq
                      (throw (ex-info "stream read timed out"
                                      {:category :request-timeout
                                       :retryable false})))))))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result (llm/stream
                 "mock/model" "go"
                 {:client client :max_retries 2
                  :retry_policy {:sleep_fn (fn [_] nil)}})
        events (vec (:events result))]
    (is (= 1 @attempts))
    (is (= [:text_delta :error] (mapv :type events)))
    (is (= :request-timeout
           (:category (ex-data (:error (second events))))))
    (is (= "partial"
           (get-in ((:partial_response result)) [:message :text])))))

(deftest test-stream-object-yields-growing-partials-and-validates-final-object
  (let [captured (atom nil)
        schema {:type "object"
                :properties
                {:recipes
                 {:type "array"
                  :items {:type "object"
                          :properties {:name {:type "string"}}
                          :required ["name"]}}}
                :required ["recipes"]}
        adapter
        (llm/make-adapter
          "mock" (fn [_] nil)
          (fn [request]
            (reset! captured request)
            [{:type :stream_start}
             {:type :text_delta
              :delta "{\"recipes\":[{\"name\":\"Soup\""}
             {:type :text_delta
              :delta "},{\"name\":\"Pie\""}
             {:type :text_delta :delta "}]}"}
             {:type :finish :finish_reason :stop :usage {}
              :response
              {:message {:text
                         "{\"recipes\":[{\"name\":\"Soup\"},{\"name\":\"Pie\"}]}"}
               :tool_calls [] :usage {} :finish_reason :stop}}]))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result (llm/stream-object "mock/model" "recipes" schema
                                  {:client client})
        partials (vec (:objects result))]
    (is (= [1 2] (mapv #(count (get % "recipes")) partials)))
    (is (= {"recipes" [{"name" "Soup"} {"name" "Pie"}]}
           ((:object result))))
    (is (= "json_schema"
           (get-in @captured [:response_format :type])))
    (is (= schema
           (get-in @captured [:response_format :json_schema])))))

