                                 :default_provider "mock"})
        result (llm/stream "mock/model" "go" {:client client})]
    ((:close result))
    (is (= [] (vec (:events result))))
    (is (= 0 @calls))))

(deftest test-total-timeout-closes-an-idle-stream
  (let [closed (atom false)
        adapter
        (llm/make-adapter
          "mock" (fn [_] nil)
          (fn [request]
            ((:register_stream_close request)
             (fn [] (reset! closed true)))
            [{:type :stream_start} {:type :text_delta :delta "later"}]))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        events (:events
                 (llm/stream "mock/model" "go"
                             {:client client :timeout 0.01}))]
    (is (= :stream_start (:type (first events))))
    (core/sleep 25)
