                  :response {:message {:text "late"}
                             :tool_calls [] :usage {}
                             :finish_reason :stop}}])))
          client (llm/make-client {:providers {"mock" adapter}
                                   :default_provider "mock"})]
      (is (= :request-timeout
             (try
               (do (doall (:events
                            (llm/stream "mock/model" "go"
                                        {:client client
                                         :timeout {:per_step 0.03}})))
                   nil)
               (catch Object error (:category (ex-data error)))))))))

(deftest test-total-timeout-bounds-tool-execution-and-retry-delay
  (let [calls (atom 0)
        adapter
        (llm/make-adapter
          "mock"
          (fn [_]
            (swap! calls inc)
            {:provider "mock" :message {:role :assistant :content ""}
             :tool_calls [{:id "slow" :name "slow_tool" :arguments {}}]
             :usage {} :finish_reason :tool_calls})
          (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        started (System/currentTimeMillis)
        error
        (try
          (do
            (llm/generate
              "mock/model" "go"
              {:client client :timeout 0.01 :max_tool_rounds 1
               :tools [{:name "slow_tool" :parameters {:type "object"}
                        :execute (fn [_] (core/sleep 100) "done")}]})
            nil)
          (catch Object error error))]
    (is (= :request-timeout (:category (ex-data error))))
    (is (= :total (:scope (ex-data error))))
    (is (< (- (System/currentTimeMillis) started) 80)))
  (let [attempts (atom 0)
        adapter
        (llm/make-adapter
          "mock"
          (fn [_]
            (swap! attempts inc)
            (throw (ex-info "again" {:retryable true})))
          (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})]
    (is (= :request-timeout
           (try
             (do (llm/generate "mock/model" "go"
                               {:client client :timeout {:total 0.01}
                                :retry_policy {:base_delay 1.0 :jitter false}})
                 nil)
             (catch Object error (:category (ex-data error))))))
    (is (= 1 @attempts))))

(deftest test-cancellation-is-forwarded-to-the-active-adapter
