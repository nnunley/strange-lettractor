(ns attractor.llm-test
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.string :as str]
            [clojure.core :as core]
            [json :as json]
            [attractor.llm :as llm]))

(deftest test-model-catalog-supports-provider-capability-and-alias-lookups
  (is (= "claude-opus-4-6" (:id (llm/get-model-info "opus"))))
  (is (= "gpt-5.2" (:id (llm/get-latest-model "openai" "reasoning"))))
  (is (every? #(= "gemini" (:provider %)) (llm/list-models "gemini")))
  (is (> (count (llm/list-models)) 5))
  (is (nil? (llm/get-model-info "future-model-not-yet-cataloged"))))

(deftest test-provider-errors-have-portable-taxonomy-and-retry-after
  (let [error
        (try
          (llm/openai-complete
            {:model "gpt-test" :api_key "bad" :messages []
             :transport
             (fn [_]
               {:status 429 :headers {"retry-after" "2.5"}
                :body "{\"error\":{\"code\":\"rate_limit\",\"message\":\"slow down\"}}"})})
          nil
          (catch Object e e))
        data (ex-data error)]
    (is (= :rate-limit (:category data)))
    (is (true? (:retryable data)))
    (is (= 429 (:status_code data)))
    (is (= "rate_limit" (:error_code data)))
    (is (= 2.5 (:retry_after data))))
  (let [error
        (try
          (llm/gemini-complete
            {:model "gemini-test" :api_key "bad" :messages []
             :transport
             (fn [_]
               {:status 400
                :body "{\"error\":{\"status\":\"UNAUTHENTICATED\",\"message\":\"bad\"}}"})})
          nil
          (catch Object e e))]
    (is (= :authentication (:category (ex-data error))))
    (is (false? (:retryable (ex-data error))))))

(deftest test-retry-policy-honors-backoff-and-retry-after
  (let [calls (atom 0)
        delays (atom [])
        callbacks (atom [])
        result
        (llm/retry
          (fn []
            (if (< (swap! calls inc) 3)
              (throw (ex-info "temporary" {:retryable true}))
              :ok))
          {:max_retries 2 :base_delay 1.0 :backoff_multiplier 2.0
           :max_delay 10.0 :jitter false
           :sleep_fn (fn [delay] (swap! delays conj delay))
           :on_retry (fn [_ attempt delay]
                       (swap! callbacks conj [attempt delay]))})]
    (is (= :ok result))
    (is (= [1.0 2.0] @delays))
    (is (= [[1 1.0] [2 2.0]] @callbacks)))
  (let [calls (atom 0)
        error (try
                (llm/retry
                  (fn []
                    (swap! calls inc)
                    (throw (ex-info "wait too long"
                                    {:retryable true :retry_after 90.0})))
                  {:max_retries 2 :max_delay 60.0
                   :sleep_fn (fn [_] nil)})
                nil
                (catch Object e e))]
    (is (= 1 @calls))
    (is (= 90.0 (:retry_after (ex-data error))))))

(deftest test-generate-retries-each-llm-step-without-reexecuting-tools
  (let [llm-calls (atom 0)
        tool-calls (atom 0)
        adapter
        (llm/make-adapter
          "mock"
          (fn [_]
            (let [call (swap! llm-calls inc)]
              (case call
                1 (throw (ex-info "first transient" {:retryable true}))
                2 {:provider "mock" :message {:role :assistant :content ""}
                   :tool_calls [{:id "call-1" :name "work" :arguments {}}]
                   :usage {} :finish_reason :tool_calls}
                3 (throw (ex-info "second transient" {:retryable true}))
                {:provider "mock" :message {:role :assistant :content "done"}
                 :tool_calls [] :usage {} :finish_reason :stop})))
          (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result
        (llm/generate
          "model" "prompt"
          {:client client :max_tool_rounds 1
           :retry_policy {:max_retries 1 :base_delay 0.0 :jitter false
                          :sleep_fn (fn [_] nil)}
           :tools [{:name "work" :parameters {:type "object"}
                    :execute (fn [_] (swap! tool-calls inc) "ok")}]})]
    (is (= "done" (:text result)))
    (is (= 4 @llm-calls))
    (is (= 1 @tool-calls)))
  (let [calls (atom 0)
        error (try
                (llm/retry
                  (fn []
                    (swap! calls inc)
                    (throw (ex-info "bad request" {:retryable false})))
                  {:max_retries 3 :sleep_fn (fn [_] nil)})
                nil
                (catch Object e e))]
    (is (= 1 @calls))
    (is (= "bad request" (ex-message error)))))

(deftest test-openai-url-resolution
  (testing "Resolves default OpenAI URL when unset"
    (is (= "https://api.openai.com/v1/responses"
           (llm/resolve-openai-url nil))))

  (testing "Appends /responses when omitted"
    (is (= "https://my-proxy.com/v1/responses"
           (llm/resolve-openai-url "https://my-proxy.com/v1"))))

  (testing "Handles trailing slash properly"
    (is (= "https://my-proxy.com/v1/responses"
           (llm/resolve-openai-url "https://my-proxy.com/v1/"))))

  (testing "Preserves full endpoint path when already present"
    (is (= "https://my-proxy.com/v1/responses"
           (llm/resolve-openai-url "https://my-proxy.com/v1/responses")))))

(deftest test-anthropic-url-resolution
  (testing "Resolves default Anthropic URL when unset"
    (is (= "https://api.anthropic.com/v1/messages"
           (llm/resolve-anthropic-url nil))))

  (testing "Appends /messages when omitted"
    (is (= "https://my-proxy.com/v1/messages"
           (llm/resolve-anthropic-url "https://my-proxy.com/v1")))))

(deftest test-provider-detection
  (is (= "openai" (llm/detect-provider "gpt-4o")))
  (is (= "openai" (llm/detect-provider "o1-preview")))
  (is (= "openai" (llm/detect-provider "o3-mini")))
  (is (= "anthropic" (llm/detect-provider "claude-3-7-sonnet")))
  (is (= "gemini" (llm/detect-provider "gemini-2.5-pro")))
  (is (= "mock" (llm/detect-provider "local-test-model"))))

(deftest test-litellm-provider-model-convention
  (testing "Parses provider/model format (LiteLLM convention)"
    (is (= {:provider "ollama" :model "qwen3.5:397b"}
           (llm/parse-model-spec "ollama/qwen3.5:397b")))
    (is (= {:provider "ollama" :model "deepseek-v4-pro:0813"}
           (llm/parse-model-spec "ollama/deepseek-v4-pro:0813")))
    (is (= {:provider "anthropic" :model "claude-3-7-sonnet"}
           (llm/parse-model-spec "anthropic/claude-3-7-sonnet")))
    (is (= {:provider "openai" :model "gpt-4o"}
           (llm/parse-model-spec "openai/gpt-4o")))
    (is (= {:provider "gemini" :model "gemini-2.5-pro"}
           (llm/parse-model-spec "gemini/gemini-2.5-pro"))))

  (testing "Handles un-prefixed models using auto-detection or explicit provider"
    (is (= {:provider "openai" :model "gpt-4o"}
           (llm/parse-model-spec "gpt-4o")))
    (is (= {:provider "anthropic" :model "claude-3-5-haiku"}
           (llm/parse-model-spec "claude-3-5-haiku")))
    (is (= {:provider "ollama" :model "custom-llama"}
           (llm/parse-model-spec "custom-llama" "ollama")))))

(deftest test-request-omits-unspecified-generation-settings
  (let [request (llm/make-request "openai/gpt-test"
                                  [{:role :user :content "hello"}])]
    (is (= "openai" (:provider request)))
    (is (= "gpt-test" (:model request)))
    (is (nil? (:temperature request)))
    (is (nil? (:max_tokens request)))
    (is (nil? (:reasoning_effort request)))))

(deftest test-portable-generation-settings-translate-across-providers
  (let [captures (atom {})
        settings {:temperature 0.25
                  :top_p 0.8
                  :max_tokens 321
                  :stop_sequences ["END" "STOP"]}
        transport
        (fn [provider response]
          (fn [request]
            (swap! captures assoc provider request)
            {:status 200 :body (json/write-json response)}))
        _ (llm/openai-complete
            (merge settings
                   {:model "gpt-test" :api_key "key" :messages []
                    :transport
                    (transport :openai
                               {:id "o" :status "completed"
                                :output [] :usage {}})}))
        _ (llm/anthropic-complete
            (merge settings
                   {:model "claude-test" :api_key "key" :messages []
                    :transport
                    (transport :anthropic
                               {:id "a" :content [] :stop_reason "end_turn"
                                :usage {}})}))
        _ (llm/gemini-complete
            (merge settings
                   {:model "gemini-test" :api_key "key" :messages []
                    :transport
                    (transport :gemini
                               {:responseId "g" :candidates []
                                :usageMetadata {}})}))
        _ (llm/openai-compatible-complete
            (merge settings
                   {:provider "ollama" :model "local-test" :messages []
                    :transport
                    (transport :compatible
                               {:id "c" :model "local-test"
                                :choices [{:message {:content "ok"}
                                           :finish_reason "stop"}]
                                :usage {}})}))
        openai (json/read-json (:body (:openai @captures)))
        anthropic (json/read-json (:body (:anthropic @captures)))
        gemini (json/read-json (:body (:gemini @captures)))
        compatible (json/read-json (:body (:compatible @captures)))]
    (is (= 0.25 (get openai "temperature")))
    (is (= 0.8 (get openai "top_p")))
    (is (= 321 (get openai "max_output_tokens")))
    (is (= 0.25 (get anthropic "temperature")))
    (is (= 0.8 (get anthropic "top_p")))
    (is (= 321 (get anthropic "max_tokens")))
    (is (= ["END" "STOP"] (get anthropic "stop_sequences")))
    (is (= 0.25 (get-in gemini ["generationConfig" "temperature"])))
    (is (= 0.8 (get-in gemini ["generationConfig" "topP"])))
    (is (= 321 (get-in gemini ["generationConfig" "maxOutputTokens"])))
    (is (= ["END" "STOP"]
           (get-in gemini ["generationConfig" "stopSequences"])))
    (is (= 0.25 (get compatible "temperature")))
    (is (= 0.8 (get compatible "top_p")))
    (is (= 321 (get compatible "max_tokens")))
    (is (= ["END" "STOP"] (get compatible "stop")))))

(deftest test-reasoning-effort-translates-across-native-providers
  (let [captures (atom {})
        transport
        (fn [provider response]
          (fn [request]
            (swap! captures assoc provider request)
            {:status 200 :body (json/write-json response)}))]
    (llm/openai-complete
      {:model "gpt-test" :api_key "key" :messages []
       :reasoning_effort "high"
       :transport (transport :openai
                             {:id "o" :status "completed"
                              :output [] :usage {}})})
    (llm/anthropic-complete
      {:model "claude-test" :api_key "key" :messages []
       :reasoning_effort "high"
       :transport (transport :anthropic
                             {:id "a" :content [] :stop_reason "end_turn"
                              :usage {}})})
    (llm/gemini-complete
      {:model "gemini-3-test" :api_key "key" :messages []
       :reasoning_effort "high"
       :transport (transport :gemini
                             {:responseId "g" :candidates []
                              :usageMetadata {}})})
    (let [openai (json/read-json (:body (:openai @captures)))
          anthropic-request (:anthropic @captures)
          anthropic (json/read-json (:body anthropic-request))
          gemini (json/read-json (:body (:gemini @captures)))]
      (is (= "high" (get-in openai ["reasoning" "effort"])))
      (is (= {"type" "enabled" "budget_tokens" 3072}
             (get anthropic "thinking")))
      (is (= 4096 (get anthropic "max_tokens")))
      (is (str/includes?
            (get-in anthropic-request [:headers "anthropic-beta"])
            "interleaved-thinking-2025-05-14"))
      (is (= "high"
             (get-in gemini
                     ["generationConfig" "thinkingConfig"
                      "thinkingLevel"]))))))

(deftest test-explicit-thinking-options-override-portable-reasoning-effort
  (let [captures (atom {})
        transport
        (fn [provider response]
          (fn [request]
            (swap! captures assoc provider request)
            {:status 200 :body (json/write-json response)}))]
    (llm/anthropic-complete
      {:model "claude-test" :api_key "key" :messages []
       :reasoning_effort "low"
       :provider_options
       {:anthropic {:thinking {:type "enabled" :budget_tokens 1500}}}
       :transport (transport :anthropic
                             {:id "a" :content [] :stop_reason "end_turn"
                              :usage {}})})
    (llm/gemini-complete
      {:model "gemini-3-test" :api_key "key" :messages []
       :reasoning_effort "low"
       :provider_options
       {:gemini {:generationConfig
                 {:thinkingConfig {:thinkingLevel "medium"}}}}
       :transport (transport :gemini
                             {:responseId "g" :candidates []
                              :usageMetadata {}})})
    (is (= 1500
           (get-in (json/read-json (:body (:anthropic @captures)))
                   ["thinking" "budget_tokens"])))
    (is (= "medium"
           (get-in (json/read-json (:body (:gemini @captures)))
                   ["generationConfig" "thinkingConfig"
                    "thinkingLevel"])))))

(deftest test-anthropic-validates-final-merged-thinking-budget
  (let [response {:status 200
                  :body (json/write-json
                          {:id "a" :content [] :stop_reason "end_turn"
                           :usage {}})}
        capture (atom nil)
        valid
        (llm/anthropic-complete
          {:model "claude" :api_key "key" :messages []
           :provider_options
           {:anthropic {:max_tokens 6000
                        :thinking {:type "enabled" :budget_tokens 5000}}}
           :transport (fn [request] (reset! capture request) response)})]
    (is (= 6000
           (get (json/read-json (:body @capture)) "max_tokens")))
    (is (= "a" (:id valid)))
    (doseq [options
            [{:reasoning_effort "high"
              :provider_options {:anthropic {:max_tokens 1000}}}
             {:provider_options
              {:anthropic
               {:thinking {:type "enabled" :budget_tokens 5000}}}}]]
      (is (= :invalid-request
             (try
               (do (llm/anthropic-complete
                     (merge {:model "claude" :api_key "key" :messages []}
                            options))
                   nil)
               (catch Object error (:category (ex-data error)))))))))

(deftest test-native-adapters-reject-invalid-reasoning-effort
  (doseq [call [(fn [] (llm/openai-complete
                         {:model "gpt" :api_key "key" :messages []
                          :reasoning_effort "enormous"}))
                (fn [] (llm/anthropic-complete
                         {:model "claude" :api_key "key" :messages []
                          :reasoning_effort "enormous"}))
                (fn [] (llm/gemini-complete
                         {:model "gemini" :api_key "key" :messages []
                          :reasoning_effort "enormous"}))]]
    (is (= :invalid-reasoning-effort
           (try (do (call) nil)
                (catch Object error (:category (ex-data error))))))))

(deftest test-adapters-omit-unset-generation-settings
  (let [captures (atom {})
        transport
        (fn [provider response]
          (fn [request]
            (swap! captures assoc provider request)
            {:status 200 :body (json/write-json response)}))
        _ (llm/openai-complete
            {:model "gpt-test" :api_key "key" :messages []
             :transport
             (transport :openai {:id "o" :status "completed"
                                 :output [] :usage {}})})
        _ (llm/anthropic-complete
            {:model "claude-test" :api_key "key" :messages []
             :transport
             (transport :anthropic {:id "a" :content []
                                    :stop_reason "end_turn" :usage {}})})
        _ (llm/gemini-complete
            {:model "gemini-test" :api_key "key" :messages []
             :transport
             (transport :gemini {:responseId "g" :candidates []
                                 :usageMetadata {}})})
        _ (llm/openai-compatible-complete
            {:provider "ollama" :model "local-test" :messages []
             :transport
             (transport :compatible
                        {:id "c" :choices [{:message {:content "ok"}
                                            :finish_reason "stop"}]
                         :usage {}})})
        openai (json/read-json (:body (:openai @captures)))
        anthropic (json/read-json (:body (:anthropic @captures)))
        gemini (json/read-json (:body (:gemini @captures)))
        compatible (json/read-json (:body (:compatible @captures)))]
    (doseq [field-name ["temperature" "top_p" "max_output_tokens"
                        "metadata"]]
      (is (nil? (get openai field-name))))
    (is (= 4096 (get anthropic "max_tokens")))
    (doseq [field-name ["temperature" "top_p" "stop_sequences" "metadata"]]
      (is (nil? (get anthropic field-name))))
    (is (nil? (get gemini "generationConfig")))
    (doseq [field-name ["temperature" "top_p" "max_tokens" "stop"]]
      (is (nil? (get compatible field-name))))))

(deftest test-high-level-generate-forwards-portable-generation-settings
  (let [captured (atom nil)
        adapter
        (llm/make-adapter
          "openai"
          (fn [request]
            (reset! captured request)
            {:id "r" :model (:model request) :provider "openai"
             :message {:role :assistant :content [] :text "ok"}
             :tool_calls [] :usage {} :finish_reason :stop
             :warnings []})
          nil)
        client (llm/make-client {:providers {"openai" adapter}})
        settings {:temperature 0.1 :top_p 0.7 :max_tokens 222
                  :stop_sequences ["DONE"]}
        _ (llm/generate "gpt-test" "hello"
                        (merge settings {:provider "openai" :client client}))]
    (is (= settings
           (select-keys @captured
                        [:temperature :top_p :max_tokens :stop_sequences])))))

(deftest test-provider-options-override-portable-generation-settings
  (let [captures (atom {})
        transport
        (fn [provider response]
          (fn [request]
            (swap! captures assoc provider request)
            {:status 200 :body (json/write-json response)}))
        _ (llm/openai-complete
            {:model "gpt-test" :api_key "key" :messages []
             :temperature 0.1
             :provider_options {"openai" {"temperature" 0.9}}
             :transport
             (transport :openai {:id "o" :status "completed"
                                 :output [] :usage {}})})
        _ (llm/anthropic-complete
            {:model "claude-test" :api_key "key" :messages []
             :temperature 0.1
             :provider_options {"anthropic" {"temperature" 0.9}}
             :transport
             (transport :anthropic {:id "a" :content []
                                    :stop_reason "end_turn" :usage {}})})
        _ (llm/gemini-complete
            {:model "gemini-test" :api_key "key" :messages []
             :temperature 0.1 :top_p 0.7 :max_tokens 222
             :response_format {:type "json_schema"
                               :json_schema {:type "object"}}
             :provider_options
             {"gemini" {"generationConfig" {"temperature" 0.9}}}
             :transport
             (transport :gemini {:responseId "g" :candidates []
                                 :usageMetadata {}})})
        _ (llm/openai-compatible-complete
            {:provider "ollama" :model "local-test" :messages []
             :temperature 0.1
             :provider_options {"ollama" {"temperature" 0.9}}
             :transport
             (transport :compatible
                        {:id "c" :choices [{:message {:content "ok"}
                                            :finish_reason "stop"}]
                         :usage {}})})
        openai (json/read-json (:body (:openai @captures)))
        anthropic (json/read-json (:body (:anthropic @captures)))
        gemini (json/read-json (:body (:gemini @captures)))
        compatible (json/read-json (:body (:compatible @captures)))]
    (is (= 0.9 (get openai "temperature")))
    (is (= 1 (count (re-seq #"\"temperature\":"
                             (:body (:openai @captures))))))
    (is (= 0.9 (get anthropic "temperature")))
    (is (= 1 (count (re-seq #"\"temperature\":"
                             (:body (:anthropic @captures))))))
    (is (= 0.9 (get-in gemini ["generationConfig" "temperature"])))
    (is (= 0.7 (get-in gemini ["generationConfig" "topP"])))
    (is (= 222 (get-in gemini ["generationConfig" "maxOutputTokens"])))
    (is (= "application/json"
           (get-in gemini ["generationConfig" "responseMimeType"])))
    (is (= "object"
           (get-in gemini ["generationConfig" "responseSchema" "type"])))
    (is (= 0.9 (get compatible "temperature")))))

(deftest test-unsupported-portable-fields-produce-response-warnings
  (let [captures (atom {})
        transport
        (fn [provider response]
          (fn [request]
            (swap! captures assoc provider request)
            {:status 200 :body (json/write-json response)}))
        openai-response
        (llm/openai-complete
          {:model "gpt-test" :api_key "key" :messages []
           :stop_sequences ["END"] :metadata {:trace_id "trace-1"}
           :transport
           (transport :openai {:id "o" :status "completed"
                               :output [] :usage {}})})
        anthropic-response
        (llm/anthropic-complete
          {:model "claude-test" :api_key "key" :messages []
           :metadata {:user_id "opaque-user" :trace_id "trace-1"}
           :transport
           (transport :anthropic {:id "a" :content []
                                  :stop_reason "end_turn" :usage {}})})
        gemini-response
        (llm/gemini-complete
          {:model "gemini-test" :api_key "key" :messages []
           :metadata {:trace_id "trace-1"}
           :transport
           (transport :gemini {:responseId "g" :candidates []
                               :usageMetadata {}})})
        openai-body (json/read-json (:body (:openai @captures)))
        anthropic-body (json/read-json (:body (:anthropic @captures)))
        gemini-body (json/read-json (:body (:gemini @captures)))]
    (is (= "trace-1" (get-in openai-body ["metadata" "trace_id"])))
    (is (nil? (get openai-body "stop")))
    (is (= "unsupported_parameter"
           (get-in openai-response [:warnings 0 :code])))
    (is (= "opaque-user"
           (get-in anthropic-body ["metadata" "user_id"])))
    (is (nil? (get-in anthropic-body ["metadata" "trace_id"])))
    (is (= "unsupported_parameter"
           (get-in anthropic-response [:warnings 0 :code])))
    (is (nil? (get gemini-body "metadata")))
    (is (= "unsupported_parameter"
           (get-in gemini-response [:warnings 0 :code])))))

(deftest test-mock-provider-uses-canonical-content-parts
  (let [response
        (llm/complete
          {:provider "mock" :model "mock-test"
           :messages [{:role :user
                       :content [{:kind :text :text "hello"}]}]})]
    (is (= :text (get-in response [:message :content 0 :kind])))
    (is (str/includes? (llm/response-text response) "hello"))))

(deftest test-provider-options-pass-through
  (let [openai-captured (atom nil)
        anthropic-captured (atom nil)
        gemini-captured (atom nil)
        _ (llm/openai-complete
            {:model "gpt-test" :api_key "key"
             :messages [{:role :user :content "hello"}]
             :provider_options
             {:openai {:metadata {:trace_id "trace-1"}
                       :service_tier "flex"}}
             :transport
             (fn [request]
               (reset! openai-captured request)
               {:status 200
                :body (json/write-json
                        {:id "r" :model "gpt-test" :status "completed"
                         :output [] :usage {}})})})
        _ (llm/anthropic-complete
            {:model "claude-test" :api_key "key" :messages []
             :provider_options
             {:anthropic {:beta_headers ["feature-a" "feature-b"]
                          :thinking {:type "enabled" :budget_tokens 128}}}
             :transport
             (fn [request]
               (reset! anthropic-captured request)
               {:status 200
                :body (json/write-json
                        {:id "m" :content [] :stop_reason "end_turn"
                         :usage {}})})})
        _ (llm/gemini-complete
            {:model "gemini-test" :api_key "key" :messages []
             :provider_options
             {:gemini {:cachedContent "cachedContents/1"
                       :safetySettings [{:category "HARM_CATEGORY_HATE_SPEECH"
                                         :threshold "BLOCK_NONE"}]}}
             :transport
             (fn [request]
               (reset! gemini-captured request)
               {:status 200
                :body (json/write-json
                        {:responseId "g" :candidates [] :usageMetadata {}})})})
        openai-body (json/read-json (:body @openai-captured))
        anthropic-body (json/read-json (:body @anthropic-captured))
        gemini-body (json/read-json (:body @gemini-captured))]
    (is (= "trace-1" (get-in openai-body ["metadata" "trace_id"])))
    (is (= "flex" (get openai-body "service_tier")))
    (is (str/includes?
          (get-in @anthropic-captured [:headers "anthropic-beta"])
          "feature-a,feature-b"))
    (is (str/includes?
          (get-in @anthropic-captured [:headers "anthropic-beta"])
          "prompt-caching-2024-07-31"))
    (is (= 128 (get-in anthropic-body ["thinking" "budget_tokens"])))
    (is (= "cachedContents/1" (get gemini-body "cachedContent")))
    (is (= "BLOCK_NONE"
           (get-in gemini-body ["safetySettings" 0 "threshold"])))))

(deftest test-multimodal-image-parts-translate-across-native-providers
  (let [messages
        [{:role :system
          :content [{:kind :text :text "Analyze precisely"}]}
         {:role :developer
          :content [{:kind :text :text "Follow policy"}]}
         {:role :user
          :content
          [{:kind :text :text "Describe these images"}
           {:kind :image
            :image {:url "https://example.test/chart.png"
                    :media_type "image/png" :detail "high"}}
           {:kind :image
            :image {:data (byte-array [137 80 78 71])
                    :media_type "image/png"}}]}]
        openai-captured (atom nil)
        anthropic-captured (atom nil)
        gemini-captured (atom nil)
        complete-response
        (fn [provider]
          (case provider
            :openai {:id "o" :status "completed" :output [] :usage {}}
            :anthropic {:id "a" :content [] :stop_reason "end_turn" :usage {}}
            {:responseId "g" :candidates [] :usageMetadata {}}))
        _ (llm/openai-complete
            {:model "gpt-test" :api_key "key" :messages messages
             :transport (fn [request]
                          (reset! openai-captured request)
                          {:status 200
                           :body (json/write-json (complete-response :openai))})})
        _ (llm/anthropic-complete
            {:model "claude-test" :api_key "key" :messages messages
             :transport (fn [request]
                          (reset! anthropic-captured request)
                          {:status 200
                           :body (json/write-json (complete-response :anthropic))})})
        _ (llm/gemini-complete
            {:model "gemini-test" :api_key "key" :messages messages
             :transport (fn [request]
                          (reset! gemini-captured request)
                          {:status 200
                           :body (json/write-json (complete-response :gemini))})})
        openai-content
        (get-in (json/read-json (:body @openai-captured)) ["input" 0 "content"])
        anthropic-content
        (get-in (json/read-json (:body @anthropic-captured)) ["messages" 0 "content"])
        gemini-parts
        (get-in (json/read-json (:body @gemini-captured)) ["contents" 0 "parts"])]
    (is (= "Analyze precisely\n\nFollow policy"
           (get (json/read-json (:body @openai-captured)) "instructions")))
    (is (= "Analyze precisely\n\nFollow policy"
           (get-in (json/read-json (:body @anthropic-captured))
                   ["system" 0 "text"])))
    (is (= "Analyze precisely\n\nFollow policy"
           (get-in (json/read-json (:body @gemini-captured))
                   ["systemInstruction" "parts" 0 "text"])))
    (is (= {"type" "input_text" "text" "Describe these images"}
           (get openai-content 0)))
    (is (= {"type" "input_image"
            "image_url" "https://example.test/chart.png"
            "detail" "high"}
           (get openai-content 1)))
    (is (= "data:image/png;base64,iVBORw=="
           (get-in openai-content [2 "image_url"])))
    (is (= {"type" "url" "url" "https://example.test/chart.png"}
           (get-in anthropic-content [1 "source"])))
    (is (= {"type" "base64" "media_type" "image/png"
            "data" "iVBORw=="}
           (get-in anthropic-content [2 "source"])))
    (is (= {"mimeType" "image/png"
            "fileUri" "https://example.test/chart.png"}
           (get-in gemini-parts [1 "fileData"])))
    (is (= {"mimeType" "image/png" "data" "iVBORw=="}
           (get-in gemini-parts [2 "inlineData"])))))

(deftest test-local-image-path-is-inlined-and-mime-type-is-inferred
  (let [path (str "/tmp/strange-lettractor-image-" (random-uuid) ".png")
        captured (atom nil)]
    (spit path (byte-array [0 255]))
    (try
      (llm/gemini-complete
        {:model "gemini-test" :api_key "key"
         :messages [{:role :user
                     :content [{:kind :image :image {:url path}}]}]
         :transport
         (fn [request]
           (reset! captured request)
           {:status 200
            :body (json/write-json
                    {:responseId "g" :candidates [] :usageMetadata {}})})})
      (let [inline-data
            (get-in (json/read-json (:body @captured))
                    ["contents" 0 "parts" 0 "inlineData"])]
        (is (= "image/png" (get inline-data "mimeType")))
        (is (= "AP8=" (get inline-data "data"))))
      (finally
        (delete-file path)))))

(deftest test-binary-content-requires-exactly-one-source
  (doseq [image [{:url "https://example.test/x.png" :data "PNG"}
                 {}]]
    (let [error
          (try
            (llm/openai-complete
              {:model "gpt" :api_key "key"
               :messages [{:role :user
                           :content [{:kind :image :image image}]}]
               :transport (fn [_] (throw (ex-info "network called" {})))})
            nil
            (catch Object e e))]
      (is (= :invalid-request (:category (ex-data error))))
      (is (= :image (:content_kind (ex-data error)))))))

(deftest test-provider-specific-content-parts-replay-verbatim
  (let [openai-captured (atom nil)
        anthropic-captured (atom nil)
        gemini-captured (atom nil)
        send
        (fn [complete model part capture response]
          (complete
            {:model model :api_key "key"
             :messages [{:role :assistant
                         :content [{:kind :provider_content
                                    :provider_data part}]}]
             :transport
             (fn [request]
               (reset! capture request)
               {:status 200 :body (json/write-json response)})}))]
    (send llm/openai-complete "gpt"
          {"type" "refusal" "refusal" "cannot"}
          openai-captured
          {:id "o" :status "completed" :output [] :usage {}})
    (send llm/anthropic-complete "claude"
          {"type" "server_tool_use" "name" "search"}
          anthropic-captured
          {:id "a" :content [] :stop_reason "end_turn" :usage {}})
    (send llm/gemini-complete "gemini"
          {"executableCode" {"language" "PYTHON" "code" "1+1"}}
          gemini-captured
          {:responseId "g" :candidates [] :usageMetadata {}})
    (is (= "cannot"
           (get-in (json/read-json (:body @openai-captured))
                   ["input" 0 "content" 0 "refusal"])))
    (is (= "search"
           (get-in (json/read-json (:body @anthropic-captured))
                   ["messages" 0 "content" 0 "name"])))
    (is (= "1+1"
           (get-in (json/read-json (:body @gemini-captured))
                   ["contents" 0 "parts" 0 "executableCode" "code"])))))

(deftest test-openai-top-level-provider-items-replay-at-top-level
  (let [first-response
        (llm/openai-complete
          {:model "gpt" :api_key "key" :messages []
           :transport
           (fn [_]
             {:status 200
              :body (json/write-json
                      {:id "o1" :status "completed" :usage {}
                       :output [{:type "computer_call" :id "computer-1"
                                 :action {:type "screenshot"}}]})})})
        captured (atom nil)
        _ (llm/openai-complete
            {:model "gpt" :api_key "key"
             :messages [(:message first-response)]
