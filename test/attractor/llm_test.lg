           :tools [{:name "lookup" :parameters {:type "object"}
                    :execute (fn [_] "done")}]} )
        partials (vec (:objects result))]
    (is (= 2 @calls))
    (is (= {"name" "Ad"} (first partials)))
    (is (= {"name" "Ada"} ((:object result))))))

(deftest test-high-level-apis-honor-abort-signals
  (let [complete-calls (atom 0)
        stream-closed (atom false)
        controller (llm/make-abort-controller)
        adapter
        (llm/make-adapter
          "mock"
          (fn [_]
            (swap! complete-calls inc)
            {:provider "mock" :message {:role :assistant :content "late"}
             :tool_calls [] :usage {} :finish_reason :stop})
          (fn [request]
            ((:register_stream_close request)
             (fn [] (reset! stream-closed true)))
            [{:type :stream_start}
             {:type :text_delta :delta "late"}
             {:type :finish :finish_reason :stop :usage {}
              :response {:message {:text "late"}
                         :tool_calls [] :usage {} :finish_reason :stop}}]))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})]
    ((:abort controller))
    (is (true?
          (try
            (do (llm/generate "mock/model" "go"
                              {:client client
                               :abort_signal (:signal controller)})
                false)
            (catch Object error
              (= :abort (:category (ex-data error)))))))
    (is (= 0 @complete-calls))
    (let [live-controller (llm/make-abort-controller)
          result (llm/stream "mock/model" "go"
                             {:client client
                              :abort_signal (:signal live-controller)})
          events (:events result)]
      (is (= :stream_start (:type (first events))))
      ((:abort live-controller))
      (core/sleep 20)
      (is (true? @stream-closed))
      (is (true?
            (try
              (do (doall (rest events)) false)
              (catch Object error
                (= :abort (:category (ex-data error))))))))))

(deftest test-stream-close-is-terminal-before-first-realization
  (let [calls (atom 0)
