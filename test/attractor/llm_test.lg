             (do (doall (rest events)) nil)
             (catch Object error (:category (ex-data error))))))))

(deftest test-high-level-apis-enforce-per-step-timeouts
  (let [adapter
        (llm/make-adapter
          "mock"
          (fn [_]
            (core/sleep 50)
            {:provider "mock" :message {:role :assistant :content "late"}
             :tool_calls [] :usage {} :finish_reason :stop})
          (fn [_]
            (core/sleep 50)
            [{:type :stream_start}]))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})]
    (doseq [operation
            [(fn [] (llm/generate "mock/model" "go"
                                  {:client client
                                   :timeout {:per_step 0.005}}))
             (fn [] (doall (:events
                             (llm/stream "mock/model" "go"
                                         {:client client
                                          :timeout {:per_step 0.005}}))))]]
      (is (true?
            (try
              (do (operation) false)
               (catch Object error
                 (= :request-timeout (:category (ex-data error))))))))))

(deftest test-stream-per-step-timeout-covers-the-whole-provider-call
