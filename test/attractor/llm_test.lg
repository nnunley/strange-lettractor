    (is (= :request-timeout
           (try
             (do (doall (:events
                          (llm/stream "mock/model" "go"
                                      {:client client
                                       :timeout {:per_step 0.005}})))
                 nil)
             (catch Object error (:category (ex-data error))))))
    (core/sleep 40)
    (is (true? @closed))))

(deftest test-stream-closes-failed-attempt-before-retry
  (let [attempts (atom 0)
        closed (atom [])
        adapter
        (llm/make-adapter
          "mock" (fn [_] nil)
          (fn [request]
            (let [attempt (swap! attempts inc)]
              ((:register_stream_close request)
               (fn [] (swap! closed conj attempt)))
              (if (= attempt 1)
                (lazy-seq
                  (throw (ex-info "connect failed" {:retryable true})))
                [{:type :stream_start}]))))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})]
    (is (= [:stream_start]
           (mapv :type
                 (:events
                   (llm/stream
                     "mock/model" "go"
                     {:client client
                      :retry_policy {:sleep_fn (fn [_] nil)}})))))
    (is (= 2 @attempts))
    (is (= [1 2] @closed))))

(deftest test-stream-closes-terminal-pre-first-event-failures
  (doseq [[max-retries retryable expected-attempts]
          [[2 false 1] [1 true 2]]]
    (let [attempts (atom 0)
          closed (atom [])
          adapter
          (llm/make-adapter
            "mock" (fn [_] nil)
            (fn [request]
              (let [attempt (swap! attempts inc)]
                ((:register_stream_close request)
                 (fn [] (swap! closed conj attempt)))
                (lazy-seq
                  (throw (ex-info "open failed" {:retryable retryable}))))))
          client (llm/make-client {:providers {"mock" adapter}
                                   :default_provider "mock"})]
      (is (= "open failed"
             (try
               (do (doall (:events
                            (llm/stream
                              "mock/model" "go"
                              {:client client :max_retries max-retries
                               :retry_policy {:sleep_fn (fn [_] nil)}})))
                   nil)
               (catch Object error (ex-message error)))))
      (is (= expected-attempts @attempts))
      (is (= (vec (range 1 (inc expected-attempts))) @closed)))))

(deftest test-json-schema-validation-distinguishes-presence-and-enforces-constraints
  (let [object-schema
        {:type "object"
         :properties
         {:enabled {:type "boolean"}
          :nothing {:type "null"}
          :name {:type "string" :minLength 2 :pattern "^[A-Z]"}
          :score {:type "number" :minimum 1 :maximum 10}
          :kind {:type "string" :enum ["a" "b"]}
          :tags {:type "array" :minItems 1 :uniqueItems true}}
         :required ["enabled" "nothing" "name" "score" "kind"]
         :additionalProperties false}
        valid {"enabled" false "nothing" nil "name" "Ada"
               "score" 5 "kind" "a" "tags" ["x"]}]
    (is (true? (first (llm/validate-json-schema valid object-schema))))
    (is (false?
          (first
            (llm/validate-json-schema
              3 {:type "integer" :minimum 5
                 :allOf [{:type "integer" :maximum 10}]}))))
    (is (true?
          (first
            (llm/validate-json-schema
              0.3 {:type "number" :multipleOf 0.1}))))
    (is (true?
          (first (llm/validate-json-schema 1.0 {:type "integer"}))))
    (is (false?
          (first (llm/validate-json-schema 1.5 {:type "integer"}))))
    (is (true?
          (first
            (llm/validate-json-schema
              {"count" 2}
              {:type :object :properties {:count {:type :integer}}}))))
    (is (false?
          (first
            (llm/validate-json-schema
              {"count" "not-an-integer"}
              {:type :object :properties {:count {:type :integer}}}))))
    (is (false?
          (first
            (llm/validate-json-schema
              0.31 {:type "number" :multipleOf 0.1}))))
    (is (false?
          (first
            (llm/validate-json-schema
              1000000000.25 {:type "number" :multipleOf 1}))))
    (is (true?
          (first
            (llm/validate-json-schema
              {"next" {"next" nil}}
              {:type "object"
               :properties
               {:next {:anyOf [{:$ref "#"} {:type "null"}]}}
               :required ["next"]}))))
    (is (true?
          (first
            (llm/validate-json-schema
              3
              {:$ref "#/$defs/choices/1"
               :$defs {:choices [{:type "string"}
                                  {:type "integer" :minimum 2}]}}))))
    (doseq [invalid
            [(assoc valid "enabled" "false")
             (assoc valid "name" nil)
             (assoc valid "name" "a")
             (assoc valid "name" "lower")
             (assoc valid "score" 0)
             (assoc valid "score" 11)
             (assoc valid "kind" "c")
             (assoc valid "tags" [])
             (assoc valid "tags" ["x" "x"])
             (assoc valid "extra" true)]]
      (is (false? (first (llm/validate-json-schema invalid object-schema)))))))

(deftest test-client-initializes-and-closes-adapters
  (let [events (atom [])
        adapter (llm/make-adapter
                  "mock" (fn [_] {}) (fn [_] [])
                  {:initialize (fn [] (swap! events conj :initialize))
                   :close (fn [] (swap! events conj :close))})
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})]
    (is (= [:initialize] @events))
    (llm/client-close! client)
    (is (= [:initialize :close] @events))))

(deftest test-client-from-env-registers-only-configured-providers
  (let [client (llm/client-from-env
                 {"OPENAI_API_KEY" "openai-key"
                  "GOOGLE_API_KEY" "google-key"})]
    (is (= #{"openai" "gemini"} (set (keys (:providers client)))))
    (is (= "openai" (:default_provider client)))
    (is (= "google-key"
           (get-in client [:providers "gemini" :options :api_key])))))

(deftest test-high-level-generate-standardizes-input-and-result
  (let [captured (atom nil)
        adapter (llm/make-adapter
                  "mock"
                  (fn [request]
                    (reset! captured request)
                    {:id "response-1" :provider "mock" :model (:model request)
                     :message {:role :assistant :content "Hello"}
                     :reasoning "because"
                     :tool_calls []
                     :usage {:input_tokens 2 :output_tokens 1 :total_tokens 3}
                     :finish_reason :stop})
                  (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result (llm/generate "native-model" "Hi"
                             {:system "Be kind" :client client})]
    (is (= [{:role :system :content "Be kind"}
            {:role :user :content "Hi"}]
           (:messages @captured)))
    (is (= "Hello" (:text result)))
    (is (= "because" (:reasoning result)))
    (is (= 3 (get-in result [:total_usage :total_tokens])))
    (is (= 1 (count (:steps result))))
    (is (= "response-1" (get-in result [:response :id])))
    (is (= "Hello"
           (:text (llm/generate
                    "native-model" nil
                    {:messages [{:role :user :content "From history"}]
                     :client client}))))
    (is (= [{:role :user :content "From history"}] (:messages @captured)))
    (is (true?
          (try
            (do (llm/generate "native-model" nil
                              {:messages [{:role :user :content "Hi"}]
                               :prompt "also hi" :client client})
                false)
            (catch Object _ true))))))

(deftest test-generate-executes-active-tools-and-aggregates-steps
  (let [requests (atom [])
        tool-arguments (atom [])
        adapter
        (llm/make-adapter
          "mock"
          (fn [request]
            (swap! requests conj request)
            (if (= 1 (count @requests))
              {:id "step-1" :provider "mock" :model (:model request)
               :message {:role :assistant :content "Checking"}
               :tool_calls [{:id "call-1" :name "lookup"
                             :arguments {"query" "weather"}}]
               :usage {:input_tokens 2 :output_tokens 1 :total_tokens 3}
               :finish_reason :tool_calls}
              {:id "step-2" :provider "mock" :model (:model request)
               :message {:role :assistant :content "Sunny"}
               :tool_calls []
               :usage {:input_tokens 4 :output_tokens 2 :total_tokens 6}
               :finish_reason :stop}))
          (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result
        (llm/generate
          "native-model" "What is the weather?"
          {:client client :max_tool_rounds 2
           :tools [{:name "lookup" :description "Look up weather"
                    :parameters {:type "object"}
                    :execute (fn [arguments]
                               (swap! tool-arguments conj arguments)
                               {:forecast "sunny"})}]})]
    (is (= [{"query" "weather"}] @tool-arguments))
    (is (= 2 (count @requests)))
    (is (= "Sunny" (:text result)))
    (is (= 9 (get-in result [:total_usage :total_tokens])))
    (is (= 2 (count (:steps result))))
    (is (= {:forecast "sunny"}
           (get-in result [:steps 0 :tool_results 0 :content])))
    (is (= :assistant (get-in @requests [1 :messages 1 :role])))
    (is (= :tool (get-in @requests [1 :messages 2 :role])))
    (is (= "call-1"
           (get-in @requests [1 :messages 2 :content 0 :tool_call_id])))))

(deftest test-generate-does-not-execute-passive-tools-or-exceed-budget
  (let [calls (atom 0)
        executions (atom 0)
        adapter
        (llm/make-adapter
          "mock"
          (fn [request]
            (swap! calls inc)
            {:provider "mock" :model (:model request)
             :message {:role :assistant :content ""}
             :tool_calls [{:id "call-1" :name "lookup" :arguments {}}]
             :usage {} :finish_reason :tool_calls})
          (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})]
    (llm/generate "model" "prompt"
                  {:client client :max_tool_rounds 3
                   :tools [{:name "lookup" :parameters {:type "object"}}]})
    (is (= 1 @calls))
    (llm/generate "model" "prompt"
                  {:client client :max_tool_rounds 0
                   :tools [{:name "lookup" :parameters {:type "object"}
                            :execute (fn [_] (swap! executions inc))}]})
    (is (= 2 @calls))
    (is (= 0 @executions))))

(deftest test-generate-returns-tool-errors-to-model
  (let [requests (atom [])
        adapter
        (llm/make-adapter
          "mock"
          (fn [request]
            (swap! requests conj request)
            (if (= 1 (count @requests))
              {:provider "mock" :message {:role :assistant :content ""}
               :tool_calls [{:id "bad-1" :name "missing" :arguments {}}]
               :usage {} :finish_reason :tool_calls}
              {:provider "mock" :message {:role :assistant :content "recovered"}
               :tool_calls [] :usage {} :finish_reason :stop}))
          (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result (llm/generate "model" "prompt"
                             {:client client :max_tool_rounds 1 :tools []})]
    (is (= "recovered" (:text result)))
    (is (true? (get-in result [:steps 0 :tool_results 0 :is_error])))
    (is (str/includes?
          (get-in result [:steps 0 :tool_results 0 :content])
          "Unknown tool"))))

(deftest test-generate-validates-tool-arguments-before-execution
  (let [executed (atom false)
        requests (atom 0)
        adapter
        (llm/make-adapter
          "mock"
          (fn [_]
            (swap! requests inc)
            (if (= 1 @requests)
              {:provider "mock" :message {:role :assistant :content ""}
               :tool_calls [{:id "bad-args" :name "lookup" :arguments {}}]
               :usage {} :finish_reason :tool_calls}
              {:provider "mock" :message {:role :assistant :content "fixed"}
               :tool_calls [] :usage {} :finish_reason :stop}))
          (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result
        (llm/generate
          "model" "prompt"
          {:client client :max_tool_rounds 1
           :tools [{:name "lookup"
                    :parameters {:type "object"
                                 :properties {:query {:type "string"}}
                                 :required ["query"]}
                    :execute (fn [_] (reset! executed true))}]})]
    (is (false? @executed))
    (is (true? (get-in result [:steps 0 :tool_results 0 :is_error])))
    (is (str/includes? (get-in result [:steps 0 :tool_results 0 :content])
                       "Missing required property"))))

(deftest test-generate-executes-parallel-tools-concurrently-in-order
  (let [started (atom 0)
        gate (promise)
        requests (atom 0)
        handler (fn [arguments]
                  (let [count-started (swap! started inc)]
                    (when (= count-started 2) (deliver gate :go))
                    (if (= :go (deref gate 1000 :timeout))
                      (get arguments "value")
                      :did-not-overlap)))
        adapter
        (llm/make-adapter
          "mock"
          (fn [_]
            (swap! requests inc)
            (if (= 1 @requests)
              {:provider "mock" :message {:role :assistant :content ""}
               :tool_calls [{:id "a" :name "first"
                             :arguments {"value" "one"}}
                            {:id "b" :name "second"
                             :arguments {"value" "two"}}]
               :usage {} :finish_reason :tool_calls}
              {:provider "mock" :message {:role :assistant :content "done"}
               :tool_calls [] :usage {} :finish_reason :stop}))
          (fn [_] []))
        client (llm/make-client {:providers {"mock" adapter}
                                 :default_provider "mock"})
        result
        (llm/generate
          "model" "prompt"
          {:client client :max_tool_rounds 1
           :tools [{:name "first" :parameters {:type "object"} :execute handler}
                   {:name "second" :parameters {:type "object"} :execute handler}]})]
    (is (= 2 @started))
    (is (= ["one" "two"]
           (mapv :content (get-in result [:steps 0 :tool_results]))))))

(deftest test-openai-stream-normalizes-responses-sse
  (let [captured (atom nil)
        sse (str
              "event: response.created\n"
              "data: {\"type\":\"response.created\",\"response\":{\"id\":\"resp-stream\"}}\n\n"
              "event: response.output_item.added\n"
              "data: {\"type\":\"response.output_item.added\",\"item\":{\"id\":\"msg-1\",\"type\":\"message\",\"content\":[]}}\n\n"
              "event: response.content_part.added\n"
              "data: {\"type\":\"response.content_part.added\",\"item_id\":\"msg-1\",\"part\":{\"type\":\"output_text\",\"text\":\"\"}}\n\n"
              "event: response.output_text.delta\n"
              "data: {\"type\":\"response.output_text.delta\",\"item_id\":\"msg-1\",\"delta\":\"Hel\"}\n\n"
              "event: response.output_text.delta\n"
              "data: {\"type\":\"response.output_text.delta\",\"item_id\":\"msg-1\",\"delta\":\"lo\"}\n\n"
              "event: response.output_text.done\n"
              "data: {\"type\":\"response.output_text.done\",\"item_id\":\"msg-1\",\"text\":\"Hello\"}\n\n"
              "event: response.completed\n"
              "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp-stream\",\"model\":\"gpt-test\",\"status\":\"completed\",\"output\":[{\"type\":\"message\",\"content\":[{\"type\":\"output_text\",\"text\":\"Hello\"}]}],\"usage\":{\"input_tokens\":2,\"output_tokens\":1,\"total_tokens\":3}}}")
        events (vec
                 (llm/stream
                   {:provider "openai" :model "gpt-test" :api_key "key"
                    :messages [{:role :user :content "hello"}]
                    :transport (fn [request]
                                 (reset! captured request)
                                 {:status 200 :body sse})}))]
    (is (= true (get (json/read-json (:body @captured)) "stream")))
    (is (= :stream (:as @captured)))
    (is (= [:stream_start :text_start :text_delta :text_delta :text_end :finish]
           (mapv :type events)))
    (is (= ["Hel" "lo"]
           (mapv :delta (filter (fn [event] (= (:type event) :text_delta)) events))))
    (is (= "Hello" (get-in (last events) [:response :message :text])))
    (is (= 3 (get-in (last events) [:usage :total_tokens])))))

(deftest test-openai-compatible-stream-normalizes-chat-completions-sse
  (let [captured (atom nil)
        sse (str
              "data: {\"id\":\"chat-stream\",\"model\":\"local-test\",\"choices\":[{\"delta\":{\"role\":\"assistant\"},\"finish_reason\":null}]}\n\n"
              "data: {\"choices\":[{\"delta\":{\"content\":\"Hel\"},\"finish_reason\":null}]}\n\n"
              "data: {\"choices\":[{\"delta\":{\"content\":\"lo\"},\"finish_reason\":null}]}\n\n"
              "data: {\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"call-1\",\"type\":\"function\",\"function\":{\"name\":\"lookup\",\"arguments\":\"{\\\"q\\\":\\\"\"}}]},\"finish_reason\":null}]}\n\n"
              "data: {\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"function\":{\"arguments\":\"x\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}]}\n\n"
              "data: {\"choices\":[],\"usage\":{\"prompt_tokens\":3,\"completion_tokens\":2,\"total_tokens\":5}}\n\n"
              "data: [DONE]\n\n")
        events
        (vec
          (llm/stream
            {:provider "ollama" :model "local-test" :messages []
             :temperature 0.2 :top_p 0.6 :max_tokens 111
             :stop_sequences ["END"]
             :transport (fn [request]
                          (reset! captured request)
                          {:status 200 :body sse})}))
        payload (json/read-json (:body @captured))
        finish (last events)
        configured-captured (atom nil)
        adapter
        (llm/make-provider-adapter
          "ollama"
          {:transport (fn [request]
                        (reset! configured-captured request)
                        {:status 200 :body sse})})
        client (llm/make-client {:providers {"ollama" adapter}})
        configured-events
        (vec (llm/client-stream client
                                {:provider "ollama" :model "local-test"
                                 :messages []}))]
    (is (= :stream (:as @captured)))
    (is (= true (get payload "stream")))
    (is (= 0.2 (get payload "temperature")))
    (is (= 0.6 (get payload "top_p")))
    (is (= 111 (get payload "max_tokens")))
    (is (= ["END"] (get payload "stop")))
    (is (= [:stream_start :text_start :text_delta :text_delta
            :tool_call_start :tool_call_delta :text_end :tool_call_end :finish]
           (mapv :type events)))
    (is (= "Hello" (get-in finish [:response :message :text])))
    (is (= {"q" "x"}
           (get-in finish [:response :tool_calls 0 :arguments])))
    (is (= 5 (get-in finish [:usage :total_tokens])))
    (is (= :tool_calls (:finish_reason finish)))
    (is (= :stream (:as @configured-captured)))
    (is (= :finish (:type (last configured-events))))))

(deftest test-openai-compatible-stream-surfaces-midstream-errors
  (let [sse (str
              "data: {\"id\":\"chat-stream\",\"choices\":[{\"delta\":{\"content\":\"partial\"},\"finish_reason\":null}]}\n\n"
              "data: {\"error\":{\"code\":\"server_error\",\"message\":\"failed\"}}\n\n"
              "data: {\"choices\":[{\"delta\":{\"content\":\"ignored\"},\"finish_reason\":null}]}\n\n"
              "data: {\"error\":{\"code\":\"server_error\",\"message\":\"duplicate\"}}\n\n"
              "data: [DONE]\n\n")
        events
        (vec
          (llm/openai-compatible-stream
            {:provider "ollama" :model "local-test" :messages []
             :transport (fn [_] {:status 200 :body sse})}))]
    (is (= [:stream_start :text_start :text_delta :error]
           (mapv :type events)))
    (is (= "partial" (:delta (nth events 2))))
    (is (= "server_error" (get-in (last events) [:error "code"])))
    (is (empty? (filter (fn [event] (= :finish (:type event))) events)))))

(deftest test-sse-parser-handles-multiline-retry-comments-and-eof
  (let [events (vec
                 (llm/parse-sse-lines
                   [": keepalive"
                    "event: update"
                    "retry: 1500"
                    "data: first"
                    "data: second"]))]
    (is (= 1 (count events)))
    (is (= "update" (:event (first events))))
    (is (= 1500 (:retry (first events))))
    (is (= "first\nsecond" (:data (first events))))))

