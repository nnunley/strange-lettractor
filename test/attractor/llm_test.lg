        (llm/gemini-complete
          {:model "gemini" :api_key "key" :messages []
           :transport
           (fn [_]
             {:status 200
              :body (json/write-json
                      {:responseId "g"
                       :candidates
                       [{:finishReason "STOP"
                         :content {:parts
                                   [{:inlineData
                                     {:mimeType "image/png"
                                      :data "iVBORw=="}}]}}]
                       :usageMetadata {}})})})
