(ns attractor.loop-restart-contract-test
  (:require [clojure.test :refer [deftest is testing]]
            [attractor.context :as context]
            [attractor.engine :as engine]
            [attractor.handlers :as handlers]
            [attractor.interviewer :as interviewer]
            [attractor.parser :as parser]
            [io :as io]
            [os :as os]))

(defn restart-test-root [label]
  (str (os/temp-dir) "/attractor-loop-restart-" label "-"
       (System/nanoTime)))

(defn first-event-index [events event-type target]
  (first
    (for [[index event] (map-indexed vector events)
          :when (and (= event-type (:type event))
                     (= target (:target event)))]
      index)))

(deftest restart-driver-preserves-run-inputs-and-orders-fresh-segments
  (let [graph
        (parser/parse-dot
          "digraph Restart {
             start [shape=Mdiamond]
             first [type=restart.probe]
             second [type=restart.probe]
             third [type=restart.probe]
             exit [shape=Msquare]
             start -> first
             first -> second [loop_restart=true, fidelity=full, thread_id=\"edge-one\"]
             second -> third [loop_restart=true, fidelity=full, thread_id=\"edge-two\"]
             third -> exit
           }")
        registry
        (handlers/make-handler-registry
          (interviewer/make-auto-approve-interviewer) nil)
        ctx (context/make-context {"semantic" {:keep [1 2 3]}})
        cancelled? (fn [] false)
        calls (atom [])
        events (atom [])
        fresh-at-restart (atom [])
        preserved-files (atom [])
        root (restart-test-root "finite")
        _ (handlers/register-handler!
            registry "restart.probe"
            (fn [node handler-ctx handler-graph logs-root]
              (swap! calls conj
                     {:node (:id node)
                      :logs-root logs-root
                      :graph-identical? (identical? graph handler-graph)
                      :context-identical? (identical? ctx handler-ctx)
                      :cancelled-identical?
                      (identical? cancelled? (:cancelled? node))
                      :semantic (context/ctx-get handler-ctx "semantic")
                      :fidelity (:resolved_fidelity node)
                      :thread (:resolved_thread_id node)})
              {:status :success}))
        result
        (engine/run-pipeline
          graph
          {:registry registry
           :context ctx
           :cancelled? cancelled?
           :logs-root root
           :on-event
           (fn [event]
             (when (= :pipeline.restarting (:type event))
               (let [new-root (:new_logs_root event)
                     old-root (:old_logs_root event)
                     stage-id (get {"second" "first" "third" "second"}
                                   (:target event))
                     checkpoint-path (str old-root "/checkpoint.edn")
                     status-path (str old-root "/" stage-id "/status.json")]
                 (swap! fresh-at-restart conj
                        (and (string? new-root)
                             (nil? (os/stat new-root))))
                 (swap! preserved-files conj
                        {:checkpoint {:path checkpoint-path
                                      :contents (io/slurp checkpoint-path)}
                         :status {:path status-path
                                  :contents (io/slurp status-path)}})))
             (swap! events conj event))})
        call-data @calls
        roots (mapv :logs-root call-data)
        restart-events
        (filterv (fn [event] (= :pipeline.restarting (:type event))) @events)
        started-roots
        (mapv :logs_root
              (filter (fn [event] (= :pipeline.started (:type event))) @events))]
    (is (= :success (:status result)))
    (is (not (contains? result :attractor.engine/restart)))
    (is (= ["first" "second" "third"] (mapv :node call-data)))
    (is (= 3 (count (set roots))))
    (is (= roots started-roots))
    (is (= [true true] @fresh-at-restart))
    (is (every? some? (map os/stat roots)))
    (doseq [segment-files @preserved-files
            recorded-file [(:checkpoint segment-files) (:status segment-files)]]
      (is (some? (os/stat (:path recorded-file))))
      (is (= (:contents recorded-file)
             (io/slurp (:path recorded-file)))))
    (is (every? :graph-identical? call-data))
    (is (every? :context-identical? call-data))
    (is (every? :cancelled-identical? call-data))
    (is (every? (fn [call] (= {:keep [1 2 3]} (:semantic call)))
                call-data))
    (is (= "full" (:fidelity (second call-data))))
    (is (= "edge-one" (:thread (second call-data))))
    (is (= "full" (:fidelity (nth call-data 2))))
    (is (= "edge-two" (:thread (nth call-data 2))))
    (is (= [{:type :pipeline.restarting
             :old_logs_root (first roots)
             :new_logs_root (second roots)
             :target "second"}
            {:type :pipeline.restarting
             :old_logs_root (second roots)
             :new_logs_root (nth roots 2)
             :target "third"}]
           restart-events))
    (doseq [[target expected-root] [["second" (second roots)]
                                    ["third" (nth roots 2)]]]
      (let [restart-index (first-event-index @events :pipeline.restarting target)
            pipeline-started-index
            (first
              (for [[index event] (map-indexed vector @events)
                    :when (and (> index restart-index)
                               (= :pipeline.started (:type event))
                               (= expected-root (:logs_root event)))]
                index))
            stage-started-index
            (first
              (for [[index event] (map-indexed vector @events)
                    :when (and (> index restart-index)
                               (= :stage.started (:type event))
                               (= target (:node_id event)))]
                index))]
        (is (< restart-index pipeline-started-index stage-started-index))))))

(deftest restart-cycle-uses-one-invocation-wide-step-budget
  (let [limit 4
        reason "Pipeline step limit exceeded (4 steps)"
        graph
        (parser/parse-dot
          "digraph Cycle {
             start [shape=Mdiamond, type=cycle.probe]
             cycle [type=cycle.probe]
             start -> cycle [loop_restart=true]
             cycle -> cycle [loop_restart=true]
           }")
        registry
        (handlers/make-handler-registry
          (interviewer/make-auto-approve-interviewer) nil)
        handler-count (atom 0)
        events (atom [])
        _ (handlers/register-handler!
            registry "cycle.probe"
            (fn [_ _ _ _]
              (swap! handler-count inc)
              {:status :success}))
        result
        (try
          (engine/run-pipeline
            graph
            {:registry registry
             :logs-root (restart-test-root "cycle")
             :max-steps limit
             :on-event (fn [event] (swap! events conj event))})
          (catch Object error
            {:thrown error}))]
    (is (= :fail (:status result)))
    (is (= reason (:failure_reason result)))
    (is (= limit @handler-count))
    (is (= [{:type :pipeline.failed :error reason}]
           (filterv (fn [event] (= :pipeline.failed (:type event)))
                    @events)))
    (is (= limit
           (count (filter (fn [event]
                            (= :pipeline.restarting (:type event)))
                          @events))))
    (is (= (inc limit)
           (count (filter (fn [event]
                            (= :pipeline.started (:type event)))
                          @events))))))

(deftest max-steps-contract-is-public-and-rejects-invalid-values
  (let [default-var (ns-resolve 'attractor.engine 'default-max-steps)]
    (is (= 10000 (when default-var @default-var))))
  (let [graph
        (parser/parse-dot
          "digraph InvalidBudget {
             start [shape=Mdiamond, type=budget.probe]
             exit [shape=Msquare]
             start -> exit
           }")]
    (doseq [invalid [0 -1 1.5 "4"]]
      (testing (str "invalid max steps " invalid)
        (let [handler-count (atom 0)
              events (atom [])
              registry
              (handlers/make-handler-registry
                (interviewer/make-auto-approve-interviewer) nil)
              _ (handlers/register-handler!
                  registry "budget.probe"
                  (fn [_ _ _ _]
                    (swap! handler-count inc)
                    {:status :success}))
              error
              (try
                (do
                  (engine/run-pipeline
                    graph
                    {:registry registry
                     :logs-root (restart-test-root "invalid")
                     :max-steps invalid
                     :on-event (fn [event] (swap! events conj event))})
                  nil)
                (catch Object cause cause))]
          (is (= "Invalid :max-steps; expected a positive integer"
                 (ex-message error)))
          (is (= {:category :configuration_error
                  :option :max-steps
                  :value invalid}
                 (ex-data error)))
          (is (= 0 @handler-count))
          (is (empty? @events)))))))

(deftest max-steps-allows-a-satisfied-terminal-after-the-exact-budget
  (let [one-handler-graph
        (parser/parse-dot
          "digraph ExactBudget {
             start [shape=Mdiamond, type=budget.probe]
             exit [shape=Msquare]
             start -> exit
           }")
        two-handler-graph
        (parser/parse-dot
          "digraph OverBudget {
             start [shape=Mdiamond, type=budget.probe]
             extra [type=budget.probe]
             exit [shape=Msquare]
             start -> extra -> exit
           }")
        registry
        (handlers/make-handler-registry
          (interviewer/make-auto-approve-interviewer) nil)
        handler-count (atom 0)
        _ (handlers/register-handler!
            registry "budget.probe"
            (fn [_ _ _ _]
              (swap! handler-count inc)
              {:status :success}))
        exact-events (atom [])
        exact-result
        (engine/run-pipeline
          one-handler-graph
          {:registry registry
           :logs-root (restart-test-root "exact-budget")
           :max-steps 1
           :on-event (fn [event] (swap! exact-events conj event))})
        _ (reset! handler-count 0)
        over-events (atom [])
        over-result
        (engine/run-pipeline
          two-handler-graph
          {:registry registry
           :logs-root (restart-test-root "over-budget")
           :max-steps 1
           :on-event (fn [event] (swap! over-events conj event))})
        reason "Pipeline step limit exceeded (1 steps)"]
    (is (= :success (:status exact-result)))
    (is (= ["start" "exit"] (:completed_nodes exact-result)))
    (is (empty? (filter (fn [event] (= :pipeline.failed (:type event)))
                        @exact-events)))
    (is (= :fail (:status over-result)))
    (is (= reason (:failure_reason over-result)))
    (is (= 1 @handler-count))
    (is (= 1 (count (filter (fn [event] (= :stage.started (:type event)))
                            @over-events))))
    (is (= [{:type :pipeline.failed :error reason}]
           (filterv (fn [event] (= :pipeline.failed (:type event)))
                    @over-events)))))

(deftest goal-gate-reroutes-consume-the-shared-step-budget
  (let [graph
        (parser/parse-dot
          "digraph GateBudget {
             start [shape=Mdiamond, type=gate.probe,
                    goal_gate=true, retry_target=retry]
             retry [type=gate.probe]
             exit [shape=Msquare]
             start -> exit [condition=\"outcome=fail\"]
             retry -> exit
           }")
        run-case
        (fn [limit]
          (let [handler-nodes (atom [])
                events (atom [])
                registry
                (handlers/make-handler-registry
                  (interviewer/make-auto-approve-interviewer) nil)
                _ (handlers/register-handler!
                    registry "gate.probe"
                    (fn [node _ _ _]
                      (swap! handler-nodes conj (:id node))
                      (if (= "start" (:id node))
                        {:status :fail :failure_reason "goal not met"}
                        {:status :success})))
                result
                (engine/run-pipeline
                  graph
                  {:registry registry
                   :logs-root (restart-test-root (str "gate-" limit))
                   :max-steps limit
                   :on-event (fn [event] (swap! events conj event))})]
            {:result result :handler-nodes @handler-nodes :events @events}))
        at-limit (run-case 1)
        with-reroute (run-case 2)]
    (is (= "Pipeline step limit exceeded (1 steps)"
           (get-in at-limit [:result :failure_reason])))
    (is (= ["start"] (:handler-nodes at-limit)))
    (is (empty? (filter (fn [event]
                          (= :goal_gate.retrying (:type event)))
                        (:events at-limit))))
    (is (= [{:type :pipeline.failed
             :error "Pipeline step limit exceeded (1 steps)"}]
           (filterv (fn [event] (= :pipeline.failed (:type event)))
                    (:events at-limit))))
    (is (= "Pipeline step limit exceeded (2 steps)"
           (get-in with-reroute [:result :failure_reason])))
    (is (= ["start"] (:handler-nodes with-reroute)))
    (is (= 1 (count (filter (fn [event]
                              (= :goal_gate.retrying (:type event)))
                            (:events with-reroute)))))
    (is (= 1 (count (filter (fn [event]
                              (= :stage.started (:type event)))
                            (:events with-reroute)))))))

(deftest fidelity-cleanup-attempts-all-closes-and-preserves-primary-errors
  (let [graph
        (parser/parse-dot
          "digraph Cleanup {
             start [shape=Mdiamond, type=cleanup.probe]
             exit [shape=Msquare]
             start -> exit
           }")
        primary-error (ex-info "primary transition failure" {:kind :primary})
        cleanup-error (ex-info "cleanup failure" {:kind :cleanup})
        run-case
        (fn [throw-primary?]
          (let [attempts (atom [])
                threads-seen (atom nil)
                registry
                (handlers/make-handler-registry
                  (interviewer/make-auto-approve-interviewer) nil)
                _ (handlers/register-handler!
                    registry "cleanup.probe"
                    (fn [node _ _ _]
                      (let [threads (:fidelity_threads node)]
                        (reset! threads-seen threads)
                        (reset! threads
                                (array-map
                                  "broken"
                                  {:close (fn []
                                            (swap! attempts conj "broken")
                                            (throw cleanup-error))}
                                  "healthy"
                                  {:close (fn []
                                            (swap! attempts conj "healthy"))}))
                        (if throw-primary?
                          (throw primary-error)
                          {:status :success}))))
                escaped
                (try
                  (do
                    (engine/run-pipeline
                      graph
                      {:registry registry
                       :logs-root
                       (restart-test-root
                         (if throw-primary? "primary-cleanup" "cleanup-only"))
                       :on-event
                       (fn [event]
                         (when (and throw-primary?
                                    (= :stage.failed (:type event)))
                           (throw primary-error)))})
                    nil)
                  (catch Object error error))]
            {:escaped escaped
             :attempts @attempts
             :threads @threads-seen}))
        with-primary (run-case true)
        cleanup-only (run-case false)]
    (is (identical? primary-error (:escaped with-primary)))
    (is (= #{"broken" "healthy"} (set (:attempts with-primary))))
    (is (= 2 (count (:attempts with-primary))))
    (is (empty? @(:threads with-primary)))
    (is (identical? cleanup-error (:escaped cleanup-only)))
    (is (= #{"broken" "healthy"} (set (:attempts cleanup-only))))
    (is (= 2 (count (:attempts cleanup-only))))
    (is (empty? @(:threads cleanup-only)))))
