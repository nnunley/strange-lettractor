(ns attractor.loop-restart-contract-test
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.string :as str]
            [attractor.agent :as agent]
            [attractor.context :as context]
            [attractor.engine :as engine]
            [attractor.handlers :as handlers]
            [attractor.interviewer :as interviewer]
            [attractor.parser :as parser]
            [io :as io]
            [os :as os]))

(defn restart-test-root [label]
  (str (os/temp-dir) "/attractor-loop-restart-" label "-"
       (random-uuid)))

(defn first-event-index [events event-type target]
  (first
    (for [[index event] (map-indexed vector events)
          :when (and (= event-type (:type event))
                     (= target (:target event)))]
      index)))

(def restart-bookkeeping-names
  #{"run.id" "current_node" "outcome" "preferred_label"})

(defn restart-bookkeeping-key-name [key]
  (cond
    (string? key) key
    (and (keyword? key) (nil? (namespace key))) (name key)
    :else nil))

(defn stale-restart-bookkeeping-keys [values]
  (filterv
    (fn [key]
      (when-let [key-name (restart-bookkeeping-key-name key)]
        (or (contains? restart-bookkeeping-names key-name)
            (str/starts-with? key-name "internal.retry_count."))))
    (keys values)))

(deftest restart-context-scrub-preserves-custom-map-semantics
  (let [semantic-value {:nested [1 2 3]}
        reverse-compare (fn [left right] (compare right left))
        original-values
        (with-meta
          (sorted-map-by reverse-compare
                         "z-semantic" semantic-value
                         "run.id" "old-run"
                         "outcome" "old-outcome"
                         "a-semantic" :keep)
          {:context-map :custom-sorted})
        ctx (context/make-context original-values)
        _ (context/ctx-reset-for-restart! ctx)
        reset-values (:values @ctx)
        extended-values (assoc reset-values "m-semantic" :added)]
    (is (nil? (get reset-values "run.id")))
    (is (nil? (get reset-values "outcome")))
    (is (sorted? reset-values))
    (is (= ["z-semantic" "a-semantic"] (vec (keys reset-values))))
    (is (= ["z-semantic" "m-semantic" "a-semantic"]
           (vec (keys extended-values))))
    (is (= {:context-map :custom-sorted} (meta reset-values)))
    (is (identical? semantic-value (get reset-values "z-semantic")))))

(deftest restart-driver-preserves-run-inputs-and-orders-fresh-segments
  (let [graph
        (parser/parse-dot
          "digraph Restart {
             start [shape=Mdiamond]
             first [type=restart.probe]
             second [type=restart.probe]
             third [type=restart.probe]
             exit [shape=Msquare]
             start -> first
             first -> second [loop_restart=true, fidelity=full, thread_id=\"edge-one\"]
             second -> third [loop_restart=true, fidelity=full, thread_id=\"edge-two\"]
             third -> exit
           }")
        registry
        (handlers/make-handler-registry
          (interviewer/make-auto-approve-interviewer) nil)
        ctx (context/make-context {"semantic" {:keep [1 2 3]}})
        cancelled? (fn [] false)
        calls (atom [])
        events (atom [])
        fresh-at-restart (atom [])
        preserved-files (atom [])
        root (restart-test-root "finite")
        _ (handlers/register-handler!
            registry "restart.probe"
            (fn [node handler-ctx handler-graph logs-root]
              (swap! calls conj
                     {:node (:id node)
                      :logs-root logs-root
                      :graph-identical? (identical? graph handler-graph)
                      :context-identical? (identical? ctx handler-ctx)
                      :cancelled-identical?
                      (identical? cancelled? (:cancelled? node))
                      :semantic (context/ctx-get handler-ctx "semantic")
                      :fidelity (:resolved_fidelity node)
                      :thread (:resolved_thread_id node)})
              {:status :success}))
        result
        (engine/run-pipeline
          graph
          {:registry registry
           :context ctx
           :cancelled? cancelled?
           :logs-root root
           :on-event
           (fn [event]
             (when (= :pipeline.restarting (:type event))
               (let [new-root (:new_logs_root event)
                     old-root (:old_logs_root event)
                     stage-id (get {"second" "first" "third" "second"}
                                   (:target event))
                     checkpoint-path (str old-root "/checkpoint.edn")
                     status-path (str old-root "/" stage-id "/status.json")]
                 (swap! fresh-at-restart conj
                        (and (string? new-root)
                             (nil? (os/stat new-root))))
                 (swap! preserved-files conj
                        {:checkpoint {:path checkpoint-path
                                      :contents (io/slurp checkpoint-path)}
                         :status {:path status-path
                                  :contents (io/slurp status-path)}})))
             (swap! events conj event))})
        call-data @calls
        roots (mapv :logs-root call-data)
        restart-events
        (filterv (fn [event] (= :pipeline.restarting (:type event))) @events)
        started-roots
        (mapv :logs_root
              (filter (fn [event] (= :pipeline.started (:type event))) @events))]
    (is (= :success (:status result)))
    (is (not (contains? result :attractor.engine/restart)))
    (is (= ["first" "second" "third"] (mapv :node call-data)))
    (is (= 3 (count (set roots))))
    (is (= roots started-roots))
    (is (= [true true] @fresh-at-restart))
    (is (every? some? (map os/stat roots)))
    (doseq [segment-files @preserved-files
            recorded-file [(:checkpoint segment-files) (:status segment-files)]]
      (is (some? (os/stat (:path recorded-file))))
      (is (= (:contents recorded-file)
             (io/slurp (:path recorded-file)))))
    (is (every? :graph-identical? call-data))
    (is (every? :context-identical? call-data))
    (is (every? :cancelled-identical? call-data))
    (is (every? (fn [call] (= {:keep [1 2 3]} (:semantic call)))
                call-data))
    (is (= "full" (:fidelity (second call-data))))
    (is (= "edge-one" (:thread (second call-data))))
    (is (= "full" (:fidelity (nth call-data 2))))
    (is (= "edge-two" (:thread (nth call-data 2))))
    (is (= [{:type :pipeline.restarting
             :old_logs_root (first roots)
             :new_logs_root (second roots)
             :target "second"}
            {:type :pipeline.restarting
             :old_logs_root (second roots)
             :new_logs_root (nth roots 2)
             :target "third"}]
           restart-events))
    (doseq [[target expected-root] [["second" (second roots)]
                                    ["third" (nth roots 2)]]]
      (let [restart-index (first-event-index @events :pipeline.restarting target)
            pipeline-started-index
            (first
              (for [[index event] (map-indexed vector @events)
                    :when (and (> index restart-index)
                               (= :pipeline.started (:type event))
                               (= expected-root (:logs_root event)))]
                index))
            stage-started-index
            (first
              (for [[index event] (map-indexed vector @events)
                    :when (and (> index restart-index)
                               (= :stage.started (:type event))
                               (= target (:node_id event)))]
                index))]
        (is (< restart-index pipeline-started-index stage-started-index))))))

(deftest restart-cycle-uses-one-invocation-wide-step-budget
  (let [limit 4
        reason "Pipeline step limit exceeded (4 steps)"
        graph
        (parser/parse-dot
          "digraph Cycle {
             start [shape=Mdiamond, type=cycle.probe]
             cycle [type=cycle.probe]
             start -> cycle [loop_restart=true]
             cycle -> cycle [loop_restart=true]
           }")
        registry
        (handlers/make-handler-registry
          (interviewer/make-auto-approve-interviewer) nil)
        handler-count (atom 0)
        events (atom [])
        _ (handlers/register-handler!
            registry "cycle.probe"
            (fn [_ _ _ _]
              (swap! handler-count inc)
              {:status :success}))
        result
        (try
          (engine/run-pipeline
            graph
            {:registry registry
             :logs-root (restart-test-root "cycle")
             :max-steps limit
             :on-event (fn [event] (swap! events conj event))})
          (catch Object error
            {:thrown error}))]
    (is (= :fail (:status result)))
    (is (= reason (:failure_reason result)))
    (is (= limit @handler-count))
    (is (= [{:type :pipeline.failed :error reason}]
           (filterv (fn [event] (= :pipeline.failed (:type event)))
                    @events)))
    (is (= limit
           (count (filter (fn [event]
                            (= :pipeline.restarting (:type event)))
                          @events))))
    (is (= (inc limit)
           (count (filter (fn [event]
                            (= :pipeline.started (:type event)))
                          @events))))))

(deftest max-steps-contract-is-public-and-rejects-invalid-values
  (let [default-var (ns-resolve 'attractor.engine 'default-max-steps)]
    (is (= 10000 (when default-var @default-var))))
  (let [graph
        (parser/parse-dot
          "digraph InvalidBudget {
             start [shape=Mdiamond, type=budget.probe]
             exit [shape=Msquare]
             start -> exit
           }")]
    (doseq [invalid [0 -1 1.5 "4"]]
      (testing (str "invalid max steps " invalid)
        (let [handler-count (atom 0)
              events (atom [])
              registry
              (handlers/make-handler-registry
                (interviewer/make-auto-approve-interviewer) nil)
              _ (handlers/register-handler!
                  registry "budget.probe"
                  (fn [_ _ _ _]
                    (swap! handler-count inc)
                    {:status :success}))
              error
              (try
                (do
                  (engine/run-pipeline
                    graph
                    {:registry registry
                     :logs-root (restart-test-root "invalid")
                     :max-steps invalid
                     :on-event (fn [event] (swap! events conj event))})
                  nil)
                (catch Object cause cause))]
          (is (= "Invalid :max-steps; expected a positive integer"
                 (ex-message error)))
          (is (= {:category :configuration_error
                  :option :max-steps
                  :value invalid}
                 (ex-data error)))
          (is (= 0 @handler-count))
          (is (empty? @events)))))))

(deftest max-steps-allows-a-satisfied-terminal-after-the-exact-budget
  (let [one-handler-graph
        (parser/parse-dot
          "digraph ExactBudget {
             start [shape=Mdiamond, type=budget.probe]
             exit [shape=Msquare]
             start -> exit
           }")
        two-handler-graph
        (parser/parse-dot
          "digraph OverBudget {
             start [shape=Mdiamond, type=budget.probe]
             extra [type=budget.probe]
             exit [shape=Msquare]
             start -> extra -> exit
           }")
        registry
        (handlers/make-handler-registry
          (interviewer/make-auto-approve-interviewer) nil)
        handler-count (atom 0)
        _ (handlers/register-handler!
            registry "budget.probe"
            (fn [_ _ _ _]
              (swap! handler-count inc)
              {:status :success}))
        exact-events (atom [])
        exact-result
        (engine/run-pipeline
          one-handler-graph
          {:registry registry
           :logs-root (restart-test-root "exact-budget")
           :max-steps 1
           :on-event (fn [event] (swap! exact-events conj event))})
        _ (reset! handler-count 0)
        over-events (atom [])
        over-result
        (engine/run-pipeline
          two-handler-graph
          {:registry registry
           :logs-root (restart-test-root "over-budget")
           :max-steps 1
           :on-event (fn [event] (swap! over-events conj event))})
        reason "Pipeline step limit exceeded (1 steps)"]
    (is (= :success (:status exact-result)))
    (is (= ["start" "exit"] (:completed_nodes exact-result)))
    (is (empty? (filter (fn [event] (= :pipeline.failed (:type event)))
                        @exact-events)))
    (is (= :fail (:status over-result)))
    (is (= reason (:failure_reason over-result)))
    (is (= 1 @handler-count))
    (is (= 1 (count (filter (fn [event] (= :stage.started (:type event)))
                            @over-events))))
    (is (= [{:type :pipeline.failed :error reason}]
           (filterv (fn [event] (= :pipeline.failed (:type event)))
                    @over-events)))))

(deftest goal-gate-reroutes-consume-the-shared-step-budget
  (let [graph
        (parser/parse-dot
          "digraph GateBudget {
             start [shape=Mdiamond, type=gate.probe,
                    goal_gate=true, retry_target=retry]
             retry [type=gate.probe]
             exit [shape=Msquare]
             start -> exit [condition=\"outcome=fail\"]
             retry -> exit
           }")
        run-case
        (fn [limit]
          (let [handler-nodes (atom [])
                events (atom [])
                registry
                (handlers/make-handler-registry
                  (interviewer/make-auto-approve-interviewer) nil)
                _ (handlers/register-handler!
                    registry "gate.probe"
                    (fn [node _ _ _]
                      (swap! handler-nodes conj (:id node))
                      (if (= "start" (:id node))
                        {:status :fail :failure_reason "goal not met"}
                        {:status :success})))
                result
                (engine/run-pipeline
                  graph
                  {:registry registry
                   :logs-root (restart-test-root (str "gate-" limit))
                   :max-steps limit
                   :on-event (fn [event] (swap! events conj event))})]
            {:result result :handler-nodes @handler-nodes :events @events}))
        at-limit (run-case 1)
        with-reroute (run-case 2)]
    (is (= "Pipeline step limit exceeded (1 steps)"
           (get-in at-limit [:result :failure_reason])))
    (is (= ["start"] (:handler-nodes at-limit)))
    (is (empty? (filter (fn [event]
                          (= :goal_gate.retrying (:type event)))
                        (:events at-limit))))
    (is (= [{:type :pipeline.failed
             :error "Pipeline step limit exceeded (1 steps)"}]
           (filterv (fn [event] (= :pipeline.failed (:type event)))
                    (:events at-limit))))
    (is (= "Pipeline step limit exceeded (2 steps)"
           (get-in with-reroute [:result :failure_reason])))
    (is (= ["start"] (:handler-nodes with-reroute)))
    (is (= 1 (count (filter (fn [event]
                              (= :goal_gate.retrying (:type event)))
                            (:events with-reroute)))))
    (is (= 1 (count (filter (fn [event]
                              (= :stage.started (:type event)))
                            (:events with-reroute)))))))

(deftest fidelity-cleanup-attempts-all-closes-and-preserves-primary-errors
  (let [graph
        (parser/parse-dot
          "digraph Cleanup {
             start [shape=Mdiamond, type=cleanup.probe]
             exit [shape=Msquare]
             start -> exit
           }")
        primary-error (ex-info "primary transition failure" {:kind :primary})
        cleanup-error (ex-info "cleanup failure" {:kind :cleanup})
        run-case
        (fn [throw-primary?]
          (let [attempts (atom [])
                threads-seen (atom nil)
                registry
                (handlers/make-handler-registry
                  (interviewer/make-auto-approve-interviewer) nil)
                _ (handlers/register-handler!
                    registry "cleanup.probe"
                    (fn [node _ _ _]
                      (let [threads (:fidelity_threads node)]
                        (reset! threads-seen threads)
                        (reset! threads
                                (array-map
                                  "broken"
                                  {:close (fn []
                                            (swap! attempts conj "broken")
                                            (throw cleanup-error))}
                                  "healthy"
                                  {:close (fn []
                                            (swap! attempts conj "healthy"))}))
                        (if throw-primary?
                          (throw primary-error)
                          {:status :success}))))
                escaped
                (try
                  (do
                    (engine/run-pipeline
                      graph
                      {:registry registry
                       :logs-root
                       (restart-test-root
                         (if throw-primary? "primary-cleanup" "cleanup-only"))
                       :on-event
                       (fn [event]
                         (when (and throw-primary?
                                    (= :stage.failed (:type event)))
                           (throw primary-error)))})
                    nil)
                  (catch Object error error))]
            {:escaped escaped
             :attempts @attempts
             :threads @threads-seen}))
        with-primary (run-case true)
        cleanup-only (run-case false)]
    (is (identical? primary-error (:escaped with-primary)))
    (is (= #{"broken" "healthy"} (set (:attempts with-primary))))
    (is (= 2 (count (:attempts with-primary))))
    (is (empty? @(:threads with-primary)))
    (is (identical? cleanup-error (:escaped cleanup-only)))
    (is (= #{"broken" "healthy"} (set (:attempts cleanup-only))))
    (is (= 2 (count (:attempts cleanup-only))))
    (is (empty? @(:threads cleanup-only)))))

(deftest restart-exhaustively-isolates-segment-state-and-artifacts
  (let [semantic {:nested {:items [1 2 3]}}
        first-produced {:from "start" :nested ["a"]}
        second-produced {:from "second" :nested ["b"]}
        preserved-special-values
        {:tenant/run.id {:kind :namespaced-run}
         :tenant/current_node {:kind :namespaced-node}
         :tenant/outcome {:kind :namespaced-outcome}
         :tenant/preferred_label {:kind :namespaced-label}
         :tenant/internal.retry_count.x {:kind :namespaced-retry}
         'run.id {:kind :symbol-run}
         'internal.retry_count.x {:kind :symbol-retry}
         "run.id.extra" {:kind :string-run-boundary}
         "internal.retry_count" {:kind :string-retry-boundary}
         :run.id.extra {:kind :keyword-run-boundary}
         :internal.retry_count {:kind :keyword-retry-boundary}}
        graph
        (parser/parse-dot
          "digraph Isolation {
             graph [goal=\"Keep the mission\", label=\"Stable label\", owner=stable]
             start [shape=Mdiamond, type=restart.matrix]
             second [type=restart.matrix]
             third [type=restart.matrix]
             exit [shape=Msquare]
             start -> second [loop_restart=true, fidelity=full, thread_id=\"edge-one\"]
             second -> third [loop_restart=true, fidelity=full, thread_id=\"edge-two\"]
             third -> exit
           }")
        registry
        (handlers/make-handler-registry
          (interviewer/make-auto-approve-interviewer) nil)
        template-parallel (get @registry handlers/parallel-executor-key)
        template-manager (get @registry handlers/manager-runtime-key)
        template-parallel-value @template-parallel
        template-manager-value @template-manager
        ctx
        (context/make-context
          (merge
            {"semantic" semantic
             "preserve.internal.retry_count.value" "yes"
             "run.id" "old-string-run"
             :run.id "old-keyword-run"
             "current_node" "old-string-node"
             :current_node "old-keyword-node"
             "outcome" "old-string-outcome"
             :outcome "old-keyword-outcome"
             "preferred_label" "old-string-label"
             :preferred_label "old-keyword-label"
             "internal.retry_count.string" 1
             :internal.retry_count.keyword 2}
            preserved-special-values))
        cancelled? (fn [] false)
        root (restart-test-root "matrix")
        events (atom [])
        calls (atom [])
        segment-inits (atom [])
        restart-files (atom [])
        manager-config {:configured true}
        _
        (handlers/register-handler!
          registry "restart.matrix"
          (fn [node handler-ctx handler-graph logs-root]
            (let [node-id (:id node)
                  values (:values @handler-ctx)
                  earlier-node-ids
                  (case node-id
                    "start" []
                    "second" ["start"]
                    "third" ["start" "second"])
                  stage-dir (str logs-root "/" node-id)
                  produced (if (= node-id "start") first-produced second-produced)]
              (swap! calls conj
                     {:node node-id
                      :logs-root logs-root
                      :context handler-ctx
                      :graph handler-graph
                      :cancelled? (:cancelled? node)
                      :values values
                      :logs (:logs @handler-ctx)
                      :semantic (get values "semantic")
                      :fidelity (:resolved_fidelity node)
                      :thread (:resolved_thread_id node)
                      :clean-at-entry?
                      (and (nil? (os/stat (str logs-root "/checkpoint.edn")))
                           (every?
                             (fn [earlier]
                               (nil? (os/stat (str logs-root "/" earlier))))
                             earlier-node-ids))})
              (os/sh "mkdir" "-p" stage-dir)
              (io/spit (str stage-dir "/artifact.txt")
                       (str "artifact-" node-id))
              (context/ctx-append-log! handler-ctx (str "log-" node-id))
              (when-not (= node-id "third")
                (swap! handler-ctx update :values assoc
                       :run.id "bad-keyword-run"
                       :current_node "bad-keyword-node"
                       :outcome "bad-keyword-outcome"
                       :preferred_label "bad-keyword-label"
                       :internal.retry_count.bad 99))
              {:status :success
               :preferred_label "bad-string-label"
               :context_updates
               {(str "produced." node-id) produced
                "graph.id" "corrupt-id"
                "graph.goal" "corrupt-goal"
                "graph.label" "corrupt-label"
                "graph.owner" "corrupt-owner"
                "internal.retry_count.bad" 99}})))
        result
        (engine/run-pipeline
          graph
          {:registry registry
           :context ctx
           :cancelled? cancelled?
           :logs-root root
           :manager-runtime manager-config
           :first-node-fidelity-override "summary:high"
           :completed-nodes ["prior"]
           :node-outcomes {"prior" {:status :success}}
           :node-retries {"prior" 2}
           :attractor.engine/on-segment-initialized
           (fn [state] (swap! segment-inits conj state))
           :on-event
           (fn [event]
             (when (= :pipeline.restarting (:type event))
               (let [old-root (:old_logs_root event)
                     old-node (get {"second" "start" "third" "second"}
                                   (:target event))]
                 (swap! restart-files conj
                        (mapv
                          (fn [path]
                            {:path path :contents (io/slurp path)})
                          [(str old-root "/checkpoint.edn")
                           (str old-root "/" old-node "/status.json")
                           (str old-root "/" old-node "/artifact.txt")]))))
             (when (= :pipeline.started (:type event))
               (swap! events conj
                      {:event event
                       :values (:values @ctx)
                       :logs (:logs @ctx)})))})
        call-data @calls
        roots (mapv :logs-root call-data)
        checkpoints (mapv (fn [segment-root]
                            (context/load-checkpoint
                              (str segment-root "/checkpoint.edn")))
                          roots)
        started @events]
    (is (= :success (:status result)))
    (is (= ["start" "second" "third"] (mapv :node call-data)))
    (is (= 3 (count (set roots))))
    (is (every? :clean-at-entry? call-data))
    (is (every? (fn [call] (identical? ctx (:context call))) call-data))
    (is (every? (fn [call] (identical? graph (:graph call))) call-data))
    (is (every? (fn [call] (identical? cancelled? (:cancelled? call))) call-data))
    (is (every? (fn [call] (identical? semantic (:semantic call))) call-data))
    (is (= [[] ["log-start"] ["log-start" "log-second"]]
           (mapv :logs call-data)))
    (is (= ["log-start" "log-second" "log-third"] (:logs @ctx)))
    (is (= "yes" (context/ctx-get ctx "preserve.internal.retry_count.value")))
    (is (identical? first-produced (context/ctx-get ctx "produced.start")))
    (is (identical? second-produced (context/ctx-get ctx "produced.second")))
    (doseq [[key expected] preserved-special-values]
      (is (contains? (:values @ctx) key))
      (is (identical? expected (get (:values @ctx) key))))
    (doseq [index [1 2]]
      (let [started-state (nth started index)
            values (:values started-state)
            handler-values (:values (nth call-data index))
            node-id (:node (nth call-data index))]
        (is (= (nth roots index) (get values "run.id")))
        (is (empty? (stale-restart-bookkeeping-keys
                      (dissoc values "run.id"))))
        (is (nil? (get values "current_node")))
        (is (= (nth roots index) (get handler-values "run.id")))
        (is (= node-id (get handler-values "current_node")))
        (is (empty?
              (stale-restart-bookkeeping-keys
                (dissoc handler-values "run.id" "current_node"))))
        (is (= "Isolation" (get handler-values "graph.id")))
        (is (= "Keep the mission" (get handler-values "graph.goal")))
        (is (= "Stable label" (get handler-values "graph.label")))
        (is (= "stable" (get handler-values "graph.owner")))))
    (is (= "summary:high" (:fidelity (first call-data))))
    (is (= [["full" "edge-one"] ["full" "edge-two"]]
           (mapv (fn [call] [(:fidelity call) (:thread call)])
                 (rest call-data))))
    (is (= [["prior" "start"] ["second"] ["third" "exit"]]
           (mapv :completed_nodes checkpoints)))
    (is (= [#{"prior" "start"} #{"second"} #{"third"}]
           (mapv (fn [checkpoint] (set (keys (:node_outcomes checkpoint))))
                 checkpoints)))
    (is (= [{"prior" 2 "start" 0} {"second" 0} {"third" 0}]
           (mapv :node_retries checkpoints)))
    (doseq [recorded-files @restart-files
            recorded recorded-files]
      (is (some? (os/stat (:path recorded))))
      (is (= (:contents recorded) (io/slurp (:path recorded)))))
    (doseq [[index own-node] [[0 "start"] [1 "second"] [2 "third"]]
            candidate ["start" "second" "third"]]
      (let [path (str (nth roots index) "/" candidate)]
        (if (= candidate own-node)
          (do
            (is (some? (os/stat (str path "/status.json"))))
            (is (= (str "artifact-" candidate)
                   (io/slurp (str path "/artifact.txt")))))
          (is (nil? (os/stat path))))))
    (is (= 3 (count @segment-inits)))
    (is (= 3 (count (set (map :parallel-executor @segment-inits)))))
    (is (= 3 (count (set (map :manager-runtime @segment-inits)))))
    (is (= 3 (count (set (map :retry-counts @segment-inits)))))
    (is (= 3 (count (set (map :fidelity-threads @segment-inits)))))
    (is (every? (fn [state] (fn? @(:parallel-executor state)))
                @segment-inits))
    (is (every? (fn [state] (= manager-config @(:manager-runtime state)))
                @segment-inits))
    (is (= [{"prior" 2} {} {}]
           (mapv :retry-counts-value @segment-inits)))
    (is (= [{} {} {}]
           (mapv :fidelity-threads-value @segment-inits)))
    (is (nil? template-parallel-value))
    (is (= {} template-manager-value))
    (is (nil? @template-parallel))
    (is (= {} @template-manager))))

(deftest two-restarts-create-three-fresh-full-fidelity-sessions
  (let [requests (atom [])
        session-starts (atom [])
        session-ends (atom [])
        backend
        (agent/make-agent-codergen-backend
          {:model "mock/test"
           :project_docs []
           :complete_fn
           (fn [request]
             (swap! requests conj request)
             {:id (str "response-" (count @requests))
              :content "ok" :tool_calls []})
           :on_event
           (fn [event]
             (case (:type event)
               :session_start (swap! session-starts conj (:session_id event))
               :session_end (swap! session-ends conj (:session_id event))
               nil))})
        registry (handlers/make-handler-registry
                   (interviewer/make-auto-approve-interviewer) backend)
        graph
        (parser/parse-dot
          "digraph FidelityRestart {
             graph [default_fidelity=full, thread_id=shared]
             start [shape=Mdiamond]
             first [shape=box]
             second [shape=box]
             third [shape=box]
             exit [shape=Msquare]
             start -> first
             first -> second [loop_restart=true]
             second -> third [loop_restart=true]
             third -> exit
           }")
        result
        (engine/run-pipeline
          graph {:registry registry
                 :logs-root (restart-test-root "three-fidelity")})]
    (is (= :success (:status result)))
    (is (= [2 2 2] (mapv (comp count :messages) @requests)))
    (is (= 3 (count (set @session-starts))))
    (is (= (set @session-starts) (set @session-ends)))
    (is (= 3 (count @session-ends)))))

(deftest caller-fidelity-thread-ownership-differs-on-restart-and-completion
  (let [make-registry
        (fn [calls]
          (let [registry
                (handlers/make-handler-registry
                  (interviewer/make-auto-approve-interviewer) nil)]
            (handlers/register-handler!
              registry "ownership.probe"
              (fn [node _ _ _]
                (swap! calls conj
                       {:node (:id node)
                        :threads (:fidelity_threads node)})
                {:status :success}))
            registry))
        restart-graph
        (parser/parse-dot
          "digraph RestartOwnership {
             start [shape=Mdiamond, type=ownership.probe]
             second [type=ownership.probe]
             exit [shape=Msquare]
             start -> second [loop_restart=true]
             second -> exit
           }")
        restart-closes (atom 0)
        caller-restart-threads
        (atom {"caller" {:close (fn [] (swap! restart-closes inc))}})
        restart-calls (atom [])
        restart-inits (atom [])
        restart-result
        (engine/run-pipeline
          restart-graph
          {:registry (make-registry restart-calls)
           :logs-root (restart-test-root "caller-restart-ownership")
           :fidelity-threads caller-restart-threads
           :attractor.engine/on-segment-initialized
           (fn [state]
             (swap! restart-inits conj (:fidelity-threads state)))})
        ordinary-graph
        (parser/parse-dot
          "digraph OrdinaryOwnership {
             start [shape=Mdiamond, type=ownership.probe]
             exit [shape=Msquare]
             start -> exit
           }")
        ordinary-closes (atom 0)
        ordinary-close (fn [] (swap! ordinary-closes inc))
        caller-ordinary-threads (atom {"caller" {:close ordinary-close}})
        ordinary-calls (atom [])
        ordinary-inits (atom [])
        ordinary-result
        (engine/run-pipeline
          ordinary-graph
          {:registry (make-registry ordinary-calls)
           :logs-root (restart-test-root "caller-ordinary-ownership")
           :fidelity-threads caller-ordinary-threads
           :attractor.engine/on-segment-initialized
           (fn [state]
             (swap! ordinary-inits conj (:fidelity-threads state)))})]
    (is (= :success (:status restart-result)))
    (is (= ["start" "second"] (mapv :node @restart-calls)))
    (is (identical? caller-restart-threads
                    (:threads (first @restart-calls))))
    (is (identical? caller-restart-threads (first @restart-inits)))
    (is (not (identical? caller-restart-threads
                         (:threads (second @restart-calls)))))
    (is (identical? (:threads (second @restart-calls))
                    (second @restart-inits)))
    (is (= 1 @restart-closes))
    (is (empty? @caller-restart-threads))

    (is (= :success (:status ordinary-result)))
    (is (= ["start"] (mapv :node @ordinary-calls)))
    (is (identical? caller-ordinary-threads
                    (:threads (first @ordinary-calls))))
    (is (identical? caller-ordinary-threads (first @ordinary-inits)))
    (is (= 0 @ordinary-closes))
    (is (= #{"caller"} (set (keys @caller-ordinary-threads))))
    ;; The engine retained caller ownership; perform the caller's cleanup now.
    (ordinary-close)
    (reset! caller-ordinary-threads {})
    (is (= 1 @ordinary-closes))
    (is (empty? @caller-ordinary-threads))))

