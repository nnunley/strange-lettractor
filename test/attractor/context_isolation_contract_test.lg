(ns attractor.context-isolation-contract-test
  (:require [clojure.test :refer [deftest is testing]]
            [attractor.context :as context]))

(defn container? [value]
  (or (map? value)
      (vector? value)
      (set? value)
      (list? value)))

(defn matching-set-member [members wanted]
  (first (filter (fn [candidate] (= wanted candidate)) members)))

(defn matching-map-key [copied wanted]
  (first (filter (fn [candidate] (= wanted candidate)) (keys copied))))

(defn assert-deep-copy [source copied path]
  (when (and (container? source) (seq source))
    (is (not (identical? source copied))
        (str "container at " path " must be copied")))
  (cond
    (map? source)
    (doseq [[key value] source]
      (let [copied-key (matching-map-key copied key)]
        (assert-deep-copy key copied-key (conj path :map-key))
        (assert-deep-copy value (get copied copied-key) (conj path key))))

    (or (vector? source) (list? source))
    (doseq [[index value] (map-indexed vector source)]
      (assert-deep-copy value (nth copied index) (conj path index)))

    (set? source)
    (doseq [value source]
      (assert-deep-copy value (matching-set-member copied value)
                        (conj path :set-member)))))

(defn thrown-data [operation ctx]
  (try
    (do (operation ctx) nil)
    (catch Object error
      (ex-data error))))

(deftest snapshots-and-clones-deep-copy-supported-edn-values
  (let [container-key [:container {:nested-key (list :x :y)}]
        source-values
        (hash-map
          "nested"
          {:map {:leaf [1 2]}
           :vector [{:inside #{:a :b}}]
           :set (hash-set {:member (list 3 4)})
           :list (list {:tail [5 6]})}
          container-key
          {:keyed-value (list 7 8)})
        parent (context/make-context source-values)
        _ (context/ctx-append-log! parent "parent-before-copy")
        snapshot (context/ctx-snapshot parent)
        clone-a (context/ctx-clone parent)
        clone-b (context/ctx-clone parent)
        clone-a-values (:values @clone-a)
        clone-b-values (:values @clone-b)]
    (is (= source-values snapshot)
        (str "source=" (pr-str source-values) " snapshot=" (pr-str snapshot)))
    (is (= source-values clone-a-values))
    (is (= source-values clone-b-values))
    (assert-deep-copy source-values snapshot [:values])
    (assert-deep-copy source-values clone-a-values [:values])
    (assert-deep-copy source-values clone-b-values [:values])

    (context/ctx-set! parent "nested" {:changed :parent})
    (is (= (get source-values "nested") (get snapshot "nested")))
    (is (= (get source-values "nested")
           (context/ctx-get clone-a "nested")))
    (is (= (get source-values "nested")
           (context/ctx-get clone-b "nested")))

    (context/ctx-set! clone-a "nested" {:changed :clone-a})
    (context/ctx-set! clone-b "branch-only" [:clone-b])
    (is (= {:changed :parent} (context/ctx-get parent "nested")))
    (is (= {:changed :clone-a} (context/ctx-get clone-a "nested")))
    (is (= (get source-values "nested")
           (context/ctx-get clone-b "nested")))
    (is (nil? (context/ctx-get parent "branch-only")))
    (is (nil? (context/ctx-get clone-a "branch-only")))
    (is (= [:clone-b] (context/ctx-get clone-b "branch-only")))
    (is (= (get source-values "nested") (get snapshot "nested")))

    (is (not (identical? (:logs @parent) (:logs @clone-a))))
    (is (not (identical? (:logs @parent) (:logs @clone-b))))
    (is (not (identical? (:logs @clone-a) (:logs @clone-b))))
    (context/ctx-append-log! clone-a "clone-a-only")
    (context/ctx-append-log! clone-b "clone-b-only")
    (context/ctx-append-log! parent "parent-only")
    (is (= ["parent-before-copy" "parent-only"] (:logs @parent)))
    (is (= ["parent-before-copy" "clone-a-only"] (:logs @clone-a)))
    (is (= ["parent-before-copy" "clone-b-only"] (:logs @clone-b)))))

(deftest snapshots-and-clones-reject-unsupported-values-at-exact-paths
  (let [root-opaque (atom :root)
        nested-opaque (atom :nested)
        vector-opaque (fn [] :vector)
        list-opaque (atom :list)
        top-key-opaque (atom :top-key)
        map-key-opaque (atom :map-key)
        set-member-opaque (atom :set-member)
        cases
        [{:label "root value"
          :values {"bad" root-opaque}
          :path [:values "bad"]}
         {:label "nested map value"
          :values {"bad" {:inside nested-opaque}}
          :path [:values "bad" :inside]}
         {:label "vector index"
          :values {"bad" [:ok vector-opaque]}
          :path [:values "bad" 1]}
         {:label "list index"
          :values {"bad" (list :ok list-opaque)}
          :path [:values "bad" 1]}
         {:label "top-level map key"
          :values (hash-map top-key-opaque :value)
          :path [:values :map-key]}
         {:label "nested map key"
          :values {"bad" (hash-map map-key-opaque :value)}
          :path [:values "bad" :map-key]}
         {:label "set member"
          :values {"bad" (hash-set set-member-opaque)}
          :path [:values "bad" :set-member]}]]
    (doseq [case-data cases]
      (let [label (:label case-data)
            values (:values case-data)
            path (:path case-data)
            expected {:category :unsupported-context-value :path path}
            snapshot-data
            (thrown-data context/ctx-snapshot (context/make-context values))
            clone-data
            (thrown-data context/ctx-clone (context/make-context values))]
        (testing (str label " in ctx-snapshot")
          (is (= expected snapshot-data)))
        (testing (str label " in ctx-clone")
          (is (= expected clone-data)))))))

;; SCN-CONTEXT-ISOLATION COMPLETE
