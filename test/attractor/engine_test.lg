(ns attractor.engine-test
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.string :as str]
            [attractor.parser :as p]
            [attractor.engine :as e]
            [attractor.context :as c]
            [attractor.handlers :as h]
            [attractor.interviewer :as i]
            [attractor.agent :as agent]
            [json :as json]
            [io :as io]
            [os :as os]))

(deftest test-linear-pipeline-execution
  (let [dot "
digraph Linear {
    start [shape=Mdiamond]
    step1 [shape=box, prompt=\"Step 1\"]
    exit  [shape=Msquare]

    start -> step1 -> exit
}
"
        g (p/parse-dot dot)
        logs "test_engine_linear"
        res (e/run-pipeline g {:logs-root logs})]
    (is (= :success (:status res)))
    (is (= ["start" "step1" "exit"] (:completed_nodes res)))
    (is (= "success"
           (get (json/read-json (io/slurp (str logs "/start/status.json")))
                "outcome")))
    (os/sh "rm" "-rf" logs)))

(deftest test-human-gate-selection
  (let [dot "
digraph Review {
    start  [shape=Mdiamond]
    gate   [shape=hexagon, label=\"Choose path\", type=\"wait.human\"]
    opt_a  [shape=box, prompt=\"Option A\"]
    opt_b  [shape=box, prompt=\"Option B\"]
    exit   [shape=Msquare]

    start -> gate
    gate -> opt_a [label=\"[A] Option A\"]
    gate -> opt_b [label=\"[B] Option B\"]
    opt_a -> exit
    opt_b -> exit
}
"
        g (p/parse-dot dot)
        queue (i/make-queue-interviewer [{:value "B" :text "Option B"}])
        reg (h/make-handler-registry queue nil)
        logs "test_engine_human"
        res (e/run-pipeline g {:registry reg :logs-root logs})]
    (is (= :success (:status res)))
    (is (= ["start" "gate" "opt_b" "exit"] (:completed_nodes res)))
    (os/sh "rm" "-rf" logs)))

(deftest test-goal-gate-enforcement
  (let [dot "
digraph Gate {
    start [shape=Mdiamond]
    flaky [shape=box, prompt=\"Flaky\", goal_gate=true, retry_target=\"fix\"]
    fix   [shape=box, prompt=\"Fix\"]
    exit  [shape=Msquare]

    start -> flaky -> exit
    fix -> flaky
}
"
        g (p/parse-dot dot)
        visits (atom 0)
        flaky-backend (fn [node _prompt _ctx]
                        (if (= (:id node) "flaky")
                          (let [v (swap! visits inc)]
                            (if (= v 1)
                              {:status :fail :failure_reason "First attempt fails"}
                              {:status :success}))
                          {:status :success}))
        reg (h/make-handler-registry (i/make-auto-approve-interviewer) flaky-backend)
        logs "test_engine_gate"
        res (e/run-pipeline g {:registry reg :logs-root logs})]
    (is (= :success (:status res)))
    (is (= ["start" "flaky" "fix" "flaky" "exit"] (:completed_nodes res)))
    (os/sh "rm" "-rf" logs)))

(deftest test-pipeline-honors-cancellation-signal
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   exit [shape=Msquare]
                   start -> exit
                 }")
        cancelled (atom true)
        logs "test_engine_cancelled"
        events (atom [])
        result (e/run-pipeline graph
                               {:logs-root logs
                                :cancelled? (fn [] @cancelled)
                                :on-event (fn [event]
                                            (swap! events conj event))})]
    (is (= :cancelled (:status result)))
    (is (some #(= :pipeline.cancelled (:type %)) @events))
    (os/sh "rm" "-rf" logs)))

(deftest test-handler-cancellation-terminates-the-pipeline
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   work [type=cancel.test]
                   exit [shape=Msquare]
                   start -> work -> exit
                 }")
        registry (h/make-handler-registry)
        events (atom [])
        logs "test_engine_handler_cancelled"
        _ (h/register-handler!
            registry "cancel.test"
            (fn [_ _ _ _]
              {:status :cancelled :failure_reason "Pipeline cancelled"}))
        result (e/run-pipeline
                 graph {:registry registry
                        :logs-root logs
                        :on-event #(swap! events conj %)})]
    (is (= :cancelled (:status result)))
    (is (= ["start"] (:completed_nodes result)))
    (is (some #(= :pipeline.cancelled (:type %)) @events))
    (os/sh "rm" "-rf" logs)))

(deftest test-pipeline-retry-policy-controls-backoff-without-real-sleep
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   flaky [shape=box, max_retries=2]
                   exit [shape=Msquare]
                   start -> flaky -> exit
                 }")
        attempts (atom 0)
        delays (atom [])
        events (atom [])
        backend (fn [node _ _]
                  (if (= "flaky" (:id node))
                    (if (< (swap! attempts inc) 3)
                      {:status :retry :failure_reason "transient"}
                      {:status :success})
                    {:status :success}))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_retry_policy"
        result (e/run-pipeline
                 graph
                 {:registry registry
                  :logs-root logs
                  :retry-policy {:initial_delay_ms 10
                                 :backoff_factor 3.0
                                 :max_delay_ms 20
                                 :jitter false}
                  :sleep-fn (fn [delay] (swap! delays conj delay))
                  :on-event (fn [event] (swap! events conj event))})
        retry-events (filter #(= :stage.retrying (:type %)) @events)
        checkpoint (c/load-checkpoint (str logs "/checkpoint.edn"))]
    (is (= :success (:status result)))
    (is (= [10 20] @delays))
    (is (= [10 20] (mapv :delay_ms retry-events)))
    (is (= {"start" 0 "flaky" 0}
           (:node_retries checkpoint)))
    (os/sh "rm" "-rf" logs)))

(deftest test-terminal-handler-exception-is-not-retried
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   broken [shape=box, max_retries=3]
                   exit [shape=Msquare]
                   start -> broken -> exit
                 }")
        attempts (atom 0)
        backend (fn [node _ _]
                  (if (= "broken" (:id node))
                    (do
                      (swap! attempts inc)
                      (throw (ex-info "invalid configuration"
                                      {:category :configuration_error
                                       :retryable false})))
                    {:status :success}))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_terminal_error"
        result (e/run-pipeline
                 graph
                 {:registry registry :logs-root logs
                  :sleep-fn (fn [_] nil)})]
    (is (= :fail (:status result)))
    (is (= 1 @attempts))
    (os/sh "rm" "-rf" logs)))

(deftest test-named-retry-policies-respect-explicit-node-limits
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   work [shape=box]
                   limited [shape=box, max_retries=1]
                   exit [shape=Msquare]
                   start -> work -> limited -> exit
                 }")
        standard (e/build-retry-policy
                   (p/find-node graph "work") graph
                   {:retry-policy {:name :standard}})
        node-limited (e/build-retry-policy
                       (p/find-node graph "limited") graph
                       {:retry-policy {:name :standard}})]
    (is (= 5 (:max_attempts standard)))
    (is (= 2 (:max_attempts node-limited)))
    (is (= 300
           (e/delay-for-attempt
             1 {:initial_delay_ms 200 :backoff_factor 2.0
                :max_delay_ms 60000 :jitter true}
             (fn [] 1.0))))))

(deftest test-resume-restores-consumed-node-retries
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   work [shape=box, max_retries=2]
                   exit [shape=Msquare]
                   start -> work -> exit
                 }")
        logs "test_engine_retry_resume"
        checkpoint-path (str logs "/checkpoint.edn")
        _ (os/sh "mkdir" "-p" logs)
        _ (c/save-checkpoint
            {:timestamp "before-resume"
             :current_node "start"
             :completed_nodes ["start"]
             :node_retries {"work" 1}
             :node_outcomes {"start" {:status :success}}
             :context_values {"outcome" "success"}
             :logs []}
            checkpoint-path)
        attempts (atom 0)
        delays (atom [])
        backend (fn [node _ _]
                  (if (= "work" (:id node))
                    (do (swap! attempts inc)
                        {:status :retry :failure_reason "still transient"})
                    {:status :success}))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        result (e/resume-pipeline
                 checkpoint-path graph
                 {:registry registry :logs-root logs
                  :retry-policy {:jitter false :initial_delay_ms 1}
                  :sleep-fn (fn [delay] (swap! delays conj delay))})
        final-checkpoint (c/load-checkpoint checkpoint-path)]
    (is (= :fail (:status result)))
    (is (= 2 @attempts))
    (is (= [2] @delays) (str "restored retry delays: " @delays))
    (is (= 2 (get (:node_retries final-checkpoint) "work")))
    (os/sh "rm" "-rf" logs)))

(deftest test-resume-does-not-repeat-a-completed-failed-node
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   work [shape=box, max_retries=2]
                   exit [shape=Msquare]
                   start -> work -> exit
                 }")
        logs "test_engine_completed_failure_resume"
        checkpoint-path (str logs "/checkpoint.edn")
        _ (os/sh "mkdir" "-p" logs)
        _ (c/save-checkpoint
            {:timestamp "after-failure"
             :current_node "work"
             :completed_nodes ["start" "work"]
             :node_retries {"start" 0 "work" 2}
             :node_outcomes {"start" {:status :success}
                             "work" {:status :fail
                                     :failure_reason "max retries exceeded"}}
             :context_values {"outcome" "fail"}
             :logs []}
            checkpoint-path)
        attempts (atom 0)
        backend (fn [_ _ _]
                  (swap! attempts inc)
                  {:status :success})
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        result (e/resume-pipeline checkpoint-path graph
                                  {:registry registry :logs-root logs
                                   :sleep-fn (fn [_] nil)})]
    (is (= :fail (:status result)))
    (is (= 0 @attempts))
    (is (= ["start" "work"] (:completed_nodes result)))
    (os/sh "rm" "-rf" logs)))

(deftest test-allow-partial-resets-retry-counter
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   work [shape=box, max_retries=1, allow_partial=true]
                   exit [shape=Msquare]
                   start -> work -> exit
                 }")
        backend (fn [node _ _]
                  (if (= "work" (:id node))
                    {:status :retry :failure_reason "not complete"}
                    {:status :success}))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_allow_partial"
        result (e/run-pipeline graph {:registry registry :logs-root logs
                                      :retry-policy {:jitter false}
                                      :sleep-fn (fn [_] nil)})
        checkpoint (c/load-checkpoint (str logs "/checkpoint.edn"))]
    (is (= :success (:status result)))
    (is (= 0 (get (:node_retries checkpoint) "work")))
    (os/sh "rm" "-rf" logs)))

(deftest test-failure-routing-only-selects-explicit-fail-edge
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   broken [shape=box]
                   contextual [shape=box]
                   failed [shape=box]
                   exit [shape=Msquare]
                   start -> broken
                   broken -> contextual [condition=\"context.route=yes\", weight=10]
                   broken -> failed [condition=\"outcome=fail\", weight=0]
                   contextual -> exit
                   failed -> exit
                 }")
        ctx (c/make-context {"route" "yes"})
        backend (fn [node _ _]
                  (if (= "broken" (:id node))
                    {:status :fail :failure_reason "broken"}
                    {:status :success}))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_explicit_fail_edge"
        result (e/run-pipeline graph {:registry registry :context ctx
                                      :logs-root logs})]
    (is (= :success (:status result)))
    (is (some #{"failed"} (:completed_nodes result)))
    (is (not (some #{"contextual"} (:completed_nodes result))))
    (os/sh "rm" "-rf" logs)))

(deftest test-ordinary-failure-does-not-use-graph-goal-gate-target
  (let [graph (p/parse-dot
                "digraph G {
                   graph [retry_target=\"repair\"]
                   start [shape=Mdiamond]
                   broken [shape=box]
                   repair [shape=box]
                   exit [shape=Msquare]
                   start -> broken -> exit
                   repair -> exit
                 }")
        backend (fn [node _ _]
                  (if (= "broken" (:id node))
                    {:status :fail :failure_reason "permanent"}
                    {:status :success}))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_graph_retry_target_scope"
        result (e/run-pipeline graph {:registry registry :logs-root logs})]
    (is (= :fail (:status result)))
    (is (not (some #{"repair"} (:completed_nodes result))))
    (os/sh "rm" "-rf" logs)))

(deftest test-explicit-zero-and-legacy-graph-retry-limits
  (let [zero-graph (p/parse-dot
                     "digraph G {
                        graph [default_max_retries=0]
                        start [shape=Mdiamond]
                        work [shape=box]
                        exit [shape=Msquare]
                        start -> work -> exit
                      }")
        legacy-graph (p/parse-dot
                       "digraph G {
                          graph [default_max_retry=2]
                          start [shape=Mdiamond]
                          work [shape=box]
                          exit [shape=Msquare]
                          start -> work -> exit
                        }")]
    (is (= 1 (:max_attempts
               (e/build-retry-policy
                 (p/find-node zero-graph "work") zero-graph
                 {:retry-policy {:name :standard}}))))
    (is (= 3 (:max_attempts
               (e/build-retry-policy
                 (p/find-node legacy-graph "work") legacy-graph {}))))))

(deftest test-retryable-error-classification-accepts-portable-categories
  (is (true? (e/retryable-error?
               (ex-info "network unavailable" {:category :network-error}))))
  (is (true? (e/retryable-error?
               (ex-info "provider unavailable" {:status 599}))))
  (is (false? (e/retryable-error?
                (ex-info "invalid status" {:status 600})))))

(deftest test-subgraph-failure-uses-node-retry-target
  (let [graph (p/parse-dot
                "digraph G {
                   branch [shape=box, retry_target=\"repair\"]
                   repair [shape=box]
                   join [shape=tripleoctagon]
                   exit [shape=Msquare]
                   branch -> join
                   repair -> join
                   join -> exit
                 }")
        backend (fn [node _ _]
                  (if (= "branch" (:id node))
                    {:status :fail :failure_reason "branch failed"}
                    {:status :success}))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        result (e/execute-subgraph
                 "branch" (c/make-context) graph
                 "test_engine_subgraph_retry_target" registry (fn [_] nil)
                 {:retry-counts (atom {}) :sleep-fn (fn [_] nil)})]
    (is (= :success (:status result)))
    (is (= "join" (:boundary_node_id result)))
    (os/sh "rm" "-rf" "test_engine_subgraph_retry_target")))

(deftest test-manager-node-autostarts-a-real-child-pipeline
  (let [child-dotfile "test_engine_manager_child.dot"
        logs "test_engine_manager_parent"
        events (atom [])
        _ (io/spit child-dotfile
                   "digraph Child {
                      start [shape=Mdiamond]
                      work [shape=box]
                      exit [shape=Msquare]
                      start -> work -> exit
                    }")
        parent (p/parse-dot
                 (str "digraph Parent {
                         graph [stack.child_dotfile=\"" child-dotfile "\"]
                         start [shape=Mdiamond]
                         manager [shape=house,
                                  manager.poll_interval=\"1ms\",
                                  manager.max_cycles=100]
                         exit [shape=Msquare]
                         start -> manager -> exit
                       }"))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer)
                   (fn [_ _ _]
                     {:status :success
                      :context_updates {"child.progress" "done"}
                      :artifacts ["report.edn"]}))
        result (e/run-pipeline parent {:registry registry
                                       :logs-root logs
                                       :on-event #(swap! events conj %)})]
    (is (= :success (:status result)))
    (is (os/stat (str logs "/manager/child/checkpoint.edn")))
    (let [child-event (first (filter #(= :manager.child_event (:type %))
                                     @events))]
      (is (= "manager" (:manager_node_id child-event)))
      (is (= (str logs "/manager/child") (:child_logs child-event))))
    (is (= ["report.edn"]
           (get (:context result) "context.stack.child.artifacts")))
    (os/sh "rm" "-rf" logs)
    (os/sh "rm" "-f" child-dotfile)))

(deftest test-manager-node-can-observe-an-existing-child
  (let [parent
        (p/parse-dot
          "digraph Parent {
             start [shape=Mdiamond]
             manager [shape=house,
                      stack.child_autostart=false,
                      manager.actions=observe]
             exit [shape=Msquare]
             start -> manager -> exit
           }")
        child {:state (atom {:status :completed :outcome :success
                             :active_stage "done"})
               :context (c/make-context)
               :logs-root "test_engine_existing_child"}
        logs "test_engine_manager_existing"
        result (e/run-pipeline parent {:logs-root logs
                                       :manager-child child})]
    (is (= :success (:status result)))
    (is (= "done"
           (get (:context result) "context.stack.child.active_stage")))
    (os/sh "rm" "-rf" logs)))

(deftest test-run-pipeline-does-not-mutate-template-handler-runtimes
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   exit [shape=Msquare]
                   start -> exit
                 }")
        registry (h/make-handler-registry)
        manager-runtime (get @registry h/manager-runtime-key)
        parallel-runtime (get @registry h/parallel-executor-key)
        logs "test_engine_registry_isolation"
        result (e/run-pipeline graph {:registry registry :logs-root logs})]
    (is (= :success (:status result)))
    (is (= {} @manager-runtime))
    (is (nil? @parallel-runtime))
    (os/sh "rm" "-rf" logs)))

(deftest test-run-pipeline-preserves-registered-manager-overrides
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   manager [shape=house]
                   exit [shape=Msquare]
                   start -> manager -> exit
                 }")
        registry (h/make-handler-registry)
        _ (h/register-handler!
            registry "stack.manager_loop"
            (fn [_ _ _ _]
              {:status :success :context_updates {"manager.custom" true}}))
        logs "test_engine_manager_override"
        result (e/run-pipeline graph {:registry registry :logs-root logs})]
    (is (= :success (:status result)))
    (is (= true (get (:context result) "manager.custom")))
    (os/sh "rm" "-rf" logs)))

(deftest test-engine-resolves-fidelity-and-injects-fresh-session-preambles
  (let [graph
        (p/parse-dot
          "digraph G {
             graph [goal=\"Ship it\", default_fidelity=compact]
             start [shape=Mdiamond]
             first [shape=box, fidelity=full]
             second [shape=box, fidelity=full, thread_id=\"node-thread\"]
             exit [shape=Msquare]
             start -> first [fidelity=truncate]
             first -> second [fidelity=full, thread_id=\"edge-thread\"]
             second -> exit
           }")
        calls (atom [])
        backend
        (fn [node prompt _]
          (swap! calls conj {:id (:id node)
                             :fidelity (:resolved_fidelity node)
                             :thread (:resolved_thread_id node)
                             :prompt prompt})
          {:status :success})
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_fidelity"
        result (e/run-pipeline graph {:registry registry :logs-root logs})
        first-call (first @calls)
        second-call (second @calls)]
    (is (= :success (:status result)))
    (is (= "truncate" (:fidelity first-call)))
    (is (nil? (:thread first-call)))
    (is (str/includes? (:prompt first-call) "Pipeline Goal: Ship it"))
    (is (= "full" (:fidelity second-call)))
    (is (= "node-thread" (:thread second-call)))
    (is (= "second" (:prompt second-call)))
    (os/sh "rm" "-rf" logs)))

(deftest test-full-fidelity-reuses-agent-session-by-thread
  (let [requests (atom [])
        closed (atom 0)
        complete-fn
        (fn [request]
          (swap! requests conj request)
          {:id (str "response-" (count @requests))
           :content "ok" :tool_calls []})
        backend (agent/make-agent-codergen-backend
                  {:model "mock/test" :complete_fn complete-fn
                   :project_docs []
                   :on_event
                   (fn [event]
                     (when (= :session_end (:type event))
                       (swap! closed inc)))})
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        graph
        (p/parse-dot
          "digraph G {
             graph [default_fidelity=full]
             node [thread_id=shared]
             start [shape=Mdiamond]
             first [shape=box]
             second [shape=box]
             third [shape=box, thread_id=other]
             exit [shape=Msquare]
             start -> first -> second -> third -> exit
           }")
        logs "test_engine_full_fidelity"
        result (e/run-pipeline graph {:registry registry :logs-root logs})]
    (is (= :success (:status result)))
    (is (= 3 (count @requests)))
    (is (= 2 (count (:messages (first @requests)))))
    (is (= 4 (count (:messages (second @requests)))))
    (is (= 2 (count (:messages (nth @requests 2)))))
    (is (= 2 @closed))
    (os/sh "rm" "-rf" logs)))

(deftest test-resume-degrades-first-full-fidelity-hop
  (let [graph
        (p/parse-dot
          "digraph G {
             graph [goal=\"Resume safely\", default_fidelity=full]
             start [shape=Mdiamond]
             first [shape=box, thread_id=shared]
             second [shape=box, thread_id=shared]
             exit [shape=Msquare]
             start -> first -> second -> exit
           }")
        root "test_engine_resume_fidelity"
        checkpoint (str root "/checkpoint.edn")
        _ (os/sh "mkdir" "-p" root)
        _ (c/save-checkpoint
            {:timestamp "1"
             :current_node "first"
             :completed_nodes ["start" "first"]
             :node_retries {}
             :node_outcomes
             {"start" {:status :success}
              "first" {:status :success}}
             :context_values {"outcome" "success"}
             :logs []}
            checkpoint)
        calls (atom [])
        backend
        (fn [node prompt _]
          (swap! calls conj {:fidelity (:resolved_fidelity node)
                             :prompt prompt})
          {:status :success})
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        result (e/resume-pipeline checkpoint graph
                                  {:registry registry :logs-root root})]
    (is (= :success (:status result)))
    (is (= "summary:high" (:fidelity (first @calls))))
    (is (str/includes? (:prompt (first @calls))
                       "Comprehensive stage history"))
    (os/sh "rm" "-rf" root)))

(deftest test-parallel-branches-apply-incoming-edge-fidelity
  (let [graph
        (p/parse-dot
          "digraph G {
             graph [goal=\"Parallel context\", default_fidelity=compact]
             start [shape=Mdiamond]
             fork [shape=component]
             branch [shape=box]
             join [shape=tripleoctagon]
             exit [shape=Msquare]
             start -> fork
             fork -> branch [fidelity=truncate]
             branch -> join
             join -> exit
           }")
        calls (atom [])
        backend
        (fn [node prompt _]
          (swap! calls conj {:fidelity (:resolved_fidelity node)
                             :prompt prompt})
          {:status :success})
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_parallel_fidelity"
        result (e/run-pipeline graph {:registry registry :logs-root logs})]
    (is (= :success (:status result)))
    (is (= "truncate" (:fidelity (first @calls))))
    (is (str/includes? (:prompt (first @calls))
                       "Pipeline Goal: Parallel context"))
    (os/sh "rm" "-rf" logs)))

(deftest test-parallel-branch-uses-its-exact-fork-edge
  (let [graph
        (p/parse-dot
          "digraph G {
             graph [default_fidelity=compact]
             start [shape=Mdiamond]
             fork [shape=component]
             decoy [shape=box]
             branch [shape=box, thread_id=selected]
             join [shape=tripleoctagon]
             exit [shape=Msquare]
             start -> fork
             decoy -> branch [fidelity=truncate]
             fork -> branch [fidelity=full]
             branch -> join
             join -> exit
           }")
        seen (atom nil)
        backend (fn [node _ _]
                  (reset! seen (:resolved_fidelity node))
                  {:status :success})
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_parallel_exact_edge"
        result (e/run-pipeline graph {:registry registry :logs-root logs})]
    (is (= :success (:status result)))
    (is (= "full" @seen))
    (os/sh "rm" "-rf" logs)))

(deftest test-loop-restart-starts-fresh-full-fidelity-sessions
  (let [requests (atom [])
        closed (atom 0)
        backend
        (agent/make-agent-codergen-backend
          {:model "mock/test"
           :project_docs []
           :complete_fn
           (fn [request]
             (swap! requests conj request)
             {:id "response" :content "ok" :tool_calls []})
           :on_event
           (fn [event]
             (when (= :session_end (:type event))
               (swap! closed inc)))})
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        graph
        (p/parse-dot
          "digraph G {
             graph [default_fidelity=full, thread_id=shared]
             start [shape=Mdiamond]
             first [shape=box]
             second [shape=box]
             exit [shape=Msquare]
             start -> first
             first -> second [loop_restart=true]
             second -> exit
           }")
        root "test_engine_restart_fidelity"
        logs (str root "/run")
        result (e/run-pipeline graph {:registry registry :logs-root logs})]
    (is (= :success (:status result)))
    (is (= [2 2] (mapv (comp count :messages) @requests)))
    (is (= 2 @closed))
    (os/sh "rm" "-rf" root)))

(deftest test-retryable-agent-failure-evicts-closed-full-session
  (let [calls (atom 0)
        backend
        (agent/make-agent-codergen-backend
          {:model "mock/test"
           :project_docs []
           :complete_fn
           (fn [_]
             (let [call (swap! calls inc)]
               (if (= 1 call)
                 (throw (ex-info "temporary" {:category :network-error
                                                :retryable true}))
                 {:id "response" :content "ok" :tool_calls []})))})
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        graph
        (p/parse-dot
          "digraph G {
             graph [default_fidelity=full, thread_id=shared]
             start [shape=Mdiamond]
             work [shape=box, max_retries=1]
             exit [shape=Msquare]
             start -> work -> exit
           }")
        logs "test_engine_retry_full_session"
        result (e/run-pipeline
                 graph {:registry registry :logs-root logs
                        :sleep-fn (fn [_] nil)
                        :random-fn (fn [] 0.5)})]
    (is (= :success (:status result)))
    (is (= 2 @calls))
    (os/sh "rm" "-rf" logs)))

(deftest test-fidelity-uses-the-exact-selected-edge
  (let [graph
        (p/parse-dot
          "digraph G {
             start [shape=Mdiamond]
             first [shape=box]
             second [shape=box, thread_id=chosen]
             exit [shape=Msquare]
             start -> first
             first -> second [condition=\"context.choice=no\", fidelity=truncate]
             first -> second [condition=\"context.choice=yes\", fidelity=full]
             second -> exit
           }")
        seen (atom nil)
        backend
        (fn [node _ _]
          (if (= "first" (:id node))
            {:status :success :context_updates {"choice" "yes"}}
            (do
              (reset! seen (:resolved_fidelity node))
              {:status :success})))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_exact_fidelity_edge"
        result (e/run-pipeline graph {:registry registry :logs-root logs})]
    (is (= :success (:status result)))
    (is (= "full" @seen))
    (os/sh "rm" "-rf" logs)))
