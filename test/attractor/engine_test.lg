(ns attractor.engine-test
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.string :as str]
            [attractor.parser :as p]
            [attractor.engine :as e]
            [attractor.context :as c]
            [attractor.handlers :as h]
            [attractor.interviewer :as i]
            [attractor.agent :as agent]
            [json :as json]
            [io :as io]
            [os :as os]))

(deftest test-linear-pipeline-execution
  (let [dot "
digraph Linear {
    start [shape=Mdiamond]
    step1 [shape=box, prompt=\"Step 1\"]
    exit  [shape=Msquare]

    start -> step1 -> exit
}
"
        g (p/parse-dot dot)
        logs "test_engine_linear"
        res (e/run-pipeline g {:logs-root logs})]
    (is (= :success (:status res)))
    (is (= ["start" "step1" "exit"] (:completed_nodes res)))
    (is (= "success"
           (get (json/read-json (io/slurp (str logs "/start/status.json")))
                "outcome")))
    (os/sh "rm" "-rf" logs)))

(deftest test-human-gate-selection
  (let [dot "
digraph Review {
    start  [shape=Mdiamond]
    gate   [shape=hexagon, label=\"Choose path\", type=\"wait.human\"]
    opt_a  [shape=box, prompt=\"Option A\"]
    opt_b  [shape=box, prompt=\"Option B\"]
    exit   [shape=Msquare]

    start -> gate
    gate -> opt_a [label=\"[A] Option A\"]
    gate -> opt_b [label=\"[B] Option B\"]
    opt_a -> exit
    opt_b -> exit
}
"
        g (p/parse-dot dot)
        queue (i/make-queue-interviewer [{:value "B" :text "Option B"}])
        reg (h/make-handler-registry queue nil)
        logs "test_engine_human"
        res (e/run-pipeline g {:registry reg :logs-root logs})]
    (is (= :success (:status res)))
    (is (= ["start" "gate" "opt_b" "exit"] (:completed_nodes res)))
    (os/sh "rm" "-rf" logs)))

(deftest test-goal-gate-enforcement
  (let [dot "
digraph Gate {
    start [shape=Mdiamond]
    flaky [shape=box, prompt=\"Flaky\", goal_gate=true, retry_target=\"fix\"]
    fix   [shape=box, prompt=\"Fix\"]
    exit  [shape=Msquare]

    start -> flaky -> exit
    fix -> flaky
}
"
        g (p/parse-dot dot)
        visits (atom 0)
        flaky-backend (fn [node _prompt _ctx]
                        (if (= (:id node) "flaky")
                          (let [v (swap! visits inc)]
                            (if (= v 1)
                              {:status :fail :failure_reason "First attempt fails"}
                              {:status :success}))
                          {:status :success}))
        reg (h/make-handler-registry (i/make-auto-approve-interviewer) flaky-backend)
        logs "test_engine_gate"
        res (e/run-pipeline g {:registry reg :logs-root logs})]
    (is (= :success (:status res)))
    (is (= ["start" "flaky" "fix" "flaky" "exit"] (:completed_nodes res)))
    (os/sh "rm" "-rf" logs)))

(deftest test-pipeline-honors-cancellation-signal
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   exit [shape=Msquare]
                   start -> exit
                 }")
        cancelled (atom true)
        logs "test_engine_cancelled"
        events (atom [])
        result (e/run-pipeline graph
                               {:logs-root logs
                                :cancelled? (fn [] @cancelled)
                                :on-event (fn [event]
                                            (swap! events conj event))})]
    (is (= :cancelled (:status result)))
    (is (some #(= :pipeline.cancelled (:type %)) @events))
    (os/sh "rm" "-rf" logs)))

(deftest test-handler-cancellation-terminates-the-pipeline
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   work [type=cancel.test]
                   exit [shape=Msquare]
                   start -> work -> exit
                 }")
        registry (h/make-handler-registry)
        events (atom [])
        logs "test_engine_handler_cancelled"
        _ (h/register-handler!
            registry "cancel.test"
            (fn [_ _ _ _]
              {:status :cancelled :failure_reason "Pipeline cancelled"}))
        result (e/run-pipeline
                 graph {:registry registry
                        :logs-root logs
                        :on-event #(swap! events conj %)})]
    (is (= :cancelled (:status result)))
    (is (= ["start"] (:completed_nodes result)))
    (is (some #(= :pipeline.cancelled (:type %)) @events))
    (os/sh "rm" "-rf" logs)))

(deftest test-pipeline-retry-policy-controls-backoff-without-real-sleep
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   flaky [shape=box, max_retries=2]
                   exit [shape=Msquare]
                   start -> flaky -> exit
                 }")
        attempts (atom 0)
        delays (atom [])
        events (atom [])
        backend (fn [node _ _]
                  (if (= "flaky" (:id node))
                    (if (< (swap! attempts inc) 3)
                      {:status :retry :failure_reason "transient"}
                      {:status :success})
                    {:status :success}))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_retry_policy"
        result (e/run-pipeline
                 graph
                 {:registry registry
                  :logs-root logs
                  :retry-policy {:initial_delay_ms 10
                                 :backoff_factor 3.0
                                 :max_delay_ms 20
                                 :jitter false}
                  :sleep-fn (fn [delay] (swap! delays conj delay))
                  :on-event (fn [event] (swap! events conj event))})
        retry-events (filter #(= :stage.retrying (:type %)) @events)
        checkpoint (c/load-checkpoint (str logs "/checkpoint.edn"))]
    (is (= :success (:status result)))
    (is (= [10 20] @delays))
    (is (= [10 20] (mapv :delay_ms retry-events)))
    (is (= {"start" 0 "flaky" 0}
           (:node_retries checkpoint)))
    (os/sh "rm" "-rf" logs)))

(deftest test-terminal-handler-exception-is-not-retried
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   broken [shape=box, max_retries=3]
                   exit [shape=Msquare]
                   start -> broken -> exit
                 }")
        attempts (atom 0)
        backend (fn [node _ _]
                  (if (= "broken" (:id node))
                    (do
                      (swap! attempts inc)
                      (throw (ex-info "invalid configuration"
                                      {:category :configuration_error
                                       :retryable false})))
                    {:status :success}))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_terminal_error"
        result (e/run-pipeline
                 graph
                 {:registry registry :logs-root logs
                  :sleep-fn (fn [_] nil)})]
    (is (= :fail (:status result)))
    (is (= 1 @attempts))
    (os/sh "rm" "-rf" logs)))

(deftest test-node-timeout-signals-cooperative-handler-and-keeps-partial-updates
  (let [attempts (atom 0)
        saw-cancellation (atom false)
        cancellation-reason (atom nil)
        events (atom [])
        outcome
        (e/execute-with-retry
          (fn [node _ _ _]
            (swap! attempts inc)
            (let [cancelled? (:cancelled? node)
                  stop-at (+ (System/currentTimeMillis) 200)]
              (loop []
                (if (or (and cancelled? (cancelled?))
                        (>= (System/currentTimeMillis) stop-at))
                  (do
                    (reset! saw-cancellation (boolean (and cancelled? (cancelled?))))
                    (reset! cancellation-reason ((:cancellation_reason node)))
                    {:status :success :context_updates {"partial.output" "retained"}})
                  (do
                    (core/sleep 5)
                    (recur))))))
          {:id "timed" :timeout "20ms"}
          (c/make-context) {} "" #(swap! events conj %) {})]
    (is (= :fail (:status outcome)))
    (is (= :timeout_error (:category outcome)))
    (is (= true (:retryable outcome)))
    (is (= 1 @attempts))
    (is (true? @saw-cancellation))
    (is (= :deadline @cancellation-reason))
    (is (= {"partial.output" "retained"} (:context_updates outcome)))
    (is (= 1 (count (filter #(= :stage.started (:type %)) @events))))
    (is (empty? (filter #(= :stage.retrying (:type %)) @events)))))

(deftest test-timed-tool-node-keeps-partial-output-and-never-accepts-late-success
  (let [late-marker (str (os/temp-dir) "/attractor-engine-tool-timeout-late-"
                         (System/nanoTime))
        command (str "printf 'partial stdout\\n'; "
                     "printf 'partial stderr\\n' >&2; "
                     "sleep 1; printf late > " late-marker)
        started (System/currentTimeMillis)
        task (core/future
               (e/execute-with-retry
                 h/handle-tool
                 {:id "timed-tool"
                  :timeout "50ms"
                  :attrs {:tool_command command}}
                 (c/make-context) {} "" (fn [_] nil) {}))
        outcome (deref task 4000 ::timed-out)
        elapsed (- (System/currentTimeMillis) started)]
    (is (not= ::timed-out outcome))
    (is (< elapsed 4000))
    (is (= :fail (:status outcome)))
    (is (= :timeout_error (:category outcome)))
    (is (= true (:retryable outcome)))
    (is (= "partial stdout\n"
           (get-in outcome [:context_updates "tool.output"])))
    (is (str/includes? (get-in outcome [:context_updates "tool.error"])
                       "partial stderr"))
    (is (nil? (os/stat late-marker)))))

(deftest test-timeout-retries-use-fresh-controllers-and-report-failures-in-order
  (let [clock (atom 0)
        entry-states (atom [])
        timings (atom [])
        events (atom [])
        outcome
        (e/execute-with-retry
          (fn [node _ _ _]
            (let [attempt (inc (count @entry-states))
                  started-at @clock]
              (swap! entry-states conj
                     {:attempt attempt
                      :cancelled? ((:cancelled? node))
                      :reason ((:cancellation_reason node))})
              ;; Advance this attempt's injected clock to its deadline, then
              ;; cooperatively wait for its controller to be signalled.
              (swap! clock + 20)
              (loop []
                (if ((:cancelled? node))
                  (do
                    (swap! timings conj {:attempt attempt
                                         :started-at started-at
                                         :cancelled-at @clock
                                         :reason ((:cancellation_reason node))})
                    {:status :success
                     :context_updates {"partial.attempt" attempt}})
                  (do
                    (core/sleep 1)
                    (recur))))))
          {:id "timed-retry" :timeout 20 :max_retries 1}
          (c/make-context) {} "" #(swap! events conj %)
          {:now-ms (fn [] @clock)
           :sleep-fn (fn [_] nil)})
        failed-events (filter #(= :stage.failed (:type %)) @events)
        retry-events (filter #(= :stage.retrying (:type %)) @events)]
    (is (= :fail (:status outcome)))
    (is (= :timeout_error (:category outcome)))
    (is (= {"partial.attempt" 2} (:context_updates outcome)))
    (is (= [{:attempt 1 :cancelled? false :reason :running}
            {:attempt 2 :cancelled? false :reason :running}]
           @entry-states))
    (is (= [{:attempt 1 :started-at 0 :cancelled-at 20 :reason :deadline}
            {:attempt 2 :started-at 20 :cancelled-at 40 :reason :deadline}]
           @timings))
    (is (= 2 (count failed-events)))
    (is (= [true false] (mapv :will_retry failed-events)))
    (is (= 1 (count retry-events)))
    (is (= [:stage.started :stage.failed :stage.retrying
            :stage.started :stage.failed]
           (mapv :type @events)))))

(deftest test-pipeline-cancellation-wins-a-deadline-race-during-handler-join
  (let [clock (atom 0)
        cancelled (atom false)
        deadline-observed (promise)
        pipeline-observed (promise)
        release-handler (promise)
        attempts (atom 0)
        reason (atom nil)
        events (atom [])
        processing
        (core/future
          (e/execute-with-retry
            (fn [node _ _ _]
              (swap! attempts inc)
              (reset! clock 20)
              (loop []
                (if ((:cancelled? node))
                  (do
                    ;; The controller is at :deadline only after the engine
                    ;; begins joining this handler. Then issue cancellation.
                    (deliver deadline-observed
                             ((:cancellation_reason node)))
                    (reset! cancelled true)
                    (loop []
                      (let [state ((:cancellation_reason node))]
                        (cond
                          (= :pipeline_cancelled state)
                          (do
                            (deliver pipeline-observed state)
                            (deref release-handler 1000 :released)
                            (reset! reason state)
                            {:status :success})

                          ;; A broken controller transition must not strand
                          ;; this test's handler after its observer times out.
                          (not= ::pending
                                (deref release-handler 1 ::pending))
                          (do
                            (reset! reason state)
                            {:status :success})

                          :else
                          (recur)))))
                  (do
                    (core/sleep 1)
                    (recur)))))
            {:id "deadline-race" :timeout 20 :max_retries 1}
            (c/make-context) {} "" #(swap! events conj %)
            {:now-ms (fn [] @clock)
             :cancelled? (fn [] @cancelled)
             :sleep-fn (fn [_] nil)}))
        deadline-state (deref deadline-observed 1000 :not-observed)
        pipeline-state (deref pipeline-observed 1000 :not-observed)
        _released (deliver release-handler :released)
        outcome (deref processing 1000 :not-finished)]
    (is (= :cancelled (:status outcome)))
    (is (= 1 @attempts))
    (is (= :deadline deadline-state))
    (is (= :pipeline_cancelled pipeline-state))
    (is (= :pipeline_cancelled @reason))
    (is (empty? (filter #(= :stage.retrying (:type %)) @events)))))

(deftest test-pipeline-cancellation-from-retry-failure-skips-the-next-attempt
  (let [cancelled (atom false)
        attempts (atom 0)
        events (atom [])
        outcome
        (e/execute-with-retry
          (fn [_ _ _ _]
            (swap! attempts inc)
            (throw (ex-info "transient timeout"
                            {:category :timeout_error :retryable true})))
          {:id "cancel-between-retries" :max_retries 1}
          (c/make-context) {} ""
          (fn [event]
            (swap! events conj event)
            (when (and (= :stage.failed (:type event))
                       (:will_retry event))
              (reset! cancelled true)))
          {:cancelled? (fn [] @cancelled)
           :sleep-fn (fn [_] nil)})]
    (is (= :cancelled (:status outcome)))
    (is (= 1 @attempts))
    (is (= 1 (count (filter #(= :stage.started (:type %)) @events))))
    (is (empty? (filter #(= :stage.retrying (:type %)) @events)))))

(deftest test-explicitly-non-retryable-timeout-like-error-is-terminal
  (let [attempts (atom 0)
        events (atom [])
        outcome
        (e/execute-with-retry
          (fn [_ _ _ _]
            (swap! attempts inc)
            (throw (ex-info "request timed out"
                            {:category :timeout_error :retryable false})))
          {:id "non-retryable-timeout" :max_retries 1}
          (c/make-context) {} "" #(swap! events conj %) {})]
    (is (= :fail (:status outcome)))
    (is (= :timeout_error (:category outcome)))
    (is (= false (:retryable outcome)))
    (is (= 1 @attempts))
    (is (= [false]
           (mapv :will_retry
                 (filter #(= :stage.failed (:type %)) @events))))
    (is (empty? (filter #(= :stage.retrying (:type %)) @events)))))

(deftest test-numeric-node-timeout-is-milliseconds
  (let [saw-cancellation (atom false)
        outcome
        (e/execute-with-retry
          (fn [node _ _ _]
            (loop []
              (if ((:cancelled? node))
                (do
                  (reset! saw-cancellation true)
                  {:status :success})
                (do
                  (core/sleep 5)
                  (recur)))))
          {:id "timed" :timeout 20}
          (c/make-context) {} "" (fn [_] nil) {})]
    (is (= :fail (:status outcome)))
    (is (true? @saw-cancellation))))

(deftest test-invalid-or-non-positive-node-timeout-is-terminal-before-handler
  (doseq [timeout ["invalid" "0ms" 0 -1
                   1e100 9223372036854775807
                   "999999999999999999999999999999999999999999999999s"]]
    (let [attempts (atom 0)
          events (atom [])
          outcome
          (e/execute-with-retry
            (fn [_ _ _ _]
              (swap! attempts inc)
              {:status :success})
            {:id "invalid-timeout" :timeout timeout :max_retries 3}
            (c/make-context) {} "" #(swap! events conj %)
            {:now-ms (fn [] 1)})]
      (is (= :fail (:status outcome)))
      (is (= :configuration_error (:category outcome)))
      (is (= false (:retryable outcome)))
      (is (= 0 @attempts))
      (is (= 1 (count (filter #(= :stage.started (:type %)) @events))))
      (is (= 1 (count (filter #(= :stage.failed (:type %)) @events))))
      (is (empty? (filter #(= :stage.retrying (:type %)) @events))))))

(deftest test-node-timeout-does-not-accept-completion-after-deadline
  (let [clock (atom 0)
        outcome
        (e/execute-with-retry
          (fn [_ _ _ _]
            (reset! clock 21)
            {:status :success})
          {:id "late" :timeout 20}
          (c/make-context) {} "" (fn [_] nil) {:now-ms (fn [] @clock)})]
    (is (= :fail (:status outcome)))
    (is (= :timeout_error (:category outcome)))
    (is (= true (:retryable outcome)))))

(deftest test-pipeline-cancellation-during-timed-attempt-is-terminal-and-not-retried
  (let [cancelled (atom false)
        started (promise)
        attempts (atom 0)
        reason (atom nil)
        events (atom [])
        _ (core/future
            (deref started 1000 :not-started)
            (reset! cancelled true))
        outcome
        (e/execute-with-retry
          (fn [node _ _ _]
            (swap! attempts inc)
            (deliver started :running)
            (loop []
              (if ((:cancelled? node))
                (do
                  (reset! reason ((:cancellation_reason node)))
                  {:status :success})
                (do
                  (core/sleep 2)
                  (recur)))))
          {:id "cancelled" :timeout "100ms" :max_retries 3}
          (c/make-context) {} "" #(swap! events conj %)
          {:cancelled? (fn [] @cancelled)
           :sleep-fn (fn [_] nil)})]
    (is (= :cancelled (:status outcome)))
    (is (= 1 @attempts))
    (is (= :pipeline_cancelled @reason))
    (is (= 1 (count (filter #(= :stage.started (:type %)) @events))))
    (is (empty? (filter #(= :stage.retrying (:type %)) @events)))))

(deftest test-node-without-timeout-runs-synchronously-without-cancellation-hooks
  (let [received-node (atom nil)
        outcome
        (e/execute-with-retry
          (fn [node _ _ _]
            (reset! received-node node)
            {:status :success})
          {:id "untimed"}
          (c/make-context) {} "" (fn [_] nil) {})]
    (is (= :success (:status outcome)))
    (is (nil? (:cancelled? @received-node)))
    (is (nil? (:cancellation_reason @received-node)))))

(deftest test-named-retry-policies-respect-explicit-node-limits
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   work [shape=box]
                   limited [shape=box, max_retries=1]
                   exit [shape=Msquare]
                   start -> work -> limited -> exit
                 }")
        standard (e/build-retry-policy
                   (p/find-node graph "work") graph
                   {:retry-policy {:name :standard}})
        node-limited (e/build-retry-policy
                       (p/find-node graph "limited") graph
                       {:retry-policy {:name :standard}})]
    (is (= 5 (:max_attempts standard)))
    (is (= 2 (:max_attempts node-limited)))
    (is (= 300
           (e/delay-for-attempt
             1 {:initial_delay_ms 200 :backoff_factor 2.0
                :max_delay_ms 60000 :jitter true}
             (fn [] 1.0))))))

(deftest test-resume-restores-consumed-node-retries
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   work [shape=box, max_retries=2]
                   exit [shape=Msquare]
                   start -> work -> exit
                 }")
        logs "test_engine_retry_resume"
        checkpoint-path (str logs "/checkpoint.edn")
        _ (os/sh "mkdir" "-p" logs)
        _ (c/save-checkpoint
            {:timestamp "before-resume"
             :current_node "start"
             :completed_nodes ["start"]
             :node_retries {"work" 1}
             :node_outcomes {"start" {:status :success}}
             :context_values {"outcome" "success"}
             :logs []}
            checkpoint-path)
        attempts (atom 0)
        delays (atom [])
        backend (fn [node _ _]
                  (if (= "work" (:id node))
                    (do (swap! attempts inc)
                        {:status :retry :failure_reason "still transient"})
                    {:status :success}))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        result (e/resume-pipeline
                 checkpoint-path graph
                 {:registry registry :logs-root logs
                  :retry-policy {:jitter false :initial_delay_ms 1}
                  :sleep-fn (fn [delay] (swap! delays conj delay))})
        final-checkpoint (c/load-checkpoint checkpoint-path)]
    (is (= :fail (:status result)))
    (is (= 2 @attempts))
    (is (= [2] @delays) (str "restored retry delays: " @delays))
    (is (= 2 (get (:node_retries final-checkpoint) "work")))
    (os/sh "rm" "-rf" logs)))

(deftest test-resume-does-not-repeat-a-completed-failed-node
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   work [shape=box, max_retries=2]
                   exit [shape=Msquare]
                   start -> work -> exit
                 }")
        logs "test_engine_completed_failure_resume"
        checkpoint-path (str logs "/checkpoint.edn")
        _ (os/sh "mkdir" "-p" logs)
        _ (c/save-checkpoint
            {:timestamp "after-failure"
             :current_node "work"
             :completed_nodes ["start" "work"]
             :node_retries {"start" 0 "work" 2}
             :node_outcomes {"start" {:status :success}
                             "work" {:status :fail
                                     :failure_reason "max retries exceeded"}}
             :context_values {"outcome" "fail"}
             :logs []}
            checkpoint-path)
        attempts (atom 0)
        backend (fn [_ _ _]
                  (swap! attempts inc)
                  {:status :success})
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        result (e/resume-pipeline checkpoint-path graph
                                  {:registry registry :logs-root logs
                                   :sleep-fn (fn [_] nil)})]
    (is (= :fail (:status result)))
    (is (= 0 @attempts))
    (is (= ["start" "work"] (:completed_nodes result)))
    (os/sh "rm" "-rf" logs)))

(deftest test-allow-partial-resets-retry-counter
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   work [shape=box, max_retries=1, allow_partial=true]
                   exit [shape=Msquare]
                   start -> work -> exit
                 }")
        backend (fn [node _ _]
                  (if (= "work" (:id node))
                    {:status :retry :failure_reason "not complete"}
                    {:status :success}))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs (str (os/temp-dir) "/test_engine_allow_partial-" (random-uuid))
        result (e/run-pipeline graph {:registry registry :logs-root logs
                                      :retry-policy {:jitter false}
                                      :sleep-fn (fn [_] nil)})
        checkpoint (c/load-checkpoint (str logs "/checkpoint.edn"))]
    (is (= :success (:status result)))
    (is (= 0 (get (:node_retries checkpoint) "work")))))

(deftest test-failure-routing-only-selects-explicit-fail-edge
  (let [graph (p/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   broken [shape=box]
                   contextual [shape=box]
                   failed [shape=box]
                   exit [shape=Msquare]
                   start -> broken
                   broken -> contextual [condition=\"context.route=yes\", weight=10]
                   broken -> failed [condition=\"outcome=fail\", weight=0]
                   contextual -> exit
                   failed -> exit
                 }")
        ctx (c/make-context {"route" "yes"})
        backend (fn [node _ _]
                  (if (= "broken" (:id node))
                    {:status :fail :failure_reason "broken"}
                    {:status :success}))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_explicit_fail_edge"
        result (e/run-pipeline graph {:registry registry :context ctx
                                      :logs-root logs})]
    (is (= :success (:status result)))
    (is (some #{"failed"} (:completed_nodes result)))
    (is (not (some #{"contextual"} (:completed_nodes result))))
    (os/sh "rm" "-rf" logs)))

(deftest test-ordinary-failure-does-not-use-graph-goal-gate-target
  (let [graph (p/parse-dot
                "digraph G {
                   graph [retry_target=\"repair\"]
                   start [shape=Mdiamond]
                   broken [shape=box]
                   repair [shape=box]
                   exit [shape=Msquare]
                   start -> broken -> exit
                   repair -> exit
                 }")
        backend (fn [node _ _]
                  (if (= "broken" (:id node))
                    {:status :fail :failure_reason "permanent"}
                    {:status :success}))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_graph_retry_target_scope"
        result (e/run-pipeline graph {:registry registry :logs-root logs})]
    (is (= :fail (:status result)))
    (is (not (some #{"repair"} (:completed_nodes result))))
    (os/sh "rm" "-rf" logs)))

(deftest test-explicit-zero-and-legacy-graph-retry-limits
  (let [zero-graph (p/parse-dot
                     "digraph G {
                        graph [default_max_retries=0]
                        start [shape=Mdiamond]
                        work [shape=box]
                        exit [shape=Msquare]
                        start -> work -> exit
                      }")
        legacy-graph (p/parse-dot
                       "digraph G {
                          graph [default_max_retry=2]
                          start [shape=Mdiamond]
                          work [shape=box]
                          exit [shape=Msquare]
                          start -> work -> exit
                        }")]
    (is (= 1 (:max_attempts
               (e/build-retry-policy
                 (p/find-node zero-graph "work") zero-graph
                 {:retry-policy {:name :standard}}))))
    (is (= 3 (:max_attempts
               (e/build-retry-policy
                 (p/find-node legacy-graph "work") legacy-graph {}))))))

(deftest test-retryable-error-classification-accepts-portable-categories
  (is (true? (e/retryable-error?
               (ex-info "network unavailable" {:category :network-error}))))
  (is (true? (e/retryable-error?
               (ex-info "provider unavailable" {:status 599}))))
  (is (false? (e/retryable-error?
                (ex-info "invalid status" {:status 600})))))

(deftest test-subgraph-failure-uses-node-retry-target
  (let [graph (p/parse-dot
                "digraph G {
                   branch [shape=box, retry_target=\"repair\"]
                   repair [shape=box]
                   join [shape=tripleoctagon]
                   exit [shape=Msquare]
                   branch -> join
                   repair -> join
                   join -> exit
                 }")
        backend (fn [node _ _]
                  (if (= "branch" (:id node))
                    {:status :fail :failure_reason "branch failed"}
                    {:status :success}))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        result (e/execute-subgraph
                 "branch" (c/make-context) graph
                 "test_engine_subgraph_retry_target" registry (fn [_] nil)
                 {:retry-counts (atom {}) :sleep-fn (fn [_] nil)})]
    (is (= :success (:status result)))
    (is (= "join" (:boundary_node_id result)))
    (os/sh "rm" "-rf" "test_engine_subgraph_retry_target")))

(deftest test-manager-node-autostarts-a-real-child-pipeline
  (let [child-dotfile "test_engine_manager_child.dot"
        logs "test_engine_manager_parent"
        events (atom [])
        _ (io/spit child-dotfile
                   "digraph Child {
                      start [shape=Mdiamond]
                      work [shape=box]
                      exit [shape=Msquare]
                      start -> work -> exit
                    }")
        parent (p/parse-dot
                 (str "digraph Parent {
                         graph [stack.child_dotfile=\"" child-dotfile "\"]
                         start [shape=Mdiamond]
                         manager [shape=house,
                                  manager.poll_interval=\"1ms\",
                                  manager.max_cycles=100]
                         exit [shape=Msquare]
                         start -> manager -> exit
                       }"))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer)
                   (fn [_ _ _]
                     {:status :success
                      :context_updates {"child.progress" "done"}
                      :artifacts ["report.edn"]}))
        result (e/run-pipeline parent {:registry registry
                                       :logs-root logs
                                       :on-event #(swap! events conj %)})]
    (is (= :success (:status result)))
    (is (os/stat (str logs "/manager/child/checkpoint.edn")))
    (let [child-event (first (filter #(= :manager.child_event (:type %))
                                     @events))]
      (is (= "manager" (:manager_node_id child-event)))
      (is (= (str logs "/manager/child") (:child_logs child-event))))
    (is (= ["report.edn"]
           (get (:context result) "context.stack.child.artifacts")))
    (os/sh "rm" "-rf" logs)
    (os/sh "rm" "-f" child-dotfile)))

(deftest test-manager-node-can-observe-an-existing-child
  (let [parent
        (p/parse-dot
          "digraph Parent {
