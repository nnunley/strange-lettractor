(deftest test-parallel-branch-uses-its-exact-fork-edge
  (let [graph
        (p/parse-dot
          "digraph G {
             graph [default_fidelity=compact]
             start [shape=Mdiamond]
             fork [shape=component]
             decoy [shape=box]
             branch [shape=box, thread_id=selected]
             join [shape=tripleoctagon]
             exit [shape=Msquare]
             start -> fork
             decoy -> branch [fidelity=truncate]
             fork -> branch [fidelity=full]
             branch -> join
             join -> exit
           }")
        seen (atom nil)
        backend (fn [node _ _]
                  (reset! seen (:resolved_fidelity node))
                  {:status :success})
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_parallel_exact_edge"
        result (e/run-pipeline graph {:registry registry :logs-root logs})]
    (is (= :success (:status result)))
    (is (= "full" @seen))
    (os/sh "rm" "-rf" logs)))

(deftest test-loop-restart-starts-fresh-full-fidelity-sessions
  (let [requests (atom [])
        closed (atom 0)
        backend
        (agent/make-agent-codergen-backend
          {:model "mock/test"
           :project_docs []
           :complete_fn
           (fn [request]
             (swap! requests conj request)
             {:id "response" :content "ok" :tool_calls []})
           :on_event
           (fn [event]
             (when (= :session_end (:type event))
               (swap! closed inc)))})
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        graph
        (p/parse-dot
          "digraph G {
             graph [default_fidelity=full, thread_id=shared]
             start [shape=Mdiamond]
             first [shape=box]
             second [shape=box]
             exit [shape=Msquare]
             start -> first
             first -> second [loop_restart=true]
             second -> exit
           }")
        root "test_engine_restart_fidelity"
        logs (str root "/run")
        result (e/run-pipeline graph {:registry registry :logs-root logs})]
    (is (= :success (:status result)))
    (is (= [2 2] (mapv (comp count :messages) @requests)))
    (is (= 2 @closed))
    (os/sh "rm" "-rf" root)))

(deftest test-retryable-agent-failure-evicts-closed-full-session
  (let [calls (atom 0)
        backend
        (agent/make-agent-codergen-backend
          {:model "mock/test"
           :project_docs []
           :complete_fn
           (fn [_]
             (let [call (swap! calls inc)]
               (if (= 1 call)
                 (throw (ex-info "temporary" {:category :network-error
                                                :retryable true}))
                 {:id "response" :content "ok" :tool_calls []})))})
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        graph
        (p/parse-dot
          "digraph G {
             graph [default_fidelity=full, thread_id=shared]
             start [shape=Mdiamond]
             work [shape=box, max_retries=1]
             exit [shape=Msquare]
             start -> work -> exit
           }")
        logs "test_engine_retry_full_session"
        result (e/run-pipeline
                 graph {:registry registry :logs-root logs
                        :sleep-fn (fn [_] nil)
                        :random-fn (fn [] 0.5)})]
    (is (= :success (:status result)))
    (is (= 2 @calls))
    (os/sh "rm" "-rf" logs)))

(deftest test-fidelity-uses-the-exact-selected-edge
  (let [graph
        (p/parse-dot
          "digraph G {
             start [shape=Mdiamond]
             first [shape=box]
             second [shape=box, thread_id=chosen]
             exit [shape=Msquare]
             start -> first
             first -> second [condition=\"context.choice=no\", fidelity=truncate]
             first -> second [condition=\"context.choice=yes\", fidelity=full]
             second -> exit
           }")
        seen (atom nil)
        backend
        (fn [node _ _]
          (if (= "first" (:id node))
            {:status :success :context_updates {"choice" "yes"}}
            (do
              (reset! seen (:resolved_fidelity node))
              {:status :success})))
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_exact_fidelity_edge"
        result (e/run-pipeline graph {:registry registry :logs-root logs})]
    (is (= :success (:status result)))
    (is (= "full" @seen))
    (os/sh "rm" "-rf" logs)))
