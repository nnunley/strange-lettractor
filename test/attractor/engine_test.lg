(deftest test-engine-resolves-fidelity-and-injects-fresh-session-preambles
  (let [graph
        (p/parse-dot
          "digraph G {
             graph [goal=\"Ship it\", default_fidelity=compact]
             start [shape=Mdiamond]
             first [shape=box, fidelity=full]
             second [shape=box, fidelity=full, thread_id=\"node-thread\"]
             exit [shape=Msquare]
             start -> first [fidelity=truncate]
             first -> second [fidelity=full, thread_id=\"edge-thread\"]
             second -> exit
           }")
        calls (atom [])
        backend
        (fn [node prompt _]
          (swap! calls conj {:id (:id node)
                             :fidelity (:resolved_fidelity node)
                             :thread (:resolved_thread_id node)
                             :prompt prompt})
          {:status :success})
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        logs "test_engine_fidelity"
        result (e/run-pipeline graph {:registry registry :logs-root logs})
        first-call (first @calls)
        second-call (second @calls)]
    (is (= :success (:status result)))
    (is (= "truncate" (:fidelity first-call)))
    (is (nil? (:thread first-call)))
    (is (str/includes? (:prompt first-call) "Pipeline Goal: Ship it"))
    (is (= "full" (:fidelity second-call)))
    (is (= "node-thread" (:thread second-call)))
    (is (= "second" (:prompt second-call)))
    (os/sh "rm" "-rf" logs)))

(deftest test-full-fidelity-reuses-agent-session-by-thread
  (let [requests (atom [])
        closed (atom 0)
        complete-fn
        (fn [request]
          (swap! requests conj request)
          {:id (str "response-" (count @requests))
           :content "ok" :tool_calls []})
        backend (agent/make-agent-codergen-backend
                  {:model "mock/test" :complete_fn complete-fn
                   :project_docs []
                   :on_event
                   (fn [event]
                     (when (= :session_end (:type event))
                       (swap! closed inc)))})
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        graph
        (p/parse-dot
          "digraph G {
             graph [default_fidelity=full]
             node [thread_id=shared]
             start [shape=Mdiamond]
             first [shape=box]
             second [shape=box]
             third [shape=box, thread_id=other]
             exit [shape=Msquare]
             start -> first -> second -> third -> exit
           }")
        logs "test_engine_full_fidelity"
        result (e/run-pipeline graph {:registry registry :logs-root logs})]
    (is (= :success (:status result)))
    (is (= 3 (count @requests)))
    (is (= 2 (count (:messages (first @requests)))))
    (is (= 4 (count (:messages (second @requests)))))
    (is (= 2 (count (:messages (nth @requests 2)))))
    (is (= 2 @closed))
    (os/sh "rm" "-rf" logs)))

(deftest test-resume-degrades-first-full-fidelity-hop
  (let [graph
        (p/parse-dot
          "digraph G {
             graph [goal=\"Resume safely\", default_fidelity=full]
             start [shape=Mdiamond]
             first [shape=box, thread_id=shared]
             second [shape=box, thread_id=shared]
             exit [shape=Msquare]
             start -> first -> second -> exit
           }")
        root "test_engine_resume_fidelity"
        checkpoint (str root "/checkpoint.edn")
        _ (os/sh "mkdir" "-p" root)
        _ (c/save-checkpoint
            {:timestamp "1"
             :current_node "first"
             :completed_nodes ["start" "first"]
             :node_retries {}
             :node_outcomes
             {"start" {:status :success}
              "first" {:status :success}}
             :context_values {"outcome" "success"}
             :logs []}
            checkpoint)
        calls (atom [])
        backend
        (fn [node prompt _]
          (swap! calls conj {:fidelity (:resolved_fidelity node)
                             :prompt prompt})
          {:status :success})
        registry (h/make-handler-registry
                   (i/make-auto-approve-interviewer) backend)
        result (e/resume-pipeline checkpoint graph
                                  {:registry registry :logs-root root})]
    (is (= :success (:status result)))
    (is (= "summary:high" (:fidelity (first @calls))))
    (is (str/includes? (:prompt (first @calls))
                       "Comprehensive stage history"))
    (os/sh "rm" "-rf" root)))

