(ns attractor.google-credentials-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string :as str]
            [json :as json]
            [net :as net]
            [attractor.credentials :as credentials]
            [attractor.credentials-test :as fixture]))

(defn- complete-callback [url]
  (let [port (second (re-find #"redirect_uri=http%3a%2f%2f127.0.0.1%3a([0-9]+)" url))
        state (second (re-find #"state=([^&]+)" url))
        connection (net/dial "127.0.0.1" (Integer/parseInt port))]
    (net/write! connection (str "GET /callback?code=CODE&state=" state " HTTP/1.1\r\nHost: localhost\r\n\r\n"))
    (net/read! connection 4096)
    (net/close! connection)))

(deftest native-login-loopback-and-single-grant-write
  (let [s (fixture/store) requests (atom []) browser-urls (atom [])
        r (credentials/make-resolver
            (credentials/validate-profiles :local {"google" fixture/source})
            {:store (:ops s) :client-reader (fn [_] fixture/client)
             :open-browser (fn [url]
               (swap! browser-urls conj url)
               (complete-callback url))
             :transport (fn [req]
               (swap! requests conj req)
               {:status 200 :body (json/write-json {:access_token "access-secret"
                                                   :refresh_token "refresh-secret"
                                                   :expires_in 3600 :token_type "Bearer"
                                                   :scope "scope-a scope-b"})})})]
    (let [result (credentials/login! r "google")]
      (is (= :ready (:state result)))
      (is (not (str/includes? (pr-str result) "access-secret")))
      (is (not (str/includes? (pr-str result) "refresh-secret"))))
    (is (= 1 (count @(:writes s))))
    (is (str/includes? (first @browser-urls) "access_type=offline"))
    (is (str/includes? (first @browser-urls) "prompt=consent"))
    (is (str/includes? (:body (first @requests)) "client_secret=client-secret"))))

(deftest incomplete-login-never-writes-grant
  (doseq [[response expected-reason]
          [[{:access_token "access" :refresh_token "refresh"
             :expires_in 3600 :token_type "Bearer"} :missing-granted-scopes]
           [{:access_token "access" :expires_in 3600 :token_type "Bearer"
             :scope "scope-a scope-b"} :invalid-token-response]]]
    (let [s (fixture/store)
          r (credentials/make-resolver
              (credentials/validate-profiles :local {"google" fixture/source})
              {:store (:ops s) :client-reader (fn [_] fixture/client)
               :open-browser complete-callback
               :transport (fn [_] {:status 200 :body (json/write-json response)})})
          error (fixture/caught #(credentials/login! r "google"))]
      (is (= :credentials-google (:category (ex-data error))))
      (is (= expected-reason (:reason (ex-data error))))
      (is (empty? @(:writes s)))
      (is (= :login-required (:state (credentials/status r "google")))))))
