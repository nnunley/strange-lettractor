(ns attractor.stylesheet-test
  (:require [clojure.test :refer [deftest is testing]]
            [attractor.stylesheet :as s]
            [attractor.parser :as parser]
            [attractor.pipeline :as pipeline]
            [attractor.transforms :as transforms]))

(deftest test-stylesheet-specificity
  (testing "Resolves properties by selector specificity"
    (let [css "
        * { llm_model: claude-3-5-haiku; llm_provider: anthropic; }
        .code { llm_model: claude-3-7-sonnet; }
        #critical { llm_model: o3-mini; llm_provider: openai; }
    "
          rules (s/parse-stylesheet css)
          node-gen {:id "gen" :shape "box" :class "general"}
          node-code {:id "worker" :shape "box" :class "code"}
          node-crit {:id "critical" :shape "box" :class "code"}
          node-override {:id "worker" :shape "box" :class "code" :llm_model "custom-model"}]

      (let [r-gen (s/resolve-node-model-props node-gen rules {})]
        (is (= "claude-3-5-haiku" (:llm_model r-gen)))
        (is (= "anthropic" (:llm_provider r-gen))))

      (let [r-code (s/resolve-node-model-props node-code rules {})]
        (is (= "claude-3-7-sonnet" (:llm_model r-code)))
        (is (= "anthropic" (:llm_provider r-code))))

      (let [r-crit (s/resolve-node-model-props node-crit rules {})]
        (is (= "o3-mini" (:llm_model r-crit)))
        (is (= "openai" (:llm_provider r-crit))))

      (let [r-over (s/resolve-node-model-props node-override rules {})]
        (is (= "custom-model" (:llm_model r-over)))))))

(deftest test-invalid-stylesheet-has-no-rules
  (testing "Text without a selector block is rejected"
    (is (empty? (s/parse-stylesheet "this is not a stylesheet")))
    (is (some? (s/validate-stylesheet-syntax "this is not a stylesheet")))))

(deftest all-selector-levels-compete-through-public-preparation
  (let [prepared (pipeline/prepare
                   "digraph Cascade {
                      graph [model_stylesheet=\"#chosen { llm_model: id-model; } .fast { llm_model: class-model; } box { llm_model: shape-model; } * { llm_model: universal-model; }\"];
                      start [shape=Mdiamond];
                      shaped [shape=box]; classified [shape=box, class=fast];
                      chosen [shape=box, class=fast];
                      explicit [shape=box, class=fast, llm_model=\"explicit-model\"];
                      exit [shape=Msquare];
                      start -> shaped -> classified -> chosen -> explicit -> exit;
                    }")
        nodes (get-in prepared [:graph :nodes])]
    (is (= "universal-model" (get-in nodes ["start" :llm_model])))
    (is (= "shape-model" (get-in nodes ["shaped" :llm_model])))
    (is (= "class-model" (get-in nodes ["classified" :llm_model])))
    (is (= "id-model" (get-in nodes ["chosen" :llm_model])))
    (is (= "explicit-model" (get-in nodes ["explicit" :llm_model])))))

(deftest test-stylesheet-can-set-reasoning-effort
  (let [dot "digraph G {
               graph [model_stylesheet=\"box { reasoning_effort: low; }\"]
               task [shape=box]
             }"
        graph (-> (parser/parse-dot dot) transforms/apply-transforms)]
    (is (= "low" (:reasoning_effort (parser/find-node graph "task"))))))

(deftest malformed-stylesheets-are-rejected-in-full
  (doseq [css ["junk * { llm_model: model; }"
               "* { llm_model: model; } junk"
               "* { llm_model model; }"
               "* { llm_model: ; }"
               "* { llm_model: model llm_provider: mock; }"
               "* { unknown: value; }"
               "* { llm_model: model;; }"
               "* {}" "* { llm_model: model; } } {"
               "* { llm_model: \"unfinished; }"
               "* { llm_model: @@@; }"
               ".bad_class { llm_model: m; }"
               "* { llm_model: \"a\\qb\"; }"]]
    (is (some? (s/validate-stylesheet-syntax css)) css)
    (is (empty? (s/parse-stylesheet css)) css)))

(deftest quoted-stylesheet-values-preserve-delimiters-and-escapes
  (let [css "* { llm_model: \"vendor/a;b}c{d\\\"e\"; llm_provider: mock; } #task { reasoning_effort: low }"
        rules (s/parse-stylesheet css)]
    (is (nil? (s/validate-stylesheet-syntax css)))
    (is (= 2 (count rules)))
    (is (= "vendor/a;b}c{d\"e" (get-in (vec rules) [0 :properties :llm_model])))
    (is (= "low" (:reasoning_effort (s/resolve-node-model-props {:id "task"} rules {}))))))

(deftest public-preparation-reports-malformed-stylesheet
  (let [result (pipeline/prepare
                 "digraph G { graph [model_stylesheet=\"* { llm_model: model; } garbage\"] start [shape=Mdiamond]; exit [shape=Msquare]; start -> exit; }")]
    (is (some #(and (= "stylesheet_syntax" (:rule %)) (= :error (:severity %)))
              (:diagnostics result)))))

(deftest custom-properties-follow-stylesheet-precedence
  (let [css "* { --context-window: 8000; --reserve-tokens: 1000; } .review { --context-window: 16000; } #task { --context-window: 32000; }"
        rules (s/parse-stylesheet css)
        resolved (s/resolve-node-model-props {:id "task" :class "review" :attrs {:--reserve-tokens "2000"}}
                                           rules {:--context-window "4000" :--max-output-tokens "512"})]
    (is (nil? (s/validate-stylesheet-syntax css)))
    (is (= "32000" (:--context-window resolved)))
    (is (= "2000" (:--reserve-tokens resolved)))
    (is (= "512" (:--max-output-tokens resolved)))))

(deftest dot-custom-property-overrides-survive-preparation
  (let [prepared (pipeline/prepare
                   "digraph G { graph [model_stylesheet=\"* { --reserve-tokens: 1000; }\"]; start [shape=Mdiamond]; task [\"--reserve-tokens\"=2000]; exit [shape=Msquare]; start -> task -> exit; }")]
    (is (= 2000 (get-in prepared [:graph :nodes "task" :--reserve-tokens])))))
