(ns attractor.status-contract-test
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.string :as str]
            [clojure.core :as core]
            [attractor.engine :as engine]
            [attractor.context :as context]
            [attractor.handlers :as handlers]
            [attractor.interviewer :as interviewer]
            [attractor.parser :as parser]
            [attractor.status :as status]
            [json :as json]
            [io :as io]
            [os :as os]))

(defn- test-logs [label]
  (str (os/temp-dir) "/attractor-status-contract-" label "-"
       (System/nanoTime)))

(defn- status-path [logs node-id]
  (str logs "/" node-id "/status.json"))

(defn- write-status! [logs node-id value]
  (let [stage-dir (str logs "/" node-id)]
    (os/sh "mkdir" "-p" stage-dir)
    (io/spit (status-path logs node-id)
             (if (string? value) value (json/write-json value)))))

(defn- execute [handler node logs events]
  (engine/execute-with-retry handler node (context/make-context) {} logs
                             #(swap! events conj %)
                             {:sleep-fn (fn [_] nil)}))

;; SCN-STATUS-FILE COMPLETE
(deftest status-file-is-authoritative-and-normalized
  (let [logs (test-logs "authoritative")
        events (atom [])
        outcome
        (execute
          (fn [_ _ _ _]
            (write-status!
              logs "stage"
              "{\"outcome\":\"partial_success\",\"preferred_label\":\"Review\",\"suggested_next_ids\":[\"review\",\"done\"],\"context_updates\":{\"answer\":42},\"notes\":\"file wins\",\"unknown_field\":\"ignored\"}")
            {:status :fail :failure_reason "handler loses"})
          {:id "stage"} logs events)
        completed (first (filter #(= :stage.completed (:type %)) @events))]
    (is (= {:status :partial_success
            :preferred_label "Review"
            :suggested_next_ids ["review" "done"]
            :context_updates {"answer" 42}
            :notes "file wins"}
           outcome))
    (is (not (contains? outcome :unknown_field)))
    (is (= outcome (:outcome completed)))))

(deftest valid-handler-outcome-is-used-when-no-file-exists
  (let [logs (test-logs "handler-fallback")
        events (atom [])
        outcome (execute (fn [_ _ _ _]
                           {:status "success"
                            :preferred_label "Next"
                            :suggested_next_ids ["next"]
                            :context_updates {"source" "handler"}
                            :notes "fallback"})
                         {:id "stage"} logs events)]
    (is (= {:status :success
            :preferred_label "Next"
            :suggested_next_ids ["next"]
            :context_updates {"source" "handler"}
            :notes "fallback"}
           outcome))))

(deftest stale-status-is-cleared-before-every-attempt
  (let [logs (test-logs "stale")
        events (atom [])
        attempts (atom 0)]
    (write-status! logs "stage" {:outcome "fail" :notes "stale first attempt"})
    (let [outcome
          (execute
            (fn [_ _ _ _]
              (let [attempt (swap! attempts inc)]
                (if (= attempt 1)
                  (do
                    (write-status! logs "stage" {:outcome "retry"})
                    {:status :success})
                  {:status :success :notes "fresh handler fallback"})))
            {:id "stage" :max_retries 1} logs events)]
      (is (= 2 @attempts))
      (is (= :success (:status outcome)))
      (is (= "fresh handler fallback" (:notes outcome)))
      (is (= [:stage.started :stage.retrying :stage.started :stage.completed]
             (mapv :type @events))))))

(deftest malformed-or-invalid-status-is-a-terminal-failure
  (let [invalid-values
        ["{not-json"
         []
         {:notes "missing outcome"}
         {:outcome 3}
         {:outcome "unknown"}
         {:outcome "success" :preferred_label 1}
         {:outcome "success" :suggested_next_ids "next"}
         {:outcome "success" :suggested_next_ids ["next" 2]}
         {:outcome "success" :context_updates []}
         {:outcome "success" :notes 9}]]
    (doseq [[index invalid] (map-indexed vector invalid-values)]
      (let [logs (test-logs (str "invalid-" index))
            attempts (atom 0)
            events (atom [])
            outcome
            (execute
              (fn [_ _ _ _]
                (swap! attempts inc)
                (write-status! logs "stage" invalid)
                {:status :success})
              {:id "stage" :max_retries 2} logs events)]
        (is (= :fail (:status outcome)))
        (is (= :status_contract_error (:category outcome)))
        (is (= false (:retryable outcome)))
        (is (= 1 @attempts))
        (is (= [:stage.started :stage.failed] (mapv :type @events)))))))

;; SCN-AUTO-STATUS COMPLETE
(deftest auto-status-synthesizes-the-exact-success-outcome
  (let [logs (test-logs "auto")
        events (atom [])
        outcome (execute (fn [_ _ _ _] nil)
                         {:id "stage" :auto_status true} logs events)]
    (is (= {:status :success
            :notes "auto-status: handler completed without writing status"}
           outcome))))

(deftest missing-file-and-invalid-handler-outcome-fails-without-auto-status
  (let [logs (test-logs "missing")
        events (atom [])
        outcome (execute (fn [_ _ _ _] nil) {:id "stage"} logs events)]
    (is (= :fail (:status outcome)))
    (is (= :status_contract_error (:category outcome)))
    (is (= false (:retryable outcome)))))

(deftest cancellation-bypasses-a-conflicting-status-file
  (let [logs (test-logs "cancel")
        events (atom [])
        cancelled (atom false)
        outcome
        (engine/execute-with-retry
          (fn [_ _ _ _]
            (write-status! logs "stage" {:outcome "success" :notes "must lose"})
            (reset! cancelled true)
            {:status :success})
          {:id "stage"} (context/make-context) {} logs #(swap! events conj %)
          {:cancelled? (fn [] @cancelled)})]
    (is (= :cancelled (:status outcome)))
    (is (not= "must lose" (:notes outcome)))))

(deftest cancellation-that-arrives-during-status-resolution-wins
  (let [logs (test-logs "cancel-during-resolve")
        events (atom [])
        cancellation-checks (atom 0)
        outcome
        (engine/execute-with-retry
          (fn [_ _ _ _]
            (write-status! logs "stage" {:outcome "success" :notes "must lose"})
            {:status :success})
          {:id "stage"} (context/make-context) {} logs #(swap! events conj %)
          {:cancelled? (fn [] (>= (swap! cancellation-checks inc) 3))})]
    (is (= 3 @cancellation-checks))
    (is (= :cancelled (:status outcome)))
    (is (not= "must lose" (:notes outcome)))
    (is (empty? (filter #(= :success (:status %)) @events)))))

(deftest timeout-bypasses-a-status-file-written-by-the-handler
  (let [logs (test-logs "timeout")
        events (atom [])
        outcome
        (engine/execute-with-retry
          (fn [node _ _ _]
            (write-status! logs "stage" {:outcome "success" :notes "must lose"})
            (loop []
              (if ((:cancelled? node))
                {:status :success}
                (do (core/sleep 1) (recur)))))
          {:id "stage" :timeout "10ms"}
          (context/make-context) {} logs #(swap! events conj %) {})]
    (is (= :fail (:status outcome)))
    (is (= :timeout_error (:category outcome)))
    (is (not= "must lose" (:notes outcome)))))

(deftest handler-error-bypasses-a-status-file-written-before-throwing
  (let [logs (test-logs "error")
        events (atom [])
        attempts (atom 0)
        outcome
        (execute
          (fn [_ _ _ _]
            (swap! attempts inc)
            (write-status! logs "stage" {:outcome "success" :notes "must lose"})
            (throw (ex-info "handler failed"
                            {:category :authentication_error
                             :retryable false})))
          {:id "stage" :max_retries 2} logs events)]
    (is (= :fail (:status outcome)))
    (is (= :authentication_error (:category outcome)))
    (is (= false (:retryable outcome)))
    (is (= 1 @attempts))
    (is (not= "must lose" (:notes outcome)))
    (is (= [:stage.started :stage.failed] (mapv :type @events)))))

(deftest nested-string-context-keys-round-trip-through-codergen-status
  (let [logs (test-logs "codergen-nested-context")
        handler (handlers/make-codergen-handler
                  (fn [_ _ _]
                    {:status :success
                     :context_updates
                     {"outer" {"inner" "codergen"}}}))]
    (handler {:id "stage" :prompt "work"}
             (context/make-context) {} logs)
    (let [status (json/read-json (io/slurp (status-path logs "stage")))]
      (is (= "codergen"
             (get-in status ["context_updates" "outer" "inner"]))))))

(deftest nested-string-context-keys-round-trip-through-engine-status
  (let [logs (test-logs "engine-nested-context")
        graph (parser/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   stage [type=custom.status]
                   exit [shape=Msquare]
                   start -> stage -> exit
                 }")
        registry (handlers/make-handler-registry
                   (interviewer/make-auto-approve-interviewer) nil)]
    (handlers/register-handler!
      registry "custom.status"
      (fn [_ _ _ _]
        {:status :success
         :context_updates {"outer" {"inner" "engine"}}}))
    (engine/run-pipeline graph {:logs-root logs :registry registry})
    (let [status (json/read-json (io/slurp (status-path logs "stage")))]
      (is (= "engine"
             (get-in status ["context_updates" "outer" "inner"]))))))

(deftest status-codec-requires-an-explicit-allowed-status
  (doseq [[label outcome]
          [["nil outcome" nil]
           ["empty outcome" {}]
           ["missing keyword status" {:notes "missing"}]
           ["missing string status" {"notes" "missing"}]
           ["nil keyword status" {:status nil}]
           ["nil string status" {"status" nil}]
           ["non-string-or-keyword status" {:status 1}]
           ["invalid string status" {:status "unknown"}]
           ["invalid keyword status" {:status :skipped}]]]
    (testing label
      (let [result (try
                     {:json (status/outcome->status-json outcome)}
                     (catch Object error {:error error}))]
        (is (= :status_contract_error
               (:category (ex-data (:error result)))))
        (is (= false (:retryable (ex-data (:error result)))))
        (is (nil? (:json result)))))))

(deftest stage-artifact-writer-does-not-persist-an-implicit-success
  (let [logs (test-logs "artifact-invalid-status")
        result (try
                 (context/write-stage-artifacts logs "stage" nil nil {})
                 {:returned true}
                 (catch Object error {:error error}))]
    (is (= :status_contract_error
           (:category (ex-data (:error result)))))
    (is (= false (:retryable (ex-data (:error result)))))
    (is (nil? (os/stat (status-path logs "stage"))))))

(deftest engine-cancellation-clears-a-handler-authored-status-file
  (let [logs (test-logs "cancelled-status-audit")
        graph (parser/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   stage [type=custom.cancel]
                   exit [shape=Msquare]
                   start -> stage -> exit
                 }")
        registry (handlers/make-handler-registry)]
    (handlers/register-handler!
      registry "custom.cancel"
      (fn [_ _ _ _]
        (write-status! logs "stage"
                       {:outcome "success" :notes "stale after cancellation"})
        {:status :cancelled :failure_reason "Pipeline cancelled"}))
    (let [outcome (engine/run-pipeline graph
                                       {:logs-root logs :registry registry})]
      (is (= :cancelled (:status outcome)))
      (is (nil? (os/stat (status-path logs "stage")))))))

(deftest codergen-backend-cancellation-is-not-converted-to-failure
  (let [logs (test-logs "codergen-cancelled")
        handler (handlers/make-codergen-handler
                  (fn [_ _ _]
                    {:status :cancelled
                     :failure_reason "Pipeline cancelled"}))
        result (try
                 {:outcome (handler {:id "stage" :prompt "work"}
                                    (context/make-context) {} logs)}
                 (catch Object error {:error error}))]
    (is (nil? (:error result)))
    (is (= :cancelled (get-in result [:outcome :status])))
    (is (= "Pipeline cancelled"
           (get-in result [:outcome :failure_reason])))
    (is (nil? (os/stat (status-path logs "stage"))))))

(deftest execute-subgraph-cancellation-clears-handler-status
  (let [logs (test-logs "subgraph-cancelled-status")
        graph (parser/parse-dot
                "digraph G {
                   stage [type=custom.cancel]
                   join [shape=tripleoctagon]
                   stage -> join
                 }")
        registry (handlers/make-handler-registry)]
    (handlers/register-handler!
      registry "custom.cancel"
      (fn [_ _ _ handler-logs]
        (write-status! handler-logs "stage"
                       {:outcome "success" :notes "stale branch audit"})
        {:status :cancelled :failure_reason "Pipeline cancelled"}))
    (let [outcome (engine/execute-subgraph
                    "stage" (context/make-context) graph logs registry
                    (fn [_] nil) {})]
      (is (= :cancelled (:status outcome)))
      (is (nil? (os/stat (status-path logs "stage")))))))

(deftest main-pipeline-routes-and-persists-the-file-resolved-outcomes
  (let [logs (test-logs "main-routing")
        events (atom [])
        visited (atom [])
        graph (parser/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   file_stage [type=custom.file]
                   preferred [type=custom.preferred]
                   wrong_label [type=custom.wrong]
                   suggested [type=custom.suggested]
                   wrong_id [type=custom.wrong]
                   exit [shape=Msquare]
                   start -> file_stage
                   file_stage -> preferred [label=Review]
                   file_stage -> wrong_label [label=Wrong]
                   preferred -> suggested
                   preferred -> wrong_id
                   suggested -> exit
                   wrong_label -> exit
                   wrong_id -> exit
                 }")
        registry (handlers/make-handler-registry)]
    (handlers/register-handler!
      registry "custom.file"
      (fn [_ _ _ _]
        (swap! visited conj "file_stage")
        (write-status!
          logs "file_stage"
          "{\"outcome\":\"partial_success\",\"preferred_label\":\"Review\",\"context_updates\":{\"file.value\":42},\"notes\":\"file-authored\"}")
        {:status :fail :preferred_label "Wrong" :notes "handler loses"}))
    (handlers/register-handler!
      registry "custom.preferred"
      (fn [_ _ _ _]
        (swap! visited conj "preferred")
        (write-status!
          logs "preferred"
          "{\"outcome\":\"success\",\"suggested_next_ids\":[\"suggested\"],\"context_updates\":{\"suggested.value\":\"chosen\"},\"notes\":\"suggested route\"}")
        {:status :success :suggested_next_ids ["wrong_id"]}))
    (handlers/register-handler!
      registry "custom.suggested"
      (fn [_ _ _ _]
        (swap! visited conj "suggested")
        {:status :success :notes "chosen handler"}))
    (handlers/register-handler!
      registry "custom.wrong"
      (fn [node _ _ _]
        (swap! visited conj (:id node))
        {:status :success}))
    (let [result (engine/run-pipeline graph {:logs-root logs
                                              :registry registry
                                              :on-event #(swap! events conj %)})
          checkpoint (context/load-checkpoint (str logs "/checkpoint.edn"))
          file-outcome (get-in checkpoint [:node_outcomes "file_stage"])
          preferred-outcome (get-in checkpoint [:node_outcomes "preferred"])
          completed (filter #(= :stage.completed (:type %)) @events)]
      (is (= :success (:status result)))
      (is (= ["file_stage" "preferred" "suggested"] @visited))
      (is (= 42 (get-in result [:context "file.value"])))
      (is (= "chosen" (get-in result [:context "suggested.value"])))
      (is (= :partial_success (:status file-outcome)))
      (is (= "file-authored" (:notes file-outcome)))
      (is (= "Review" (:preferred_label file-outcome)))
      (is (= ["suggested"] (:suggested_next_ids preferred-outcome)))
      (is (= file-outcome
             (:outcome (first (filter #(= "file_stage" (:node_id %)) completed)))))
      (is (= preferred-outcome
             (:outcome (first (filter #(= "preferred" (:node_id %)) completed)))))
      (is (= "file-authored"
             (get (json/read-json (io/slurp (status-path logs "file_stage")))
                  "notes"))))))

(deftest main-pipeline-persists-canonical-handler-fallback
  (let [logs (test-logs "main-handler-fallback")
        graph (parser/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   stage [type=custom.fallback]
                   exit [shape=Msquare]
                   start -> stage -> exit
                 }")
        registry (handlers/make-handler-registry)]
    (handlers/register-handler!
      registry "custom.fallback"
      (fn [_ _ _ _]
        {:status "success"
         :preferred_label "Done"
         :suggested_next_ids ["exit"]
         :context_updates {"fallback" true}
         :notes "handler-authored"}))
    (let [result (engine/run-pipeline graph {:logs-root logs :registry registry})
          persisted (json/read-json (io/slurp (status-path logs "stage")))
          checkpoint (context/load-checkpoint (str logs "/checkpoint.edn"))]
      (is (= :success (:status result)))
      (is (= {"outcome" "success"
              "preferred_label" "Done"
              "suggested_next_ids" ["exit"]
              "context_updates" {"fallback" true}
              "notes" "handler-authored"}
             persisted))
      (is (= :success (get-in checkpoint [:node_outcomes "stage" :status])))
      (is (= "handler-authored"
             (get-in checkpoint [:node_outcomes "stage" :notes]))))))

(deftest main-pipeline-retry-does-not-reuse-the-prior-attempt-file
  (let [logs (test-logs "main-retry-freshness")
        attempts (atom 0)
        graph (parser/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   stage [type=custom.retry, max_retries=1]
                   exit [shape=Msquare]
                   start -> stage -> exit
                 }")
        registry (handlers/make-handler-registry)]
    (handlers/register-handler!
      registry "custom.retry"
      (fn [_ _ _ _]
        (if (= 1 (swap! attempts inc))
          (do (write-status! logs "stage"
                             {:outcome "retry" :notes "first attempt only"})
              {:status :fail})
          {:status :success :notes "second attempt handler"})))
    (let [result (engine/run-pipeline graph {:logs-root logs :registry registry})
          persisted (json/read-json (io/slurp (status-path logs "stage")))]
      (is (= :success (:status result)))
      (is (= 2 @attempts))
      (is (= "success" (get persisted "outcome")))
      (is (= "second attempt handler" (get persisted "notes"))))))

(deftest malformed-file-is-terminal-through-main-pipeline
  (let [logs (test-logs "main-malformed")
        attempts (atom 0)
        events (atom [])
        graph (parser/parse-dot
                "digraph G {
                   start [shape=Mdiamond]
                   stage [type=custom.invalid, max_retries=2]
                   exit [shape=Msquare]
                   start -> stage -> exit
                 }")
        registry (handlers/make-handler-registry)]
    (handlers/register-handler!
      registry "custom.invalid"
      (fn [_ _ _ _]
        (swap! attempts inc)
        (write-status! logs "stage" "{malformed")
        {:status :success}))
    (let [result (engine/run-pipeline graph {:logs-root logs
                                              :registry registry
                                              :on-event #(swap! events conj %)})
          stage-failure (first (filter #(and (= :stage.failed (:type %))
                                             (= "stage" (:node_id %)))
                                       @events))]
      (is (= :fail (:status result)))
      (is (= 1 @attempts))
      (is (= :status_contract_error
             (get-in stage-failure [:outcome :category])))
      (is (= false (get-in stage-failure [:outcome :retryable]))))))

(deftest auto-status-and-explicit-false-have-main-pipeline-parity
  (doseq [[label node-source expected-status]
          [["enabled" "node [auto_status=true] stage [type=custom.nil]" :success]
           ["explicit-false" "node [auto_status=true] stage [type=custom.nil, auto_status=false]" :fail]]]
    (let [logs (test-logs (str "main-auto-" label))
          graph (parser/parse-dot
                  (str "digraph G { " node-source
                       " start [shape=Mdiamond] exit [shape=Msquare] "
                       " start -> stage -> exit }"))
          registry (handlers/make-handler-registry)]
      (handlers/register-handler! registry "custom.nil" (fn [_ _ _ _] nil))
      (let [result (engine/run-pipeline graph {:logs-root logs :registry registry})
            persisted (json/read-json (io/slurp (status-path logs "stage")))
            checkpoint (context/load-checkpoint (str logs "/checkpoint.edn"))]
        (is (= expected-status (:status result)) label)
        (if (= :success expected-status)
          (do
            (is (= {"outcome" "success"
                    "notes" "auto-status: handler completed without writing status"}
                   persisted)))
          (do
            (is (= "fail" (get persisted "outcome")))
            (is (= :status_contract_error
                   (get-in checkpoint [:node_outcomes "stage" :category])))))))))

(deftest execute-subgraph-resolves-file-routing-context-events-and-auto-status
  (let [logs (test-logs "subgraph-contract")
        ctx (context/make-context)
        events (atom [])
        visited (atom [])
        graph (parser/parse-dot
                "digraph G {
                   stage [type=custom.file]
                   selected [type=custom.selected]
                   wrong [type=custom.wrong]
                   join [shape=tripleoctagon]
                   stage -> selected [label=Take]
                   stage -> wrong [label=Wrong]
                   selected -> join
                   wrong -> join
                 }")
        registry (handlers/make-handler-registry)]
    (handlers/register-handler!
      registry "custom.file"
      (fn [_ _ _ _]
        (write-status! logs "stage"
                       "{\"outcome\":\"success\",\"preferred_label\":\"Take\",\"context_updates\":{\"branch.value\":\"file\"},\"notes\":\"branch file\"}")
        {:status :fail :preferred_label "Wrong"}))
    (handlers/register-handler!
      registry "custom.selected"
      (fn [_ _ _ _]
        (swap! visited conj "selected")
        {:status :success :notes "selected"}))
    (handlers/register-handler!
      registry "custom.wrong"
      (fn [_ _ _ _]
        (swap! visited conj "wrong")
        {:status :success}))
    (let [result (engine/execute-subgraph
                   "stage" ctx graph logs registry
                   #(swap! events conj %) {})
          completed (first (filter #(and (= :stage.completed (:type %))
                                         (= "stage" (:node_id %)))
                                   @events))]
      (is (= :success (:status result)))
      (is (= "join" (:boundary_node_id result)))
      (is (= ["selected"] @visited))
      (is (= "file" (context/ctx-get ctx "branch.value")))
      (is (= "branch file" (get-in completed [:outcome :notes])))))
  (doseq [[label node-source expected-status]
          [["enabled" "node [auto_status=true] stage [type=custom.nil]" :success]
           ["explicit-false" "node [auto_status=true] stage [type=custom.nil, auto_status=false]" :fail]]]
    (let [logs (test-logs (str "subgraph-auto-" label))
          graph (parser/parse-dot
                  (str "digraph G { " node-source
                       " join [shape=tripleoctagon] stage -> join }"))
          registry (handlers/make-handler-registry)]
      (handlers/register-handler! registry "custom.nil" (fn [_ _ _ _] nil))
      (let [result (engine/execute-subgraph
                     "stage" (context/make-context) graph logs registry
                     (fn [_] nil) {})
            persisted (json/read-json (io/slurp (status-path logs "stage")))]
        (is (= expected-status (:status result)) label)
        (if (= :success expected-status)
          (is (= {"outcome" "success"
                  "notes" "auto-status: handler completed without writing status"}
                 persisted))
          (is (= :status_contract_error (:category result))))))))

(deftest execute-subgraph-supports-suggested-routing-and-handler-fallback
  (let [logs (test-logs "subgraph-suggested-fallback")
        visited (atom [])
        graph (parser/parse-dot
                "digraph G {
                   stage [type=custom.file]
                   fallback [type=custom.fallback]
                   wrong [type=custom.wrong]
                   join [shape=tripleoctagon]
                   stage -> wrong
                   stage -> fallback
                   fallback -> join
                   wrong -> join
                 }")
        registry (handlers/make-handler-registry)]
    (handlers/register-handler!
      registry "custom.file"
      (fn [_ _ _ _]
        (write-status! logs "stage"
                       "{\"outcome\":\"success\",\"suggested_next_ids\":[\"fallback\"],\"notes\":\"file chooses fallback\"}")
        {:status :success :suggested_next_ids ["wrong"]}))
    (handlers/register-handler!
      registry "custom.fallback"
      (fn [_ _ _ _]
        (swap! visited conj "fallback")
        {:status "success"
         :context_updates {"branch.fallback" true}
         :notes "handler fallback"}))
    (handlers/register-handler!
      registry "custom.wrong"
      (fn [_ _ _ _]
        (swap! visited conj "wrong")
        {:status :success}))
    (let [result (engine/execute-subgraph
                   "stage" (context/make-context) graph logs registry
                   (fn [_] nil) {})
          persisted (json/read-json (io/slurp (status-path logs "fallback")))]
      (is (= :success (:status result)))
      (is (= "join" (:boundary_node_id result)))
      (is (= ["fallback"] @visited))
      (is (= {"outcome" "success"
              "context_updates" {"branch.fallback" true}
              "notes" "handler fallback"}
             persisted)))))

(deftest execute-subgraph-retry-does-not-reuse-prior-status
  (let [logs (test-logs "subgraph-retry-freshness")
        attempts (atom 0)
        graph (parser/parse-dot
                "digraph G {
                   stage [type=custom.retry, max_retries=1]
                   join [shape=tripleoctagon]
                   stage -> join
                 }")
        registry (handlers/make-handler-registry)]
    (handlers/register-handler!
      registry "custom.retry"
      (fn [_ _ _ _]
        (if (= 1 (swap! attempts inc))
          (do
            (write-status! logs "stage"
                           {:outcome "retry" :notes "must not survive"})
            {:status :fail})
          {:status :success :notes "fresh handler"})))
    (let [result (engine/execute-subgraph
                   "stage" (context/make-context) graph logs registry
                   (fn [_] nil) {})
          persisted (json/read-json (io/slurp (status-path logs "stage")))]
      (is (= :success (:status result)))
      (is (= 2 @attempts))
      (is (= {"outcome" "success" "notes" "fresh handler"}
             persisted)))))

(deftest execute-subgraph-treats-malformed-and-invalid-status-as-terminal
  (doseq [[label invalid]
          [["malformed" "{malformed"]
           ["invalid" "{\"outcome\":\"success\",\"suggested_next_ids\":\"not-an-array\"}"]]]
    (let [logs (test-logs (str "subgraph-terminal-" label))
          attempts (atom 0)
          graph (parser/parse-dot
                  "digraph G {
                     stage [type=custom.invalid, max_retries=2]
                     join [shape=tripleoctagon]
                     stage -> join
                   }")
          registry (handlers/make-handler-registry)]
      (handlers/register-handler!
        registry "custom.invalid"
        (fn [_ _ _ _]
          (swap! attempts inc)
          (write-status! logs "stage" invalid)
          {:status :success}))
      (let [result (engine/execute-subgraph
                     "stage" (context/make-context) graph logs registry
                     (fn [_] nil) {})]
        (is (= :fail (:status result)) label)
        (is (= :status_contract_error (:category result)) label)
        (is (= false (:retryable result)) label)
        (is (= 1 @attempts) label)))))
