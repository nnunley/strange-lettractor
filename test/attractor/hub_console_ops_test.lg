(ns attractor.hub-console-ops-test
  (:require [clojure.test :refer [deftest is]] [clojure.core :as core]
            [clojure.string :as str] [os :as os] [io :as io]
            [attractor.hub :as hub] [attractor.execution :as execution]
            [attractor.profiles :as profiles] [attractor.handlers :as handlers]
            [attractor.interviewer :as interviewer]))

;; SCN-HUB-CONSOLE-OPS: hub-owned evaluation, workflows and external workers
;; behind the same request/event contract as agent sessions.

(defn- answer [request] {:message {:role :assistant :content (:content (last (:messages request)))}})
(defn- options []
  {:session_options {:provider_profile (profiles/make-profile {:id "fixture" :model "fixture" :supports_streaming false})
                     :execution_env (execution/make-environment {:file_exists (fn [_] false)
                                                                 :inspect_command (fn [_] {:exit_code 1 :stdout ""})})
                     :project_docs [] :complete_fn answer}
   :workflow_registry_fn (fn [_] (handlers/make-handler-registry (interviewer/make-auto-approve-interviewer) nil {}))
   :agent_commands {:claude [(let [override (os/getenv "LGX_LG")] (if (str/blank? override) "lg" override))
                              (str (os/cwd) "/test/fixtures/claude_worker.lg")]
                     :codex [(let [override (os/getenv "LGX_LG")] (if (str/blank? override) "lg" override))
                             (str (os/cwd) "/test/fixtures/codex_app_server.lg")]}
   :allow_agent_scenario true})
(defn- req [h op fields]
  (deref (hub/request! h (merge {:id (str (random-uuid)) :op op} fields)) 5000 {:error {:category :test-timeout}}))
(defn- stop [h] (when h (req h :hub/stop {})))
(defn- eval! [h fields]
  (let [r (req h :eval/submit fields)]
    (if (:error r) r (deref (:completion (:value r)) 5000 {:error {:category :test-timeout}}))))
(defn- events [h client] (:events (hub/events-since h (:client_id client) (:cursor client))))
(defn- await-true [f ms] (let [deadline (+ (System/currentTimeMillis) ms)]
                           (loop [] (cond (f) true (> (System/currentTimeMillis) deadline) false
                                          :else (do (core/sleep 5) (recur))))))

(deftest eval-persists-namespace-binds-selection-and-renders-errors
  (let [h (hub/start! (options))]
    (try
      (let [client (:value (req h :client/attach {}))
            first (eval! h {:code "(def x 41) (inc x)" :session_id "s1" :run_id nil})
            error (eval! h {:code "(undefined-fn x)"})
            second (eval! h {:code "[x *session* *run*] " :session_id "s2" :run_id "r9"})
            printed (eval! h {:code "(println \"hi\") :done"})]
        (is (= 42 (get-in first [:value :value])))
        (is (= :eval-error (get-in error [:error :category])))
        (is (str/includes? (get-in error [:error :message]) "undefined-fn"))
        (is (= [41 "s2" "r9"] (get-in second [:value :value])))
        (is (= "hi\n" (get-in printed [:value :printed])))
        (is (= :done (get-in printed [:value :value])))
        (let [evs (filter #(and (= :eval (:source %)) (= :eval_result (get-in % [:event :type]))) (events h client))]
          (is (= 4 (count evs)))
          (is (= [:ok :error :ok :ok] (mapv #(get-in % [:event :status]) evs)))
          (is (= "s2" (:session_id (nth evs 2))))))
      (finally (stop h)))))

(deftest eval-is-serialized-and-busy-rejects
  (let [h (hub/start! (options))]
    (try
      (let [slow (eval! h {:code "(sleep 300) :slow"})]
        (is (= :slow (get-in slow [:value :value]))))
      (let [slow (req h :eval/submit {:code "(sleep 300) :slow"})]
        (is (= :busy (get-in (req h :eval/submit {:code ":fast"}) [:error :category])))
        (is (= :slow (get-in (deref (:completion (:value slow)) 3000 {}) [:value :value]))))
      (finally (stop h)))))

(def ^:private dot "digraph T { graph [goal=\"hub\"] start [shape=Mdiamond] work [shape=box, label=\"Work\", prompt=\"do $goal\"] exit [shape=Msquare] start -> work -> exit }")
(defn- dot-file [root] (let [path (str root "/inline.dot")] (io/spit path dot) path))

(deftest workflow-runs-emit-identified-events-and-complete
  (let [h (hub/start! (options)) root (str/trim (:out (os/sh "/usr/bin/mktemp" "-d")))]
    (try
      (let [client (:value (req h :client/attach {}))
            run (:value (req h :workflow/run {:dot_source dot :source_path (dot-file root) :logs_root (str root "/logs")}))
            outcome (deref (:completion run) 10000 {:error {:category :test-timeout}})]
        (is (string? (:run_id run)))
        (is (= :success (get-in outcome [:value :status])) (pr-str outcome))
        (let [evs (filter #(= :workflow (:source %)) (events h client))]
          (is (every? #(= (:run_id run) (:run_id %)) evs))
          (is (some #(= :pipeline.started (get-in % [:event :type])) evs))
          (is (some #(= :pipeline.completed (get-in % [:event :type])) evs)))
        (is (= [{:run_id (:run_id run) :done true}]
               (mapv #(select-keys % [:run_id :done]) (:value (req h :workflow/list {}))))))
      (finally (stop h) (os/sh "/bin/rm" "-rf" "--" root)))))

(deftest workflow-cancel-stops-the-run-and-keeps-the-hub
  (let [entered (promise) release (promise)
        opts (assoc (options) :workflow_registry_fn
                    (fn [_] (let [registry (handlers/make-handler-registry (interviewer/make-auto-approve-interviewer) nil {})]
                              (handlers/register-handler! registry "codergen"
                                (fn [node _ _ _]
                                  (deliver entered true)
                                  (loop [] (when-not (or (realized? release) ((:cancelled? node))) (core/sleep 5) (recur)))
                                  (if ((:cancelled? node))
                                    {:status :cancelled :failure_reason "cancelled"}
                                    {:status :success})))
                              registry)))
        h (hub/start! opts) root (str/trim (:out (os/sh "/usr/bin/mktemp" "-d")))]
    (try
      (let [run (:value (req h :workflow/run {:dot_source dot :source_path (dot-file root) :logs_root (str root "/logs")}))]
        (is (true? (deref entered 3000 false)))
        (let [cancel (req h :workflow/cancel {:run_id (:run_id run)})
              outcome (deref (:completion run) 5000 {:error {:category :test-timeout}})]
          (is (nil? (:error cancel)) (pr-str cancel))
          (is (not= :test-timeout (get-in outcome [:error :category])) (pr-str outcome))
          (is (not= :success (get-in outcome [:value :status])) (pr-str outcome)))
        (is (= 42 (get-in (eval! h {:code "42"}) [:value :value])) "hub still serves requests"))
      (finally (deliver release true) (stop h) (os/sh "/bin/rm" "-rf" "--" root)))))

(deftest agent-jobs-stream-identified-events-and-report-failure
  (let [h (hub/start! (options))]
    (try
      (let [client (:value (req h :client/attach {}))
            ok (:value (req h :agent/run {:agent :claude :prompt "hello" :scenario "success" :timeout_ms 3000}))
            result (deref (:completion ok) 5000 {:error {:category :test-timeout}})]
        (is (string? (:agent_id ok)))
        (is (= "hello" (get-in result [:value :text])) (pr-str result))
        (let [evs (filter #(= :agent (:source %)) (events h client))]
          (is (every? #(= (:agent_id ok) (:agent_id %)) evs))
          (is (= ["héλ🙂"] (mapv #(get-in % [:event :text]) (filter #(= :text_delta (get-in % [:event :type])) evs)))
              (pr-str (mapv #(select-keys (:event %) [:type :text]) evs))))
        (let [bad (:value (req h :agent/run {:agent :claude :prompt "x" :scenario "error" :timeout_ms 3000}))
              failure (deref (:completion bad) 5000 {:error {:category :test-timeout}})]
          (is (= :claude-result (get-in failure [:error :category])) (pr-str failure)))
        (is (= :unknown-agent (get-in (req h :agent/run {:agent :gemini :prompt "x"}) [:error :category])))
        (let [codex (:value (req h :agent/run {:agent :codex :prompt "via hub" :scenario "agent" :timeout_ms 5000}))
              result (deref (:completion codex) 8000 {:error {:category :test-timeout}})]
          (is (= "echo: via hub" (get-in result [:value :text])) (pr-str result))
          (is (every? #(= :codex (:agent %)) (filter #(= (:agent_id codex) (:agent_id %)) (events h client)))))
        (is (= 3 (count (:value (req h :agent/list {}))))))
      (finally (stop h)))))

(deftest agent-cancel-terminates-the-process
  (let [h (hub/start! (options)) dir (str/trim (:out (os/sh "/usr/bin/mktemp" "-d"))) gate (str dir "/release")]
    (try
      (let [client (:value (req h :client/attach {}))
            w (:value (req h :agent/run {:agent :claude :prompt gate :scenario "gated" :timeout_ms 10000}))]
        (is (true? (await-true #(some (fn [e] (= :text_delta (get-in e [:event :type]))) (events h client)) 3000)))
        (is (nil? (:error (req h :agent/cancel {:agent_id (:agent_id w)}))))
        (let [outcome (deref (:completion w) 5000 {:error {:category :test-timeout}})]
          (is (contains? #{:cancelled :claude-exit :claude-protocol} (get-in outcome [:error :category])) (pr-str outcome))))
      (finally (stop h) (os/sh "/bin/rm" "-rf" "--" dir)))))

(deftest fast-failures-still-mark-entries-done
  ;; A worker or workflow that fails before its entry is registered must not
  ;; stay "running" forever.
  (let [h (hub/start! (assoc (options) :agent_commands {:claude ["/nonexistent/claude-binary"]}))]
    (try
      (let [w (:value (req h :agent/run {:agent :claude :prompt "x" :timeout_ms 2000}))]
        (is (contains? (deref (:completion w) 5000 {}) :error))
        (is (true? (await-true #(:done (first (:value (req h :agent/list {})))) 2000))))
      (let [r (:value (req h :workflow/run {:dot_source "digraph { not valid" :source_path nil :logs_root nil}))]
        (is (contains? (deref (:completion r) 5000 {}) :error))
        (is (true? (await-true #(:done (first (:value (req h :workflow/list {})))) 2000))))
      (finally (stop h)))))

(deftest eval-namespaces-are-per-hub-and-start-events-precede-results
  (let [a (hub/start! (options)) b (hub/start! (options))]
    (try
      (let [client (:value (req a :client/attach {}))]
        (eval! a {:code "(def only-in-a 1)"})
        (is (= :eval-error (get-in (eval! b {:code "only-in-a"}) [:error :category])) "definitions do not leak across hubs")
        (is (= "a" (get-in (eval! a {:code "(subs (str (:id (request! :session/open))) 0 0) \"a\"" }) [:value :value])))
        (is (= 1 (count (:value (req a :session/list {})))) "helpers act on their own hub")
        (is (= 0 (count (:value (req b :session/list {})))))
        (let [evs (filter #(= :eval (:source %)) (events a client))
              types (mapv #(get-in % [:event :type]) evs)]
          (is (= [:eval_start :eval_result] (take 2 types)) (pr-str types))))
      (finally (stop a) (stop b)))))

(deftest agent-scenario-is-ignored-unless-enabled
  (let [h (hub/start! (dissoc (options) :allow_agent_scenario))]
    (try
      (let [w (:value (req h :agent/run {:agent :claude :prompt "hello" :scenario "error" :timeout_ms 3000}))
            result (deref (:completion w) 5000 {})]
        ;; Without the scenario argument the fixture reads its default path.
        (is (not= :claude-result (get-in result [:error :category])) (pr-str result)))
      (finally (stop h)))))

;; ATTR-HUM-02 at the hub seam: human gates are questions published as hub
;; events and answered through a hub request, so no interviewer blocks stdin
;; and timeout_seconds is honored by a deadline on the answer promise.
(def ^:private gate-dot
  (str "digraph G { graph [goal=\"gate\"] start [shape=Mdiamond] "
       "gate [shape=hexagon, label=\"Ship it?\"%s] "
       "ship [shape=box, prompt=\"ship\"] hold [shape=box, prompt=\"hold\"] exit [shape=Msquare] "
       "start -> gate gate -> ship [label=\"Ship\"] gate -> hold [label=\"Hold\"] ship -> exit hold -> exit }"))
(defn- gate-options []
  (assoc (options) :workflow_registry_fn
         (fn [request] (handlers/make-handler-registry (:interviewer request) nil {}))))
(defn- started-nodes [evs]
  (set (keep #(when (= :stage.started (get-in % [:event :type])) (get-in % [:event :node_id])) evs)))
(def ^:private gate-runs (atom 0))
(defn- run-gate! [h root attrs]
  ;; Each run gets its own root: pinned publication rejects a different
  ;; workflow in an existing run root.
  (let [n (swap! gate-runs inc) path (str root "/gate-" n ".dot")]
    (io/spit path (format gate-dot attrs))
    (:value (req h :workflow/run {:dot_source (io/slurp path) :source_path path :logs_root (str root "/logs-" n)}))))

(deftest human-gate-questions-are-hub-events-answered-by-request
  (let [h (hub/start! (gate-options)) root (str/trim (:out (os/sh "/usr/bin/mktemp" "-d")))]
    (try
      (let [client (:value (req h :client/attach {})) run (run-gate! h root "")]
        (is (true? (await-true #(seq (:value (req h :question/list {}))) 3000)))
        (let [[q] (:value (req h :question/list {}))
              evs (events h client)
              question-event (first (filter #(= :question (:source %)) evs))]
          (is (= (:run_id run) (:run_id q)))
          (is (= "Ship it?" (get-in q [:question :text])))
          (is (= ["S" "H"] (mapv :key (get-in q [:question :options]))))
          (is (= (:question_id q) (:question_id question-event)))
          (is (= :unknown-question (get-in (req h :question/answer {:question_id "nope" :value "H"}) [:error :category])))
          (is (nil? (:error (req h :question/answer {:question_id (:question_id q) :value "H"}))))
          (is (= :unknown-question (get-in (req h :question/answer {:question_id (:question_id q) :value "S"}) [:error :category]))
              "an answered question cannot be answered again"))
        (let [outcome (deref (:completion run) 10000 {:error {:category :test-timeout}})
              evs (events h client)]
          (is (= :success (get-in outcome [:value :status])) (pr-str outcome))
          (is (contains? (started-nodes evs) "hold"))
          (is (not (contains? (started-nodes evs) "ship")))
          (is (some #(and (= :question (:source %)) (= :answered (get-in % [:event :type]))
                          (= "H" (get-in % [:event :answer :value]))) evs))
          (is (empty? (:value (req h :question/list {}))))))
      (finally (stop h) (os/sh "/bin/rm" "-rf" "--" root)))))

(deftest human-gate-timeout-uses-default-choice-without-blocking
  (let [h (hub/start! (gate-options)) root (str/trim (:out (os/sh "/usr/bin/mktemp" "-d")))]
    (try
      (let [client (:value (req h :client/attach {}))
            started (System/currentTimeMillis)
            run (run-gate! h root ", human.timeout_seconds=\"0.2\", human.default_choice=\"hold\"")
            outcome (deref (:completion run) 10000 {:error {:category :test-timeout}})
            evs (events h client)]
        (is (= :success (get-in outcome [:value :status])) (pr-str outcome))
        (is (< (- (System/currentTimeMillis) started) 5000))
        (is (contains? (started-nodes evs) "hold"))
        (is (some #(and (= :question (:source %)) (= :timeout (get-in % [:event :answer :value]))) evs))
        (is (some #(and (= :workflow (:source %)) (= :interview.timeout (get-in % [:event :type]))
                        (= "gate" (get-in % [:event :stage]))) evs) "§9.6 InterviewTimeout"))
      (finally (stop h) (os/sh "/bin/rm" "-rf" "--" root)))))

(deftest human-gate-timeout-without-default-retries-and-cancel-releases-the-wait
  (let [h (hub/start! (gate-options)) root (str/trim (:out (os/sh "/usr/bin/mktemp" "-d")))]
    (try
      (let [run (run-gate! h root ", human.timeout_seconds=\"0.2\", max_retries=\"0\"")
            outcome (deref (:completion run) 10000 {:error {:category :test-timeout}})]
        (is (not= :success (get-in outcome [:value :status])) (pr-str outcome))
        (is (not= :test-timeout (get-in outcome [:error :category]))))
      (let [run (run-gate! h root "")]
        (is (true? (await-true #(seq (:value (req h :question/list {}))) 3000)))
        (let [started (System/currentTimeMillis)]
          (req h :workflow/cancel {:run_id (:run_id run)})
          (let [outcome (deref (:completion run) 5000 {:error {:category :test-timeout}})]
            (is (not= :test-timeout (get-in outcome [:error :category])) "cancel releases a waiting gate")
            (is (< (- (System/currentTimeMillis) started) 3000))
            (is (empty? (:value (req h :question/list {})))))))
      (finally (stop h) (os/sh "/bin/rm" "-rf" "--" root)))))
