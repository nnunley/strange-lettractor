(ns attractor.schema-official-reference-test
  (:require [clojure.test :refer [deftest is]]
            [json :as json]
            [attractor.llm :as llm]))

(def fixture-root "test/fixtures/json-schema/")

(defn- fixture [path] (json/read-json (slurp (str fixture-root path))))

(defn- registry []
  (into (into {} (map (fn [name]
                       [(str "http://localhost:1234/draft2020-12/" name ".json")
                        (fixture (str "draft2020-12/" name ".json"))])
                     ["detached-dynamicref" "tree" "extendible-dynamic-ref"]))
        (map (fn [name]
               (let [schema (fixture (str "meta/" name ".json"))]
                 [(get schema "$id") schema]))
             ["schema" "core" "applicator" "unevaluated" "validation"
              "meta-data" "format-annotation" "content"])))

(defn- check-corpus [name]
  (let [resources (registry)]
    (doseq [group (fixture (str "draft2020-12/" name ".json"))
            example (get group "tests")]
      (let [result (llm/validate-json-schema (get example "data") (get group "schema")
                     {:schema_registry resources})]
        (is (= (get example "valid") (first result))
            (str name " / " (get group "description") " / " (get example "description")
                 " / " (pr-str result)))))))

(deftest official-static-references (check-corpus "ref"))
(deftest official-dynamic-references (check-corpus "dynamicRef"))
(deftest official-unevaluated-properties (check-corpus "unevaluatedProperties"))
(deftest official-unevaluated-items (check-corpus "unevaluatedItems"))
