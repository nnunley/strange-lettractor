(ns attractor.handlers-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.core :as core]
            [clojure.string :as str]
            [attractor.context :as context]
            [attractor.handlers :as handlers]
            [os :as os]))

(deftest test-tool-handler-evaluates-complete-command-through-shell
  (let [output-path (str (os/temp-dir) "/attractor-tool-handler-shell-" (System/nanoTime))
        command (str "printf '%s\n' 'quoted value' | tr ' ' '_' > " output-path
                     " && cat " output-path)
        result (handlers/handle-tool {:attrs {:tool_command command}} nil nil nil)]
    (is (= :success (:status result)))
    (is (= "quoted_value\n" (get-in result [:context_updates "tool.output"])))))

(deftest test-tool-handler-reports-shell-nonzero-exit
  (let [result (handlers/handle-tool
                 {:attrs {:tool_command "printf 'failed\n' >&2; exit 17"}}
                 nil nil nil)]
    (is (= :fail (:status result)))
    (is (= "Tool exited with code 17: failed\n" (:failure_reason result)))
    (is (= "failed\n" (get-in result [:context_updates "tool.error"])))))

(deftest test-tool-handler-requires-command
  (let [result (handlers/handle-tool {:attrs {}} nil nil nil)]
    (is (= :fail (:status result)))
    (is (= "No tool_command specified" (:failure_reason result)))))

(deftest test-tool-handler-admits-timeout-above-local-environment-ceiling
  (let [factory-options (atom nil)
        forwarded-timeout (atom nil)
        environment
        {:exec_command
         (fn [_command timeout-ms _working-dir _env-vars]
           (reset! forwarded-timeout timeout-ms)
           {:stdout "done" :stderr "" :exit_code 0
            :timed_out false :cancelled false})
         :cleanup (fn [] nil)}
        result
        (binding [handlers/*tool-environment-factory*
                  (fn [options]
                    (reset! factory-options options)
                    environment)]
          (handlers/handle-tool
            {:attrs {:tool_command "printf done"} :timeout "900s"}
            nil nil nil))]
    (is (= :success (:status result)))
    (is (= 900000 @forwarded-timeout))
    (is (= {:default_command_timeout_ms 900000
            :max_command_timeout_ms 900000}
           (select-keys @factory-options
                        [:default_command_timeout_ms
                         :max_command_timeout_ms])))))

(deftest test-tool-handler-rejects-invalid-timeout-when-called-directly
  (let [result
        (handlers/handle-tool
          {:attrs {:tool_command "printf unexpected"} :timeout "invalid"}
          nil nil nil)]
    (is (= :fail (:status result)))
    (is (= :configuration_error (:category result)))
    (is (= false (:retryable result)))))

(deftest test-tool-handler-times-out-with-partial-command-output
  (let [late-marker (str (os/temp-dir) "/attractor-tool-timeout-late-"
                         (System/nanoTime))
        command (str "printf 'partial stdout\\n'; "
                     "printf 'partial stderr\\n' >&2; "
                     "sleep 1; printf late > " late-marker)
        started (System/currentTimeMillis)
        task (core/future
               (handlers/handle-tool
                 {:attrs {:tool_command command} :timeout "50ms"}
                 nil nil nil))
        result (deref task 4000 ::timed-out)
        elapsed (- (System/currentTimeMillis) started)]
    (is (not= ::timed-out result))
    (is (< elapsed 4000))
    (is (= :fail (:status result)))
    (is (= :timeout_error (:category result)))
    (is (= true (:retryable result)))
    (is (= "partial stdout\n"
           (get-in result [:context_updates "tool.output"])))
    (is (str/includes? (get-in result [:context_updates "tool.error"])
                       "partial stderr"))
    (is (nil? (os/stat late-marker)))))

(deftest test-manager-loop-starts-observes-and-completes-child
  (let [started (atom [])
        observations (atom [{:status :running :active_stage "build"
                             :retry_counts {"build" 1}}
                            {:status :completed :outcome :success}])
        sleeps (atom [])
        runtime {:start-child
                 (fn [dotfile logs-root _node]
                   (swap! started conj [dotfile logs-root])
                   {:id "child-1"})
                 :observe-child
                 (fn [_]
                   (let [observation (first @observations)]
                     (swap! observations #(vec (rest %)))
                     observation))
                 :sleep-fn (fn [delay] (swap! sleeps conj delay))}
        handler (handlers/make-manager-loop-handler runtime)
        ctx (context/make-context)
        node {:id "manager"
              :attrs {:manager.poll_interval "10ms"
                      :manager.max_cycles 4
                      :manager.actions "observe,wait"}}
        graph {:attrs {:stack.child_dotfile "child.dot"}}
        result (handler node ctx graph "run")]
    (is (= :success (:status result)))
    (is (= [["child.dot" "run/manager/child"]] @started))
    (is (= [10] @sleeps))
    (is (= "completed"
           (context/ctx-get ctx "context.stack.child.status")))
    (is (= "build"
           (context/ctx-get ctx "context.stack.child.active_stage")))
    (is (= {"build" 1}
           (context/ctx-get ctx "context.stack.child.retry_counts")))))

(deftest test-manager-loop-propagates-child-failure
  (let [handler
        (handlers/make-manager-loop-handler
          {:start-child (fn [_ _ _] :child)
           :observe-child (fn [_] {:status :failed :outcome :fail
                                    :failure_reason "worker crashed"})
           :sleep-fn (fn [_] nil)})
        result (handler
                 {:id "manager" :attrs {:manager.actions "observe,wait"}}
                 (context/make-context)
                 {:attrs {:stack.child_dotfile "child.dot"}}
                 "run")]
    (is (= :fail (:status result)))
    (is (= "worker crashed" (:failure_reason result)))))

(deftest test-manager-loop-stop-condition-precedes-steering
  (let [steers (atom 0)
        sleeps (atom 0)
        handler
        (handlers/make-manager-loop-handler
          {:start-child (fn [_ _ _] :child)
           :observe-child (fn [_] {:status :running
                                    :context_updates {"progress" "done"}})
           :steer-child (fn [_ _ _] (swap! steers inc))
           :sleep-fn (fn [_] (swap! sleeps inc))})
        result
        (handler
          {:id "manager"
           :attrs {:manager.actions "observe,steer,wait"
                   :manager.stop_condition "context.progress=done"
                   :manager.max_cycles 5}}
          (context/make-context)
          {:attrs {:stack.child_dotfile "child.dot"}}
          "run")]
    (is (= :success (:status result)))
    (is (= 0 @steers))
    (is (= 0 @sleeps))))

(deftest test-manager-loop-fails-after-max-cycles
  (let [observed (atom 0)
        slept (atom [])
        handler
        (handlers/make-manager-loop-handler
          {:start-child (fn [_ _ _] :child)
           :observe-child (fn [_]
                            (swap! observed inc)
                            {:status :running})
           :sleep-fn (fn [delay] (swap! slept conj delay))})
        result
        (handler
          {:id "manager"
           :attrs {:manager.actions "observe,wait"
                   :manager.poll_interval "2ms"
                   :manager.max_cycles 3}}
          (context/make-context)
          {:attrs {:stack.child_dotfile "child.dot"}}
          "run")]
    (is (= :fail (:status result)))
    (is (= "Max cycles exceeded" (:failure_reason result)))
    (is (= 3 @observed))
    (is (= [2 2] @slept))))

(deftest test-manager-loop-does-not-steer-a-terminal-child
  (let [steers (atom 0)
        handler
        (handlers/make-manager-loop-handler
          {:start-child (fn [_ _ _] :child)
           :observe-child (fn [_] {:status :completed :outcome :success})
           :steer-child (fn [_ _ _] (swap! steers inc))})
        result
        (handler {:id "manager" :attrs {:manager.actions "observe,steer"}}
                 (context/make-context)
                 {:attrs {:stack.child_dotfile "child.dot"}}
                 "run")]
    (is (= :success (:status result)))
    (is (= 0 @steers))))

(deftest test-manager-loop-throttles-steering
  (let [steers (atom 0)
        times (atom [0 5 10])
        observations (atom [{:status :running}
                            {:status :running}
                            {:status :completed :outcome :success}])
        handler
        (handlers/make-manager-loop-handler
          {:start-child (fn [_ _ _] :child)
           :observe-child
           (fn [_]
             (let [observation (first @observations)]
               (swap! observations #(vec (rest %)))
               observation))
           :steer-child (fn [_ _ _] (swap! steers inc))
           :now-fn
           (fn []
             (let [now (first @times)]
               (swap! times #(vec (rest %)))
               now))})
        result
        (handler
          {:id "manager"
           :attrs {:manager.actions "observe,steer"
                   :manager.poll_interval "10ms"
                   :manager.max_cycles 3}}
          (context/make-context)
          {:attrs {:stack.child_dotfile "child.dot"}}
          "run")]
    (is (= :success (:status result)))
    (is (= 1 @steers))))

(deftest test-manager-loop-cancels-owned-child-when-parent-cancels
  (let [cancelled (atom false)
        stops (atom 0)
        child-cancelled (atom nil)
        handler
        (handlers/make-manager-loop-handler
          {:start-child (fn [_ _ node]
                          (reset! child-cancelled (:cancelled? node))
                          :child)
           :observe-child (fn [_] {:status :running})
           :cancelled? (fn [] @cancelled)
           :stop-child (fn [_] (swap! stops inc))
           :sleep-fn (fn [_] (reset! cancelled true))})
        result
        (handler
          {:id "manager"
           :attrs {:manager.actions "observe,wait"
                   :manager.poll_interval "1ms"}}
          (context/make-context)
          {:attrs {:stack.child_dotfile "child.dot"}}
          "run")]
    (is (= :cancelled (:status result)))
    (is (= 1 @stops))
    (is (true? (@child-cancelled)))))

(deftest test-manager-loop-combines-attempt-cancellation-with-runtime-cancellation
  (let [attempt-cancelled (atom false)
        child-cancelled (atom false)
        stops (atom 0)
        handler (handlers/make-manager-loop-handler
                  {:start-child (fn [_ _ node]
                                  (reset! child-cancelled (:cancelled? node))
                                  :child)
                   :observe-child (fn [_] {:status :running})
                   :stop-child (fn [_] (swap! stops inc))
                   :sleep-fn (fn [_] (reset! attempt-cancelled true))})
        result (handler {:id "manager"
                         :cancelled? (fn [] @attempt-cancelled)
                         :attrs {:manager.actions "observe,wait"
                                 :manager.poll_interval "1ms"}}
                        (context/make-context)
                        {:attrs {:stack.child_dotfile "child.dot"}}
                        "run")]
    (is (= :cancelled (:status result)))
    (is (= 1 @stops))
    (is (true? (@child-cancelled)))))

(deftest test-manager-loop-chunks-wait-for-attempt-cancellation
  (let [attempt-cancelled (atom false)
        child-cancelled (atom nil)
        sleeps (atom [])
        handler (handlers/make-manager-loop-handler
                  {:cancelled? (fn [] false)
                   :start-child (fn [_ _ node]
                                  (reset! child-cancelled (:cancelled? node))
                                  :child)
                   :observe-child (fn [_] {:status :running})
                   :stop-child (fn [_] nil)
                   :sleep-fn (fn [delay]
                               (swap! sleeps conj delay)
                               (reset! attempt-cancelled true))})
        result (handler {:id "manager"
                         :cancelled? (fn [] @attempt-cancelled)
                         :attrs {:manager.actions "observe,wait"
                                 :manager.poll_interval "45s"}}
                        (context/make-context)
                        {:attrs {:stack.child_dotfile "child.dot"}}
                        "run")]
    (is (= :cancelled (:status result)))
    (is (= 1 (count @sleeps)))
    (is (<= (first @sleeps) 100))
    (is (true? (@child-cancelled)))))

(deftest test-manager-loop-requires-child-runtime-and-dotfile
  (let [handler (handlers/make-manager-loop-handler {})]
    (is (= :fail
           (:status
             (handler {:id "manager" :attrs {}}
                      (context/make-context) {:attrs {}} "run"))))))

(deftest test-parallel-handler-callback-keeps-target-id-contract
  (let [received (atom [])
        handler
        (handlers/make-parallel-handler
          (fn [target-id _ _ _ _]
            (swap! received conj target-id)
            {:status :success :boundary_node_id "join"})
          false true)
        result
        (handler {:id "fork" :attrs {}}
                 (context/make-context)
                 {:edges [{:from "fork" :to "branch"}]}
                 "run")]
    (is (= :success (:status result)))
    (is (= ["branch"] @received))))

(deftest test-parallel-handler-four-argument-executor-remains-compatible
  (let [received (atom [])
        handler (handlers/make-parallel-handler
                  (fn [target-id _ _ _]
                    (swap! received conj target-id)
                    {:status :success})
                  false)
        result (handler {:id "fork" :attrs {}}
                        (context/make-context)
                        {:edges [{:from "fork" :to "branch"}]}
                        "run")]
    (is (= :success (:status result)))
    (is (= ["branch"] @received))))

(deftest test-parallel-handler-stops-scheduling-after-cancellation
  (let [cancelled (atom false)
        received (atom [])
        handler (handlers/make-parallel-handler
                  (fn [target-id _ _ _ branch-cancelled?]
                    (swap! received conj target-id)
                    (reset! cancelled true)
                    (is (true? (branch-cancelled?)))
                    {:status :success})
                  false true)
        result (handler {:id "fork"
                         :cancelled? (fn [] @cancelled)
                         :attrs {:max_parallel 1}}
                        (context/make-context)
                        {:edges [{:from "fork" :to "a"}
                                 {:from "fork" :to "b"}]}
                        "run")]
    (is (= :cancelled (:status result)))
    (is (= ["a"] @received))))

(deftest test-parallel-handler-joins-active-branch-on-cancellation
  (let [cancelled (atom false)
        started (promise)
        release (promise)
        task (core/future
               ((handlers/make-parallel-handler
                  (fn [_ _ _ _ branch-cancelled?]
                    (deliver started branch-cancelled?)
                    (loop []
                      (if (branch-cancelled?)
                        (do @release {:status :cancelled})
                        (do (core/sleep 1) (recur)))))
                  false true)
                {:id "fork" :cancelled? (fn [] @cancelled)
                 :attrs {:max_parallel 1}}
                (context/make-context)
                {:edges [{:from "fork" :to "a"}]}
                "run"))]
    (is (fn? (deref started 1000 :timeout)))
    (reset! cancelled true)
    (deliver release :released)
    (is (= :cancelled (:status (deref task 1000 :timeout))))))
