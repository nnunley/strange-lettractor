                            :registration-endpoint "http://m.example/register"))
    (let [err (try (mcp/admit-servers! (atom {:id "s" :mcp_evidence (atom [])}) ["demo"]
                                       (base-opts roots (fn [_] {}) (fn [_] "tok")))
                   (catch Object e e))]
      (is (= :mcp-manifest-invalid (:category (ex-data err)))))))

(deftest find-manifest-flags-divergence
  (let [roots (make-roots)
        access {:project-root (:project roots) :user-root (:user roots)
                :read-text (:read-text (file-access))
                :file-exists (:file-exists (file-access))}]
    (write-manifest! (:project roots) "demo"
                     (manifest-for "demo" "https://p.example/mcp" [(query-tool)]))
    (write-manifest! (:user roots) "demo"
                     (manifest-for "demo" "https://u.example/mcp" [(query-tool)]))
    (let [found (mcp/find-manifest access "demo")]
      (is (= :divergent (:cross-root found)))
      (is (= "project" (:root found))))))

(deftest refresh-token-values-are-form-encoded
  (let [seen (atom nil)
        transport (fn [request]
                    (reset! seen (:body request))
                    {:status 200 :headers {"content-type" "application/json"}
                     :body (json/write-json {:access_token "n" :expires_in 1})})
        out (mcp/refresh-access-token transport "https://api.example/t" "cid" "a/b+c@d e")]
    (is (= "n" (:access-token out)))
    (is (str/includes? @seen "refresh_token=a%2Fb%2Bc%40d%20e"))))

;; ---------------------------------------------------------------------------
;; stdio transport: manifest shapes, admission, owned-process calls.
;; ---------------------------------------------------------------------------

(defn- stdio-manifest [id command & [extra]]
  (merge {:id id :revision "2026-09-14" :name (str "Server " id)
          :description (str "Serves " id)
          :transport :stdio :command command
          :tools [{:name "quote" :description "Get a quote"
                   :class :pure-tool :side-effects :none
                   :schema {:type "object" :properties {:symbol {:type "string"}}}}]
          :resources []
          :task-types ["research"]
          :limits {:timeout-ms 15000 :max-bytes 8192}
          :provenance {:operator "test" :license "MIT"}}
         extra))

(def stdio-fixture [(str (os/cwd) "/test/fixtures/mcp_stdio_server.py")])

(deftest stdio-manifest-shape-rules
  (let [roots (make-roots)]
    (doseq [[label manifest]
            [["endpoint-forbidden"
              (assoc (stdio-manifest "demo" stdio-fixture) :endpoint "https://m.example/mcp")]
             ["env-forbidden"
              (assoc (stdio-manifest "demo" stdio-fixture) :env {"FOO" "bar"})]
             ["refresh-forbidden"
              (assoc (stdio-manifest "demo" stdio-fixture)
                     :refresh-token-env "T" :token-endpoint "https://api.example/t" :client-id "c")]
             ["empty-command"
              (assoc (stdio-manifest "demo" stdio-fixture) :command [])]
             ["blank-command-entry"
              (assoc (stdio-manifest "demo" stdio-fixture) :command [""])]
             ["command-forbidden-for-http"
              (assoc (manifest-for "demo" "https://m.example/mcp" [(query-tool)])
                     :command ["x"])]]]
      (write-manifest! (:project roots) "demo" manifest)
      (let [err (try (mcp/admit-servers! (atom {:id "s" :mcp_evidence (atom [])}) ["demo"]
                                         (base-opts roots (fn [_] {}) (fn [_] "tok")))
                     (catch Object e e))]
        (is (= :mcp-manifest-invalid (:category (ex-data err))) (str "case: " label))))))

(deftest stdio-admission-spawns-owned-process-with-pid-evidence
  (let [roots (make-roots)]
    (write-manifest! (:project roots) "demo"
                     (stdio-manifest "demo" (into ["/usr/bin/python3"] stdio-fixture)))
    (let [requests (atom [])
          session (make-session-with-mcp
                    roots requests ["demo"]
                    (fn [_] (throw (ex-info "stdio needs no HTTP" {})))
                    (fn [_] nil))]
      (try
        (let [server (first (:mcp_servers @session))]
          (is (= :stdio (:transport server)))
          (is (integer? (:server-pid server)))
          (is (pos? (:server-pid server)))
          (is (some? (profiles/registry-get
                       (get-in @session [:provider_profile :tool_registry])
                       "demo__quote"))))
        (finally (agent/close-session! session))))))

(deftest stdio-tool-call-round-trips-through-child
  (let [roots (make-roots)]
    (write-manifest! (:project roots) "demo"
                     (stdio-manifest "demo" (into ["/usr/bin/python3"] stdio-fixture)))
    (let [requests (atom [])
          session (make-session-with-mcp
                    roots requests ["demo"]
                    (fn [_] (throw (ex-info "stdio needs no HTTP" {})))
                    (fn [_] nil))]
      (try
        (let [tool (profiles/registry-get
                     (get-in @session [:provider_profile :tool_registry]) "demo__quote")
              output ((:executor tool) {:symbol "AAA"} nil)
              entry (last @(:mcp_evidence @session))]
          (is (str/includes? output "price 42 for AAA"))
          (is (str/includes? output "externally-supplied"))
          (is (= "demo" (:server entry)))
          (is (false? (:truncated entry))))
        (finally (agent/close-session! session))))))

(deftest stdio-token-env-handoff-checked-at-admission
  (let [roots (make-roots)]
    (write-manifest! (:project roots) "demo"
                     (assoc (stdio-manifest "demo" ["/bin/cat"]) :token-env "MCP_TEST_TOKEN"))
    (testing "missing token fails closed without spawning"
      (let [err (try (mcp/admit-servers! (atom {:id "s" :mcp_evidence (atom [])}) ["demo"]
                                         (base-opts roots (fn [_] {}) (fn [_] nil)))
                     (catch Object e e))]
        (is (= :mcp-auth-missing (:category (ex-data err))))))
    (testing "present token admits"
      (let [requests (atom [])
            session (make-session-with-mcp
                      roots requests ["demo"]
                      (fn [_] (throw (ex-info "no HTTP" {})))
                      (fn [_] "handoff-token"))]
        (try
          (is (= ["demo"] (mapv :server_id (:mcp_servers @session))))
          (finally (agent/close-session! session)))))))

(deftest dead-binary-admits-then-fails-fast-on-first-call
  (let [roots (make-roots)]
    (write-manifest! (:project roots) "demo"
                     (stdio-manifest "demo" ["/nonexistent-binary-xyz"]))
    (let [requests (atom [])
          session (make-session-with-mcp
                    roots requests ["demo"]
                    (fn [_] (throw (ex-info "no HTTP" {})))
                    (fn [_] nil))]
      (try
        ;; Admission succeeds (eager spawn tolerates immediate child death);
        ;; the first call fails fast, never hangs to timeout.
        (is (= ["demo"] (mapv :server_id (:mcp_servers @session))))
        (let [tool (profiles/registry-get
                     (get-in @session [:provider_profile :tool_registry]) "demo__quote")
              t0 (System/currentTimeMillis)
              err (try ((:executor tool) {:symbol "AAA"} nil) (catch Object e e))]
          (is (= :mcp-unavailable (:category (ex-data err))))
          (is (< (- (System/currentTimeMillis) t0) 10000)))
        (finally (agent/close-session! session))))))

;; ---------------------------------------------------------------------------
;; Standing requirement: tokens cached per server, reused until expiry.
;; ---------------------------------------------------------------------------

(deftest access-token-reused-across-calls-without-reacquire
  (let [roots (make-roots)]
    (write-manifest! (:project roots) "demo"
                     (manifest-for "demo" "https://m.example/mcp" [(query-tool)]))
    (let [reads (atom [])
          reader (fn [name] (swap! reads conj name) "tok-1")
          auths (atom [])
          transport (fn [request]
                      (swap! auths conj (get (:headers request) "authorization"))
                      {:status 200 :headers {"content-type" "application/json"}
                       :body (rpc-result (request-id request)
                                         {:content [{:type "text" :text "ok"}]})})
          requests (atom [])
          session (make-session-with-mcp
                    roots requests ["demo"] transport reader)]
      (try
        (let [tool (profiles/registry-get
                     (get-in @session [:provider_profile :tool_registry]) "demo__quote")]
          ((:executor tool) {:symbol "AAA"} nil)
          ((:executor tool) {:symbol "BBB"} nil)
          (is (= ["Bearer tok-1" "Bearer tok-1"] @auths))
          ;; Token read once at admission, never re-acquired per call.
          (is (= ["MCP_TEST_TOKEN"] @reads))
          (let [entries @(:mcp_evidence @session)]
            (is (= 2 (count entries)))
            (is (every? #(true? (:token-reused %)) entries))
            (is (every? #(nil? (:token-expires-at %)) entries))))
        (finally (agent/close-session! session))))))

(deftest tracked-expiry-refreshes-proactively-without-401
  (let [roots (make-roots)]
    (write-manifest! (:project roots) "demo"
                     (assoc (manifest-for "demo" "https://m.example/mcp" [(query-tool)])
                            :refresh-token-env "MCP_TEST_REFRESH"
                            :token-endpoint "https://api.example/oauth2/token/"
                            :client-id "test-public-client"))
    (let [token-hits (atom 0)
          status-401 (atom 0)
          transport (fn [request]
                      (let [url (:url request)]
                        (cond (str/includes? url "oauth2/token")
                              (do (swap! token-hits inc)
                                  {:status 200 :headers {"content-type" "application/json"}
                                   :body (json/write-json {:access_token (str "tok-" @token-hits)
                                                           :expires_in -1})})
                              (= "Bearer tok-stale" (get (:headers request) "authorization"))
                              (do (swap! status-401 inc)
                                  {:status 401 :headers {} :body "expired"})
                              :else
                              {:status 200 :headers {"content-type" "application/json"}
                               :body (call-echo request "ok")})))
          tokens {"MCP_TEST_TOKEN" "tok-stale" "MCP_TEST_REFRESH" "tok-refresh"}
          requests (atom [])
          session (make-session-with-mcp
                    roots requests ["demo"] transport #(get tokens %))]
      (try
        (let [tool (profiles/registry-get
                     (get-in @session [:provider_profile :tool_registry]) "demo__quote")]
          ;; Call 1: stale token, single 401, refresh (expires immediately).
          ((:executor tool) {:symbol "AAA"} nil)
          ;; Call 2: tracked expiry forces proactive refresh, no new 401.
          ((:executor tool) {:symbol "BBB"} nil)
          (is (= 1 @status-401))
          (is (= 2 @token-hits))
          (let [entries @(:mcp_evidence @session)
                second-entry (second entries)]
            (is (false? (:token-reused second-entry)))
            (is (some? (:token-expires-at second-entry)))))
        (finally (agent/close-session! session))))))

(deftest proactive-refresh-failure-still-audits
  (let [roots (make-roots)]
    (write-manifest! (:project roots) "demo"
                     (assoc (manifest-for "demo" "https://m.example/mcp" [(query-tool)])
                            :refresh-token-env "MCP_TEST_REFRESH"
                            :token-endpoint "https://api.example/oauth2/token/"
                            :client-id "test-public-client"))
    (let [mode (atom :seed-expired)
          transport (fn [request]
                      (let [url (:url request)]
                        (cond (str/includes? url "oauth2/token")
                              (if (= :seed-expired @mode)
                                {:status 200 :headers {"content-type" "application/json"}
                                 :body (json/write-json {:access_token "tok-1" :expires_in -1})}
                                (throw (ex-info "token endpoint down" {})))
                              (= "Bearer tok-stale" (get (:headers request) "authorization"))
                              {:status 401 :headers {} :body "expired"}
                              :else
                              {:status 200 :headers {"content-type" "application/json"}
                               :body (call-echo request "ok")})))
          tokens {"MCP_TEST_TOKEN" "tok-stale" "MCP_TEST_REFRESH" "tok-refresh"}
          requests (atom [])
          session (make-session-with-mcp
                    roots requests ["demo"] transport #(get tokens %))]
      (try
        (let [tool (profiles/registry-get
                     (get-in @session [:provider_profile :tool_registry]) "demo__quote")]
          ((:executor tool) {:symbol "AAA"} nil)
          (reset! mode :endpoint-down)
          (let [err (try ((:executor tool) {:symbol "BBB"} nil) (catch Object e e))]
            (is (= :mcp-auth-failed (:category (ex-data err))))
            (let [entries @(:mcp_evidence @session)]
              (is (= 2 (count entries)))
              (let [second-entry (second entries)]
                (is (= :error (:status second-entry)))
                (is (false? (:token-reused second-entry)))
                (is (= :mcp-auth-failed (:error-category second-entry)))))))
        (finally (agent/close-session! session))))))

(deftest concurrent-expiry-refreshes-exactly-once
  (let [roots (make-roots)]
    (write-manifest! (:project roots) "demo"
                     (assoc (manifest-for "demo" "https://m.example/mcp" [(query-tool)])
                            :refresh-token-env "MCP_TEST_REFRESH"
                            :token-endpoint "https://api.example/oauth2/token/"
                            :client-id "test-public-client"))
    (let [token-hits (atom 0)
          transport (fn [request]
                      (let [url (:url request)]
                        (cond (str/includes? url "oauth2/token")
                              (let [n (swap! token-hits inc)]
                                {:status 200 :headers {"content-type" "application/json"}
                                 :body (json/write-json {:access_token (str "tok-" n)
                                                         :expires_in (if (= 1 n) -1 3600)})})
                              (= "Bearer tok-stale" (get (:headers request) "authorization"))
                              {:status 401 :headers {} :body "expired"}
                              :else
                              {:status 200 :headers {"content-type" "application/json"}
                               :body (call-echo request "ok")})))
          tokens {"MCP_TEST_TOKEN" "tok-stale" "MCP_TEST_REFRESH" "tok-refresh"}
          requests (atom [])
          session (make-session-with-mcp
                    roots requests ["demo"] transport #(get tokens %))]
      (try
        (let [tool (profiles/registry-get
                     (get-in @session [:provider_profile :tool_registry]) "demo__quote")]
          ;; Seed tracked expiry: one 401-driven refresh that expires at once.
          ((:executor tool) {:symbol "seed"} nil)
          (is (= 1 @token-hits))
          (let [futures (mapv (fn [n]
                                (core/future
                                  (try ((:executor tool) {:symbol (str "c" n)} nil)
                                       (catch Object e e))))
                              [1 2 3 4 5])
                results (mapv #(deref % 15000 :timeout) futures)]
            (is (every? string? results))
            (is (= 2 @token-hits))
            (is (= 6 (count @(:mcp_evidence @session))))))
        (finally (agent/close-session! session))))))

;; ---------------------------------------------------------------------------
;; Keychain-backed bootstrap and token origins.
;; ---------------------------------------------------------------------------

(defn- oauth-manifest [endpoint]
  (assoc (manifest-for "demo" endpoint [(query-tool)])
         :refresh-token-env "MCP_TEST_REFRESH"
         :token-endpoint "https://api.example/oauth2/token/"
         :client-id "test-public-client"))

(defn- keychain-store-fake [stored-map]
  {:store (fn [_] nil)
   :fetch (fn [{:keys [host username]}] (get stored-map [host username]))
   :erase (fn [_] nil)})

(deftest keychain-refresh-bootstraps-without-401
  (let [roots (make-roots)]
    (write-manifest! (:project roots) "demo" (oauth-manifest "https://m.example/mcp"))
    (let [auths (atom [])
          transport (fn [request]
                      (let [url (:url request)]
                        (cond (str/includes? url "oauth2/token")
                              {:status 200 :headers {"content-type" "application/json"}
                               :body (json/write-json {:access_token "tok-keychain-boot"
                                                       :expires_in 3600})}
                              :else
                              (do (swap! auths conj (get (:headers request) "authorization"))
                                  {:status 200 :headers {"content-type" "application/json"}
                                   :body (call-echo request "ok")}))))
          store (keychain-store-fake {["api.example" "mcp:demo"] "tok-refresh-kc"})
          requests (atom [])
          session (make-session-with-mcp
                    roots requests ["demo"] transport (fn [_] nil)
                    {:credential-store store})]
      (try
        (let [tool (profiles/registry-get
                     (get-in @session [:provider_profile :tool_registry]) "demo__quote")
              output ((:executor tool) {:symbol "AAA"} nil)
              entry (last @(:mcp_evidence @session))]
          (is (str/includes? output "ok"))
          (is (= ["Bearer tok-keychain-boot"] @auths))
          (is (= "keychain" (:token-origin entry)))
          (is (false? (:token-reused entry)))
          (is (some? (:token-expires-at entry))))
        (finally (agent/close-session! session))))))

(deftest refresh-returns-rotated-refresh-token
  (let [transport (fn [_]
                    {:status 200 :headers {"content-type" "application/json"}
                     :body (json/write-json {:access_token "tok-a" :expires_in 60
                                             :refresh_token "tok-refresh-next"})})
        fresh (mcp/refresh-access-token transport "https://api.example/oauth2/token/"
                                        "cid" "tok-refresh-old")]
    (is (= "tok-a" (:access-token fresh)))
    (is (= "tok-refresh-next" (:refresh-token fresh)))))

(deftest keychain-refresh-persists-rotation-and-reads-stored-client-id
  (let [roots (make-roots)]
    ;; A dynamically registered client has no id to put in the manifest.
    (write-manifest! (:project roots) "demo"
                     (dissoc (oauth-manifest "https://m.example/mcp") :client-id))
    (let [token-bodies (atom [])
          transport (fn [request]
                      (if (str/includes? (:url request) "oauth2/token")
                        (do (swap! token-bodies conj (str (:body request)))
                            {:status 200 :headers {"content-type" "application/json"}
                             :body (json/write-json {:access_token "tok-keychain-boot"
                                                     :expires_in 3600
                                                     :refresh_token "tok-refresh-rotated"})})
                        {:status 200 :headers {"content-type" "application/json"}
                         :body (call-echo request "ok")}))
          writes (atom [])
          store (assoc (keychain-store-fake {["api.example" "mcp:demo"] "tok-refresh-kc"
                                             ["api.example" "mcp:demo:client-id"] "cid-registered"})
                       :store (fn [entry] (swap! writes conj entry) nil))
          requests (atom [])
          session (make-session-with-mcp
                    roots requests ["demo"] transport (fn [_] nil)
                    {:credential-store store})]
      (try
        (let [tool (profiles/registry-get
                     (get-in @session [:provider_profile :tool_registry]) "demo__quote")
              output ((:executor tool) {:symbol "AAA"} nil)]
          (is (str/includes? output "ok"))
          (is (str/includes? (first @token-bodies) "client_id=cid-registered"))
          (is (= [{:host "api.example" :username "mcp:demo" :secret "tok-refresh-rotated"}]
                 @writes))
          (is (not (str/includes? (pr-str @(:mcp_evidence @session)) "tok-refresh"))))
        (finally (agent/close-session! session))))))

(deftest broken-keychain-helper-fails-closed-at-admission
  (let [roots (make-roots)]
    (write-manifest! (:project roots) "demo" (oauth-manifest "https://m.example/mcp"))
    (let [store {:store (fn [_] nil)
                 :fetch (fn [_] (throw (ex-info "keychain down" {})))
                 :erase (fn [_] nil)}
          requests (atom [])
          err (try (make-session-with-mcp
                     roots requests ["demo"]
                     (fn [_] {:status 200 :headers {} :body "{}"})
                     (fn [_] nil)
                     {:credential-store store})
                   (catch Object e e))]
      (is (= :auth-store-failed (:category (ex-data err)))))))

(deftest env-token-records-environment-origin
  (let [roots (make-roots)]
    (write-manifest! (:project roots) "demo" (oauth-manifest "https://m.example/mcp"))
    (let [requests (atom [])
          session (make-session-with-mcp
                    roots requests ["demo"]
                    (json-transport (atom []) (rpc-result 1 {:content [{:type "text" :text "ok"}]}))
                    (fn [name] (get {"MCP_TEST_TOKEN" "tok-env"} name)))]
      (try
        (let [tool (profiles/registry-get
                     (get-in @session [:provider_profile :tool_registry]) "demo__quote")]
          ((:executor tool) {:symbol "AAA"} nil)
          (let [entry (last @(:mcp_evidence @session))]
            (is (= "environment" (:token-origin entry)))
            (is (true? (:token-reused entry)))))
        (finally (agent/close-session! session))))))

(deftest handoff-overrides-carry-store-and-registration
  (let [roots (make-roots)]
    (write-manifest! (:project roots) "demo"
                     (-> (manifest-for "demo" "https://m.example/mcp" [(query-tool)])
                         (dissoc :token-env)
                         (assoc :registration-endpoint "https://api.example/reg"
                                :client-id "cid-9"
                                :scope "internal")))
    (let [seen (atom nil)
          authorizer (fn [_ _ descriptor opts]
                       (reset! seen {:descriptor descriptor :opts opts})
                       {:access-token "tok-h" :refresh-token nil :expires-in 100})
          requests (atom [])
          profile (profiles/make-profile {:id "custom" :model "test" :supports_streaming false})
          session (agent/make-session
                    {:provider_profile profile :execution_env (journey-env)
                     :max_subagent_depth 0 :project_docs []
                     :complete_fn (fn [request]
                                    (swap! requests conj request)
                                    {:message {:role :assistant :content "done"} :tool_calls []})})
          out (mcp/admit-servers!
                session ["demo"]
                (assoc (base-opts roots (fn [_] {:status 401 :headers {} :body "no"})
                                  (fn [_] nil))
                       :oauth-authorizer authorizer))]
      (try
        (is (some? out))
        (let [tool (profiles/registry-get
                     (get-in @session [:provider_profile :tool_registry]) "demo__quote")]
          (try ((:executor tool) {:symbol "AAA"} nil) (catch Object _ nil)))
        (is (= "mcp:demo" (get-in @seen [:opts :service-id])))
        (is (contains? (:opts @seen) :store))
        (is (= "https://api.example/reg" (get-in @seen [:descriptor :registration-url])))
        (is (= "cid-9" (get-in @seen [:descriptor :client-id])))
        (finally (agent/close-session! session))))))

(deftest keychain-identity-agrees-on-explicit-ports
  (let [roots (make-roots)]
    (write-manifest! (:project roots) "demo"
                     (assoc (manifest-for "demo" "https://m.example/mcp" [(query-tool)])
                            :refresh-token-env "MCP_TEST_REFRESH"
                            :token-endpoint "https://api.example:8443/oauth2/token/"
                            :client-id "test-public-client"))
    (let [transport (fn [request]
                      (let [url (:url request)]
                        (if (str/includes? url "oauth2/token")
                          {:status 200 :headers {"content-type" "application/json"}
                           :body (json/write-json {:access_token "tok-port" :expires_in 3600})}
                          {:status 200 :headers {"content-type" "application/json"}
                           :body (call-echo request "ok")})))
          store (keychain-store-fake {["api.example:8443" "mcp:demo"] "tok-refresh-port"})
          requests (atom [])
          session (make-session-with-mcp
                    roots requests ["demo"] transport (fn [_] nil)
                    {:credential-store store})]
      (try
        (let [tool (profiles/registry-get
                     (get-in @session [:provider_profile :tool_registry]) "demo__quote")
              output ((:executor tool) {:symbol "AAA"} nil)
              entry (last @(:mcp_evidence @session))]
          (is (str/includes? output "ok"))
          (is (= "keychain" (:token-origin entry))))
        (finally (agent/close-session! session))))))

(deftest blank-attractor-home-falls-back-to-home
  ;; An unset variable reads as "" on this runtime, so blank must not win.
  (let [previous (os/getenv "ATTRACTOR_HOME")]
    (os/setenv "ATTRACTOR_HOME" "")
    (try
      (is (= (str (os/getenv "HOME") "/.attractor/mcp") (mcp/user-mcp-root)))
      (is (= (str (os/getenv "HOME") "/.attractor/mcp-approvals.edn")
             (mcp/default-approvals-path)))
      (finally (os/setenv "ATTRACTOR_HOME" (or previous ""))))))

(deftest open-server-gives-programs-raw-results-under-the-same-gates
  (let [roots (make-roots)]
    (write-manifest! (:project roots) "demo" (oauth-manifest "https://m.example/mcp"))
    (let [payload "{\"next\":\"https://x.example/?a=1&b=<2>\"}"
          transport (fn [request]
                      (if (str/includes? (:url request) "oauth2/token")
                        {:status 200 :headers {"content-type" "application/json"}
                         :body (json/write-json {:access_token "tok-prog" :expires_in 3600})}
                        {:status 200 :headers {"content-type" "application/json"}
                         :body (call-echo request payload)}))
          store (keychain-store-fake {["api.example" "mcp:demo"] "tok-refresh-kc"})
          server (mcp/open-server! "demo" (assoc (base-opts roots transport (fn [_] nil))
                                                 :credential-store store))]
      (try
        ;; Unlabeled and unescaped: a program parses this, no model reads it.
        (is (= payload ((:call! server) "quote" {:symbol "AAA"})))
        ;; Only manifest-declared tools exist.
        (is (= :mcp-tool-not-declared
               (:category (ex-data (try ((:call! server) "place_order" {})
                                        (catch Object e e))))))
        (let [entry (last ((:evidence server)))]
          (is (= "quote" (:tool entry)))
          (is (= :ok (:status entry)))
          (is (not (str/includes? (pr-str entry) "tok-"))))
        (finally ((:close! server)))))))

;; Host write approvals are separate from declarations and root selection.
(defn- write-tool []
  (assoc (query-tool) :name "update" :class :write-tool :side-effects :write))

(defn- bare-mcp-session []
  (atom {:id "write-admission-test"
         :provider_profile {:tool_registry (profiles/make-tool-registry)}
         :mcp_evidence (atom [])}))

(defn- write-grant [roots id names]
  {id {:manifest-digest (hash/sha256 (io/slurp (str (:project roots) "/" id "/mcp.edn")))
       :tools names}})

(deftest write-tools-require-an-exact-host-grant-before-opening
  (let [roots (make-roots)
        manifest (manifest-for "demo" "https://m.example/mcp" [(write-tool)])
        _ (write-manifest! (:project roots) "demo" manifest)
        calls (atom [])
        credentials (atom [])
        opts (base-opts roots (json-transport calls "{}")
                        (fn [name] (swap! credentials conj name) "tok"))
        exact (write-grant roots "demo" #{"update"})]
    (doseq [grant [nil {}
                   {"other" (get exact "demo")}
                   {"demo" (assoc (get exact "demo") :manifest-digest "stale")}
                   {"demo" (assoc (get exact "demo") :tools #{"quote"})}
                   {"demo" (assoc (get exact "demo") :tools ["update"])}]]
      (let [error (try (mcp/admit-servers! (bare-mcp-session) ["demo"]
                                         (assoc opts :write-approvals grant))
                       (catch Object error error))]
        (is (= :mcp-write-approval-required (:category (ex-data error))))))
    (is (= [] @calls))
    (is (= [] @credentials))
    ;; The manifest's own approval-shaped field cannot grant authority.
    (write-manifest! (:project roots) "demo" (assoc manifest :write-approvals exact))
    (is (= :mcp-write-approval-required
           (:category (ex-data (try (mcp/admit-servers! (bare-mcp-session) ["demo"] opts)
                                    (catch Object error error))))))))

(deftest exact-write-approval-registers-and-executes-declared-tools
  (doseq [tool-class [:write-tool :idempotent-tool]]
    (let [roots (make-roots)
          _ (write-manifest! (:project roots) "demo"
                            (manifest-for "demo" "https://m.example/mcp"
                                          [(assoc (write-tool) :class tool-class)]))
          calls (atom []) session (bare-mcp-session)
          transport (fn [request]
                      (swap! calls conj request)
                      {:status 200 :headers {"content-type" "application/json"}
                       :body (call-echo request "updated")})
          result (mcp/admit-servers! session ["demo"]
                                    (assoc (base-opts roots transport (fn [_] "tok"))
                                           :write-approvals (write-grant roots "demo" #{"update"})))
          tool (profiles/registry-get (get-in @session [:provider_profile :tool_registry])
                                      "demo__update")]
      (try
        (is (= ["demo__update"] (:write-tools (first (:servers result)))))
        (is (str/includes? ((:executor tool) {:symbol "AAA"} nil) "updated"))
        (let [body (json/read-json (:body (last @calls)))]
          (is (= "tools/call" (get body "method")))
          (is (= "update" (get-in body ["params" "name"]))))
        (finally (doseq [close (:mcp_close_fns @session)] (close)))))))

(deftest programmatic-write-access-uses-the-same-host-gate
  (let [roots (make-roots)
        _ (write-manifest! (:project roots) "demo"
                          (manifest-for "demo" "https://m.example/mcp" [(write-tool)]))
        calls (atom [])
        opts (base-opts roots
                        (fn [request] (swap! calls conj request)
                          {:status 200 :headers {"content-type" "application/json"}
                           :body (call-echo request "updated")})
                        (fn [_] "tok"))]
    (is (= :mcp-write-approval-required
           (:category (ex-data (try (mcp/open-server! "demo" opts)
                                    (catch Object error error))))))
    (is (= [] @calls))
    (let [server (mcp/open-server! "demo" (assoc opts :write-approvals (write-grant roots "demo" #{"update"})))]
      (try
        (is (= "updated" ((:call! server) "update" {:symbol "AAA"})))
        (is (= "update" (:tool (last ((:evidence server))))))
        (finally ((:close! server)))))))

(deftest all-selected-write-grants-are-preflighted-before-any-server-opens
  (let [roots (make-roots)
        _ (write-manifest! (:project roots) "read"
                          (-> (manifest-for "read" "https://r.example/mcp" [(query-tool)])
                              (dissoc :endpoint)
                              (assoc :transport :stdio :command ["must-not-launch"])))
        _ (write-manifest! (:project roots) "write" (manifest-for "write" "https://w.example/mcp" [(write-tool)]))
        credentials (atom []) opened (atom []) session (bare-mcp-session)
        opts (base-opts roots (fn [_] (throw (ex-info "Transport must not open" {})))
                        (fn [name] (swap! credentials conj name) "tok"))
        error (with-redefs [mcp-client/open-session
                            (fn [options]
                              (swap! opened conj options)
                              (throw (ex-info "Server must not open" {})))]
                (try (mcp/admit-servers! session ["read" "write"] opts)
                     (catch Object error error)))]
    (is (= :mcp-write-approval-required (:category (ex-data error))))
    (is (= [] @opened))
    (is (= [] @credentials))
    (is (nil? (profiles/registry-get (get-in @session [:provider_profile :tool_registry]) "read__quote")))))

(deftest contradictory-tool-effects-fail-manifest-validation
  (let [roots (make-roots)]
    (doseq [[tool-class effects] [[:write-tool :none] [:write-tool :read]
                                 [:pure-tool :write] [:read-only-resource :write]]]
      (write-manifest! (:project roots) "demo"
                       (manifest-for "demo" "https://m.example/mcp"
                                     [(assoc (write-tool) :class tool-class :side-effects effects)]))
      (is (= :mcp-manifest-invalid
             (:category (ex-data (try (mcp/open-server! "demo"
                                       (base-opts roots (fn [_] nil) (fn [_] "tok")))
                                      (catch Object error error)))))))))

(deftest make-session-forwards-explicit-mcp-write-approvals
  (let [roots (make-roots)
        _ (write-manifest! (:project roots) "demo"
                          (manifest-for "demo" "https://m.example/mcp" [(write-tool)]))
        previous (os/getenv "MCP_TEST_TOKEN")
        options {:provider_profile (profiles/make-profile {:id "custom" :model "test" :supports_streaming false})
                 :execution_env (journey-env) :max_subagent_depth 0 :project_docs []
                 :mcp ["demo"] :project_mcp_root (:project roots) :user_mcp_root (:user roots)}]
    (os/setenv "MCP_TEST_TOKEN" "write-admission-test-token")
    (try
      (is (= :mcp-write-approval-required
             (:category (ex-data (try (agent/make-session options) (catch Object error error))))))
      (let [session (agent/make-session
                      (assoc options :mcp_write_approvals (write-grant roots "demo" #{"update"})))]
        (try
          (is (= ["demo__update"] (:write-tools (first (:mcp_servers @session)))))
          (is (some? (profiles/registry-get
                       (get-in @session [:provider_profile :tool_registry]) "demo__update")))
          (finally (agent/close-session! session))))
      (finally (os/setenv "MCP_TEST_TOKEN" (or previous ""))))))
