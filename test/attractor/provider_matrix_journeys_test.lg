(deftest billing-or-quota-error-cannot-prove-rate-limiting
  (doseq [provider ["openai" "anthropic" "gemini"]]
    (let [seen (atom 0)
          target {:provider provider :model (case provider
                                              "openai" "gpt-5-mini"
                                              "anthropic" "claude-haiku-4-5"
                                              "gemini" "gemini-3-flash-preview")
                  :compat false}
          transport (fn [_]
                      (swap! seen inc)
                      {:status 429
                       :body (json/write-json
                               {:error {:message "billing quota exceeded"
                                        :type "insufficient_quota"
                                        :status "RESOURCE_EXHAUSTED"}})})
          row (get (into {} (journeys/journeys target
                              {:api_key "fixture" :base_url "https://fixture.invalid/native"
                               :transport transport})) :rate-limit)
          result (journeys/run-journey target [:rate-limit row])]
      (is (= :fail (:status result)))
      (is (= :quota-exceeded (:category result)))
      (is (= 1 @seen)))))
