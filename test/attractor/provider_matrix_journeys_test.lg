(deftest prompt-cache-completes-five-opaque-tool-turns-with-model-aware-choice
  (wire/with-wire-server
    (fn [root]
      (doseq [[model expected-choice] [["claude-fable-5-1" "auto"]
                                       ["claude-sonnet-4-5" "any"]]]
        (let [target {:provider "anthropic" :model model :compat false}
              row (get (into {} (journeys/journeys target
                                  {:api_key "fixture"
                                   :base_url (str root "/anthropic/provider-cache")}))
                       :prompt-cache)
              result (journeys/run-journey target [:prompt-cache row])
              requests (filterv #(and (str/includes? (get % "path") "/anthropic/provider-cache/")
                                      (= model (get-in % ["body" "model"])))
                                (wire/recorded root))]
          (is (= :pass (:status result)) (pr-str result))
          (is (= 5 (count (get-in result [:detail :cache_turns]))))
          (is (= 10 (count requests)))
          (is (= expected-choice
                 (get-in (first requests) ["body" "tool_choice" "type"]))))))))

