(ns attractor.evaluator-test
  "Unit tests for attractor.evaluator: scoped let-go execution,
   bounded timeouts, error handling, and dynamic tool authoring."
  (:require [clojure.test :refer [deftest is]]
            [clojure.string :as str]
            [attractor.evaluator :as eval]
            [attractor.harness :as harness]
            [attractor.profiles :as profiles]))

(deftest eval-code-basic-and-env-test
  ;; Basic arithmetic & string operations
  (let [r1 (eval/eval-code "(+ 10 20 12)")]
    (is (= :ok (:status r1)))
    (is (= 42 (:result r1)))
    (is (= "42" (:output r1))))

  ;; String and JSON library access
  (let [r2 (eval/eval-code "(str/upper-case \"attractor-engine\")")]
    (is (= :ok (:status r2)))
    (is (= "ATTRACTOR-ENGINE" (:result r2))))

  ;; Access to env map
  (let [r3 (eval/eval-code "(str \"Platform: \" (:platform env) \" Cwd: \" ((:cwd env)))"
                           {:env {:platform "darwin" :cwd (fn [] "/tmp/project")}})]
    (is (= :ok (:status r3)))
    (is (= "Platform: darwin Cwd: /tmp/project" (:result r3)))))

(deftest eval-code-error-handling-and-timeout-test
  ;; Syntax error
  (let [r-syntax (eval/eval-code "(+ 10 (* 2)")]
    (is (= :error (:status r-syntax)))
    (is (= :syntax_error (:category r-syntax))))

  ;; Runtime error
  (let [r-runtime (eval/eval-code "(/ 10 0)")]
    (is (= :error (:status r-runtime)))
    (is (= :runtime_error (:category r-runtime))))

  ;; Bounded infinite loop timeout
  (let [r-timeout (eval/eval-code "(loop [] (recur))" {:timeout_ms 150})]
    (is (= :timeout (:status r-timeout)))
    (is (= :timeout (:category r-timeout)))
    (is (str/includes? (:error r-timeout) "timed out after 150ms"))))

(deftest dynamic-tool-creation-and-execution-test
  (let [reg (profiles/make-tool-registry)
        h (harness/make-harness)
        ;; Define dynamic tool
        msg (eval/define-tool! reg h "multiply" "Multiply two numbers"
              {:properties {:a {:type "number"} :b {:type "number"}} :required ["a" "b"]}
              "(fn [args env] (* (get args \"a\") (get args \"b\")))")
        tool (profiles/registry-get reg "multiply")]
    (is (str/includes? msg "Defined and registered dynamic tool: multiply"))
    (is (some? tool))
    (is (= "multiply" (get-in tool [:definition :name])))

    ;; Execute tool
    (is (= 42 ((:executor tool) {"a" 6 "b" 7} {})))

    ;; Check persistence in harness
    (let [harness-tool (get-in @h [:entries :tool "multiply"])]
      (is (some? harness-tool))
      (is (= "multiply" (:title harness-tool)))
      (is (str/includes? (:content harness-tool) "* (get args \"a\")")))

    ;; Verify restoration in a fresh registry
    (let [fresh-reg (profiles/make-tool-registry)
          restored-count (eval/load-harness-tools! fresh-reg h)
          restored-tool (profiles/registry-get fresh-reg "multiply")]
      (is (= 1 restored-count))
      (is (some? restored-tool))
      (is (= 100 ((:executor restored-tool) {"a" 10 "b" 10} {}))))))

(deftest eval-letgo-tool-test
  (let [eval-tool (eval/eval-letgo-tool)]
    (is (= "eval_letgo" (get-in eval-tool [:definition :name])))

    ;; Successful evaluation returns output string
    (let [out ((:executor eval-tool) {"code" "(+ 1 2 3)"} {})]
      (is (= "6" out)))

    ;; Error evaluation returns formatted error diagnostics
    (let [err ((:executor eval-tool) {"code" "(/ 1 0)"} {})]
      (is (str/includes? err "Evaluation Error [runtime_error]")))))

(deftest timed-out-evaluation-is-joined-before-return
  (let [marker (atom false)
        result (eval/eval-code "(do (core/sleep 250) (reset! (:marker env) true))"
                              {:timeout_ms 100 :env {:marker marker}})]
    (is (= :timeout (:status result)))
    (core/sleep 350)
    (is (false? @marker))))

(deftest compilation-rejects-top-level-execution
  (let [error (try (eval/compile-tool-fn "(do (fn [args env] 1))") nil (catch Object e e))]
    (is (some? error))))

(deftest tool-exceptions-are-never-replayed
  (let [calls (atom 0)
        tool (eval/make-dynamic-tool "fails" "" {}
               (fn [& args] (swap! calls inc) (throw (ex-info "failure" {}))))]
    (try ((:executor tool) {} {}) (catch Object _ nil))
    (is (= 1 @calls))))

(deftest recursive-and-macro-loops-cancel-and-join
  (doseq [code ["((fn spin [] (spin)))" "(while true (swap! (:calls env) inc))"
                "(loop [] (swap! (:calls env) inc) (recur))"]]
    (let [calls (atom 0) result (eval/eval-code code {:timeout_ms 25 :env {:calls calls}})
          after @calls]
      (is (= :timeout (:status result)))
      (core/sleep 30)
      (is (= after @calls)))))

(deftest restoration-cannot-overwrite-host-tools
  (let [h (harness/make-harness) registry (profiles/make-tool-registry)
        host {:definition {:name "shell" :description "host shell" :parameters {:type "object"}} :executor (fn [_ _] "host")}]
    (profiles/register-tool! registry host)
    (harness/apply-edit! h {:kind "tool" :id "shell" :action "create" :content "(fn [args env] 42)"})
    (is (some? (try (eval/load-harness-tools! registry h) nil (catch Object e e))))
    (is (= host (profiles/registry-get registry "shell")))))
