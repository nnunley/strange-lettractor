(ns attractor.coding-smoke-journey-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string :as str] [clojure.edn :as edn]
            [clojure.core :as core] [attractor.llm :as llm]
            [attractor.execution :as execution] [os :as os] [io :as io]
            [live.coding-smoke-journey :as smoke]))

(deftest timeout-proof-requires-command-default-error-and-duration
  (let [call {:id "sleep" :name "shell" :arguments {:command "sleep 30"}}
        value {:stdout "" :stderr "timed out after 10000ms" :exit_code 124 :timed_out true :duration_ms 10010}
        context {:history [{:type :assistant :tool_calls [call]}
                           {:type :tool_results :results [{:tool_call_id "sleep" :is_error true :content (pr-str value)}]}
                           {:type :assistant :tool_calls [] :content "It timed out"}]
                 :requests [{:messages [{:role :tool :content [{:tool_call_id "sleep" :is_error true :content (pr-str value)}]}]}]}]
    (is (true? (:passed (smoke/check-step :timeout context))))
    (doseq [bad [(assoc-in context [:history 0 :tool_calls 0 :arguments :timeout_ms] 10000)
                 (assoc-in context [:history 0 :tool_calls 0 :arguments :command] "sleep 1")
                 (assoc-in context [:history 1 :results 0 :is_error] false)
                 (assoc-in context [:history 1 :results 0 :content] (pr-str (assoc value :duration_ms 100)))
                 (assoc context :requests [])
                 (update context :history pop)
                 (assoc context :events [{:type :turn_limit}])]]
      (is (false? (:passed (smoke/check-step :timeout bad)))))))

(deftest truncation-proof-correlates-full-output-model-result-and-request
  (let [payload (apply str (repeat 100000 "x"))
        result {:tool_call_id "read" :is_error false :content "xxx [WARNING: Tool output was truncated. 50000 characters removed] xxx"}
        context {:history [{:type :assistant :tool_calls [{:id "read" :name "read_file" :arguments {:file_path "big.txt"}}]}
                           {:type :tool_results :results [result]}]
                 :events [{:type :tool_call_end :call_id "read" :tool_name "read_file" :output (str "1 | " payload)}]
                 :requests [{:messages [{:role :tool :content [result]}]}]}]
    (is (true? (:passed (smoke/check-step :truncation context))))
    (doseq [bad [(assoc-in context [:events 0 :call_id] "unrelated")
                 (assoc-in context [:events 0 :output] "short")
                 (assoc context :requests [])
                 (assoc-in context [:history 1 :results 0 :is_error] true)]]
      (is (false? (:passed (smoke/check-step :truncation bad)))))))

(deftest file-and-shell-proofs-reject-claims-without-files-or-tool-results
  (let [hello "print('Hello World')\nprint('Goodbye')\n"
        read {:id "r" :name "read_file" :arguments {:file_path "hello.py"}}
        write {:id "w" :name "write_file" :arguments {:file_path "hello.py" :content hello}}
        shell {:id "s" :name "shell" :arguments {:command "python3 hello.py"}}
        history [{:type :assistant :tool_calls [read]}
                 {:type :tool_results :results [{:tool_call_id "r" :is_error false :content "before"}]}
                 {:type :assistant :tool_calls [write shell]}
                 {:type :tool_results :results [{:tool_call_id "w" :is_error false :content "ok"}
                                               {:tool_call_id "s" :is_error false :content (pr-str {:exit_code 0 :stdout "Hello World\nGoodbye\n"})}]}]
        context {:files {"hello.py" hello} :history history}]
    (doseq [step [:create :edit :shell]]
      (is (true? (:passed (smoke/check-step step context))))
      (is (false? (:passed (smoke/check-step step (assoc context :files {} :history []))))))))

(defn scripted-provider []
  (let [counts (atom {})]
    (fn [request]
      (let [messages (:messages request)
            prompt (:content (last (filter #(and (= :user (:role %))
                                                (string? (:content %))
                                                (or (clojure.string/starts-with? (:content %) "SMOKE_")
                                                    (= "CHILD_TEST_JOB" (:content %)))) messages)))
            n (get (swap! counts update prompt (fnil inc 0)) prompt)
            call (fn [name arguments] {:id (str prompt "-" n) :name name :arguments arguments})
            tc (cond
                 (= prompt "CHILD_TEST_JOB")
                 (when (= n 1) (call "write_file" {:file_path "test_hello.py" :content "import subprocess, unittest\nclass TestHello(unittest.TestCase):\n    def test_output(self):\n        output = subprocess.check_output(['python3', 'hello.py']).decode()\n        self.assertIn('Hello World', output)\n        self.assertIn('Goodbye', output)\n"}))
                 (clojure.string/starts-with? (str prompt) "SMOKE_CREATE")
                 (when (= n 1) (call "write_file" {:file_path "hello.py" :content "print('Hello World')\n"}))
                 (clojure.string/starts-with? (str prompt) "SMOKE_EDIT")
                 (case n 1 (call "read_file" {:file_path "hello.py"})
                         2 (call "apply_patch" {:patch "*** Begin Patch\n*** Update File: hello.py\n@@\n print('Hello World')\n+print('Goodbye')\n*** End Patch"}) nil)
                 (clojure.string/starts-with? (str prompt) "SMOKE_SHELL")
                 (when (= n 1) (call "shell" {:command "python3 hello.py"}))
                 (clojure.string/starts-with? (str prompt) "SMOKE_TRUNCATION")
                 (when (= n 1) (call "read_file" {:file_path "big.txt"}))
                 (clojure.string/starts-with? (str prompt) "SMOKE_STEERING")
                 (case n 1 (call "read_file" {:file_path "hello.py"})
                         2 (call "write_file" {:file_path "app.py" :content "from flask import Flask\napp = Flask(__name__)\n@app.route('/health')\ndef health():\n    return 'ok'\n"}) nil)
                 (clojure.string/starts-with? (str prompt) "SMOKE_SUBAGENT")
                 (case n 1 (call "spawn_agent" {:task "CHILD_TEST_JOB"})
                         2 (let [last-result (last (mapcat :content (filter #(= :tool (:role %)) messages)))
                                 id (:agent_id (clojure.edn/read-string (:content last-result)))]
                             (call "wait" {:agent_id id})) nil)
                 (clojure.string/starts-with? (str prompt) "SMOKE_TIMEOUT")
                 (when (= n 1) (call "shell" {:command "sleep 30"})))]
        {:text (if tc "" "done") :tool_calls (if tc [tc] [])}))))

(deftest seven-steps-share-one-real-session-and-real-tools
  (let [seen (atom [])
        result (smoke/run-journey "openai/audit" {:complete_fn (scripted-provider)
                                                 :step_timeout_ms 20000 :on_event #(swap! seen conj %)})]
    (is (= :pass (:status result)) (pr-str result))
    (is (= (mapv :step smoke/steps) (mapv :step (:steps result))))
    (is (= 1 (count (set (map :session_id @seen)))))
    (is (= 7 (count (filter #(= :user_input (:type %)) @seen))))
    (is (= :session_end (:type (last @seen))))))

(deftest steering-proof-requires-boundary-order-next-request-and-single-health-route
  (let [r {:id "r" :name "read_file" :arguments {:file_path "hello.py"}}
        w {:id "w" :name "write_file" :arguments {:file_path "app.py"}}
        context {:history [{:type :assistant :tool_calls [r w]}
                           {:type :tool_results :results [{:tool_call_id "r" :is_error false}
                                                         {:tool_call_id "w" :is_error false}]}]
                 :files {"app.py" "from flask import Flask\napp = Flask(__name__)\n@app.route('/health')\ndef health(): return 'ok'"}
                 :events [{:type :tool_call_end :call_id "r"}
                          {:type :steering_injected :content smoke/steering-text}
                          {:type :tool_call_start :call_id "w"}]
                 :requests [{:messages [{:role :user :content smoke/steering-text}]}]}]
    (is (true? (:passed (smoke/check-step :steering context))))
    (doseq [bad [(assoc context :requests [])
                 (update context :events #(vec (reverse %)))
                 (update-in context [:files "app.py"] str "\n@app.route('/other')\ndef other(): pass")
                 (update-in context [:files "app.py"] str "\napp.add_url_rule('/other', view_func=lambda: 'other')")
                 (update-in context [:files "app.py"] #(str/replace % "@app.route" "# @app.route"))
                 (update-in context [:files "app.py"] #(str/replace % "from flask import Flask\n" ""))
                 (update-in context [:files "app.py"] #(str/replace % "def health():" "def health(*, x=app.add_url_rule('/other', view_func=lambda: 'other')):"))
                 (update-in context [:files "app.py"] #(str/replace % "def health():" "def health() -> app.add_url_rule('/other', view_func=lambda: 'other'):"))
                 (update-in context [:files "app.py"] #(str/replace % "return 'ok'" "return None"))]]
      (is (false? (:passed (smoke/check-step :steering bad)))))))

(deftest subagent-proof-requires-child-owned-write-and-correlated-wait
  (let [child-call {:id "cw" :name "write_file" :arguments {:file_path "test_hello.py"}}
        child (atom {:history [{:type :assistant :tool_calls [child-call]}
                              {:type :tool_results :results [{:tool_call_id "cw" :is_error false}]}]})
        context {:session (atom {:subagents {"child" {:session child}}})
                 :files {"test_hello.py" "assert 'Hello' in output\nassert 'Goodbye' in output"}
                 :test_verification {:baseline_passed true :hello_mutant_rejected true :goodbye_mutant_rejected true}
                 :requests [{:messages [{:role :tool :content [{:tool_call_id "w" :is_error false :content "{:success true}"}]}]}]
                 :history [{:type :assistant :tool_calls [{:id "s" :name "spawn_agent" :arguments {}}
                                                         {:id "w" :name "wait" :arguments {:agent_id "child"}}]}
                           {:type :tool_results :results [{:tool_call_id "s" :is_error false :content "{:agent_id \"child\"}"}
                                                         {:tool_call_id "w" :is_error false :content "{:success true}"}]}
                           {:type :assistant :tool_calls [] :content "Reviewed"}]
                 :events [{:type :subagent_event :agent_id "child" :event {:type :tool_call_end :call_id "cw"}}]}]
    (is (true? (:passed (smoke/check-step :subagent context))))
    (let [failed [{:type :assistant :tool_calls [{:id "bad-spawn" :name "spawn_agent" :arguments {}}
                                                {:id "bad-wait" :name "wait" :arguments {:agent_id "child"}}]}
                  {:type :tool_results :results [{:tool_call_id "bad-spawn" :is_error true :content "spawn failed"}
                                                {:tool_call_id "bad-wait" :is_error false :content "{:success false}"}]}]
          recovered (update context :history #(vec (concat failed %)))]
      (is (true? (:passed (smoke/check-step :subagent recovered))))
      (is (= "s" (get-in (smoke/check-step :subagent recovered) [:proof :spawn_call])))
      (is (= "w" (get-in (smoke/check-step :subagent recovered) [:proof :wait_call]))))
    (let [parent-only (-> context
                          (assoc :session (atom {:subagents {"child" {:session (atom {:history []})}}}))
                          (update :history #(vec (concat (butlast %)
                                                        [{:type :assistant :tool_calls [child-call]}
                                                         {:type :tool_results :results [{:tool_call_id "cw" :is_error false}]}
                                                         (last %)]))))]
      (is (false? (:passed (smoke/check-step :subagent parent-only)))))
    (doseq [bad [(assoc context :events [])
                 (assoc-in context [:history 0 :tool_calls 1 :arguments :agent_id] "other")
                 (assoc context :session (atom {:subagents {}}))
                 (assoc context :requests [])
                 (update context :history pop)
                 (assoc context :test_verification {:baseline_passed false})]]
      (is (false? (:passed (smoke/check-step :subagent bad)))))))

(deftest injected-client-runs-all-seven-inputs-despite-proof-failures
  (let [requests (atom [])
        respond (fn [r] (swap! requests conj r) {:message {:role :assistant :content "claim only"} :tool_calls []})
        client (llm/make-client {:default_provider "openai"
                                :providers {"openai" (llm/make-adapter "openai" respond
                                                        (fn [r] [{:type :finish :response (respond r)}]))}})
        result (smoke/run-journey "openai/audit" {:llm_client client :step_timeout_ms 1000})]
    (is (= :fail (:status result)))
    (is (= 7 (count (:steps result))))
    (is (every? #(= :fail (:status %)) (:steps result)))
    (is (= 7 (count @requests)))
    (is (= 7 (count (filter #(= :user (:role %)) (:messages (last @requests))))))))

(deftest step-deadline-aborts-and-remaining-steps-record-closed
  (let [result (smoke/run-journey
                 "openai/audit"
                 {:step_timeout_ms 10
                  :complete_fn (fn [r]
                                 (loop [n 0]
                                   (when (and (< n 1000) (not ((get-in r [:abort_signal :aborted?]))))
                                     (core/sleep 2) (recur (inc n))))
                                 {:text "late" :tool_calls []})})]
    (is (= :fail (:status result)))
    (is (= 7 (count (:steps result))))
    (is (= :step-timeout (:error (first (:steps result)))))
    (is (every? #(= :session-closed (:error %)) (rest (:steps result))))))

(deftest patch-proof-resolves-absolute-file-paths
  (let [context {:dir "/tmp" :files {"hello.py" "print('Hello World')\n"}
                 :history [{:type :assistant :tool_calls [{:id "p" :name "apply_patch"
                                                          :arguments {:patch "*** Begin Patch\n*** Add File: /tmp/hello.py\n+print('Hello World')\n*** End Patch"}}]}
                           {:type :tool_results :results [{:tool_call_id "p" :is_error false}]}]}]
    (is (true? (:passed (smoke/check-step :create context))))))

(deftest adversarial-smoke-claims-are-not-execution-evidence
  (let [shell {:history [{:type :assistant :tool_calls [{:id "s" :name "shell" :arguments {:command "printf HelloGoodbye; # hello.py"}}]}
                         {:type :tool_results :results [{:tool_call_id "s" :is_error false :content (pr-str {:exit_code 0 :stdout "Hello Goodbye"})}]}]}
        timeout {:requests [] :history [{:type :assistant :tool_calls [{:id "t" :name "shell" :arguments {:command "sleep 30"}}]}
                                        {:type :tool_results :results [{:tool_call_id "t" :is_error true :content (pr-str {:exit_code 124 :timed_out true :duration_ms 10010 :stderr "timed out after 10000ms"})}]}]}]
    (is (false? (:passed (smoke/check-step :shell shell))))
    (is (false? (:passed (smoke/check-step :timeout timeout))))))

(deftest unittest-verification-rejects-comments-and-independent-tests-and-restores-file
  (let [root (str (os/temp-dir) "/smoke-tests-check-" (random-uuid))
        _ (io/mkdir root) env (execution/make-local-environment {:working_dir root})
        original "print('Hello World')\nprint('Goodbye')\n"
        sources [["# assert Hello Goodbye\n" false]
                 ["import unittest\nclass T(unittest.TestCase):\n def test_fake(self):\n  self.assertIn('Hello', 'Hello Goodbye')\n  self.assertIn('Goodbye', 'Hello Goodbye')\n" false]
                 ["import unittest, subprocess\nclass T(unittest.TestCase):\n def test_real(self):\n  output = subprocess.check_output(['python3', 'hello.py']).decode()\n  self.assertIn('Hello', output)\n  self.assertIn('Goodbye', output)\n" true]]]
    (try
      ((:write_file env) "hello.py" original)
      (doseq [[source expected] sources]
        ((:write_file env) "test_hello.py" source)
        (let [proof (smoke/verify-child-tests! env)]
          (is (= expected (every? true? (map #(get proof %) [:baseline_passed :hello_mutant_rejected :goodbye_mutant_rejected]))))
          (is (= original ((:read_text env) "hello.py")))))
      (finally ((:cleanup env)) (os/sh "rm" "-rf" root)))))

(deftest shell-invocation-proof-accepts-scoped-paths-and-rejects-shell-substitutes
  (let [context (fn [command]
                  {:dir "/tmp"
                   :history [{:type :assistant :tool_calls [{:id "s" :name "shell" :arguments {:command command}}]}
                             {:type :tool_results :results [{:tool_call_id "s" :is_error false :content (pr-str {:exit_code 0 :stdout "Hello World\nGoodbye\n"})}]}]})]
    (doseq [command ["python3 hello.py" "python3 /tmp/hello.py" "python3 './hello.py'"
                     "cd /tmp && python3 hello.py" "cd '/tmp' && python3 '/tmp/hello.py'"]]
      (is (true? (:passed (smoke/check-step :shell (context command)))) command))
    (doseq [command ["printf 'Hello Goodbye'; # hello.py" "python3 hello.py; printf extra"
                     "cd / && python3 hello.py" "echo python3 hello.py" "python3 other.py"
                     "python3 hello.py # ignored" "python3 hello.py | cat" "python3\nhello.py"]]
      (is (false? (:passed (smoke/check-step :shell (context command)))) command))))
