(deftest public-resume-allows-only-explicit-runtime-options
  (let [source
        "digraph SafeResumeOptions {
           start [shape=Mdiamond]
           work [type=options.work, retry_target=repair, max_retries=5]
           repair [type=options.repair]
           exit [shape=Msquare]
           start -> work
           start -> repair [condition=\"outcome=fail\"]
           work -> exit [condition=\"outcome=success\"]
           repair -> work
         }"
        run-root (publication-root)
        initial-registry (handlers/make-handler-registry)
        _ (handlers/register-handler!
            initial-registry "options.work"
            (fn [_ _ _ _] {:status :fail :failure_reason "repair first"}))
        _ (handlers/register-handler!
            initial-registry "options.repair"
            (fn [_ _ _ _] {:status :success}))
        initial (pipeline/run source {:logs-root run-root
                                      :registry initial-registry
                                      :max-steps 3})
        checkpoint-path (str run-root "/checkpoint.edn")
        checkpoint (context/load-checkpoint checkpoint-path)
        _ (context/save-checkpoint
            (assoc-in checkpoint [:node_retries "work"] 2)
            checkpoint-path)
        fidelities (atom [])
        registry (handlers/make-handler-registry)
        _ (handlers/register-handler!
            registry "options.work"
            (fn [node _ _ _]
              (swap! fidelities conj (:resolved_fidelity node))
              {:status :success}))
        events (atom [])
        result
        (pipeline/resume
          checkpoint-path
          {:registry registry
           :on-event #(swap! events conj %)
           :retry-counts (atom {"work" 99})
           :first-node-fidelity-override "truncate"
           :context (context/make-context {"poisoned" true})
           :start-at "exit"})
        started (first (filter #(= :stage.started (:type %)) @events))]
    (is (= :fail (:status initial)))
    (is (= ["start" "work" "repair"] (:completed_nodes checkpoint)))
    (is (= :success (:status result)))
    (is (= 3 (:attempt started)))
    (is (= ["compact"] @fidelities))
    (is (not (contains? (:context result) "poisoned")))))

(deftest public-resume-validates-current-source-overrides
  (doseq [invalid [nil "" "  " :root.dot]]
    (let [{:keys [checkpoint-path]} (interrupted-pinned-run)
          error (workflow-error
                  #(pipeline/resume checkpoint-path
                                    {:current-source-path invalid}))]
      (is (= :workflow_configuration_error (:category error)))
      (is (= :current-source-path (:option error)))
      (is (= invalid (:value error))))))

(deftest public-resume-reports-relocated-and-unreadable-current-sources
  (testing "relocated"
    (let [{:keys [source-path checkpoint-path]} (interrupted-pinned-run)
          relocated (str (os/temp-dir) "/lettractor-relocated-" (random-uuid) ".dot")
          _ (io/spit relocated pinned-resume-dot)
          events (atom [])
          result (pipeline/resume checkpoint-path
                                  {:current-source-path relocated
                                   :on-event #(swap! events conj %)})
          change {:logical-id workflow/root-plan-id
                  :state :relocated
                  :expected-sha256 (workflow/sha256-text pinned-resume-dot)
                  :actual-sha256 (workflow/sha256-text pinned-resume-dot)
                  :path (os/canonical-path relocated)}]
      (is (io/file-exists? source-path))
      (is (= {:type :workflow.drift_detected :changes [change]}
             (first @events)))
      (is (= (str "Pinned workflow differs from current sources: "
                  (pr-str [change]))
             (get-in result [:diagnostics 0 :message])))))
  (testing "unreadable"
    (let [{:keys [source-path checkpoint-path]} (interrupted-pinned-run)
          current-path (os/canonical-path source-path)
          real-slurp io/slurp
          events (atom [])
          result
          (with-redefs [io/slurp
                        (fn [path]
                          (if (= path current-path)
                            (throw (ex-info "injected unreadable" {}))
                            (real-slurp path)))]
            (pipeline/resume checkpoint-path
                             {:on-event #(swap! events conj %)}))
          change {:logical-id workflow/root-plan-id
                  :state :unreadable
                  :expected-sha256 (workflow/sha256-text pinned-resume-dot)
                  :path current-path}]
      (is (= {:type :workflow.drift_detected :changes [change]}
             (first @events)))
      (is (= (str "Pinned workflow differs from current sources: "
                  (pr-str [change]))
             (get-in result [:diagnostics 0 :message]))))))
