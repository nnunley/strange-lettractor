(ns attractor.workflow-recovery-contract-test
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.core :as core]
            [clojure.edn :as edn]
            [io :as io]
            [os :as os]
            [attractor.context :as context]
            [attractor.handlers :as handlers]
            [attractor.pipeline :as pipeline]
            [attractor.workflow :as workflow]))

(def root-dot
  "digraph Root { start [shape=Mdiamond] exit [shape=Msquare] start -> exit }")

(def changed-root-dot
  "digraph Root { start [shape=Mdiamond] work [shape=box] exit [shape=Msquare] start -> work -> exit }")

(defn- workflow-error [f]
  (try
    (do (f) nil)
    (catch ExceptionInfo error
      (ex-data error))))

(defn- serialization-error [value]
  (try
    (do (workflow/canonical-tree value) nil)
    (catch ExceptionInfo error
      (ex-data error))))

(deftest canonical-tree-uses-the-version-one-scalar-grammar
  (is (= ["nil"] (workflow/canonical-tree nil)))
  (is (= ["bool" true] (workflow/canonical-tree true)))
  (is (= ["int" "-12"] (workflow/canonical-tree -12)))
  (is (= ["decimal" "1.5"] (workflow/canonical-tree 1.50)))
  (is (= ["decimal" "-0.0"] (workflow/canonical-tree -0.0)))
  (is (= ["string" "héllo 世界"]
         (workflow/canonical-tree "héllo 世界")))
  (is (= ["keyword" nil "plain"]
         (workflow/canonical-tree :plain)))
  (is (= ["keyword" "workflow" "plan"]
         (workflow/canonical-tree :workflow/plan)))
  (is (= ["symbol" nil "plain"]
         (workflow/canonical-tree 'plain)))
  (is (= ["symbol" "δοκιμή" "λ"]
         (workflow/canonical-tree (symbol "δοκιμή" "λ")))))

(deftest canonical-tree-distinguishes-and-orders-containers
  (is (= ["vector" [["int" "1"] ["string" "x"]]]
         (workflow/canonical-tree [1 "x"])))
  (is (= ["list" [["int" "1"] ["string" "x"]]]
         (workflow/canonical-tree '(1 "x"))))
  (is (= ["map" [[["keyword" nil "a"] ["int" "1"]]
                 [["keyword" nil "b"] ["int" "2"]]]]
         (workflow/canonical-tree {:b 2 :a 1})))
  (is (= ["set" [["keyword" nil "a"] ["keyword" nil "b"]]]
         (workflow/canonical-tree #{:b :a}))))

(deftest canonical-edn-is-independent-of-map-set-order-and-metadata
  (let [left {:values (into {} [[:z 1] [:a 2]])
              :members (into #{} [:z :a])}
        right {:members (into #{} [:a :z])
               :values (into {} [[:a 2] [:z 1]])}]
    (is (= (workflow/canonical-edn left)
           (workflow/canonical-edn right)))
    (is (= (workflow/canonical-edn [1 2])
           (workflow/canonical-edn (with-meta [1 2] {:ignored true}))))))

(deftest canonical-tree-reports-exact-unsupported-structural-paths
  (let [handler-error
        (serialization-error
          {:nodes {"work" {:attrs {:handler (fn [] nil)}}}})
        map-key-error (serialization-error {(fn [] nil) 1})
        set-element-error (serialization-error #{(fn [] nil)})]
    (is (= {:category :workflow_not_serializable
            :path [:graph :nodes "work" :attrs :handler]}
           handler-error))
    (is (= {:category :workflow_not_serializable
            :path [:graph :map-key]}
           map-key-error))
    (is (= {:category :workflow_not_serializable
            :path [:graph :set-element]}
           set-element-error))))

(deftest canonical-tree-rejects-nonfinite-numbers
  (doseq [value [##NaN ##Inf ##-Inf]]
    (is (= {:category :workflow_not_serializable :path [:graph]}
           (serialization-error value)))))

(deftest canonical-tree-rejects-scalars-that-fail-edn-round-trip
  (doseq [reader [(fn [_] "different")
                  (fn [_] (throw (ex-info "reader failed" {})))]]
    (is (= {:category :workflow_not_serializable :path [:graph 0]}
           (with-redefs [edn/read-string reader]
             (serialization-error ["original"]))))))

(deftest sha256-text-locks-utf8-byte-digests
  (is (= "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
         (workflow/sha256-text "abc")))
  (is (= "c2a59c71097b678dc5af2eb1f98ddc575b63948b0fa6740071a945673aaada4d"
         (workflow/sha256-text "héllo wörld ✓"))))

(deftest plan-and-closure-fingerprints-have-independent-golden-vectors
  (let [graph {:greeting "héllo 世界" :count 2 :ratio 1.5}
        index {:format-version 1
               :root-plan-id "workflow://root"
               :sources []
               :plans []}]
    (is (= "[\"map\" [[[\"keyword\" nil \"count\"] [\"int\" \"2\"]] [[\"keyword\" nil \"greeting\"] [\"string\" \"héllo 世界\"]] [[\"keyword\" nil \"ratio\"] [\"decimal\" \"1.5\"]]]]"
           (workflow/canonical-edn graph)))
    (is (= "bb37904c667a2ee3b51ceab617d7eb289abae4e4b61a783fc57f63052cd6e142"
           (workflow/plan-fingerprint graph)))
    (is (= "815856054ca24c5a33b05c9ea4391743a593e362c429e045e2e543881938483e"
           (workflow/closure-fingerprint index)))))

(deftest prepare-captures-the-exact-root-source-and-prepared-graph
  (let [root (str (os/temp-dir) "/lettractor-root-capture-" (random-uuid))
        source-path (str root "/root.dot")
        _ (io/mkdir root)
        _ (io/spit source-path "current bytes are deliberately ignored")
        prepared (pipeline/prepare root-dot {:source-path source-path})
        graph (:graph prepared)
        bundle (:workflow prepared)
        source-sha (workflow/sha256-text root-dot)
        plan-sha (workflow/plan-fingerprint graph)
        expected-index
        {:format-version 1
         :root-plan-id "workflow://root"
         :sources [{:logical-id "workflow://root"
                    :source-sha256 source-sha}]
         :plans [{:logical-id "workflow://root"
                  :primary-plan-id "workflow://root"
                  :plan-sha256 plan-sha
                  :source-sha256 source-sha
                  :references []}]}]
    (is (= 1 (:format-version bundle)))
    (is (= "workflow://root" (:root-plan-id bundle)))
    (is (= expected-index (:index bundle)))
    (is (= (workflow/closure-fingerprint expected-index)
           (:fingerprint bundle)))
    (is (= [{:logical-id "workflow://root"
             :physical-id (os/canonical-path source-path)
             :source root-dot}]
           (:source-records bundle)))
    (is (= [{:id "root" :path (os/canonical-path root)}]
           (:workflow-roots bundle)))
    (is (= {:graph graph
            :plan-sha256 plan-sha
            :source-sha256 source-sha
            :primary-plan-id "workflow://root"
            :references []}
           (get-in bundle [:plans "workflow://root"])))
    (is (identical? graph
                    (get-in bundle [:plans "workflow://root" :graph])))))

(deftest prepare-supports-source-only-and-an-in-memory-base-directory
  (let [source-only (pipeline/prepare root-dot)
        base (str (os/temp-dir) "/lettractor-root-base-" (random-uuid))
        _ (io/mkdir base)
        based (pipeline/prepare root-dot {:base-dir base})]
    (is (map? (:workflow source-only)))
    (is (= [] (get-in source-only [:workflow :workflow-roots])))
    (is (= [{:logical-id "workflow://root"
             :physical-id nil
             :source root-dot}]
           (get-in source-only [:workflow :source-records])))
    (is (= [{:id "root" :path (os/canonical-path base)}]
           (get-in based [:workflow :workflow-roots])))
    (is (= nil
           (get-in based [:workflow :source-records 0 :physical-id])))))

(deftest workflow-roots-are-normalized-in-order-and-reject-conflicting-ids
  (let [first-root (str (os/temp-dir) "/lettractor-allowed-a-" (random-uuid))
        second-root (str (os/temp-dir) "/lettractor-allowed-b-" (random-uuid))
        _ (io/mkdir first-root)
        _ (io/mkdir second-root)
        prepared
        (pipeline/prepare
          root-dot
          {:base-dir first-root
           :workflow-roots [{:id "z" :path first-root}
                            {:id "a" :path second-root}
                            {:id "z" :path first-root}]})]
    (is (= [{:id "z" :path (os/canonical-path first-root)}
            {:id "a" :path (os/canonical-path second-root)}]
           (get-in prepared [:workflow :workflow-roots])))
    (is (= {:category :workflow_configuration_error
            :option :workflow-roots
            :reason :duplicate-id
            :id "same"}
           (workflow-error
             #(pipeline/prepare
                root-dot
                {:workflow-roots [{:id "same" :path first-root}
                                  {:id "same" :path second-root}]}))))
    (doseq [roots [{}
                   [{:id "ok"}]
                   [{:id 7 :path first-root}]
                   [{:id "" :path first-root}]
                   [{:id "ok" :path 7}]]]
      (is (= :workflow_configuration_error
             (:category
               (workflow-error
                 #(pipeline/prepare root-dot {:workflow-roots roots}))))))))

(deftest root-fingerprints-separate-source-plan-and-physical-identity
  (let [checkout-a (str (os/temp-dir) "/lettractor-checkout-a-" (random-uuid))
        checkout-b (str (os/temp-dir) "/lettractor-checkout-b-" (random-uuid))
        path-a (str checkout-a "/root.dot")
        path-b (str checkout-b "/root.dot")
        _ (io/mkdir checkout-a)
        _ (io/mkdir checkout-b)
        _ (io/spit path-a root-dot)
        _ (io/spit path-b root-dot)
        a (:workflow (pipeline/prepare root-dot {:source-path path-a}))
        b (:workflow (pipeline/prepare root-dot {:source-path path-b}))
        changed (:workflow (pipeline/prepare changed-root-dot))
        whitespace-source (str root-dot "\n\n")
        whitespace (:workflow (pipeline/prepare whitespace-source))]
    (is (= (:fingerprint a) (:fingerprint b)))
    (is (not= (get-in a [:source-records 0 :physical-id])
              (get-in b [:source-records 0 :physical-id])))
    (is (not= (get-in a [:plans "workflow://root" :source-sha256])
              (get-in changed [:plans "workflow://root" :source-sha256])))
    (is (not= (get-in a [:plans "workflow://root" :plan-sha256])
              (get-in changed [:plans "workflow://root" :plan-sha256])))
    (is (= (get-in a [:plans "workflow://root" :graph])
           (get-in whitespace [:plans "workflow://root" :graph])))
    (is (= (get-in a [:plans "workflow://root" :plan-sha256])
           (get-in whitespace [:plans "workflow://root" :plan-sha256])))
    (is (not= (get-in a [:plans "workflow://root" :source-sha256])
              (get-in whitespace [:plans "workflow://root" :source-sha256])))
    (is (not= (:fingerprint a) (:fingerprint whitespace)))))

(deftest closure-fingerprint-includes-logical-aliases-and-references
  (let [root-source (workflow/sha256-text root-dot)
        root-plan (workflow/plan-fingerprint (:graph (pipeline/prepare root-dot)))
        base {:format-version 1
              :root-plan-id "workflow://root"
              :sources [{:logical-id "workflow://root"
                         :source-sha256 root-source}]
              :plans [{:logical-id "workflow://root"
                       :primary-plan-id "workflow://root"
                       :plan-sha256 root-plan
                       :source-sha256 root-source
                       :references []}]}
        alias (-> base
                  (update :sources conj
                          {:logical-id "workflow://root/alias.dot"
                           :source-sha256 root-source})
                  (update :plans conj
                          {:logical-id "workflow://root/alias.dot"
                           :primary-plan-id "workflow://root"
                           :plan-sha256 root-plan
                           :source-sha256 root-source
                           :references []}))
        referenced (assoc-in
                     base [:plans 0 :references]
                     [{:node-id "child"
                       :logical-reference "child.dot"
                       :plan-id "workflow://root/child.dot"}])]
    (is (not= (workflow/closure-fingerprint base)
              (workflow/closure-fingerprint alias)))
    (is (not= (workflow/closure-fingerprint base)
              (workflow/closure-fingerprint referenced)))))

(deftest runtime-bundle-materialization-is-bound-to-the-fingerprinted-index
  (let [prepared (pipeline/prepare root-dot)
        graph (:graph prepared)
        changed-graph (assoc graph :goal "unfingerprinted mutation")
        changed-sha (workflow/plan-fingerprint changed-graph)
        attacked
        (-> prepared
            (assoc :graph changed-graph)
            (assoc-in [:workflow :plans workflow/root-plan-id :graph] changed-graph)
            (assoc-in [:workflow :plans workflow/root-plan-id :plan-sha256]
                      changed-sha))]
    (is (= :workflow_snapshot_corrupt
           (:category
             (workflow-error
               #(workflow/verify-bundle! (:workflow attacked)
                                         (:graph attacked))))))))

(defn- publication-root []
  (str (os/temp-dir) "/lettractor-publication-" (random-uuid)))

(defn- prepared-bundle []
  (:workflow (pipeline/prepare root-dot)))

(deftest workflow-publication-commits-content-before-an-edn-manifest
  (let [run-root (publication-root)
        bundle (prepared-bundle)
        writes (atom [])
        renames (atom [])
        real-spit io/spit
        real-rename os/rename
        manifest-path
        (with-redefs [io/spit (fn [path content]
                               (swap! writes conj path)
                               (real-spit path content))
                      os/rename (fn [source target]
                                  (swap! renames conj [source target])
                                  (real-rename source target))]
          (workflow/publish! bundle run-root))
        manifest (edn/read-string (io/slurp manifest-path))
        source-path (get-in manifest [:sources 0 :path])
        plan-path (get-in manifest [:plans 0 :path])]
    (is (= (str run-root "/workflow/manifest.edn") manifest-path))
    (is (= (:fingerprint bundle) (:fingerprint manifest)))
    (is (= (:index bundle) (:index manifest)))
    (is (= root-dot (io/slurp (str run-root "/" source-path))))
    (is (= (get-in bundle [:plans workflow/root-plan-id :graph])
           (workflow/decode-canonical-tree
             (edn/read-string (io/slurp (str run-root "/" plan-path))))))
    (is (= manifest-path (second (last @renames))))
    (is (every? #(re-find #"[.]tmp-[0-9a-f-]+$" (first %)) @renames))
    (is (nil? (os/stat (str run-root "/workflow/.publish.lock"))))
    (is (map? (edn/read-string (io/slurp manifest-path))))))

(deftest workflow-publication-reuses-verified-content-and-rejects-collisions
  (testing "the same immutable bundle is reusable"
    (let [run-root (publication-root)
          bundle (prepared-bundle)
          first-path (workflow/publish! bundle run-root)
          first-bytes (io/slurp first-path)
          second-path (workflow/publish! bundle run-root)]
      (is (= first-path second-path))
      (is (= first-bytes (io/slurp second-path)))
      (is (= (:fingerprint bundle)
             (:fingerprint (workflow/read-manifest! second-path))))))
  (testing "different manifests never overwrite a committed run"
    (let [run-root (publication-root)
          first (prepared-bundle)
          second (:workflow (pipeline/prepare changed-root-dot))
          path (workflow/publish! first run-root)
          before (io/slurp path)
          error (workflow-error #(workflow/publish! second run-root))]
      (is (= :workflow_already_published (:category error)))
      (is (= before (io/slurp path)))))
  (testing "an existing content address with wrong bytes is rejected"
    (let [run-root (publication-root)
          bundle (prepared-bundle)
          source-sha (get-in bundle [:index :sources 0 :source-sha256])
          source-dir (str run-root "/workflow/sources")
          _ (io/mkdir source-dir)
          target (str source-dir "/" source-sha ".dot")
          _ (io/spit target "wrong bytes")
          error (workflow-error #(workflow/publish! bundle run-root))]
      (is (= :workflow_snapshot_corrupt (:category error)))
      (is (= target (:path error))))))

(deftest existing-manifest-reuse-requires-byte-identical-edn
  (doseq [mutation
          [(fn [manifest bytes]
             (let [original-prefix
                   (str "{:format-version " (pr-str (:format-version manifest))
                        ", :fingerprint " (pr-str (:fingerprint manifest)) ",")
                   reordered-prefix
                   (str "{:fingerprint " (pr-str (:fingerprint manifest))
                        ", :format-version " (pr-str (:format-version manifest)) ",")]
               (str reordered-prefix (subs bytes (count original-prefix)))))
           (fn [_ bytes] (str bytes "\n"))
           (fn [_ _] "{:not-valid")]]
    (let [run-root (publication-root)
          bundle (prepared-bundle)
          manifest-path (workflow/publish! bundle run-root)
          original-bytes (io/slurp manifest-path)
          manifest (edn/read-string original-bytes)
          mutated-bytes (mutation manifest original-bytes)
          _ (io/spit manifest-path mutated-bytes)
          error (workflow-error #(workflow/publish! bundle run-root))]
      (is (not= original-bytes mutated-bytes))
      (is (= :workflow_already_published (:category error)))
      (is (= mutated-bytes (io/slurp manifest-path))))))

(deftest identical-manifest-reuse-reverifies-every-referenced-content-file
  (doseq [manifest-key [:sources :plans]]
    (let [run-root (publication-root)
          bundle (prepared-bundle)
          manifest-path (workflow/publish! bundle run-root)
          manifest-bytes (io/slurp manifest-path)
          manifest (edn/read-string manifest-bytes)
          content-path (str run-root "/" (get-in manifest [manifest-key 0 :path]))
          _ (io/spit content-path "corrupted after publication")
          error (workflow-error #(workflow/publish! bundle run-root))]
      (is (= :workflow_snapshot_corrupt (:category error)))
      (is (= content-path (:path error)))
      (is (= manifest-bytes (io/slurp manifest-path))))))

(deftest workflow-publication-refuses-an-uncommitted-lock
  (let [run-root (publication-root)
        workflow-dir (str run-root "/workflow")
        _ (io/mkdir workflow-dir)
        _ (io/mkdir (str workflow-dir "/.publish.lock"))
        error (workflow-error #(workflow/publish! (prepared-bundle) run-root))]
    (is (= :workflow_publication_incomplete (:category error)))
    (is (= workflow/publish-lock-wait-ms (:wait-ms error)))
    (is (nil? (os/stat (str workflow-dir "/manifest.edn"))))))

(deftest concurrent-publishers-never-corrupt-the-committed-bundle
  (let [run-root (publication-root)
        bundle (prepared-bundle)
        started (promise)
        contender-observed (promise)
        release (promise)
        real-spit io/spit
        real-sh os/sh
        first (core/future
                (with-redefs [io/spit
                              (fn [path content]
                                (when (and (re-find #"/sources/" path)
                                           (re-find #"[.]tmp-" path))
                                  (deliver started true)
                                  (deref release 1000 :timeout))
                                (real-spit path content))
                              os/sh
                              (fn [command path]
                                (let [result (real-sh command path)]
                                  (when (and (= command "mkdir")
                                             (not (zero? (:exit result))))
                                    (deliver contender-observed true))
                                  result))]
                  (workflow/publish! bundle run-root)))
        _ (deref started 1000 :not-started)
        second (core/future
                 (try
                   {:path (workflow/publish! bundle run-root)}
                 (catch ExceptionInfo error
                     {:error (ex-data error)})))
        _ (deref contender-observed 1000 :not-observed)
        _ (deliver release true)
        first-path (deref first 1000 :timeout)
        second-result (deref second 1000 :timeout)]
    (is (= first-path (:path second-result)))
    (is (= (:fingerprint bundle)
           (:fingerprint (workflow/read-manifest! first-path))))))

(deftest verify-published-validates-the-expected-fingerprint
  (let [run-root (publication-root)
        bundle (prepared-bundle)
        _ (workflow/publish! bundle run-root)
        verified (workflow/verify-published! run-root (:fingerprint bundle))]
    (is (= (:fingerprint bundle) (get-in verified [:workflow :fingerprint])))
    (is (= (:graph (get-in bundle [:plans workflow/root-plan-id]))
           (:graph verified)))
    (is (= :workflow_snapshot_corrupt
           (:category
             (workflow-error
               #(workflow/verify-published! run-root "not-the-fingerprint")))))))

(deftest published-manifest-materialization-is-bound-and-confined
  (doseq [mutate
          [(fn [manifest]
             (assoc-in manifest [:plans 0 :plan-sha256]
                       (apply str (repeat 64 "0"))))
           (fn [manifest]
             (assoc-in manifest [:plans 0 :path] "../outside.edn"))
           (fn [manifest]
             (update manifest :plans conj (first (:plans manifest))))
           (fn [manifest]
             (assoc manifest :sources []))
           (fn [manifest]
             (assoc-in manifest [:plans 0 :unexpected] true))
           (fn [manifest]
             (assoc-in manifest [:index :plans] {}))]]
    (let [run-root (publication-root)
          bundle (prepared-bundle)
          manifest-path (workflow/publish! bundle run-root)
          manifest (workflow/read-manifest! manifest-path)
          attacked (mutate manifest)
          outside-path (str run-root "/../outside.edn")
          _ (io/spit manifest-path (pr-str attacked))
          real-slurp io/slurp
          reads (atom [])
          error
          (with-redefs [io/slurp (fn [path]
                                  (swap! reads conj path)
                                  (real-slurp path))]
            (workflow-error
              #(workflow/verify-published! run-root (:fingerprint bundle))))]
      (is (= :workflow_snapshot_corrupt (:category error)))
      (is (not (some #(= outside-path %) @reads))))))

(deftest verify-published-reads-each-plan-once-and-returns-that-verified-value
  (let [run-root (publication-root)
        bundle (prepared-bundle)
        manifest-path (workflow/publish! bundle run-root)
        manifest (workflow/read-manifest! manifest-path)
        plan-path (str run-root "/" (get-in manifest [:plans 0 :path]))
        real-slurp io/slurp
        plan-reads (atom 0)
        verified
        (with-redefs [io/slurp
                      (fn [path]
                        (if (= path plan-path)
                          (do
                            (swap! plan-reads inc)
                            (if (= 1 @plan-reads)
                              (real-slurp path)
                              "corrupted on a second read"))
                          (real-slurp path)))]
          (workflow/verify-published! run-root (:fingerprint bundle)))]
    (is (= 1 @plan-reads))
    (is (= (get-in bundle [:plans workflow/root-plan-id :graph])
           (:graph verified)))))

(deftest verify-published-normalizes-a-missing-source
  (let [run-root (publication-root)
        bundle (prepared-bundle)
        manifest-path (workflow/publish! bundle run-root)
        manifest (workflow/read-manifest! manifest-path)
        source-path (str run-root "/" (get-in manifest [:sources 0 :path]))
        _ (io/delete-file source-path)
        error
        (workflow-error
          #(workflow/verify-published! run-root (:fingerprint bundle)))]
    (is (= :workflow_snapshot_missing (:category error)))
    (is (= :source (:kind error)))
    (is (= source-path (:path error)))))

(deftest public-runs-persist-pinned-workflow-identity-in-checkpoints
  (testing "successful runs retain identity in the final checkpoint"
    (let [source
          "digraph FinalFidelity {
             graph [default_fidelity=compact]
             start [shape=Mdiamond]
             exit [shape=Msquare]
             start -> exit [fidelity=full]
           }"
          logs (publication-root)
          prepared (pipeline/prepare source)
          expected (get-in prepared [:workflow :fingerprint])
          result (pipeline/run source {:logs-root logs})
          checkpoint (context/load-checkpoint (str logs "/checkpoint.edn"))]
      (is (= :success (:status result)))
      (is (= expected (:workflow_fingerprint checkpoint)))
      (is (= "workflow/manifest.edn" (:workflow_manifest checkpoint)))
      (is (= "exit" (:current_node checkpoint)))
      (is (= "full" (:current_fidelity checkpoint)))))
  (testing "failed runs retain identity in their last stage checkpoint"
    (let [source
          "digraph Failed {
             graph [default_fidelity=compact]
             start [shape=Mdiamond]
             broken [type=checkpoint.fail]
             exit [shape=Msquare]
             start -> broken
             broken -> exit [condition=\"outcome=success\"]
           }"
          logs (publication-root)
          prepared (pipeline/prepare source)
          expected (get-in prepared [:workflow :fingerprint])
          registry (handlers/make-handler-registry)
          _ (handlers/register-handler!
              registry "checkpoint.fail"
              (fn [_ _ _ _]
                {:status :fail :failure_reason "expected failure"}))
          result (pipeline/run source {:logs-root logs :registry registry})
          checkpoint (context/load-checkpoint (str logs "/checkpoint.edn"))]
      (is (= :fail (:status result)))
      (is (= expected (:workflow_fingerprint checkpoint)))
      (is (= "workflow/manifest.edn" (:workflow_manifest checkpoint)))
      (is (= "compact" (:current_fidelity checkpoint))))))

(def pinned-resume-dot
  "digraph PinnedResume {
     start [shape=Mdiamond]
     work [type=pinned.original]
     exit [shape=Msquare]
     start -> work -> exit
   }")

(defn- interrupted-pinned-run []
  (let [run-root (publication-root)
        checkout (str (os/temp-dir) "/lettractor-current-" (random-uuid))
        source-path (str checkout "/root.dot")
        _ (io/mkdir checkout)
        _ (io/spit source-path pinned-resume-dot)
        result (pipeline/run pinned-resume-dot
                             {:source-path source-path
                              :logs-root run-root
                              :max-steps 1})]
    (is (= :fail (:status result)))
    {:run-root run-root
     :source-path source-path
     :checkpoint-path (str run-root "/checkpoint.edn")}))

(defn- update-edn-file! [path update-fn]
  (io/spit path (pr-str (update-fn (edn/read-string (io/slurp path))))))

(deftest current-drift-is-exact-sorted-and-root-override-only
  (let [root-dir (str (os/temp-dir) "/lettractor-drift-" (random-uuid))
        changed-path (str root-dir "/changed.dot")
        unreadable-path (str root-dir "/unreadable.dot")
        relocated-original (str root-dir "/old-root.dot")
        relocated-path (str root-dir "/new-root.dot")
        root-symlink (str root-dir "/root-link.dot")
        missing-path (str root-dir "/missing.dot")
        _ (io/mkdir root-dir)
        _ (io/spit changed-path "changed")
        _ (io/spit unreadable-path "unreadable")
        _ (io/spit relocated-original "captured")
        _ (io/spit relocated-path "captured")
        _ (os/sh "ln" "-s" relocated-original root-symlink)
        manifest
        {:root-plan-id workflow/root-plan-id
         :sources
         [{:logical-id "workflow://root/z-unreadable"
           :source-sha256 (workflow/sha256-text "expected")
           :physical-id unreadable-path}
          {:logical-id workflow/root-plan-id
           :source-sha256 (workflow/sha256-text "captured")
           :physical-id relocated-original}
          {:logical-id "workflow://root/a-changed"
           :source-sha256 (workflow/sha256-text "expected")
           :physical-id changed-path}
          {:logical-id "workflow://root/m-missing"
           :source-sha256 (workflow/sha256-text "expected")
           :physical-id missing-path}]}
        real-slurp io/slurp
        changes
        (with-redefs [io/slurp
                      (fn [path]
                        (if (= (os/canonical-path unreadable-path)
                               (os/canonical-path path))
                          (throw (ex-info "denied" {}))
                          (real-slurp path)))]
          (workflow/current-drift
            manifest {:current-source-path relocated-path}))]
    (is (= [{:logical-id "workflow://root"
             :state :relocated
             :expected-sha256 (workflow/sha256-text "captured")
             :actual-sha256 (workflow/sha256-text "captured")
             :path (os/canonical-path relocated-path)}
            {:logical-id "workflow://root/a-changed"
             :state :changed
             :expected-sha256 (workflow/sha256-text "expected")
             :actual-sha256 (workflow/sha256-text "changed")
             :path (os/canonical-path changed-path)}
            {:logical-id "workflow://root/m-missing"
             :state :missing
             :expected-sha256 (workflow/sha256-text "expected")
             :path missing-path}
            {:logical-id "workflow://root/z-unreadable"
             :state :unreadable
             :expected-sha256 (workflow/sha256-text "expected")
             :path (os/canonical-path unreadable-path)}]
           changes))
    (is (= []
           (workflow/current-drift
             {:root-plan-id workflow/root-plan-id
              :sources [{:logical-id workflow/root-plan-id
                         :source-sha256 (workflow/sha256-text "captured")
                         :physical-id relocated-original}]}
             {})))
    (is (= []
           (workflow/current-drift
             {:root-plan-id workflow/root-plan-id
              :sources [{:logical-id workflow/root-plan-id
                         :source-sha256 (workflow/sha256-text "captured")
                         :physical-id relocated-original}]}
             {:current-source-path root-symlink})))
    (is (= [] (workflow/current-drift manifest {:check-current? false})))))

(deftest public-resume-executes-captured-bytes-and-reports-canonical-drift
  (let [{:keys [run-root source-path checkpoint-path]}
        (interrupted-pinned-run)
        _ (io/spit source-path "this is no longer valid DOT")
        events (atom [])
        original-calls (atom 0)
        changed-calls (atom 0)
        registry (handlers/make-handler-registry)
        _ (handlers/register-handler!
            registry "pinned.original"
            (fn [_ _ _ _]
              (swap! original-calls inc)
              {:status :success
               :artifacts [{:name "captured" :value "yes"}]}))
        _ (handlers/register-handler!
            registry "pinned.changed"
            (fn [_ _ _ _]
              (swap! changed-calls inc)
              {:status :success}))
        decoy-root (str (os/temp-dir) "/run_latest-" (random-uuid))
        expected-change
        {:logical-id workflow/root-plan-id
         :state :changed
         :expected-sha256 (workflow/sha256-text pinned-resume-dot)
         :actual-sha256 (workflow/sha256-text "this is no longer valid DOT")
         :path (os/canonical-path source-path)}
        result (pipeline/resume
                 checkpoint-path
                 {:registry registry
                  :logs-root decoy-root
                  :on-event #(swap! events conj %)})
        final-checkpoint (context/load-checkpoint checkpoint-path)
        warning {:rule "workflow_drift"
                 :severity :warning
                 :message
                 (str "Pinned workflow differs from current sources: "
                      (pr-str [expected-change]))}]
    (is (= :success (:status result)))
    (is (= 1 @original-calls))
    (is (= 0 @changed-calls))
    (is (= [warning] (:diagnostics result)))
    (is (= {:type :workflow.drift_detected :changes [expected-change]}
           (first @events)))
    (is (= :pipeline.started (:type (second @events))))
    (is (= (os/canonical-path run-root) (:logs_root (second @events))))
    (is (= "exit" (:current_node final-checkpoint)))
    (is (= "workflow/manifest.edn" (:workflow_manifest final-checkpoint)))
    (is (io/file-exists? (str run-root "/work/status.json")))
    (is (not (io/file-exists? (str decoy-root "/work/status.json"))))))

(deftest public-resume-can-suppress-current-source-comparison
  (let [{:keys [source-path checkpoint-path]} (interrupted-pinned-run)
        _ (io/spit source-path "invalid current source")
        events (atom [])
        result (pipeline/resume checkpoint-path
                                {:check-current? false
                                 :on-event #(swap! events conj %)})]
    (is (= :success (:status result)))
    (is (= [] (:diagnostics result)))
    (is (empty? (filter #(= :workflow.drift_detected (:type %)) @events)))
    (is (= :pipeline.started (:type (first @events))))))

(deftest public-resume-survives-a-deleted-current-source
  (let [{:keys [source-path checkpoint-path]} (interrupted-pinned-run)
        recorded-source-path (os/canonical-path source-path)
        _ (io/delete-file source-path)
        calls (atom 0)
        events (atom [])
        registry (handlers/make-handler-registry)
        _ (handlers/register-handler!
            registry "pinned.original"
            (fn [_ _ _ _]
              (swap! calls inc)
              {:status :success}))
        result (pipeline/resume checkpoint-path
                                {:registry registry
                                 :on-event #(swap! events conj %)})
        change {:logical-id workflow/root-plan-id
                :state :missing
                :expected-sha256 (workflow/sha256-text pinned-resume-dot)
                :path recorded-source-path}]
    (is (= :success (:status result)))
    (is (= 1 @calls))
    (is (= {:type :workflow.drift_detected :changes [change]}
           (first @events)))
    (is (= [{:rule "workflow_drift"
             :severity :warning
             :message
             (str "Pinned workflow differs from current sources: "
                  (pr-str [change]))}]
           (:diagnostics result)))))

(deftest public-resume-rejects-untrusted-manifest-paths-before-the-engine
  (doseq [manifest-value ["/workflow/manifest.edn"
                          "../workflow/manifest.edn"
                          "workflow/../workflow/manifest.edn"
                          "workflow/other.edn"
                          :workflow/manifest]]
    (let [{:keys [checkpoint-path]} (interrupted-pinned-run)
          checkpoint (context/load-checkpoint checkpoint-path)
          _ (context/save-checkpoint
              (assoc checkpoint :workflow_manifest manifest-value)
              checkpoint-path)
          events (atom [])
          calls (atom 0)
          registry (handlers/make-handler-registry)
          _ (handlers/register-handler!
              registry "pinned.original"
              (fn [_ _ _ _]
                (swap! calls inc)
                {:status :success}))
          error (workflow-error
                  #(pipeline/resume checkpoint-path
                                    {:registry registry
                                     :on-event #(swap! events conj %)}))]
      (is (= :workflow_snapshot_corrupt (:category error)))
      (is (= manifest-value (:workflow-manifest error)))
      (is (= [] @events))
      (is (= 0 @calls)))))

(deftest public-resume-fails-closed-for-missing-or-corrupt-captures
  (doseq [[label attack expected-category]
          [[:manifest-missing
            (fn [run-root _checkpoint-path]
              (io/delete-file (str run-root "/workflow/manifest.edn")))
            :workflow_snapshot_missing]
           [:source-missing
            (fn [run-root _checkpoint-path]
              (let [manifest (workflow/read-manifest!
                               (str run-root "/workflow/manifest.edn"))]
                (io/delete-file (str run-root "/" (get-in manifest [:sources 0 :path])))))
            :workflow_snapshot_missing]
           [:plan-missing
            (fn [run-root _checkpoint-path]
              (let [manifest (workflow/read-manifest!
                               (str run-root "/workflow/manifest.edn"))]
                (io/delete-file (str run-root "/" (get-in manifest [:plans 0 :path])))))
            :workflow_snapshot_missing]
           [:source-corrupt
            (fn [run-root _checkpoint-path]
              (let [manifest (workflow/read-manifest!
                               (str run-root "/workflow/manifest.edn"))]
                (io/spit (str run-root "/" (get-in manifest [:sources 0 :path]))
                         "corrupt")))
            :workflow_snapshot_corrupt]
           [:plan-corrupt
            (fn [run-root _checkpoint-path]
              (let [manifest (workflow/read-manifest!
                               (str run-root "/workflow/manifest.edn"))]
                (io/spit (str run-root "/" (get-in manifest [:plans 0 :path]))
                         "corrupt")))
            :workflow_snapshot_corrupt]
           [:manifest-fingerprint
            (fn [run-root _checkpoint-path]
              (update-edn-file!
                (str run-root "/workflow/manifest.edn")
                #(assoc % :fingerprint (apply str (repeat 64 "0")))))
            :workflow_snapshot_corrupt]
           [:manifest-format
            (fn [run-root _checkpoint-path]
              (update-edn-file!
                (str run-root "/workflow/manifest.edn")
                #(assoc % :format-version 2)))
            :workflow_snapshot_corrupt]
           [:manifest-root
            (fn [run-root _checkpoint-path]
              (update-edn-file!
                (str run-root "/workflow/manifest.edn")
                #(assoc % :root-plan-id "workflow://missing")))
            :workflow_snapshot_corrupt]
           [:checkpoint-fingerprint
            (fn [_run-root checkpoint-path]
              (update-edn-file!
                checkpoint-path
                #(assoc % :workflow_fingerprint
                        (apply str (repeat 64 "f")))))
            :workflow_snapshot_corrupt]
           [:checkpoint-node
            (fn [_run-root checkpoint-path]
              (update-edn-file!
                checkpoint-path
                #(assoc % :current_node "not-in-captured-plan")))
            :workflow_snapshot_corrupt]]]
    (testing (name label)
      (let [{:keys [run-root checkpoint-path]} (interrupted-pinned-run)
            _ (attack run-root checkpoint-path)
            events (atom [])
            calls (atom 0)
            registry (handlers/make-handler-registry)
            _ (handlers/register-handler!
                registry "pinned.original"
                (fn [_ _ _ _]
                  (swap! calls inc)
                  {:status :success}))
            error (workflow-error
                    #(pipeline/resume checkpoint-path
                                      {:registry registry
                                       :on-event #(swap! events conj %)}))]
        (is (= expected-category (:category error)))
        (is (or (:path error) (:kind error) (:format-version error)
                (:root-plan-id error) (:expected error) (:current-node error)))
        (is (= [] @events))
        (is (= 0 @calls))))))

(deftest public-resume-requires-both-checkpoint-identity-fields
  (doseq [[missing-key expected-kind]
          [[:workflow_manifest :manifest]
           [:workflow_fingerprint :fingerprint]]]
    (let [{:keys [checkpoint-path]} (interrupted-pinned-run)
          _ (update-edn-file! checkpoint-path #(dissoc % missing-key))
          events (atom [])
          error (workflow-error
                  #(pipeline/resume checkpoint-path
                                    {:on-event #(swap! events conj %)}))]
      (is (= :workflow_snapshot_missing (:category error)))
      (is (= expected-kind (:kind error)))
      (is (= [] @events)))))

(deftest public-resume-uses-the-once-loaded-checkpoint-after-drift-callbacks
  (let [{:keys [source-path checkpoint-path]} (interrupted-pinned-run)
        _ (io/spit source-path "changed after launch")
        calls (atom 0)
        registry (handlers/make-handler-registry)
        _ (handlers/register-handler!
            registry "pinned.original"
            (fn [_ _ _ _]
              (swap! calls inc)
              {:status :success}))
        rewrite-checkpoint!
        (fn [event]
          (when (= :workflow.drift_detected (:type event))
            (let [checkpoint (context/load-checkpoint checkpoint-path)]
              (context/save-checkpoint
                (assoc checkpoint
                       :current_node "work"
                       :completed_nodes ["start" "work"]
                       :node_outcomes
                       {"start" {:status :success}
                        "work" {:status :success}})
                checkpoint-path))))
        result (pipeline/resume checkpoint-path
                                {:registry registry
                                 :on-event rewrite-checkpoint!})]
    (is (= :success (:status result)))
    (is (= 1 @calls))))

(deftest public-resume-pins-the-resolved-checkpoint-and-run-root-across-symlink-swap
  (let [{:keys [run-root source-path checkpoint-path]} (interrupted-pinned-run)
        _ (io/spit source-path "changed after launch")
        other-root (publication-root)
        _ (io/mkdir other-root)
        other-checkpoint (str other-root "/checkpoint.edn")
        checkpoint (context/load-checkpoint checkpoint-path)
        _ (context/save-checkpoint
            (assoc checkpoint
                   :current_node "work"
                   :completed_nodes ["start" "work"]
                   :node_outcomes
                   {"start" {:status :success}
                    "work" {:status :success}})
            other-checkpoint)
        link-parent (str (os/temp-dir) "/lettractor-link-parent-" (random-uuid))
        link-root (str link-parent "/run")
        replacement (str link-parent "/replacement")
        _ (io/mkdir link-parent)
        link-result (os/sh "ln" "-s" run-root link-root)
        calls (atom 0)
        registry (handlers/make-handler-registry)
        _ (handlers/register-handler!
            registry "pinned.original"
            (fn [_ _ _ _]
              (swap! calls inc)
              {:status :success}))
        swap-link!
        (fn [event]
          (when (= :workflow.drift_detected (:type event))
            (os/sh "ln" "-s" other-root replacement)
            (os/rename replacement link-root)))
        result (pipeline/resume (str link-root "/checkpoint.edn")
                                {:registry registry
                                 :on-event swap-link!})]
    (is (= 0 (:exit link-result)))
    (is (= :success (:status result)))
    (is (= 1 @calls))
    (is (io/file-exists? (str run-root "/work/status.json")))
    (is (not (io/file-exists? (str other-root "/work/status.json"))))))

(deftest public-resume-rejects-impossible-checkpoint-structure-before-events
  (doseq [[label mutate]
          [[:impossible-transition
            #(assoc %
                    :current_node "exit"
                    :completed_nodes ["start" "exit"])]
           [:unknown-outcome
            #(assoc-in % [:node_outcomes "unknown"] {:status :success})]
           [:uncompleted-outcome
            #(assoc-in % [:node_outcomes "work"] {:status :success})]
           [:nonstr-outcome
            #(assoc-in % [:node_outcomes :start] {:status :success})]
           [:unknown-retry
            #(assoc-in % [:node_retries "unknown"] 1)]
           [:uncompleted-retry
            #(assoc-in % [:node_retries "work"] 1)]
           [:nonstr-retry
            #(assoc-in % [:node_retries :start] 1)]]]
    (testing (name label)
      (let [{:keys [checkpoint-path]} (interrupted-pinned-run)
            _ (update-edn-file! checkpoint-path mutate)
            events (atom [])
            error (workflow-error
                    #(pipeline/resume checkpoint-path
                                      {:on-event #(swap! events conj %)}))]
        (is (= :workflow_snapshot_corrupt (:category error)))
        (is (= :checkpoint (:kind error)))
        (is (= [] @events))))))

(deftest public-resume-rejects-invalid-checkpoint-values-before-events-or-handlers
  (doseq [[label field node-id value mutate]
          [[:retry-string :node_retries "start" "oops"
            #(assoc-in % [:node_retries "start"] "oops")]
           [:retry-negative :node_retries "start" -1
            #(assoc-in % [:node_retries "start"] -1)]
           [:outcome-not-map :node_outcomes "start" :success
            #(assoc-in % [:node_outcomes "start"] :success)]
           [:outcome-status :node_outcomes "start" :unknown
            #(assoc-in % [:node_outcomes "start" :status] :unknown)]
           [:preferred-label :node_outcomes "start" 1
            #(assoc-in % [:node_outcomes "start" :preferred_label] 1)]
           [:suggested-ids :node_outcomes "start" ["work" 2]
            #(assoc % :node_outcomes
                    {"start" {"status" "success"
                              "suggested_next_ids" ["work" 2]}})]
           [:context-updates :node_outcomes "start" []
            #(assoc-in % [:node_outcomes "start" :context_updates] [])]
           [:notes :node_outcomes "start" 42
            #(assoc % :node_outcomes
                    {"start" {"status" "success" "notes" 42}})]
           [:next-node-id :node_outcomes "start" 42
            #(assoc-in % [:node_outcomes "start" :next_node_id] 42)]
           [:legacy-next-node-id :node_outcomes "start" 42
            #(assoc % :node_outcomes
                    {"start" {"status" "success" "next_node_id" 42}})]
           [:unknown-next-node-id :node_outcomes "start" "not-in-captured-plan"
            #(assoc-in % [:node_outcomes "start" :next_node_id]
                       "not-in-captured-plan")]]]
    (testing (name label)
      (let [{:keys [checkpoint-path]} (interrupted-pinned-run)
            _ (update-edn-file! checkpoint-path mutate)
            events (atom [])
            calls (atom 0)
            registry (handlers/make-handler-registry)
            _ (handlers/register-handler!
                registry "pinned.original"
                (fn [_ _ _ _]
                  (swap! calls inc)
                  {:status :success}))
            error (workflow-error
                    #(pipeline/resume checkpoint-path
                                      {:registry registry
                                       :on-event #(swap! events conj %)}))]
        (is (= :workflow_snapshot_corrupt (:category error)))
        (is (= :checkpoint (:kind error)))
        (is (= field (:field error)))
        (is (= node-id (:node-id error)))
        (is (= value (:value error)))
        (is (= [] @events))
        (is (= 0 @calls))))))

(deftest public-resume-accepts-legacy-string-keyed-outcomes
  (let [{:keys [checkpoint-path]} (interrupted-pinned-run)
        _ (update-edn-file!
            checkpoint-path
            #(assoc % :node_outcomes
                    {"start" {"status" "success"
                              "preferred_label" ""
                              "suggested_next_ids" []
                              "context_updates" {}
                              "notes" "legacy"}}))
        calls (atom 0)
        registry (handlers/make-handler-registry)
        _ (handlers/register-handler!
            registry "pinned.original"
            (fn [_ _ _ _]
              (swap! calls inc)
              {:status :success}))
        result (pipeline/resume checkpoint-path {:registry registry})]
    (is (= :success (:status result)))
    (is (= 1 @calls))))

(deftest public-resume-preserves-a-parallel-forks-legacy-next-node-id
  (let [source
        "digraph ParallelResume {
           start [shape=Mdiamond]
           fork [shape=component, max_parallel=2]
           left [type=parallel.count]
           right [type=parallel.count]
           join [shape=tripleoctagon]
           exit [shape=Msquare]
           start -> fork
           fork -> left -> join
           fork -> right -> join
           join -> exit
         }"
        run-root (publication-root)
        checkout (str (os/temp-dir) "/lettractor-parallel-current-"
                      (random-uuid))
        source-path (str checkout "/root.dot")
        _ (io/mkdir checkout)
        _ (io/spit source-path source)
        calls (atom {})
        registry (handlers/make-handler-registry)
        _ (handlers/register-handler!
            registry "parallel.count"
            (fn [node _ _ _]
              (swap! calls update (:id node) (fnil inc 0))
              {:status :success
               :context_updates {(str "branch." (:id node)) true}}))
        initial (pipeline/run source {:source-path source-path
                                      :logs-root run-root
                                      :registry registry
                                      :max-steps 2})
        initial-calls @calls
        checkpoint-path (str run-root "/checkpoint.edn")
        checkpoint (context/load-checkpoint checkpoint-path)
        fork-outcome (get-in checkpoint [:node_outcomes "fork"])
        _ (update-edn-file!
            checkpoint-path
            #(assoc-in % [:node_outcomes "fork"]
                       {"status" "success"
                        "next_node_id" "join"
                        "context_updates" (:context_updates fork-outcome)
                        "notes" (:notes fork-outcome)}))
        events (atom [])
        resumed (pipeline/resume checkpoint-path
                                 {:registry registry
                                  :on-event #(swap! events conj %)})
        resumed-calls @calls
        final-checkpoint (context/load-checkpoint checkpoint-path)
        completed-resume (pipeline/resume checkpoint-path
                                          {:registry registry})]
    (is (= :fail (:status initial)))
    (is (= ["start" "fork"] (:completed_nodes checkpoint)))
    (is (= {"left" 1 "right" 1} initial-calls))
    (is (= :success (:status resumed)))
    (is (= "join"
           (:node_id (first (filter #(= :stage.started (:type %)) @events)))))
    (is (= {"left" 1 "right" 1} resumed-calls))
    (is (= ["start" "fork" "join" "exit"]
           (:completed_nodes final-checkpoint)))
    (is (= "join"
           (get-in final-checkpoint [:node_outcomes "fork" :next_node_id])))
    ;; A second public resume validates the persisted non-edge fork -> join
    ;; history rather than accepting arbitrary jumps.
    (is (= :success (:status completed-resume)))
    (is (= {"left" 1 "right" 1} @calls))))

(deftest public-resume-allows-a-declared-retry-target-in-completed-history
  (let [source
        "digraph RetryHistory {
           start [shape=Mdiamond]
           flaky [type=history.flaky, retry_target=repair]
           repair [type=history.repair]
           exit [shape=Msquare]
           start -> flaky
           start -> repair [condition=\"outcome=fail\"]
           flaky -> exit [condition=\"outcome=success\"]
           repair -> flaky
         }"
        run-root (publication-root)
        initial-registry (handlers/make-handler-registry)
        _ (handlers/register-handler!
            initial-registry "history.flaky"
            (fn [_ _ _ _] {:status :fail :failure_reason "repair me"}))
        _ (handlers/register-handler!
            initial-registry "history.repair"
            (fn [_ _ _ _] {:status :success}))
        initial (pipeline/run source {:logs-root run-root
                                      :registry initial-registry
                                      :max-steps 3})
        checkpoint-path (str run-root "/checkpoint.edn")
        checkpoint (context/load-checkpoint checkpoint-path)
        resumed-calls (atom 0)
        resumed-registry (handlers/make-handler-registry)
        _ (handlers/register-handler!
            resumed-registry "history.flaky"
            (fn [_ _ _ _]
              (swap! resumed-calls inc)
              {:status :success}))
        result (pipeline/resume checkpoint-path {:registry resumed-registry})]
    (is (= :fail (:status initial)))
    (is (= ["start" "flaky" "repair"] (:completed_nodes checkpoint)))
    (is (= :success (:status result)))
    (is (= 1 @resumed-calls))))

(deftest public-resume-allows-a-goal-gate-reroute-in-completed-history
  (let [source
        "digraph GoalGateHistory {
           start [shape=Mdiamond]
           gate [type=history.gate, goal_gate=true, retry_target=repair]
           after [type=history.after]
           repair [type=history.repair]
           exit [shape=Msquare]
           start -> gate
           start -> repair [condition=\"outcome=fail\"]
           gate -> after [condition=\"outcome=fail\"]
           after -> exit
           repair -> gate
         }"
        run-root (publication-root)
        initial-registry (handlers/make-handler-registry)
        _ (handlers/register-handler!
            initial-registry "history.gate"
            (fn [_ _ _ _] {:status :fail :failure_reason "gate failed"}))
        _ (handlers/register-handler!
            initial-registry "history.after"
            (fn [_ _ _ _] {:status :success}))
        _ (handlers/register-handler!
            initial-registry "history.repair"
            (fn [_ _ _ _] {:status :success}))
        initial (pipeline/run source {:logs-root run-root
                                      :registry initial-registry
                                      :max-steps 5})
        checkpoint-path (str run-root "/checkpoint.edn")
        checkpoint (context/load-checkpoint checkpoint-path)
        resumed-registry (handlers/make-handler-registry)
        _ (handlers/register-handler!
            resumed-registry "history.gate"
            (fn [_ _ _ _] {:status :success}))
        result (pipeline/resume checkpoint-path {:registry resumed-registry})]
    (is (= :fail (:status initial)))
    (is (= ["start" "gate" "after" "repair"]
           (:completed_nodes checkpoint)))
    (is (= :success (:status result)))))

(deftest public-resume-allows-legacy-failed-node-retry-history
  (let [source
        "digraph LegacyRetryHistory {
           start [shape=Mdiamond]
           flaky [type=legacy.flaky, retry_target=repair]
           repair [type=legacy.repair]
           exit [shape=Msquare]
           start -> flaky
           start -> repair [condition=\"outcome=fail\"]
           flaky -> exit [condition=\"outcome=success\"]
           repair -> flaky
         }"
        run-root (publication-root)
        initial-registry (handlers/make-handler-registry)
        _ (handlers/register-handler!
            initial-registry "legacy.flaky"
            (fn [_ _ _ _] {:status :fail :failure_reason "repair me"}))
        _ (handlers/register-handler!
            initial-registry "legacy.repair"
            (fn [_ _ _ _] {:status :success}))
        _ (pipeline/run source {:logs-root run-root
                                :registry initial-registry
                                :max-steps 3})
        checkpoint-path (str run-root "/checkpoint.edn")
        _ (update-edn-file!
            checkpoint-path
            #(assoc % :node_outcomes
                    {"start" {"status" "success"}
                     "flaky" {"status" "fail"
                              "failure_reason" "repair me"}
                     "repair" {"status" "success"}}))
        events (atom [])
        registry (handlers/make-handler-registry)
        _ (handlers/register-handler!
            registry "legacy.flaky"
            (fn [_ _ _ _] {:status :success}))
        result (pipeline/resume checkpoint-path
                                {:registry registry
                                 :on-event #(swap! events conj %)})]
    (is (= :success (:status result)))
    (is (= :pipeline.started (:type (first @events))))
    (is (= "flaky"
           (:node_id (first (filter #(= :stage.started (:type %)) @events)))))))

