(ns attractor.workflow-recovery-contract-test
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.core :as core]
            [clojure.edn :as edn]
            [io :as io]
            [os :as os]
            [attractor.pipeline :as pipeline]
            [attractor.workflow :as workflow]))

(def root-dot
  "digraph Root { start [shape=Mdiamond] exit [shape=Msquare] start -> exit }")

(def changed-root-dot
  "digraph Root { start [shape=Mdiamond] work [shape=box] exit [shape=Msquare] start -> work -> exit }")

(defn- workflow-error [f]
  (try
    (do (f) nil)
    (catch ExceptionInfo error
      (ex-data error))))

(defn- serialization-error [value]
  (try
    (do (workflow/canonical-tree value) nil)
    (catch ExceptionInfo error
      (ex-data error))))

(deftest canonical-tree-uses-the-version-one-scalar-grammar
  (is (= ["nil"] (workflow/canonical-tree nil)))
  (is (= ["bool" true] (workflow/canonical-tree true)))
  (is (= ["int" "-12"] (workflow/canonical-tree -12)))
  (is (= ["decimal" "1.5"] (workflow/canonical-tree 1.50)))
  (is (= ["decimal" "-0.0"] (workflow/canonical-tree -0.0)))
  (is (= ["string" "héllo 世界"]
         (workflow/canonical-tree "héllo 世界")))
  (is (= ["keyword" nil "plain"]
         (workflow/canonical-tree :plain)))
  (is (= ["keyword" "workflow" "plan"]
         (workflow/canonical-tree :workflow/plan)))
  (is (= ["symbol" nil "plain"]
         (workflow/canonical-tree 'plain)))
  (is (= ["symbol" "δοκιμή" "λ"]
         (workflow/canonical-tree (symbol "δοκιμή" "λ")))))

(deftest canonical-tree-distinguishes-and-orders-containers
  (is (= ["vector" [["int" "1"] ["string" "x"]]]
         (workflow/canonical-tree [1 "x"])))
  (is (= ["list" [["int" "1"] ["string" "x"]]]
         (workflow/canonical-tree '(1 "x"))))
  (is (= ["map" [[["keyword" nil "a"] ["int" "1"]]
                 [["keyword" nil "b"] ["int" "2"]]]]
         (workflow/canonical-tree {:b 2 :a 1})))
  (is (= ["set" [["keyword" nil "a"] ["keyword" nil "b"]]]
         (workflow/canonical-tree #{:b :a}))))

(deftest canonical-edn-is-independent-of-map-set-order-and-metadata
  (let [left {:values (into {} [[:z 1] [:a 2]])
              :members (into #{} [:z :a])}
        right {:members (into #{} [:a :z])
               :values (into {} [[:a 2] [:z 1]])}]
    (is (= (workflow/canonical-edn left)
           (workflow/canonical-edn right)))
    (is (= (workflow/canonical-edn [1 2])
           (workflow/canonical-edn (with-meta [1 2] {:ignored true}))))))

(deftest canonical-tree-reports-exact-unsupported-structural-paths
  (let [handler-error
        (serialization-error
          {:nodes {"work" {:attrs {:handler (fn [] nil)}}}})
        map-key-error (serialization-error {(fn [] nil) 1})
        set-element-error (serialization-error #{(fn [] nil)})]
    (is (= {:category :workflow_not_serializable
            :path [:graph :nodes "work" :attrs :handler]}
           handler-error))
    (is (= {:category :workflow_not_serializable
            :path [:graph :map-key]}
           map-key-error))
    (is (= {:category :workflow_not_serializable
            :path [:graph :set-element]}
           set-element-error))))

(deftest canonical-tree-rejects-nonfinite-numbers
  (doseq [value [##NaN ##Inf ##-Inf]]
    (is (= {:category :workflow_not_serializable :path [:graph]}
           (serialization-error value)))))

(deftest canonical-tree-rejects-scalars-that-fail-edn-round-trip
  (doseq [reader [(fn [_] "different")
                  (fn [_] (throw (ex-info "reader failed" {})))]]
    (is (= {:category :workflow_not_serializable :path [:graph 0]}
           (with-redefs [edn/read-string reader]
             (serialization-error ["original"]))))))

(deftest sha256-text-locks-utf8-byte-digests
  (is (= "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
         (workflow/sha256-text "abc")))
  (is (= "c2a59c71097b678dc5af2eb1f98ddc575b63948b0fa6740071a945673aaada4d"
         (workflow/sha256-text "héllo wörld ✓"))))

(deftest plan-and-closure-fingerprints-have-independent-golden-vectors
  (let [graph {:greeting "héllo 世界" :count 2 :ratio 1.5}
        index {:format-version 1
               :root-plan-id "workflow://root"
               :sources []
               :plans []}]
    (is (= "[\"map\" [[[\"keyword\" nil \"count\"] [\"int\" \"2\"]] [[\"keyword\" nil \"greeting\"] [\"string\" \"héllo 世界\"]] [[\"keyword\" nil \"ratio\"] [\"decimal\" \"1.5\"]]]]"
           (workflow/canonical-edn graph)))
    (is (= "bb37904c667a2ee3b51ceab617d7eb289abae4e4b61a783fc57f63052cd6e142"
           (workflow/plan-fingerprint graph)))
    (is (= "815856054ca24c5a33b05c9ea4391743a593e362c429e045e2e543881938483e"
           (workflow/closure-fingerprint index)))))

(deftest prepare-captures-the-exact-root-source-and-prepared-graph
  (let [root (str (os/temp-dir) "/lettractor-root-capture-" (random-uuid))
        source-path (str root "/root.dot")
        _ (io/mkdir root)
        _ (io/spit source-path "current bytes are deliberately ignored")
        prepared (pipeline/prepare root-dot {:source-path source-path})
        graph (:graph prepared)
        bundle (:workflow prepared)
        source-sha (workflow/sha256-text root-dot)
        plan-sha (workflow/plan-fingerprint graph)
        expected-index
        {:format-version 1
         :root-plan-id "workflow://root"
         :sources [{:logical-id "workflow://root"
                    :source-sha256 source-sha}]
         :plans [{:logical-id "workflow://root"
                  :primary-plan-id "workflow://root"
                  :plan-sha256 plan-sha
                  :source-sha256 source-sha
                  :references []}]}]
    (is (= 1 (:format-version bundle)))
    (is (= "workflow://root" (:root-plan-id bundle)))
    (is (= expected-index (:index bundle)))
    (is (= (workflow/closure-fingerprint expected-index)
           (:fingerprint bundle)))
    (is (= [{:logical-id "workflow://root"
             :physical-id (os/canonical-path source-path)
             :source root-dot}]
           (:source-records bundle)))
    (is (= [{:id "root" :path (os/canonical-path root)}]
           (:workflow-roots bundle)))
    (is (= {:graph graph
            :plan-sha256 plan-sha
            :source-sha256 source-sha
            :primary-plan-id "workflow://root"
            :references []}
           (get-in bundle [:plans "workflow://root"])))
    (is (identical? graph
                    (get-in bundle [:plans "workflow://root" :graph])))))

(deftest prepare-supports-source-only-and-an-in-memory-base-directory
  (let [source-only (pipeline/prepare root-dot)
        base (str (os/temp-dir) "/lettractor-root-base-" (random-uuid))
        _ (io/mkdir base)
        based (pipeline/prepare root-dot {:base-dir base})]
    (is (map? (:workflow source-only)))
    (is (= [] (get-in source-only [:workflow :workflow-roots])))
    (is (= [{:logical-id "workflow://root"
             :physical-id nil
             :source root-dot}]
           (get-in source-only [:workflow :source-records])))
    (is (= [{:id "root" :path (os/canonical-path base)}]
           (get-in based [:workflow :workflow-roots])))
    (is (= nil
           (get-in based [:workflow :source-records 0 :physical-id])))))

(deftest workflow-roots-are-normalized-in-order-and-reject-conflicting-ids
  (let [first-root (str (os/temp-dir) "/lettractor-allowed-a-" (random-uuid))
        second-root (str (os/temp-dir) "/lettractor-allowed-b-" (random-uuid))
        _ (io/mkdir first-root)
        _ (io/mkdir second-root)
        prepared
        (pipeline/prepare
          root-dot
          {:base-dir first-root
           :workflow-roots [{:id "z" :path first-root}
                            {:id "a" :path second-root}
                            {:id "z" :path first-root}]})]
    (is (= [{:id "z" :path (os/canonical-path first-root)}
            {:id "a" :path (os/canonical-path second-root)}]
           (get-in prepared [:workflow :workflow-roots])))
    (is (= {:category :workflow_configuration_error
            :option :workflow-roots
            :reason :duplicate-id
            :id "same"}
           (workflow-error
             #(pipeline/prepare
                root-dot
                {:workflow-roots [{:id "same" :path first-root}
                                  {:id "same" :path second-root}]}))))
    (doseq [roots [{}
                   [{:id "ok"}]
                   [{:id 7 :path first-root}]
                   [{:id "" :path first-root}]
                   [{:id "ok" :path 7}]]]
      (is (= :workflow_configuration_error
             (:category
               (workflow-error
                 #(pipeline/prepare root-dot {:workflow-roots roots}))))))))

(deftest root-fingerprints-separate-source-plan-and-physical-identity
  (let [checkout-a (str (os/temp-dir) "/lettractor-checkout-a-" (random-uuid))
        checkout-b (str (os/temp-dir) "/lettractor-checkout-b-" (random-uuid))
        path-a (str checkout-a "/root.dot")
        path-b (str checkout-b "/root.dot")
        _ (io/mkdir checkout-a)
        _ (io/mkdir checkout-b)
        _ (io/spit path-a root-dot)
        _ (io/spit path-b root-dot)
        a (:workflow (pipeline/prepare root-dot {:source-path path-a}))
        b (:workflow (pipeline/prepare root-dot {:source-path path-b}))
        changed (:workflow (pipeline/prepare changed-root-dot))
        whitespace-source (str root-dot "\n\n")
        whitespace (:workflow (pipeline/prepare whitespace-source))]
    (is (= (:fingerprint a) (:fingerprint b)))
    (is (not= (get-in a [:source-records 0 :physical-id])
              (get-in b [:source-records 0 :physical-id])))
    (is (not= (get-in a [:plans "workflow://root" :source-sha256])
              (get-in changed [:plans "workflow://root" :source-sha256])))
    (is (not= (get-in a [:plans "workflow://root" :plan-sha256])
              (get-in changed [:plans "workflow://root" :plan-sha256])))
    (is (= (get-in a [:plans "workflow://root" :graph])
           (get-in whitespace [:plans "workflow://root" :graph])))
    (is (= (get-in a [:plans "workflow://root" :plan-sha256])
           (get-in whitespace [:plans "workflow://root" :plan-sha256])))
    (is (not= (get-in a [:plans "workflow://root" :source-sha256])
              (get-in whitespace [:plans "workflow://root" :source-sha256])))
    (is (not= (:fingerprint a) (:fingerprint whitespace)))))

(deftest closure-fingerprint-includes-logical-aliases-and-references
  (let [root-source (workflow/sha256-text root-dot)
        root-plan (workflow/plan-fingerprint (:graph (pipeline/prepare root-dot)))
        base {:format-version 1
              :root-plan-id "workflow://root"
              :sources [{:logical-id "workflow://root"
                         :source-sha256 root-source}]
              :plans [{:logical-id "workflow://root"
                       :primary-plan-id "workflow://root"
                       :plan-sha256 root-plan
                       :source-sha256 root-source
                       :references []}]}
        alias (-> base
                  (update :sources conj
                          {:logical-id "workflow://root/alias.dot"
                           :source-sha256 root-source})
                  (update :plans conj
                          {:logical-id "workflow://root/alias.dot"
                           :primary-plan-id "workflow://root"
                           :plan-sha256 root-plan
                           :source-sha256 root-source
                           :references []}))
        referenced (assoc-in
                     base [:plans 0 :references]
                     [{:node-id "child"
                       :logical-reference "child.dot"
                       :plan-id "workflow://root/child.dot"}])]
    (is (not= (workflow/closure-fingerprint base)
              (workflow/closure-fingerprint alias)))
    (is (not= (workflow/closure-fingerprint base)
              (workflow/closure-fingerprint referenced)))))

(defn- publication-root []
  (str (os/temp-dir) "/lettractor-publication-" (random-uuid)))

(defn- prepared-bundle []
  (:workflow (pipeline/prepare root-dot)))

(deftest workflow-publication-commits-content-before-an-edn-manifest
  (let [run-root (publication-root)
        bundle (prepared-bundle)
        writes (atom [])
        renames (atom [])
        real-spit io/spit
        real-rename os/rename
        manifest-path
        (with-redefs [io/spit (fn [path content]
                               (swap! writes conj path)
                               (real-spit path content))
                      os/rename (fn [source target]
                                  (swap! renames conj [source target])
                                  (real-rename source target))]
          (workflow/publish! bundle run-root))
        manifest (edn/read-string (io/slurp manifest-path))
        source-path (get-in manifest [:sources 0 :path])
        plan-path (get-in manifest [:plans 0 :path])]
    (is (= (str run-root "/workflow/manifest.edn") manifest-path))
    (is (= (:fingerprint bundle) (:fingerprint manifest)))
    (is (= (:index bundle) (:index manifest)))
    (is (= root-dot (io/slurp (str run-root "/" source-path))))
    (is (= (get-in bundle [:plans workflow/root-plan-id :graph])
           (workflow/decode-canonical-tree
             (edn/read-string (io/slurp (str run-root "/" plan-path))))))
    (is (= manifest-path (second (last @renames))))
    (is (every? #(re-find #"[.]tmp-[0-9a-f-]+$" (first %)) @renames))
    (is (nil? (os/stat (str run-root "/workflow/.publish.lock"))))
    (is (map? (edn/read-string (io/slurp manifest-path))))))

(deftest workflow-publication-reuses-verified-content-and-rejects-collisions
  (testing "the same immutable bundle is reusable"
    (let [run-root (publication-root)
          bundle (prepared-bundle)
          first-path (workflow/publish! bundle run-root)
          first-bytes (io/slurp first-path)
          second-path (workflow/publish! bundle run-root)]
      (is (= first-path second-path))
      (is (= first-bytes (io/slurp second-path)))
      (is (= (:fingerprint bundle)
             (:fingerprint (workflow/read-manifest! second-path))))))
  (testing "different manifests never overwrite a committed run"
    (let [run-root (publication-root)
          first (prepared-bundle)
          second (:workflow (pipeline/prepare changed-root-dot))
          path (workflow/publish! first run-root)
          before (io/slurp path)
          error (workflow-error #(workflow/publish! second run-root))]
      (is (= :workflow_already_published (:category error)))
      (is (= before (io/slurp path)))))
  (testing "an existing content address with wrong bytes is rejected"
    (let [run-root (publication-root)
          bundle (prepared-bundle)
          source-sha (get-in bundle [:index :sources 0 :source-sha256])
          source-dir (str run-root "/workflow/sources")
          _ (io/mkdir source-dir)
          target (str source-dir "/" source-sha ".dot")
          _ (io/spit target "wrong bytes")
          error (workflow-error #(workflow/publish! bundle run-root))]
      (is (= :workflow_snapshot_corrupt (:category error)))
      (is (= target (:path error))))))

(deftest workflow-publication-refuses-an-uncommitted-lock
  (let [run-root (publication-root)
        workflow-dir (str run-root "/workflow")
        _ (io/mkdir workflow-dir)
        _ (io/mkdir (str workflow-dir "/.publish.lock"))
        error (workflow-error #(workflow/publish! (prepared-bundle) run-root))]
    (is (= :workflow_publication_incomplete (:category error)))
    (is (nil? (os/stat (str workflow-dir "/manifest.edn"))))))

(deftest concurrent-publishers-never-corrupt-the-committed-bundle
  (let [run-root (publication-root)
        bundle (prepared-bundle)
        started (promise)
        release (promise)
        real-spit io/spit
        first (core/future
                (with-redefs [io/spit
                              (fn [path content]
                                (when (and (re-find #"/sources/" path)
                                           (re-find #"[.]tmp-" path))
                                  (deliver started true)
                                  (deref release 1000 :timeout))
                                (real-spit path content))]
                  (workflow/publish! bundle run-root)))
        _ (deref started 1000 :not-started)
        second (core/future
                 (try
                   {:path (workflow/publish! bundle run-root)}
                   (catch ExceptionInfo error
                     {:error (ex-data error)})))
        second-result (deref second 1000 :timeout)
        _ (deliver release true)
        first-path (deref first 1000 :timeout)]
    (is (or (= :workflow_publication_incomplete
               (get-in second-result [:error :category]))
            (= first-path (:path second-result))))
    (is (= (:fingerprint bundle)
           (:fingerprint (workflow/read-manifest! first-path))))))

(deftest verify-published-validates-the-expected-fingerprint
  (let [run-root (publication-root)
        bundle (prepared-bundle)
        _ (workflow/publish! bundle run-root)
        verified (workflow/verify-published! run-root (:fingerprint bundle))]
    (is (= (:fingerprint bundle) (get-in verified [:workflow :fingerprint])))
    (is (= (:graph (get-in bundle [:plans workflow/root-plan-id]))
           (:graph verified)))
    (is (= :workflow_snapshot_corrupt
           (:category
             (workflow-error
               #(workflow/verify-published! run-root "not-the-fingerprint")))))))
