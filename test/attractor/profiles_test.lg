(ns attractor.profiles-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string :as str]
            [attractor.profiles :as profiles]))

(deftest test-tool-registry-is-latest-wins
  (let [registry (profiles/make-tool-registry)
        first-tool {:definition {:name "lookup" :description "first"
                                 :parameters {:type "object"}}
                    :executor (fn [_ _] "first")}
        replacement {:definition {:name "lookup" :description "replacement"
                                  :parameters {:type "object"}}
                     :executor (fn [_ _] "replacement")}]
    (profiles/register-tool! registry first-tool)
    (profiles/register-tool! registry replacement)
    (is (= replacement (profiles/registry-get registry "lookup")))
    (is (= ["lookup"] (profiles/registry-names registry)))
    (is (= "replacement"
           (:description (first (profiles/registry-definitions registry)))))
    (profiles/unregister-tool! registry "lookup")
    (is (nil? (profiles/registry-get registry "lookup")))))

(deftest test-tool-registry-requires-object-parameter-schemas
  (doseq [parameters [nil {:properties {}} {:type "array"}]]
    (is (= :invalid-tool-definition
           (try
             (do
               (profiles/register-tool!
                 (profiles/make-tool-registry)
                 {:definition {:name "unsafe" :parameters parameters}
                  :executor (fn [_ _] "unsafe")})
               nil)
             (catch Object error (:category (ex-data error))))))))

(deftest test-provider-profiles-have-provider-aligned-editing-tools
  (let [openai (profiles/create-openai-profile "gpt-5-codex")
        anthropic (profiles/create-anthropic-profile "claude-sonnet")
        gemini (profiles/create-gemini-profile "gemini-pro")
        names (fn [profile]
                (set (profiles/registry-names (:tool_registry profile))))]
    (is (contains? (names openai) "apply_patch"))
    (is (not (contains? (names openai) "edit_file")))
    (is (contains? (names anthropic) "edit_file"))
    (is (not (contains? (names anthropic) "apply_patch")))
    (is (contains? (names gemini) "read_many_files"))
    (is (= 120000 (:default_command_timeout_ms anthropic)))
    (is (true? (:supports_parallel_tool_calls openai)))))

(deftest test-provider-profiles-expose-required-tool-schemas
  (let [openai (profiles/create-openai-profile "gpt-5-codex")
        anthropic (profiles/create-anthropic-profile "claude-sonnet")
        gemini (profiles/create-gemini-profile "gemini-pro")
        registry (fn [profile] (:tool_registry profile))
        names (fn [profile] (set (profiles/registry-names (registry profile))))
        properties
        (fn [profile tool]
          (get-in (profiles/registry-get (registry profile) tool)
                  [:definition :parameters :properties]))]
    (is (= #{"read_file" "apply_patch" "write_file" "shell" "grep" "glob"}
           (names openai)))
    (is (= #{"read_file" "edit_file" "write_file" "shell" "grep" "glob"}
           (names anthropic)))
    (is (= #{"read_file" "read_many_files" "edit_file" "write_file"
             "shell" "grep" "glob" "list_dir"}
           (names gemini)))
    (doseq [profile [openai anthropic gemini]]
      (is (= #{:command :timeout_ms :description}
             (set (keys (properties profile "shell"))))))
    (doseq [profile [openai gemini]]
      (is (= #{:pattern :path :glob_filter :case_insensitive :max_results}
             (set (keys (properties profile "grep"))))))
    (is (= #{:pattern :path :glob_filter :case_insensitive :max_results
             :output_mode}
           (set (keys (properties anthropic "grep")))))
    (is (= ["content" "files_with_matches" "count"]
           (get-in (properties anthropic "grep") [:output_mode :enum])))
    (is (= #{:path :depth}
           (set (keys (properties gemini "list_dir")))))))

(deftest test-profile-shell-tools-use-provider-specific-defaults
  (let [calls (atom [])
        environment
        {:default_command_timeout_ms 5000
         :exec_command
         (fn [command timeout-ms working-directory env]
           (swap! calls conj [command timeout-ms working-directory env])
           {:exit_code 0 :stdout "ok" :stderr ""})}
        invoke
        (fn [profile arguments]
          (let [tool (profiles/registry-get (:tool_registry profile) "shell")]
            ((:executor tool) arguments environment)))]
    (invoke (profiles/create-openai-profile) {"command" "openai"})
    (invoke (profiles/create-anthropic-profile) {"command" "anthropic"})
    (invoke (profiles/create-gemini-profile)
            {"command" "gemini" "timeout_ms" 321})
    (is (= [["openai" 5000 nil nil]
            ["anthropic" 120000 nil nil]
            ["gemini" 321 nil nil]]
           @calls))))

(deftest test-anthropic-grep-forwards-output-mode
  (let [calls (atom [])
        profile (profiles/create-anthropic-profile)
        tool (profiles/registry-get (:tool_registry profile) "grep")
        environment
        {:grep (fn [pattern path options]
                 (swap! calls conj [pattern path options])
                 "a.lg:2")}
        arguments {"pattern" "needle" "path" "src"
                   "output_mode" "count"}]
    (is (= "a.lg:2" ((:executor tool) arguments environment)))
    (is (= [["needle" "src" arguments]] @calls))))

(deftest test-gemini-list-dir-delegates-to-execution-environment
  (let [calls (atom [])
        profile (profiles/create-gemini-profile "gemini")
        tool (profiles/registry-get (:tool_registry profile) "list_dir")
        environment
        {:list_directory
         (fn [path depth]
           (swap! calls conj [path depth])
           [{:name "src" :is_dir true}])}]
    (is (= [{:name "src" :is_dir true}]
           ((:executor tool) {"path" "." "depth" 2} environment)))
    (is (= [["." 2]] @calls))))

(deftest test-anthropic-edit-tool-delegates-to-environment
  (let [calls (atom [])
        profile (profiles/create-anthropic-profile "claude")
        registered (profiles/registry-get (:tool_registry profile) "edit_file")
        environment {:edit_file
                     (fn [path old new replace-all]
                       (swap! calls conj [path old new replace-all])
                       1)}]
    (is (= 1 ((:executor registered)
              {"file_path" "a.txt" "old_string" "x"
               "new_string" "y" "replace_all" false}
              environment)))
    (is (= [["a.txt" "x" "y" false]] @calls))))

(deftest test-provider-system-prompts-cover-native-agent-conventions
  (let [environment {:working_directory (fn [] "/workspace")
                     :platform (fn [] "test-os")}
        prompt (fn [profile]
                 (str/lower-case
                   (profiles/build-system-prompt profile environment [])))
        openai (prompt (profiles/create-openai-profile))
        anthropic (prompt (profiles/create-anthropic-profile))
        gemini (prompt (profiles/create-gemini-profile))]
    (doseq [topic ["openai codex" "tool" "apply_patch"
                   "*** begin patch" "verify" "error"]]
      (is (str/includes? openai topic) topic))
    (doseq [topic ["anthropic claude" "tool" "read before"
                   "edit_file" "old_string" "unique" "write_file"
                   "verify"]]
      (is (str/includes? anthropic topic) topic))
    (doseq [topic ["google gemini" "tool" "gemini.md"
                   "read_many_files" "list_dir" "edit_file" "verify"]]
      (is (str/includes? gemini topic) topic))
    (is (not= openai anthropic))
    (is (not= anthropic gemini))))

(deftest test-profile-compatibility-api
  (is (= "openai" (:id (profiles/create-openai-profile))))
  (is (= "anthropic" (:id (profiles/get-profile-by-id "claude"))))
  (is (= 3 (count profiles/available-providers))))
