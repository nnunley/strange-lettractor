(ns attractor.gemini-reasoning-budget-test
  (:require [clojure.test :refer [deftest is testing]]
            [json :as json]
            [attractor.llm :as llm]))

(defn- serialized [model effort mode & [provider-options]]
  (let [captured (atom nil)
        response {:responseId "budget-test"
                  :candidates [{:content {:role "model" :parts [{:text "ok"}]}
                                :finishReason "STOP"}]
                  :usageMetadata {:promptTokenCount 1 :candidatesTokenCount 1}}
        request (cond-> {:provider "gemini" :model model :api_key "test-key"
                         :messages [{:role :user :content "hello"}]
                         :transport (fn [wire]
                                      (reset! captured wire)
                                      {:status 200
                                       :body (if (= mode :stream)
                                               (str "data: " (json/write-json response) "\n\n")
                                               (json/write-json response))})}
                  effort (assoc :reasoning_effort effort)
                  provider-options (assoc :provider_options {:gemini provider-options}))]
    (if (= mode :stream)
      (doall (llm/gemini-stream request))
      (llm/gemini-complete request))
    (json/read-json (:body @captured))))

(deftest gemini-25-portable-effort-serializes-budgets-on-complete-and-stream
  (doseq [mode [:complete :stream]
          model ["gemini-2.5-pro" "models/gemini-2.5-flash" "gemini-2.5-flash-lite-preview"]]
    (testing (str mode " " model)
      (let [low (get-in (serialized model "low" mode)
                        ["generationConfig" "thinkingConfig"])
            high (get-in (serialized model "high" mode)
                         ["generationConfig" "thinkingConfig"])]
        (is (= {"thinkingBudget" 1024} low))
        (is (= {"thinkingBudget" 24576} high)))))
  (is (= 8192
         (get-in (serialized "gemini-2.5-pro" "medium" :complete)
                 ["generationConfig" "thinkingConfig" "thinkingBudget"]))))

(deftest gemini-budget-preserves-explicit-settings-and-other-models
  (doseq [mode [:complete :stream]]
    (is (nil? (get-in (serialized "gemini-2.5-pro" nil mode)
                      ["generationConfig" "thinkingConfig"])))
    (is (= {"thinkingBudget" 0}
           (get-in (serialized "gemini-2.5-flash" "high" mode
                               {"generationConfig" {"thinkingConfig" {"thinkingBudget" 0}}})
                   ["generationConfig" "thinkingConfig"])))
    (is (= {"thinkingBudget" -1}
           (get-in (serialized "gemini-2.5-pro" "low" mode
                               {:generationConfig {:thinkingConfig {:thinkingBudget -1}}})
                   ["generationConfig" "thinkingConfig"])))
    (is (= {"thinkingLevel" "high"}
           (get-in (serialized "gemini-3-pro" "high" mode)
                   ["generationConfig" "thinkingConfig"])))
    (is (= {"thinkingLevel" "high"}
           (get-in (serialized "future-gemini-model" "high" mode)
                   ["generationConfig" "thinkingConfig"])))))
