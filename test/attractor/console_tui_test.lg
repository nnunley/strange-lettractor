(ns attractor.console-tui-test
  (:require [clojure.test :refer [deftest is]] [clojure.core :as core]
            [clojure.string :as str] [tiny-tui.key :as key]
            [attractor.hub :as hub] [attractor.execution :as execution]
            [attractor.profiles :as profiles]
            [attractor.console.session :as session] [attractor.console.tui :as tui]))

;; SCN-CONSOLE-TUI: the tiny-tui frontend drives the same dispatcher headlessly
;; with scripted keys and a captured render; Ctrl-C routes by state.

(defn- hub-options []
  {:session_options {:provider_profile (profiles/make-profile {:id "fixture" :model "fixture" :supports_streaming false})
                     :execution_env (execution/make-environment {:file_exists (fn [_] false)
                                                                 :inspect_command (fn [_] {:exit_code 1 :stdout ""})})
                     :project_docs []
                     :complete_fn (fn [request]
                                    (let [text (:content (last (:messages request)))]
                                      (when (= text "slow") (core/sleep 400))
                                      {:message {:role :assistant :content (str "echo: " text)}}))}})
(defn- keys-for [text] (concat (map str (seq text)) [:enter]))
(defn- scripted-keys [groups]
  ;; Each group is a vector of key messages followed by a pause so hub events
  ;; can arrive; nil ends input.
  (let [queue (atom (vec groups))]
    (fn []
      (loop []
        (let [q @queue]
          (cond
            (empty? q) nil
            (empty? (first q)) (do (swap! queue #(vec (rest %))) (core/sleep 200) (recur))
            :else (let [k (first (first q))] (swap! queue #(vec (cons (rest (first %)) (rest %)))) k)))))))
(defn- has? [lines s] (boolean (some #(str/includes? % s) lines)))

(deftest headless-tui-routes-text-eval-and-ctrl-c-by-state
  (let [h (hub/start! (hub-options)) c (session/open! h) frames (atom [])]
    (try
      (let [result (tui/run! c {:screen false :render-fn #(swap! frames conj %) :poll-ms 10
                                :read-key (scripted-keys [(keys-for "hello") []
                                                          (keys-for ": (+ 1 2)") []
                                                          (keys-for ":{") (keys-for "(+ 1") [:ctrl-c] []
                                                          (keys-for "/list") []
                                                          (keys-for "slow") [:ctrl-c] []
                                                          [:ctrl-c]])})
            transcript (:transcript result)]
        (is (= :quit (:event result)) (pr-str (:event result)))
        (is (has? transcript "> hello"))
        (is (has? transcript "echo: hello"))
        (is (has? transcript "[eval] => 3"))
        (is (has? transcript "(draft discarded)"))
        (is (has? transcript "* session"))
        (is (has? transcript "cancel requested: session") "Ctrl-C during a busy focus cancels")
        (is (has? transcript "bye"))
        (is (session/closed? c))
        (is (some #(str/includes? % "attractor console") @frames) "status line rendered")
        (is (some #(str/includes? % "multiline eval draft") @frames) "draft state shown while buffering"))
      (finally (deref (hub/request! h {:id "stop" :op :hub/stop}) 5000 nil)))))

(deftest eof-ends-the-tui-and-detaches
  (let [h (hub/start! (hub-options)) c (session/open! h)]
    (try
      (let [result (tui/run! c {:screen false :render-fn (fn [_] nil) :poll-ms 10 :read-key (scripted-keys [])})]
        (is (nil? (:event result)))
        (is (session/closed? c)))
      (finally (deref (hub/request! h {:id "stop" :op :hub/stop}) 5000 nil)))))

(deftest activity-ticks-preserve-editor-and-inline-transcript
  (let [events (atom []) c (atom {:focus {:kind :session :id "s"} :session "s" :cursor 0
                                :events_fn (fn [_ _] {:events @events :cursor 1})
                                :text_buffers {} :presentation true})
        printed (atom [])
        state {:console c :transcript [] :pending [] :inline? true :flush-lines #(swap! printed into %)
               :input {:text "my unfinished input" :cursor 5}}
        _ (reset! events [{:source :session :session_id "s" :event {:type :tool_call_start :call_id "x" :tool_name "read_file"}}
                         {:source :session :session_id "s" :event {:type :assistant_text_end :text "Looking closely."}}])
        next (first (tui/update state :attractor.console.tui/tick))
        frame (tui/view (assoc next :tui/size [40 12]))]
    (is (= (:input state) (:input next)))
    (is (= ["Looking closely."] @printed))
    (is (str/includes? frame "Reading files"))
    (is (= 2 (count (str/split frame #"\n")))))
  (let [c (atom {:activity {:phase "bad\nline\u001b[31m"}})
        frame (tui/view {:console c :inline? true :tui/size [4 2] :input {:text "abcdef" :cursor 6}})]
    (is (= 2 (count (str/split frame #"\n"))))))

(deftest discarding-an-editor-draft-does-not-cancel-the-busy-session
  (let [release (promise) started (promise)
        opts (assoc-in (hub-options) [:session_options :complete_fn]
                      (fn [_] (deliver started true) @release {:message {:role :assistant :content "done"}}))
        h (hub/start! opts) c (session/open! h)]
    (try
      (session/handle! c {:type :line :text "work"})
      (is (= true (deref started 2000 false)))
      (let [state {:console c :transcript [] :pending [] :buffering false
                   :input {:text "unsubmitted draft" :cursor 17}}
            discarded (first (tui/update state :attractor.console.tui/interrupt))]
        (is (= "" (get-in discarded [:input :text])))
        (is (session/busy? c) "discarding a local editor draft leaves work running")
        (is (not (:closed (first (:value (deref (hub/request! h {:id "list" :op :session/list}) 2000 nil))))))
        (let [cancelled (first (tui/update discarded :attractor.console.tui/interrupt))]
          (is (has? (:transcript cancelled) "cancel requested: session"))))
      (finally (deliver release true)
               (deref (hub/request! h {:id "stop" :op :hub/stop}) 5000 nil)))))

(deftest ctrl-d-preserves-a-whitespace-only-editor-draft
  (let [c (atom {:quit false})
        state {:console c :transcript [] :pending [] :input {:text "  " :cursor 0}}
        next (first (tui/update state (key/parse (str (char 4)))))]
    (is (= " " (get-in next [:input :text])) "Ctrl-D deletes forward in a nonempty draft")
    (is (not (session/closed? c)))))

(deftest discarding-a-whitespace-draft-does-not-cancel-the-busy-session
  (let [release (promise) started (promise)
        opts (assoc-in (hub-options) [:session_options :complete_fn]
                      (fn [_] (deliver started true) @release {:message {:role :assistant :content "done"}}))
        h (hub/start! opts) c (session/open! h)]
    (try
      (session/handle! c {:type :line :text "work"})
      (is (= true (deref started 2000 false)))
      (let [state {:console c :transcript [] :pending [] :buffering false
                   :input {:text "  " :cursor 2}}
            discarded (first (tui/update state :attractor.console.tui/interrupt))]
        (is (= "" (get-in discarded [:input :text])))
        (is (session/busy? c) "discarding a local editor draft leaves work running")
        (is (not (:closed (first (:value (deref (hub/request! h {:id "list" :op :session/list}) 2000 nil))))))
        (let [cancelled (first (tui/update discarded :attractor.console.tui/interrupt))]
          (is (has? (:transcript cancelled) "cancel requested: session"))))
      (finally (deliver release true)
               (deref (hub/request! h {:id "stop" :op :hub/stop}) 5000 nil)))))


(deftest parsed-ctrl-d-quits-an-empty-editor
  (let [c (atom {:quit false})
        [next event] (tui/update {:console c :transcript [] :pending [] :input {:text "" :cursor 0}}
                                 (key/parse (str (char 4))))]
    (is (= :quit event))
    (is (session/closed? c))))
