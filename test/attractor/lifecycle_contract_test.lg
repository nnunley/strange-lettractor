(ns attractor.lifecycle-contract-test
  (:require [clojure.test :refer [deftest is testing]]
            [os :as os]
            [attractor.context :as context]
            [attractor.handlers :as handlers]
            [attractor.parser :as parser]
            [attractor.pipeline :as pipeline]
            [attractor.stylesheet :as stylesheet]
            [attractor.transforms :as transforms]
            [attractor.validation :as validation]))

(deftest subgraph-label-derivation-is-order-independent
  (let [graph
        (parser/parse-dot
          "digraph G {
             graph [model_stylesheet=\".late-label { llm_model: late-model; } .early-label { llm_model: early-model; } .edge-member { llm_provider: edge-provider; } .ordinary-scope { llm_provider: ordinary-provider; } .outer-scope { llm_model: outer-model; } .inner-scope { llm_provider: inner-provider; }\"]
             outside [class=external, prompt=preserved, shape=diamond]
             subgraph edge_membership {
               label = \"Edge Member\"
               outside -> introduced_inside
             }
             ordinary_existing [class=external, prompt=preserved, shape=diamond]
             subgraph existing_membership {
               label = \"Ordinary Scope\"
               ordinary_existing
             }
             subgraph later_redeclaration {
               label = \"Ordinary Scope\"
               member_redeclared
             }
             member_redeclared [prompt=later]
             subgraph late {
               before [class=explicit]
               chained -> edge_node
               duplicate [class=\"late-label\"]
               label = \" Late   Label!! \"
             }
             subgraph early {
               label = \"Early Label\"
               early_node [class=manual]
             }
             subgraph outer {
               node [thread_id=outer]
               outer_before
               subgraph inner {
                 inner_before [class=\"explicit-inner\"]
                 label = \"Inner Scope\"
               }
               outer_after
               label = \"Outer Scope\"
             }
           }")
        rules (stylesheet/parse-stylesheet (:model_stylesheet graph))
        props-for (fn [node-id]
                    (stylesheet/resolve-node-model-props
                      (parser/find-node graph node-id) rules (:attrs graph)))
        model-for (fn [node-id] (:llm_model (props-for node-id)))]
    (testing "label-after updates explicit and edge-introduced nodes"
      (is (= "explicit,late-label" (:class (parser/find-node graph "before"))))
      (is (= "late-label" (:class (parser/find-node graph "chained"))))
      (is (= "late-label" (:class (parser/find-node graph "edge_node"))))
      (is (= "late-model" (model-for "before")))
      (is (= "late-model" (model-for "edge_node"))))
    (testing "derived class is composed exactly once"
      (is (= "late-label" (:class (parser/find-node graph "duplicate")))))
    (testing "label-before behavior remains styled"
      (is (= "manual,early-label" (:class (parser/find-node graph "early_node"))))
      (is (= "early-model" (model-for "early_node"))))
    (testing "label-before edge membership updates existing endpoints"
      (is (= "external,edge-member"
             (:class (parser/find-node graph "outside"))))
      (is (= "edge-member"
             (:subgraph_class (parser/find-node graph "outside"))))
      (is (= "edge-provider" (:llm_provider (props-for "outside"))))
      (is (= "preserved" (:prompt (parser/find-node graph "outside"))))
      (is (= "diamond" (:shape (parser/find-node graph "outside")))))
    (testing "ordinary membership preserves an existing node declaration"
      (is (= "external,ordinary-scope"
             (:class (parser/find-node graph "ordinary_existing"))))
      (is (= "ordinary-scope"
             (:subgraph_class (parser/find-node graph "ordinary_existing"))))
      (is (= "ordinary-provider"
             (:llm_provider (props-for "ordinary_existing"))))
      (is (= "preserved"
             (:prompt (parser/find-node graph "ordinary_existing"))))
      (is (= "diamond" (:shape (parser/find-node graph "ordinary_existing")))))
    (testing "later ordinary redeclaration preserves subgraph membership"
      (is (= "ordinary-scope"
             (:class (parser/find-node graph "member_redeclared"))))
      (is (= "ordinary-scope"
             (:subgraph_class (parser/find-node graph "member_redeclared"))))
      (is (= "ordinary-provider"
             (:llm_provider (props-for "member_redeclared"))))
      (is (= "later" (:prompt (parser/find-node graph "member_redeclared")))))
    (testing "scoped defaults and nested scope restoration remain intact"
      (is (= "outer" (:thread_id (parser/find-node graph "inner_before"))))
      (is (= "explicit-inner,inner-scope,outer-scope"
             (:class (parser/find-node graph "inner_before"))))
      (is (= "inner-scope"
             (:subgraph_class (parser/find-node graph "inner_before"))))
      (is (= "inner-provider" (:llm_provider (props-for "inner_before"))))
      (is (= "outer-model" (model-for "inner_before")))
      (is (= "outer-scope" (:class (parser/find-node graph "outer_after"))))
      (is (= "outer-scope"
             (:subgraph_class (parser/find-node graph "outer_after"))))
      (is (= "outer-model" (model-for "outer_after"))))))

;; SCN-SUBGRAPH-LABEL COMPLETE

(defn- validation-fixtures []
  (let [invalid (parser/parse-dot
                  "digraph Invalid {
                     graph [model_stylesheet=\"not a stylesheet\"]
                     start [shape=Mdiamond]
                     invalid [type=unknown, fidelity=invalid, retry_target=missing]
                     gate [goal_gate=true]
                     exit [shape=Msquare]
                     start -> exit
                     exit -> start [condition=\"a==b\"]
                   }")
        missing-boundaries (parser/parse-dot
                             "digraph Missing { lone [shape=box] }")
        manual (-> (parser/parse-dot
                     "digraph Manual {
                        start [shape=Mdiamond]
                        exit [shape=Msquare]
                        start -> exit
                      }")
                   (assoc-in [:nodes "blank"]
                             {:id "blank"
                              :shape "box"
                              :type "codergen"
                              :label ""
                              :prompt ""
                              :class ""
                              :subgraph_class ""
                              :attrs {}})
                   (update :edges conj
                           {:from "ghost" :to "missing" :condition ""}))]
    [invalid missing-boundaries manual]))

(defn- canonical-diagnostic? [diag]
  (let [allowed-keys #{:rule :severity :message :node_id :edge :fix}]
    (and (every? allowed-keys (keys diag))
         (contains? diag :rule)
         (contains? diag :severity)
         (contains? diag :message)
         (string? (:rule diag))
         (contains? #{:error :warning :info} (:severity diag))
         (string? (:message diag))
         (not (contains? diag :node-id))
         (or (not (contains? diag :node_id))
             (string? (:node_id diag)))
         (or (not (contains? diag :edge))
             (and (vector? (:edge diag))
                  (= 2 (count (:edge diag)))
                  (every? string? (:edge diag))))
         (or (not (contains? diag :fix))
             (string? (:fix diag))))))

(deftest validation-api-preserves-schema-order-and-complete-results
  (let [fixtures (validation-fixtures)
        validation-graph (first fixtures)
        built-in-diags (vec (mapcat validation/validate fixtures))
        expected-rules #{"start_node"
                         "terminal_node"
                         "start_no_incoming"
                         "exit_no_outgoing"
                         "edge_target_exists"
                         "reachability"
                         "condition_syntax"
                         "stylesheet_syntax"
                         "type_known"
                         "fidelity_valid"
                         "retry_target_exists"
                         "goal_gate_has_retry"
                         "prompt_on_llm_nodes"}
        emitted-rules (set (map :rule built-in-diags))
        reachability (first (filter (fn [diag]
                                      (= "reachability" (:rule diag)))
                                    built-in-diags))]
    (testing "every built-in rule family uses the canonical public schema"
      (is (every? emitted-rules expected-rules))
      (is (every? canonical-diagnostic? built-in-diags))
      (is (= :error (:severity reachability)))
      (is (string? (:node_id reachability)))
      (is (some :node_id built-in-diags))
      (is (some :edge built-in-diags)))
    (testing "custom rules run after built-ins in registration and result order"
      (let [built-ins (validation/validate validation-graph)
            calls (atom [])
            custom-diags [{:rule "custom_first"
                           :severity :warning
                           :message "first warning"
                           :node_id "invalid"
                           :edge ["start" "invalid"]
                           :fix "Connect the node"}
                          {:rule "custom_first_info"
                           :severity :info
                           :message "first info"}
                          {:rule "custom_second"
                           :severity :warning
                           :message "second warning"}]
            first-rule (fn [_]
                         (swap! calls conj :first)
                         (subvec custom-diags 0 2))
            second-rule (fn [_]
                          (swap! calls conj :second)
                          [(nth custom-diags 2)])
            diagnostics (validation/validate validation-graph [first-rule second-rule])]
        (is (= [:first :second] @calls))
        (is (= (vec (concat built-ins custom-diags)) diagnostics))
        (is (every? canonical-diagnostic? diagnostics))))
    (testing "errors carry the complete diagnostics vector"
      (let [custom-rules [(fn [_]
                            [{:rule "custom_warning"
                              :severity :warning
                              :message "keep warning"}])
                          (fn [_]
                            [{:rule "custom_info"
                              :severity :info
                              :message "keep info"}])]
            expected (validation/validate validation-graph custom-rules)
            error (try
                    (do (validation/validate-or-raise validation-graph custom-rules) nil)
                    (catch Object caught caught))]
        (is (= :validation_error (:category (ex-data error))))
        (is (= expected (:diagnostics (ex-data error))))
        (is (= [:warning :info]
               (mapv :severity (take-last 2 (:diagnostics (ex-data error))))))))
    (testing "no-error validation returns the complete diagnostics vector"
      (let [valid-graph (parser/parse-dot
                          "digraph Valid {
                             start [shape=Mdiamond]
                             exit [shape=Msquare]
                             start -> exit
                           }")
            custom-rules [(fn [_]
                            [{:rule "custom_warning"
                              :severity :warning
                              :message "keep warning"}])
                          (fn [_]
                            [{:rule "custom_info"
                              :severity :info
                              :message "keep info"}])]
            expected (validation/validate valid-graph custom-rules)]
        (is (= expected
               (validation/validate-or-raise valid-graph custom-rules)))))))

(def lifecycle-dot
  "digraph Lifecycle {
     graph [goal=\"Ship it\", owner=platform, model_stylesheet=\".styled { llm_model: prepared-model; }\"]
     start [shape=Mdiamond]
     work [shape=box, class=styled, prompt=\"Deliver $goal\"]
     exit [shape=Msquare]
     start -> work -> exit
   }")

(defn- lifecycle-extensions [calls diagnostics]
  (let [first-transform
        (fn [graph]
          (swap! calls conj [:transform-1
                             (get-in graph [:nodes "work" :prompt])
                             (get-in graph [:nodes "work" :llm_model])])
          (-> graph
              (assoc-in [:attrs :transform_marker] "first")
              (assoc-in [:nodes "work" :transform_marker] "first")))
        second-transform
        (fn [graph]
          (swap! calls conj [:transform-2
                             (get-in graph [:nodes "work" :transform_marker])])
          (-> graph
              (assoc-in [:attrs :transform_marker] "second")
              (assoc-in [:nodes "work" :transform_marker] "second")))
        custom-rule
        (fn [graph]
          (swap! calls conj [:rule
                             (get-in graph [:nodes "work" :transform_marker])])
          diagnostics)]
    {:custom-transforms [first-transform second-transform]
     :custom-rules [custom-rule]}))

(deftest transform-order-and-public-prepare-contract
  (testing "direct transforms preserve input and compose built-ins before custom transforms"
    (let [parsed (parser/parse-dot lifecycle-dot)
          before parsed
          calls (atom [])
          options (lifecycle-extensions calls [])
          prepared (transforms/apply-transforms parsed (:custom-transforms options))]
      (is (= before parsed))
      (is (not= parsed prepared))
      (is (= [[:transform-1 "Deliver Ship it" "prepared-model"]
              [:transform-2 "first"]]
             @calls))
      (is (= "second" (get-in prepared [:nodes "work" :transform_marker])))))
  (testing "prepare validates the last custom graph without starting execution"
    (let [calls (atom [])
          handler-calls (atom 0)
          events (atom [])
          ctx (context/make-context {"untouched" true})
          logs (str (os/temp-dir) "/attractor-prepare-" (System/nanoTime))
          registry (handlers/make-handler-registry)
          diagnostics [{:rule "prepared_warning"
                        :severity :warning
                        :message "prepared warning"}]
          extensions (lifecycle-extensions calls diagnostics)
          _ (handlers/register-handler!
              registry "codergen"
              (fn [_ _ _ _]
                (swap! handler-calls inc)
                {:status :success}))
          result (pipeline/prepare
                   lifecycle-dot
                   (merge extensions
                          {:registry registry
                           :context ctx
                           :logs-root logs
                           :on-event #(swap! events conj %)}))]
      (is (= "second" (get-in result [:graph :nodes "work" :transform_marker])))
      (is (= diagnostics (:diagnostics result)))
      (is (= [[:transform-1 "Deliver Ship it" "prepared-model"]
              [:transform-2 "first"]
              [:rule "second"]]
             @calls))
      (is (= 0 @handler-calls))
      (is (= [] @events))
      (is (= {:values {"untouched" true} :logs []} @ctx))
      (is (nil? (os/stat logs))))))

;; SCN-TRANSFORM-ORDER COMPLETE

(deftest public-run-gates-errors-and-preserves-success-diagnostics
  (testing "valid runs execute the prepared graph once and return diagnostics"
    (let [calls (atom [])
          handler-observations (atom [])
          events (atom [])
          ctx (context/make-context {"seed" "present"})
          logs (str (os/temp-dir) "/attractor-public-run-" (System/nanoTime))
          registry (handlers/make-handler-registry)
          diagnostics [{:rule "prepared_warning"
                        :severity :warning
                        :message "keep warning"}
                       {:rule "prepared_info"
                        :severity :info
                        :message "keep info"}]
          extensions (lifecycle-extensions calls diagnostics)
          _ (handlers/register-handler!
              registry "codergen"
              (fn [node _ctx graph _logs-root]
                (swap! handler-observations conj
                       {:node (:id node)
                        :prompt (:prompt node)
                        :model (:llm_model node)
                        :marker (get-in graph [:attrs :transform_marker])})
                {:status :success
                 :context_updates {"handler.marker" (:transform_marker node)}}))
          result (pipeline/run
                   lifecycle-dot
                   (merge extensions
                          {:registry registry
                           :context ctx
                           :logs-root logs
                           :on-event #(swap! events conj %)}))
          checkpoint (context/load-checkpoint (str logs "/checkpoint.edn"))]
      (is (= [[:transform-1 "Deliver Ship it" "prepared-model"]
              [:transform-2 "first"]
              [:rule "second"]]
             @calls))
      (is (= [{:node "work"
               :prompt "Deliver Ship it"
               :model "prepared-model"
               :marker "second"}]
             @handler-observations))
      (is (= diagnostics (:diagnostics result)))
      (is (= :success (:status result)))
      (is (= ["start" "work" "exit"] (:completed_nodes result)))
      (is (= "Ship it" (context/ctx-get ctx "graph.goal")))
      (is (= "platform" (context/ctx-get ctx "graph.owner")))
      (is (= "second" (context/ctx-get ctx "graph.transform_marker")))
      (is (= "second" (context/ctx-get ctx "handler.marker")))
      (is (= (:context result) (context/ctx-snapshot ctx)))
      (is (= (:completed_nodes result) (:completed_nodes checkpoint)))
      (is (= (:context result) (:context_values checkpoint)))
      (is (= "exit" (:current_node checkpoint)))
      (is (= :pipeline.started (:type (first @events))))
      (is (= ["start" "work"]
             (mapv :node_id
                   (filter #(= :stage.completed (:type %)) @events))))
      (is (= :pipeline.completed (:type (last @events))))
      (is (= (:completed_nodes result)
             (:completed_nodes (last @events))))))
  (testing "errors from the final transformed graph block every engine side effect"
    (let [transform-calls (atom 0)
          rule-calls (atom 0)
          handler-calls (atom 0)
          events (atom [])
          ctx (context/make-context {"seed" "unchanged"})
          before @ctx
          logs (str (os/temp-dir) "/attractor-public-invalid-" (System/nanoTime))
          registry (handlers/make-handler-registry)
          invalid-transform
          (fn [graph]
            (swap! transform-calls inc)
            (assoc-in graph [:nodes "orphan"]
                      {:id "orphan"
                       :shape "box"
                       :type "codergen"
                       :label ""
                       :prompt "Created by final transform"
                       :attrs {:shape "box"
                               :type "codergen"
                               :label ""
                               :prompt "Created by final transform"}}))
          custom-rule
          (fn [graph]
            (swap! rule-calls inc)
            (is (= "Created by final transform"
                   (get-in graph [:nodes "orphan" :prompt])))
            [{:rule "custom_warning"
              :severity :warning
              :message "keep warning"}
             {:rule "custom_info"
              :severity :info
              :message "keep info"}
             {:rule "custom_error"
              :severity :error
              :message "block execution"}])
          _ (handlers/register-handler!
              registry "codergen"
              (fn [_ _ _ _]
                (swap! handler-calls inc)
                {:status :success}))
          error (try
                  (do
                    (pipeline/run
                      lifecycle-dot
                      {:custom-transforms [invalid-transform]
                       :custom-rules [custom-rule]
                       :registry registry
                       :context ctx
                       :logs-root logs
                       :on-event #(swap! events conj %)})
                    nil)
                  (catch Object caught caught))
          diagnostics (:diagnostics (ex-data error))]
      (is (= :validation_error (:category (ex-data error))))
      (is (= [:error :warning :info :error]
             (mapv :severity diagnostics)))
      (is (= ["reachability" "custom_warning" "custom_info" "custom_error"]
             (mapv :rule diagnostics)))
      (is (= 1 @transform-calls))
      (is (= 1 @rule-calls))
      (is (= 0 @handler-calls))
      (is (= [] @events))
      (is (= before @ctx))
      (is (nil? (os/stat logs))))))

