(ns attractor.context-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string :as str]
            [clojure.edn :as edn]
            [attractor.context :as context]
            [json :as json]
            [io :as io]
            [os :as os]))

(defn- checkpoint-path [label extension]
  (str (os/temp-dir) "/lettractor-checkpoint-" label "-"
       (random-uuid) extension))

(deftest artifact-named-index-does-not-overwrite-registration-metadata
  (let [root (checkpoint-path "artifact-index" "")
        store (context/make-artifact-store root)
        large (apply str (repeat (inc context/file-backing-threshold) "x"))]
    (context/store-artifact! store "other" "Other" {:kept true})
    (context/store-artifact! store "index" "Index" large)
    (is (= large (context/retrieve-artifact store "index")))
    (let [reopened (context/make-artifact-store root)]
      (is (= large (context/retrieve-artifact reopened "index")))
      (is (= {:kept true} (context/retrieve-artifact reopened "other")))
      (context/remove-artifact! reopened "index")
      (is (= {:kept true} (context/retrieve-artifact (context/make-artifact-store root) "other"))))))

(deftest legacy-artifact-index-migrates-before-index-artifact-is-published
  (let [root (checkpoint-path "artifact-legacy" "")
        info {:id "old" :name "Old" :size_bytes 3 :is_file_backed false}
        large (apply str (repeat (inc context/file-backing-threshold) "z"))]
    (io/mkdir (str root "/artifacts"))
    (io/spit (str root "/artifacts/index.edn")
             (pr-str {:artifacts {"old" {:info info :inline "old"}}}))
    (let [store (context/make-artifact-store root)]
      (is (= "old" (context/retrieve-artifact store "old")))
      (context/store-artifact! store "index" "Index" large)
      (let [reopened (context/make-artifact-store root)]
        (is (= "old" (context/retrieve-artifact reopened "old")))
        (is (= large (context/retrieve-artifact reopened "index")))))))

(deftest test-checkpoint-roundtrip-preserves-pinned-workflow-fields
  (let [path (checkpoint-path "pinned-roundtrip" ".edn")
        checkpoint {:timestamp "now"
                    :current_node "work"
                    :completed_nodes ["start" "work"]
                    :node_retries {"work" 1}
                    :node_outcomes {"work" {:status :success}}
                    :current_fidelity "compact"
                    :context_values {"answer" 42}
                    :logs ["saved"]
                    :workflow_fingerprint "abc123"
                    :workflow_manifest "workflow/manifest.edn"}
        _ (context/save-checkpoint checkpoint path)
        serialized (edn/read-string (io/slurp path))
        loaded (context/load-checkpoint path)]
    (is (= checkpoint serialized))
    (is (= checkpoint loaded))))

(deftest test-checkpoint-omits-optional-pinned-workflow-fields
  (let [path (checkpoint-path "optional-fields" ".edn")
        _ (context/save-checkpoint
            {:timestamp "now"
             :current_node "start"}
            path)
        serialized (edn/read-string (io/slurp path))
        loaded (context/load-checkpoint path)]
    (is (not (contains? serialized :current_fidelity)))
    (is (not (contains? serialized :workflow_fingerprint)))
    (is (not (contains? serialized :workflow_manifest)))
    (is (not (contains? loaded :current_fidelity)))
    (is (not (contains? loaded :workflow_fingerprint)))
    (is (not (contains? loaded :workflow_manifest)))))

(deftest test-load-checkpoint-supports-legacy-edn-and-json-keys
  (let [edn-path (checkpoint-path "legacy-edn" ".edn")
        json-path (checkpoint-path "legacy-json" ".json")
        legacy {:timestamp "then"
                :current_node "start"
                :completed_nodes ["start"]
                :node_retries {}
                :node_outcomes {}
                :context {"legacy" true}
                :logs []}
        json-checkpoint {:timestamp "now"
                         :current_node "work"
                         :completed_nodes ["start" "work"]
                         :node_retries {}
                         :node_outcomes {}
                         :current_fidelity "full"
                         :context_values {:modern true}
                         :logs []
                         :workflow_fingerprint "def456"
                         :workflow_manifest "workflow/manifest.edn"}
        _ (io/spit edn-path (pr-str legacy))
        _ (io/spit json-path (json/write-json json-checkpoint))
        loaded-edn (context/load-checkpoint edn-path)
        loaded-json (context/load-checkpoint json-path)]
    (is (= {"legacy" true} (:context_values loaded-edn)))
    (is (not (contains? loaded-edn :current_fidelity)))
    (is (not (contains? loaded-edn :workflow_fingerprint)))
    (is (= "full" (:current_fidelity loaded-json)))
    (is (= "def456" (:workflow_fingerprint loaded-json)))
    (is (= "workflow/manifest.edn" (:workflow_manifest loaded-json)))
    (is (= {"modern" true} (:context_values loaded-json)))))

(deftest test-truncate-preamble-carries-goal-and-run-id
  (let [ctx (context/make-context {"run.id" "run-42"})
        preamble
        (context/synthesize-context-preamble
          "truncate" {:goal "Ship it"} ctx ["plan"]
          {"plan" {:status :success}})]
    (is (str/includes? preamble "Pipeline Goal: Ship it"))
    (is (str/includes? preamble "Run ID: run-42"))
    (is (not (str/includes? preamble "plan")))))

(deftest test-compact-preamble-carries-outcomes-and-key-context
  (let [ctx (context/make-context {"priority" "high"})
        preamble
        (context/synthesize-context-preamble
          "compact" {:goal "Ship it"} ctx ["plan"]
          {"plan" {:status :success}})]
    (is (str/includes? preamble "[plan] -> :success"))
    (is (str/includes? preamble "priority: high"))))

(deftest test-thread-id-uses-only-the-enclosing-subgraph-class
  (is (= "previous"
         (context/resolve-thread-id nil {:class "styling-only"} {}
                                    "previous")))
  (is (= "review-loop"
         (context/resolve-thread-id nil
                                    {:class "styling-only,review-loop"
                                     :subgraph_class "review-loop"}
                                    {}
                                    "previous"))))

(deftest test-artifact-store-uses-edn-and-supports-full-lifecycle
  (let [root (str (os/temp-dir) "/lettractor-artifacts-" (random-uuid))
        store (context/make-artifact-store root)
        small {:answer 42 :ok false}
        large (str (apply str (repeat context/file-backing-threshold "x")) "y")
        replacement (str large "replacement")
        unicode-large (apply str (repeat 40000 "€"))
        small-info (context/store-artifact! store "small" "Small" small)
        large-info (context/store-artifact! store "large" "Large" large)
        unicode-info
        (context/store-artifact! store "unicode" "Unicode" unicode-large)]
    (is (false? (:is_file_backed small-info)))
    (is (true? (:is_file_backed large-info)))
    (is (= small (context/retrieve-artifact store "small")))
    (is (= large (context/retrieve-artifact store "large")))
    (context/store-artifact! store "large" "Replacement" replacement)
    (is (= replacement (context/retrieve-artifact store "large")))
    (is (true? (:is_file_backed unicode-info)))
    (is (= 120000 (:size_bytes unicode-info)))
    (is (some? (os/stat (str root "/artifacts/large.edn"))))
    (is (= 3 (count (context/list-artifacts store))))
    (context/remove-artifact! store "large")
    (is (false? (context/has-artifact? store "large")))
    (is (nil? (os/stat (str root "/artifacts/large.edn"))))
    (context/clear-artifacts! store)
    (is (empty? (context/list-artifacts store)))
    (is (true?
          (try
            (do (context/retrieve-artifact store "missing") false)
            (catch Object _ true))))
    (is (true?
          (try
            (do (context/store-artifact! store "../escape" "bad" large)
                false)
            (catch Object _ true))))))

(deftest test-artifact-store-rejects-values-that-cannot-round-trip-through-edn
  (let [root (str (os/temp-dir) "/lettractor-artifacts-" (random-uuid))
        store (context/make-artifact-store root)
        unsupported (vec (repeat 10000 (fn [] nil)))]
    (is (true?
          (try
            (do (context/store-artifact! store "unsupported" "Unsupported"
                                         unsupported)
                false)
            (catch Object _ true))))
    (is (false? (context/has-artifact? store "unsupported")))))

(deftest test-artifact-removal-keeps-registration-when-file-deletion-fails
  (let [root (str (os/temp-dir) "/lettractor-artifacts-" (random-uuid))
        store (context/make-artifact-store root)
        large (str (apply str (repeat context/file-backing-threshold "x")) "y")
        path (str root "/artifacts/delete-failure.edn")]
    (context/store-artifact! store "delete-failure" "Delete failure" large)
    (io/delete-file path)
    (io/mkdir path)
    (io/spit (str path "/blocker") "keep directory non-empty")
    (is (true?
          (try
            (do (context/remove-artifact! store "delete-failure") false)
            (catch Object _ true))))
    (is (true? (context/has-artifact? store "delete-failure")))))

(deftest test-artifact-clear-keeps-only-file-backed-registrations-that-still-exist
  (let [root (str (os/temp-dir) "/lettractor-artifacts-" (random-uuid))
        store (context/make-artifact-store root)
        large (str (apply str (repeat context/file-backing-threshold "x")) "y")
        blocked-path (str root "/artifacts/second.edn")]
    (context/store-artifact! store "first" "First" large)
    (context/store-artifact! store "second" "Second" large)
    (io/delete-file blocked-path)
    (io/mkdir blocked-path)
    (io/spit (str blocked-path "/blocker") "keep directory non-empty")
    (is (true?
          (try
            (do (context/clear-artifacts! store) false)
            (catch Object _ true))))
    (doseq [info (context/list-artifacts store)]
      (is (some? (os/stat (str root "/artifacts/" (:id info) ".edn")))))))
