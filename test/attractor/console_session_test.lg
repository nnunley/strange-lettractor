(ns attractor.console-session-test
  (:require [clojure.test :refer [deftest is]] [clojure.core :as core]
            [clojure.string :as str] [os :as os] [io :as io]
            [attractor.hub :as hub] [attractor.execution :as execution]
            [attractor.profiles :as profiles] [attractor.handlers :as handlers]
            [attractor.interviewer :as interviewer]
            [attractor.console.session :as console]))

;; SCN-CONSOLE-CONTROL: one dispatcher routes agent text, evaluation, workflow
;; and worker commands to the hub and renders identified events for any frontend.

(defn- answer [request] {:message {:role :assistant :content (str "echo: " (:content (last (:messages request))))}})
(defn- hub-options []
  {:session_options {:provider_profile (profiles/make-profile {:id "fixture" :model "fixture" :supports_streaming false})
                     :execution_env (execution/make-environment {:file_exists (fn [_] false)
                                                                 :inspect_command (fn [_] {:exit_code 1 :stdout ""})})
                     :project_docs [] :complete_fn answer}
   :workflow_registry_fn (fn [_] (handlers/make-handler-registry (interviewer/make-auto-approve-interviewer) nil {}))
   :agent_commands {:claude [(let [override (os/getenv "LGX_LG")] (if (str/blank? override) "lg" override))
                              (str (os/cwd) "/test/fixtures/claude_worker.lg")]
                     :codex [(let [override (os/getenv "LGX_LG")] (if (str/blank? override) "lg" override))
                             (str (os/cwd) "/test/fixtures/codex_app_server.lg")]}
   :allow_agent_scenario true})
(defn- stop [h] (deref (hub/request! h {:id "stop" :op :hub/stop}) 5000 nil))
(defn- line [c text] (:lines (console/handle! c {:type :line :text text})))
(defn- drain-until [c pred ms]
  (let [deadline (+ (System/currentTimeMillis) ms)]
    (loop [acc []]
      (let [acc (into acc (:lines (console/drain! c)))]
        (if (or (some pred acc) (> (System/currentTimeMillis) deadline))
          acc
          (do (core/sleep 10) (recur acc)))))))
(defn- has [lines s] (boolean (some #(str/includes? % s) lines)))

(deftest agent-text-opens-a-session-and-renders-identified-turn
  (let [h (hub/start! (hub-options)) c (console/open! h)]
    (try
      (let [sent (line c "hello there")
            rendered (drain-until c #(str/includes? % "turn complete") 5000)]
        (is (has sent "→ agent"))
        (is (= :session (:kind (console/focus c))))
        (is (has rendered "session started"))
        (is (has rendered "echo: hello there"))
        (is (has rendered "turn complete"))
        (is (every? #(str/starts-with? % "[session ") rendered) (pr-str rendered)))
      (finally (console/close! c) (stop h)))))

(deftest eval-routes-render-values-errors-and-bind-focus
  (let [h (hub/start! (hub-options)) c (console/open! h)]
    (try
      (is (has (line c ": (def x 20)") "→ eval"))
      (is (has (drain-until c #(str/includes? % "=>") 5000) "[eval] => #'"))
      (line c ": (undefined-fn x)")
      (is (has (drain-until c #(str/includes? % "error") 5000) "[eval] error"))
      (line c ":{")
      (is (:buffering (console/handle! c {:type :line :text "(println \"multi\")"})))
      (line c "(* x 2)")
      (is (has (line c ":}") "→ eval"))
      (let [rendered (drain-until c #(str/includes? % "=> 40") 5000)]
        (is (has rendered "multi"))
        (is (has rendered "[eval] => 40")))
      (line c "/new")
      (let [sid (:id (console/focus c))]
        (line c ": *session*")
        (let [rendered (drain-until c #(str/includes? % "=>") 5000)]
          (is (has rendered (str "=> \"" sid "\"")) (pr-str rendered))))
      (is (has (line c ":not-a-form") "→ agent") "keyword without space is agent text")
      (finally (console/close! c) (stop h)))))

(def ^:private dot "digraph T { graph [goal=\"console\"] start [shape=Mdiamond] work [shape=box, label=\"Work\", prompt=\"do $goal\"] exit [shape=Msquare] start -> work -> exit }")

(deftest workflow-and-worker-commands-run-focus-and-cancel
  (let [h (hub/start! (hub-options)) root (str/trim (:out (os/sh "/usr/bin/mktemp" "-d")))
        path (str root "/t.dot") _ (io/spit path dot)
        c (console/open! h {:run_defaults {:logs_root_fn (fn [_] (str root "/logs"))}})]
    (try
      (is (has (line c "/run") "usage"))
      (is (has (line c "/run /nonexistent.dot --auto-approve") "no such file"))
      (is (has (line c (str "/run " path)) "started from") "human gates are hub questions now")
      (is (has (line c (str "/run " path " --logs-root")) "flag needs a value"))
      (is (has (line c (str "/run " path " --auto-approve --logs-root " root "/logs")) "started from"))
      (is (= :run (:kind (console/focus c))))
      (let [rendered (drain-until c #(str/includes? % "completed in") 10000)]
        (is (has rendered "[run "))
        (is (has rendered "stage work")))
      (is (has (line c "/agent claude hello --scenario success") "claude "))
      (let [rendered (drain-until c #(and (str/includes? % "[claude") (str/includes? % "completed")) 5000)]
        (is (has rendered "[claude ") (pr-str rendered))
        (is (has rendered "héλ🙂")))
      (let [agents (line c "/list")]
        (is (has agents "  run") "focus moved off the run")
        (is (has agents "* claude") "exactly the agent job is focused")
        (is (has agents "done")))
      (is (has (line c "/agent") "usage"))
      (is (has (line c "/agent claude do it --cwd") "flag needs a value"))
      (is (has (line c "/focus nope") "no session, run or agent job matches"))
      (is (has (line c "/cancel") "cancel requested: agent"))
      (let [run-id (some (fn [l] (when (str/starts-with? l "  run ") (nth (str/split (str/trim l) #" +") 1))) (line c "/list"))]
        (is (has (line c (str "/focus " run-id)) "focus: run"))
        (is (has (line c "/cancel") "cancel requested: run") "cancel targets the newly focused run, not the agent job"))
      (is (has (line c "\\/cancel") "→ agent") "escaped command is agent text, still to the remembered session")
      (finally (console/close! c) (stop h) (os/sh "/bin/rm" "-rf" "--" root)))))

(deftest late-events-survive-quit-and-cursor-expiry-resyncs
  (let [h (hub/start! (assoc (hub-options) :event_capacity 8)) c (console/open! h)]
    (try
      (line c "hello")
      (core/sleep 300)
      ;; Everything the turn emitted is still undrained; quitting must not lose it.
      (line c "/quit")
      (is (has (:lines (console/drain! c)) "echo: hello") "final drain delivered after detach")
      (is (= [] (:lines (console/drain! c))) "delivered once")
      (finally (stop h))))
  (let [h (hub/start! (assoc (hub-options) :event_capacity 4)) c (console/open! h)]
    (try
      (line c "first") (core/sleep 300) (line c "second") (core/sleep 300) (line c "third") (core/sleep 300)
      (let [lines (:lines (console/drain! c))]
        (is (has lines "older events dropped") (pr-str lines))
        (is (has lines "turn complete")))
      (is (vector? (:lines (console/drain! c))) "subsequent drains work again")
      (finally (console/close! c) (stop h)))))

(deftest interrupt-cancels-focus-only-outside-a-draft-and-quit-detaches-not-stops
  (let [h (hub/start! (hub-options)) c (console/open! h)]
    (try
      (is (= ["nothing focused to cancel"] (:lines (console/handle! c {:type :interrupt}))))
      (line c ":{")
      (is (= [] (:lines (console/handle! c {:type :interrupt}))) "interrupt discards the draft silently")
      (is (not (:buffering (console/handle! c {:type :line :text "(+ 1 1)"}))) "draft was discarded")
      (is (has (drain-until c #(str/includes? % "→") 200) "") )
      (is (has (line c "/help") "Console input:"))
      (is (has (line c "/quit") "bye"))
      (is (console/closed? c))
      (is (= :alive (get-in (deref (hub/request! h {:id "x" :op :session/list}) 1000 {:error {:category :missing}}) [:error :category] :alive))
          "hub is still alive after client quit")
      (finally (stop h)))))

(deftest agent-frameworks-and-aliases-are-explicit
  (let [h (hub/start! (hub-options)) c (console/open! h {:aliases {"cx" "agent codex"}})]
    (try
      (is (has (line c "/agent hi") "unknown agent hi"))
      (is (has (line c "/agent gemini hi") "unknown agent "))
      (is (has (line c "/claude hi") "Unknown console command") "no built-in /claude")
      (is (has (line c "/cx hello --scenario agent") "codex ") "startup alias expands")
      (let [rendered (drain-until c #(str/includes? % "completed") 8000)]
        (is (has rendered "[codex ") (pr-str rendered))
        (is (has rendered "echo: hello")))
      (is (has (line c "/alias claude agent claude") "/claude -> /agent claude"))
      (is (has (line c "/alias") "/cx -> /agent codex"))
      (is (has (line c "/alias run agent") "built-in"))
      (is (has (line c "/claude hello --scenario success") "claude ") "defined alias expands")
      (is (has (drain-until c #(str/includes? % "completed") 8000) "[claude "))
      (is (has (line c "\\/cx literal") "→ agent") "escape still wins over aliases")
      (finally (console/close! c) (stop h)))))

(def ^:private gate-dot
  "digraph G { graph [goal=\"gate\"] start [shape=Mdiamond] gate [shape=hexagon, label=\"Ship it?\"] ship [shape=box, prompt=\"ship\"] hold [shape=box, prompt=\"hold\"] exit [shape=Msquare] start -> gate gate -> ship [label=\"Ship\"] gate -> hold [label=\"Hold\"] ship -> exit hold -> exit }")

(deftest human-gates-are-answered-from-the-console
  (let [h (hub/start! (assoc (hub-options) :workflow_registry_fn
                             (fn [request] (handlers/make-handler-registry
                                             (if (:auto_approve request) (interviewer/make-auto-approve-interviewer) (:interviewer request))
                                             nil {}))))
        root (str/trim (:out (os/sh "/usr/bin/mktemp" "-d"))) path (str root "/gate.dot") _ (io/spit path gate-dot)
        c (console/open! h {:run_defaults {:logs_root_fn (fn [_] (str root "/logs"))}})]
    (try
      (is (has (line c "/answer H") "no question is waiting"))
      (is (has (line c (str "/run " path)) "started from") "no --auto-approve needed")
      (let [rendered (drain-until c #(str/includes? % "/answer") 5000)]
        (is (has rendered "? Ship it?") (pr-str rendered))
        (is (has rendered "[S] Ship"))
        (is (has rendered "[H] Hold"))
        (is (has rendered "/answer <key or text>")))
      (is (has (line c "/list") "waiting for an answer"))
      (is (has (line c "/answer H") "answered"))
      (let [rendered (drain-until c #(str/includes? % "completed in") 10000)]
        (is (has rendered "answered: H"))
        (is (has rendered "stage hold"))
        (is (not (has rendered "stage ship"))))
      (is (has (line c "/answer H") "no question is waiting"))
      (finally (console/close! c) (stop h) (os/sh "/bin/rm" "-rf" "--" root)))))
