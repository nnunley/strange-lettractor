(ns attractor.agent-test
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.string :as str]
            [attractor.agent :as agent]
            [attractor.execution :as execution]
            [attractor.profiles :as profiles]))

(deftest test-character-truncation-preserves-head-and-tail
  (let [output "abcdefghijklmnopqrstuvwxyz"
        result (agent/truncate-output output 10 "head_tail")]
    (is (str/starts-with? result "abcde"))
    (is (str/ends-with? result "vwxyz"))
    (is (str/includes? result "16 characters were removed"))))

(deftest test-line-truncation-preserves-head-and-tail
  (let [output "one\ntwo\nthree\nfour\nfive\nsix"
        result (agent/truncate-lines output 4)]
    (is (str/starts-with? result "one\ntwo"))
    (is (str/ends-with? result "five\nsix"))
    (is (str/includes? result "2 lines omitted"))))

(deftest test-tool-truncation-is-character-first
  (testing "A huge single line cannot bypass output limits"
    (let [output (apply str (repeat 100 "x"))
          result (agent/truncate-tool-output output "read_file"
                   {:tool_output_limits {"read_file" 20}})]
      (is (not= output result))
      (is (str/includes? result "80 characters were removed"))
      (is (str/includes? result "Tool output was truncated")))))

(deftest test-agent-runs-tool-loop-until-text-response
  (let [calls (atom 0)
        requests (atom [])
        events (atom [])
        complete-fn
        (fn [request]
          (swap! requests conj request)
          (if (= 1 (swap! calls inc))
            {:id "response-1"
             :message {:role :assistant :content ""}
             :tool_calls [{:id "call-1"
                           :name "missing_tool"
                           :arguments {}}]}
            {:id "response-2"
             :message {:role :assistant :content "Recovered"}
             :tool_calls []}))
        session (agent/make-session {:model "mock/test"
                                     :complete_fn complete-fn
                                     :max_tool_rounds_per_input 3})
        result (agent/process-input! session "Do the work"
                 (fn [event] (swap! events conj event)))]
    (is (= "Recovered" result))
    (is (= 2 @calls))
    (is (= :idle (:state @session)))
    (is (= [:user :assistant :tool_results :assistant]
           (mapv :type (:history @session))))
    (is (true? (get-in @session [:history 2 :results 0 :is_error])))
    (is (= "call-1" (get-in @session [:history 2 :results 0 :tool_call_id])))
    (is (some (fn [event] (= :tool_call_end (:type event))) @events))
    (is (= :tool (get-in @requests [1 :messages 3 :role])))))

(deftest test-agent-honors-tool-round-limit
  (let [calls (atom 0)
        complete-fn (fn [_]
                      (swap! calls inc)
                      {:message {:role :assistant :content ""}
                       :tool_calls [{:id "loop" :name "missing_tool" :arguments {}}]})
        session (agent/make-session {:complete_fn complete-fn
                                     :max_tool_rounds_per_input 1})
        result (agent/process-input! session "loop" nil)]
    (is (= "" result))
    (is (= 1 @calls))
    (is (= :idle (:state @session)))))

(deftest test-session-dispatches-profile-tools-through-execution-environment
  (let [environment-calls (atom [])
        environment
        (execution/make-environment
          {:working_directory (fn [] "/virtual/project")
           :platform (fn [] "wasm")
           :read_file (fn [path offset limit]
                        (swap! environment-calls conj [path offset limit])
                        "1 | virtual")})
        registry (profiles/make-tool-registry)
        _ (profiles/register-tool!
            registry
            {:definition {:name "read_file" :description "Read"
                          :parameters {:type "object"}}
             :executor (fn [arguments env]
                         ((:read_file env) (get arguments "file_path") nil nil))})
        profile (profiles/make-profile
                  {:id "test-provider" :model "native-model"
                   :tool_registry registry
                   :build_system_prompt
                   (fn [env _]
                     (str "cwd=" ((:working_directory env))))})
        requests (atom [])
        complete-fn
        (fn [request]
          (swap! requests conj request)
          (if (= 1 (count @requests))
            {:message {:role :assistant :content ""}
             :tool_calls [{:id "read-1" :name "read_file"
                           :arguments {"file_path" "README.md"}}]}
            {:message {:role :assistant :content "done"} :tool_calls []}))
        session (agent/make-session {:provider_profile profile
                                     :execution_env environment
                                     :complete_fn complete-fn
                                     :max_tool_rounds_per_input 2})]
    (is (= "done" (agent/process-input! session "work")))
    (is (= [["README.md" nil nil]] @environment-calls))
    (is (= :system (get-in @requests [0 :messages 0 :role])))
    (is (str/includes? (get-in @requests [0 :messages 0 :content])
                       "cwd=/virtual/project"))
    (is (= "test-provider" (get-in @requests [0 :provider])))
    (is (= "native-model" (get-in @requests [0 :model])))
    (is (= "read_file" (get-in @requests [0 :tools 0 :name])))))

(deftest test-session-processes-followups-after-current-input
  (let [prompts (atom [])
        events (atom [])
        complete-fn
        (fn [request]
          (let [user-content
                (:content
                  (last (filter #(= :user (:role %)) (:messages request))))]
            (swap! prompts conj user-content)
            {:message {:role :assistant :content (str "done: " user-content)}
             :tool_calls []}))
        session (agent/make-session {:complete_fn complete-fn})]
    (agent/follow-up-session! session "second")
    (is (= "done: second"
           (agent/process-input! session "first"
                                 (fn [event] (swap! events conj event)))))
    (is (= ["first" "second"] @prompts))
    (is (empty? (:followup-queue @session)))
    (is (= 1 (count (filter #(= :processing_end (:type %)) @events))))))

(deftest test-session-detects-repeating-tool-call-loops
  (let [events (atom [])
        calls (atom 0)
        complete-fn
        (fn [_]
          (swap! calls inc)
          {:message {:role :assistant :content ""}
           :tool_calls [{:id (str "call-" @calls)
                         :name "missing" :arguments {"x" 1}}]})
        session (agent/make-session {:complete_fn complete-fn
                                     :max_tool_rounds_per_input 3
                                     :loop_detection_window 2})]
    (agent/process-input! session "loop"
                          (fn [event] (swap! events conj event)))
    (is (some #(= :loop_detection (:type %)) @events))
    (is (some #(= :steering (:type %)) (:history @session)))))

(deftest test-session-close-and-abort-run-environment-cleanup
  (let [cleanups (atom 0)
        environment
        (execution/make-environment
          {:cleanup (fn [] (swap! cleanups inc))})
        closed (agent/make-session {:execution_env environment})
        aborted (agent/make-session {:execution_env environment})]
    (agent/close-session! closed)
    (is (= :closed (:state @closed)))
    (agent/abort-session! aborted)
    (is (= :closed (:state @aborted)))
    (is (true? (:abort_signaled @aborted)))
    (is (= 2 @cleanups))))

(deftest test-session-event-stream-brackets-lifecycle-and-stamps-events
  (let [delivered (atom [])
        session (agent/make-session
                  {:on_event (fn [event] (swap! delivered conj event))
                   :complete_fn
                   (fn [_]
                     {:message {:role :assistant :content "done"}
                      :tool_calls []})})]
    (agent/process-input! session "work")
    (agent/close-session! session)
    (let [events (agent/session-events session)
          types (mapv :type events)]
      (is (= [:session_start :user_input :assistant_text_start
              :assistant_text_end :processing_end :session_end]
             types))
      (is (= events @delivered))
      (is (every? #(= (:id @session) (:session_id %)) events))
      (is (every? number? (map :timestamp events))))))

(deftest test-unrecoverable-session-error-closes-and-cleans-up
  (let [cleanups (atom 0)
        environment (execution/make-environment
                      {:cleanup (fn [] (swap! cleanups inc))})
        session (agent/make-session
                  {:execution_env environment
                   :complete_fn
                   (fn [_]
                     (throw (ex-info "bad credentials"
                                     {:category :authentication})))})
        thrown? (try
                  (do (agent/process-input! session "work") false)
                  (catch Object _ true))]
    (is (true? thrown?))
    (is (= :closed (:state @session)))
    (is (= 1 @cleanups))
    (is (= [:session_start :user_input :assistant_text_start
            :error :session_end]
           (mapv :type (agent/session-events session))))))

(deftest test-project-doc-discovery-is-provider-aware-and-root-first
  (let [files {"/repo/AGENTS.md" "root universal"
               "/repo/CLAUDE.md" "root anthropic"
               "/repo/GEMINI.md" "wrong provider"
               "/repo/sub/AGENTS.md" "nested universal"
               "/repo/sub/CLAUDE.md" "nested anthropic"}
        environment
        (execution/make-environment
          {:working_directory (fn [] "/repo/sub")
           :file_exists (fn [path] (contains? files path))
           :read_text (fn [path] (get files path))
           :exec_command
           (fn [command _ _ _]
             (if (str/includes? command "rev-parse")
               {:exit_code 0 :stdout "/repo\n" :stderr ""}
               {:exit_code 1 :stdout "" :stderr ""}))})
        docs (agent/discover-project-docs environment "anthropic")
        joined (str/join "\n" docs)]
    (is (= 4 (count docs)))
    (is (< (str/index-of joined "root universal")
           (str/index-of joined "nested universal")))
    (is (str/includes? joined "root anthropic"))
    (is (str/includes? joined "nested anthropic"))
    (is (not (str/includes? joined "wrong provider")))))

(deftest test-system-prompt-layers-environment-tools-docs-and-user-override
  (let [requests (atom [])
        environment
        (execution/make-environment
          {:working_directory (fn [] "/virtual/project")
           :platform (fn [] "wasm")
           :os_version (fn [] "wasm/test")})
        session
        (agent/make-session
          {:execution_env environment
           :project_docs ["project rules"]
           :user_instructions "highest priority"
           :complete_fn
           (fn [request]
             (swap! requests conj request)
             {:message {:role :assistant :content "done"} :tool_calls []})})]
    (agent/process-input! session "work")
    (let [prompt (get-in @requests [0 :messages 0 :content])]
      (is (str/includes? prompt "<environment>"))
      (is (str/includes? prompt "Working directory: /virtual/project"))
      (is (str/includes? prompt "<tools>"))
      (is (str/includes? prompt "project rules"))
      (is (str/ends-with? prompt "highest priority")))))
