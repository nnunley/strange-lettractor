(ns attractor.repair-test
  (:require [clojure.test :refer [deftest is]] [clojure.core :as core]
            [attractor.repair :as repair] [clojure.string :as str]
            [io :as io] [os :as os] [json :as json]))

(defn fixture []
  (let [root (str (os/cwd) "/attractor_runs/repair-supervisor-test-" (System/nanoTime))]
    (io/mkdir root) (io/spit (str root "/.gitignore") "attractor_runs/\n")
    (doseq [args [["init" "-q"] ["add" ".gitignore"]
                  ["-c" "user.name=Fixture" "-c" "user.email=fixture@localhost" "commit" "-qm" "initial"]]]
      (let [r (apply os/sh (concat ["git" "-C" root] args))]
        (when-not (= 0 (:exit r)) (throw (ex-info "Fixture git failed" r))))) root))
(defn config [root] {:repository root :triage_model "mock/strong" :coding_model "mock/coder"
                    :test_command "true" :build_command "true" :timeout_ms 2000})
(defn wait-for [f]
  (let [end (+ 5000 (System/currentTimeMillis))]
    (loop [] (cond (f) true (> (System/currentTimeMillis) end) false
                  :else (do (core/sleep 5) (recur))))))
(defn incident [path]
  {:session_id "parent" :event {:type :subagent_event :agent_id "child"
    :event {:type :tool_call_end :error "missing" :incident
      {:session_id "child" :parent_session_id "parent" :cwd "/task/repo"
       :tool_name "read_file" :arguments {"file_path" path}
       :delegation_task "read src/attractor/engine.lg"
       :exception {:message "no such file" :category :io} :history []}}}})
(defn answer [kind]
  {:message {:content (json/write-json {:classification kind :summary "diagnosed" :evidence "observed call"
                                       :reproduction "Run regression" :advice "Use the discovered full path"})}})

(deftest wrong-path-triage-is-bounded-deduplicated-and-never-edits-source
  (let [calls (atom []) workers (atom 0) advice (atom []) root (fixture)
        r (repair/start! (config root) {:complete (fn [req] (swap! calls conj req) (answer "tool_use"))
                  :worker (fn [& _] (swap! workers inc)) :emit (fn [_]) :advise #(swap! advice conj [%1 %2])})]
    (try
      (let [id (repair/capture! r (incident "engine.lg"))]
        (is (string? id))
        (is (= id (repair/capture! r (incident "engine.lg"))))
        (is (wait-for #(= :advised (:status (repair/detail r id)))))
        (is (= 1 (count @calls)))
        (is (= "mock/strong" (:model (first @calls))))
        (is (= 0 @workers))
        (is (= "parent" (ffirst @advice)))
        (is (= root (:repository (repair/status r))))
        (is (= "/task/repo" (get-in (repair/detail r id) [:incident :cwd])))
        (is (nil? (repair/capture! r {:event {:type :repair_error :incident {:exception {:message "own failure"}}}}))))
      (finally (repair/stop! r) (deref (:done r) 3000 nil)))))

(deftest framework-only-routes-to-worker-and-invalid-json-fails-closed
  (doseq [valid? [true false]]
    (let [calls (atom []) root (fixture)
          r (repair/start! (config root)
              {:complete (fn [_] (if valid? (answer "framework") {:message {:content "sounds fine"}}))
               :worker (fn [cfg inc diag complete emit cancelled?]
                         (swap! calls conj [cfg inc diag]) {:status :ready :commit "tested-commit"}) :emit (fn [_])})]
      (try
        (let [id (repair/capture! r (incident "engine.lg"))]
          (is (wait-for #(contains? #{:ready :failed} (:status (repair/detail r id)))))
          (is (= (if valid? :ready :failed) (:status (repair/detail r id))))
          (is (= (if valid? 1 0) (count @calls)))
          (when valid? (is (re-matches #"[0-9a-f]{40,64}" (:revision (second (first @calls)))))))
        (finally (repair/stop! r) (deref (:done r) 3000 nil))))))

(deftest cancellation-drains-a-blocked-triage-and-does-not-start-worker
  (let [entered (promise) calls (atom 0)
        r (repair/start! (config (fixture))
             {:complete (fn [_] (deliver entered true) (core/sleep 100000) (answer "framework"))
              :worker (fn [& _] (swap! calls inc)) :emit (fn [_])})]
    (let [id (repair/capture! r (incident "engine.lg"))]
      (is (= true (deref entered 3000 false)))
      (repair/cancel! r id)
      (is (wait-for #(= :cancelled (:status (repair/detail r id)))))
      (is (= 0 @calls)))
    (repair/stop! r)
    (is (= true (deref (:done r) 3000 false)))))

(deftest only-one-supervisor-can-own-a-framework-repository
  (let [cfg (config (fixture)) callbacks {:complete (fn [_] (answer "tool_use")) :emit (fn [_])}
        a (repair/start! cfg callbacks)]
    (try
      (let [other (try {:supervisor (repair/start! cfg callbacks)}
                       (catch Object e {:category (:category (ex-data e))}))]
        (when-let [b (:supervisor other)] (repair/stop! b) (deref (:done b) 3000 nil))
        (is (= :repair-in-use (:category other))))
      (finally (repair/stop! a) (deref (:done a) 3000 nil)))
    (let [b (repair/start! cfg callbacks)]
      (repair/stop! b) (is (true? (deref (:done b) 3000 false))))))

(deftest persistence-failure-disables-admission-instead-of-stranding-jobs
  (let [r (repair/start! (config (fixture)) {:complete (fn [_] (answer "tool_use")) :emit (fn [_])})]
    ;; A directory at the ledger destination makes its atomic rename fail.
    (io/mkdir (:path r))
    (repair/capture! r (incident "engine.lg"))
    (is (true? (deref (:done r) 3000 false)))
    (is (false? (:running (repair/status r))))
    (is (string? (:error (repair/status r))))
    (is (nil? (repair/capture! r (incident "other.lg"))))) )

(deftest bounded-ledger-restores-deduplication-without-rerunning-triage
  (let [cfg (assoc (config (fixture)) :max_incidents 1) calls (atom 0)
        callbacks {:complete (fn [_] (swap! calls inc) (answer "tool_use")) :emit (fn [_])}
        first (repair/start! cfg callbacks) id (repair/capture! first (incident "engine.lg"))]
    (is (wait-for #(= :advised (:status (repair/detail first id)))))
    (is (nil? (repair/capture! first (incident "other.lg"))))
    (is (= 1 (:dropped (repair/status first))))
    (repair/stop! first) (deref (:done first) 3000 nil)
    (let [second (repair/start! cfg callbacks)]
      (try
        (is (= id (repair/capture! second (incident "engine.lg"))))
        (is (= :advised (:status (repair/detail second id))))
        (is (= 1 @calls))
        (finally (repair/stop! second) (deref (:done second) 3000 nil))))))
