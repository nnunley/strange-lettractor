(ns attractor.parser-test
  (:require [clojure.test :refer [deftest is testing run-tests]]
            [clojure.string :as str]
            [attractor.ids]
            [attractor.parser :as p]))

(deftest test-linear-dot-parsing
  (testing "Parses a simple linear pipeline"
    (let [dot "
digraph Simple {
    graph [goal=\"Test Goal\"]
    start [shape=Mdiamond]
    step1 [shape=box, prompt=\"Step 1\"]
    exit  [shape=Msquare]

    start -> step1 -> exit
}
"
          g (p/parse-dot dot)]
      (is (= "Test Goal" (:goal g)))
      (is (= 3 (count (:nodes g))))
      (is (= 2 (count (:edges g))))
      (is (= "start" (first (p/find-start-node g))))
      (is (= "exit" (first (p/find-exit-node g)))))))

(deftest test-subgraph-inheritance
  (testing "Inherits subgraph label and node defaults"
    (let [dot "
digraph Subgraphs {
    subgraph cluster_loop {
        label = \"Loop A\"
        node [thread_id=\"loop-a\", timeout=\"900s\"]

        Plan      [label=\"Plan step\"]
        Implement [label=\"Implement\", timeout=\"1800s\", class=\"coder\"]
    }
}
"
          g (p/parse-dot dot)
          plan (p/find-node g "Plan")
          impl (p/find-node g "Implement")]
      (is (= "loop-a" (:class plan)))
      (is (= "loop-a" (:thread_id plan)))
      (is (= "900s" (:timeout plan)))
      (is (= "coder,loop-a" (:class impl)))
      (is (= "1800s" (:timeout impl))))))

(deftest test-edge-chaining
  (testing "Expands A -> B -> C into two edges"
    (let [dot "
digraph Chaining {
    start [shape=Mdiamond]
    mid   [shape=box]
    exit  [shape=Msquare]

    start -> mid -> exit [weight=10]
}
"
          g (p/parse-dot dot)]
      (is (= 2 (count (:edges g))))
      (let [e1 (first (p/outgoing-edges g "start"))
            e2 (first (p/outgoing-edges g "mid"))]
        (is (= "mid" (:to e1)))
        (is (= 10 (:weight e1)))
        (is (= "exit" (:to e2)))
        (is (= 10 (:weight e2)))))))

(defn- parse-fails? [source]
  (try
    (do (p/parse-dot source) false)
    (catch Object _ true)))

(deftest test-strict-dot-subset-rejects-malformed-input
  (doseq [source
          ["digraph G { A [label=\"x\"]"
           "digraph G { A [label=\"unterminated] }"
           "digraph G { A [label=\"x\" shape=box] }"
           "digraph G { A -> }"
           "digraph G { 9bad [shape=box] }"
           "digraph G { bad-id [shape=box] }"
           "digraph G { A -- B }"
           "strict digraph G { A }"
           "digraph G { A } digraph H { B }"
           "digraph G junk { A }"]]
    (is (true? (parse-fails? source)) source)))

(deftest test-strict-dot-subset-accepts-negative-values-and-comments
  (let [graph (p/parse-dot
                "digraph G { /* block */ A [weight=-2, label=\"ok\"]; // line\n }")]
    (is (= -2 (get-in graph [:nodes "A" :attrs :weight])))))

(deftest test-nested-subgraphs-restore-parent-scope
  (let [graph
        (p/parse-dot
          "digraph G {
             subgraph outer {
               node [thread_id=outer]
               Before
               subgraph inner { node [thread_id=inner] Inside }
               After
             }
           }")]
    (is (= "outer" (:thread_id (p/find-node graph "Before"))))
    (is (= "inner" (:thread_id (p/find-node graph "Inside"))))
    (is (= "outer" (:thread_id (p/find-node graph "After"))))
    (is (= 2 (count (:subgraphs graph))))))

(deftest edge-defaults-are-inherited-and-restored-at-subgraph-boundaries
  (let [graph (p/parse-dot
                "digraph ScopedEdges {
                   edge [weight=1, label=global]
                   a -> b
                   subgraph outer {
                     b -> c
                     edge [weight=7, label=outer]
                     c -> d
                     subgraph inner {
                       d -> e
                       edge [weight=9, label=inner]
                       e -> f [weight=11]
                     }
                     f -> g
                   }
                   g -> h
                   subgraph sibling { h -> i }
                 }")]
    (is (= [{:from "a" :to "b" :weight 1 :label "global"}
            {:from "b" :to "c" :weight 1 :label "global"}
            {:from "c" :to "d" :weight 7 :label "outer"}
            {:from "d" :to "e" :weight 7 :label "outer"}
            {:from "e" :to "f" :weight 11 :label "inner"}
            {:from "f" :to "g" :weight 7 :label "outer"}
            {:from "g" :to "h" :weight 1 :label "global"}
            {:from "h" :to "i" :weight 1 :label "global"}]
           (mapv #(select-keys % [:from :to :weight :label]) (:edges graph))))))

(deftest test-explicit-false-auto-status-overrides-inherited-true
  (let [graph (p/parse-dot
                "digraph G {
                   node [auto_status=true]
                   inherited
                   disabled [auto_status=false]
                 }")]
    (is (true? (:auto_status (p/find-node graph "inherited"))))
    (is (false? (:auto_status (p/find-node graph "disabled"))))))

(deftest quoted-integer-and-boolean-attributes-keep-their-spec-types
  ;; The upstream attribute tables type max_retries and default_max_retries as Integer and
  ;; goal_gate as Boolean; the spec's examples quote attribute values.
  (let [g (p/parse-dot "digraph Q { graph [default_max_retries=\"3\"] start [shape=Mdiamond] work [prompt=\"w\", max_retries=\"2\", goal_gate=\"true\"] exit [shape=Msquare] start -> work -> exit }")
        work (get-in g [:nodes "work"])]
    (is (= 3 (:default_max_retries g)))
    (is (= 2 (:max_retries work)))
    (is (true? (:goal_gate work)))))

(deftest identifiers-never-carry-the-uuid-reader-tag
  (let [text (attractor.ids/uuid-text) run (attractor.ids/prefixed "run")]
    (is (re-matches #"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}" text))
    (is (re-matches #"run-[0-9a-f-]{36}" run))
    (is (= 12 (count (attractor.ids/short run))))
    (is (not (str/includes? (str text run) "#uuid")))))

(deftest escapes-are-decoded-once-in-left-to-right-order
  (doseq [[encoded expected] [["\\\\n" "\\n"] ["\\\\t" "\\t"]
                              ["\\\\\\n" "\\\n"] ["\\n\\t" "\n\t"]
                              ["\\\\\\\"" "\\\""] ["\\q" "\\q"]]]
    (is (= expected (p/unescape-string encoded)))))

(deftest comments-do-not-consume-quoted-prompt-or-edge-text
  (let [graph (p/parse-dot
                "digraph Comments {
                   // fake [prompt=bad]
                   start [shape=Mdiamond];
                   work [prompt=\"Fetch https://host/path /* literal */ and // text\"];
                   /* ignored -> node; */
                   exit [shape=Msquare];
                   start -> work [label=\"/* proceed */ // now\"];
                   work -> exit;
                 }")]
    (is (= "Fetch https://host/path /* literal */ and // text" (get-in graph [:nodes "work" :prompt])))
    (is (= "/* proceed */ // now" (:label (first (:edges graph)))))
    (is (= #{"start" "work" "exit"} (set (keys (:nodes graph)))))))
