(ns attractor.execution-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string :as str]
            [io :as io]
            [os :as os]
            [attractor.execution :as execution]))

(deftest test-local-environment-resolves-paths-and-numbers-lines
  (let [root (str (os/temp-dir) "/lettractor-execution-test")
        _ (io/mkdir root)
        _ (io/spit (str root "/sample.txt") "alpha\nbeta\ngamma")
        environment (execution/make-local-environment {:working_dir root})
        output ((:read_file environment) "sample.txt" 2 1)]
    (is (= root ((:working_directory environment))))
    (is (= "2 | beta" output))
    (is (true? ((:file_exists environment) "sample.txt")))
    (is (= (os/os-name) ((:platform environment))))))

(deftest test-custom-environment-contract-is-consumer-implementable
  (let [calls (atom [])
        environment
        (execution/make-environment
          {:working_directory (fn [] "/virtual")
           :platform (fn [] "wasm")
           :read_file (fn [path offset limit]
                        (swap! calls conj [path offset limit])
                        "virtual content")})]
    (is (= "virtual content" ((:read_file environment) "x" nil nil)))
    (is (= [["x" nil nil]] @calls))
    (is (= "wasm" ((:platform environment))))))

(deftest test-local-environment-writes-edits-and-executes-in-working-directory
  (let [root (str (os/temp-dir) "/lettractor-execution-write-test")
        environment (execution/make-local-environment {:working_dir root})]
    ((:write_file environment) "nested/file.txt" "same\nsame")
    (is (true? ((:file_exists environment) "nested/file.txt")))
    (is (true?
          (try
            (do ((:edit_file environment) "nested/file.txt" "same" "changed" false)
                false)
            (catch Object _ true))))
    (is (= 2 ((:edit_file environment)
              "nested/file.txt" "same" "changed" true)))
    (is (str/includes? ((:read_file environment) "nested/file.txt" nil nil)
                       "changed"))
    (let [result ((:exec_command environment) "pwd" 1000 nil nil)]
      (is (= 0 (:exit_code result)))
      ;; macOS canonicalizes /var to /private/var in pwd output.
      (is (str/ends-with? (str/trim (:stdout result))
                          "/lettractor-execution-write-test")))))
