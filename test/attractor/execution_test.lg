(ns attractor.execution-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string :as str]
            [clojure.core :as core]
            [io :as io]
            [os :as os]
            [attractor.execution :as execution]))

(deftest test-local-environment-resolves-paths-and-numbers-lines
  (let [root (str (os/temp-dir) "/lettractor-execution-test")
        _ (io/mkdir root)
        _ (io/spit (str root "/sample.txt") "alpha\nbeta\ngamma")
        environment (execution/make-local-environment {:working_dir root})
        output ((:read_file environment) "sample.txt" 2 1)]
    (is (= root ((:working_directory environment))))
    (is (= "2 | beta" output))
    (is (true? ((:file_exists environment) "sample.txt")))
    (is (= (os/os-name) ((:platform environment))))))

(deftest test-custom-environment-contract-is-consumer-implementable
  (let [calls (atom [])
        environment
        (execution/make-environment
          {:working_directory (fn [] "/virtual")
           :platform (fn [] "wasm")
           :read_file (fn [path offset limit]
                        (swap! calls conj [path offset limit])
                        "virtual content")})]
    (is (= "virtual content" ((:read_file environment) "x" nil nil)))
    (is (= [["x" nil nil]] @calls))
    (is (= "wasm" ((:platform environment))))))

(deftest test-local-environment-writes-edits-and-executes-in-working-directory
  (let [root (str (os/temp-dir) "/lettractor-execution-write-test")
        environment (execution/make-local-environment {:working_dir root})]
    ((:write_file environment) "nested/file.txt" "same\nsame")
    (is (true? ((:file_exists environment) "nested/file.txt")))
    (is (true?
          (try
            (do ((:edit_file environment) "nested/file.txt" "same" "changed" false)
                false)
            (catch Object _ true))))
    (is (= 2 ((:edit_file environment)
              "nested/file.txt" "same" "changed" true)))
    (is (str/includes? ((:read_file environment) "nested/file.txt" nil nil)
                       "changed"))
    (let [result ((:exec_command environment) "pwd" 1000 nil nil)]
      (is (= 0 (:exit_code result)))
      ;; macOS canonicalizes /var to /private/var in pwd output.
      (is (str/ends-with? (str/trim (:stdout result))
                          "/lettractor-execution-write-test")))))

(deftest test-local-command-timeout-terminates-the-process-group
  (let [root (str (os/temp-dir) "/lettractor-execution-timeout-test")
        marker (str root "/descendant-survived")
        environment (execution/make-local-environment {:working_dir root})
        _ (io/mkdir root)
        result ((:exec_command environment)
                (str "trap '' TERM; printf partial; sleep 5; "
                     "printf leaked > " marker)
                100 nil nil)]
    (is (= 124 (:exit_code result)))
    (is (true? (:timed_out result)))
    (is (str/includes? (:stdout result) "partial"))
    (is (str/includes? (:stderr result) "Command timed out after 100ms"))
    (is (false? ((:file_exists environment) "descendant-survived")))))

(deftest test-local-command-filters-secrets-and-allows-explicit-environment
  (let [_ (os/setenv "lettractor_execution_test_token" "lowercase-secret")
        _ (os/setenv "Lettractor_Execution_Test_CREDENTIAL" "mixed-secret")
        _ (os/setenv "LETTRACTOR_EXECUTION_VISIBLE" "inherited")
        environment (execution/make-local-environment)
        result ((:exec_command environment)
                (str "printf '%s|%s|%s|%s' "
                     "\"$lettractor_execution_test_token\" "
                     "\"$Lettractor_Execution_Test_CREDENTIAL\" "
                     "\"$LETTRACTOR_EXECUTION_VISIBLE\" "
                     "\"$EXPLICIT_TOKEN\"")
                1000 nil {"EXPLICIT_TOKEN" "allowed"})]
    (is (= 0 (:exit_code result)))
    (is (= "||inherited|allowed" (:stdout result)))))

(deftest test-local-command-environment-inheritance-policies
  (let [_ (os/setenv "LETTRACTOR_POLICY_VISIBLE" "inherited")
        _ (os/setenv "LETTRACTOR_POLICY_TOKEN" "secret")
        read-environment
        (fn [policy]
          (let [environment (execution/make-local-environment
                              {:env_policy policy})]
            ((:exec_command environment)
             (str "printf '%s|%s|%s|%s' "
                  "\"$LETTRACTOR_POLICY_VISIBLE\" "
                  "\"$LETTRACTOR_POLICY_TOKEN\" "
                  "\"${PATH:+core}\" "
                  "\"$EXPLICIT_VALUE\"")
             1000 nil {"EXPLICIT_VALUE" "explicit"})))]
    (is (= "inherited|secret|core|explicit"
           (:stdout (read-environment :all))))
    (is (= "|||explicit"
           (:stdout (read-environment :none))))
    (is (= "||core|explicit"
           (:stdout (read-environment :core))))
    (let [environment (execution/make-local-environment {:env_policy :none})
          result ((:exec_command environment)
                  "printf '%s' \"$PATH\""
                  1000 nil {"PATH" "/explicit/bin"})]
      (is (= "/explicit/bin" (:stdout result))))))

(deftest test-local-environment-rejects-unknown-inheritance-policy
  (is (= :invalid-environment-policy
         (try
           (do (execution/make-local-environment {:env_policy :mystery}) nil)
           (catch Object error (:category (ex-data error)))))))

(deftest test-local-command-rejects-invalid-explicit-environment-name
  (let [environment (execution/make-local-environment {:env_policy :none})]
    (is (= :invalid-environment-variable
           (try
             (do ((:exec_command environment)
                  "printf unreachable" 1000 nil {"--unset" "PATH"})
                 nil)
             (catch Object error (:category (ex-data error))))))))

(deftest test-isolated-policies-block-bash-env-secret-exfiltration
  (let [hook (str (os/temp-dir) "/lettractor-bash-env-"
                  (System/currentTimeMillis))]
    (io/spit hook
             (str "if [ -n \"$LETTRACTOR_BOOTSTRAP_TOKEN\" ]; then "
                  "export LETTRACTOR_EXFILTRATED=\"$LETTRACTOR_BOOTSTRAP_TOKEN\"; "
                  "fi\n"))
    (os/setenv "LETTRACTOR_BOOTSTRAP_TOKEN" "bootstrap-secret")
    (os/setenv "BASH_ENV" hook)
    (try
      (doseq [policy [:filtered :none :core]]
        (let [environment (execution/make-local-environment
                            {:env_policy policy})
              result ((:exec_command environment)
                      "printf '%s' \"$LETTRACTOR_EXFILTRATED\""
                      1000 nil nil)]
          (is (= "" (:stdout result)) (str "policy=" policy))))
      (finally
        (os/setenv "BASH_ENV" "")))))

(deftest test-local-command-timeout-is-clamped-to-configured-maximum
  (let [environment (execution/make-local-environment
                      {:default_command_timeout_ms 1000
                       :max_command_timeout_ms 50})
        result ((:exec_command environment) "sleep 1" 5000 nil nil)]
    (is (= 124 (:exit_code result)))
    (is (str/includes? (:stderr result) "after 50ms"))))

(deftest test-local-environment-cleanup-cancels-active-process-group
  (let [root (str (os/temp-dir) "/lettractor-execution-cancel-"
                  (System/currentTimeMillis))
        started (str root "/started")
        survived (str root "/survived")
        environment (execution/make-local-environment {:working_dir root})
        _ (io/mkdir root)
        task
        (core/future
          ((:exec_command environment)
           (str "printf started > \"" started "\"; "
                "trap '' TERM; sleep 5; "
                "printf survived > \"" survived "\"")
           500 nil nil))]
    (loop [attempt 0]
      (when (and (< attempt 100) (nil? (os/stat started)))
        (core/sleep 5)
        (recur (inc attempt))))
    (is (some? (os/stat started)))
    ((:cleanup environment))
    (let [result (deref task 4000 :timeout)]
      (is (not= :timeout result))
      (is (= 130 (:exit_code result)))
      (is (true? (:cancelled result)))
      (is (false? (some? (os/stat survived)))))))

(deftest test-local-environment-rejects-commands-after-cleanup
  (let [root (str (os/temp-dir) "/lettractor-execution-closed-"
                  (System/currentTimeMillis))
        launched (str root "/launched")
        environment (execution/make-local-environment {:working_dir root})]
    (io/mkdir root)
    ((:cleanup environment))
    (let [result ((:exec_command environment)
                  (str "printf launched > \"" launched "\"")
                  1000 nil nil)]
      (is (= 130 (:exit_code result)))
      (is (true? (:cancelled result)))
      (is (false? (some? (os/stat launched)))))))

(deftest test-local-environment-cleanup-cancels-all-active-commands
  (let [root (str (os/temp-dir) "/lettractor-execution-cancel-all-"
                  (System/currentTimeMillis))
        environment (execution/make-local-environment {:working_dir root})
        started-a (str root "/started-a")
        started-b (str root "/started-b")
        survived-a (str root "/survived-a")
        survived-b (str root "/survived-b")
        command (fn [started survived]
                  (str "printf started > \"" started "\"; "
                       "trap '' TERM; sleep 5; "
                       "printf survived > \"" survived "\""))
        _ (io/mkdir root)
        task-a (core/future
                 ((:exec_command environment)
                  (command started-a survived-a) 10000 nil nil))
        task-b (core/future
                 ((:exec_command environment)
                  (command started-b survived-b) 10000 nil nil))]
    (loop [attempt 0]
      (when (and (< attempt 200)
                 (or (nil? (os/stat started-a))
                     (nil? (os/stat started-b))))
        (core/sleep 5)
        (recur (inc attempt))))
    (is (some? (os/stat started-a)))
    (is (some? (os/stat started-b)))
    ((:cleanup environment))
    (let [result-a (deref task-a 4000 :timeout)
          result-b (deref task-b 4000 :timeout)]
      (is (not= :timeout result-a) (str "result-a=" (pr-str result-a)))
      (is (not= :timeout result-b) (str "result-b=" (pr-str result-b)))
      (is (= 130 (:exit_code result-a)) (str "result-a=" (pr-str result-a)))
      (is (= 130 (:exit_code result-b)) (str "result-b=" (pr-str result-b)))
      (is (true? (:cancelled result-a)))
      (is (true? (:cancelled result-b)))
      (is (false? (some? (os/stat survived-a))))
      (is (false? (some? (os/stat survived-b)))))))

(deftest test-working-directory-view-shares-parent-cancellation-lifecycle
  (let [root (str (os/temp-dir) "/lettractor-execution-scoped-"
                  (System/currentTimeMillis))
        nested (str root "/nested")
        started (str nested "/started")
        survived (str nested "/survived")
        parent (execution/make-local-environment {:working_dir root})
        _ (io/mkdir nested)
        scoped ((:with_working_directory parent) "nested")
        task
        (core/future
          ((:exec_command scoped)
           (str "printf started > \"" started "\"; "
                "trap '' TERM; sleep 5; "
                "printf survived > \"" survived "\"")
           10000 nil nil))]
    (loop [attempt 0]
      (when (and (< attempt 200) (nil? (os/stat started)))
        (core/sleep 5)
        (recur (inc attempt))))
    (is (some? (os/stat started)))
    ((:cleanup parent))
    (let [result (deref task 4000 :timeout)]
      (is (not= :timeout result))
      (is (= 130 (:exit_code result)))
      (is (true? (:cancelled result)))
      (is (false? (some? (os/stat survived)))))))
