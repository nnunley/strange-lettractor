(ns attractor.server-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.core :as core]
            [clojure.string :as str]
            [io :as io]
            [json :as json]
            [os :as os]
            [attractor.context :as context]
            [attractor.pipeline :as pipeline]
            [attractor.server :as server]
            [attractor.workflow :as workflow]))

(deftest test-checkpoint-endpoint-reads-edn-and-returns-json
  (let [logs-root (str "/tmp/strange-lettractor-server-" (System/currentTimeMillis))
        _ (os/sh "mkdir" "-p" logs-root)
        _ (context/save-checkpoint
            {:timestamp 123
             :current_node "review"
             :completed_nodes ["start" "plan"]
             :node_retries {"plan" 1}
             :node_outcomes {"plan" :success}
             :context_values {:goal "ship"}}
            (str logs-root "/checkpoint.edn"))
        _ (reset! server/active-pipelines
                  {"pipe-test" {:logs_root logs-root}})
        response (server/app-handler
                   {:request-method "GET"
                    :path "/pipelines/pipe-test/checkpoint"})
        body (json/read-json (:body response))]
    (is (= 200 (:status response)))
    (is (= "application/json" (get-in response [:headers "Content-Type"])))
    (is (= "review" (get body "current_node")))
    (is (= ["start" "plan"] (get body "completed_nodes")))
    (is (= "ship" (get-in body ["context_values" "goal"])))))

(deftest test-server-prepares-and-validates-submitted-pipelines
  (let [invalid (server/handle-start-pipeline
                  {:body "digraph G { only [shape=box] }"})]
    (is (= 400 (:status invalid))))
  (let [source
        "digraph G {
           graph [goal=\"Ship it\"]
           start [shape=Mdiamond]
           work [prompt=\"Do $goal\"]
           exit [shape=Msquare]
           start -> work -> exit
         }"
        response (server/handle-start-pipeline {:body source})
        body (json/read-json (:body response))
        pipeline (get @server/active-pipelines (get body "id"))]
    (is (= 201 (:status response)))
    (is (= "Do Ship it" (get-in pipeline [:graph :nodes "work" :prompt])))))

(deftest test-server-cancel-signals-running-engine
  (let [cancelled (atom false)
        _ (reset! server/active-pipelines
                  {"pipe-cancel" {:id "pipe-cancel" :status :running
                                  :cancelled cancelled}})
        response (server/app-handler
                   {:request-method "POST"
                    :path "/pipelines/pipe-cancel/cancel"})]
    (is (= 200 (:status response)))
    (is (true? @cancelled))
    (is (= :cancelled (get-in @server/active-pipelines
                              ["pipe-cancel" :status])))))

(deftest test-server-graph-endpoint-returns-svg
  (reset! server/active-pipelines
          {"pipe-graph" {:id "pipe-graph"
                         :dot "digraph G { start -> exit }"}})
  (let [response (server/app-handler
                   {:request-method "GET"
                    :path "/pipelines/pipe-graph/graph"})]
    (is (= 200 (:status response)))
    (is (= "image/svg+xml" (get-in response [:headers "Content-Type"])))
    (is (str/includes? (:body response) "<svg"))))

(def server-dot
  "digraph Server { start [shape=Mdiamond] exit [shape=Msquare] start -> exit }")

(deftest start-registers-only-after-a-verified-publication
  (reset! server/active-pipelines {})
  (let [before-publication (atom nil)
        first-registration (atom nil)
        second-registration (atom nil)
        callback-count (atom 0)
        background-complete (promise)
        response
        (with-redefs
          [pipeline/run
           (fn [source options]
             (try
               (let [prepared (pipeline/prepare source)]
                 ((:on-prepared options) prepared)
                 (reset! before-publication @server/active-pipelines)
                 (let [manifest-path
                       (workflow/publish! (:workflow prepared) (:logs-root options))]
                   ((:on-published options) prepared manifest-path)
                   (swap! callback-count inc)
                   (reset! first-registration
                           (first (vals @server/active-pipelines)))
                   ((:on-published options) prepared manifest-path)
                   (swap! callback-count inc)
                   (reset! second-registration
                           (first (vals @server/active-pipelines)))
                   {:status :success}))
               (finally
                 (deliver background-complete true))))]
          (server/handle-start-pipeline {:body server-dot}))
        _ (deref background-complete 1000 :timeout)
        body (json/read-json (:body response))
        pipeline-id (get body "id")
        registered (get @server/active-pipelines pipeline-id)
        manifest-path (:workflow_manifest registered)
        verified (workflow/verify-published!
                   (:logs_root registered)
                   (:workflow_fingerprint registered))]
    (is (= 201 (:status response)))
    (is (= {} @before-publication))
    (is (= 2 @callback-count))
    (is (identical? @first-registration @second-registration))
    (is (= (:workflow_fingerprint registered)
           (get-in verified [:workflow :fingerprint])))
    (is (= (str (:logs_root registered) "/workflow/manifest.edn")
           manifest-path))
    (is (some? (io/slurp manifest-path)))
    (is (= 1 (count @server/active-pipelines)))))

(deftest publication-or-publication-callback-failure-does-not-register
  (doseq [run-fn
          [(fn [source options]
             ((:on-prepared options) (pipeline/prepare source))
             (throw (ex-info "publication failed" {:phase :publication})))
           (fn [source options]
             (let [prepared (pipeline/prepare source)]
               ((:on-prepared options) prepared)
               ((:on-published options)
                prepared
                (str (:logs-root options) "/workflow/manifest.edn"))))]]
    (reset! server/active-pipelines {})
    (let [background-complete (promise)
          joined-run (fn [source options]
                       (try
                         (run-fn source options)
                         (finally
                           (deliver background-complete true))))
          response (with-redefs [pipeline/run joined-run]
                     (server/handle-start-pipeline {:body server-dot}))]
      (is (= true (deref background-complete 1000 :timeout)))
      (is (= 400 (:status response)))
      (is (= {} @server/active-pipelines)))))

(deftest concurrent-publication-callbacks-share-the-winning-registration
  (reset! server/active-pipelines {})
  (let [registration-entered (promise)
        release-registration (promise)
        second-verified (promise)
        background-complete (promise)
        callback-results (atom nil)
        registered-identities (atom nil)
        observed-cancelled (atom nil)
        real-verify workflow/verify-published!
        verify-count (atom 0)
        watch-key (keyword (str "registration-" (random-uuid)))]
    (add-watch server/active-pipelines watch-key
               (fn [_ _ old-state new-state]
                 (when (and (empty? old-state) (seq new-state))
                   (deliver registration-entered true)
                   @release-registration)))
    (try
      (let [response
            (with-redefs
              [workflow/verify-published!
               (fn [run-root fingerprint]
                 (let [verified (real-verify run-root fingerprint)
                       count (swap! verify-count inc)]
                   (when (= 2 count) (deliver second-verified true))
                   verified))
               pipeline/run
               (fn [source options]
                 (try
                   (let [prepared (pipeline/prepare source)
                         manifest-path
                         (workflow/publish! (:workflow prepared) (:logs-root options))
                         invoke (fn []
                                  (try
                                    ((:on-published options) prepared manifest-path)
                                    :ok
                                    (catch Object error error)))
                         first-callback (core/future (invoke))]
                     (is (= true (deref registration-entered 1000 :timeout)))
                     (let [first-record (first (vals @server/active-pipelines))
                           second-callback (core/future (invoke))]
                       (is (= true (deref second-verified 1000 :timeout)))
                       (deliver release-registration true)
                       (let [first-result (deref first-callback 1000 :timeout)
                             second-result (deref second-callback 1000 :timeout)
                             second-record (first (vals @server/active-pipelines))]
                         (reset! callback-results [first-result second-result])
                         (reset! registered-identities [first-record second-record])
                         (reset! observed-cancelled @(:cancelled second-record))))
                     {:status :success})
                   (finally
                     (deliver background-complete true))))]
              (server/handle-start-pipeline {:body server-dot}))]
        (is (= true (deref background-complete 1000 :timeout)))
        (is (= 201 (:status response)))
        (is (= [:ok :ok] @callback-results))
        (is (apply identical? @registered-identities))
        (is (false? @observed-cancelled)))
      (finally
        (deliver release-registration true)
        (remove-watch server/active-pipelines watch-key)))))

(deftest late-completion-cannot-recreate-a-removed-registration
  (reset! server/active-pipelines {})
  (let [release (promise) updated (promise) watch-key (keyword (str "late-" (random-uuid)))]
    (try
      (with-redefs [pipeline/run
                    (fn [source options]
                      (let [prepared (pipeline/prepare source)
                            manifest (workflow/publish! (:workflow prepared) (:logs-root options))]
                        ((:on-published options) prepared manifest)
                        @release
                        {:status :success}))]
        (let [response (server/handle-start-pipeline {:body server-dot})]
          (is (= 201 (:status response)))
          (reset! server/active-pipelines {})
          (add-watch server/active-pipelines watch-key
                     (fn [_ _ old-state new-state]
                       (when (empty? old-state) (deliver updated new-state))))
          (deliver release true)
          (is (= {} (deref updated 1000 :timeout)))))
      (finally
        (deliver release true)
        (remove-watch server/active-pipelines watch-key)))))

(deftest timeout-that-wins-during-publication-verification-prevents-late-registration
  (reset! server/active-pipelines {})
  (let [verification-entered (promise)
        release-verification (promise)
        background-complete (promise)
        engine-entered (atom false)
        prepared-workflow (pipeline/prepare server-dot)
        published-fingerprint (atom nil)
        response
        (with-redefs
          [workflow/publish!
           (fn [bundle logs-root]
             (reset! published-fingerprint (:fingerprint bundle))
             (str logs-root "/" workflow/manifest-relative-path))
           workflow/read-manifest!
           (fn [_]
             {:fingerprint @published-fingerprint})
           workflow/verify-published!
           (fn [run-root fingerprint]
             (deliver verification-entered true)
             @release-verification
             {:workflow {:fingerprint fingerprint}})
           pipeline/run
           (fn [source options]
             (try
               (let [prepared prepared-workflow
                     manifest-path
                     (workflow/publish! (:workflow prepared) (:logs-root options))]
                 ((:on-published options) prepared manifest-path)
                 (reset! engine-entered true)
                 {:status :success})
               (finally
                 (deliver background-complete true))))]
          (let [request (core/future
                          (server/handle-start-pipeline
                            {:body server-dot :preparation-timeout-ms 20}))]
            (is (= true (deref verification-entered 1000 :timeout)))
            (let [timed-out-response (deref request 1000 :timeout)]
              (deliver release-verification true)
              timed-out-response)))]
    (is (= 400 (:status response)))
    (is (= true (deref background-complete 1000 :timeout)))
    (is (= {} @server/active-pipelines))
    (is (false? @engine-entered))))

(deftest timeout-before-publication-prevents-late-registration-and-execution
  (reset! server/active-pipelines {})
  (let [prepublication-entered (promise)
        release-publication (promise)
        background-complete (promise)
        engine-entered (atom false)
        prepared-workflow (pipeline/prepare server-dot)
        published-fingerprint (atom nil)
        result
        (with-redefs
          [workflow/publish!
           (fn [bundle logs-root]
             (reset! published-fingerprint (:fingerprint bundle))
             (str logs-root "/" workflow/manifest-relative-path))
           workflow/read-manifest!
           (fn [_]
             {:fingerprint @published-fingerprint})
           workflow/verify-published!
           (fn [_ fingerprint]
             {:workflow {:fingerprint fingerprint}})
           pipeline/run
           (fn [source options]
             (try
               (let [prepared prepared-workflow]
                 ((:on-prepared options) prepared)
                 (deliver prepublication-entered true)
                 @release-publication
                 (let [manifest-path
                       (workflow/publish! (:workflow prepared) (:logs-root options))]
                   ((:on-published options) prepared manifest-path)
                   (reset! engine-entered true)
                   {:status :success}))
               (finally
                 (deliver background-complete true))))]
          (let [request
                (core/future
                  (server/handle-start-pipeline
                    {:body server-dot :preparation-timeout-ms 20}))
                entered (deref prepublication-entered 1000 :timeout)
                response (deref request 1000 :timeout)]
            (deliver release-publication true)
            {:entered entered
             :response response
             :background (deref background-complete 1000 :timeout)}))]
    (is (= true (:entered result)))
    (is (= 400 (:status (:response result))))
    (is (= true (:background result)))
    (is (= {} @server/active-pipelines))
    (is (false? @engine-entered))))

(deftest timeout-during-registration-ownership-cleans-provisional-state
  (reset! server/active-pipelines {})
  (let [registration-entered (promise)
        release-registration (promise)
        background-complete (promise)
        engine-entered (atom false)
        observed-cancelled (atom nil)
        prepared-workflow (pipeline/prepare server-dot)
        published-fingerprint (atom nil)
        watch-key (keyword (str "timeout-registration-" (random-uuid)))]
    (add-watch server/active-pipelines watch-key
               (fn [_ _ old-state new-state]
                 (when (and (empty? old-state) (seq new-state))
                   (reset! observed-cancelled
                           (:cancelled (first (vals new-state))))
                   (deliver registration-entered true)
                   @release-registration)))
    (try
      (let [result
            (with-redefs
              [workflow/publish!
               (fn [bundle logs-root]
                 (reset! published-fingerprint (:fingerprint bundle))
                 (str logs-root "/" workflow/manifest-relative-path))
               workflow/read-manifest!
               (fn [_]
                 {:fingerprint @published-fingerprint})
               workflow/verify-published!
               (fn [_ fingerprint]
                 {:workflow {:fingerprint fingerprint}})
               pipeline/run
               (fn [source options]
                 (try
                   (let [prepared prepared-workflow
                         manifest-path
                         (workflow/publish! (:workflow prepared) (:logs-root options))]
                     ((:on-published options) prepared manifest-path)
                     (reset! engine-entered true)
                     {:status :success})
                   (finally
                     (deliver background-complete true))))]
              (let [request
                    (core/future
                      (server/handle-start-pipeline
                        {:body server-dot :preparation-timeout-ms 20}))
                    entered (deref registration-entered 1000 :timeout)
                    response (deref request 1000 :timeout)]
                (deliver release-registration true)
                {:entered entered
                 :response response
                 :background (deref background-complete 1000 :timeout)}))]
        (is (= true (:entered result)))
        (is (= 400 (:status (:response result))))
        (is (= true (:background result)))
        (is (= {} @server/active-pipelines))
        (is (true? (deref @observed-cancelled)))
        (is (false? @engine-entered)))
      (finally
        (deliver release-registration true)
        (remove-watch server/active-pipelines watch-key)))))

(deftest registered-publication-never-causes-an-unbounded-response-wait
  (reset! server/active-pipelines {})
  (let [delivery-entered (promise)
        release-delivery (promise)
        background-complete (promise)
        prepared-workflow (pipeline/prepare server-dot)
        published-fingerprint (atom nil)
        real-deliver deliver
        result
        (with-redefs
          [deliver
           (fn [signal value]
             (if (and (map? value) (:graph value))
               (do
                 (real-deliver delivery-entered true)
                 @release-delivery
                 (real-deliver signal value))
               (real-deliver signal value)))
           workflow/publish!
           (fn [bundle logs-root]
             (reset! published-fingerprint (:fingerprint bundle))
             (str logs-root "/" workflow/manifest-relative-path))
           workflow/read-manifest!
           (fn [_]
             {:fingerprint @published-fingerprint})
           workflow/verify-published!
           (fn [_ fingerprint]
             {:workflow {:fingerprint fingerprint}})
           pipeline/run
           (fn [source options]
             (try
               (let [prepared prepared-workflow
                     manifest-path
                     (workflow/publish! (:workflow prepared) (:logs-root options))]
                 ((:on-published options) prepared manifest-path)
                 {:status :success})
               (finally
                 (real-deliver background-complete true))))]
          (let [response-future
                (core/future
                  (server/handle-start-pipeline
                    {:body server-dot :preparation-timeout-ms 20}))
                entered (deref delivery-entered 1000 :timeout)
                response (deref response-future 200 :timeout)]
            (real-deliver release-delivery true)
            {:entered entered
             :response response
             :background (deref background-complete 1000 :timeout)}))]
    (is (= true (:entered result)))
    (is (not= :timeout (:response result)))
    (is (= 201 (:status (:response result))))
    (is (= true (:background result)))
    (is (= 1 (count @server/active-pipelines)))))

(deftest routes-accept-the-runtime-keyword-request-method
  ;; http/serve delivers :request-method as a keyword (:get), while these
  ;; tests pass strings; both must route.
  (reset! server/active-pipelines {})
  (is (= 200 (:status (server/app-handler {:request-method :get :path "/pipelines"}))))
  (is (= 200 (:status (server/app-handler {:request-method "GET" :path "/pipelines"}))))
  (is (= 404 (:status (server/app-handler {:request-method :get :path "/pipelines/none/events"})))))
