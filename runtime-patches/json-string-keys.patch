+package rt
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/nooga/let-go/pkg/vm"
+)
+
+func TestJSONObjectKeysPreserveStringContents(t *testing.T) {
+	for _, key := range []string{"q-human-id", "", "space and /slash", "quote\"\\\n", "日本語"} {
+		t.Run(key, func(t *testing.T) {
+			value := vm.EmptyPersistentMap.Assoc(vm.String(key), vm.String("answer"))
+			converted, err := fromValue(value)
+			if err != nil {
+				t.Fatal(err)
+			}
+			encoded, err := json.Marshal(converted)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var decoded map[string]string
+			if err := json.Unmarshal(encoded, &decoded); err != nil {
+				t.Fatal(err)
+			}
+			if decoded[key] != "answer" {
+				t.Fatalf("key %q was not preserved: %s", key, encoded)
+			}
+		})
+	}
+}
