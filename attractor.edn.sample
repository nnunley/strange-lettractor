;; Strange Lettractor provider registry.
;;   Project file:  ./attractor.edn   (or the path in ATTRACTOR_CONFIG)
;;   User file:     ~/.config/attractor/attractor.edn  ($XDG_CONFIG_HOME/attractor/attractor.edn)
;; Precedence: built-ins < user file < project file < environment
;; (<ID>_BASE_URL, <ID>_API_KEY or :api_key_env) < explicit CLI/API values.
;;
;; Entries are data only. A key or bearer token may be held directly in
;; :api_key, in which case the file must be chmod 600, or named indirectly by
;; the environment variable in :api_key_env. Other keys are errors.
;;
;; Built-ins that need no entry: openai (Responses API), anthropic (Messages
;; API), gemini (generateContent), openai-compat (Chat Completions, base URL
;; required). Redefining one of those ids here overrides it.
{:providers
 {;; OpenRouter: Chat Completions, pay-per-use key, model list at /models.
  "openrouter" {:protocol :openai-chat-completions
                :base_url "https://openrouter.ai/api/v1"
                :api_key "sk-or-..."            ; or :api_key_env "OPENROUTER_API_KEY"
                :model_discovery true}

  ;; The same gateway reached through the native wire protocols. OpenRouter
  ;; also serves the Anthropic Messages API at /v1/messages and the OpenAI
  ;; Responses API at /v1/responses, so the native adapters can be exercised
  ;; against a real server. :api_key_from borrows the entry above's key.
  ;; Models: or-messages/anthropic/claude-haiku-4.5, or-responses/openai/gpt-4.1-mini
  "or-messages" {:protocol :anthropic-messages
                 :base_url "https://openrouter.ai/api/v1"
                 :api_key_from "openrouter"
                 :model_discovery false}
  "or-responses" {:protocol :openai-responses
                  :base_url "https://openrouter.ai/api/v1"
                  :api_key_from "openrouter"
                  :model_discovery false}

  ;; A local llama.cpp server: no key needed, and its /models list is not
  ;; worth querying, so discovery is off.
  "llamacpp" {:protocol :openai-chat-completions
              :base_url "http://localhost:8080/v1"
              :model_discovery false}

  ;; An enterprise gateway that speaks the Anthropic Messages API.
  ;; Models are addressed as claude-gw/<name>.
  "claude-gw" {:protocol :anthropic-messages
               :base_url "https://gateway.example.com/anthropic/v1"
               :api_key_env "CLAUDE_GW_API_KEY"
               :model_discovery false}}}
