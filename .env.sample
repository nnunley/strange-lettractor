# ==============================================================================
# Attractor Environment Configuration (.env)
# Copy this file to .env and configure with your keys:
#   cp .env.sample .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime / Package Manager Configuration
# ------------------------------------------------------------------------------
# Path to your local let-go binary (used by lgx)
# LGX_LG=/path/to/let-go/lg

# ------------------------------------------------------------------------------
# Anthropic Configuration
# ------------------------------------------------------------------------------
# API Key for Claude models (claude-3-7-sonnet, claude-3-5-haiku, claude-opus-4-6)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional base URL override (e.g. enterprise proxy or gateway)
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ------------------------------------------------------------------------------
# OpenAI Configuration
# ------------------------------------------------------------------------------
# API Key for OpenAI models (gpt-4o, o1, o3-mini, gpt-4.5)
OPENAI_API_KEY=your-openai-api-key-here

# Optional base URL override (supports Ollama, vLLM, LiteLLM, or custom gateways)
# Examples:
#   Ollama:   http://localhost:11434/v1
#   vLLM:     http://localhost:8000/v1
#   LiteLLM:  http://localhost:4000/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Ollama / Ollama Cloud Configuration
# ------------------------------------------------------------------------------
# API Key for Ollama Cloud
OLLAMA_API_KEY=your-ollama-api-key-here

# Base URL for Ollama Cloud (default is https://ollama.com/v1)
# For local Ollama: http://localhost:11434/v1
OLLAMA_BASE_URL=https://ollama.com/v1

# ------------------------------------------------------------------------------
# Attractor Server Configuration (Optional)
# ------------------------------------------------------------------------------
# Port for HTTP management server (./bin/attractor serve)
ATTRACTOR_PORT=:7070
