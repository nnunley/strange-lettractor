digraph DevelopmentTask {
  graph [goal="Complete the captured task with test and review evidence", default_max_retry=0, default_fidelity="truncate", development.task_id="task", development.kind="branch", development.task="{\"acceptance\":[\"Read tests pass\"],\"context\":\"source\",\"objective\":\"Implement reading\",\"requirements\":[{\"id\":\"R1\",\"text\":\"Read files\"}]}", development.input_budget=2500, development.counter_kind="provided", development.max_repairs=1];
  start [shape="Mdiamond"];
  exit [shape="Msquare"];
  blocked [shape="parallelogram", type="tool", tool_command="false", development.stage="blocked", development.attempt=0, fidelity="truncate", timeout="20m"];
  plan [shape="parallelogram", type="tool", tool_command="false", development.stage="plan", development.attempt=0, fidelity="truncate", timeout="20m"];
  start -> child_0;
  child_0 [type="subpipeline", shape="parallelogram", tool_command="false", subpipeline.dotfile="task_0.dot", output_map="{\"development.result\" \"development.child.task_0\"}"];
  child_0 -> plan [condition="outcome=success"];
  child_0 -> blocked [condition="outcome=fail"];
  child_0 -> blocked;
  plan -> code_0 [condition="outcome=success"];
  plan -> blocked [condition="outcome=fail"];
  plan -> blocked;
  code_0 [shape="parallelogram", type="tool", tool_command="false", development.stage="code", development.attempt=0, fidelity="truncate", timeout="20m"];
  test_0 [shape="parallelogram", type="tool", tool_command="false", development.stage="test", development.attempt=0, fidelity="truncate", timeout="20m"];
  par_0 [shape="component", join_policy="wait_all", max_parallel=2];
  review_a_0 [shape="parallelogram", type="tool", tool_command="false", development.stage="review", development.attempt=0, fidelity="truncate", timeout="20m"];
  review_b_0 [shape="parallelogram", type="tool", tool_command="false", development.stage="review", development.attempt=0, fidelity="truncate", timeout="20m"];
  join_0 [shape="tripleoctagon"];
  adjudicate_0 [shape="parallelogram", type="tool", tool_command="false", development.stage="adjudicate", development.attempt=0, fidelity="truncate", timeout="20m"];
  publish_0 [shape="parallelogram", type="tool", tool_command="false", development.stage="publish", development.attempt=0, fidelity="truncate", timeout="20m"];
  code_0 -> test_0 [condition="outcome=success"];
  code_0 -> code_1 [condition="outcome=fail"];
  code_0 -> code_1;
  test_0 -> par_0 [condition="outcome=success"];
  test_0 -> code_1 [condition="outcome=fail"];
  test_0 -> code_1;
  par_0 -> review_a_0;
  par_0 -> review_b_0;
  review_a_0 -> join_0 [condition="outcome=fail"];
  review_a_0 -> join_0;
  review_b_0 -> join_0 [condition="outcome=fail"];
  review_b_0 -> join_0;
  join_0 -> adjudicate_0 [condition="outcome=fail"];
  join_0 -> adjudicate_0;
  adjudicate_0 -> publish_0 [condition="outcome=success"];
  adjudicate_0 -> code_1 [condition="outcome=fail"];
  adjudicate_0 -> code_1;
  publish_0 -> exit [condition="outcome=success"];
  publish_0 -> blocked [condition="outcome=fail"];
  publish_0 -> blocked;
  code_1 [shape="parallelogram", type="tool", tool_command="false", development.stage="repair", development.attempt=1, fidelity="truncate", timeout="20m"];
  test_1 [shape="parallelogram", type="tool", tool_command="false", development.stage="test", development.attempt=1, fidelity="truncate", timeout="20m"];
  par_1 [shape="component", join_policy="wait_all", max_parallel=2];
  review_a_1 [shape="parallelogram", type="tool", tool_command="false", development.stage="review", development.attempt=1, fidelity="truncate", timeout="20m"];
  review_b_1 [shape="parallelogram", type="tool", tool_command="false", development.stage="review", development.attempt=1, fidelity="truncate", timeout="20m"];
  join_1 [shape="tripleoctagon"];
  adjudicate_1 [shape="parallelogram", type="tool", tool_command="false", development.stage="adjudicate", development.attempt=1, fidelity="truncate", timeout="20m"];
  publish_1 [shape="parallelogram", type="tool", tool_command="false", development.stage="publish", development.attempt=1, fidelity="truncate", timeout="20m"];
  code_1 -> test_1 [condition="outcome=success"];
  code_1 -> blocked [condition="outcome=fail"];
  code_1 -> blocked;
  test_1 -> par_1 [condition="outcome=success"];
  test_1 -> blocked [condition="outcome=fail"];
  test_1 -> blocked;
  par_1 -> review_a_1;
  par_1 -> review_b_1;
  review_a_1 -> join_1 [condition="outcome=fail"];
  review_a_1 -> join_1;
  review_b_1 -> join_1 [condition="outcome=fail"];
  review_b_1 -> join_1;
  join_1 -> adjudicate_1 [condition="outcome=fail"];
  join_1 -> adjudicate_1;
  adjudicate_1 -> publish_1 [condition="outcome=success"];
  adjudicate_1 -> blocked [condition="outcome=fail"];
  adjudicate_1 -> blocked;
  publish_1 -> exit [condition="outcome=success"];
  publish_1 -> blocked [condition="outcome=fail"];
  publish_1 -> blocked;
}
