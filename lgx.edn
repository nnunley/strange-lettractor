{:paths ["src"]
 :main "main.lg"
 :lg-version "1.13.0"
 :deps {tiny-tui {:git/url "https://github.com/abogoyavlensky/tiny-tui"
                  :git/sha "3d2aeaa68e4647187c10cbbcba7df881b81b9a6c"}}
 :targets {:bin {:out "bin/attractor"}}

 :contexts
 {:test {:extra-paths ["test"]}}

 ;; Every entry point lives here; the Makefile only forwards to these tasks.
 :tasks
 {suite {:doc "Run the full Attractor test suite (lgx 0.3.2+)"
         :do  {:sh ["lgx" "test"]}}
  test-ns {:doc "Run one test namespace, e.g. attractor.providers-test"
           :args [{:name :ns :type :string}]
           :with [:test]
           :do  {:run ["test/runner.lg" :arg/ns]}}
  audit-coding-loop
  {:doc "Audit the original coding-loop spec: deterministic contracts, native wire tests and repair regressions (no live providers)"
   :with [:test]
   :do {:run ["test/runner.lg" "--deadline-ms" "240000"
              "attractor.agent-test"
              "attractor.agent-loop-contract-test"
              "attractor.agent-loop-wire-test"
              "attractor.agent-error-wire-test"
              "attractor.agent-parity-matrix-wire-test"
              "attractor.agent-subagent-wire-test"
              "attractor.agent-event-origin-test"
              "attractor.profiles-test"
              "attractor.gemini-native-schema-test"
              "attractor.tool-contract-test"
              "attractor.tool-output-contract-test"
              "attractor.environment-contract-test"
              "attractor.environment-edit-portability-test"
              "attractor.execution-test"
              "attractor.execution-scope-test"
              "attractor.execution-cwd-test"
              "attractor.execution-env-test"
              "attractor.execution-env-collision-test"
              "attractor.execution-stdin-test"
              "attractor.patch-test"
              "attractor.project-docs-contract-test"
              "attractor.prompt-metadata-test"
              "attractor.read-file-agent-contract-test"
              "attractor.subagent-lifecycle-test"
              "attractor.turn-ownership-test"
              "attractor.session-error-contract-test"
              "attractor.event-families-test"
              "attractor.parity-matrix-journeys-test"
              "attractor.parity-matrix-evidence-test"
              "attractor.coding-loop-audit-test"
              "attractor.coding-smoke-journey-test"
              "attractor.coding-conformance-suite-test"]}}
  runners {:doc "Run every test namespace in its own process, one summary line each"
           :do  {:sh ["bash" "test/runners.sh"]}}

  rebuild {:doc "Rebuild bin/attractor (removes the old binary first; macOS in-place rebuilds die with 137)"
           :do  [{:sh ["rm" "-f" "bin/attractor"]}
                 {:sh ["lgx" "build"]}]}
  hooks {:doc "Gate pushes on the full suite (sets core.hooksPath for this clone)"
         :do  {:sh ["git" "config" "core.hooksPath" ".githooks"]}}

  validate {:doc "Validate a DOT pipeline"
            :args [{:name :file :type :string}]
            :do  {:run ["main.lg" "validate" :arg/file]}}
  run-pipeline {:doc "Run a DOT pipeline"
                :args [{:name :file :type :string}]
                :do  {:run ["main.lg" "run" :arg/file "--auto-approve"]}}

  providers {:doc "Show the effective provider registry"
             :do  [{:sh ["lgx" "rebuild"]}
                   {:sh ["bin/attractor" "providers"]}]}
  models {:doc "List models from every queryable provider"
          :do  [{:sh ["lgx" "rebuild"]}
                {:sh ["bin/attractor" "models"]}]}
  models-for {:doc "List models from one provider"
              :args [{:name :provider :type :string}]
              :do  [{:sh ["lgx" "rebuild"]}
                    {:sh ["bin/attractor" "models" "--provider" :arg/provider]}]}

  live-matrix {:doc "Credential-gated provider matrix (ATTRACTOR_MATRIX_PROVIDERS=a,b to restrict)"
               :with [:test]
               :do  {:run ["test/live/provider_matrix.lg" "run"]}}
  live-parity {:doc "Live coding-agent parity matrix against ATTRACTOR_LIVE_MODEL"
               :with [:test]
               :do  {:run ["test/live/parity_matrix.lg" "run"]}}
  live-coding-conformance {:doc "Coding-agent live parity and shared-session smoke for native providers or explicit gateway aliases"
                           :with [:test]
                           :do {:run ["test/live/coding_conformance.lg" "run"]}}
  live-smoke {:doc "Live Attractor pipeline smoke against ATTRACTOR_LIVE_MODEL"
              :with [:test]
              :do  {:run ["test/live/attractor_smoke.lg" "run"]}}
  live-mcp-pilot {:doc "MCP pilot dry run (no network): prints plan, exits 2"
                  :with [:test]
                  :do  {:run ["test/live/mcp_pilot_trading.lg" "run" "--dry-run"]}}
  live-mcp-pilot-live {:doc "LIVE MCP pilot: OAuth + read-only calls (operator browser step)"
                       :with [:test]
                       :do  {:run ["test/live/mcp_pilot_trading.lg" "run" "--live"]}}

  clean-runs {:doc "Remove pipeline execution artifacts, logs and checkpoints"
              :do  {:sh ["rm" "-rf" "attractor_runs"]}}
  clean-all {:doc "Remove run artifacts and the built binary"
             :do  [{:sh ["rm" "-rf" "attractor_runs"]}
                   {:sh ["rm" "-f" "bin/attractor"]}]}}}
